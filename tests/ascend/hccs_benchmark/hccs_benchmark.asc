#include <cstdint>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"

#define DEEP_EP_ASCEND_SIMT_DEVICE 1
#define DEEP_EP_ASCEND_STAGED_URMA 1
#define DEEP_EP_ASCEND_AICORE_URMA_SERVICE 1
#define DEEP_EP_ASCEND_AICORE_WQE_CALLEE __aicore__
#include "csrc/backends/ascend/transport/aicore_transport_service.hpp"
#include "csrc/backends/ascend/transport/device_transport_facade.hpp"
#include "hccs_benchmark.hpp"

namespace deep_ep::ascend::hccs_benchmark {
namespace {

__simt_vf__ inline void enqueue_puts(
    __gm__ void* window, std::uint64_t peer_stride,
    __gm__ const std::uint64_t* peer_bytes,
    transport::DeviceTransportContext context) {
    if (threadIdx.x != 0)
        return;

    transport::DeviceTransportFacade transport(context, 0);
    const auto rank = static_cast<std::uint64_t>(context.topology.world_rank);
    const auto world_size = static_cast<std::uint64_t>(
        context.topology.world_size);
    const auto window_address = reinterpret_cast<std::uint64_t>(window);
    bool issued = false;
    for (std::uint64_t peer = 0; peer < world_size; ++peer) {
        const auto bytes = transport::simt::load_observed(&peer_bytes[peer]);
        if (peer == rank || bytes == 0)
            continue;
        const auto source = window_address +
            (world_size + peer) * peer_stride;
        const auto destination = window_address + rank * peer_stride;
        transport.put(
            transport::TransportTeam::kWorld, static_cast<int>(peer),
            destination, source, static_cast<std::size_t>(bytes),
            transport::CooperationScope::kParticipant,
            transport::MemorySegment::kDevice,
            transport::kDefaultOptions,
            transport::RemoteAction::none());
        issued = true;
    }
    if (issued)
        transport.flush(transport::CooperationScope::kDevice);
}

__aicore__ inline void copy_diagnostic(
    __gm__ BenchmarkControl* control,
    const transport::DeviceTransportContext& context) {
    auto* staged = reinterpret_cast<__gm__ transport::StagedTransportContext*>(
        context.backend_context);
    if (staged == nullptr)
        return;
    transport::aicore::flush_cacheline(staged);
    auto* queue = reinterpret_cast<__gm__ transport::TransportCommandQueue*>(
        staged->command_queue);
    if (queue == nullptr)
        return;
    transport::aicore::flush_cacheline(queue);
    auto* diagnostic =
        reinterpret_cast<__gm__ transport::DeviceTransportDiagnostic*>(
            queue->diagnostic);
    if (diagnostic == nullptr)
        return;
    transport::aicore::flush_cacheline(diagnostic);
    auto* source = reinterpret_cast<__gm__ std::uint64_t*>(diagnostic);
    auto* destination = reinterpret_cast<__gm__ std::uint64_t*>(
        &control->diagnostic);
    for (std::uint32_t word = 0;
         word < sizeof(transport::DeviceTransportDiagnostic) /
             sizeof(std::uint64_t);
         ++word)
        destination[word] = source[word];
}

}  // namespace

__global__ __vector__ void hccs_benchmark_kernel(
    __gm__ void* window, std::uint64_t peer_stride,
    __gm__ const std::uint64_t* peer_bytes,
    transport::DeviceTransportContext context, std::uint64_t generation,
    __gm__ BenchmarkControl* control) {
    transport::service::reset(context, generation);

    const auto total_start = static_cast<std::uint64_t>(
        AscendC::GetSystemCycle());
    const auto producer_start = total_start;
    asc_vf_call<enqueue_puts>(
        dim3(1), window, peer_stride, peer_bytes, context);
    const auto producer_end = static_cast<std::uint64_t>(
        AscendC::GetSystemCycle());

    const auto service_start = producer_end;
    transport::service::execute(context);
    const auto service_end = static_cast<std::uint64_t>(
        AscendC::GetSystemCycle());

    control->producer_cycles = producer_end - producer_start;
    control->service_cycles = service_end - service_start;
    control->total_cycles = service_end - total_start;
    copy_diagnostic(control, context);
    transport::aicore::system_fence();
    transport::aicore::flush_cacheline(control);
}

}  // namespace deep_ep::ascend::hccs_benchmark

extern "C" int deep_ep_hccs_benchmark_launch(
    void* window, std::uint64_t peer_stride,
    const std::uint64_t* peer_bytes,
    deep_ep::ascend::transport::DeviceTransportContext context,
    std::uint64_t generation,
    deep_ep::ascend::hccs_benchmark::BenchmarkControl* control,
    void* stream) {
    deep_ep::ascend::hccs_benchmark::hccs_benchmark_kernel<<<
        1, 0, static_cast<aclrtStream>(stream)>>>(
            window, peer_stride, peer_bytes, context, generation, control);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}
