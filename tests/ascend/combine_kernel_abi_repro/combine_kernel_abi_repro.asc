#include <cstdint>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"

namespace deep_ep::ascend::combine_kernel_abi_repro {

enum class Stage : std::uint8_t {
    kProducerRecord = 4,
};

// Deliberately representative of CoreTiling: aligned 64-bit fields followed
// by nested pointer-like values. The real failure is caused by placing the
// byte-sized Stage immediately before this aggregate in a device signature.
struct Tiling {
    std::uint64_t generation;
    std::uintptr_t local_window_base;
    std::uint64_t workspace_offset;
    std::uint64_t record_offset;
    std::uint32_t num_rows;
    std::uint32_t num_topk;
};

__simt_vf__ __launch_bounds__(64) inline void abi_probe_vf(
    __gm__ std::uint32_t* output, std::uint64_t generation,
    std::uintptr_t local_window_base, std::uint64_t workspace_offset,
    std::uint64_t record_offset, std::uint32_t num_rows,
    std::uint32_t num_topk, std::uint8_t stage) {
    if (threadIdx.x != 0)
        return;
    // The probe intentionally performs the same kind of GM address formation
    // as combine. A decoded zero/misaligned tiling value produces a device
    // address fault on affected CANN/Ascend combinations.
    const auto address = local_window_base + workspace_offset + record_offset;
    *reinterpret_cast<__gm__ std::uint32_t*>(address) =
        static_cast<std::uint32_t>(generation + num_rows + num_topk + stage);
    *output = static_cast<std::uint32_t>(address != 0 ? 42 : 0);
}

__global__ __vector__ void combine_kernel_abi_probe(
    __gm__ std::uint32_t* output,
#if defined(DEEP_EP_REPRO_BAD_ORDER)
    Stage stage, Tiling tiling
#else
    Tiling tiling, Stage stage
#endif
) {
    asc_vf_call<abi_probe_vf>(dim3(64), output, tiling.generation,
        tiling.local_window_base, tiling.workspace_offset,
        tiling.record_offset, tiling.num_rows, tiling.num_topk,
        static_cast<std::uint8_t>(stage));
}

}  // namespace deep_ep::ascend::combine_kernel_abi_repro

extern "C" int deep_ep_combine_kernel_abi_repro_launch(
    std::uint32_t* output, void* stream) {
    using namespace deep_ep::ascend::combine_kernel_abi_repro;
    const Tiling tiling{39, reinterpret_cast<std::uintptr_t>(output), 0, 0, 1, 1};
#if defined(DEEP_EP_REPRO_BAD_ORDER)
    combine_kernel_abi_probe<<<1, 0, static_cast<aclrtStream>(stream)>>>(
        output, Stage::kProducerRecord, tiling);
#else
    combine_kernel_abi_probe<<<1, 0, static_cast<aclrtStream>(stream)>>>(
        output, tiling, Stage::kProducerRecord);
#endif
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}
