#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <cmath>
#include <vector>

#include "acl/acl.h"

#include "csrc/backends/ascend/elastic/kernels.hpp"

using namespace deep_ep::ascend::elastic;

namespace {

constexpr std::uint64_t kNumTokens = 7;
constexpr std::uint64_t kHidden = 64;
constexpr std::uint64_t kNumExperts = 4;
constexpr std::uint64_t kNumTopk = 2;
constexpr std::uint64_t kMaxTokens = 16;

const std::int64_t kTopk[kNumTokens * kNumTopk] = {
    0, 1, 2, -1, 3, 1, -1, -1, 0, 2, 1, 3, 2, 0,
};

struct DeviceBuffers {
    std::uint16_t* x = nullptr;
    std::int64_t* topk = nullptr;
    float* weights = nullptr;
    std::uint8_t* communication = nullptr;
    std::uint8_t* workspace = nullptr;
    std::uint16_t* recv_x = nullptr;
    std::int64_t* recv_topk = nullptr;
    float* recv_weights = nullptr;
    std::int32_t* prefix_rank = nullptr;
    std::int32_t* prefix_expert = nullptr;
    std::int32_t* unaligned_expert = nullptr;
    std::int32_t* slots = nullptr;
    std::int32_t* source_metadata = nullptr;
    std::uint16_t* bias_0 = nullptr;
    std::uint16_t* bias_1 = nullptr;
    std::uint16_t* combined_x = nullptr;
    float* combined_weights = nullptr;
};

bool check_acl(aclError result, const char* expression, int line) {
    if (result == ACL_SUCCESS)
        return true;
    std::fprintf(stderr, "ACL failed at line %d: %s returned %d\n",
                 line, expression, static_cast<int>(result));
    return false;
}

#define CHECK_ACL(expression) \
    do { \
        if (!check_acl((expression), #expression, __LINE__)) \
            return false; \
    } while (0)

template <typename T>
bool allocate(T** pointer, std::uint64_t count) {
    return check_acl(
        aclrtMalloc(reinterpret_cast<void**>(pointer), count * sizeof(T),
                    ACL_MEM_MALLOC_HUGE_FIRST),
        "aclrtMalloc", __LINE__);
}

void release(DeviceBuffers* buffers) {
    void* pointers[] = {
        buffers->combined_weights, buffers->combined_x,
        buffers->bias_1, buffers->bias_0,
        buffers->source_metadata, buffers->slots,
        buffers->unaligned_expert, buffers->prefix_expert,
        buffers->prefix_rank, buffers->recv_weights, buffers->recv_topk,
        buffers->recv_x, buffers->workspace, buffers->communication,
        buffers->weights, buffers->topk, buffers->x,
    };
    for (void* pointer : pointers) {
        if (pointer != nullptr)
            (void)aclrtFree(pointer);
    }
    *buffers = {};
}

bool allocate_dispatch_buffers(
    const CoreTiling& tiling, DeviceBuffers* buffers) {
    const std::uint64_t receive_capacity =
        kMaxTokens * kNumTopk;
    return allocate(&buffers->x, kNumTokens * kHidden) &&
           allocate(&buffers->topk, kNumTokens * kNumTopk) &&
           allocate(&buffers->weights, kNumTokens * kNumTopk) &&
           allocate(&buffers->communication,
                    tiling.communication_buffer_bytes) &&
           allocate(&buffers->workspace, tiling.workspace_bytes) &&
           allocate(&buffers->recv_x, receive_capacity * kHidden) &&
           allocate(&buffers->recv_topk, receive_capacity * kNumTopk) &&
           allocate(&buffers->recv_weights, receive_capacity * kNumTopk) &&
           allocate(&buffers->prefix_rank, 1) &&
           allocate(&buffers->prefix_expert, kNumExperts + 1) &&
           allocate(&buffers->unaligned_expert, kNumExperts) &&
           allocate(&buffers->slots, kNumTokens * kNumTopk) &&
           allocate(&buffers->source_metadata,
                    kMaxTokens * (2 + kNumTopk)) &&
           allocate(&buffers->bias_0, kNumTokens * kHidden) &&
           allocate(&buffers->bias_1, kNumTokens * kHidden) &&
           allocate(&buffers->combined_x, kNumTokens * kHidden) &&
           allocate(&buffers->combined_weights, kNumTokens * kNumTopk);
}

CoreTiling make_dispatch_tiling(
    CoreModeFlags flags = 0, std::uint64_t num_tokens = kNumTokens) {
    CoreTilingInput input{};
    input.operation = OperationKind::kDispatch;
    input.element_kind = ElementKind::kBFloat16;
    input.mode_flags = flags;
    input.num_tokens = num_tokens;
    input.hidden = kHidden;
    input.num_experts = kNumExperts;
    input.num_topk = kNumTopk;
    input.expert_alignment = 4;
    input.num_max_tokens_per_rank = kMaxTokens;
    input.has_reusable_slots = has_mode(flags, CoreMode::kCached);
    CoreTiling tiling{};
    const auto status = build_core_tiling(input, &tiling);
    if (!status.ok()) {
        std::fprintf(stderr, "tiling failed: %s\n", status.message);
        std::exit(2);
    }
    return tiling;
}

bool initialize_dispatch(
    const DeviceBuffers& buffers,
    const CoreTiling& tiling,
    const std::vector<std::uint16_t>& x,
    const std::vector<float>& weights) {
    CHECK_ACL(aclrtMemcpy(
        buffers.x, x.size() * sizeof(std::uint16_t), x.data(),
        x.size() * sizeof(std::uint16_t), ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(
        buffers.topk, sizeof(kTopk), kTopk, sizeof(kTopk),
        ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(
        buffers.weights, weights.size() * sizeof(float), weights.data(),
        weights.size() * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemset(
        buffers.communication, tiling.communication_buffer_bytes, 0,
        tiling.communication_buffer_bytes));
    CHECK_ACL(aclrtMemset(
        buffers.workspace, tiling.workspace_bytes, 0, tiling.workspace_bytes));
    CHECK_ACL(aclrtMemset(
        buffers.recv_x, kMaxTokens * kNumTopk * kHidden * sizeof(std::uint16_t),
        0, kMaxTokens * kNumTopk * kHidden * sizeof(std::uint16_t)));
    CHECK_ACL(aclrtMemset(
        buffers.recv_topk, kMaxTokens * kNumTopk * kNumTopk * sizeof(std::int64_t),
        0xff, kMaxTokens * kNumTopk * kNumTopk * sizeof(std::int64_t)));
    CHECK_ACL(aclrtMemset(
        buffers.recv_weights, kMaxTokens * kNumTopk * kNumTopk * sizeof(float),
        0, kMaxTokens * kNumTopk * kNumTopk * sizeof(float)));
    CHECK_ACL(aclrtMemset(
        buffers.slots, kNumTokens * kNumTopk * sizeof(std::int32_t), 0xff,
        kNumTokens * kNumTopk * sizeof(std::int32_t)));
    CHECK_ACL(aclrtMemset(
        buffers.source_metadata, kMaxTokens * (2 + kNumTopk) * sizeof(std::int32_t),
        0xff, kMaxTokens * (2 + kNumTopk) * sizeof(std::int32_t)));
    return true;
}

bool verify_normal_dispatch(
    const DeviceBuffers& buffers,
    const std::vector<std::uint16_t>& input,
    const std::vector<float>& weights) {
    std::int32_t prefix_rank = -1;
    std::int32_t prefix_expert[kNumExperts + 1] = {};
    std::int32_t unaligned[kNumExperts] = {};
    std::int32_t slots[kNumTokens * kNumTopk] = {};
    std::int32_t metadata[kMaxTokens * (2 + kNumTopk)] = {};
    std::uint16_t output[kMaxTokens * kHidden] = {};
    std::int64_t output_topk[kMaxTokens * kNumTopk] = {};
    float output_weights[kMaxTokens * kNumTopk] = {};

    CHECK_ACL(aclrtMemcpy(&prefix_rank, sizeof(prefix_rank),
                          buffers.prefix_rank, sizeof(prefix_rank),
                          ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(prefix_expert, sizeof(prefix_expert),
                          buffers.prefix_expert, sizeof(prefix_expert),
                          ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(unaligned, sizeof(unaligned),
                          buffers.unaligned_expert, sizeof(unaligned),
                          ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(slots, sizeof(slots), buffers.slots,
                          sizeof(slots), ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(metadata, sizeof(metadata), buffers.source_metadata,
                          sizeof(metadata), ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(output, sizeof(output), buffers.recv_x,
                          sizeof(output), ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(output_topk, sizeof(output_topk), buffers.recv_topk,
                          sizeof(output_topk), ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(output_weights, sizeof(output_weights),
                          buffers.recv_weights, sizeof(output_weights),
                          ACL_MEMCPY_DEVICE_TO_HOST));

    const std::int32_t expected_prefix[] = {0, 4, 8, 12, 16};
    const std::int32_t expected_unaligned[] = {3, 3, 3, 2};
    if (prefix_rank != 6 ||
        std::memcmp(prefix_expert, expected_prefix,
                    sizeof(expected_prefix)) != 0 ||
        std::memcmp(unaligned, expected_unaligned,
                    sizeof(expected_unaligned)) != 0) {
        std::fprintf(stderr, "dispatch count or prefix mismatch\n");
        return false;
    }

    const std::uint64_t valid_tokens[] = {0, 1, 2, 4, 5, 6};
    for (std::uint64_t slot = 0; slot < 6; ++slot) {
        const std::uint64_t token = valid_tokens[slot];
        if (std::memcmp(output + slot * kHidden,
                        input.data() + token * kHidden,
                        kHidden * sizeof(std::uint16_t)) != 0 ||
            std::memcmp(output_topk + slot * kNumTopk,
                        kTopk + token * kNumTopk,
                        kNumTopk * sizeof(std::int64_t)) != 0 ||
            std::memcmp(output_weights + slot * kNumTopk,
                        weights.data() + token * kNumTopk,
                        kNumTopk * sizeof(float)) != 0 ||
            metadata[slot * (2 + kNumTopk)] !=
                static_cast<std::int32_t>(token)) {
            std::fprintf(stderr, "dispatch payload mismatch at slot %llu\n",
                         static_cast<unsigned long long>(slot));
            return false;
        }
    }

    const std::int32_t expected_slots[] = {
        0, -1, 1, -1, 2, -1, -1, -1, 3, -1, 4, -1, 5, -1,
    };
    if (std::memcmp(slots, expected_slots, sizeof(expected_slots)) != 0) {
        std::fprintf(stderr, "dispatch slot map mismatch\n");
        return false;
    }
    return true;
}

DispatchArguments make_dispatch_arguments(const DeviceBuffers& buffers) {
    DispatchArguments arguments{};
    arguments.x = buffers.x;
    arguments.topk_indices = buffers.topk;
    arguments.topk_weights = buffers.weights;
    arguments.communication_buffer = buffers.communication;
    arguments.workspace = buffers.workspace;
    arguments.recv_x = buffers.recv_x;
    arguments.recv_topk_indices = buffers.recv_topk;
    arguments.recv_topk_weights = buffers.recv_weights;
    arguments.prefix_per_rank = buffers.prefix_rank;
    arguments.prefix_per_expert = buffers.prefix_expert;
    arguments.unaligned_per_expert = buffers.unaligned_expert;
    arguments.destination_slots = buffers.slots;
    arguments.source_metadata = buffers.source_metadata;
    return arguments;
}

bool launch_dispatch(
    const DeviceBuffers& buffers, const CoreTiling& tiling,
    aclrtStream stream) {
    const auto arguments = make_dispatch_arguments(buffers);
    return deep_ep_ascend_launch_dispatch(arguments, tiling, stream) == 0 &&
           deep_ep_ascend_launch_dispatch_epilogue(
               arguments, tiling, stream) == 0 &&
           check_acl(aclrtSynchronizeStream(stream),
                     "aclrtSynchronizeStream", __LINE__);
}

bool verify_expanded_dispatch(
    const DeviceBuffers& buffers,
    const std::vector<std::uint16_t>& input,
    const std::vector<float>& weights,
    bool expect_zero_padding) {
    std::int32_t metadata[kMaxTokens * (2 + kNumTopk)] = {};
    std::uint16_t output[kMaxTokens * kNumTopk * kHidden] = {};
    float output_weights[kMaxTokens * kNumTopk] = {};
    CHECK_ACL(aclrtMemcpy(metadata, sizeof(metadata), buffers.source_metadata,
                          sizeof(metadata), ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(output, sizeof(output), buffers.recv_x,
                          sizeof(output), ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(output_weights, sizeof(output_weights),
                          buffers.recv_weights, sizeof(output_weights),
                          ACL_MEMCPY_DEVICE_TO_HOST));

    const std::int32_t prefix[] = {0, 4, 8, 12, 16};
    std::int32_t next[] = {0, 4, 8, 12};
    std::int32_t normal_slot = 0;
    bool occupied[16] = {};
    for (std::uint64_t token = 0; token < kNumTokens; ++token) {
        bool valid_token = false;
        for (std::uint64_t lane = 0; lane < kNumTopk; ++lane) {
            const std::int64_t expert = kTopk[token * kNumTopk + lane];
            if (expert < 0 || expert >= static_cast<std::int64_t>(kNumExperts))
                continue;
            valid_token = true;
            const std::int32_t destination = next[expert]++;
            occupied[destination] = true;
            if (std::memcmp(output + destination * kHidden,
                            input.data() + token * kHidden,
                            kHidden * sizeof(std::uint16_t)) != 0 ||
                output_weights[destination] !=
                    weights[token * kNumTopk + lane]) {
                std::fprintf(stderr,
                             "expanded payload mismatch at destination %d\n",
                             destination);
                return false;
            }
            if (metadata[normal_slot * (2 + kNumTopk) + 2 + lane] !=
                destination) {
                std::fprintf(stderr,
                             "expanded metadata mismatch at token %llu lane %llu\n",
                             static_cast<unsigned long long>(token),
                             static_cast<unsigned long long>(lane));
                return false;
            }
        }
        if (valid_token)
            ++normal_slot;
    }
    if (normal_slot != 6)
        return false;

    for (std::int32_t slot = 0; slot < prefix[kNumExperts]; ++slot) {
        if (occupied[slot] || !expect_zero_padding)
            continue;
        for (std::uint64_t hidden = 0; hidden < kHidden; ++hidden) {
            if (output[slot * kHidden + hidden] != 0) {
                std::fprintf(stderr,
                             "expanded padding is nonzero at slot %d\n", slot);
                return false;
            }
        }
        if (output_weights[slot] != 0.0F) {
            std::fprintf(stderr,
                         "expanded padding weight is nonzero at slot %d\n", slot);
            return false;
        }
    }
    return true;
}

bool run_dispatch_normal(aclrtStream stream) {
    const auto tiling = make_dispatch_tiling();
    DeviceBuffers buffers{};
    if (!allocate_dispatch_buffers(tiling, &buffers)) {
        release(&buffers);
        return false;
    }
    std::vector<std::uint16_t> x(kNumTokens * kHidden);
    std::vector<float> weights(kNumTokens * kNumTopk);
    for (std::uint64_t token = 0; token < kNumTokens; ++token) {
        for (std::uint64_t hidden = 0; hidden < kHidden; ++hidden)
            x[token * kHidden + hidden] =
                static_cast<std::uint16_t>(token * 100 + hidden);
        for (std::uint64_t lane = 0; lane < kNumTopk; ++lane)
            weights[token * kNumTopk + lane] =
                static_cast<float>(token * 10 + lane) / 8.0F;
    }
    bool ok = initialize_dispatch(buffers, tiling, x, weights);
    if (ok) {
        ok = launch_dispatch(buffers, tiling, stream) &&
             verify_normal_dispatch(buffers, x, weights);
    }
    release(&buffers);
    return ok;
}

bool run_dispatch_expanded(aclrtStream stream, bool cached, bool zero_padding) {
    const CoreModeFlags expanded = mode_bit(CoreMode::kExpanded);
    const auto initial_tiling = make_dispatch_tiling(expanded);
    DeviceBuffers buffers{};
    if (!allocate_dispatch_buffers(initial_tiling, &buffers)) {
        release(&buffers);
        return false;
    }
    std::vector<std::uint16_t> x(kNumTokens * kHidden);
    std::vector<float> weights(kNumTokens * kNumTopk);
    for (std::uint64_t index = 0; index < x.size(); ++index)
        x[index] = static_cast<std::uint16_t>(index + 1);
    for (std::uint64_t index = 0; index < weights.size(); ++index)
        weights[index] = static_cast<float>(index + 1) / 16.0F;

    bool ok = initialize_dispatch(buffers, initial_tiling, x, weights) &&
              launch_dispatch(buffers, initial_tiling, stream) &&
              verify_expanded_dispatch(buffers, x, weights, false);
    if (ok && cached) {
        for (auto& value : x)
            value = static_cast<std::uint16_t>(value + 1000);
        for (auto& value : weights)
            value += 4.0F;
        CHECK_ACL(aclrtMemcpy(
            buffers.x, x.size() * sizeof(std::uint16_t), x.data(),
            x.size() * sizeof(std::uint16_t), ACL_MEMCPY_HOST_TO_DEVICE));
        CHECK_ACL(aclrtMemcpy(
            buffers.weights, weights.size() * sizeof(float), weights.data(),
            weights.size() * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE));
        CHECK_ACL(aclrtMemset(
            buffers.communication, initial_tiling.communication_buffer_bytes,
            0, initial_tiling.communication_buffer_bytes));
        CHECK_ACL(aclrtMemset(
            buffers.recv_x,
            kMaxTokens * kNumTopk * kHidden * sizeof(std::uint16_t),
            0x5a,
            kMaxTokens * kNumTopk * kHidden * sizeof(std::uint16_t)));
        CHECK_ACL(aclrtMemset(
            buffers.recv_weights,
            kMaxTokens * kNumTopk * kNumTopk * sizeof(float),
            0x5a,
            kMaxTokens * kNumTopk * kNumTopk * sizeof(float)));
        CoreModeFlags flags = expanded | mode_bit(CoreMode::kCached);
        if (zero_padding)
            flags |= mode_bit(CoreMode::kZeroPadding);
        const auto cached_tiling = make_dispatch_tiling(flags);
        ok = launch_dispatch(buffers, cached_tiling, stream) &&
             verify_expanded_dispatch(buffers, x, weights, zero_padding);
    }
    release(&buffers);
    return ok;
}

bool run_dispatch_empty(aclrtStream stream) {
    const auto allocation_tiling = make_dispatch_tiling();
    const auto empty_tiling = make_dispatch_tiling(0, 0);
    DeviceBuffers buffers{};
    if (!allocate_dispatch_buffers(allocation_tiling, &buffers)) {
        release(&buffers);
        return false;
    }
    std::vector<std::uint16_t> x(kNumTokens * kHidden, 0);
    std::vector<float> weights(kNumTokens * kNumTopk, 0.0F);
    bool ok = initialize_dispatch(buffers, allocation_tiling, x, weights) &&
              launch_dispatch(buffers, empty_tiling, stream);
    std::int32_t prefix_rank = -1;
    std::int32_t prefix_expert[kNumExperts + 1] = {-1, -1, -1, -1, -1};
    std::int32_t unaligned[kNumExperts] = {-1, -1, -1, -1};
    if (ok) {
        CHECK_ACL(aclrtMemcpy(&prefix_rank, sizeof(prefix_rank),
                              buffers.prefix_rank, sizeof(prefix_rank),
                              ACL_MEMCPY_DEVICE_TO_HOST));
        CHECK_ACL(aclrtMemcpy(prefix_expert, sizeof(prefix_expert),
                              buffers.prefix_expert, sizeof(prefix_expert),
                              ACL_MEMCPY_DEVICE_TO_HOST));
        CHECK_ACL(aclrtMemcpy(unaligned, sizeof(unaligned),
                              buffers.unaligned_expert, sizeof(unaligned),
                              ACL_MEMCPY_DEVICE_TO_HOST));
        ok = prefix_rank == 0;
        for (std::uint64_t expert = 0; expert < kNumExperts; ++expert)
            ok = ok && prefix_expert[expert] == 0 && unaligned[expert] == 0;
        ok = ok && prefix_expert[kNumExperts] == 0;
    }
    if (!ok)
        std::fprintf(stderr, "empty dispatch output mismatch\n");
    release(&buffers);
    return ok;
}

std::uint16_t float_to_bfloat16(float value) {
    std::uint32_t bits = 0;
    std::memcpy(&bits, &value, sizeof(bits));
    const std::uint32_t rounding_bias = 0x7fffU + ((bits >> 16U) & 1U);
    return static_cast<std::uint16_t>((bits + rounding_bias) >> 16U);
}

float bfloat16_to_float(std::uint16_t value) {
    const std::uint32_t bits = static_cast<std::uint32_t>(value) << 16U;
    float output = 0.0F;
    std::memcpy(&output, &bits, sizeof(output));
    return output;
}

CoreTiling make_combine_tiling(CoreModeFlags flags) {
    CoreTilingInput input{};
    input.operation = OperationKind::kCombine;
    input.element_kind = ElementKind::kBFloat16;
    input.mode_flags = flags;
    input.num_tokens = kNumTokens;
    input.hidden = kHidden;
    input.num_experts = kNumExperts;
    input.num_topk = kNumTopk;
    input.expert_alignment = 4;
    input.num_max_tokens_per_rank = kMaxTokens;
    CoreTiling tiling{};
    const auto status = build_core_tiling(input, &tiling);
    if (!status.ok()) {
        std::fprintf(stderr, "combine tiling failed: %s\n", status.message);
        std::exit(2);
    }
    return tiling;
}

bool run_combine_case(
    aclrtStream stream, bool expanded, bool allow_multiple_reduction,
    int num_biases) {
    CoreModeFlags flags = expanded ? mode_bit(CoreMode::kExpanded) : 0;
    if (allow_multiple_reduction)
        flags |= mode_bit(CoreMode::kAllowMultipleReduction);
    const auto dispatch_tiling = make_dispatch_tiling(
        expanded ? mode_bit(CoreMode::kExpanded) : 0);
    const auto combine_tiling = make_combine_tiling(flags);
    DeviceBuffers buffers{};
    if (!allocate_dispatch_buffers(dispatch_tiling, &buffers)) {
        release(&buffers);
        return false;
    }

    std::vector<std::uint16_t> x(kNumTokens * kHidden);
    std::vector<float> weights(kNumTokens * kNumTopk);
    std::vector<std::uint16_t> bias_0(kNumTokens * kHidden);
    std::vector<std::uint16_t> bias_1(kNumTokens * kHidden);
    for (std::uint64_t token = 0; token < kNumTokens; ++token) {
        for (std::uint64_t hidden = 0; hidden < kHidden; ++hidden) {
            x[token * kHidden + hidden] = float_to_bfloat16(
                static_cast<float>(token + 1) +
                static_cast<float>(hidden % 4) * 0.25F);
            bias_0[token * kHidden + hidden] = float_to_bfloat16(1.0F);
            bias_1[token * kHidden + hidden] = float_to_bfloat16(0.5F);
        }
        for (std::uint64_t lane = 0; lane < kNumTopk; ++lane)
            weights[token * kNumTopk + lane] =
                static_cast<float>(token * kNumTopk + lane + 1) / 16.0F;
    }

    bool ok = initialize_dispatch(buffers, dispatch_tiling, x, weights) &&
              launch_dispatch(buffers, dispatch_tiling, stream);
    if (ok) {
        CHECK_ACL(aclrtMemcpy(
            buffers.bias_0, bias_0.size() * sizeof(std::uint16_t),
            bias_0.data(), bias_0.size() * sizeof(std::uint16_t),
            ACL_MEMCPY_HOST_TO_DEVICE));
        CHECK_ACL(aclrtMemcpy(
            buffers.bias_1, bias_1.size() * sizeof(std::uint16_t),
            bias_1.data(), bias_1.size() * sizeof(std::uint16_t),
            ACL_MEMCPY_HOST_TO_DEVICE));
        CHECK_ACL(aclrtMemset(
            buffers.communication, combine_tiling.communication_buffer_bytes,
            0, combine_tiling.communication_buffer_bytes));
        CHECK_ACL(aclrtMemset(
            buffers.combined_x, kNumTokens * kHidden * sizeof(std::uint16_t),
            0, kNumTokens * kHidden * sizeof(std::uint16_t)));
        CHECK_ACL(aclrtMemset(
            buffers.combined_weights, kNumTokens * kNumTopk * sizeof(float),
            0, kNumTokens * kNumTopk * sizeof(float)));

        CombineArguments arguments{};
        arguments.x = buffers.recv_x;
        arguments.topk_weights = buffers.recv_weights;
        arguments.source_metadata = buffers.source_metadata;
        arguments.combined_topk_indices = buffers.topk;
        arguments.prefix_per_rank = buffers.prefix_rank;
        arguments.bias_0 = num_biases >= 1 ? buffers.bias_0 : nullptr;
        arguments.bias_1 = num_biases >= 2 ? buffers.bias_1 : nullptr;
        arguments.communication_buffer = buffers.communication;
        arguments.workspace = buffers.workspace;
        arguments.combined_x = buffers.combined_x;
        arguments.combined_topk_weights = buffers.combined_weights;
        ok = deep_ep_ascend_launch_combine(
                 arguments, combine_tiling, stream) == 0 &&
             deep_ep_ascend_launch_combine_epilogue(
                 arguments, combine_tiling, stream) == 0 &&
             check_acl(aclrtSynchronizeStream(stream),
                       "aclrtSynchronizeStream", __LINE__);
    }

    std::vector<std::uint16_t> actual(kNumTokens * kHidden);
    std::vector<float> actual_weights(kNumTokens * kNumTopk);
    if (ok) {
        CHECK_ACL(aclrtMemcpy(
            actual.data(), actual.size() * sizeof(std::uint16_t),
            buffers.combined_x, actual.size() * sizeof(std::uint16_t),
            ACL_MEMCPY_DEVICE_TO_HOST));
        CHECK_ACL(aclrtMemcpy(
            actual_weights.data(), actual_weights.size() * sizeof(float),
            buffers.combined_weights,
            actual_weights.size() * sizeof(float),
            ACL_MEMCPY_DEVICE_TO_HOST));

        for (std::uint64_t token = 0; token < kNumTokens && ok; ++token) {
            std::uint64_t valid_experts = 0;
            for (std::uint64_t lane = 0; lane < kNumTopk; ++lane) {
                if (kTopk[token * kNumTopk + lane] >= 0)
                    ++valid_experts;
                const float expected_weight =
                    kTopk[token * kNumTopk + lane] >= 0 ?
                    weights[token * kNumTopk + lane] : 0.0F;
                if (actual_weights[token * kNumTopk + lane] !=
                    expected_weight) {
                    std::fprintf(stderr,
                                 "combine weight mismatch at token %llu lane %llu\n",
                                 static_cast<unsigned long long>(token),
                                 static_cast<unsigned long long>(lane));
                    ok = false;
                }
            }
            for (std::uint64_t hidden = 0; hidden < kHidden && ok; ++hidden) {
                const float source = bfloat16_to_float(
                    x[token * kHidden + hidden]);
                float expected = valid_experts == 0 ? 0.0F :
                    source * static_cast<float>(expanded ? valid_experts : 1);
                if (num_biases >= 1)
                    expected += 1.0F;
                if (num_biases >= 2)
                    expected += 0.5F;
                const std::uint16_t expected_bits = float_to_bfloat16(expected);
                if (actual[token * kHidden + hidden] != expected_bits) {
                    std::fprintf(stderr,
                                 "combine payload mismatch at token %llu hidden %llu: actual=%f expected=%f\n",
                                 static_cast<unsigned long long>(token),
                                 static_cast<unsigned long long>(hidden),
                                 bfloat16_to_float(actual[token * kHidden + hidden]),
                                 bfloat16_to_float(expected_bits));
                    ok = false;
                }
            }
        }
    }
    release(&buffers);
    return ok;
}

}  // namespace

int main(int argc, char** argv) {
    if (argc != 3 || std::strcmp(argv[1], "--case") != 0) {
        std::fprintf(stderr,
                     "usage: %s --case dispatch-normal|dispatch-expanded|dispatch-cached|dispatch-zero-padding|dispatch-empty|combine-normal|combine-expanded|combine-multiple|combine-single-reduction|combine-weights|combine-bias0|combine-bias01|round-trip\n",
                     argv[0]);
        return 2;
    }
    const bool known_case =
        std::strcmp(argv[2], "dispatch-normal") == 0 ||
        std::strcmp(argv[2], "dispatch-expanded") == 0 ||
        std::strcmp(argv[2], "dispatch-cached") == 0 ||
        std::strcmp(argv[2], "dispatch-zero-padding") == 0 ||
        std::strcmp(argv[2], "dispatch-empty") == 0 ||
        std::strcmp(argv[2], "combine-normal") == 0 ||
        std::strcmp(argv[2], "combine-expanded") == 0 ||
        std::strcmp(argv[2], "combine-multiple") == 0 ||
        std::strcmp(argv[2], "combine-single-reduction") == 0 ||
        std::strcmp(argv[2], "combine-weights") == 0 ||
        std::strcmp(argv[2], "combine-bias0") == 0 ||
        std::strcmp(argv[2], "combine-bias01") == 0 ||
        std::strcmp(argv[2], "round-trip") == 0;
    if (!known_case) {
        std::fprintf(stderr, "unknown case: %s\n", argv[2]);
        return 2;
    }

    bool initialized = false;
    bool device_set = false;
    aclrtStream stream = nullptr;
    bool ok = false;
    if (!check_acl(aclInit(nullptr), "aclInit", __LINE__))
        goto cleanup;
    initialized = true;
    if (!check_acl(aclrtSetDevice(0), "aclrtSetDevice", __LINE__))
        goto cleanup;
    device_set = true;
    if (!check_acl(aclrtCreateStream(&stream), "aclrtCreateStream", __LINE__))
        goto cleanup;
    if (std::strcmp(argv[2], "dispatch-normal") == 0)
        ok = run_dispatch_normal(stream);
    else if (std::strcmp(argv[2], "dispatch-expanded") == 0)
        ok = run_dispatch_expanded(stream, false, false);
    else if (std::strcmp(argv[2], "dispatch-cached") == 0)
        ok = run_dispatch_expanded(stream, true, false);
    else if (std::strcmp(argv[2], "dispatch-zero-padding") == 0)
        ok = run_dispatch_expanded(stream, true, true);
    else if (std::strcmp(argv[2], "dispatch-empty") == 0)
        ok = run_dispatch_empty(stream);
    else if (std::strcmp(argv[2], "combine-expanded") == 0 ||
             std::strcmp(argv[2], "combine-single-reduction") == 0)
        ok = run_combine_case(stream, true, false, 0);
    else if (std::strcmp(argv[2], "combine-multiple") == 0)
        ok = run_combine_case(stream, true, true, 0);
    else if (std::strcmp(argv[2], "combine-bias0") == 0)
        ok = run_combine_case(stream, false, true, 1);
    else if (std::strcmp(argv[2], "combine-bias01") == 0)
        ok = run_combine_case(stream, false, true, 2);
    else
        ok = run_combine_case(stream, false, true, 0);

cleanup:
    if (stream != nullptr)
        (void)aclrtDestroyStream(stream);
    if (device_set)
        (void)aclrtResetDevice(0);
    if (initialized)
        (void)aclFinalize();
    std::printf("case=%s %s\n", argv[2],
                ok ? "Verification PASSED" : "Verification FAILED");
    return ok ? 0 : 1;
}
