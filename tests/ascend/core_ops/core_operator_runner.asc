__simt_vf__ inline void cached_mixed_rank_prefix_probe_vf(
    __gm__ const std::int64_t* records,
    __gm__ const std::int32_t* cached_counts,
    __gm__ const std::int32_t* cached_prefix,
    __gm__ std::int32_t* output,
    std::uint64_t num_records, std::uint64_t num_experts,
    std::uint64_t num_topk, std::uint64_t expert_alignment,
    int world_rank, int world_size) {
    if (threadIdx.x != 0)
        return;
    const std::uint64_t num_local_experts =
        num_experts / static_cast<std::uint64_t>(world_size);
    const std::uint64_t first_local_expert =
        static_cast<std::uint64_t>(world_rank) * num_local_experts;
    std::int32_t derived_prefix = 0;
    bool matches_cache = true;
    for (std::uint64_t expert = 0; expert < num_experts; ++expert) {
        std::int32_t actual_count = 0;
        if (is_dispatch_expert_local(
                static_cast<std::int64_t>(expert), first_local_expert,
                num_local_experts)) {
            for (std::uint64_t record = 0; record < num_records; ++record) {
                for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                    if (records[record * num_topk + lane] ==
                        static_cast<std::int64_t>(expert))
                        ++actual_count;
                }
            }
        }
        output[1 + expert] = actual_count;
        output[1 + num_experts + expert] = derived_prefix;
        if (actual_count != cached_counts[expert] ||
            derived_prefix != cached_prefix[expert])
            matches_cache = false;
        const std::int32_t alignment =
            static_cast<std::int32_t>(expert_alignment);
        derived_prefix +=
            ((actual_count + alignment - 1) / alignment) * alignment;
    }
    output[1 + 2 * num_experts] = derived_prefix;
    if (derived_prefix != cached_prefix[num_experts])
        matches_cache = false;
    output[0] = matches_cache ? 1 : 0;
}

__global__ __vector__ void cached_mixed_rank_prefix_probe_kernel(
    __gm__ const std::int64_t* records,
    __gm__ const std::int32_t* cached_counts,
    __gm__ const std::int32_t* cached_prefix,
    __gm__ std::int32_t* output,
    std::uint64_t num_records, std::uint64_t num_experts,
    std::uint64_t num_topk, std::uint64_t expert_alignment,
    int world_rank, int world_size) {
    asc_vf_call<cached_mixed_rank_prefix_probe_vf>(
        dim3(1), records, cached_counts, cached_prefix, output,
        num_records, num_experts, num_topk, expert_alignment,
        world_rank, world_size);
}

__simt_vf__ inline void dispatch_public_identity_probe_vf(
    __gm__ std::int64_t* output) {
    if (threadIdx.x != 0)
        return;
    output[0] = encode_dispatch_source_index(1, 4, 3);
    output[1] = decode_dispatch_source_rank(7, 4);
    output[2] = decode_dispatch_local_index(7, 4);
    output[3] = encode_dispatch_source_index(1, 2, 1);
    output[4] = is_dispatch_local_index(3, 4) ? 1 : 0;
    output[5] = is_dispatch_local_index(4, 4) ? 1 : 0;
    output[6] = localize_dispatch_expert(2, 2, 2);
    output[7] = localize_dispatch_expert(3, 2, 2);
    output[8] = localize_dispatch_expert(0, 2, 2);
    output[9] = localize_dispatch_expert(-1, 2, 2);
}

__global__ __vector__ void dispatch_public_identity_probe_kernel(
    __gm__ std::int64_t* output) {
    asc_vf_call<dispatch_public_identity_probe_vf>(dim3(1), output);
}

inline constexpr std::uint32_t kHybridRouteLocalProbe = 0;
inline constexpr std::uint32_t kHybridRouteScaleUpProbe = 1;
inline constexpr std::uint32_t kHybridRouteScaleOutProbe = 2;
inline constexpr std::uint32_t kHybridRouteDiagonalProbe = 3;
inline constexpr std::uint32_t kHybridRouteEmptyProbe = 4;
inline constexpr std::uint32_t kHybridRouteCachedProbe = 5;
inline constexpr std::uint32_t kHybridCombineSingleProbe = 6;
inline constexpr std::uint32_t kHybridCombineMultipleProbe = 7;

__simt_vf__ inline void hybrid_route_probe_vf(
    __gm__ const std::int32_t* reduction_rows,
    __gm__ std::uint64_t* output, std::uint32_t case_id) {
    if (threadIdx.x != 0)
        return;

    constexpr std::uint64_t generation = 41;
    constexpr std::uint64_t topology_epoch = 17;
    if (case_id == kHybridRouteEmptyProbe) {
        const HybridRouteRecord* records = nullptr;
        const std::uint64_t record_count = 0;
        output[0] = records == nullptr && record_count == 0 ? 1 : 0;
        return;
    }

    int destination_rank = static_cast<int>(case_id);
    if (case_id >= kHybridRouteCachedProbe)
        destination_rank = 3;
    const auto route = classify_world_route(0, destination_rank, 2);
    const bool diagonal = route.kind == WorldRouteKind::kDiagonal;
    HybridRouteRecord record{};
    record.origin_world_rank = 0;
    record.destination_world_rank = destination_rank;
    record.ingress_world_rank = route.ingress_world_rank;
    record.destination_local_expert = 0;
    record.origin_source_row = 0;
    record.ingress_slot = diagonal ? 5 : kInvalidHybridRouteSlot;
    record.forwarded_slot = diagonal ? 7 : kInvalidHybridRouteSlot;
    record.generation = generation;
    record.topology_epoch = topology_epoch;
    record.stage_flags = kHybridRouteCompleteStageFlags;
    record.reserved = 0;

    bool ok = record.origin_world_rank == 0 &&
              record.destination_world_rank == destination_rank &&
              record.ingress_world_rank == route.ingress_world_rank &&
              record.origin_source_row == 0 &&
              record.generation == generation &&
              record.topology_epoch == topology_epoch &&
              record.stage_flags == kHybridRouteCompleteStageFlags &&
              record.reserved == 0 &&
              (diagonal ?
                   record.ingress_slot == 5 && record.forwarded_slot == 7 :
                   record.ingress_slot == kInvalidHybridRouteSlot &&
                       record.forwarded_slot == kInvalidHybridRouteSlot);
    if (case_id == kHybridRouteLocalProbe) {
        ok = ok && route.kind == WorldRouteKind::kLocal &&
             route.ingress_world_rank == 0;
    } else if (case_id == kHybridRouteScaleUpProbe) {
        const auto team = transport::TransportTeam::kScaleUp;
        ok = ok && route.kind == WorldRouteKind::kScaleUp &&
             route.ingress_world_rank == 1 &&
             team == transport::TransportTeam::kScaleUp;
    } else if (case_id == kHybridRouteScaleOutProbe) {
        const auto team = transport::TransportTeam::kScaleOut;
        ok = ok && route.kind == WorldRouteKind::kScaleOut &&
             route.ingress_world_rank == 2 &&
             team == transport::TransportTeam::kScaleOut;
    } else if (case_id == kHybridRouteDiagonalProbe) {
        const auto ingress_team = transport::TransportTeam::kScaleOut;
        const auto forward_team = transport::TransportTeam::kScaleUp;
        ok = ok && route.kind == WorldRouteKind::kDiagonal &&
             route.ingress_world_rank == 2 &&
             ingress_team == transport::TransportTeam::kScaleOut &&
             forward_team == transport::TransportTeam::kScaleUp;
    } else if (case_id == kHybridRouteCachedProbe) {
        HybridRouteRecord cached = record;
        cached.generation = generation + 1;
        ok = ok && cached.origin_world_rank == record.origin_world_rank &&
             cached.destination_world_rank == record.destination_world_rank &&
             cached.ingress_world_rank == record.ingress_world_rank &&
             cached.origin_source_row == record.origin_source_row &&
             cached.ingress_slot == record.ingress_slot &&
             cached.forwarded_slot == record.forwarded_slot &&
             cached.topology_epoch == record.topology_epoch &&
             cached.stage_flags == record.stage_flags &&
             cached.generation == record.generation + 1;
    } else {
        const bool allow_multiple_reduction =
            case_id == kHybridCombineMultipleProbe;
        const std::uint64_t record_count = combine_expanded_record_count(
            reduction_rows, 2, allow_multiple_reduction);
        const auto reverse_forward_team = transport::TransportTeam::kScaleUp;
        const auto reverse_return_team = transport::TransportTeam::kScaleOut;
        ok = ok && route.kind == WorldRouteKind::kDiagonal &&
             reverse_forward_team == transport::TransportTeam::kScaleUp &&
             reverse_return_team == transport::TransportTeam::kScaleOut &&
             record_count == (allow_multiple_reduction ? 1 : 2);
    }
    output[0] = ok ? 1 : 0;
}

__global__ __vector__ void hybrid_route_probe_kernel(
    __gm__ const std::int32_t* reduction_rows,
    __gm__ std::uint64_t* output, std::uint32_t case_id) {
    asc_vf_call<hybrid_route_probe_vf>(
        dim3(1), reduction_rows, output, case_id);
}

__simt_vf__ inline void combine_state_probe_vf(
    __gm__ std::uint64_t* results, __gm__ std::uint16_t* output) {
    if (threadIdx.x != 0)
        return;

    constexpr std::uint64_t generation = 13;
    const bool clean = is_clean_combine_transport_completion(
        generation, generation, transport::kTransportCommandAbiVersion,
        generation, transport::DeviceTransportError::kNone);
    const bool failed = is_clean_combine_transport_completion(
        generation, generation, transport::kTransportCommandAbiVersion,
        generation, transport::DeviceTransportError::kCompletionFailure);
    const bool valid_extent = is_valid_combine_token_extent(8, 8);
    const bool invalid_extent = is_valid_combine_token_extent(9, 8);
    results[0] = clean ? 1 : 0;
    results[1] = failed ? 1 : 0;
    results[2] = valid_extent ? 1 : 0;
    results[3] = invalid_extent ? 1 : 0;
    results[4] = combine_receive_shard_address(
        0x100000, 0x2000, 0, 0x400);
    results[5] = combine_receive_shard_address(
        0x100000, 0x2000, 1, 0x400);
    results[6] = combine_staging_shard_address(
        0x100000, 0x3000, 0, 0x800);
    results[7] = combine_staging_shard_address(
        0x100000, 0x3000, 1, 0x800);

    constexpr std::uint16_t sentinel = 0x5a5a;
    output[0] = sentinel;
    output[1] = sentinel;
    output[2] = sentinel;
    auto* bf16_output = reinterpret_cast<__gm__ bfloat16_t*>(output);
    if (clean) {
        float value = 0.0F;
        value += static_cast<float>(static_cast<bfloat16_t>(1.0F));
        value += static_cast<float>(static_cast<bfloat16_t>(0.00390625F));
        value += static_cast<float>(static_cast<bfloat16_t>(0.00390625F));
        bf16_output[0] = static_cast<bfloat16_t>(value);
    }
    if (failed)
        bf16_output[1] = static_cast<bfloat16_t>(0.0F);
    if (clean && invalid_extent)
        bf16_output[2] = static_cast<bfloat16_t>(0.0F);
}

__global__ __vector__ void combine_state_probe_kernel(
    __gm__ std::uint64_t* results, __gm__ std::uint16_t* output) {
    asc_vf_call<combine_state_probe_vf>(dim3(1), results, output);
}

}  // namespace deep_ep::ascend::elastic::runner

namespace {

constexpr std::uint64_t kNumTokens = 7;
constexpr std::uint64_t kHidden = 64;
constexpr std::uint64_t kNumExperts = 4;
constexpr std::uint64_t kNumTopk = 2;
constexpr std::uint64_t kMaxTokens = 16;
constexpr std::uint8_t kRejectedOutputSentinel = 0x5a;
constexpr std::uint64_t kInvalidTopkStatus = (1ULL << 32U) | 1ULL;
constexpr std::uint64_t kInvalidCachedSlotStatus = (1ULL << 32U) | 2ULL;
constexpr std::uint64_t kInvalidCachedPrefixStatus = (1ULL << 32U) | 3ULL;
constexpr std::uint64_t kInvalidCachedMetadataStatus =
    (1ULL << 32U) | 4ULL;

const std::int64_t kTopk[kNumTokens * kNumTopk] = {
    0, 1, 2, -1, 3, 1, -1, -1, 0, 2, 1, 3, 2, 0,
};

constexpr int kMixedRankWorldRank = 0;
constexpr int kMixedRankWorldSize = 2;
constexpr std::uint64_t kMixedRankNumRecords = 2;
const std::int64_t kMixedRankRecords[kMixedRankNumRecords * kNumTopk] = {
    0, 2,
    1, 3,
};
const std::int32_t kMixedRankCachedCounts[kNumExperts] = {1, 1, 0, 0};
const std::int32_t kMixedRankCachedPrefix[kNumExperts + 1] = {0, 4, 8, 8, 8};

struct DeviceBuffers {
    std::uint16_t* x = nullptr;
    std::int64_t* topk = nullptr;
    float* weights = nullptr;
    std::uint8_t* communication = nullptr;
    std::uint8_t* workspace = nullptr;
    std::uint16_t* recv_x = nullptr;
    std::int64_t* recv_topk = nullptr;
    float* recv_weights = nullptr;
    std::int32_t* prefix_rank = nullptr;
    std::int32_t* prefix_expert = nullptr;
    std::int32_t* unaligned_expert = nullptr;
    std::int32_t* slots = nullptr;
    std::int32_t* source_metadata = nullptr;
    std::uint16_t* bias_0 = nullptr;
    std::uint16_t* bias_1 = nullptr;
    std::uint16_t* combined_x = nullptr;
    float* combined_weights = nullptr;
};

bool check_acl(aclError result, const char* expression, int line) {
    if (result == ACL_SUCCESS)
        return true;
    std::fprintf(stderr, "ACL failed at line %d: %s returned %d\n",
                 line, expression, static_cast<int>(result));
    return false;
}

#define CHECK_ACL(expression) \
    do { \
        if (!check_acl((expression), #expression, __LINE__)) \
            return false; \
    } while (0)

template <typename T>
bool allocate(T** pointer, std::uint64_t count) {
    return check_acl(
        aclrtMalloc(reinterpret_cast<void**>(pointer), count * sizeof(T),
                    ACL_MEM_MALLOC_HUGE_FIRST),
        "aclrtMalloc", __LINE__);
}

void release(DeviceBuffers* buffers) {
    void* pointers[] = {
        buffers->combined_weights, buffers->combined_x,
        buffers->bias_1, buffers->bias_0,
        buffers->source_metadata, buffers->slots,
        buffers->unaligned_expert, buffers->prefix_expert,
        buffers->prefix_rank, buffers->recv_weights, buffers->recv_topk,
        buffers->recv_x, buffers->workspace, buffers->communication,
        buffers->weights, buffers->topk, buffers->x,
    };
    for (void* pointer : pointers) {
        if (pointer != nullptr)
            (void)aclrtFree(pointer);
    }
    *buffers = {};
}

bool allocate_dispatch_buffers(
    const CoreTiling& tiling, const CoreLaunchStorage& allocation_storage,
    std::uint64_t prefix_rank_count, DeviceBuffers* buffers) {
    const auto required_storage = required_core_launch_storage(tiling);
    if (allocation_storage.communication_buffer_bytes <
            required_storage.communication_buffer_bytes ||
        allocation_storage.workspace_bytes < required_storage.workspace_bytes ||
        prefix_rank_count <
            static_cast<std::uint64_t>(tiling.topology.world_size))
        return false;
    const std::uint64_t receive_capacity =
        kMaxTokens * kNumTopk;
    return allocate(&buffers->x, kNumTokens * kHidden) &&
           allocate(&buffers->topk, kNumTokens * kNumTopk) &&
           allocate(&buffers->weights, kNumTokens * kNumTopk) &&
           allocate(&buffers->communication,
                    allocation_storage.communication_buffer_bytes) &&
           allocate(&buffers->workspace, allocation_storage.workspace_bytes) &&
           allocate(&buffers->recv_x, receive_capacity * kHidden) &&
           allocate(&buffers->recv_topk, receive_capacity * kNumTopk) &&
           allocate(&buffers->recv_weights, receive_capacity * kNumTopk) &&
           allocate(&buffers->prefix_rank, prefix_rank_count) &&
           allocate(&buffers->prefix_expert, kNumExperts + 1) &&
           allocate(&buffers->unaligned_expert, kNumExperts) &&
           allocate(&buffers->slots, kNumTokens * kNumTopk) &&
           allocate(&buffers->source_metadata,
                    kMaxTokens * (2 + kNumTopk)) &&
           allocate(&buffers->bias_0, kNumTokens * kHidden) &&
           allocate(&buffers->bias_1, kNumTokens * kHidden) &&
           allocate(&buffers->combined_x, kNumTokens * kHidden) &&
           allocate(&buffers->combined_weights, kNumTokens * kNumTopk);
}

bool allocate_dispatch_buffers(
    const CoreTiling& tiling, DeviceBuffers* buffers) {
    return allocate_dispatch_buffers(
        tiling, required_core_launch_storage(tiling),
        static_cast<std::uint64_t>(tiling.topology.world_size), buffers);
}

CoreTiling make_dispatch_tiling(
    CoreModeFlags flags = 0, std::uint64_t num_tokens = kNumTokens) {
    CoreTilingInput input{};
    input.operation = OperationKind::kDispatch;
    input.element_kind = ElementKind::kBFloat16;
    input.mode_flags = flags;
    input.num_tokens = num_tokens;
    input.hidden = kHidden;
    input.num_experts = kNumExperts;
    input.num_topk = kNumTopk;
    input.expert_alignment = 4;
    input.num_max_tokens_per_rank = kMaxTokens;
    input.has_reusable_slots = has_mode(flags, CoreMode::kCached);
    CoreTiling tiling{};
    const auto status = build_core_tiling(input, &tiling);
    if (!status.ok()) {
        std::fprintf(stderr, "tiling failed: %s\n", status.message);
        std::exit(2);
    }
    return tiling;
}

bool initialize_dispatch(
    const DeviceBuffers& buffers,
    const CoreTiling& tiling,
    const std::vector<std::uint16_t>& x,
    const std::vector<float>& weights,
    const std::int64_t* topk = kTopk) {
    CHECK_ACL(aclrtMemcpy(
        buffers.x, x.size() * sizeof(std::uint16_t), x.data(),
        x.size() * sizeof(std::uint16_t), ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(
        buffers.topk, sizeof(kTopk), topk, sizeof(kTopk),
        ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(
        buffers.weights, weights.size() * sizeof(float), weights.data(),
        weights.size() * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemset(
        buffers.communication, tiling.communication_buffer_bytes, 0,
        tiling.communication_buffer_bytes));
    CHECK_ACL(aclrtMemset(
        buffers.workspace, tiling.workspace_bytes, 0, tiling.workspace_bytes));
    CHECK_ACL(aclrtMemset(
        buffers.recv_x, kMaxTokens * kNumTopk * kHidden * sizeof(std::uint16_t),
        0, kMaxTokens * kNumTopk * kHidden * sizeof(std::uint16_t)));
    CHECK_ACL(aclrtMemset(
        buffers.recv_topk, kMaxTokens * kNumTopk * kNumTopk * sizeof(std::int64_t),
        0xff, kMaxTokens * kNumTopk * kNumTopk * sizeof(std::int64_t)));
    CHECK_ACL(aclrtMemset(
        buffers.recv_weights, kMaxTokens * kNumTopk * kNumTopk * sizeof(float),
        0, kMaxTokens * kNumTopk * kNumTopk * sizeof(float)));
    CHECK_ACL(aclrtMemset(
        buffers.slots, kNumTokens * kNumTopk * sizeof(std::int32_t), 0xff,
        kNumTokens * kNumTopk * sizeof(std::int32_t)));
    CHECK_ACL(aclrtMemset(
        buffers.source_metadata, kMaxTokens * (2 + kNumTopk) * sizeof(std::int32_t),
        0xff, kMaxTokens * (2 + kNumTopk) * sizeof(std::int32_t)));
    return true;
}

bool verify_normal_dispatch(
    const DeviceBuffers& buffers,
    const std::vector<std::uint16_t>& input,
    const std::vector<float>& weights) {
    std::int32_t prefix_rank = -1;
    std::int32_t prefix_expert[kNumExperts + 1] = {};
    std::int32_t unaligned[kNumExperts] = {};
    std::int32_t slots[kNumTokens * kNumTopk] = {};
    std::int32_t metadata[kMaxTokens * (2 + kNumTopk)] = {};
    std::uint16_t output[kMaxTokens * kHidden] = {};
    std::int64_t output_topk[kMaxTokens * kNumTopk] = {};
    float output_weights[kMaxTokens * kNumTopk] = {};

    CHECK_ACL(aclrtMemcpy(&prefix_rank, sizeof(prefix_rank),
                          buffers.prefix_rank, sizeof(prefix_rank),
                          ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(prefix_expert, sizeof(prefix_expert),
                          buffers.prefix_expert, sizeof(prefix_expert),
                          ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(unaligned, sizeof(unaligned),
                          buffers.unaligned_expert, sizeof(unaligned),
                          ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(slots, sizeof(slots), buffers.slots,
                          sizeof(slots), ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(metadata, sizeof(metadata), buffers.source_metadata,
                          sizeof(metadata), ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(output, sizeof(output), buffers.recv_x,
                          sizeof(output), ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(output_topk, sizeof(output_topk), buffers.recv_topk,
                          sizeof(output_topk), ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(output_weights, sizeof(output_weights),
                          buffers.recv_weights, sizeof(output_weights),
                          ACL_MEMCPY_DEVICE_TO_HOST));

    const std::int32_t expected_prefix[] = {0, 4, 8, 12, 16};
    const std::int32_t expected_unaligned[] = {3, 3, 3, 2};
    if (prefix_rank != 6 ||
        std::memcmp(prefix_expert, expected_prefix,
                    sizeof(expected_prefix)) != 0 ||
        std::memcmp(unaligned, expected_unaligned,
                    sizeof(expected_unaligned)) != 0) {
        std::fprintf(stderr, "dispatch count or prefix mismatch\n");
        return false;
    }

    const std::uint64_t valid_tokens[] = {0, 1, 2, 4, 5, 6};
    for (std::uint64_t slot = 0; slot < 6; ++slot) {
        const std::uint64_t token = valid_tokens[slot];
        if (std::memcmp(output + slot * kHidden,
                        input.data() + token * kHidden,
                        kHidden * sizeof(std::uint16_t)) != 0 ||
            std::memcmp(output_topk + slot * kNumTopk,
                        kTopk + token * kNumTopk,
                        kNumTopk * sizeof(std::int64_t)) != 0 ||
            std::memcmp(output_weights + slot * kNumTopk,
                        weights.data() + token * kNumTopk,
                        kNumTopk * sizeof(float)) != 0 ||
            metadata[slot * (2 + kNumTopk)] !=
                static_cast<std::int32_t>(token)) {
            std::fprintf(stderr, "dispatch payload mismatch at slot %llu\n",
                         static_cast<unsigned long long>(slot));
            return false;
        }
    }

    const std::int32_t expected_slots[] = {
        0, 0, 1, -1, 2, 2, -1, -1, 3, 3, 4, 4, 5, 5,
    };
    if (std::memcmp(slots, expected_slots, sizeof(expected_slots)) != 0) {
        std::fprintf(stderr, "dispatch slot map mismatch\n");
        return false;
    }
    return true;
}

DispatchArguments make_dispatch_arguments(
    const DeviceBuffers& buffers, std::uint64_t generation) {
    DispatchArguments arguments{};
    arguments.x = buffers.x;
    arguments.topk_indices = buffers.topk;
    arguments.topk_weights = buffers.weights;
    arguments.communication_buffer = buffers.communication;
    arguments.workspace = buffers.workspace;
    arguments.recv_x = buffers.recv_x;
    arguments.recv_topk_indices = buffers.recv_topk;
    arguments.recv_topk_weights = buffers.recv_weights;
    arguments.prefix_per_rank = buffers.prefix_rank;
    arguments.prefix_per_expert = buffers.prefix_expert;
    arguments.unaligned_per_expert = buffers.unaligned_expert;
    arguments.destination_slots = buffers.slots;
    arguments.source_metadata = buffers.source_metadata;
    arguments.generation = generation;
    arguments.timeout_cycles = 1000000;
    return arguments;
}

bool launch_dispatch(
    const DeviceBuffers& buffers, const CoreTiling& tiling,
    aclrtStream stream, std::uint64_t generation = 1) {
    const auto arguments = make_dispatch_arguments(buffers, generation);
    const auto storage = required_core_launch_storage(tiling);
    return launch_internal_dispatch(
               arguments, tiling, storage, stream).ok() &&
           check_acl(aclrtSynchronizeStream(stream),
                     "aclrtSynchronizeStream", __LINE__);
}

bool verify_expanded_dispatch(
    const DeviceBuffers& buffers,
    const std::vector<std::uint16_t>& input,
    const std::vector<float>& weights,
    bool expect_zero_padding,
    const std::int64_t* topk = kTopk) {
    std::int32_t metadata[kMaxTokens * (2 + kNumTopk)] = {};
    std::uint16_t output[kMaxTokens * kNumTopk * kHidden] = {};
    float output_weights[kMaxTokens * kNumTopk] = {};
    CHECK_ACL(aclrtMemcpy(metadata, sizeof(metadata), buffers.source_metadata,
                          sizeof(metadata), ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(output, sizeof(output), buffers.recv_x,
                          sizeof(output), ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(output_weights, sizeof(output_weights),
                          buffers.recv_weights, sizeof(output_weights),
                          ACL_MEMCPY_DEVICE_TO_HOST));

    const std::int32_t prefix[] = {0, 4, 8, 12, 16};
    std::int32_t next[] = {0, 4, 8, 12};
    std::int32_t normal_slot = 0;
    bool occupied[16] = {};
    for (std::uint64_t token = 0; token < kNumTokens; ++token) {
        bool valid_token = false;
        for (std::uint64_t lane = 0; lane < kNumTopk; ++lane) {
            const std::int64_t expert = topk[token * kNumTopk + lane];
            if (expert < 0 || expert >= static_cast<std::int64_t>(kNumExperts))
                continue;
            valid_token = true;
            const std::int32_t destination = next[expert]++;
            occupied[destination] = true;
            if (std::memcmp(output + destination * kHidden,
                            input.data() + token * kHidden,
                            kHidden * sizeof(std::uint16_t)) != 0 ||
                output_weights[destination] !=
                    weights[token * kNumTopk + lane]) {
                std::fprintf(stderr,
                             "expanded payload mismatch at destination %d\n",
                             destination);
                return false;
            }
            if (metadata[normal_slot * (2 + kNumTopk) + 2 + lane] !=
                destination) {
                std::fprintf(stderr,
                             "expanded metadata mismatch at token %llu lane %llu\n",
                             static_cast<unsigned long long>(token),
                             static_cast<unsigned long long>(lane));
                return false;
            }
        }
        if (valid_token)
            ++normal_slot;
    }
    if (normal_slot != 6)
        return false;

    for (std::int32_t slot = 0; slot < prefix[kNumExperts]; ++slot) {
        if (occupied[slot] || !expect_zero_padding)
            continue;
        for (std::uint64_t hidden = 0; hidden < kHidden; ++hidden) {
            if (output[slot * kHidden + hidden] != 0) {
                std::fprintf(stderr,
                             "expanded padding is nonzero at slot %d\n", slot);
                return false;
            }
        }
        if (output_weights[slot] != 0.0F) {
            std::fprintf(stderr,
                         "expanded padding weight is nonzero at slot %d\n", slot);
            return false;
        }
    }
    return true;
}

bool run_dispatch_normal(aclrtStream stream) {
    const auto tiling = make_dispatch_tiling();
    DeviceBuffers buffers{};
    if (!allocate_dispatch_buffers(tiling, &buffers)) {
        release(&buffers);
        return false;
    }
    std::vector<std::uint16_t> x(kNumTokens * kHidden);
    std::vector<float> weights(kNumTokens * kNumTopk);
    for (std::uint64_t token = 0; token < kNumTokens; ++token) {
        for (std::uint64_t hidden = 0; hidden < kHidden; ++hidden)
            x[token * kHidden + hidden] =
                static_cast<std::uint16_t>(token * 100 + hidden);
        for (std::uint64_t lane = 0; lane < kNumTopk; ++lane)
            weights[token * kNumTopk + lane] =
                static_cast<float>(token * 10 + lane) / 8.0F;
    }
    bool ok = initialize_dispatch(buffers, tiling, x, weights);
    if (ok) {
        ok = launch_dispatch(buffers, tiling, stream) &&
             verify_normal_dispatch(buffers, x, weights);
    }
    release(&buffers);
    return ok;
}

bool run_dispatch_expanded(aclrtStream stream, bool cached, bool zero_padding) {
    const CoreModeFlags expanded = mode_bit(CoreMode::kExpanded);
    const auto initial_tiling = make_dispatch_tiling(expanded);
    DeviceBuffers buffers{};
    if (!allocate_dispatch_buffers(initial_tiling, &buffers)) {
        release(&buffers);
        return false;
    }
    std::vector<std::uint16_t> x(kNumTokens * kHidden);
    std::vector<float> weights(kNumTokens * kNumTopk);
    for (std::uint64_t index = 0; index < x.size(); ++index)
        x[index] = static_cast<std::uint16_t>(index + 1);
    for (std::uint64_t index = 0; index < weights.size(); ++index)
        weights[index] = static_cast<float>(index + 1) / 16.0F;

    bool ok = initialize_dispatch(buffers, initial_tiling, x, weights) &&
              launch_dispatch(buffers, initial_tiling, stream) &&
              verify_expanded_dispatch(buffers, x, weights, false);
    if (ok && cached) {
        for (auto& value : x)
            value = static_cast<std::uint16_t>(value + 1000);
        for (auto& value : weights)
            value += 4.0F;
        CHECK_ACL(aclrtMemcpy(
            buffers.x, x.size() * sizeof(std::uint16_t), x.data(),
            x.size() * sizeof(std::uint16_t), ACL_MEMCPY_HOST_TO_DEVICE));
        CHECK_ACL(aclrtMemcpy(
            buffers.weights, weights.size() * sizeof(float), weights.data(),
            weights.size() * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE));
        CHECK_ACL(aclrtMemset(
            buffers.communication, initial_tiling.communication_buffer_bytes,
            0, initial_tiling.communication_buffer_bytes));
        CHECK_ACL(aclrtMemset(
            buffers.recv_x,
            kMaxTokens * kNumTopk * kHidden * sizeof(std::uint16_t),
            0x5a,
            kMaxTokens * kNumTopk * kHidden * sizeof(std::uint16_t)));
        CHECK_ACL(aclrtMemset(
            buffers.recv_weights,
            kMaxTokens * kNumTopk * kNumTopk * sizeof(float),
            0x5a,
            kMaxTokens * kNumTopk * kNumTopk * sizeof(float)));
        CoreModeFlags flags = expanded | mode_bit(CoreMode::kCached);
        if (zero_padding)
            flags |= mode_bit(CoreMode::kZeroPadding);
        const auto cached_tiling = make_dispatch_tiling(flags);
        ok = launch_dispatch(buffers, cached_tiling, stream, 2) &&
             verify_expanded_dispatch(buffers, x, weights, zero_padding);
    }
    release(&buffers);
    return ok;
}

bool run_dispatch_empty(aclrtStream stream) {
    const auto allocation_tiling = make_dispatch_tiling();
    const auto empty_tiling = make_dispatch_tiling(0, 0);
    DeviceBuffers buffers{};
    if (!allocate_dispatch_buffers(allocation_tiling, &buffers)) {
        release(&buffers);
        return false;
    }
    std::vector<std::uint16_t> x(kNumTokens * kHidden, 0);
    std::vector<float> weights(kNumTokens * kNumTopk, 0.0F);
    bool ok = initialize_dispatch(buffers, allocation_tiling, x, weights) &&
              launch_dispatch(buffers, empty_tiling, stream);
    std::int32_t prefix_rank = -1;
    std::int32_t prefix_expert[kNumExperts + 1] = {-1, -1, -1, -1, -1};
    std::int32_t unaligned[kNumExperts] = {-1, -1, -1, -1};
    if (ok) {
        CHECK_ACL(aclrtMemcpy(&prefix_rank, sizeof(prefix_rank),
                              buffers.prefix_rank, sizeof(prefix_rank),
                              ACL_MEMCPY_DEVICE_TO_HOST));
        CHECK_ACL(aclrtMemcpy(prefix_expert, sizeof(prefix_expert),
                              buffers.prefix_expert, sizeof(prefix_expert),
                              ACL_MEMCPY_DEVICE_TO_HOST));
        CHECK_ACL(aclrtMemcpy(unaligned, sizeof(unaligned),
                              buffers.unaligned_expert, sizeof(unaligned),
                              ACL_MEMCPY_DEVICE_TO_HOST));
        ok = prefix_rank == 0;
        for (std::uint64_t expert = 0; expert < kNumExperts; ++expert)
            ok = ok && prefix_expert[expert] == 0 && unaligned[expert] == 0;
        ok = ok && prefix_expert[kNumExperts] == 0;
    }
    if (!ok)
        std::fprintf(stderr, "empty dispatch output mismatch\n");
    release(&buffers);
    return ok;
}

bool verify_dispatch_rejected(
    const DeviceBuffers& buffers, const CoreTiling& tiling,
    std::uint64_t expected_status) {
    std::uint64_t observed_status = 0;
    std::vector<std::uint8_t> output(
        kMaxTokens * kNumTopk * kHidden * sizeof(std::uint16_t));
    std::vector<std::uint8_t> output_weights(
        kMaxTokens * kNumTopk * kNumTopk * sizeof(float));
    CHECK_ACL(aclrtMemcpy(
        &observed_status, sizeof(observed_status),
        buffers.workspace + tiling.workspace_layout.scratch_offset,
        sizeof(observed_status), ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(
        output.data(), output.size(), buffers.recv_x, output.size(),
        ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(
        output_weights.data(), output_weights.size(), buffers.recv_weights,
        output_weights.size(), ACL_MEMCPY_DEVICE_TO_HOST));
    if (observed_status != expected_status) {
        std::fprintf(stderr,
                     "dispatch protocol status mismatch: got=%llu expected=%llu\n",
                     static_cast<unsigned long long>(observed_status),
                     static_cast<unsigned long long>(expected_status));
        return false;
    }
    for (std::uint8_t byte : output) {
        if (byte != kRejectedOutputSentinel) {
            std::fprintf(stderr, "rejected dispatch modified output\n");
            return false;
        }
    }
    for (std::uint8_t byte : output_weights) {
        if (byte != kRejectedOutputSentinel) {
            std::fprintf(stderr, "rejected dispatch modified output weights\n");
            return false;
        }
    }
    return true;
}

bool fill_rejected_output_sentinels(const DeviceBuffers& buffers) {
    CHECK_ACL(aclrtMemset(
        buffers.recv_x,
        kMaxTokens * kNumTopk * kHidden * sizeof(std::uint16_t),
        kRejectedOutputSentinel,
        kMaxTokens * kNumTopk * kHidden * sizeof(std::uint16_t)));
    CHECK_ACL(aclrtMemset(
        buffers.recv_weights,
        kMaxTokens * kNumTopk * kNumTopk * sizeof(float),
        kRejectedOutputSentinel,
        kMaxTokens * kNumTopk * kNumTopk * sizeof(float)));
    return true;
}

bool run_dispatch_invalid_topk(aclrtStream stream) {
    const auto tiling = make_dispatch_tiling();
    DeviceBuffers buffers{};
    if (!allocate_dispatch_buffers(tiling, &buffers)) {
        release(&buffers);
        return false;
    }
    std::vector<std::uint16_t> x(kNumTokens * kHidden, 1);
    std::vector<float> weights(kNumTokens * kNumTopk, 1.0F);
    const std::int64_t invalid_expert = -2;
    bool ok = initialize_dispatch(buffers, tiling, x, weights);
    if (ok) {
        CHECK_ACL(aclrtMemcpy(
            buffers.topk, sizeof(invalid_expert), &invalid_expert,
            sizeof(invalid_expert), ACL_MEMCPY_HOST_TO_DEVICE));
        ok = fill_rejected_output_sentinels(buffers) &&
             launch_dispatch(buffers, tiling, stream) &&
             verify_dispatch_rejected(buffers, tiling, kInvalidTopkStatus);
    }
    release(&buffers);
    return ok;
}

bool run_dispatch_invalid_cache(aclrtStream stream) {
    const CoreModeFlags expanded = mode_bit(CoreMode::kExpanded);
    const auto initial_tiling = make_dispatch_tiling(expanded);
    DeviceBuffers buffers{};
    if (!allocate_dispatch_buffers(initial_tiling, &buffers)) {
        release(&buffers);
        return false;
    }
    std::vector<std::uint16_t> x(kNumTokens * kHidden, 1);
    std::vector<float> weights(kNumTokens * kNumTopk, 1.0F);
    bool ok = initialize_dispatch(buffers, initial_tiling, x, weights) &&
              launch_dispatch(buffers, initial_tiling, stream);
    if (ok) {
        const std::int32_t invalid_destination =
            static_cast<std::int32_t>(kMaxTokens * kNumTopk);
        CHECK_ACL(aclrtMemcpy(
            buffers.source_metadata + 2, sizeof(invalid_destination),
            &invalid_destination, sizeof(invalid_destination),
            ACL_MEMCPY_HOST_TO_DEVICE));
        const auto cached_tiling = make_dispatch_tiling(
            expanded | mode_bit(CoreMode::kCached));
        ok = fill_rejected_output_sentinels(buffers) &&
             launch_dispatch(buffers, cached_tiling, stream, 2) &&
             verify_dispatch_rejected(
                 buffers, cached_tiling, kInvalidCachedMetadataStatus);
    }
    release(&buffers);
    return ok;
}

bool run_dispatch_invalid_prefix(aclrtStream stream) {
    // Mutation caught: producer-side cached rank-prefix repair.
    const CoreModeFlags expanded = mode_bit(CoreMode::kExpanded);
    const auto initial_tiling = make_dispatch_tiling(expanded);
    DeviceBuffers buffers{};
    if (!allocate_dispatch_buffers(initial_tiling, &buffers)) {
        release(&buffers);
        return false;
    }
    std::vector<std::uint16_t> x(kNumTokens * kHidden, 1);
    std::vector<float> weights(kNumTokens * kNumTopk, 1.0F);
    bool ok = initialize_dispatch(buffers, initial_tiling, x, weights) &&
              launch_dispatch(buffers, initial_tiling, stream);
    if (ok) {
        const std::int32_t invalid_prefix = 5;
        CHECK_ACL(aclrtMemcpy(
            buffers.prefix_rank, sizeof(invalid_prefix), &invalid_prefix,
            sizeof(invalid_prefix), ACL_MEMCPY_HOST_TO_DEVICE));
        const auto cached_tiling = make_dispatch_tiling(
            expanded | mode_bit(CoreMode::kCached));
        ok = fill_rejected_output_sentinels(buffers) &&
             launch_dispatch(buffers, cached_tiling, stream, 2) &&
             verify_dispatch_rejected(
                 buffers, cached_tiling, kInvalidCachedPrefixStatus);
    }
    release(&buffers);
    return ok;
}

bool run_dispatch_invalid_slot(aclrtStream stream) {
    // Mutation caught: cached slot validation after publication.
    const CoreModeFlags expanded = mode_bit(CoreMode::kExpanded);
    const auto initial_tiling = make_dispatch_tiling(expanded);
    DeviceBuffers buffers{};
    if (!allocate_dispatch_buffers(initial_tiling, &buffers)) {
        release(&buffers);
        return false;
    }
    std::vector<std::uint16_t> x(kNumTokens * kHidden, 1);
    std::vector<float> weights(kNumTokens * kNumTopk, 1.0F);
    bool ok = initialize_dispatch(buffers, initial_tiling, x, weights) &&
              launch_dispatch(buffers, initial_tiling, stream);
    if (ok) {
        const std::int32_t invalid_slot = static_cast<std::int32_t>(kMaxTokens);
        CHECK_ACL(aclrtMemcpy(
            buffers.slots, sizeof(invalid_slot), &invalid_slot,
            sizeof(invalid_slot), ACL_MEMCPY_HOST_TO_DEVICE));
        const auto cached_tiling = make_dispatch_tiling(
            expanded | mode_bit(CoreMode::kCached));
        ok = fill_rejected_output_sentinels(buffers) &&
             launch_dispatch(buffers, cached_tiling, stream, 2) &&
             verify_dispatch_rejected(
                 buffers, cached_tiling, kInvalidCachedSlotStatus);
    }
    release(&buffers);
    return ok;
}

bool run_dispatch_cached_mixed_rank(aclrtStream stream) {
    // Mutation caught: nonlocal lanes counted in cached expert prefixes.
    std::int64_t* records = nullptr;
    std::int32_t* cached_counts = nullptr;
    std::int32_t* cached_prefix = nullptr;
    std::int32_t* output = nullptr;
    constexpr std::uint64_t output_fields = 2 * kNumExperts + 2;
    bool ok = allocate(&records, kMixedRankNumRecords * kNumTopk) &&
              allocate(&cached_counts, kNumExperts) &&
              allocate(&cached_prefix, kNumExperts + 1) &&
              allocate(&output, output_fields);
    if (ok) {
        ok = check_acl(aclrtMemcpy(
                 records, sizeof(kMixedRankRecords), kMixedRankRecords,
                 sizeof(kMixedRankRecords), ACL_MEMCPY_HOST_TO_DEVICE),
                 "aclrtMemcpy", __LINE__) &&
             check_acl(aclrtMemcpy(
                 cached_counts, sizeof(kMixedRankCachedCounts),
                 kMixedRankCachedCounts, sizeof(kMixedRankCachedCounts),
                 ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy", __LINE__) &&
             check_acl(aclrtMemcpy(
                 cached_prefix, sizeof(kMixedRankCachedPrefix),
                 kMixedRankCachedPrefix, sizeof(kMixedRankCachedPrefix),
                 ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy", __LINE__);
    }
    if (ok) {
        runner::cached_mixed_rank_prefix_probe_kernel<<<1, 0, stream>>>(
            records, cached_counts, cached_prefix, output,
            kMixedRankNumRecords, kNumExperts, kNumTopk, 4,
            kMixedRankWorldRank, kMixedRankWorldSize);
        ok = check_acl(aclrtGetLastError(ACL_RT_THREAD_LEVEL),
                       "cached_mixed_rank_prefix_probe_kernel", __LINE__) &&
             check_acl(aclrtSynchronizeStream(stream),
                       "aclrtSynchronizeStream", __LINE__);
    }
    std::int32_t observed[output_fields] = {};
    if (ok)
        ok = check_acl(aclrtMemcpy(
            observed, sizeof(observed), output, sizeof(observed),
            ACL_MEMCPY_DEVICE_TO_HOST), "aclrtMemcpy", __LINE__);
    const std::int32_t expected[output_fields] = {
        1, 1, 1, 0, 0, 0, 4, 8, 8, 8,
    };
    ok = ok && std::memcmp(observed, expected, sizeof(expected)) == 0;
    if (!ok)
        std::fprintf(stderr, "mixed-rank cached prefix mismatch\n");
    if (output != nullptr)
        (void)aclrtFree(output);
    if (cached_prefix != nullptr)
        (void)aclrtFree(cached_prefix);
    if (cached_counts != nullptr)
        (void)aclrtFree(cached_counts);
    if (records != nullptr)
        (void)aclrtFree(records);
    return ok;
}

bool run_dispatch_public_identity(aclrtStream stream) {
    // Mutation caught: destination-ranked cached slots.
    // Mutation caught: receiver-local source token bounds.
    // Mutation caught: global normal-mode receive routes.
    std::int64_t* output = nullptr;
    bool ok = allocate(&output, 10);
    if (ok) {
        runner::dispatch_public_identity_probe_kernel<<<1, 0, stream>>>(output);
        ok = check_acl(aclrtGetLastError(ACL_RT_THREAD_LEVEL),
                       "dispatch_public_identity_probe_kernel", __LINE__) &&
             check_acl(aclrtSynchronizeStream(stream),
                       "aclrtSynchronizeStream", __LINE__);
    }
    std::int64_t observed[10] = {};
    if (ok)
        ok = check_acl(aclrtMemcpy(
            observed, sizeof(observed), output, sizeof(observed),
            ACL_MEMCPY_DEVICE_TO_HOST), "aclrtMemcpy", __LINE__);
    const std::int64_t expected[10] = {7, 1, 3, 3, 1, 0, 0, 1, -1, -1};
    ok = ok && std::memcmp(observed, expected, sizeof(expected)) == 0;
    if (!ok)
        std::fprintf(stderr, "dispatch public identity mismatch\n");
    if (output != nullptr)
        (void)aclrtFree(output);
    return ok;
}

bool run_hybrid_route_probe(aclrtStream stream, std::uint32_t case_id) {
    const std::int32_t reduction_rows[2] = {2, 3};
    std::int32_t* device_reduction_rows = nullptr;
    std::uint64_t* device_output = nullptr;
    bool ok = allocate(&device_reduction_rows, 2) &&
              allocate(&device_output, 1);
    if (ok) {
        ok = check_acl(aclrtMemcpy(
                 device_reduction_rows, sizeof(reduction_rows),
                 reduction_rows, sizeof(reduction_rows),
                 ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy", __LINE__);
    }
    if (ok) {
        runner::hybrid_route_probe_kernel<<<1, 0, stream>>>(
            device_reduction_rows, device_output, case_id);
        ok = check_acl(aclrtGetLastError(ACL_RT_THREAD_LEVEL),
                       "hybrid_route_probe_kernel", __LINE__) &&
             check_acl(aclrtSynchronizeStream(stream),
                       "aclrtSynchronizeStream", __LINE__);
    }
    std::uint64_t observed = 0;
    if (ok) {
        ok = check_acl(aclrtMemcpy(
            &observed, sizeof(observed), device_output, sizeof(observed),
            ACL_MEMCPY_DEVICE_TO_HOST), "aclrtMemcpy", __LINE__);
    }
    if (device_output != nullptr)
        (void)aclrtFree(device_output);
    if (device_reduction_rows != nullptr)
        (void)aclrtFree(device_reduction_rows);
    return ok && observed == 1;
}

std::uint16_t float_to_bfloat16(float value) {
    std::uint32_t bits = 0;
    std::memcpy(&bits, &value, sizeof(bits));
    const std::uint32_t rounding_bias = 0x7fffU + ((bits >> 16U) & 1U);
    return static_cast<std::uint16_t>((bits + rounding_bias) >> 16U);
}

float bfloat16_to_float(std::uint16_t value) {
    const std::uint32_t bits = static_cast<std::uint32_t>(value) << 16U;
    float output = 0.0F;
    std::memcpy(&output, &bits, sizeof(output));
    return output;
}

bool run_combine_state_probe(aclrtStream stream) {
    std::uint64_t* results = nullptr;
    std::uint16_t* output = nullptr;
    bool ok = allocate(&results, 8) && allocate(&output, 3);
    if (ok) {
        runner::combine_state_probe_kernel<<<1, 0, stream>>>(results, output);
        ok = check_acl(aclrtGetLastError(ACL_RT_THREAD_LEVEL),
                       "combine_state_probe_kernel", __LINE__) &&
             check_acl(aclrtSynchronizeStream(stream),
                       "aclrtSynchronizeStream", __LINE__);
    }
    std::uint64_t observed_results[8] = {};
    std::uint16_t observed_output[3] = {};
    if (ok) {
        ok = check_acl(aclrtMemcpy(
                 observed_results, sizeof(observed_results), results,
                 sizeof(observed_results), ACL_MEMCPY_DEVICE_TO_HOST),
                 "aclrtMemcpy", __LINE__) &&
             check_acl(aclrtMemcpy(
                 observed_output, sizeof(observed_output), output,
                 sizeof(observed_output), ACL_MEMCPY_DEVICE_TO_HOST),
                 "aclrtMemcpy", __LINE__);
    }
    const std::uint64_t expected_results[8] = {
        1, 0, 1, 0, 0x102000, 0x102400, 0x103000, 0x103800,
    };
    ok = ok &&
         std::memcmp(
             observed_results, expected_results, sizeof(expected_results)) == 0 &&
         observed_output[0] == float_to_bfloat16(1.0078125F) &&
         observed_output[1] == 0x5a5a &&
         observed_output[2] == 0x5a5a;
    if (!ok)
        std::fprintf(stderr, "combine state probe mismatch\n");
    if (output != nullptr)
        (void)aclrtFree(output);
    if (results != nullptr)
        (void)aclrtFree(results);
    return ok;
}

CoreTiling make_combine_tiling(
    CoreModeFlags flags,
    const deep_ep::ascend::transport::DeviceTransportContext& transport_context) {
    CoreTilingInput input{};
    input.operation = OperationKind::kCombine;
    input.element_kind = ElementKind::kBFloat16;
    input.mode_flags = flags;
    input.num_tokens = kNumTokens;
    input.hidden = kHidden;
    input.num_experts = kNumExperts;
    input.num_topk = kNumTopk;
    input.expert_alignment = 4;
    input.num_max_tokens_per_rank = kMaxTokens;
    input.topology = core_topology_from_transport(
        transport_context.topology);
    CoreTiling tiling{};
    const auto status = build_core_tiling(input, &tiling);
    if (!status.ok()) {
        std::fprintf(stderr, "combine tiling failed: %s\n", status.message);
        std::exit(2);
    }
    tiling.transport_context = transport_context;
    return tiling;
}

bool run_combine_case(
    aclrtStream stream, bool expanded, bool allow_multiple_reduction,
    int num_biases, bool with_weights,
    const deep_ep::ascend::transport::DeviceTransportContext& transport_context) {
    CoreModeFlags flags = expanded ? mode_bit(CoreMode::kExpanded) : 0;
    if (allow_multiple_reduction)
        flags |= mode_bit(CoreMode::kAllowMultipleReduction);
    const auto dispatch_tiling = make_dispatch_tiling(
        expanded ? mode_bit(CoreMode::kExpanded) : 0);
    const auto combine_tiling = make_combine_tiling(flags, transport_context);
    const auto allocation_storage = merge_core_launch_storage(
        required_core_launch_storage(dispatch_tiling),
        required_core_launch_storage(combine_tiling));
    const auto prefix_rank_count =
        static_cast<std::uint64_t>(combine_tiling.topology.world_size);
    DeviceBuffers buffers{};
    if (!allocate_dispatch_buffers(
            dispatch_tiling, allocation_storage, prefix_rank_count, &buffers)) {
        release(&buffers);
        return false;
    }

    std::vector<std::uint16_t> x(kNumTokens * kHidden);
    std::vector<float> weights(kNumTokens * kNumTopk);
    std::vector<std::uint16_t> bias_0(kNumTokens * kHidden);
    std::vector<std::uint16_t> bias_1(kNumTokens * kHidden);
    for (std::uint64_t token = 0; token < kNumTokens; ++token) {
        for (std::uint64_t hidden = 0; hidden < kHidden; ++hidden) {
            x[token * kHidden + hidden] = float_to_bfloat16(
                static_cast<float>(token + 1) +
                static_cast<float>(hidden % 4) * 0.25F);
            bias_0[token * kHidden + hidden] = float_to_bfloat16(1.0F);
            bias_1[token * kHidden + hidden] = float_to_bfloat16(0.5F);
        }
        for (std::uint64_t lane = 0; lane < kNumTopk; ++lane)
            weights[token * kNumTopk + lane] =
                static_cast<float>(token * kNumTopk + lane + 1) / 16.0F;
    }

    bool ok = initialize_dispatch(buffers, dispatch_tiling, x, weights) &&
              launch_dispatch(buffers, dispatch_tiling, stream);
    if (ok) {
        constexpr std::int32_t combine_prefix[2] = {6, 6};
        CHECK_ACL(aclrtMemcpy(
            buffers.prefix_rank, sizeof(combine_prefix), combine_prefix,
            sizeof(combine_prefix), ACL_MEMCPY_HOST_TO_DEVICE));
        CHECK_ACL(aclrtMemcpy(
            buffers.bias_0, bias_0.size() * sizeof(std::uint16_t),
            bias_0.data(), bias_0.size() * sizeof(std::uint16_t),
            ACL_MEMCPY_HOST_TO_DEVICE));
        CHECK_ACL(aclrtMemcpy(
            buffers.bias_1, bias_1.size() * sizeof(std::uint16_t),
            bias_1.data(), bias_1.size() * sizeof(std::uint16_t),
            ACL_MEMCPY_HOST_TO_DEVICE));
        auto* combine_communication = reinterpret_cast<std::uint8_t*>(
            combine_tiling.transport_context.local_window_base);
        CHECK_ACL(aclrtMemset(
            combine_communication, combine_tiling.communication_buffer_bytes,
            0, combine_tiling.communication_buffer_bytes));
        CHECK_ACL(aclrtMemset(
            buffers.combined_x, kNumTokens * kHidden * sizeof(std::uint16_t),
            0, kNumTokens * kHidden * sizeof(std::uint16_t)));
        CHECK_ACL(aclrtMemset(
            buffers.combined_weights, kNumTokens * kNumTopk * sizeof(float),
            0, kNumTokens * kNumTopk * sizeof(float)));

        CombineArguments arguments{};
        arguments.x = buffers.recv_x;
        arguments.topk_weights = with_weights ? buffers.recv_weights : nullptr;
        arguments.source_metadata = buffers.source_metadata;
        arguments.combined_topk_indices = buffers.topk;
        arguments.prefix_per_rank = buffers.prefix_rank;
        arguments.bias_0 = num_biases >= 1 ? buffers.bias_0 : nullptr;
        arguments.bias_1 = num_biases >= 2 ? buffers.bias_1 : nullptr;
        arguments.communication_buffer = combine_communication;
        arguments.workspace = buffers.workspace;
        arguments.combined_x = buffers.combined_x;
        arguments.combined_topk_weights =
            with_weights ? buffers.combined_weights : nullptr;
        arguments.generation = 1;
        arguments.timeout_cycles = 1000000;
        arguments.num_source_rows = 6;
        arguments.num_input_rows = expanded ? kMaxTokens : 6;
        arguments.local_window_base =
            reinterpret_cast<std::uintptr_t>(combine_communication);
        ok = launch_internal_combine(
                 arguments, combine_tiling, allocation_storage, stream).ok() &&
             check_acl(aclrtSynchronizeStream(stream),
                       "aclrtSynchronizeStream", __LINE__);
    }

    std::vector<std::uint16_t> actual(kNumTokens * kHidden);
    std::vector<float> actual_weights(kNumTokens * kNumTopk);
    if (ok) {
        CHECK_ACL(aclrtMemcpy(
            actual.data(), actual.size() * sizeof(std::uint16_t),
            buffers.combined_x, actual.size() * sizeof(std::uint16_t),
            ACL_MEMCPY_DEVICE_TO_HOST));
        CHECK_ACL(aclrtMemcpy(
            actual_weights.data(), actual_weights.size() * sizeof(float),
            buffers.combined_weights,
            actual_weights.size() * sizeof(float),
            ACL_MEMCPY_DEVICE_TO_HOST));

        for (std::uint64_t token = 0; token < kNumTokens && ok; ++token) {
            std::uint64_t valid_experts = 0;
            for (std::uint64_t lane = 0; lane < kNumTopk; ++lane) {
                if (kTopk[token * kNumTopk + lane] >= 0)
                    ++valid_experts;
                const float expected_weight = !with_weights ||
                    kTopk[token * kNumTopk + lane] < 0 ? 0.0F :
                    weights[token * kNumTopk + lane];
                if (actual_weights[token * kNumTopk + lane] !=
                    expected_weight) {
                    std::fprintf(stderr,
                                 "combine weight mismatch at token %llu lane %llu\n",
                                 static_cast<unsigned long long>(token),
                                 static_cast<unsigned long long>(lane));
                    ok = false;
                }
            }
            for (std::uint64_t hidden = 0; hidden < kHidden && ok; ++hidden) {
                const float source = bfloat16_to_float(
                    x[token * kHidden + hidden]);
                float expected = valid_experts == 0 ? 0.0F :
                    source * static_cast<float>(expanded ? valid_experts : 1);
                if (num_biases >= 1)
                    expected += 1.0F;
                if (num_biases >= 2)
                    expected += 0.5F;
                const std::uint16_t expected_bits = float_to_bfloat16(expected);
                if (actual[token * kHidden + hidden] != expected_bits) {
                    std::fprintf(stderr,
                                 "combine payload mismatch at token %llu hidden %llu: actual=%f expected=%f\n",
                                 static_cast<unsigned long long>(token),
                                 static_cast<unsigned long long>(hidden),
                                 bfloat16_to_float(actual[token * kHidden + hidden]),
                                 bfloat16_to_float(expected_bits));
                    ok = false;
                }
            }
        }
    }
    release(&buffers);
    return ok;
}

bool run_combine_cli_case(
    aclrtStream stream, bool expanded, bool allow_multiple_reduction,
    int num_biases, bool with_weights,
    const deep_ep::ascend::transport::DeviceTransportContext*
        transport_context = nullptr) {
    if (transport_context != nullptr)
        return run_combine_case(
            stream, expanded, allow_multiple_reduction, num_biases,
            with_weights,
            *transport_context);
    std::fprintf(
        stderr,
        "combine remote execution is hardware-deferred without an exported "
        "transport context; no combine kernel was launched\n");
    return false;
}

bool run_barrier_local(aclrtStream stream) {
    CoreTilingInput input{};
    input.operation = OperationKind::kBarrier;
    CoreTiling tiling{};
    const auto tiling_status = build_core_tiling(input, &tiling);
    if (!tiling_status.ok()) {
        std::fprintf(stderr, "barrier tiling failed: %s\n",
                     tiling_status.message);
        return false;
    }
    std::uint64_t* workspace = nullptr;
    if (!allocate(&workspace,
                  tiling.workspace_bytes / sizeof(std::uint64_t)))
        return false;
    if (!check_acl(aclrtMemset(
            workspace, tiling.workspace_bytes, 0, tiling.workspace_bytes),
            "aclrtMemset", __LINE__)) {
        (void)aclrtFree(workspace);
        return false;
    }
    const BarrierArguments arguments{workspace, 1, 1000000000ULL};
    const auto storage = required_core_launch_storage(tiling);
    bool ok = launch_internal_barrier(
                  arguments, tiling, storage, stream).ok() &&
              check_acl(aclrtSynchronizeStream(stream),
                        "aclrtSynchronizeStream", __LINE__);
    std::uint64_t observed[2] = {};
    if (ok)
        ok = check_acl(aclrtMemcpy(
            observed, sizeof(observed), workspace, sizeof(observed),
            ACL_MEMCPY_DEVICE_TO_HOST), "aclrtMemcpy", __LINE__);
    ok = ok && observed[0] == 1 && observed[1] == 1;
    (void)aclrtFree(workspace);
    return ok;
}

bool run_adapter_launch_error(aclrtStream stream) {
    CoreTilingInput input{};
    input.operation = OperationKind::kBarrier;
    CoreTiling tiling{};
    if (!build_core_tiling(input, &tiling).ok())
        return false;
    tiling.launch.num_blocks = 0;
    std::uint64_t* workspace = nullptr;
    if (!allocate(&workspace, 2))
        return false;
    const int result = deep_ep_ascend_launch_barrier(
        BarrierArguments{workspace, 1, 1000000000ULL}, tiling, stream);
    if (result == 0)
        (void)aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    (void)aclrtFree(workspace);
    return result != 0;
}

}  // namespace

int main(int argc, char** argv) {
    if (argc != 3 || std::strcmp(argv[1], "--case") != 0) {
        std::fprintf(stderr,
                     "usage: %s --case adapter-launch-error|barrier-local|dispatch-normal|dispatch-expanded|dispatch-cached|dispatch-zero-padding|dispatch-public-identity|dispatch-empty|dispatch-invalid-topk|dispatch-invalid-cache|dispatch-invalid-prefix|dispatch-invalid-slot|dispatch-cached-mixed-rank|hybrid-route-local|hybrid-route-scale-up|hybrid-route-scale-out|hybrid-route-diagonal|hybrid-route-empty|hybrid-route-cached|hybrid-combine-single|hybrid-combine-multiple|combine-state-probe|combine-normal|combine-expanded|combine-multiple|combine-single-reduction|combine-weights|combine-bias0|combine-bias01|round-trip\n",
                     argv[0]);
        return 2;
    }
    const bool known_case =
        std::strcmp(argv[2], "adapter-launch-error") == 0 ||
        std::strcmp(argv[2], "barrier-local") == 0 ||
        std::strcmp(argv[2], "dispatch-normal") == 0 ||
        std::strcmp(argv[2], "dispatch-expanded") == 0 ||
        std::strcmp(argv[2], "dispatch-cached") == 0 ||
        std::strcmp(argv[2], "dispatch-zero-padding") == 0 ||
        std::strcmp(argv[2], "dispatch-public-identity") == 0 ||
        std::strcmp(argv[2], "dispatch-empty") == 0 ||
        std::strcmp(argv[2], "dispatch-invalid-topk") == 0 ||
        std::strcmp(argv[2], "dispatch-invalid-cache") == 0 ||
        std::strcmp(argv[2], "dispatch-invalid-prefix") == 0 ||
        std::strcmp(argv[2], "dispatch-invalid-slot") == 0 ||
        std::strcmp(argv[2], "dispatch-cached-mixed-rank") == 0 ||
        std::strcmp(argv[2], "hybrid-route-local") == 0 ||
        std::strcmp(argv[2], "hybrid-route-scale-up") == 0 ||
        std::strcmp(argv[2], "hybrid-route-scale-out") == 0 ||
        std::strcmp(argv[2], "hybrid-route-diagonal") == 0 ||
        std::strcmp(argv[2], "hybrid-route-empty") == 0 ||
        std::strcmp(argv[2], "hybrid-route-cached") == 0 ||
        std::strcmp(argv[2], "hybrid-combine-single") == 0 ||
        std::strcmp(argv[2], "hybrid-combine-multiple") == 0 ||
        std::strcmp(argv[2], "combine-state-probe") == 0 ||
        std::strcmp(argv[2], "combine-normal") == 0 ||
        std::strcmp(argv[2], "combine-expanded") == 0 ||
        std::strcmp(argv[2], "combine-multiple") == 0 ||
        std::strcmp(argv[2], "combine-single-reduction") == 0 ||
        std::strcmp(argv[2], "combine-weights") == 0 ||
        std::strcmp(argv[2], "combine-bias0") == 0 ||
        std::strcmp(argv[2], "combine-bias01") == 0 ||
        std::strcmp(argv[2], "round-trip") == 0;
    if (!known_case) {
        std::fprintf(stderr, "unknown case: %s\n", argv[2]);
        return 2;
    }

    bool initialized = false;
    bool device_set = false;
    aclrtStream stream = nullptr;
    bool ok = false;
    if (!check_acl(aclInit(nullptr), "aclInit", __LINE__))
        goto cleanup;
    initialized = true;
    if (!check_acl(aclrtSetDevice(0), "aclrtSetDevice", __LINE__))
        goto cleanup;
    device_set = true;
    if (!check_acl(aclrtCreateStream(&stream), "aclrtCreateStream", __LINE__))
        goto cleanup;
    if (std::strcmp(argv[2], "adapter-launch-error") == 0)
        ok = run_adapter_launch_error(stream);
    else if (std::strcmp(argv[2], "barrier-local") == 0)
        ok = run_barrier_local(stream);
    else if (std::strcmp(argv[2], "dispatch-normal") == 0)
        ok = run_dispatch_normal(stream);
    else if (std::strcmp(argv[2], "dispatch-expanded") == 0)
        ok = run_dispatch_expanded(stream, false, false);
    else if (std::strcmp(argv[2], "dispatch-cached") == 0)
        ok = run_dispatch_expanded(stream, true, false);
    else if (std::strcmp(argv[2], "dispatch-zero-padding") == 0)
        ok = run_dispatch_expanded(stream, true, true);
    else if (std::strcmp(argv[2], "dispatch-public-identity") == 0)
        ok = run_dispatch_public_identity(stream);
    else if (std::strcmp(argv[2], "dispatch-empty") == 0)
        ok = run_dispatch_empty(stream);
    else if (std::strcmp(argv[2], "dispatch-invalid-topk") == 0)
        ok = run_dispatch_invalid_topk(stream);
    else if (std::strcmp(argv[2], "dispatch-invalid-cache") == 0)
        ok = run_dispatch_invalid_cache(stream);
    else if (std::strcmp(argv[2], "dispatch-invalid-prefix") == 0)
        ok = run_dispatch_invalid_prefix(stream);
    else if (std::strcmp(argv[2], "dispatch-invalid-slot") == 0)
        ok = run_dispatch_invalid_slot(stream);
    else if (std::strcmp(argv[2], "dispatch-cached-mixed-rank") == 0)
        ok = run_dispatch_cached_mixed_rank(stream);
    else if (std::strcmp(argv[2], "hybrid-route-local") == 0)
        ok = run_hybrid_route_probe(stream, runner::kHybridRouteLocalProbe);
    else if (std::strcmp(argv[2], "hybrid-route-scale-up") == 0)
        ok = run_hybrid_route_probe(stream, runner::kHybridRouteScaleUpProbe);
    else if (std::strcmp(argv[2], "hybrid-route-scale-out") == 0)
        ok = run_hybrid_route_probe(stream, runner::kHybridRouteScaleOutProbe);
    else if (std::strcmp(argv[2], "hybrid-route-diagonal") == 0)
        ok = run_hybrid_route_probe(stream, runner::kHybridRouteDiagonalProbe);
    else if (std::strcmp(argv[2], "hybrid-route-empty") == 0)
        ok = run_hybrid_route_probe(stream, runner::kHybridRouteEmptyProbe);
    else if (std::strcmp(argv[2], "hybrid-route-cached") == 0)
        ok = run_hybrid_route_probe(stream, runner::kHybridRouteCachedProbe);
    else if (std::strcmp(argv[2], "hybrid-combine-single") == 0)
        ok = run_hybrid_route_probe(stream, runner::kHybridCombineSingleProbe);
    else if (std::strcmp(argv[2], "hybrid-combine-multiple") == 0)
        ok = run_hybrid_route_probe(
            stream, runner::kHybridCombineMultipleProbe);
    else if (std::strcmp(argv[2], "combine-state-probe") == 0)
        ok = run_combine_state_probe(stream);
    else if (std::strcmp(argv[2], "combine-normal") == 0)
        ok = run_combine_cli_case(stream, false, false, 0, false);
    else if (std::strcmp(argv[2], "combine-expanded") == 0)
        ok = run_combine_cli_case(stream, true, true, 0, false);
    else if (std::strcmp(argv[2], "combine-single-reduction") == 0)
        ok = run_combine_cli_case(stream, true, false, 0, false);
    else if (std::strcmp(argv[2], "combine-multiple") == 0)
        ok = run_combine_cli_case(stream, true, true, 0, false);
    else if (std::strcmp(argv[2], "combine-bias0") == 0)
        ok = run_combine_cli_case(stream, false, false, 1, false);
    else if (std::strcmp(argv[2], "combine-bias01") == 0)
        ok = run_combine_cli_case(stream, false, false, 2, false);
    else
        ok = run_combine_cli_case(stream, false, false, 0, true);

cleanup:
    if (stream != nullptr)
        (void)aclrtDestroyStream(stream);
    if (device_set)
        (void)aclrtResetDevice(0);
    if (initialized)
        (void)aclFinalize();
    std::printf("case=%s %s\n", argv[2],
                ok ? "Verification PASSED" : "Verification FAILED");
    return ok ? 0 : 1;
}
