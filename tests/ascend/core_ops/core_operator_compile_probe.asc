#include <cstdint>

#include "simt_api/asc_simt.h"

#include "csrc/backends/ascend/elastic/kernels.hpp"

namespace deep_ep::ascend::elastic::probe {

__simt_vf__ inline void core_operator_compile_probe_vf(
    __gm__ std::uint32_t* output, ElementKind element_kind) {
    if (threadIdx.x == 0) {
        const auto deferred =
            (CoreModeFlags{1} << static_cast<std::uint8_t>(CoreMode::kAsyncEvent)) |
            (CoreModeFlags{1} << static_cast<std::uint8_t>(CoreMode::kCpuSync)) |
            (CoreModeFlags{1} << static_cast<std::uint8_t>(CoreMode::kHybrid)) |
            (CoreModeFlags{1} << static_cast<std::uint8_t>(CoreMode::kPipeline)) |
            (CoreModeFlags{1} << static_cast<std::uint8_t>(CoreMode::kEngram));
        const std::uint32_t fp8 =
            element_kind == ElementKind::kFloat8E4M3 ? 1U : 0U;
        output[0] = fp8 | deferred;
    }
}

__global__ __vector__ void core_operator_compile_probe_kernel(
    __gm__ std::uint32_t* output, CoreTiling tiling) {
    asc_vf_call<core_operator_compile_probe_vf>(
        dim3(1), output, tiling.element_kind);
}

__global__ __vector__ void direct_dispatch_pipeline_compile_probe_kernel(
    __gm__ std::uint32_t* output, CoreTiling tiling) {
    asc_vf_call<core_operator_compile_probe_vf>(
        dim3(1), output,
        tiling.data_launch.num_blocks == 72 ? tiling.element_kind :
                                             ElementKind::kBFloat16);
}

inline CoreLaunchShape direct_combine_pipeline_compile_probe(
    const CoreTiling& tiling) {
    const auto pipeline = direct_combine_pipeline();
    return pipeline.count == 7 ?
        direct_combine_stage_launch(
            tiling, DirectCombineStage::kEpilogueReduce) :
        CoreLaunchShape{};
}

}  // namespace deep_ep::ascend::elastic::probe
