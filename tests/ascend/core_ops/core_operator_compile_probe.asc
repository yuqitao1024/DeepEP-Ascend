#include <cstdint>

#include "kernel_operator.h"
#include "simt_api/asc_simt.h"

#include "csrc/backends/ascend/elastic/kernels.hpp"

namespace deep_ep::ascend::elastic::probe {

constexpr std::uint32_t kCombineVectorTileElements = 256;

__aicore__ inline void direct_combine_vector_payload_compile_probe(
    __gm__ bfloat16_t* output, __gm__ const bfloat16_t* input) {
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> input_queue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> output_queue;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> scratch_buffer;
    (void)pipe.InitBuffer(
        input_queue, 1,
        kCombineVectorTileElements * sizeof(bfloat16_t));
    (void)pipe.InitBuffer(
        output_queue, 1,
        kCombineVectorTileElements * sizeof(bfloat16_t));
    (void)pipe.InitBuffer(
        scratch_buffer,
        2 * kCombineVectorTileElements * sizeof(float));

    AscendC::GlobalTensor<bfloat16_t> input_global;
    AscendC::GlobalTensor<bfloat16_t> output_global;
    input_global.SetGlobalBuffer(
        const_cast<__gm__ bfloat16_t*>(input),
        kCombineVectorTileElements);
    output_global.SetGlobalBuffer(output, kCombineVectorTileElements);

    auto input_local = input_queue.AllocTensor<bfloat16_t>();
    AscendC::DataCopy(
        input_local, input_global, kCombineVectorTileElements);
    input_queue.EnQue(input_local);
    input_local = input_queue.DeQue<bfloat16_t>();

    auto scratch = scratch_buffer.Get<float>();
    auto accumulation = scratch;
    auto contribution = scratch[kCombineVectorTileElements];
    AscendC::Duplicate(
        accumulation, 0.0F,
        static_cast<std::int32_t>(kCombineVectorTileElements));
    AscendC::Cast(
        contribution, input_local, AscendC::RoundMode::CAST_NONE,
        kCombineVectorTileElements);
    AscendC::Add(
        accumulation, accumulation, contribution,
        static_cast<std::int32_t>(kCombineVectorTileElements));
    input_queue.FreeTensor(input_local);

    auto output_local = output_queue.AllocTensor<bfloat16_t>();
    AscendC::Cast(
        output_local, accumulation, AscendC::RoundMode::CAST_RINT,
        kCombineVectorTileElements);
    output_queue.EnQue(output_local);
    output_local = output_queue.DeQue<bfloat16_t>();
    AscendC::DataCopy(
        output_global, output_local, kCombineVectorTileElements);
    output_queue.FreeTensor(output_local);
}

__simt_vf__ inline void core_operator_compile_probe_vf(
    __gm__ std::uint32_t* output, ElementKind element_kind) {
    if (threadIdx.x == 0) {
        const auto deferred =
            (CoreModeFlags{1} << static_cast<std::uint8_t>(CoreMode::kAsyncEvent)) |
            (CoreModeFlags{1} << static_cast<std::uint8_t>(CoreMode::kCpuSync)) |
            (CoreModeFlags{1} << static_cast<std::uint8_t>(CoreMode::kHybrid)) |
            (CoreModeFlags{1} << static_cast<std::uint8_t>(CoreMode::kPipeline)) |
            (CoreModeFlags{1} << static_cast<std::uint8_t>(CoreMode::kEngram));
        const std::uint32_t fp8 =
            element_kind == ElementKind::kFloat8E4M3 ? 1U : 0U;
        output[0] = fp8 | deferred;
    }
}

__global__ __vector__ void core_operator_compile_probe_kernel(
    __gm__ std::uint32_t* output, CoreTiling tiling) {
    asc_vf_call<core_operator_compile_probe_vf>(
        dim3(1), output, tiling.element_kind);
}

__global__ __vector__ void direct_dispatch_pipeline_compile_probe_kernel(
    __gm__ std::uint32_t* output, CoreTiling tiling) {
    asc_vf_call<core_operator_compile_probe_vf>(
        dim3(1), output,
        tiling.data_launch.num_blocks == 72 ? tiling.element_kind :
                                             ElementKind::kBFloat16);
}

__global__ __vector__ void direct_combine_vector_payload_compile_probe_kernel(
    __gm__ std::uint16_t* output, __gm__ const std::uint16_t* input) {
    direct_combine_vector_payload_compile_probe(
        reinterpret_cast<__gm__ bfloat16_t*>(output),
        reinterpret_cast<__gm__ const bfloat16_t*>(input));
}

inline CoreLaunchShape direct_combine_pipeline_compile_probe(
    const CoreTiling& tiling) {
    const auto pipeline = direct_combine_pipeline();
    return pipeline.count == 7 ?
        direct_combine_stage_launch(
            tiling, DirectCombineStage::kEpilogueReduce) :
        CoreLaunchShape{};
}

}  // namespace deep_ep::ascend::elastic::probe
