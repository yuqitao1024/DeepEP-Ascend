#include "simt_api/asc_simt.h"

#define DEEP_EP_ASCEND_SIMT_DEVICE 1
#include "csrc/backends/ascend/transport/device_transport_facade.hpp"

namespace deep_ep::ascend::transport::probe {

__simt_vf__ inline void transport_semantic_probe_vf(
    __gm__ std::uint64_t* storage, __gm__ DeviceRequest* request,
    DeviceTransportContext context) {
    DeviceTransportFacade transport(context, 0);
    const DeviceAddress storage_address =
        reinterpret_cast<DeviceAddress>(storage);

    const bool local = transport.is_peer_directly_accessible(
        TransportTeam::kWorld, context.topology.world_rank);
    DeviceAddress direct_pointer = transport.get_symmetric_pointer(
        TransportTeam::kScaleUp, context.topology.scale_up_rank,
        storage_address);
    DeviceAddress fallback_pointer = transport.get_symmetric_pointer(
        TransportTeam::kScaleOut, context.topology.scale_out_rank + 1,
        storage_address);
    const std::uint64_t offset =
        transport.get_symmetric_offset(storage_address);

    if (local && direct_pointer != kNullDeviceAddress &&
        fallback_pointer == kNullDeviceAddress) {
        transport.put_value(
            TransportTeam::kScaleUp, context.topology.scale_up_rank,
            direct_pointer, offset, sizeof(std::uint64_t), kDefaultOptions);
    } else {
        transport.put(
            TransportTeam::kWorld, 0, storage_address, storage_address,
            sizeof(std::uint64_t),
            CooperationScope::kParticipant, MemorySegment::kDevice,
            kDefaultOptions, RemoteAction::none());
    }

    transport.put(
        TransportTeam::kScaleOut, 0, storage_address, storage_address,
        sizeof(std::uint64_t),
        CooperationScope::kWorkgroup, MemorySegment::kMixed,
        kAggregateRequests, RemoteAction::signal_add(offset, 1));
    transport.get(
        TransportTeam::kWorld, 0, storage_address, storage_address,
        sizeof(std::uint64_t),
        CooperationScope::kDevice, MemorySegment::kDevice,
        kDefaultOptions);
    transport.remote_add_release(
        TransportTeam::kScaleUp, 0, storage_address, 1);
    transport.signal(
        TransportTeam::kScaleOut, 0, RemoteAction::signal_increment(3));
    const SignalValue signal_value = transport.read_signal(
        TransportTeam::kWorld, 0, 3);
    transport.wait_signal(
        TransportTeam::kWorld, 0, 3, signal_value + 1, 1000);

    transport.flush(CooperationScope::kParticipant);
    transport.flush(CooperationScope::kWorkgroup);
    transport.flush(CooperationScope::kDevice);
    transport.flush_async(
        TransportTeam::kWorld, 0, CooperationScope::kParticipant, request);
    transport.flush_async(
        TransportTeam::kScaleOut, 0, CooperationScope::kWorkgroup, request);
    transport.wait(request);

    const std::uint64_t observed = transport.load_acquire(storage_address);
    transport.store_release(storage_address, observed);
    transport.system_fence();
    transport.device_barrier(1, storage_address, 1000);
}

__global__ __vector__ void transport_semantic_probe_kernel(
    __gm__ std::uint64_t* storage, __gm__ DeviceRequest* request,
    DeviceTransportContext context) {
    asc_vf_call<transport_semantic_probe_vf>(
        dim3(1), storage, request, context);
}

}  // namespace deep_ep::ascend::transport::probe
