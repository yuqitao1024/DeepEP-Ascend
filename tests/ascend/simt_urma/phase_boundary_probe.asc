#include <cstdint>

#include "kernel_operator.h"
#include "simt_api/asc_simt.h"

#define DEEP_EP_ASCEND_SIMT_DEVICE 1
#include "csrc/backends/ascend/transport/simt_intrinsics.hpp"
#include "csrc/backends/ascend/transport/aicore_intrinsics.hpp"

namespace deep_ep::ascend::transport::probe {

struct alignas(64) PhaseState {
    std::uint32_t sequence;
    std::uint32_t payload;
    std::uint32_t result;
};

__simt_vf__ inline void publish_command_vf(__gm__ PhaseState* state) {
    if (threadIdx.x != 0)
        return;

    simt::store_published(&state->payload, std::uint32_t{0x12345678U});
    simt::system_fence();
    simt::store_published(&state->sequence, std::uint32_t{1});
}

__simt_vf__ inline void observe_result_vf(__gm__ PhaseState* state) {
    if (threadIdx.x != 0)
        return;

    const auto result = simt::load_observed(&state->result);
    simt::store_published(&state->sequence,
                          result == 0x12345678U ? std::uint32_t{2}
                                                : std::uint32_t{0xffffffffU});
}

__global__ __vector__ void phase_boundary_probe_kernel(
    __gm__ PhaseState* state, __gm__ std::uint32_t* scratch_doorbell) {
    asc_vf_call<publish_command_vf>(dim3(1), state);

    aicore::flush_cacheline(state);
    if (aicore::load_device(&state->sequence) == 1) {
        state->result = aicore::load_device(&state->payload);
        aicore::system_fence();
        aicore::flush_cacheline(state);
        aicore::store_device(scratch_doorbell, std::uint32_t{1});
    }

    asc_vf_call<observe_result_vf>(dim3(1), state);
}

}  // namespace deep_ep::ascend::transport::probe
