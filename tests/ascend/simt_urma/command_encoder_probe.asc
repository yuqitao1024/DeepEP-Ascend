#include <cstdint>

#include "kernel_operator.h"
#include "simt_api/asc_simt.h"

#define DEEP_EP_ASCEND_SIMT_DEVICE 1
#define DEEP_EP_ASCEND_STAGED_URMA 1
#define DEEP_EP_ASCEND_AICORE_URMA_SERVICE 1
#include "csrc/backends/ascend/transport/device_transport_commands.hpp"
#include "csrc/backends/ascend/transport/device_transport_facade.hpp"
#include "csrc/backends/ascend/transport/aicore_intrinsics.hpp"

namespace deep_ep::ascend::transport::probe {

struct alignas(64) CommandEncoderState {
    TransportCommand commands[8];
    TransportCommandQueue queue;
    TransportServiceState service;
    DeviceTransportDiagnostic diagnostic;
    StagedTransportContext staged;
    DeviceRequest request;
    std::uint32_t result;
};

__simt_vf__ inline void record_commands_vf(
    __gm__ CommandEncoderState* state, DeviceTransportContext context) {
    if (threadIdx.x != 0)
        return;

    DeviceTransportFacade transport(context, 0);
    transport.put(
        TransportTeam::kScaleOut, 1, 0x1110, 0x2220, 96,
        CooperationScope::kParticipant, MemorySegment::kDevice,
        kDefaultOptions, RemoteAction::none());
    transport.put_value(
        TransportTeam::kScaleUp, 1, 0x3330,
        0xa5a5a5a55a5a5a5aULL, sizeof(std::uint64_t), kDefaultOptions);
    transport.remote_add_release(
        TransportTeam::kWorld, 1, 0x4440, -7);
    transport.signal(
        TransportTeam::kWorld, 1, RemoteAction::signal_increment(3));
    transport.flush(CooperationScope::kDevice);
    transport.device_barrier(1, 0x5550, 1234);

    transport.get(
        TransportTeam::kWorld, 1, 0x1110, 0x2220, 8,
        CooperationScope::kParticipant, MemorySegment::kDevice,
        kDefaultOptions);
    transport.flush_async(
        TransportTeam::kWorld, 1, CooperationScope::kParticipant,
        &state->request);
    simt::store_published(&state->service.consumed_count, std::uint32_t{7});
    simt::store_published(&state->service.consumed_generation,
                          std::uint64_t{17});
    transport.wait(&state->request);

    transport.put_value(
        TransportTeam::kWorld, 1, 0x6660, 7, sizeof(std::uint32_t),
        kDefaultOptions);
    transport.put(
        TransportTeam::kWorld, 9, 0x7770, 0x8880, 8,
        CooperationScope::kParticipant, MemorySegment::kDevice,
        kDefaultOptions, RemoteAction::none());
}

__simt_vf__ inline void check_commands_vf(
    __gm__ CommandEncoderState* state) {
    if (threadIdx.x != 0)
        return;

    bool valid = simt::load_observed(&state->queue.count) == 7;
    valid = valid && simt::load_observed(&state->queue.generation) == 17;
    valid = valid && simt::load_observed(
        reinterpret_cast<__gm__ std::uint32_t*>(&state->commands[0].opcode)) ==
        static_cast<std::uint32_t>(TransportCommandOpcode::kPut);
    valid = valid && simt::load_observed(&state->commands[0].source) == 0x2220;
    valid = valid && simt::load_observed(&state->commands[0].destination) ==
                         0x1110;
    valid = valid && simt::load_observed(&state->commands[0].bytes) == 96;
    valid = valid && simt::load_observed(&state->commands[0].peer) == 1;
    valid = valid && simt::load_observed(&state->commands[0].world_peer) == 3;
    valid = valid && simt::load_observed(
        reinterpret_cast<__gm__ std::uint8_t*>(&state->commands[0].team)) ==
        static_cast<std::uint8_t>(TransportTeam::kScaleOut);
    valid = valid && simt::load_observed(
        reinterpret_cast<__gm__ std::uint32_t*>(&state->commands[1].opcode)) ==
        static_cast<std::uint32_t>(TransportCommandOpcode::kPutValue64);
    valid = valid && simt::load_observed(&state->commands[1].value) ==
                         0xa5a5a5a55a5a5a5aULL;
    valid = valid && simt::load_observed(
        reinterpret_cast<__gm__ std::uint32_t*>(&state->commands[2].opcode)) ==
        static_cast<std::uint32_t>(TransportCommandOpcode::kRemoteAdd64);
    valid = valid && static_cast<std::int64_t>(
        simt::load_observed(&state->commands[2].value)) == -7;
    valid = valid && simt::load_observed(
        reinterpret_cast<__gm__ std::uint32_t*>(&state->commands[3].opcode)) ==
        static_cast<std::uint32_t>(TransportCommandOpcode::kSignal);
    valid = valid && simt::load_observed(&state->commands[3].signal_index) == 3;
    valid = valid && simt::load_observed(
        reinterpret_cast<__gm__ std::uint32_t*>(&state->commands[4].opcode)) ==
        static_cast<std::uint32_t>(TransportCommandOpcode::kFlush);
    valid = valid && simt::load_observed(
        reinterpret_cast<__gm__ std::uint32_t*>(&state->commands[5].opcode)) ==
        static_cast<std::uint32_t>(TransportCommandOpcode::kBarrier);
    valid = valid && simt::load_observed(&state->commands[5].timeout_cycles) ==
                         1234;
    valid = valid && simt::load_observed(
        reinterpret_cast<__gm__ std::uint32_t*>(&state->commands[6].opcode)) ==
        static_cast<std::uint32_t>(TransportCommandOpcode::kFlush);
    valid = valid && simt::load_observed(
        reinterpret_cast<__gm__ std::uint32_t*>(&state->request.state)) ==
        static_cast<std::uint32_t>(DeviceRequestState::kCompleted);
    valid = valid && simt::load_observed(&state->request.command_begin) == 6;
    valid = valid && simt::load_observed(&state->request.command_end) == 7;
    valid = valid && simt::load_observed(&state->request.queue_generation) ==
                         17;
    valid = valid && simt::load_observed(&state->request.consumed_target) == 7;
    valid = valid && simt::load_observed(
        reinterpret_cast<__gm__ std::uint32_t*>(
            &state->request.terminal_error)) ==
        static_cast<std::uint32_t>(DeviceTransportError::kNone);
    valid = valid && simt::load_observed(
        reinterpret_cast<__gm__ std::uint32_t*>(&state->diagnostic.error)) ==
        static_cast<std::uint32_t>(DeviceTransportError::kUnsupportedOperation);
    valid = valid && simt::load_observed(
        reinterpret_cast<__gm__ std::uint32_t*>(&state->diagnostic.opcode)) ==
        static_cast<std::uint32_t>(TransportCommandOpcode::kPutValue64);
    simt::store_published(
        &state->result, valid ? std::uint32_t{1} : std::uint32_t{0xffffffffU});
}

__global__ __vector__ void command_encoder_probe_kernel(
    __gm__ CommandEncoderState* state) {
    state->queue.abi_version = kTransportCommandAbiVersion;
    state->queue.struct_size = sizeof(TransportCommandQueue);
    state->queue.capacity = 8;
    state->queue.count = 0;
    state->queue.generation = 17;
    state->queue.commands = reinterpret_cast<std::uintptr_t>(state->commands);
    state->queue.service_state =
        reinterpret_cast<std::uintptr_t>(&state->service);
    state->queue.diagnostic =
        reinterpret_cast<std::uintptr_t>(&state->diagnostic);

    state->service.abi_version = kTransportCommandAbiVersion;
    state->service.struct_size = sizeof(TransportServiceState);
    state->service.consumed_count = 0;
    state->service.active = 0;
    state->service.consumed_generation = 0;
    state->service.default_retry_limit = 1000000;

    state->staged.abi_version = kTransportCommandAbiVersion;
    state->staged.struct_size = sizeof(StagedTransportContext);
    state->staged.cann_compatibility =
        kStagedTransportCannCompatibility;
    state->staged.command_queue =
        reinterpret_cast<std::uintptr_t>(&state->queue);
    state->staged.reserved = command::aicore_registration_cookie(
        state->staged.command_queue, state->queue.commands,
        state->queue.service_state, state->queue.diagnostic,
        state->queue.capacity);

    DeviceTransportContext facade{};
    facade.abi_version = kDeviceTransportAbiVersion;
    facade.struct_size = sizeof(DeviceTransportContext);
    facade.topology.world_rank = 1;
    facade.topology.world_size = 4;
    facade.topology.scale_up_rank = 1;
    facade.topology.scale_up_size = 2;
    facade.topology.scale_out_rank = 0;
    facade.topology.scale_out_size = 2;
    facade.topology.struct_size = sizeof(TransportTopology);
    facade.topology.kind = TransportTopologyKind::kLogicalSimulation;
    facade.topology.epoch = 1;
    facade.backend_context =
        reinterpret_cast<std::uintptr_t>(&state->staged);

    state->diagnostic.abi_version = kTransportCommandAbiVersion;
    state->diagnostic.error = DeviceTransportError::kNone;
    state->diagnostic.generation = 17;
    state->request.abi_version = kDeviceRequestAbiVersion;
    state->request.state = DeviceRequestState::kEmpty;
    state->request.command_begin = 0;
    state->request.command_end = 0;
    state->request.queue_generation = 0;
    state->request.consumed_target = 0;
    state->request.terminal_error = DeviceTransportError::kNone;
    aicore::system_fence();
    aicore::flush_cacheline(state);

    asc_vf_call<record_commands_vf>(dim3(1), state, facade);
    asc_vf_call<check_commands_vf>(dim3(1), state);
}

}  // namespace deep_ep::ascend::transport::probe
