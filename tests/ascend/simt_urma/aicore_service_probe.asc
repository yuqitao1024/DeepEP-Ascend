#include <cstdint>

#include "kernel_operator.h"
#include "simt_api/asc_simt.h"

#define DEEP_EP_ASCEND_SIMT_DEVICE 1
#define DEEP_EP_ASCEND_STAGED_URMA 1
#define DEEP_EP_ASCEND_AICORE_URMA_SERVICE 1
#include "csrc/backends/ascend/elastic/tiling.hpp"
#include "csrc/backends/ascend/transport/device_transport_facade.hpp"
#include "csrc/backends/ascend/transport/aicore_transport_service.hpp"

namespace deep_ep::ascend::transport::probe {

struct alignas(64) ServiceProbeState {
    TransportCommand commands[4];
    TransportCommandQueue queue;
    TransportServiceState service;
    DeviceTransportDiagnostic diagnostic;
    TransportStageProfile profile;
    StagedTransportContext staged;
    std::uint32_t result;
};

__simt_vf__ inline void service_producer_vf(
    __gm__ ServiceProbeState* state, DeviceTransportContext context) {
    if (threadIdx.x != 0)
        return;
    DeviceTransportFacade transport(context, 0);
    transport.flush(CooperationScope::kParticipant);
}

__simt_vf__ inline void service_consumer_vf(
    __gm__ ServiceProbeState* state) {
    if (threadIdx.x != 0)
        return;
    const bool valid =
        simt::load_observed(&state->service.consumed_generation) == 1 &&
        simt::load_observed(&state->profile.generation) == 1 &&
        simt::load_observed(&state->profile.completion_generation) == 1 &&
        simt::load_observed(&state->profile.command_count) == 1 &&
        simt::load_observed(&state->profile.command_bytes) == 0 &&
        simt::load_observed(&state->profile.service_start_cycles) != 0 &&
        simt::load_observed(&state->profile.service_end_cycles) >=
            simt::load_observed(&state->profile.service_start_cycles) &&
        simt::load_observed(&state->profile.payload_command_cycles) == 0 &&
        simt::load_observed(&state->profile.control_command_cycles) == 0 &&
        simt::load_observed(&state->profile.flush_command_cycles) == 0 &&
        simt::load_observed(&state->profile.barrier_command_cycles) == 0 &&
        simt::load_observed(&state->profile.barrier_poll_cycles) == 0;
    simt::store_published(
        &state->result, valid ? std::uint32_t{1} : std::uint32_t{0xffffffffU});
}

__global__ __vector__ void aicore_service_probe_kernel(
    __gm__ ServiceProbeState* state, elastic::CoreTiling tiling) {
    state->queue.abi_version = kTransportCommandAbiVersion;
    state->queue.struct_size = sizeof(TransportCommandQueue);
    state->queue.capacity = 4;
    state->queue.commands = reinterpret_cast<std::uintptr_t>(state->commands);
    state->queue.service_state =
        reinterpret_cast<std::uintptr_t>(&state->service);
    state->queue.diagnostic =
        reinterpret_cast<std::uintptr_t>(&state->diagnostic);
    state->service.abi_version = kTransportCommandAbiVersion;
    state->service.struct_size = sizeof(TransportServiceState);
    state->diagnostic.abi_version = kTransportCommandAbiVersion;
    state->staged.abi_version = kTransportCommandAbiVersion;
    state->staged.struct_size = sizeof(StagedTransportContext);
    state->staged.cann_compatibility = kStagedTransportCannCompatibility;
    state->staged.command_queue =
        reinterpret_cast<std::uintptr_t>(&state->queue);
    state->staged.stage_profile =
        reinterpret_cast<std::uintptr_t>(&state->profile);
    state->staged.stage_profile_bytes = sizeof(TransportStageProfile);
    state->staged.reserved = command::aicore_registration_cookie(
        state->staged.command_queue, state->queue.commands,
        state->queue.service_state, state->queue.diagnostic,
        state->queue.capacity);

    auto& context = tiling.transport_context;
    context.abi_version = kDeviceTransportAbiVersion;
    context.struct_size = sizeof(DeviceTransportContext);
    context.topology.world_size = 1;
    context.topology.scale_up_size = 1;
    context.topology.scale_out_size = 1;
    context.backend_context =
        reinterpret_cast<std::uintptr_t>(&state->staged);

    service::begin_profile(context, TransportProfileOperation::kBarrier, 1);
    service::reset(context, 1);
    asc_vf_call<service_producer_vf>(dim3(1), state, context);
    service::execute(context);
    service::complete_profile(context, 1);
    asc_vf_call<service_consumer_vf>(dim3(1), state);
}

}  // namespace deep_ep::ascend::transport::probe
