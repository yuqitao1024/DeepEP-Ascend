#include <cstdint>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"

#define DEEP_EP_ASCEND_SIMT_DEVICE 1
#define DEEP_EP_ASCEND_STAGED_URMA 1
#define DEEP_EP_ASCEND_AICORE_URMA_SERVICE 1
#define DEEP_EP_ASCEND_AICORE_WQE_CALLEE __aicore__
#include "csrc/backends/ascend/transport/aicore_transport_service.hpp"
#include "csrc/backends/ascend/transport/device_transport_facade.hpp"
#include "runtime_probe.hpp"

namespace deep_ep::ascend::transport::runtime_probe {
namespace {

inline constexpr std::uint64_t kPhasePayload = 0x13579bdf2468ace0ULL;
inline constexpr std::uint64_t kBarrierTimeout = 100000000ULL;

__simt_vf__ inline void producer_vf(
    __gm__ RuntimeState* state, DeviceTransportContext context,
    RuntimeCase runtime_case, std::uint32_t peer, std::uint64_t generation,
    std::uint32_t operation_count, bool finalize_profile_pressure) {
    if (threadIdx.x != 0)
        return;
    if (runtime_case == RuntimeCase::kPhaseBoundary) {
        simt::store_published(&state->phase_payload, kPhasePayload);
        simt::system_fence();
        simt::store_published(&state->phase_sequence, std::uint32_t{1});
        return;
    }

    DeviceTransportFacade transport(context, 0);
    TeamPeer signal_route{};
    if (!device::detail::checked_device_team_peer_for_world_rank(
            context.topology, static_cast<int>(peer), &signal_route))
        return;
    if (runtime_case == RuntimeCase::kProfileMixed) {
        if (!finalize_profile_pressure) {
            for (std::uint32_t operation = 0; operation < operation_count;
                 ++operation) {
                transport.put(
                    TransportTeam::kWorld, static_cast<int>(peer),
                    reinterpret_cast<DeviceAddress>(&state->destination),
                    reinterpret_cast<DeviceAddress>(&state->source),
                    sizeof(std::uint64_t), CooperationScope::kParticipant,
                    MemorySegment::kDevice, kDefaultOptions,
                    RemoteAction::none());
            }
            return;
        }
        enqueue_profile_mixed_final_commands(
            transport, static_cast<int>(peer),
            reinterpret_cast<DeviceAddress>(&state->destination),
            reinterpret_cast<DeviceAddress>(&state->source), state->source,
            reinterpret_cast<DeviceAddress>(&state->atomic_value),
            signal_route, generation, kBarrierTimeout);
        return;
    }
    transport.device_barrier(
        kWorldTeamMask, kNullDeviceAddress, kBarrierTimeout);
    for (std::uint32_t operation = 0; operation < operation_count;
         ++operation) {
        if (runtime_case == RuntimeCase::kPut ||
            runtime_case == RuntimeCase::kFlush ||
            runtime_case == RuntimeCase::kPayloadSignalOrder ||
            runtime_case == RuntimeCase::kQueueWrap) {
            transport.put(
                TransportTeam::kWorld, static_cast<int>(peer),
                reinterpret_cast<DeviceAddress>(&state->destination),
                reinterpret_cast<DeviceAddress>(&state->source),
                sizeof(std::uint64_t), CooperationScope::kParticipant,
                MemorySegment::kDevice, kDefaultOptions,
                RemoteAction::none());
        } else if (runtime_case == RuntimeCase::kPutValue64) {
            transport.put_value(
                TransportTeam::kWorld, static_cast<int>(peer),
                reinterpret_cast<DeviceAddress>(&state->destination),
                state->source, sizeof(std::uint64_t), kDefaultOptions);
        } else if (runtime_case == RuntimeCase::kFaa64) {
            transport.remote_add_release(
                TransportTeam::kWorld, static_cast<int>(peer),
                reinterpret_cast<DeviceAddress>(&state->atomic_value), 1);
        } else if (runtime_case == RuntimeCase::kSignal) {
            transport.signal(
                signal_route.team, signal_route.peer,
                RemoteAction::signal_increment(0));
        } else if (runtime_case == RuntimeCase::kSignalSet) {
            transport.signal(
                signal_route.team, signal_route.peer,
                RemoteAction::signal_set(0, generation));
        }
    }
    if (runtime_case == RuntimeCase::kPayloadSignalOrder) {
        transport.signal(
            signal_route.team, signal_route.peer,
            RemoteAction::signal_increment(0));
    }
    if (runtime_case == RuntimeCase::kFlush)
        transport.flush(CooperationScope::kParticipant);
    transport.device_barrier(
        kWorldTeamMask, kNullDeviceAddress, kBarrierTimeout);
    (void)generation;
}

__simt_vf__ inline void consumer_vf(
    __gm__ RuntimeState* state, DeviceTransportContext context,
    RuntimeCase runtime_case, std::uint32_t peer, std::uint64_t generation,
    std::uint64_t expected, bool finalize_profile_pressure) {
    if (threadIdx.x != 0)
        return;

    bool valid = simt::load_observed(
        reinterpret_cast<__gm__ std::uint32_t*>(&state->diagnostic.error)) ==
        static_cast<std::uint32_t>(DeviceTransportError::kNone);
    std::uint64_t observed = 0;
    if (runtime_case == RuntimeCase::kPut ||
        runtime_case == RuntimeCase::kPutValue64 ||
        runtime_case == RuntimeCase::kFlush ||
        runtime_case == RuntimeCase::kQueueWrap) {
        observed = simt::load_observed(&state->destination);
        valid = valid && observed == expected;
    } else if (runtime_case == RuntimeCase::kFaa64) {
        observed = simt::load_observed(&state->atomic_value);
        valid = valid && observed == 1;
    } else if (runtime_case == RuntimeCase::kProfileMixed &&
               finalize_profile_pressure) {
        observed = simt::load_observed(&state->destination);
        DeviceTransportFacade transport(context, 0);
        TeamPeer signal_route{};
        if (!device::detail::checked_device_team_peer_for_world_rank(
                context.topology, static_cast<int>(peer), &signal_route))
            return;
        transport.wait_signal(
            signal_route.team, signal_route.peer, 0, generation,
            kBarrierTimeout);
        valid = valid && observed == expected &&
            simt::load_observed(&state->atomic_value) == 1 &&
            transport.read_signal(
                signal_route.team, signal_route.peer, 0) >= generation;
    } else if (runtime_case == RuntimeCase::kSignal ||
               runtime_case == RuntimeCase::kSignalSet ||
               runtime_case == RuntimeCase::kPayloadSignalOrder) {
        DeviceTransportFacade transport(context, 0);
        TeamPeer signal_route{};
        if (!device::detail::checked_device_team_peer_for_world_rank(
                context.topology, static_cast<int>(peer), &signal_route))
            return;
        transport.wait_signal(
            signal_route.team, signal_route.peer, 0, generation,
            kBarrierTimeout);
        observed = transport.read_signal(
            signal_route.team, signal_route.peer, 0);
        valid = valid && (runtime_case == RuntimeCase::kSignalSet ?
            observed == generation : observed >= generation);
        if (runtime_case == RuntimeCase::kPayloadSignalOrder) {
            const auto payload = simt::load_observed(&state->destination);
            valid = valid && payload == expected;
        }
    } else if (runtime_case == RuntimeCase::kPhaseBoundary) {
        observed = simt::load_observed(&state->phase_payload);
        valid = valid &&
            simt::load_observed(&state->phase_sequence) == 2 &&
            observed == kPhasePayload;
    }
    simt::store_published(&state->observed, observed);
    simt::system_fence();
    simt::store_published(
        &state->success, valid ? std::uint32_t{1} : std::uint32_t{0});
}

__aicore__ inline void copy_diagnostic(
    __gm__ RuntimeState* state, const DeviceTransportContext& context) {
    auto* staged = reinterpret_cast<__gm__ StagedTransportContext*>(
        context.backend_context);
    if (staged == nullptr)
        return;
    aicore::flush_cacheline(staged);
    auto* queue = reinterpret_cast<__gm__ TransportCommandQueue*>(
        staged->command_queue);
    if (queue == nullptr)
        return;
    aicore::flush_cacheline(queue);
    auto* diagnostic = reinterpret_cast<__gm__ DeviceTransportDiagnostic*>(
        queue->diagnostic);
    if (diagnostic == nullptr)
        return;
    aicore::flush_cacheline(diagnostic);
    auto* source = reinterpret_cast<__gm__ std::uint64_t*>(diagnostic);
    auto* destination = reinterpret_cast<__gm__ std::uint64_t*>(
        &state->diagnostic);
    for (std::uint32_t word = 0;
         word < sizeof(DeviceTransportDiagnostic) / sizeof(std::uint64_t);
         ++word)
        destination[word] = source[word];
    aicore::system_fence();
    aicore::flush_cacheline(&state->diagnostic);
}

}  // namespace

__global__ __vector__ void runtime_probe_kernel(
    __gm__ RuntimeState* state, DeviceTransportContext context,
    RuntimeCase runtime_case, std::uint32_t peer, std::uint64_t generation,
    std::uint32_t operation_count, bool finalize_profile_pressure) {
    const auto source_peer = static_cast<std::uint32_t>(
        (context.topology.world_rank + context.topology.world_size - 1) %
        context.topology.world_size);
    const std::uint64_t expected =
        (static_cast<std::uint64_t>(source_peer + 1) << 32U) | generation;
    if (runtime_case == RuntimeCase::kPhaseBoundary) {
        asc_vf_call<producer_vf>(
            dim3(1), state, context, runtime_case, peer, generation,
            operation_count, finalize_profile_pressure);
        aicore::flush_cacheline(state);
        if (aicore::load_device(&state->phase_sequence) == 1 &&
            aicore::load_device(&state->phase_payload) == kPhasePayload) {
            state->phase_sequence = 2;
            aicore::system_fence();
            aicore::flush_cacheline(state);
        }
        asc_vf_call<consumer_vf>(
            dim3(1), state, context, runtime_case, peer, generation,
            expected, finalize_profile_pressure);
        return;
    }

    service::begin_profile(
        context, TransportProfileOperation::kBarrier, generation);
    service::reset(context, generation);
    asc_vf_call<producer_vf>(
        dim3(1), state, context, runtime_case, peer, generation,
        operation_count, finalize_profile_pressure);
    service::execute(context);
    copy_diagnostic(state, context);
    asc_vf_call<consumer_vf>(
        dim3(1), state, context, runtime_case, source_peer, generation,
        expected, finalize_profile_pressure);
    service::complete_profile(context, generation);
}

}  // namespace deep_ep::ascend::transport::runtime_probe

extern "C" int deep_ep_ascend_urma_launch_runtime_probe(
    deep_ep::ascend::transport::runtime_probe::RuntimeState* state,
    deep_ep::ascend::transport::DeviceTransportContext context,
    deep_ep::ascend::transport::runtime_probe::RuntimeCase runtime_case,
    std::uint32_t peer, std::uint64_t generation,
    std::uint32_t operation_count, bool finalize_profile_pressure,
    void* stream) {
    deep_ep::ascend::transport::runtime_probe::runtime_probe_kernel<<<
        1, 0, static_cast<aclrtStream>(stream)>>>(
        state, context, runtime_case, peer, generation, operation_count,
        finalize_profile_pressure);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}
