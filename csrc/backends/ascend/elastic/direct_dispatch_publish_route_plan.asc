#include "dispatch_device_common.hpp"

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_publish_route_plan_vf(
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t dispatch_route_plan_offset,
    std::uint64_t dispatch_route_plan_slot_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t workspace_status_offset) {
    if (threadIdx.x != 0)
        return;
    transport::DeviceTransportContext context{};
    context.abi_version = transport_abi_version;
    context.struct_size = transport_struct_size;
    context.capabilities = transport_capabilities;
    context.local_window_base = transport_local_window_base;
    context.channel_table = transport_channel_table;
    context.peer_address_table = transport_peer_address_table;
    context.topology.abi_version = transport_topology_abi_version;
    context.topology.struct_size = transport_topology_struct_size;
    context.topology.world_rank = transport_world_rank;
    context.topology.world_size = transport_world_size;
    context.topology.scale_up_rank = transport_scale_up_rank;
    context.topology.scale_up_size = transport_scale_up_size;
    context.topology.scale_out_rank = transport_scale_out_rank;
    context.topology.scale_out_size = transport_scale_out_size;
    context.topology.scale_up_direct = transport_scale_up_direct != 0;
    context.topology.kind =
        static_cast<transport::TransportTopologyKind>(
            transport_topology_kind);
    context.topology.epoch = transport_topology_epoch;
    context.backend_context = transport_backend_context;
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0 ||
        dispatch_route_plan_slot_bytes < sizeof(DispatchRoutePlanSlotHeader) ||
        dispatch_route_plan_slot_bytes > dispatch_staging_shard_bytes)
        return;

    transport.system_fence();
    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        const auto source = static_cast<transport::DeviceAddress>(
            transport_local_window_base + dispatch_staging_offset +
            static_cast<std::uint64_t>(destination_rank) *
                dispatch_staging_shard_bytes);
        const auto destination = static_cast<transport::DeviceAddress>(
            transport_local_window_base + dispatch_route_plan_offset +
            static_cast<std::uint64_t>(transport_world_rank) *
                dispatch_route_plan_slot_bytes);
        if (destination_rank == transport_world_rank) {
            auto* source_words = reinterpret_cast<__gm__ std::uint64_t*>(
                source);
            auto* destination_words = reinterpret_cast<__gm__ std::uint64_t*>(
                destination);
            const std::uint64_t word_count =
                dispatch_route_plan_slot_bytes / sizeof(std::uint64_t);
            for (std::uint64_t word = 1; word < word_count; ++word)
                destination_words[word] = source_words[word];
            transport.store_release(destination, generation);
            continue;
        }
        transport::TeamPeer route{};
        if (!transport::device::detail::checked_device_team_peer_for_world_rank(
                context.topology, destination_rank, &route)) {
            record_dispatch_protocol_error(
                context, status_address, destination_rank,
                DispatchProtocolStage::kProducer, generation,
                DispatchProtocolError::kInvalidControl);
            return;
        }
        transport.put(
            route.team, route.peer, destination, source,
            dispatch_route_plan_slot_bytes,
            transport::CooperationScope::kParticipant,
            transport::MemorySegment::kDevice,
            transport::kDefaultOptions,
            transport::RemoteAction::none());
    }
    release_protocol::flush_payload(transport);
    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        if (destination_rank == transport_world_rank)
            continue;
        transport::TeamPeer route{};
        if (!transport::device::detail::checked_device_team_peer_for_world_rank(
                context.topology, destination_rank, &route))
            return;
        transport.signal(
            route.team, route.peer,
            transport::RemoteAction::signal_set(
                transport::sync_layout::kDispatchRouteReadySignalIndex,
                generation));
    }
    // Drain the release signal, then align service progress before SIMT lanes
    // start polling route-ready state from every source rank.
    release_protocol::flush_payload(transport);
    const auto barrier_workspace = static_cast<transport::DeviceAddress>(
        transport_local_window_base + dispatch_route_plan_offset +
        static_cast<std::uint64_t>(transport_world_rank) *
            dispatch_route_plan_slot_bytes);
    transport.device_barrier(
        transport::kWorldTeamMask, barrier_workspace, timeout_cycles);
}

struct DirectDispatchPublishRoutePlanKernelArguments {
    __gm__ std::uint8_t* workspace;
    std::uint32_t transport_abi_version;
    std::uint32_t transport_struct_size;
    std::uint64_t transport_capabilities;
    std::uintptr_t transport_local_window_base;
    std::uintptr_t transport_channel_table;
    std::uintptr_t transport_peer_address_table;
    std::uint32_t transport_topology_abi_version;
    std::uint32_t transport_topology_struct_size;
    int transport_world_rank;
    int transport_world_size;
    int transport_scale_up_rank;
    int transport_scale_up_size;
    int transport_scale_out_rank;
    int transport_scale_out_size;
    std::uint32_t transport_scale_up_direct;
    std::uint32_t transport_topology_kind;
    std::uint64_t transport_topology_epoch;
    std::uintptr_t transport_backend_context;
    std::uint64_t generation;
    std::uint64_t timeout_cycles;
    std::uint64_t dispatch_route_plan_offset;
    std::uint64_t dispatch_route_plan_slot_bytes;
    std::uint64_t dispatch_staging_offset;
    std::uint64_t dispatch_staging_shard_bytes;
    std::uint64_t workspace_status_offset;
    std::uint32_t vf_num_threads;
};

__global__ __vector__ void direct_dispatch_publish_route_plan_kernel(
    DirectDispatchPublishRoutePlanKernelArguments arguments) {
    asc_vf_call<direct_dispatch_publish_route_plan_vf> (
        dim3(arguments.vf_num_threads), arguments.workspace,
        arguments.transport_abi_version, arguments.transport_struct_size,
        arguments.transport_capabilities, arguments.transport_local_window_base,
        arguments.transport_channel_table, arguments.transport_peer_address_table,
        arguments.transport_topology_abi_version,
        arguments.transport_topology_struct_size, arguments.transport_world_rank,
        arguments.transport_world_size, arguments.transport_scale_up_rank,
        arguments.transport_scale_up_size, arguments.transport_scale_out_rank,
        arguments.transport_scale_out_size, arguments.transport_scale_up_direct,
        arguments.transport_topology_kind, arguments.transport_topology_epoch,
        arguments.transport_backend_context, arguments.generation,
        arguments.timeout_cycles, arguments.dispatch_route_plan_offset,
        arguments.dispatch_route_plan_slot_bytes,
        arguments.dispatch_staging_offset,
        arguments.dispatch_staging_shard_bytes,
        arguments.workspace_status_offset);
}

extern "C" int deep_ep_ascend_launch_direct_dispatch_publish_route_plan(
    std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank,
    int transport_world_size,
    int transport_scale_up_rank,
    int transport_scale_up_size,
    int transport_scale_out_rank,
    int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation,
    std::uint64_t timeout_cycles,
    std::uint64_t dispatch_route_plan_offset,
    std::uint64_t dispatch_route_plan_slot_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    void* stream, CoreLaunchShape launch,
    std::uint32_t vf_num_threads) {
    const DirectDispatchPublishRoutePlanKernelArguments arguments{
        workspace,
        transport_abi_version,
        transport_struct_size,
        transport_capabilities,
        transport_local_window_base,
        transport_channel_table,
        transport_peer_address_table,
        transport_topology_abi_version,
        transport_topology_struct_size,
        transport_world_rank,
        transport_world_size,
        transport_scale_up_rank,
        transport_scale_up_size,
        transport_scale_out_rank,
        transport_scale_out_size,
        transport_scale_up_direct,
        transport_topology_kind,
        transport_topology_epoch,
        transport_backend_context,
        generation,
        timeout_cycles,
        dispatch_route_plan_offset,
        dispatch_route_plan_slot_bytes,
        dispatch_staging_offset,
        dispatch_staging_shard_bytes,
        workspace_status_offset,
        vf_num_threads};
    direct_dispatch_publish_route_plan_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(arguments);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
