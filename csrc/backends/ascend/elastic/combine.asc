#include <cstdint>

#include "acl/acl.h"
#include "c_api/sync/sync.h"
#include "kernel_operator.h"
#include "simt_api/asc_bf16.h"
#include "simt_api/asc_simt.h"
#include "simt_api/device_atomic_functions.h"
#include "simt_api/device_sync_functions.h"
#include "simt_api/device_warp_functions.h"

#define DEEP_EP_ASCEND_SIMT_DEVICE 1
#define DEEP_EP_ASCEND_TOPK_GROUPING_DEVICE 1
#define DEEP_EP_ASCEND_ELASTIC_AICORE_CALLEE __aicore__ inline
#include "kernels.hpp"
#undef DEEP_EP_ASCEND_ELASTIC_AICORE_CALLEE
#include "topk_grouping.hpp"

#include "combine_parallel.hpp"
#include "combine_state.hpp"
#include "release_protocol.hpp"
#include "../transport/aicore_transport_service.hpp"
#include "../transport/device_transport_facade.hpp"

namespace deep_ep::ascend::elastic {

#include "combine_device_helpers.hpp"
#include "combine_device_common.hpp"
#include "combine_vf_host_calls.hpp"

template <bool ProfileEnabled>
__global__ __vector__ void combine_kernel(
    __gm__ const std::uint16_t* x,
    __gm__ const float* topk_weights,
    __gm__ const std::int32_t* source_metadata,
    __gm__ const HybridRouteRecord* route_records,
    std::uint64_t route_record_count,
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ const std::int32_t* prefix_per_rank,
    __gm__ std::uint8_t* workspace,
    __gm__ std::uint16_t* combined_x,
    __gm__ float* combined_topk_weights,
    __gm__ const std::uint16_t* bias_0,
    __gm__ const std::uint16_t* bias_1,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t num_source_rows, std::uint64_t num_input_rows,
    std::uintptr_t local_window_base, std::uint32_t expanded_vector_reduce,
    std::uint32_t local_copy_datacopy,
    std::uint32_t direct_local_placement,
    std::uint32_t vector_reduce_tile_elements,
    DirectCombineStage stage,
    CoreTiling tiling) {
    if constexpr (ProfileEnabled) {
        const auto profile_block = static_cast<std::uint32_t>(
            AscendC::GetBlockIdx());
        transport::service::record_stage_start<true>(
            tiling.transport_context,
            transport::TransportProfileOperation::kCombine, generation,
            static_cast<std::uint32_t>(stage), profile_block,
            static_cast<std::uint32_t>(AscendC::GetBlockNum()));
    }
    const bool hybrid =
        (tiling.mode_flags &
         (CoreModeFlags{1} <<
          static_cast<std::uint8_t>(CoreMode::kHybrid))) != 0;
    const bool expanded =
        (tiling.mode_flags &
         (CoreModeFlags{1} <<
          static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    const bool allow_multiple_reduction =
        (tiling.mode_flags &
         (CoreModeFlags{1} << static_cast<std::uint8_t>(
             CoreMode::kAllowMultipleReduction))) != 0;
    const bool direct_parallel =
        !hybrid && (!expanded || allow_multiple_reduction);
    const auto release_segment = direct_combine_release_segment(
        stage, ProfileEnabled);
    if (stage == DirectCombineStage::kFull ||
        stage == DirectCombineStage::kProducerControl) {
        if (!transport::service::reset(
                tiling.transport_context, generation))
            return;
    }
    if (direct_parallel) {
        if (stage == DirectCombineStage::kFull ||
            stage == DirectCombineStage::kProducerControl) {
        (void)0;
        }
        if (stage == DirectCombineStage::kFull ||
            stage == DirectCombineStage::kProducerPlan) {
        (void)0;
        }
        if (stage == DirectCombineStage::kFull ||
            stage == DirectCombineStage::kProducerPlanPrefix) {
        (void)0;
        }
        if (stage == DirectCombineStage::kFull ||
            stage == DirectCombineStage::kProducerRecord) {
        (void)0;
        const auto payload_plan = aicore_combine_producer_payload_copy_plan(
            tiling.hidden, kCombineProducerVectorTileElements,
            kCombineDataCopyAlignmentElements, expanded);
        const auto expanded_payload_plan =
            aicore_combine_expanded_producer_payload_plan(
                tiling.hidden, kCombineProducerVectorTileElements,
                kCombineDataCopyAlignmentElements,
                expanded && allow_multiple_reduction &&
                    expanded_vector_reduce != 0);
        if (payload_plan.vector_elements != 0 ||
            expanded_payload_plan.vector_elements != 0) {
            asc_sync_vec();
            asc_sync_data_barrier(mem_dsb_t::DSB_DDR);
        }
        if (payload_plan.vector_elements != 0) {
            direct_combine_producer_vector_payload_impl(
                reinterpret_cast<__gm__ const bfloat16_t*>(x), workspace,
                local_window_base, num_source_rows,
                tiling.symmetric_window_layout.combine_record_bytes,
                tiling.symmetric_window_layout.combine_receive_offset,
                tiling.symmetric_window_layout.combine_receive_shard_bytes,
                tiling.symmetric_window_layout.combine_staging_offset,
                tiling.symmetric_window_layout.combine_staging_shard_bytes,
                tiling.workspace_layout.scratch_status_offset,
                tiling.workspace_layout.scratch_rank_values_offset,
                tiling.workspace_layout.combine_record_slots_offset,
                tiling.workspace_layout.combine_producer_tile_rank_count_offset,
                tiling.workspace_layout.combine_producer_tile_count,
                tiling.transport_context.topology.world_rank,
                tiling.transport_context.topology.world_size, tiling.hidden,
                direct_local_placement);
        }
        if (expanded_payload_plan.vector_elements != 0) {
            direct_combine_producer_expanded_vector_reduce_impl(
                reinterpret_cast<__gm__ const bfloat16_t*>(x),
                source_metadata, workspace, local_window_base,
                num_source_rows, num_input_rows, tiling.num_topk,
                tiling.symmetric_window_layout.combine_record_bytes,
                tiling.symmetric_window_layout.combine_receive_offset,
                tiling.symmetric_window_layout.combine_receive_shard_bytes,
                tiling.symmetric_window_layout.combine_staging_offset,
                tiling.symmetric_window_layout.combine_staging_shard_bytes,
                tiling.workspace_layout.scratch_status_offset,
                tiling.workspace_layout.scratch_rank_values_offset,
                tiling.workspace_layout.combine_record_slots_offset,
                tiling.workspace_layout.combine_producer_tile_rank_count_offset,
                tiling.workspace_layout.combine_producer_tile_count,
                tiling.transport_context.topology.world_rank,
                tiling.transport_context.topology.world_size, tiling.hidden,
                direct_local_placement);
        }
        // Direct placement has no copy-stage synchronization to make the
        // producer record writes visible before control publication.
        if (direct_local_placement != 0) {
            asc_sync_vec();
            asc_sync_data_barrier(mem_dsb_t::DSB_DDR);
        }
        }
        const bool run_local_copy = direct_local_placement == 0 &&
            (release_segment == DirectReleaseSegment::kAll ||
            (ProfileEnabled &&
             stage == DirectCombineStage::kProducerLocalCopy));
        if (run_local_copy) {
        if (local_copy_datacopy != 0) {
        if (local_copy_datacopy == 512) {
        direct_combine_producer_local_copy_impl<512>(
            workspace, local_window_base,
            tiling.symmetric_window_layout.combine_record_bytes,
            tiling.symmetric_window_layout.combine_receive_offset,
            tiling.symmetric_window_layout.combine_receive_shard_bytes,
            tiling.symmetric_window_layout.combine_staging_offset,
            tiling.symmetric_window_layout.combine_staging_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.scratch_rank_counts_offset,
            tiling.transport_context.topology.world_rank);
        } else if (local_copy_datacopy == 1024) {
        direct_combine_producer_local_copy_impl<1024>(
            workspace, local_window_base,
            tiling.symmetric_window_layout.combine_record_bytes,
            tiling.symmetric_window_layout.combine_receive_offset,
            tiling.symmetric_window_layout.combine_receive_shard_bytes,
            tiling.symmetric_window_layout.combine_staging_offset,
            tiling.symmetric_window_layout.combine_staging_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.scratch_rank_counts_offset,
            tiling.transport_context.topology.world_rank);
        } else if (local_copy_datacopy == 2048) {
        direct_combine_producer_local_copy_impl<2048>(
            workspace, local_window_base,
            tiling.symmetric_window_layout.combine_record_bytes,
            tiling.symmetric_window_layout.combine_receive_offset,
            tiling.symmetric_window_layout.combine_receive_shard_bytes,
            tiling.symmetric_window_layout.combine_staging_offset,
            tiling.symmetric_window_layout.combine_staging_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.scratch_rank_counts_offset,
            tiling.transport_context.topology.world_rank);
        } else if (local_copy_datacopy == 4096) {
        direct_combine_producer_local_copy_impl<4096>(
            workspace, local_window_base,
            tiling.symmetric_window_layout.combine_record_bytes,
            tiling.symmetric_window_layout.combine_receive_offset,
            tiling.symmetric_window_layout.combine_receive_shard_bytes,
            tiling.symmetric_window_layout.combine_staging_offset,
            tiling.symmetric_window_layout.combine_staging_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.scratch_rank_counts_offset,
            tiling.transport_context.topology.world_rank);
        } else if (local_copy_datacopy == 8192) {
        direct_combine_producer_local_copy_impl<8192>(
            workspace, local_window_base,
            tiling.symmetric_window_layout.combine_record_bytes,
            tiling.symmetric_window_layout.combine_receive_offset,
            tiling.symmetric_window_layout.combine_receive_shard_bytes,
            tiling.symmetric_window_layout.combine_staging_offset,
            tiling.symmetric_window_layout.combine_staging_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.scratch_rank_counts_offset,
            tiling.transport_context.topology.world_rank);
        } else if (local_copy_datacopy == 16384) {
        direct_combine_producer_local_copy_impl<16384>(
            workspace, local_window_base,
            tiling.symmetric_window_layout.combine_record_bytes,
            tiling.symmetric_window_layout.combine_receive_offset,
            tiling.symmetric_window_layout.combine_receive_shard_bytes,
            tiling.symmetric_window_layout.combine_staging_offset,
            tiling.symmetric_window_layout.combine_staging_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.scratch_rank_counts_offset,
            tiling.transport_context.topology.world_rank);
        } else {
        direct_combine_producer_local_copy_impl<32768>(
            workspace, local_window_base,
            tiling.symmetric_window_layout.combine_record_bytes,
            tiling.symmetric_window_layout.combine_receive_offset,
            tiling.symmetric_window_layout.combine_receive_shard_bytes,
            tiling.symmetric_window_layout.combine_staging_offset,
            tiling.symmetric_window_layout.combine_staging_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.scratch_rank_counts_offset,
            tiling.transport_context.topology.world_rank);
        }
        asc_sync_vec();
        asc_sync_data_barrier(mem_dsb_t::DSB_DDR);
        }
        (void)0;
        }
        if (release_segment != DirectReleaseSegment::kNone) {
        (void)0;
        }
    } else {
        (void)0;
    }
    if (!direct_parallel || release_segment != DirectReleaseSegment::kNone)
        transport::service::execute<ProfileEnabled>(tiling.transport_context);
    if (hybrid) {
        if (!transport::service::reset(
                tiling.transport_context, generation))
            return;
        const std::uint64_t hybrid_record_capacity =
            expanded && !allow_multiple_reduction ?
                tiling.num_max_tokens_per_rank * tiling.num_topk :
                tiling.num_max_tokens_per_rank;
        (void)0;
        transport::service::execute<ProfileEnabled>(tiling.transport_context);
        (void)0;
    }
    if (direct_parallel) {
        if (stage == DirectCombineStage::kFull ||
            stage == DirectCombineStage::kEpilogueAcquire) {
        (void)0;
        (void)0;
        }
        if (stage == DirectCombineStage::kFull ||
            stage == DirectCombineStage::kEpilogueValidate) {
        (void)0;
        }
        if (stage == DirectCombineStage::kFull ||
            stage == DirectCombineStage::kEpilogueValidateReduce) {
        (void)0;
        if (stage == DirectCombineStage::kEpilogueValidateReduce &&
            tiling.num_topk <= kTopkSubgroupWidth &&
            tiling.hidden % kCombineDataCopyAlignmentElements == 0) {
            (void)0;
        }
        }
        if (stage == DirectCombineStage::kFull ||
            stage == DirectCombineStage::kEpilogueReduce) {
        if (stage == DirectCombineStage::kEpilogueReduce &&
            tiling.num_topk <= kTopkSubgroupWidth &&
            tiling.hidden % kCombineDataCopyAlignmentElements == 0) {
            if (tiling.num_topk == kCombineCommonTopk &&
                tiling.hidden == kCombineCommonHidden) {
                if (vector_reduce_tile_elements ==
                    kCombineVectorReduceDefaultTileElements) {
                direct_combine_epilogue_vector_reduce_impl<
                    kCombineCommonTopk, kCombineCommonHidden,
                    kCombineVectorReduceDefaultTileElements>(
                        combined_topk_indices,
                        reinterpret_cast<__gm__ const bfloat16_t*>(bias_0),
                        reinterpret_cast<__gm__ const bfloat16_t*>(bias_1),
                        workspace,
                        reinterpret_cast<__gm__ bfloat16_t*>(combined_x),
                        local_window_base,
                        tiling.transport_context.topology.world_size,
                        tiling.num_tokens, tiling.num_experts,
                        tiling.num_topk,
                        tiling.symmetric_window_layout.combine_record_bytes,
                        tiling.symmetric_window_layout.combine_receive_offset,
                        tiling.symmetric_window_layout
                            .combine_receive_shard_bytes,
                        tiling.workspace_layout.scratch_status_offset,
                        tiling.workspace_layout.slot_offset,
                        tiling.hidden);
                } else {
                direct_combine_epilogue_vector_reduce_impl<
                    kCombineCommonTopk, kCombineCommonHidden>(
                        combined_topk_indices,
                        reinterpret_cast<__gm__ const bfloat16_t*>(bias_0),
                        reinterpret_cast<__gm__ const bfloat16_t*>(bias_1),
                        workspace,
                        reinterpret_cast<__gm__ bfloat16_t*>(combined_x),
                        local_window_base,
                        tiling.transport_context.topology.world_size,
                        tiling.num_tokens, tiling.num_experts,
                        tiling.num_topk,
                        tiling.symmetric_window_layout.combine_record_bytes,
                        tiling.symmetric_window_layout.combine_receive_offset,
                        tiling.symmetric_window_layout
                            .combine_receive_shard_bytes,
                        tiling.workspace_layout.scratch_status_offset,
                        tiling.workspace_layout.slot_offset,
                        tiling.hidden);
                }
            } else {
                direct_combine_epilogue_vector_reduce_impl<0, 0>(
                    combined_topk_indices,
                    reinterpret_cast<__gm__ const bfloat16_t*>(bias_0),
                    reinterpret_cast<__gm__ const bfloat16_t*>(bias_1),
                    workspace,
                    reinterpret_cast<__gm__ bfloat16_t*>(combined_x),
                    local_window_base,
                    tiling.transport_context.topology.world_size,
                    tiling.num_tokens, tiling.num_experts, tiling.num_topk,
                    tiling.symmetric_window_layout.combine_record_bytes,
                    tiling.symmetric_window_layout.combine_receive_offset,
                    tiling.symmetric_window_layout
                        .combine_receive_shard_bytes,
                    tiling.workspace_layout.scratch_status_offset,
                    tiling.workspace_layout.slot_offset,
                    tiling.hidden);
            }
        } else {
        }
        }
        if (stage == DirectCombineStage::kFull ||
            stage == DirectCombineStage::kEpilogueWeights) {
        if (stage == DirectCombineStage::kEpilogueWeights &&
            tiling.num_topk <= kTopkSubgroupWidth &&
            tiling.hidden % kCombineDataCopyAlignmentElements == 0 &&
            tiling.hidden % kCombineVectorTileElements != 0) {
        }
        }
        if (stage == DirectCombineStage::kFull ||
            stage == DirectCombineStage::kEpilogueComplete) {
        }
    } else {
        (void)0;
    }
    if constexpr (ProfileEnabled) {
        const auto profile_block = static_cast<std::uint32_t>(
            AscendC::GetBlockIdx());
        transport::service::record_stage_end<true>(
            tiling.transport_context,
            transport::TransportProfileOperation::kCombine, generation,
            static_cast<std::uint32_t>(stage), profile_block,
            stage == DirectCombineStage::kFull ||
                stage == DirectCombineStage::kEpilogueComplete);
    }
}
extern "C" int deep_ep_ascend_launch_combine_epilogue_complete(
    CombineArguments arguments, CoreTiling tiling, void* stream,
    CoreLaunchShape launch);

extern "C" int deep_ep_ascend_launch_combine_epilogue_reduce(
    CombineArguments arguments, CoreTiling tiling, void* stream,
    CoreLaunchShape launch);

extern "C" int deep_ep_ascend_launch_combine_epilogue_weights(
    CombineArguments arguments, CoreTiling tiling, void* stream,
    CoreLaunchShape launch);

extern "C" int deep_ep_ascend_launch_combine_epilogue_vector_tail(
    CombineArguments arguments, CoreTiling tiling, void* stream,
    CoreLaunchShape launch);

template <bool ProfileEnabled>
inline int launch_combine_kernel(
    CombineArguments arguments, CoreTiling tiling, void* stream,
    CoreLaunchShape launch, DirectCombineStage stage) {
    combine_kernel<ProfileEnabled><<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        static_cast<const std::uint16_t*>(arguments.x),
        arguments.topk_weights, arguments.source_metadata,
        arguments.route_records, arguments.route_record_count,
        arguments.combined_topk_indices, arguments.prefix_per_rank,
        static_cast<std::uint8_t*>(arguments.workspace),
        static_cast<std::uint16_t*>(arguments.combined_x),
        arguments.combined_topk_weights,
        static_cast<const std::uint16_t*>(arguments.bias_0),
        static_cast<const std::uint16_t*>(arguments.bias_1),
        arguments.generation, arguments.timeout_cycles,
        arguments.num_source_rows, arguments.num_input_rows,
        arguments.local_window_base, arguments.expanded_vector_reduce,
        arguments.local_copy_datacopy,
        arguments.direct_local_placement,
        arguments.vector_reduce_tile_elements,
        stage, tiling);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

inline int launch_combine_kernel(
    CombineArguments arguments, CoreTiling tiling, void* stream,
    CoreLaunchShape launch, DirectCombineStage stage) {
    const bool profile_enabled = deep_ep::ascend::transport::has_capability(
        tiling.transport_context.capabilities,
        deep_ep::ascend::transport::TransportCapability::kStageProfile);
    const bool hybrid = has_mode(tiling.mode_flags, CoreMode::kHybrid);
    const bool expanded = has_mode(tiling.mode_flags, CoreMode::kExpanded);
    const bool allow_multiple_reduction =
        has_mode(tiling.mode_flags, CoreMode::kAllowMultipleReduction);
    const bool direct_parallel =
        !hybrid && (!expanded || allow_multiple_reduction);
    const auto run_vf = [&](auto launcher) {
        return launcher(
            arguments, tiling, stream, launch, stage, profile_enabled);
    };
    if (direct_parallel &&
        (stage == DirectCombineStage::kFull ||
         stage == DirectCombineStage::kProducerRecord)) {
        const auto vf_status = run_vf(launch_direct_combine_producer_record);
        if (vf_status != 0)
            return vf_status;
    }
    if (direct_parallel &&
        host_combine_release_segment(stage, profile_enabled) !=
            DirectReleaseSegment::kNone) {
        const auto vf_status = run_vf(launch_direct_combine_producer_release);
        if (vf_status != 0)
            return vf_status;
    }
    const auto status = profile_enabled ?
        launch_combine_kernel<true>(
            arguments, tiling, stream, launch, stage) :
        launch_combine_kernel<false>(
            arguments, tiling, stream, launch, stage);
    if (status != 0)
        return status;
    if (direct_parallel &&
        (stage == DirectCombineStage::kFull ||
         stage == DirectCombineStage::kProducerControl)) {
        const auto vf_status = run_vf(launch_direct_combine_producer_control);
        if (vf_status != 0)
            return vf_status;
    }
    if (direct_parallel &&
        (stage == DirectCombineStage::kFull ||
         stage == DirectCombineStage::kProducerPlan)) {
        const auto vf_status = run_vf(launch_direct_combine_producer_plan);
        if (vf_status != 0)
            return vf_status;
    }
    if (direct_parallel &&
        (stage == DirectCombineStage::kFull ||
         stage == DirectCombineStage::kProducerPlanPrefix)) {
        const auto vf_status =
            run_vf(launch_direct_combine_producer_plan_prefix);
        if (vf_status != 0)
            return vf_status;
    }
    const auto release_segment =
        host_combine_release_segment(stage, profile_enabled);
    const bool run_local_copy = direct_parallel &&
        arguments.direct_local_placement == 0 &&
        (release_segment == DirectReleaseSegment::kAll ||
         (profile_enabled &&
          stage == DirectCombineStage::kProducerLocalCopy));
    if (run_local_copy) {
        const auto vf_status =
            run_vf(launch_direct_combine_producer_local_copy);
        if (vf_status != 0)
            return vf_status;
    }
    if (direct_parallel &&
        (stage == DirectCombineStage::kFull ||
         stage == DirectCombineStage::kEpilogueAcquire)) {
        auto vf_status = run_vf(launch_direct_combine_epilogue_acquire);
        if (vf_status != 0)
            return vf_status;
        vf_status = run_vf(launch_direct_combine_epilogue_clear_index);
        if (vf_status != 0)
            return vf_status;
    }
    if (direct_parallel &&
        (stage == DirectCombineStage::kFull ||
         stage == DirectCombineStage::kEpilogueValidate)) {
        const auto vf_status = run_vf(launch_direct_combine_epilogue_validate);
        if (vf_status != 0)
            return vf_status;
    }
    if (direct_parallel &&
        (stage == DirectCombineStage::kFull ||
         stage == DirectCombineStage::kEpilogueValidateReduce)) {
        auto vf_status =
            run_vf(launch_direct_combine_epilogue_reduce_errors);
        if (vf_status != 0)
            return vf_status;
        if (stage == DirectCombineStage::kEpilogueValidateReduce &&
            tiling.num_topk <= kTopkSubgroupWidth &&
            tiling.hidden % kCombineDataCopyAlignmentElements == 0) {
            vf_status = run_vf(
                launch_direct_combine_epilogue_prepare_vector_slots);
            if (vf_status != 0)
                return vf_status;
        }
    }
    if (!direct_parallel && stage == DirectCombineStage::kFull) {
        auto vf_status = run_vf(launch_combine_producer);
        if (vf_status != 0)
            return vf_status;
        if (hybrid) {
            vf_status = run_vf(launch_hybrid_combine_return);
            if (vf_status != 0)
                return vf_status;
            vf_status = run_vf(launch_hybrid_combine_prepare_epilogue);
            if (vf_status != 0)
                return vf_status;
        }
        vf_status = run_vf(launch_combine_epilogue);
        if (vf_status != 0)
            return vf_status;
    }
    if (direct_parallel &&
        (stage == DirectCombineStage::kFull ||
         stage == DirectCombineStage::kEpilogueReduce) &&
        !(stage == DirectCombineStage::kEpilogueReduce &&
          tiling.num_topk <= kTopkSubgroupWidth &&
          tiling.hidden % kCombineDataCopyAlignmentElements == 0)) {
        const auto reduce_status =
            deep_ep_ascend_launch_combine_epilogue_reduce(
                arguments, tiling, stream, launch);
        if (reduce_status != 0)
            return reduce_status;
    }
    if (direct_parallel &&
        stage == DirectCombineStage::kEpilogueWeights &&
        tiling.num_topk <= kTopkSubgroupWidth &&
        tiling.hidden % kCombineDataCopyAlignmentElements == 0 &&
        tiling.hidden % kCombineVectorTileElements != 0) {
        const auto tail_status =
            deep_ep_ascend_launch_combine_epilogue_vector_tail(
                arguments, tiling, stream, launch);
        if (tail_status != 0)
            return tail_status;
    }
    if (direct_parallel &&
        (stage == DirectCombineStage::kFull ||
         stage == DirectCombineStage::kEpilogueWeights)) {
        const auto weights_status =
            deep_ep_ascend_launch_combine_epilogue_weights(
                arguments, tiling, stream, launch);
        if (weights_status != 0)
            return weights_status;
    }
    if (direct_parallel &&
        (stage == DirectCombineStage::kFull ||
         stage == DirectCombineStage::kEpilogueComplete))
        return deep_ep_ascend_launch_combine_epilogue_complete(
            arguments, tiling, stream, launch);
    return 0;
}

inline int launch_direct_combine_stage(
    CombineArguments arguments, CoreTiling tiling, void* stream,
    DirectCombineStage stage) {
    const auto launch = direct_combine_stage_launch(tiling, stage);
    return launch_combine_kernel(
        arguments, tiling, stream, launch, stage);
}

}  // namespace deep_ep::ascend::elastic

extern "C" int deep_ep_ascend_launch_combine(
    deep_ep::ascend::elastic::CombineArguments arguments,
    deep_ep::ascend::elastic::CoreTiling tiling, void* stream) {
    using namespace deep_ep::ascend::elastic;
    const bool hybrid = has_mode(tiling.mode_flags, CoreMode::kHybrid);
    const bool expanded = has_mode(tiling.mode_flags, CoreMode::kExpanded);
    const bool allow_multiple_reduction = has_mode(
        tiling.mode_flags, CoreMode::kAllowMultipleReduction);
    if (hybrid || (expanded && !allow_multiple_reduction))
        return launch_direct_combine_stage(
            arguments, tiling, stream, DirectCombineStage::kFull);

    const bool profile_enabled = deep_ep::ascend::transport::has_capability(
        tiling.transport_context.capabilities,
        deep_ep::ascend::transport::TransportCapability::kStageProfile);
    const auto pipeline = profile_enabled ?
        direct_combine_profile_pipeline() : direct_combine_pipeline();
    for (std::uint32_t index = 0; index < pipeline.count; ++index) {
        const auto status = launch_direct_combine_stage(
            arguments, tiling, stream, pipeline.stages[index]);
        if (status != 0)
            return status;
    }
    return 0;
}

extern "C" int deep_ep_ascend_launch_combine_epilogue(
    deep_ep::ascend::elastic::CombineArguments,
    deep_ep::ascend::elastic::CoreTiling, void*) {
    return 0;
}
