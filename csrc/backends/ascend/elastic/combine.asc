#include <cstdint>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_bf16.h"
#include "simt_api/asc_simt.h"
#include "simt_api/device_warp_functions.h"

#define DEEP_EP_ASCEND_SIMT_DEVICE 1
#define DEEP_EP_ASCEND_TOPK_GROUPING_DEVICE 1
#include "kernels.hpp"
#include "topk_grouping.hpp"

#include "combine_parallel.hpp"
#include "combine_state.hpp"
#include "release_protocol.hpp"
#include "../transport/aicore_transport_service.hpp"
#include "../transport/device_transport_facade.hpp"

namespace deep_ep::ascend::elastic {

constexpr std::uint32_t kCombineVectorTileElements = 256;
constexpr std::uint32_t kCombineDataCopyAlignmentElements = 16;
constexpr std::uint64_t kCombineCommonTopk = 8;
constexpr std::uint64_t kCombineCommonHidden = 7168;

enum class CombineProtocolError : std::uint32_t {
    kNone = 0,
    kInvalidLayout,
    kCapacityOverflow,
    kInvalidPrefix,
    kInvalidMetadata,
    kInvalidControl,
    kInvalidHeader,
    kDuplicateRecord,
};

DEEP_EP_ASCEND_SIMT_CALLEE void record_combine_protocol_error(
    const transport::DeviceTransportContext& context,
    transport::DeviceAddress status_address, int peer_rank,
    CombineProtocolError error) {
    transport::DeviceTransportFacade transport(context, 0);
    const std::uint64_t status =
        (static_cast<std::uint64_t>(peer_rank + 1) << 32U) |
        static_cast<std::uint32_t>(error);
    transport.store_release(status_address, status);
#if defined(DEEP_EP_ASCEND_STAGED_URMA) && DEEP_EP_ASCEND_STAGED_URMA
    auto* queue = transport::device::detail::command_queue(context);
    auto* diagnostic = transport::device::detail::diagnostic(queue);
    if (diagnostic != nullptr) {
        const auto observed_transport_error =
            transport::simt::load_observed(
                reinterpret_cast<__gm__ std::uint32_t*>(
                    &diagnostic->error));
        if (observed_transport_error == static_cast<std::uint32_t>(
                transport::DeviceTransportError::kNone)) {
            transport::simt::store_published(
                &diagnostic->backend_status,
                static_cast<std::uint32_t>(error));
            transport::simt::system_fence();
        }
    }
    transport::device::detail::record_error(
        queue, transport::DeviceTransportError::kInvalidProtocol,
        transport::TransportCommandOpcode::kNone, peer_rank, 0);
#endif
}

DEEP_EP_ASCEND_SIMT_CALLEE CombineRecordHeader
load_observed_combine_record_header(
    __gm__ const CombineRecordHeader* header) {
    CombineRecordHeader result{};
    result.abi_version = transport::simt::load_observed(
        &header->abi_version);
    result.struct_size = transport::simt::load_observed(
        &header->struct_size);
    result.origin_token = static_cast<std::int32_t>(
        transport::simt::load_observed(
            reinterpret_cast<__gm__ const std::uint32_t*>(
                &header->origin_token)));
    result.contributor_rank = static_cast<std::int32_t>(
        transport::simt::load_observed(
            reinterpret_cast<__gm__ const std::uint32_t*>(
                &header->contributor_rank)));
    result.master_lane = static_cast<std::int32_t>(
        transport::simt::load_observed(
            reinterpret_cast<__gm__ const std::uint32_t*>(
                &header->master_lane)));
    result.contribution_lane = static_cast<std::int32_t>(
        transport::simt::load_observed(
            reinterpret_cast<__gm__ const std::uint32_t*>(
                &header->contribution_lane)));
    return result;
}

DEEP_EP_ASCEND_SIMT_CALLEE HybridCombineRouteMetadata
load_observed_hybrid_combine_route_metadata(
    __gm__ const HybridCombineRouteMetadata* metadata) {
    HybridCombineRouteMetadata result{};
    result.ingress_slot = transport::simt::load_observed(
        reinterpret_cast<__gm__ const std::uint64_t*>(
            &metadata->ingress_slot));
    result.forwarded_slot = transport::simt::load_observed(
        reinterpret_cast<__gm__ const std::uint64_t*>(
            &metadata->forwarded_slot));
    return result;
}

DEEP_EP_ASCEND_SIMT_CALLEE bool combine_direct_status_is_clean(
    __gm__ const std::uint8_t* workspace,
    std::uint64_t status_offset) {
    return transport::simt::load_observed(
        reinterpret_cast<__gm__ const std::uint64_t*>(
            workspace + status_offset)) == 0;
}

DEEP_EP_ASCEND_SIMT_CALLEE std::uint64_t hybrid_combine_records_for_row(
    __gm__ const std::int32_t* metadata, std::uint64_t num_topk,
    bool expanded, bool allow_multiple_reduction) {
    if (!expanded)
        return 1;
    const std::uint64_t lane_count = combine_expanded_record_count(
        metadata + 2, num_topk, false);
    return allow_multiple_reduction ? (lane_count == 0 ? 0 : 1) : lane_count;
}

__simt_vf__ __launch_bounds__(512) inline void combine_producer_vf(
    __gm__ const bfloat16_t* x,
    __gm__ const float* topk_weights,
    __gm__ const std::int32_t* source_metadata,
    __gm__ const HybridRouteRecord* route_records,
    std::uint64_t route_record_count,
    __gm__ const std::int32_t* prefix_per_rank,
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t timeout_cycles, std::uint64_t num_source_rows,
    std::uint64_t num_input_rows, std::uint64_t num_tokens,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t dispatch_output_capacity,
    std::uint64_t combine_record_bytes,
    std::uint64_t combine_weight_offset,
    std::uint64_t combine_control_offset,
    std::uint64_t combine_control_bytes,
    std::uint64_t combine_receive_offset,
    std::uint64_t combine_receive_shard_bytes,
    std::uint64_t combine_receive_shard_count,
    std::uint64_t combine_receive_bytes,
    std::uint64_t combine_staging_offset,
    std::uint64_t combine_staging_shard_bytes,
    std::uint64_t combine_staging_shard_count,
    std::uint64_t combine_staging_bytes,
    std::uint64_t reverse_forward_control_offset,
    std::uint64_t reverse_forward_control_bytes,
    std::uint64_t reverse_forward_shard_offset,
    std::uint64_t reverse_forward_shard_bytes,
    std::uint64_t reverse_forward_shard_count,
    std::uint64_t reverse_forward_bytes,
    std::uint64_t workspace_scratch_status_offset,
    std::uint64_t workspace_scratch_rank_counts_offset,
    std::uint64_t workspace_scratch_rank_values_offset,
    std::uint64_t workspace_scratch_rank_count,
    std::uint64_t hidden_elements) {
    if (threadIdx.x != 0)
        return;

    transport::DeviceTransportContext context{};
    context.abi_version = transport_abi_version;
    context.struct_size = transport_struct_size;
    context.capabilities = transport_capabilities;
    context.topology.abi_version = transport_topology_abi_version;
    context.topology.struct_size = transport_topology_struct_size;
    context.topology.world_rank = transport_world_rank;
    context.topology.world_size = transport_world_size;
    context.topology.scale_up_rank = transport_scale_up_rank;
    context.topology.scale_up_size = transport_scale_up_size;
    context.topology.scale_out_rank = transport_scale_out_rank;
    context.topology.scale_out_size = transport_scale_out_size;
    context.topology.scale_up_direct = transport_scale_up_direct != 0;
    context.topology.kind = static_cast<transport::TransportTopologyKind>(
        transport_topology_kind);
    context.topology.epoch = transport_topology_epoch;
    context.local_window_base = transport_local_window_base;
    context.channel_table = transport_channel_table;
    context.peer_address_table = transport_peer_address_table;
    context.backend_context = transport_backend_context;
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address =
        reinterpret_cast<transport::DeviceAddress>(
            workspace + workspace_scratch_status_offset);
    transport.store_release(status_address, 0);

    const std::uint64_t hidden_bytes =
        hidden_elements * sizeof(std::uint16_t);
    const std::uint64_t raw_record_capacity =
        shard_capacity * static_cast<std::uint64_t>(transport_world_size);

    // Raw record bounds are checked before any byte-capacity arithmetic.
    if (!transport::device::detail::valid_topology(context.topology) ||
        transport_world_size < 2 ||
        workspace_scratch_rank_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        generation == 0 || timeout_cycles == 0 ||
        num_source_rows > raw_record_capacity ||
        shard_capacity == 0 ||
        shard_capacity >
            static_cast<std::uint64_t>(0x7fffffff) /
                static_cast<std::uint64_t>(transport_world_size))
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kCapacityOverflow);

    const bool expanded = (mode_flags & (CoreModeFlags{1} <<
        static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    const bool allow_multiple_reduction = (mode_flags & (CoreModeFlags{1} <<
        static_cast<std::uint8_t>(CoreMode::kAllowMultipleReduction))) != 0;
    const bool hybrid =
        (mode_flags &
         (CoreModeFlags{1} <<
          static_cast<std::uint8_t>(CoreMode::kHybrid))) != 0;
    const auto record_trailer =
        combine_record_trailer_layout(combine_record_bytes, hybrid);
    const std::uint64_t record_capacity = expanded && !allow_multiple_reduction ?
        shard_capacity * num_topk : shard_capacity;
    if ((!expanded && (allow_multiple_reduction ||
                       num_source_rows != num_input_rows)) ||
        (expanded && num_input_rows > dispatch_output_capacity))
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kInvalidMetadata);

    if (combine_control_bytes <
            static_cast<std::uint64_t>(transport_world_size) *
                sizeof(CombineControlSlot) ||
        combine_receive_shard_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        combine_staging_shard_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        combine_receive_bytes <
            combine_receive_shard_count * combine_receive_shard_bytes ||
        combine_staging_bytes <
            combine_staging_shard_count * combine_staging_shard_bytes ||
        !record_trailer.valid ||
        hidden_bytes > combine_weight_offset ||
        combine_weight_offset > record_trailer.header_offset ||
        num_topk >
            (record_trailer.header_offset - combine_weight_offset) /
                sizeof(float) ||
        record_capacity * combine_record_bytes >
            combine_receive_shard_bytes ||
        record_capacity * combine_record_bytes >
            combine_staging_shard_bytes ||
        (hybrid &&
         (route_records == nullptr || route_record_count != num_source_rows ||
          reverse_forward_control_bytes <
              static_cast<std::uint64_t>(transport_world_size) *
                  sizeof(CombineControlSlot) ||
          reverse_forward_shard_count !=
              static_cast<std::uint64_t>(transport_world_size) ||
          reverse_forward_bytes < reverse_forward_shard_count *
              reverse_forward_shard_bytes ||
          record_capacity * combine_record_bytes >
              reverse_forward_shard_bytes)))
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kInvalidLayout);

    auto* record_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_scratch_rank_counts_offset);
    auto* record_begins = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_scratch_rank_values_offset);
    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        record_counts[destination_rank] = 0;
        record_begins[destination_rank] = 0;
    }
    std::uint64_t previous_end = 0;
    const std::uint64_t metadata_stride = 2 + num_topk;
    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        const std::int32_t encoded_end = prefix_per_rank[destination_rank];
        if (encoded_end < 0 ||
            static_cast<std::uint64_t>(encoded_end) < previous_end ||
            static_cast<std::uint64_t>(encoded_end) > num_source_rows)
            return record_combine_protocol_error(
                context, status_address, destination_rank,
                CombineProtocolError::kInvalidPrefix);
        const std::uint64_t end = static_cast<std::uint64_t>(encoded_end);
        record_begins[destination_rank] = previous_end;
        for (std::uint64_t row = previous_end; row < end; ++row) {
            __gm__ const std::int32_t* metadata =
                source_metadata + row * metadata_stride;
            const std::int32_t origin_token = decode_dispatch_local_index(
                metadata[0], shard_capacity);
            const int master_rank = decode_dispatch_source_rank(
                metadata[1], num_topk);
            const std::int32_t master_lane = decode_dispatch_local_index(
                metadata[1], num_topk);
            if (!is_valid_combine_source_identity(
                    metadata[0], destination_rank, transport_world_rank,
                    shard_capacity,
                    num_tokens) ||
                master_rank != destination_rank ||
                !is_dispatch_local_index(master_lane, num_topk))
                return record_combine_protocol_error(
                    context, status_address, destination_rank,
                    CombineProtocolError::kInvalidMetadata);
            if (hybrid) {
                const auto& route_record = route_records[row];
                const auto route = classify_world_route(
                    destination_rank, transport_world_rank,
                    transport_scale_up_size);
                const bool diagonal =
                    route.kind == WorldRouteKind::kDiagonal;
                if (route_record.origin_world_rank != destination_rank ||
                    route_record.destination_world_rank !=
                        transport_world_rank ||
                    route_record.ingress_world_rank !=
                        route.ingress_world_rank ||
                    route_record.origin_source_row !=
                        static_cast<std::uint64_t>(origin_token) ||
                    route_record.topology_epoch != transport_topology_epoch ||
                    !is_complete_hybrid_route_stage_flags(
                        route_record.stage_flags) ||
                    (diagonal ?
                         (route_record.ingress_slot ==
                              kInvalidHybridRouteSlot ||
                          route_record.forwarded_slot ==
                              kInvalidHybridRouteSlot) :
                         (route_record.ingress_slot !=
                              kInvalidHybridRouteSlot ||
                          route_record.forwarded_slot !=
                              kInvalidHybridRouteSlot)))
                    return record_combine_protocol_error(
                        context, status_address, destination_rank,
                        CombineProtocolError::kInvalidMetadata);
                if (diagonal &&
                    (shard_capacity == 0 ||
                     route_record.ingress_slot / shard_capacity !=
                         static_cast<std::uint64_t>(destination_rank) ||
                     route_record.forwarded_slot / shard_capacity !=
                         static_cast<std::uint64_t>(destination_rank)))
                    return record_combine_protocol_error(
                        context, status_address, destination_rank,
                        CombineProtocolError::kInvalidMetadata);
                if (diagonal) {
                    for (std::uint64_t prior = 0; prior < row; ++prior) {
                        const auto& prior_record = route_records[prior];
                        if (prior_record.ingress_slot ==
                                route_record.ingress_slot ||
                            prior_record.forwarded_slot ==
                                route_record.forwarded_slot)
                            return record_combine_protocol_error(
                                context, status_address, destination_rank,
                                CombineProtocolError::kInvalidMetadata);
                    }
                }
            }
            for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                const std::int32_t input_row = metadata[2 + lane];
                if (!expanded) {
                    if (input_row != -1)
                        return record_combine_protocol_error(
                            context, status_address, destination_rank,
                            CombineProtocolError::kInvalidMetadata);
                    continue;
                }
                if (!combine_expanded_input_row_is_valid(
                        input_row, num_input_rows))
                    return record_combine_protocol_error(
                        context, status_address, destination_rank,
                        CombineProtocolError::kInvalidMetadata);
            }
            record_counts[destination_rank] +=
                hybrid_combine_records_for_row(
                    metadata, num_topk, expanded,
                    allow_multiple_reduction);
        }
        previous_end = end;
    }
    if (previous_end != num_source_rows)
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kInvalidPrefix);

    // Record counts are derived before staging so no command is published on
    // malformed expanded metadata.
    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        const std::uint64_t count = record_counts[destination_rank];
        if (count * combine_record_bytes > combine_staging_shard_bytes ||
            count * combine_record_bytes > combine_receive_shard_bytes)
            return record_combine_protocol_error(
                context, status_address, destination_rank,
                CombineProtocolError::kCapacityOverflow);
    }

    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        __gm__ std::uint8_t* staging_shard =
            reinterpret_cast<__gm__ std::uint8_t*>(
                combine_staging_shard_address(
                    transport_local_window_base, combine_staging_offset,
                    static_cast<std::uint64_t>(destination_rank),
                    combine_staging_shard_bytes));
        const std::uint64_t begin = record_begins[destination_rank];
        const std::uint64_t end = destination_rank + 1 == transport_world_size ?
            num_source_rows : record_begins[destination_rank + 1];
        std::uint64_t output_slot = 0;
        for (std::uint64_t row = begin; row < end; ++row) {
            __gm__ const std::int32_t* metadata =
                source_metadata + row * metadata_stride;
            const std::int32_t master_lane = decode_dispatch_local_index(
                metadata[1], num_topk);
            const std::uint64_t records_for_row =
                hybrid_combine_records_for_row(
                    metadata, num_topk, expanded,
                    allow_multiple_reduction);
            const auto world_route = classify_world_route(
                destination_rank, transport_world_rank,
                transport_scale_up_size);
            const bool diagonal = hybrid &&
                world_route.kind == WorldRouteKind::kDiagonal;
            std::uint64_t row_output_slot = output_slot;
            if (diagonal) {
                const auto& route_record = route_records[row];
                row_output_slot = 0;
                for (std::uint64_t prior = begin; prior < end; ++prior) {
                    const auto& prior_record = route_records[prior];
                    if (prior_record.forwarded_slot >=
                        route_record.forwarded_slot)
                        continue;
                    const auto* prior_metadata =
                        source_metadata + prior * metadata_stride;
                    row_output_slot += hybrid_combine_records_for_row(
                        prior_metadata, num_topk, expanded,
                        allow_multiple_reduction);
                }
            }
            for (std::uint64_t record_index = 0;
                 record_index < records_for_row; ++record_index) {
                std::uint64_t contribution_lane =
                    static_cast<std::uint64_t>(master_lane);
                if (expanded && !allow_multiple_reduction) {
                    contribution_lane = static_cast<std::uint64_t>(
                        combine_expanded_record_lane(
                            metadata + 2, num_topk, record_index));
                }
                __gm__ std::uint8_t* record =
                    staging_shard +
                    (row_output_slot + record_index) * combine_record_bytes;
                auto* record_hidden =
                    reinterpret_cast<__gm__ bfloat16_t*>(record);
                auto* record_weights = reinterpret_cast<__gm__ float*>(
                    record + combine_weight_offset);
                for (std::uint64_t lane = 0; lane < num_topk; ++lane)
                    record_weights[lane] = 0.0F;
                for (std::uint64_t hidden = 0;
                     hidden < hidden_elements; ++hidden) {
                    float value = 0.0F;
                    if (!expanded) {
                        value = static_cast<float>(x[row * hidden_elements + hidden]);
                    } else if (allow_multiple_reduction) {
                        value = combine_reduce_expanded_lanes(
                            x, metadata + 2, num_topk, num_input_rows,
                            hidden_elements, hidden);
                    } else {
                        const std::int32_t input_row =
                            metadata[2 + contribution_lane];
                        value = static_cast<float>(x[
                            static_cast<std::uint64_t>(input_row) *
                            hidden_elements + hidden]);
                    }
                    record_hidden[hidden] = static_cast<bfloat16_t>(value);
                }
                if (!expanded) {
                    combine_fill_normal_record_routing_weights(
                        topk_weights, row, master_lane, num_topk,
                        record, combine_weight_offset);
                } else {
                    for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                        const bool owns_lane = metadata[2 + lane] != -1;
                        if (!owns_lane || (!allow_multiple_reduction &&
                                           lane != contribution_lane))
                            continue;
                        const std::int32_t input_row = metadata[2 + lane];
                        record_weights[lane] = topk_weights == nullptr ?
                            0.0F : combine_routing_weight(
                                topk_weights,
                                static_cast<std::uint64_t>(input_row));
                    }
                }
                auto* header = reinterpret_cast<__gm__ CombineRecordHeader*>(
                    record + record_trailer.header_offset);
                header->abi_version = kCombineRecordAbiVersion;
                header->struct_size = sizeof(CombineRecordHeader);
                header->origin_token = decode_dispatch_local_index(
                    metadata[0], shard_capacity);
                header->contributor_rank = transport_world_rank;
                header->master_lane = master_lane;
                header->contribution_lane = expanded && !allow_multiple_reduction ?
                    static_cast<std::int32_t>(contribution_lane) : master_lane;
                if (record_trailer.has_route_metadata) {
                    auto* route_metadata = reinterpret_cast<
                        __gm__ HybridCombineRouteMetadata*>(
                            record + record_trailer.route_metadata_offset);
                    route_metadata->ingress_slot = diagonal ?
                        route_records[row].ingress_slot :
                        kInvalidHybridRouteSlot;
                    route_metadata->forwarded_slot = diagonal ?
                        route_records[row].forwarded_slot :
                        kInvalidHybridRouteSlot;
                }
            }
            output_slot += records_for_row;
        }
    }

    transport.system_fence();
    auto* control_slots = reinterpret_cast<__gm__ CombineControlSlot*>(
        transport_local_window_base + combine_control_offset);
    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        const std::uint64_t count = record_counts[destination_rank];
        const auto source = static_cast<transport::DeviceAddress>(
            combine_staging_shard_address(
                transport_local_window_base, combine_staging_offset,
                static_cast<std::uint64_t>(destination_rank),
                combine_staging_shard_bytes));
        const auto destination = static_cast<transport::DeviceAddress>(
            combine_receive_shard_address(
                transport_local_window_base, combine_receive_offset,
                static_cast<std::uint64_t>(transport_world_rank),
                combine_receive_shard_bytes));
        if (destination_rank == transport_world_rank) {
            auto* local_source = reinterpret_cast<
                __gm__ const std::uint8_t*>(
                    combine_staging_shard_address(
                        transport_local_window_base, combine_staging_offset,
                        static_cast<std::uint64_t>(destination_rank),
                        combine_staging_shard_bytes));
            auto* local_destination = reinterpret_cast<__gm__ std::uint8_t*>(
                combine_receive_shard_address(
                    transport_local_window_base, combine_receive_offset,
                    static_cast<std::uint64_t>(transport_world_rank),
                    combine_receive_shard_bytes));
            for (std::uint64_t byte = 0;
                 byte < count * combine_record_bytes; ++byte)
                local_destination[byte] = local_source[byte];
            transport.store_release(
                reinterpret_cast<transport::DeviceAddress>(
                    &control_slots[transport_world_rank].count), count);
            transport.store_release(
                reinterpret_cast<transport::DeviceAddress>(
                    &control_slots[transport_world_rank].generation),
                generation);
            continue;
        }
        const auto world_route = classify_world_route(
            destination_rank, transport_world_rank, transport_scale_up_size);
        if (hybrid && world_route.kind == WorldRouteKind::kDiagonal) {
            const int ingress_rank = world_route.ingress_world_rank;
            transport::TeamPeer route{
                transport::TransportTeam::kScaleUp,
                ingress_rank % transport_scale_up_size, ingress_rank};
            const auto reverse_destination =
                transport_local_window_base + reverse_forward_shard_offset +
                static_cast<std::uint64_t>(destination_rank) *
                    reverse_forward_shard_bytes;
            if (count != 0) {
                transport.put(
                    transport::TransportTeam::kScaleUp, route.peer,
                    reverse_destination, source,
                    count * combine_record_bytes,
                    transport::CooperationScope::kParticipant,
                    transport::MemorySegment::kDevice,
                    transport::kDefaultOptions,
                    transport::RemoteAction::none());
            }
            release_protocol::flush_payload(transport);
            const auto remote_slot = transport_local_window_base +
                reverse_forward_control_offset +
                static_cast<std::uint64_t>(destination_rank) *
                    sizeof(CombineControlSlot);
            release_protocol::publish_control_and_release(
                transport, route, remote_slot + sizeof(std::uint64_t), count,
                remote_slot, generation,
                transport::sync_layout::kCombineReleaseSignalIndex);
            continue;
        }
        transport::TeamPeer route{};
        if (!transport::device::detail::checked_device_team_peer_for_world_rank(
                context.topology, destination_rank, &route))
            return record_combine_protocol_error(
                context, status_address, destination_rank,
                CombineProtocolError::kInvalidMetadata);
        if (count != 0) {
            transport.put(
                route.team, route.peer,
                destination, source, count * combine_record_bytes,
                transport::CooperationScope::kParticipant,
                transport::MemorySegment::kDevice,
                transport::kDefaultOptions,
                transport::RemoteAction::none());
        }
        release_protocol::flush_payload(transport);
        const auto remote_count = static_cast<transport::DeviceAddress>(
            transport_local_window_base + combine_control_offset +
            static_cast<std::uint64_t>(transport_world_rank) *
                sizeof(CombineControlSlot) + sizeof(std::uint64_t));
        const auto remote_generation = static_cast<transport::DeviceAddress>(
            transport_local_window_base + combine_control_offset +
            static_cast<std::uint64_t>(transport_world_rank) *
                sizeof(CombineControlSlot));
        release_protocol::publish_control_and_release(
            transport, route, remote_count, count, remote_generation,
            generation, transport::sync_layout::kCombineReleaseSignalIndex);
    }
    const auto barrier_workspace =
        reinterpret_cast<transport::DeviceAddress>(
            &control_slots[transport_world_rank].generation);
    transport.device_barrier(
        transport::kWorldTeamMask, barrier_workspace, timeout_cycles);
}

DEEP_EP_ASCEND_SIMT_CALLEE transport::DeviceTransportContext
make_hybrid_combine_context(
    std::uint32_t abi_version, std::uint32_t struct_size,
    std::uint64_t capabilities, std::uintptr_t local_window_base,
    std::uintptr_t channel_table, std::uintptr_t peer_address_table,
    std::uint32_t topology_abi_version,
    std::uint32_t topology_struct_size,
    int world_rank, int world_size, int scale_up_rank, int scale_up_size,
    int scale_out_rank, int scale_out_size,
    std::uint32_t scale_up_direct, std::uint32_t topology_kind,
    std::uint64_t topology_epoch, std::uintptr_t backend_context) {
    transport::DeviceTransportContext result{};
    result.abi_version = abi_version;
    result.struct_size = struct_size;
    result.capabilities = capabilities;
    result.topology.abi_version = topology_abi_version;
    result.topology.struct_size = topology_struct_size;
    result.topology.world_rank = world_rank;
    result.topology.world_size = world_size;
    result.topology.scale_up_rank = scale_up_rank;
    result.topology.scale_up_size = scale_up_size;
    result.topology.scale_out_rank = scale_out_rank;
    result.topology.scale_out_size = scale_out_size;
    result.topology.scale_up_direct = scale_up_direct != 0;
    result.topology.kind =
        static_cast<transport::TransportTopologyKind>(topology_kind);
    result.topology.epoch = topology_epoch;
    result.local_window_base = local_window_base;
    result.channel_table = channel_table;
    result.peer_address_table = peer_address_table;
    result.backend_context = backend_context;
    return result;
}

__simt_vf__ __launch_bounds__(512) inline void direct_combine_producer_control_vf(
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t timeout_cycles, std::uint64_t num_source_rows,
    std::uint64_t num_input_rows,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t dispatch_output_capacity,
    std::uint64_t combine_record_bytes,
    std::uint64_t combine_weight_offset,
    std::uint64_t combine_control_bytes,
    std::uint64_t combine_receive_shard_bytes,
    std::uint64_t combine_receive_shard_count,
    std::uint64_t combine_receive_bytes,
    std::uint64_t combine_staging_shard_bytes,
    std::uint64_t combine_staging_shard_count,
    std::uint64_t combine_staging_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_flags_offset,
    std::uint64_t workspace_rank_count,
    std::uint64_t hidden_elements) {
    if (threadIdx.x != 0)
        return;
    const auto context = make_hybrid_combine_context(
        transport_abi_version, transport_struct_size, transport_capabilities,
        transport_local_window_base, transport_channel_table,
        transport_peer_address_table, transport_topology_abi_version,
        transport_topology_struct_size, transport_world_rank,
        transport_world_size, transport_scale_up_rank,
        transport_scale_up_size, transport_scale_out_rank,
        transport_scale_out_size, transport_scale_up_direct,
        transport_topology_kind, transport_topology_epoch,
        transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    transport.store_release(status_address, 0);
    auto* errors = reinterpret_cast<__gm__ std::uint8_t*>(
        workspace + workspace_rank_flags_offset);
    for (std::uint64_t rank = 0; rank < workspace_rank_count; ++rank)
        errors[rank] = 0;

    const bool expanded = (mode_flags & (CoreModeFlags{1} <<
        static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    const bool allow_multiple_reduction =
        (mode_flags & (CoreModeFlags{1} << static_cast<std::uint8_t>(
            CoreMode::kAllowMultipleReduction))) != 0;
    const auto trailer = combine_record_trailer_layout(
        combine_record_bytes, false);
    const std::uint64_t hidden_bytes =
        hidden_elements * sizeof(std::uint16_t);
    const std::uint64_t raw_capacity =
        shard_capacity * static_cast<std::uint64_t>(transport_world_size);
    if (!transport::device::detail::valid_topology(context.topology) ||
        transport_world_size < 2 || generation == 0 || timeout_cycles == 0 ||
        workspace_rank_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        shard_capacity == 0 ||
        shard_capacity > static_cast<std::uint64_t>(0x7fffffff) ||
        num_source_rows > raw_capacity ||
        num_source_rows > dispatch_output_capacity)
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kCapacityOverflow);
    if ((expanded && !allow_multiple_reduction) ||
        (!expanded && (allow_multiple_reduction ||
                       num_source_rows != num_input_rows)) ||
        (expanded && num_input_rows > dispatch_output_capacity))
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kInvalidMetadata);
    if (combine_control_bytes <
            static_cast<std::uint64_t>(transport_world_size) *
                sizeof(CombineControlSlot) ||
        combine_receive_shard_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        combine_staging_shard_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        combine_receive_bytes <
            combine_receive_shard_count * combine_receive_shard_bytes ||
        combine_staging_bytes <
            combine_staging_shard_count * combine_staging_shard_bytes ||
        !trailer.valid || hidden_bytes > combine_weight_offset ||
        combine_weight_offset > trailer.header_offset ||
        num_topk > (trailer.header_offset - combine_weight_offset) /
            sizeof(float) ||
        shard_capacity * combine_record_bytes > combine_receive_shard_bytes ||
        shard_capacity * combine_record_bytes > combine_staging_shard_bytes)
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kInvalidLayout);

}

__simt_vf__ __launch_bounds__(512) inline void direct_combine_producer_plan_vf(
    __gm__ const std::int32_t* source_metadata,
    __gm__ const std::int32_t* prefix_per_rank,
    __gm__ std::uint8_t* workspace,
    CoreModeFlags mode_flags, int world_rank, int world_size,
    std::uint64_t num_source_rows, std::uint64_t num_input_rows,
    std::uint64_t num_tokens, std::uint64_t num_topk,
    std::uint64_t shard_capacity, std::uint64_t combine_record_bytes,
    std::uint64_t combine_receive_shard_bytes,
    std::uint64_t combine_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t workspace_rank_flags_offset,
    std::uint64_t workspace_slot_offset) {
    if (!combine_direct_status_is_clean(
            workspace, workspace_status_offset))
        return;
    const bool expanded = (mode_flags & (CoreModeFlags{1} <<
        static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    auto* counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* begins = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    auto* errors = reinterpret_cast<__gm__ std::uint8_t*>(
        workspace + workspace_rank_flags_offset);
    auto* slots = reinterpret_cast<__gm__ std::int32_t*>(
        workspace + workspace_slot_offset);
    const std::uint64_t metadata_stride = 2 + num_topk;
    for (int destination_rank = static_cast<int>(threadIdx.x);
         destination_rank < world_size;
         destination_rank += static_cast<int>(blockDim.x)) {
        const std::int32_t encoded_begin = destination_rank == 0 ? 0 :
            prefix_per_rank[destination_rank - 1];
        const std::int32_t encoded_end = prefix_per_rank[destination_rank];
        if (encoded_begin < 0 || encoded_end < encoded_begin ||
            static_cast<std::uint64_t>(encoded_end) > num_source_rows ||
            (destination_rank + 1 == world_size &&
             static_cast<std::uint64_t>(encoded_end) != num_source_rows)) {
            errors[destination_rank] = static_cast<std::uint8_t>(
                CombineProtocolError::kInvalidPrefix);
            continue;
        }
        const std::uint64_t begin =
            static_cast<std::uint64_t>(encoded_begin);
        const std::uint64_t end = static_cast<std::uint64_t>(encoded_end);
        begins[destination_rank] = begin;
        std::uint64_t count = 0;
        CombineProtocolError error = CombineProtocolError::kNone;
        for (std::uint64_t row = begin; row < end; ++row) {
            const auto* metadata = source_metadata + row * metadata_stride;
            const std::int32_t master_lane = decode_dispatch_local_index(
                metadata[1], num_topk);
            if (!is_valid_combine_source_identity(
                    metadata[0], destination_rank, world_rank,
                    shard_capacity, num_tokens) ||
                decode_dispatch_source_rank(metadata[1], num_topk) !=
                    destination_rank ||
                !is_dispatch_local_index(master_lane, num_topk))
                error = CombineProtocolError::kInvalidMetadata;
            if (error != CombineProtocolError::kNone)
                break;
            bool owns_lane = !expanded;
            for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                const std::int32_t input_row = metadata[2 + lane];
                if (!expanded) {
                    if (input_row != -1)
                        error = CombineProtocolError::kInvalidMetadata;
                } else {
                    if (!combine_expanded_input_row_is_valid(
                            input_row, num_input_rows))
                        error = CombineProtocolError::kInvalidMetadata;
                    owns_lane = owns_lane || input_row != -1;
                }
                if (error != CombineProtocolError::kNone)
                    break;
            }
            if (error != CombineProtocolError::kNone)
                break;
            slots[row] = owns_lane ? static_cast<std::int32_t>(count++) : -1;
        }
        counts[destination_rank] = count;
        if (error == CombineProtocolError::kNone &&
            (count * combine_record_bytes > combine_staging_shard_bytes ||
            count * combine_record_bytes > combine_receive_shard_bytes)
            )
            error = CombineProtocolError::kCapacityOverflow;
        errors[destination_rank] = static_cast<std::uint8_t>(error);
    }
}

__simt_vf__ __launch_bounds__(512) inline void direct_combine_producer_reduce_errors_vf(
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_flags_offset,
    std::uint64_t workspace_rank_count) {
    if (threadIdx.x != 0)
        return;
    const auto context = make_hybrid_combine_context(
        transport_abi_version, transport_struct_size, transport_capabilities,
        transport_local_window_base, transport_channel_table,
        transport_peer_address_table, transport_topology_abi_version,
        transport_topology_struct_size, transport_world_rank,
        transport_world_size, transport_scale_up_rank,
        transport_scale_up_size, transport_scale_out_rank,
        transport_scale_out_size, transport_scale_up_direct,
        transport_topology_kind, transport_topology_epoch,
        transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    const auto* errors = reinterpret_cast<__gm__ const std::uint8_t*>(
        workspace + workspace_rank_flags_offset);
    for (std::uint64_t rank = 0; rank < workspace_rank_count; ++rank) {
        if (errors[rank] == 0)
            continue;
        record_combine_protocol_error(
            context, status_address, static_cast<int>(rank),
            static_cast<CombineProtocolError>(errors[rank]));
        return;
    }
}

__simt_vf__ __launch_bounds__(512) inline void direct_combine_producer_record_vf(
    __gm__ const bfloat16_t* x,
    __gm__ const float* topk_weights,
    __gm__ const std::int32_t* source_metadata,
    __gm__ std::uint8_t* workspace,
    std::uintptr_t local_window_base,
    CoreModeFlags mode_flags, std::uint64_t num_source_rows,
    std::uint64_t num_input_rows, std::uint64_t num_topk,
    std::uint64_t shard_capacity, std::uint64_t combine_record_bytes,
    std::uint64_t combine_weight_offset,
    std::uint64_t combine_staging_offset,
    std::uint64_t combine_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t workspace_slot_offset,
    int world_rank, int world_size, std::uint64_t hidden_elements) {
    if (!combine_direct_status_is_clean(
            workspace, workspace_status_offset))
        return;
    const bool expanded = (mode_flags & (CoreModeFlags{1} <<
        static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    const auto trailer = combine_record_trailer_layout(
        combine_record_bytes, false);
    const auto* begins = reinterpret_cast<__gm__ const std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    const auto* slots = reinterpret_cast<__gm__ const std::int32_t*>(
        workspace + workspace_slot_offset);
    const std::uint64_t metadata_stride = 2 + num_topk;
    const auto grid = direct_data_grid_stride(
        blockIdx.x, threadIdx.x, gridDim.x, blockDim.x);
    for (std::uint64_t row = grid.first; row < num_source_rows;
         row += grid.stride) {
        const std::int32_t output_slot = slots[row];
        if (output_slot < 0)
            continue;
        int destination_rank = world_size - 1;
        for (int rank = 1; rank < world_size; ++rank) {
            if (row < begins[rank]) {
                destination_rank = rank - 1;
                break;
            }
        }
        auto* record = reinterpret_cast<__gm__ std::uint8_t*>(
            combine_staging_shard_address(
                local_window_base, combine_staging_offset,
                static_cast<std::uint64_t>(destination_rank),
                combine_staging_shard_bytes)) +
            static_cast<std::uint64_t>(output_slot) * combine_record_bytes;
        const auto* metadata = source_metadata + row * metadata_stride;
        const std::int32_t master_lane = decode_dispatch_local_index(
            metadata[1], num_topk);
        auto* record_hidden = reinterpret_cast<__gm__ bfloat16_t*>(record);
        auto* record_weights = reinterpret_cast<__gm__ float*>(
            record + combine_weight_offset);
        for (std::uint64_t lane = 0; lane < num_topk; ++lane)
            record_weights[lane] = 0.0F;
        for (std::uint64_t hidden = 0; hidden < hidden_elements; ++hidden) {
            const float value = expanded ? combine_reduce_expanded_lanes(
                x, metadata + 2, num_topk, num_input_rows,
                hidden_elements, hidden) :
                static_cast<float>(x[row * hidden_elements + hidden]);
            record_hidden[hidden] = static_cast<bfloat16_t>(value);
        }
        if (!expanded) {
            combine_fill_normal_record_routing_weights(
                topk_weights, row, master_lane, num_topk,
                record, combine_weight_offset);
        } else {
            for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                const std::int32_t input_row = metadata[2 + lane];
                if (input_row != -1)
                    record_weights[lane] = topk_weights == nullptr ? 0.0F :
                        combine_routing_weight(
                            topk_weights,
                            static_cast<std::uint64_t>(input_row));
            }
        }
        auto* header = reinterpret_cast<__gm__ CombineRecordHeader*>(
            record + trailer.header_offset);
        header->abi_version = kCombineRecordAbiVersion;
        header->struct_size = sizeof(CombineRecordHeader);
        header->origin_token = decode_dispatch_local_index(
            metadata[0], shard_capacity);
        header->contributor_rank = world_rank;
        header->master_lane = master_lane;
        header->contribution_lane = master_lane;
    }
}

__simt_vf__ __launch_bounds__(512) inline void direct_combine_producer_local_copy_vf(
    __gm__ std::uint8_t* workspace,
    std::uintptr_t local_window_base,
    std::uint64_t combine_record_bytes,
    std::uint64_t combine_receive_offset,
    std::uint64_t combine_receive_shard_bytes,
    std::uint64_t combine_staging_offset,
    std::uint64_t combine_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    int world_rank) {
    if (!combine_direct_status_is_clean(
            workspace, workspace_status_offset))
        return;
    const auto* counts = reinterpret_cast<__gm__ const std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* source = reinterpret_cast<__gm__ const std::uint8_t*>(
        combine_staging_shard_address(
            local_window_base, combine_staging_offset,
            static_cast<std::uint64_t>(world_rank),
            combine_staging_shard_bytes));
    auto* destination = reinterpret_cast<__gm__ std::uint8_t*>(
        combine_receive_shard_address(
            local_window_base, combine_receive_offset,
            static_cast<std::uint64_t>(world_rank),
            combine_receive_shard_bytes));
    const std::uint64_t bytes = counts[world_rank] * combine_record_bytes;
    for (std::uint64_t byte = static_cast<std::uint64_t>(threadIdx.x);
         byte < bytes; byte += static_cast<std::uint64_t>(blockDim.x))
        destination[byte] = source[byte];
}

__simt_vf__ __launch_bounds__(512) inline void direct_combine_producer_release_vf(
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t combine_record_bytes,
    std::uint64_t combine_control_offset,
    std::uint64_t combine_receive_offset,
    std::uint64_t combine_receive_shard_bytes,
    std::uint64_t combine_staging_offset,
    std::uint64_t combine_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset) {
    if (threadIdx.x != 0)
        return;
    const auto context = make_hybrid_combine_context(
        transport_abi_version, transport_struct_size, transport_capabilities,
        transport_local_window_base, transport_channel_table,
        transport_peer_address_table, transport_topology_abi_version,
        transport_topology_struct_size, transport_world_rank,
        transport_world_size, transport_scale_up_rank,
        transport_scale_up_size, transport_scale_out_rank,
        transport_scale_out_size, transport_scale_up_direct,
        transport_topology_kind, transport_topology_epoch,
        transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    const auto* counts = reinterpret_cast<__gm__ const std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* control_slots = reinterpret_cast<__gm__ CombineControlSlot*>(
        transport_local_window_base + combine_control_offset);
    transport.system_fence();
    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        const std::uint64_t count = counts[destination_rank];
        if (destination_rank == transport_world_rank) {
            transport.store_release(
                reinterpret_cast<transport::DeviceAddress>(
                    &control_slots[transport_world_rank].count), count);
            transport.store_release(
                reinterpret_cast<transport::DeviceAddress>(
                    &control_slots[transport_world_rank].generation),
                generation);
            continue;
        }
        transport::TeamPeer route{};
        if (!transport::device::detail::checked_device_team_peer_for_world_rank(
                context.topology, destination_rank, &route))
            return record_combine_protocol_error(
                context, status_address, destination_rank,
                CombineProtocolError::kInvalidMetadata);
        const auto source = static_cast<transport::DeviceAddress>(
            combine_staging_shard_address(
                transport_local_window_base, combine_staging_offset,
                static_cast<std::uint64_t>(destination_rank),
                combine_staging_shard_bytes));
        const auto destination = static_cast<transport::DeviceAddress>(
            combine_receive_shard_address(
                transport_local_window_base, combine_receive_offset,
                static_cast<std::uint64_t>(transport_world_rank),
                combine_receive_shard_bytes));
        if (count != 0)
            transport.put(
                route.team, route.peer, destination, source,
                count * combine_record_bytes,
                transport::CooperationScope::kParticipant,
                transport::MemorySegment::kDevice,
                transport::kDefaultOptions,
                transport::RemoteAction::none());
        release_protocol::flush_payload(transport);
        const auto remote_count = static_cast<transport::DeviceAddress>(
            transport_local_window_base + combine_control_offset +
            static_cast<std::uint64_t>(transport_world_rank) *
                sizeof(CombineControlSlot) + sizeof(std::uint64_t));
        const auto remote_generation = static_cast<transport::DeviceAddress>(
            transport_local_window_base + combine_control_offset +
            static_cast<std::uint64_t>(transport_world_rank) *
                sizeof(CombineControlSlot));
        release_protocol::publish_control_and_release(
            transport, route, remote_count, count, remote_generation,
            generation, transport::sync_layout::kCombineReleaseSignalIndex);
    }
    const auto barrier_workspace = reinterpret_cast<transport::DeviceAddress>(
        &control_slots[transport_world_rank].generation);
    transport.device_barrier(
        transport::kWorldTeamMask, barrier_workspace, timeout_cycles);
}

__simt_vf__ __launch_bounds__(512) inline void hybrid_combine_return_vf(
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t route_slot_capacity, std::uint64_t record_capacity,
    std::uint64_t combine_record_bytes,
    std::uint64_t reverse_control_offset,
    std::uint64_t reverse_shard_offset,
    std::uint64_t reverse_shard_bytes,
    std::uint64_t return_control_offset,
    std::uint64_t return_shard_offset,
    std::uint64_t return_shard_bytes,
    std::uint64_t workspace_status_offset) {
    if (threadIdx.x != 0)
        return;
    const auto context = make_hybrid_combine_context(
        transport_abi_version, transport_struct_size, transport_capabilities,
        transport_local_window_base, transport_channel_table,
        transport_peer_address_table, transport_topology_abi_version,
        transport_topology_struct_size, transport_world_rank,
        transport_world_size, transport_scale_up_rank,
        transport_scale_up_size, transport_scale_out_rank,
        transport_scale_out_size, transport_scale_up_direct,
        transport_topology_kind, transport_topology_epoch,
        transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    const auto record_trailer =
        combine_record_trailer_layout(combine_record_bytes, true);
    if (!record_trailer.valid)
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kInvalidLayout);
    auto* reverse_control = reinterpret_cast<__gm__ CombineControlSlot*>(
        transport_local_window_base + reverse_control_offset);
    for (int contributor_rank =
             transport_scale_out_rank * transport_scale_up_size;
         contributor_rank <
             (transport_scale_out_rank + 1) * transport_scale_up_size;
         ++contributor_rank) {
        if (contributor_rank == transport_world_rank)
            continue;
        const int origin_domain = 1 - transport_scale_out_rank;
        const int origin_rank =
            origin_domain * transport_scale_up_size + transport_scale_up_rank;
        const std::uint64_t observed_generation =
            transport.load_acquire(reinterpret_cast<transport::DeviceAddress>(
                &reverse_control[origin_rank].generation));
        const std::uint64_t count =
            transport.load_acquire(reinterpret_cast<transport::DeviceAddress>(
                &reverse_control[origin_rank].count));
        if (observed_generation != generation || count > record_capacity)
            return record_combine_protocol_error(
                context, status_address, contributor_rank,
                observed_generation != generation ?
                    CombineProtocolError::kInvalidControl :
                    CombineProtocolError::kCapacityOverflow);
        auto* input = reinterpret_cast<__gm__ const std::uint8_t*>(
            transport_local_window_base + reverse_shard_offset +
            static_cast<std::uint64_t>(origin_rank) * reverse_shard_bytes);
        auto* output = reinterpret_cast<__gm__ std::uint8_t*>(
            transport_local_window_base + return_shard_offset +
            static_cast<std::uint64_t>(contributor_rank) * return_shard_bytes);
        for (std::uint64_t input_slot = 0; input_slot < count; ++input_slot) {
            auto* input_record = input + input_slot * combine_record_bytes;
            auto* route_metadata_pointer = reinterpret_cast<
                __gm__ const HybridCombineRouteMetadata*>(
                    input_record + record_trailer.route_metadata_offset);
            const auto route_metadata =
                load_observed_hybrid_combine_route_metadata(
                    route_metadata_pointer);
            if (route_slot_capacity == 0 ||
                route_metadata.ingress_slot == kInvalidHybridRouteSlot ||
                route_metadata.forwarded_slot == kInvalidHybridRouteSlot ||
                route_metadata.ingress_slot / route_slot_capacity !=
                    static_cast<std::uint64_t>(origin_rank) ||
                route_metadata.forwarded_slot / route_slot_capacity !=
                    static_cast<std::uint64_t>(origin_rank))
                return record_combine_protocol_error(
                    context, status_address, contributor_rank,
                    CombineProtocolError::kInvalidMetadata);
        }
        for (std::uint64_t input_slot = 0; input_slot < count; ++input_slot) {
            auto* input_record = input + input_slot * combine_record_bytes;
            auto* route_metadata_pointer = reinterpret_cast<
                __gm__ const HybridCombineRouteMetadata*>(
                    input_record + record_trailer.route_metadata_offset);
            const auto route_metadata =
                load_observed_hybrid_combine_route_metadata(
                    route_metadata_pointer);
            std::uint64_t output_slot = 0;
            for (std::uint64_t prior_slot = 0; prior_slot < count;
                 ++prior_slot) {
                auto* prior_record = input + prior_slot * combine_record_bytes;
                auto* prior_metadata_pointer = reinterpret_cast<
                    __gm__ const HybridCombineRouteMetadata*>(
                        prior_record + record_trailer.route_metadata_offset);
                const auto prior_metadata =
                    load_observed_hybrid_combine_route_metadata(
                        prior_metadata_pointer);
                if (prior_metadata.ingress_slot <
                        route_metadata.ingress_slot ||
                    (prior_metadata.ingress_slot ==
                         route_metadata.ingress_slot &&
                     prior_slot < input_slot))
                    ++output_slot;
            }
            auto* output_record = output + output_slot * combine_record_bytes;
            for (std::uint64_t byte = 0; byte < combine_record_bytes; ++byte)
                output_record[byte] = input_record[byte];
        }
        transport.system_fence();
        transport::TeamPeer route{
            transport::TransportTeam::kScaleOut,
            origin_domain, origin_rank};
        const auto source = reinterpret_cast<transport::DeviceAddress>(output);
        const auto destination = transport_local_window_base +
            return_shard_offset +
            static_cast<std::uint64_t>(contributor_rank) *
                return_shard_bytes;
        if (count != 0) {
            transport.put(
                transport::TransportTeam::kScaleOut, route.peer,
                destination, source, count * combine_record_bytes,
                transport::CooperationScope::kParticipant,
                transport::MemorySegment::kDevice,
                transport::kDefaultOptions,
                transport::RemoteAction::none());
        }
        release_protocol::flush_payload(transport);
        const auto remote_slot = transport_local_window_base +
            return_control_offset +
            static_cast<std::uint64_t>(contributor_rank) *
                sizeof(CombineControlSlot);
        release_protocol::publish_control_and_release(
            transport, route, remote_slot + sizeof(std::uint64_t), count,
            remote_slot, generation,
            transport::sync_layout::kCombineReleaseSignalIndex);
    }
    transport.device_barrier(
        transport::kWorldTeamMask,
        reinterpret_cast<transport::DeviceAddress>(
            &reverse_control[transport_world_rank].generation),
        timeout_cycles);
}

__simt_vf__ __launch_bounds__(512) inline void hybrid_combine_prepare_epilogue_vf(
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t record_capacity, std::uint64_t combine_record_bytes,
    std::uint64_t combine_control_offset,
    std::uint64_t combine_receive_offset,
    std::uint64_t combine_receive_shard_bytes,
    std::uint64_t return_control_offset,
    std::uint64_t return_shard_offset,
    std::uint64_t return_shard_bytes,
    std::uint64_t workspace_status_offset) {
    if (threadIdx.x != 0)
        return;
    const auto context = make_hybrid_combine_context(
        transport_abi_version, transport_struct_size, transport_capabilities,
        transport_local_window_base, transport_channel_table,
        transport_peer_address_table, transport_topology_abi_version,
        transport_topology_struct_size, transport_world_rank,
        transport_world_size, transport_scale_up_rank,
        transport_scale_up_size, transport_scale_out_rank,
        transport_scale_out_size, transport_scale_up_direct,
        transport_topology_kind, transport_topology_epoch,
        transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    auto* direct_control = reinterpret_cast<__gm__ CombineControlSlot*>(
        transport_local_window_base + combine_control_offset);
    auto* return_control = reinterpret_cast<__gm__ CombineControlSlot*>(
        transport_local_window_base + return_control_offset);
    for (int contributor_rank = 0; contributor_rank < transport_world_size;
         ++contributor_rank) {
        const auto route = classify_world_route(
            transport_world_rank, contributor_rank, transport_scale_up_size);
        if (route.kind != WorldRouteKind::kDiagonal)
            continue;
        const auto release_boundary = combine_prepare_release_boundary(
            transport_world_rank, contributor_rank, transport_scale_up_size);
        const auto observation = release_protocol::observe_release_control(
            transport, context.topology, release_boundary,
            transport_world_rank, return_control,
            transport::sync_layout::kCombineReleaseSignalIndex,
            generation, timeout_cycles);
        const std::uint64_t count = observation.count;
        if (!observation.acquired ||
            observation.generation != generation ||
            count > record_capacity)
            return record_combine_protocol_error(
                context, status_address, contributor_rank,
                CombineProtocolError::kInvalidControl);
        auto* source = reinterpret_cast<__gm__ const std::uint8_t*>(
            transport_local_window_base + return_shard_offset +
            static_cast<std::uint64_t>(contributor_rank) *
                return_shard_bytes);
        auto* destination = reinterpret_cast<__gm__ std::uint8_t*>(
            combine_receive_shard_address(
                transport_local_window_base, combine_receive_offset,
                static_cast<std::uint64_t>(contributor_rank),
                combine_receive_shard_bytes));
        for (std::uint64_t byte = 0;
             byte < count * combine_record_bytes; ++byte)
            destination[byte] = source[byte];
        release_protocol::publish_local_control(
            transport,
            reinterpret_cast<transport::DeviceAddress>(
                &direct_control[contributor_rank].count),
            count,
            reinterpret_cast<transport::DeviceAddress>(
                &direct_control[contributor_rank].generation),
            generation);
    }
}

struct CombineOriginDeviceRecordSource {
    __gm__ const std::uint8_t* receive_base;
    std::uint64_t receive_shard_bytes;
    std::uint64_t record_bytes;
    std::uint64_t header_offset;
    std::uint64_t weight_offset;
    std::uint64_t hidden_elements;
    __gm__ const std::uint64_t* contributor_counts;
    std::uint64_t contributor_count;

    DEEP_EP_ASCEND_SIMT_CALLEE std::uint64_t record_count(
        std::uint64_t contributor_rank) const {
        return contributor_rank < contributor_count ?
            contributor_counts[contributor_rank] : 0;
    }

    DEEP_EP_ASCEND_SIMT_CALLEE CombineOriginRecordView record_at(
        std::uint64_t contributor_rank, std::uint64_t slot,
        std::uint64_t hidden) const {
        auto* record = receive_base + contributor_rank * receive_shard_bytes +
            slot * record_bytes;
        auto* header = reinterpret_cast<__gm__ const CombineRecordHeader*>(
            record + header_offset);
        auto* payload = reinterpret_cast<__gm__ const bfloat16_t*>(record);
        auto* weights = reinterpret_cast<__gm__ const float*>(
            record + weight_offset);
        return {load_observed_combine_record_header(header),
                hidden < hidden_elements ?
                    static_cast<float>(payload[hidden]) : 0.0F,
                weights};
    }
};

__simt_vf__ __launch_bounds__(512) inline void combine_epilogue_vf(
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ const float* topk_weights,
    __gm__ const bfloat16_t* bias_0,
    __gm__ const bfloat16_t* bias_1,
    __gm__ std::uint8_t* workspace,
    __gm__ bfloat16_t* combined_x,
    __gm__ float* combined_topk_weights,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t timeout_cycles, std::uint64_t num_tokens,
    std::uint64_t num_experts, std::uint64_t num_topk,
    std::uint64_t shard_capacity, std::uint64_t combine_record_bytes,
    std::uint64_t combine_weight_offset,
    std::uint64_t control_offset,
    std::uint64_t combine_control_offset,
    std::uint64_t combine_control_bytes,
    std::uint64_t combine_receive_offset,
    std::uint64_t combine_receive_shard_bytes,
    std::uint64_t combine_receive_shard_count,
    std::uint64_t combine_receive_bytes,
    std::uint64_t workspace_scratch_status_offset,
    std::uint64_t workspace_scratch_rank_counts_offset,
    std::uint64_t workspace_scratch_rank_count,
    std::uint64_t hidden_elements) {
    if (threadIdx.x != 0)
        return;

    transport::DeviceTransportContext context{};
    context.abi_version = transport_abi_version;
    context.struct_size = transport_struct_size;
    context.capabilities = transport_capabilities;
    context.topology.abi_version = transport_topology_abi_version;
    context.topology.struct_size = transport_topology_struct_size;
    context.topology.world_rank = transport_world_rank;
    context.topology.world_size = transport_world_size;
    context.topology.scale_up_rank = transport_scale_up_rank;
    context.topology.scale_up_size = transport_scale_up_size;
    context.topology.scale_out_rank = transport_scale_out_rank;
    context.topology.scale_out_size = transport_scale_out_size;
    context.topology.scale_up_direct = transport_scale_up_direct != 0;
    context.topology.kind = static_cast<transport::TransportTopologyKind>(
        transport_topology_kind);
    context.topology.epoch = transport_topology_epoch;
    context.local_window_base = transport_local_window_base;
    context.channel_table = transport_channel_table;
    context.peer_address_table = transport_peer_address_table;
    context.backend_context = transport_backend_context;
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address =
        reinterpret_cast<transport::DeviceAddress>(
            workspace + workspace_scratch_status_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    if (!is_valid_combine_token_extent(num_tokens, shard_capacity))
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kCapacityOverflow);
    const auto consumed_generation = transport.consumed_generation();
    auto* queue = transport::device::detail::command_queue(context);
    auto* diagnostic = transport::device::detail::diagnostic(queue);
    if (diagnostic == nullptr)
        return;
    const auto diagnostic_abi_version =
        transport::simt::load_observed(&diagnostic->abi_version);
    const auto diagnostic_generation =
        transport::simt::load_observed(&diagnostic->generation);
    const auto diagnostic_error =
        static_cast<transport::DeviceTransportError>(
            transport::simt::load_observed(
                reinterpret_cast<__gm__ const std::uint32_t*>(
                    &diagnostic->error)));
    if (!is_clean_combine_transport_completion(
            generation, consumed_generation, diagnostic_abi_version,
            diagnostic_generation, diagnostic_error))
        return;

    if (workspace_scratch_rank_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        combine_control_bytes <
            static_cast<std::uint64_t>(transport_world_size) *
                sizeof(CombineControlSlot) ||
        combine_receive_shard_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        combine_receive_bytes <
            combine_receive_shard_count * combine_receive_shard_bytes)
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kInvalidLayout);

    const bool expanded = (mode_flags & (CoreModeFlags{1} <<
        static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    const bool allow_multiple_reduction = (mode_flags & (CoreModeFlags{1} <<
        static_cast<std::uint8_t>(CoreMode::kAllowMultipleReduction))) != 0;
    const bool hybrid = (mode_flags & (CoreModeFlags{1} <<
        static_cast<std::uint8_t>(CoreMode::kHybrid))) != 0;
    const auto record_trailer =
        combine_record_trailer_layout(combine_record_bytes, hybrid);
    const std::uint64_t record_capacity = expanded && !allow_multiple_reduction ?
        shard_capacity * num_topk : shard_capacity;
    auto* contributor_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_scratch_rank_counts_offset);
    auto* control_slots = reinterpret_cast<__gm__ CombineControlSlot*>(
        transport_local_window_base + combine_control_offset);
    for (int contributor_rank = 0;
         contributor_rank < transport_world_size; ++contributor_rank) {
        const auto release_boundary = combine_release_boundary(
            transport_world_rank, contributor_rank,
            transport_scale_up_size);
        const auto observation =
            release_protocol::observe_release_control(
                transport, context.topology, release_boundary,
                transport_world_rank, control_slots,
                transport::sync_layout::kCombineReleaseSignalIndex,
                generation, timeout_cycles);
        if (!observation.acquired)
            return record_combine_protocol_error(
                context, status_address, contributor_rank,
                CombineProtocolError::kInvalidControl);
        const std::uint64_t observed_generation = observation.generation;
        const std::uint64_t record_count = observation.count;
        if (observed_generation != generation ||
            record_count > record_capacity ||
            record_count * combine_record_bytes >
                combine_receive_shard_bytes)
            return record_combine_protocol_error(
                context, status_address, contributor_rank,
                record_count > record_capacity ?
                    CombineProtocolError::kCapacityOverflow :
                    CombineProtocolError::kInvalidControl);
        contributor_counts[contributor_rank] = record_count;
    }

    const std::uint64_t hidden_bytes =
        hidden_elements * sizeof(std::uint16_t);
    if (!record_trailer.valid ||
        hidden_bytes > combine_weight_offset ||
        combine_weight_offset > record_trailer.header_offset ||
        num_topk >
            (record_trailer.header_offset - combine_weight_offset) /
                sizeof(float))
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kInvalidLayout);
    const std::uint64_t num_local_experts =
        num_experts / static_cast<std::uint64_t>(transport_world_size);
    // Validate all record headers before reading any payload or writing output.
    for (int contributor_rank = 0;
         contributor_rank < transport_world_size; ++contributor_rank) {
        auto* receive_shard = reinterpret_cast<__gm__ const std::uint8_t*>(
            combine_receive_shard_address(
                transport_local_window_base, combine_receive_offset,
                static_cast<std::uint64_t>(contributor_rank),
                combine_receive_shard_bytes));
        for (std::uint64_t slot = 0;
             slot < contributor_counts[contributor_rank]; ++slot) {
            auto* header =
                reinterpret_cast<__gm__ const CombineRecordHeader*>(
                    receive_shard + slot * combine_record_bytes +
                    record_trailer.header_offset);
            const auto observed_header =
                load_observed_combine_record_header(header);
            const bool valid_token = is_valid_combine_origin_token(
                observed_header.origin_token, num_tokens, shard_capacity);
            bool valid_lanes = false;
            if (valid_token)
                valid_lanes = is_valid_combine_record_lanes(
                    combined_topk_indices +
                        static_cast<std::uint64_t>(
                            observed_header.origin_token) *
                            num_topk,
                    num_topk, num_experts, num_local_experts,
                    contributor_rank, observed_header.master_lane,
                    observed_header.contribution_lane, expanded,
                    allow_multiple_reduction);
            if (observed_header.abi_version != kCombineRecordAbiVersion ||
                observed_header.struct_size != sizeof(CombineRecordHeader) ||
                observed_header.contributor_rank != contributor_rank ||
                !valid_token || !valid_lanes)
                return record_combine_protocol_error(
                    context, status_address, contributor_rank,
                    CombineProtocolError::kInvalidHeader);
            for (std::uint64_t prior = 0; prior < slot; ++prior) {
                auto* prior_header =
                    reinterpret_cast<__gm__ const CombineRecordHeader*>(
                        receive_shard + prior * combine_record_bytes +
                        record_trailer.header_offset);
                const auto observed_prior =
                    load_observed_combine_record_header(prior_header);
                if (observed_prior.origin_token ==
                        observed_header.origin_token &&
                    (!expanded || allow_multiple_reduction ||
                     observed_prior.contribution_lane ==
                         observed_header.contribution_lane))
                    return record_combine_protocol_error(
                        context, status_address, contributor_rank,
                        CombineProtocolError::kDuplicateRecord);
            }
        }
    }

    const CombineOriginDeviceRecordSource origin_records{
        reinterpret_cast<__gm__ const std::uint8_t*>(
            transport_local_window_base + combine_receive_offset),
        combine_receive_shard_bytes, combine_record_bytes,
        record_trailer.header_offset,
        combine_weight_offset, hidden_elements, contributor_counts,
        workspace_scratch_rank_count};
    for (std::uint64_t token = 0; token < num_tokens; ++token) {
        for (std::uint64_t hidden = 0;
             hidden < hidden_elements; ++hidden) {
            const float value = combine_reduce_origin_records(
                origin_records,
                static_cast<std::uint64_t>(transport_world_size),
                static_cast<std::int32_t>(token), combined_topk_indices,
                num_topk, num_experts, num_local_experts, expanded,
                allow_multiple_reduction, hidden,
                bias_0 == nullptr ? 0.0F : static_cast<float>(
                    bias_0[token * hidden_elements + hidden]),
                bias_1 == nullptr ? 0.0F : static_cast<float>(
                    bias_1[token * hidden_elements + hidden]), nullptr);
            combined_x[token * hidden_elements + hidden] =
                static_cast<bfloat16_t>(value);
        }
    }
    if (combined_topk_weights != nullptr) {
        for (std::uint64_t token = 0; token < num_tokens; ++token) {
            (void)combine_reduce_origin_records(
                origin_records,
                static_cast<std::uint64_t>(transport_world_size),
                static_cast<std::int32_t>(token), combined_topk_indices,
                num_topk, num_experts, num_local_experts, expanded,
                allow_multiple_reduction, hidden_elements, 0.0F, 0.0F,
                combined_topk_weights + token * num_topk);
        }
    }

    auto* control = reinterpret_cast<__gm__ SymmetricControlHeader*>(
        transport_local_window_base + control_offset);
    transport.store_release(
        reinterpret_cast<transport::DeviceAddress>(
            &control->combine_generation), generation);
}

__simt_vf__ __launch_bounds__(512) inline void direct_combine_epilogue_acquire_vf(
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t num_tokens, std::uint64_t shard_capacity,
    std::uint64_t combine_record_bytes,
    std::uint64_t combine_control_offset,
    std::uint64_t combine_control_bytes,
    std::uint64_t combine_receive_shard_bytes,
    std::uint64_t combine_receive_shard_count,
    std::uint64_t combine_receive_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_count) {
    if (threadIdx.x != 0)
        return;
    const auto context = make_hybrid_combine_context(
        transport_abi_version, transport_struct_size, transport_capabilities,
        transport_local_window_base, transport_channel_table,
        transport_peer_address_table, transport_topology_abi_version,
        transport_topology_struct_size, transport_world_rank,
        transport_world_size, transport_scale_up_rank,
        transport_scale_up_size, transport_scale_out_rank,
        transport_scale_out_size, transport_scale_up_direct,
        transport_topology_kind, transport_topology_epoch,
        transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    if (!is_valid_combine_token_extent(num_tokens, shard_capacity))
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kCapacityOverflow);
    auto* queue = transport::device::detail::command_queue(context);
    auto* diagnostic = transport::device::detail::diagnostic(queue);
    if (diagnostic == nullptr ||
        !is_clean_combine_transport_completion(
            generation, transport.consumed_generation(),
            transport::simt::load_observed(&diagnostic->abi_version),
            transport::simt::load_observed(&diagnostic->generation),
            static_cast<transport::DeviceTransportError>(
                transport::simt::load_observed(
                    reinterpret_cast<__gm__ const std::uint32_t*>(
                        &diagnostic->error)))))
        return;
    if (workspace_rank_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        combine_control_bytes <
            static_cast<std::uint64_t>(transport_world_size) *
                sizeof(CombineControlSlot) ||
        combine_receive_shard_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        combine_receive_bytes <
            combine_receive_shard_count * combine_receive_shard_bytes)
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kInvalidLayout);
    auto* counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* controls = reinterpret_cast<__gm__ CombineControlSlot*>(
        transport_local_window_base + combine_control_offset);
    for (int contributor_rank = 0;
         contributor_rank < transport_world_size; ++contributor_rank) {
        const auto boundary = combine_release_boundary(
            transport_world_rank, contributor_rank, transport_scale_up_size);
        const auto observation = release_protocol::observe_release_control(
            transport, context.topology, boundary, transport_world_rank,
            controls, transport::sync_layout::kCombineReleaseSignalIndex,
            generation, timeout_cycles);
        if (!observation.acquired || observation.generation != generation ||
            observation.count > shard_capacity ||
            observation.count * combine_record_bytes >
                combine_receive_shard_bytes)
            return record_combine_protocol_error(
                context, status_address, contributor_rank,
                observation.count > shard_capacity ?
                    CombineProtocolError::kCapacityOverflow :
                    CombineProtocolError::kInvalidControl);
        counts[contributor_rank] = observation.count;
    }
}

__simt_vf__ __launch_bounds__(512) inline void direct_combine_epilogue_clear_index_vf(
    __gm__ std::uint8_t* workspace,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_slot_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t workspace_rank_count,
    std::uint64_t num_tokens, std::uint64_t num_topk) {
    if (!combine_direct_status_is_clean(
            workspace, workspace_status_offset))
        return;
    auto* slots = reinterpret_cast<__gm__ std::int32_t*>(
        workspace + workspace_slot_offset);
    const std::uint64_t slot_count = num_tokens * num_topk;
    for (std::uint64_t index = static_cast<std::uint64_t>(threadIdx.x);
         index < slot_count;
         index += static_cast<std::uint64_t>(blockDim.x))
        slots[index] = -1;
    auto* errors = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    for (std::uint64_t rank = static_cast<std::uint64_t>(threadIdx.x);
         rank < workspace_rank_count;
         rank += static_cast<std::uint64_t>(blockDim.x))
        errors[rank] = 0;
}

__simt_vf__ __launch_bounds__(512) inline void direct_combine_epilogue_validate_vf(
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ std::uint8_t* workspace,
    std::uintptr_t local_window_base,
    CoreModeFlags mode_flags, int world_size, std::uint64_t num_tokens,
    std::uint64_t num_experts, std::uint64_t num_topk,
    std::uint64_t shard_capacity,
    std::uint64_t combine_record_bytes,
    std::uint64_t combine_weight_offset,
    std::uint64_t combine_receive_offset,
    std::uint64_t combine_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t workspace_slot_offset,
    std::uint64_t hidden_elements) {
    if (!combine_direct_status_is_clean(
            workspace, workspace_status_offset))
        return;
    const auto trailer = combine_record_trailer_layout(
        combine_record_bytes, false);
    const bool expanded = (mode_flags & (CoreModeFlags{1} <<
        static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    const bool allow_multiple_reduction =
        (mode_flags & (CoreModeFlags{1} << static_cast<std::uint8_t>(
            CoreMode::kAllowMultipleReduction))) != 0;
    const std::uint64_t hidden_bytes =
        hidden_elements * sizeof(std::uint16_t);
    auto* errors = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    if (!trailer.valid || hidden_bytes > combine_weight_offset ||
        combine_weight_offset > trailer.header_offset ||
        num_topk > (trailer.header_offset - combine_weight_offset) /
            sizeof(float)) {
        if (threadIdx.x == 0)
            errors[0] = (std::uint64_t{1} << 32U) |
                static_cast<std::uint32_t>(
                    CombineProtocolError::kInvalidLayout);
        return;
    }
    const auto* counts = reinterpret_cast<__gm__ const std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* slots = reinterpret_cast<__gm__ std::int32_t*>(
        workspace + workspace_slot_offset);
    const std::uint64_t local_experts =
        num_experts / static_cast<std::uint64_t>(world_size);
    for (int contributor_rank = static_cast<int>(threadIdx.x);
         contributor_rank < world_size;
         contributor_rank += static_cast<int>(blockDim.x)) {
        auto* shard = reinterpret_cast<__gm__ const std::uint8_t*>(
            combine_receive_shard_address(
                local_window_base, combine_receive_offset,
                static_cast<std::uint64_t>(contributor_rank),
                combine_receive_shard_bytes));
        CombineProtocolError error = CombineProtocolError::kNone;
        for (std::uint64_t slot = 0; slot < counts[contributor_rank]; ++slot) {
            auto* header = reinterpret_cast<
                __gm__ const CombineRecordHeader*>(
                    shard + slot * combine_record_bytes +
                    trailer.header_offset);
            const auto observed = load_observed_combine_record_header(header);
            const bool valid_token = is_valid_combine_origin_token(
                observed.origin_token, num_tokens, shard_capacity);
            const bool valid_lanes = valid_token &&
                is_valid_combine_record_lanes(
                    combined_topk_indices +
                        static_cast<std::uint64_t>(observed.origin_token) *
                            num_topk,
                    num_topk, num_experts, local_experts, contributor_rank,
                    observed.master_lane, observed.contribution_lane,
                    expanded, allow_multiple_reduction);
            if (observed.abi_version != kCombineRecordAbiVersion ||
                observed.struct_size != sizeof(CombineRecordHeader) ||
                observed.contributor_rank != contributor_rank ||
                !valid_token || !valid_lanes) {
                error = CombineProtocolError::kInvalidHeader;
                break;
            }
            std::uint64_t index = 0;
            if (!combine_simt_record_slot_index(
                    static_cast<std::uint64_t>(observed.origin_token),
                    static_cast<std::uint64_t>(observed.contribution_lane),
                    num_tokens, num_topk, &index)) {
                error = CombineProtocolError::kInvalidHeader;
                break;
            }
            if (slots[index] != -1) {
                error = CombineProtocolError::kDuplicateRecord;
                break;
            }
            slots[index] = static_cast<std::int32_t>(slot);
        }
        if (error != CombineProtocolError::kNone)
            errors[contributor_rank] =
                (static_cast<std::uint64_t>(contributor_rank + 1) << 32U) |
                static_cast<std::uint32_t>(error);
    }
}

__simt_vf__ __launch_bounds__(512) inline void direct_combine_epilogue_reduce_errors_vf(
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t workspace_rank_count) {
    if (threadIdx.x != 0)
        return;
    const auto context = make_hybrid_combine_context(
        transport_abi_version, transport_struct_size, transport_capabilities,
        transport_local_window_base, transport_channel_table,
        transport_peer_address_table, transport_topology_abi_version,
        transport_topology_struct_size, transport_world_rank,
        transport_world_size, transport_scale_up_rank,
        transport_scale_up_size, transport_scale_out_rank,
        transport_scale_out_size, transport_scale_up_direct,
        transport_topology_kind, transport_topology_epoch,
        transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    const auto* errors = reinterpret_cast<__gm__ const std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    for (std::uint64_t rank = 0; rank < workspace_rank_count; ++rank) {
        const std::uint64_t candidate = errors[rank];
        if (candidate == 0)
            continue;
        const int peer_rank = static_cast<int>((candidate >> 32U) - 1);
        record_combine_protocol_error(
            context, status_address, peer_rank,
            static_cast<CombineProtocolError>(
                static_cast<std::uint32_t>(candidate)));
        return;
    }
}

DEEP_EP_ASCEND_SIMT_CALLEE std::uint32_t
topk_compact_owner_ordinal(
    TopkSubgroupMask owner_mask, std::int32_t key) {
    std::uint32_t ordinal = 0;
    TopkSubgroupMask remaining = owner_mask;
    while (remaining != 0) {
        const std::int32_t owner_lane = topk_first_set_lane(remaining);
        const std::int32_t owner_key = asc_shfl(
            key, static_cast<std::uint32_t>(owner_lane),
            kTopkSubgroupWidth);
        if (owner_key < key)
            ++ordinal;
        remaining &= ~(TopkSubgroupMask{1} <<
                       static_cast<std::uint32_t>(owner_lane));
    }
    return ordinal;
}

__simt_vf__ __launch_bounds__(512) inline void direct_combine_epilogue_prepare_vector_slots_vf(
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ std::uint8_t* workspace,
    int world_size, std::uint64_t num_tokens,
    std::uint64_t num_experts, std::uint64_t num_topk,
    std::uint64_t workspace_status_offset,
    std::uint64_t slot_offset) {
    if (!combine_direct_status_is_clean(
            workspace, workspace_status_offset))
        return;
    auto* slots = reinterpret_cast<__gm__ std::int32_t*>(
        workspace + slot_offset);
    const std::uint64_t local_experts =
        num_experts / static_cast<std::uint64_t>(world_size);
    const auto work = direct_subgroup_grid_stride(
        blockIdx.x, threadIdx.x, gridDim.x, blockDim.x,
        kTopkSubgroupWidth);
    for (std::uint64_t token = work.first; token < num_tokens;
         token += work.stride) {
        const bool logical = work.lane < num_topk;
        const std::uint64_t logical_index = token * num_topk + work.lane;
        const std::int64_t expert = logical ?
            combined_topk_indices[logical_index] : -1;
        const bool active = logical && expert >= 0 &&
            static_cast<std::uint64_t>(expert) < num_experts;
        const std::int32_t contributor_key = active ?
            static_cast<std::int32_t>(
                static_cast<std::uint64_t>(expert) / local_experts) : -1;
        const auto group = group_topk_subgroup(contributor_key, active);
        const std::int32_t observed_slot = active ?
            slots[logical_index] : -1;
        const std::int32_t resolved_slot = topk_broadcast_owner_value(
            group, observed_slot, -1);
        if (logical)
            slots[logical_index] = resolved_slot;
    }
}

template <std::uint64_t StaticNumTopk,
          std::uint64_t StaticHiddenElements>
__aicore__ inline void direct_combine_epilogue_vector_reduce_impl(
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ const bfloat16_t* bias_0,
    __gm__ const bfloat16_t* bias_1,
    __gm__ std::uint8_t* workspace,
    __gm__ bfloat16_t* combined_x,
    std::uintptr_t local_window_base,
    int world_size, std::uint64_t num_tokens,
    std::uint64_t num_experts, std::uint64_t num_topk,
    std::uint64_t combine_record_bytes,
    std::uint64_t combine_receive_offset,
    std::uint64_t combine_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t slot_offset,
    std::uint64_t hidden_elements) {
    static_assert(
        (StaticNumTopk == 0) == (StaticHiddenElements == 0),
        "static combine extents must be both zero or both nonzero");
    const std::uint64_t effective_num_topk =
        StaticNumTopk == 0 ? num_topk : StaticNumTopk;
    const std::uint64_t effective_hidden_elements =
        StaticHiddenElements == 0 ? hidden_elements : StaticHiddenElements;
    const auto* status = reinterpret_cast<__gm__ const std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::aicore::load_device(status) != 0)
        return;

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> input_queue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> output_queue;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> scratch_buffer;
    (void)pipe.InitBuffer(
        input_queue, 1,
        kCombineVectorTileElements * sizeof(bfloat16_t));
    (void)pipe.InitBuffer(
        output_queue, 1,
        kCombineVectorTileElements * sizeof(bfloat16_t));
    (void)pipe.InitBuffer(
        scratch_buffer,
        2 * kCombineVectorTileElements * sizeof(float));

    AscendC::GlobalTensor<std::int64_t> topk_global;
    AscendC::GlobalTensor<std::int32_t> slots_global;
    AscendC::GlobalTensor<bfloat16_t> input_global;
    topk_global.SetGlobalBuffer(
        const_cast<__gm__ std::int64_t*>(combined_topk_indices),
        num_tokens * effective_num_topk);
    slots_global.SetGlobalBuffer(
        reinterpret_cast<__gm__ std::int32_t*>(workspace + slot_offset),
        num_tokens * effective_num_topk);

    const std::uint64_t local_experts =
        num_experts / static_cast<std::uint64_t>(world_size);
    const std::uint64_t vector_end =
        effective_hidden_elements -
        effective_hidden_elements % kCombineVectorTileElements;
    const auto block_index =
        static_cast<std::uint64_t>(AscendC::GetBlockIdx());
    const auto block_count =
        static_cast<std::uint64_t>(AscendC::GetBlockNum());
    auto scratch = scratch_buffer.Get<float>();
    auto accumulation = scratch;
    auto contribution = scratch[kCombineVectorTileElements];

    for (std::uint64_t token = block_index; token < num_tokens;
         token += block_count) {
        std::int32_t contributor_ranks[kTopkSubgroupWidth];
        std::int32_t receive_slots[kTopkSubgroupWidth];
        std::uint32_t contributor_count = 0;
        const std::uint64_t token_base = token * effective_num_topk;
        for (int contributor_rank = 0;
             contributor_rank < world_size; ++contributor_rank) {
            std::int32_t receive_slot = -1;
            for (std::uint64_t lane = 0;
                 lane < effective_num_topk; ++lane) {
                const std::int64_t expert =
                    topk_global.GetValue(token_base + lane);
                if (expert >= 0 &&
                    static_cast<std::uint64_t>(expert) < num_experts &&
                    static_cast<std::uint64_t>(expert) / local_experts ==
                        static_cast<std::uint64_t>(contributor_rank)) {
                    receive_slot = slots_global.GetValue(token_base + lane);
                    break;
                }
            }
            if (receive_slot >= 0) {
                contributor_ranks[contributor_count] = contributor_rank;
                receive_slots[contributor_count] = receive_slot;
                ++contributor_count;
            }
        }

        for (std::uint64_t hidden = 0; hidden < vector_end;
             hidden += kCombineVectorTileElements) {
            AscendC::Duplicate(
                accumulation, 0.0F,
                static_cast<std::int32_t>(kCombineVectorTileElements));
            for (std::uint32_t contributor_index = 0;
                 contributor_index < contributor_count;
                 ++contributor_index) {
                const std::uintptr_t shard = local_window_base +
                    combine_receive_offset +
                    static_cast<std::uint64_t>(
                        contributor_ranks[contributor_index]) *
                        combine_receive_shard_bytes;
                auto* payload = reinterpret_cast<__gm__ bfloat16_t*>(
                    shard + static_cast<std::uint64_t>(
                        receive_slots[contributor_index]) *
                        combine_record_bytes);
                input_global.SetGlobalBuffer(
                    payload + hidden, kCombineVectorTileElements);
                auto input_local =
                    input_queue.AllocTensor<bfloat16_t>();
                AscendC::DataCopy(
                    input_local, input_global,
                    kCombineVectorTileElements);
                input_queue.EnQue(input_local);
                input_local = input_queue.DeQue<bfloat16_t>();
                AscendC::Cast(
                    contribution, input_local,
                    AscendC::RoundMode::CAST_NONE,
                    kCombineVectorTileElements);
                AscendC::Add(
                    accumulation, accumulation, contribution,
                    static_cast<std::int32_t>(
                        kCombineVectorTileElements));
                input_queue.FreeTensor(input_local);
            }

            const std::uint64_t logical =
                token * effective_hidden_elements + hidden;
            if (bias_0 != nullptr) {
                input_global.SetGlobalBuffer(
                    const_cast<__gm__ bfloat16_t*>(bias_0) + logical,
                    kCombineVectorTileElements);
                auto input_local =
                    input_queue.AllocTensor<bfloat16_t>();
                AscendC::DataCopy(
                    input_local, input_global,
                    kCombineVectorTileElements);
                input_queue.EnQue(input_local);
                input_local = input_queue.DeQue<bfloat16_t>();
                AscendC::Cast(
                    contribution, input_local,
                    AscendC::RoundMode::CAST_NONE,
                    kCombineVectorTileElements);
                AscendC::Add(
                    accumulation, accumulation, contribution,
                    static_cast<std::int32_t>(
                        kCombineVectorTileElements));
                input_queue.FreeTensor(input_local);
            }
            if (bias_1 != nullptr) {
                input_global.SetGlobalBuffer(
                    const_cast<__gm__ bfloat16_t*>(bias_1) + logical,
                    kCombineVectorTileElements);
                auto input_local =
                    input_queue.AllocTensor<bfloat16_t>();
                AscendC::DataCopy(
                    input_local, input_global,
                    kCombineVectorTileElements);
                input_queue.EnQue(input_local);
                input_local = input_queue.DeQue<bfloat16_t>();
                AscendC::Cast(
                    contribution, input_local,
                    AscendC::RoundMode::CAST_NONE,
                    kCombineVectorTileElements);
                AscendC::Add(
                    accumulation, accumulation, contribution,
                    static_cast<std::int32_t>(
                        kCombineVectorTileElements));
                input_queue.FreeTensor(input_local);
            }

            auto output_local =
                output_queue.AllocTensor<bfloat16_t>();
            AscendC::Cast(
                output_local, accumulation,
                AscendC::RoundMode::CAST_RINT,
                kCombineVectorTileElements);
            output_queue.EnQue(output_local);
            output_local = output_queue.DeQue<bfloat16_t>();
            AscendC::GlobalTensor<bfloat16_t> output_tile;
            output_tile.SetGlobalBuffer(
                combined_x + logical, kCombineVectorTileElements);
            AscendC::DataCopy(
                output_tile, output_local,
                kCombineVectorTileElements);
            output_queue.FreeTensor(output_local);
        }

    }
}

__simt_vf__ __launch_bounds__(512) inline void direct_combine_epilogue_vector_tail_vf(
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ const bfloat16_t* bias_0,
    __gm__ const bfloat16_t* bias_1,
    __gm__ std::uint8_t* workspace,
    __gm__ bfloat16_t* combined_x,
    std::uintptr_t local_window_base,
    int world_size, std::uint64_t num_tokens,
    std::uint64_t num_experts, std::uint64_t num_topk,
    std::uint64_t combine_record_bytes,
    std::uint64_t combine_receive_offset,
    std::uint64_t combine_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t slot_offset,
    std::uint64_t hidden_elements) {
    if (!combine_direct_status_is_clean(
            workspace, workspace_status_offset))
        return;
    const std::uint64_t vector_end =
        hidden_elements - hidden_elements % kCombineVectorTileElements;
    if (vector_end == hidden_elements)
        return;
    auto* slots = reinterpret_cast<__gm__ std::int32_t*>(
        workspace + slot_offset);
    const std::uint64_t local_experts =
        num_experts / static_cast<std::uint64_t>(world_size);
    const auto work = direct_subgroup_grid_stride(
        blockIdx.x, threadIdx.x, gridDim.x, blockDim.x,
        kTopkSubgroupWidth);
    std::int32_t contributor_ranks[kTopkSubgroupWidth];
    std::int32_t receive_slots[kTopkSubgroupWidth];
    for (std::uint64_t token = work.first; token < num_tokens;
         token += work.stride) {
        std::uint32_t contributor_count = 0;
        const std::uint64_t token_base = token * num_topk;
        for (int contributor_rank = 0;
             contributor_rank < world_size; ++contributor_rank) {
            std::int32_t receive_slot = -1;
            for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                const std::int64_t expert =
                    combined_topk_indices[token_base + lane];
                if (expert >= 0 &&
                    static_cast<std::uint64_t>(expert) < num_experts &&
                    static_cast<std::uint64_t>(expert) / local_experts ==
                        static_cast<std::uint64_t>(contributor_rank)) {
                    receive_slot = slots[token_base + lane];
                    break;
                }
            }
            if (receive_slot >= 0) {
                contributor_ranks[contributor_count] = contributor_rank;
                receive_slots[contributor_count] = receive_slot;
                ++contributor_count;
            }
        }
        for (std::uint64_t hidden = vector_end + work.lane;
             hidden < hidden_elements;
             hidden += kTopkSubgroupWidth) {
            float value = 0.0F;
            for (std::uint32_t contributor_index = 0;
                 contributor_index < contributor_count;
                 ++contributor_index) {
                auto* shard = reinterpret_cast<
                    __gm__ const std::uint8_t*>(
                        local_window_base + combine_receive_offset +
                        static_cast<std::uint64_t>(
                            contributor_ranks[contributor_index]) *
                            combine_receive_shard_bytes);
                auto* payload = reinterpret_cast<
                    __gm__ const bfloat16_t*>(
                        shard + static_cast<std::uint64_t>(
                            receive_slots[contributor_index]) *
                            combine_record_bytes);
                value += static_cast<float>(payload[hidden]);
            }
            const std::uint64_t logical =
                token * hidden_elements + hidden;
            if (bias_0 != nullptr)
                value += static_cast<float>(bias_0[logical]);
            if (bias_1 != nullptr)
                value += static_cast<float>(bias_1[logical]);
            combined_x[logical] = static_cast<bfloat16_t>(value);
        }
    }
}

__simt_vf__ __launch_bounds__(512) inline void direct_combine_epilogue_reduce_vf(
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ const bfloat16_t* bias_0,
    __gm__ const bfloat16_t* bias_1,
    __gm__ std::uint8_t* workspace,
    __gm__ bfloat16_t* combined_x,
    std::uintptr_t local_window_base,
    int world_size, std::uint64_t num_tokens,
    std::uint64_t num_experts, std::uint64_t num_topk,
    std::uint64_t combine_record_bytes,
    std::uint64_t combine_receive_offset,
    std::uint64_t combine_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t slot_offset,
    std::uint64_t hidden_elements) {
    if (!combine_direct_status_is_clean(
            workspace, workspace_status_offset))
        return;
    auto* slots = reinterpret_cast<__gm__ std::int32_t*>(
        workspace + slot_offset);
    const std::uint64_t local_experts =
        num_experts / static_cast<std::uint64_t>(world_size);

    if (num_topk > kTopkSubgroupWidth) {
        const auto grid = direct_data_grid_stride(
            blockIdx.x, threadIdx.x, gridDim.x, blockDim.x);
        for (std::uint64_t token = grid.first; token < num_tokens;
             token += grid.stride) {
            const std::uint64_t token_base = token * num_topk;
            for (int contributor_rank = 0;
                 contributor_rank < world_size; ++contributor_rank) {
                std::int32_t owner_lane = -1;
                for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                    const std::int64_t expert =
                        combined_topk_indices[token_base + lane];
                    if (expert >= 0 &&
                        static_cast<std::uint64_t>(expert) < num_experts &&
                        static_cast<std::uint64_t>(expert) / local_experts ==
                            static_cast<std::uint64_t>(contributor_rank)) {
                        owner_lane = static_cast<std::int32_t>(lane);
                        break;
                    }
                }
                const std::int32_t owner_slot = owner_lane < 0 ? -1 :
                    slots[token_base +
                          static_cast<std::uint64_t>(owner_lane)];
                for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                    const std::int64_t expert =
                        combined_topk_indices[token_base + lane];
                    if (expert >= 0 &&
                        static_cast<std::uint64_t>(expert) < num_experts &&
                        static_cast<std::uint64_t>(expert) / local_experts ==
                            static_cast<std::uint64_t>(contributor_rank))
                        slots[token_base + lane] = owner_slot;
                }
            }
            for (std::uint64_t hidden = 0; hidden < hidden_elements;
                 ++hidden) {
                float value = 0.0F;
                for (int contributor_rank = 0;
                     contributor_rank < world_size; ++contributor_rank) {
                    std::int32_t receive_slot = -1;
                    for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                        const std::int64_t expert =
                            combined_topk_indices[token_base + lane];
                        if (expert >= 0 &&
                            static_cast<std::uint64_t>(expert) < num_experts &&
                            static_cast<std::uint64_t>(expert) / local_experts ==
                                static_cast<std::uint64_t>(contributor_rank)) {
                            receive_slot = slots[token_base + lane];
                            break;
                        }
                    }
                    if (receive_slot < 0)
                        continue;
                    auto* shard = reinterpret_cast<
                        __gm__ const std::uint8_t*>(
                            combine_receive_shard_address(
                                local_window_base, combine_receive_offset,
                                static_cast<std::uint64_t>(contributor_rank),
                                combine_receive_shard_bytes));
                    auto* payload = reinterpret_cast<
                        __gm__ const bfloat16_t*>(
                            shard + static_cast<std::uint64_t>(receive_slot) *
                                combine_record_bytes);
                    value += static_cast<float>(payload[hidden]);
                }
                const std::uint64_t logical =
                    token * hidden_elements + hidden;
                if (bias_0 != nullptr)
                    value += static_cast<float>(bias_0[logical]);
                if (bias_1 != nullptr)
                    value += static_cast<float>(bias_1[logical]);
                combined_x[logical] = static_cast<bfloat16_t>(value);
            }
        }
        return;
    }

    const auto work = direct_subgroup_grid_stride(
        blockIdx.x, threadIdx.x, gridDim.x, blockDim.x,
        kTopkSubgroupWidth);
    std::int32_t contributor_ranks[kTopkSubgroupWidth];
    std::int32_t receive_slots[kTopkSubgroupWidth];
    for (std::uint64_t token = work.first; token < num_tokens;
         token += work.stride) {
        const bool logical = work.lane < num_topk;
        const std::uint64_t logical_index = token * num_topk + work.lane;
        const std::int64_t expert = logical ?
            combined_topk_indices[logical_index] : -1;
        const bool active = logical && expert >= 0 &&
            static_cast<std::uint64_t>(expert) < num_experts;
        const std::int32_t contributor_key = active ?
            static_cast<std::int32_t>(
                static_cast<std::uint64_t>(expert) / local_experts) : -1;
        const auto group = group_topk_subgroup(contributor_key, active);
        const std::int32_t observed_slot = active ?
            slots[logical_index] : -1;
        const std::int32_t resolved_slot = topk_broadcast_owner_value(
            group, observed_slot, -1);
        const TopkSubgroupMask entry_owner_mask =
            static_cast<TopkSubgroupMask>(asc_ballot(
                group.is_owner && resolved_slot >= 0 ? 1 : 0));
        const std::uint32_t contributor_count =
            static_cast<std::uint32_t>(__popc(entry_owner_mask));
        if (logical)
            slots[logical_index] = resolved_slot;

        const std::uint32_t owner_ordinal = topk_compact_owner_ordinal(
            entry_owner_mask, contributor_key);
        TopkSubgroupMask remaining_owners = entry_owner_mask;
        while (remaining_owners != 0) {
            const std::int32_t owner_lane =
                topk_first_set_lane(remaining_owners);
            const std::uint32_t broadcast_ordinal = asc_shfl(
                owner_ordinal, static_cast<std::uint32_t>(owner_lane),
                kTopkSubgroupWidth);
            const std::int32_t broadcast_rank = asc_shfl(
                contributor_key, static_cast<std::uint32_t>(owner_lane),
                kTopkSubgroupWidth);
            const std::int32_t broadcast_slot = asc_shfl(
                resolved_slot, static_cast<std::uint32_t>(owner_lane),
                kTopkSubgroupWidth);
            contributor_ranks[broadcast_ordinal] = broadcast_rank;
            receive_slots[broadcast_ordinal] = broadcast_slot;
            remaining_owners &= ~(
                TopkSubgroupMask{1} <<
                static_cast<std::uint32_t>(owner_lane));
        }
        for (std::uint64_t hidden = work.lane;
             hidden < hidden_elements;
             hidden += kTopkSubgroupWidth) {
            float value = 0.0F;
            for (std::uint32_t contributor_index = 0;
                 contributor_index < contributor_count;
                 ++contributor_index) {
                auto* shard = reinterpret_cast<
                    __gm__ const std::uint8_t*>(
                        combine_receive_shard_address(
                            local_window_base, combine_receive_offset,
                            static_cast<std::uint64_t>(
                                contributor_ranks[contributor_index]),
                            combine_receive_shard_bytes));
                auto* payload = reinterpret_cast<
                    __gm__ const bfloat16_t*>(
                        shard + static_cast<std::uint64_t>(
                            receive_slots[contributor_index]) *
                            combine_record_bytes);
                value += static_cast<float>(payload[hidden]);
            }
            const std::uint64_t logical =
                token * hidden_elements + hidden;
            if (bias_0 != nullptr)
                value += static_cast<float>(bias_0[logical]);
            if (bias_1 != nullptr)
                value += static_cast<float>(bias_1[logical]);
            combined_x[logical] = static_cast<bfloat16_t>(value);
        }
    }
}

__simt_vf__ __launch_bounds__(512) inline void direct_combine_epilogue_weights_vf(
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ std::uint8_t* workspace,
    __gm__ float* combined_topk_weights,
    std::uintptr_t local_window_base,
    int world_size, std::uint64_t num_tokens,
    std::uint64_t num_experts, std::uint64_t num_topk,
    std::uint64_t combine_record_bytes,
    std::uint64_t combine_weight_offset,
    std::uint64_t combine_receive_offset,
    std::uint64_t combine_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_slot_offset) {
    if (combined_topk_weights == nullptr ||
        !combine_direct_status_is_clean(
            workspace, workspace_status_offset))
        return;
    const auto* slots = reinterpret_cast<__gm__ const std::int32_t*>(
        workspace + workspace_slot_offset);
    const std::uint64_t local_experts =
        num_experts / static_cast<std::uint64_t>(world_size);
    const std::uint64_t output_count = num_tokens * num_topk;
    const auto grid = direct_data_grid_stride(
        blockIdx.x, threadIdx.x, gridDim.x, blockDim.x);
    for (std::uint64_t logical = grid.first; logical < output_count;
         logical += grid.stride) {
        const std::uint64_t lane = logical % num_topk;
        const std::int64_t expert = combined_topk_indices[logical];
        const std::int32_t slot = slots[logical];
        float value = 0.0F;
        if (slot >= 0 && expert >= 0 &&
            static_cast<std::uint64_t>(expert) < num_experts) {
            const std::uint64_t contributor =
                static_cast<std::uint64_t>(expert) / local_experts;
            auto* record = reinterpret_cast<__gm__ const std::uint8_t*>(
                combine_receive_shard_address(
                    local_window_base, combine_receive_offset,
                    contributor, combine_receive_shard_bytes)) +
                static_cast<std::uint64_t>(slot) * combine_record_bytes;
            const auto* weights = reinterpret_cast<__gm__ const float*>(
                record + combine_weight_offset);
            value = weights[lane];
        }
        combined_topk_weights[logical] = value;
    }
}

__simt_vf__ __launch_bounds__(512) inline void direct_combine_epilogue_complete_vf(
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t control_offset,
    std::uint64_t workspace_status_offset) {
    if (threadIdx.x != 0)
        return;
    const auto context = make_hybrid_combine_context(
        transport_abi_version, transport_struct_size, transport_capabilities,
        transport_local_window_base, transport_channel_table,
        transport_peer_address_table, transport_topology_abi_version,
        transport_topology_struct_size, transport_world_rank,
        transport_world_size, transport_scale_up_rank,
        transport_scale_up_size, transport_scale_out_rank,
        transport_scale_out_size, transport_scale_up_direct,
        transport_topology_kind, transport_topology_epoch,
        transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    auto* control = reinterpret_cast<__gm__ SymmetricControlHeader*>(
        transport_local_window_base + control_offset);
    transport.store_release(
        reinterpret_cast<transport::DeviceAddress>(
            &control->combine_generation), generation);
}

__global__ __vector__ void combine_kernel(
    __gm__ const std::uint16_t* x,
    __gm__ const float* topk_weights,
    __gm__ const std::int32_t* source_metadata,
    __gm__ const HybridRouteRecord* route_records,
    std::uint64_t route_record_count,
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ const std::int32_t* prefix_per_rank,
    __gm__ std::uint8_t* workspace,
    __gm__ std::uint16_t* combined_x,
    __gm__ float* combined_topk_weights,
    __gm__ const std::uint16_t* bias_0,
    __gm__ const std::uint16_t* bias_1,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t num_source_rows, std::uint64_t num_input_rows,
    std::uintptr_t local_window_base, DirectCombineStage stage,
    CoreTiling tiling) {
    const bool hybrid =
        (tiling.mode_flags &
         (CoreModeFlags{1} <<
          static_cast<std::uint8_t>(CoreMode::kHybrid))) != 0;
    const bool expanded =
        (tiling.mode_flags &
         (CoreModeFlags{1} <<
          static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    const bool allow_multiple_reduction =
        (tiling.mode_flags &
         (CoreModeFlags{1} << static_cast<std::uint8_t>(
             CoreMode::kAllowMultipleReduction))) != 0;
    const bool direct_parallel =
        !hybrid && (!expanded || allow_multiple_reduction);
    if (stage == DirectCombineStage::kFull ||
        stage == DirectCombineStage::kProducerControl)
        transport::service::reset(tiling.transport_context, generation);
    if (direct_parallel) {
        if (stage == DirectCombineStage::kFull ||
            stage == DirectCombineStage::kProducerControl) {
        asc_vf_call<direct_combine_producer_control_vf>(
            dim3(tiling.launch.num_threads), workspace,
            tiling.transport_context.abi_version,
            tiling.transport_context.struct_size,
            tiling.transport_context.capabilities, local_window_base,
            tiling.transport_context.channel_table,
            tiling.transport_context.peer_address_table,
            tiling.transport_context.topology.abi_version,
            tiling.transport_context.topology.struct_size,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.transport_context.topology.scale_up_rank,
            tiling.transport_context.topology.scale_up_size,
            tiling.transport_context.topology.scale_out_rank,
            tiling.transport_context.topology.scale_out_size,
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.scale_up_direct),
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.kind),
            tiling.transport_context.topology.epoch,
            tiling.transport_context.backend_context, tiling.mode_flags,
            generation, timeout_cycles, num_source_rows, num_input_rows,
            tiling.num_topk, tiling.num_max_tokens_per_rank,
            tiling.dispatch_output_capacity,
            tiling.symmetric_window_layout.combine_record_bytes,
            tiling.symmetric_window_layout.combine_weight_offset,
            tiling.symmetric_window_layout.combine_control_bytes,
            tiling.symmetric_window_layout.combine_receive_shard_bytes,
            tiling.symmetric_window_layout.combine_receive_shard_count,
            tiling.symmetric_window_layout.combine_receive_bytes,
            tiling.symmetric_window_layout.combine_staging_shard_bytes,
            tiling.symmetric_window_layout.combine_staging_shard_count,
            tiling.symmetric_window_layout.combine_staging_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.scratch_rank_flags_offset,
            tiling.workspace_layout.scratch_rank_count, tiling.hidden);
        asc_vf_call<direct_combine_producer_plan_vf>(
            dim3(tiling.launch.num_threads), source_metadata, prefix_per_rank,
            workspace, tiling.mode_flags,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            num_source_rows, num_input_rows, tiling.num_tokens,
            tiling.num_topk, tiling.num_max_tokens_per_rank,
            tiling.symmetric_window_layout.combine_record_bytes,
            tiling.symmetric_window_layout.combine_receive_shard_bytes,
            tiling.symmetric_window_layout.combine_staging_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.scratch_rank_counts_offset,
            tiling.workspace_layout.scratch_rank_values_offset,
            tiling.workspace_layout.scratch_rank_flags_offset,
            tiling.workspace_layout.combine_record_slots_offset);
        asc_vf_call<direct_combine_producer_reduce_errors_vf>(
            dim3(tiling.launch.num_threads), workspace,
            tiling.transport_context.abi_version,
            tiling.transport_context.struct_size,
            tiling.transport_context.capabilities, local_window_base,
            tiling.transport_context.channel_table,
            tiling.transport_context.peer_address_table,
            tiling.transport_context.topology.abi_version,
            tiling.transport_context.topology.struct_size,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.transport_context.topology.scale_up_rank,
            tiling.transport_context.topology.scale_up_size,
            tiling.transport_context.topology.scale_out_rank,
            tiling.transport_context.topology.scale_out_size,
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.scale_up_direct),
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.kind),
            tiling.transport_context.topology.epoch,
            tiling.transport_context.backend_context,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.scratch_rank_flags_offset,
            tiling.workspace_layout.scratch_rank_count);
        }
        if (stage == DirectCombineStage::kFull ||
            stage == DirectCombineStage::kProducerRecord) {
        asc_vf_call<direct_combine_producer_record_vf>(
            dim3(tiling.launch.num_threads),
            reinterpret_cast<__gm__ const bfloat16_t*>(x), topk_weights,
            source_metadata, workspace, local_window_base, tiling.mode_flags,
            num_source_rows, num_input_rows, tiling.num_topk,
            tiling.num_max_tokens_per_rank,
            tiling.symmetric_window_layout.combine_record_bytes,
            tiling.symmetric_window_layout.combine_weight_offset,
            tiling.symmetric_window_layout.combine_staging_offset,
            tiling.symmetric_window_layout.combine_staging_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.scratch_rank_values_offset,
            tiling.workspace_layout.combine_record_slots_offset,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size, tiling.hidden);
        }
        if (stage == DirectCombineStage::kFull ||
            stage == DirectCombineStage::kProducerRelease) {
        asc_vf_call<direct_combine_producer_local_copy_vf>(
            dim3(tiling.launch.num_threads), workspace, local_window_base,
            tiling.symmetric_window_layout.combine_record_bytes,
            tiling.symmetric_window_layout.combine_receive_offset,
            tiling.symmetric_window_layout.combine_receive_shard_bytes,
            tiling.symmetric_window_layout.combine_staging_offset,
            tiling.symmetric_window_layout.combine_staging_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.scratch_rank_counts_offset,
            tiling.transport_context.topology.world_rank);
        asc_vf_call<direct_combine_producer_release_vf>(
            dim3(tiling.launch.num_threads), workspace,
            tiling.transport_context.abi_version,
            tiling.transport_context.struct_size,
            tiling.transport_context.capabilities, local_window_base,
            tiling.transport_context.channel_table,
            tiling.transport_context.peer_address_table,
            tiling.transport_context.topology.abi_version,
            tiling.transport_context.topology.struct_size,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.transport_context.topology.scale_up_rank,
            tiling.transport_context.topology.scale_up_size,
            tiling.transport_context.topology.scale_out_rank,
            tiling.transport_context.topology.scale_out_size,
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.scale_up_direct),
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.kind),
            tiling.transport_context.topology.epoch,
            tiling.transport_context.backend_context, generation,
            timeout_cycles,
            tiling.symmetric_window_layout.combine_record_bytes,
            tiling.symmetric_window_layout.combine_control_offset,
            tiling.symmetric_window_layout.combine_receive_offset,
            tiling.symmetric_window_layout.combine_receive_shard_bytes,
            tiling.symmetric_window_layout.combine_staging_offset,
            tiling.symmetric_window_layout.combine_staging_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.scratch_rank_counts_offset);
        }
    } else {
        asc_vf_call<combine_producer_vf>(
        dim3(tiling.launch.num_threads),
        reinterpret_cast<__gm__ const bfloat16_t*>(x), topk_weights,
        source_metadata, route_records, route_record_count,
        prefix_per_rank, workspace,
        tiling.transport_context.abi_version,
        tiling.transport_context.struct_size,
        tiling.transport_context.capabilities,
        local_window_base,
        tiling.transport_context.channel_table,
        tiling.transport_context.peer_address_table,
        tiling.transport_context.topology.abi_version,
        tiling.transport_context.topology.struct_size,
        tiling.transport_context.topology.world_rank,
        tiling.transport_context.topology.world_size,
        tiling.transport_context.topology.scale_up_rank,
        tiling.transport_context.topology.scale_up_size,
        tiling.transport_context.topology.scale_out_rank,
        tiling.transport_context.topology.scale_out_size,
        static_cast<std::uint32_t>(
            tiling.transport_context.topology.scale_up_direct),
        static_cast<std::uint32_t>(tiling.transport_context.topology.kind),
        tiling.transport_context.topology.epoch,
        tiling.transport_context.backend_context,
        tiling.mode_flags, generation, timeout_cycles,
        num_source_rows, num_input_rows, tiling.num_tokens, tiling.num_topk,
        tiling.num_max_tokens_per_rank,
        tiling.dispatch_output_capacity,
        tiling.symmetric_window_layout.combine_record_bytes,
        tiling.symmetric_window_layout.combine_weight_offset,
        tiling.symmetric_window_layout.combine_control_offset,
        tiling.symmetric_window_layout.combine_control_bytes,
        tiling.symmetric_window_layout.combine_receive_offset,
        tiling.symmetric_window_layout.combine_receive_shard_bytes,
        tiling.symmetric_window_layout.combine_receive_shard_count,
        tiling.symmetric_window_layout.combine_receive_bytes,
        tiling.symmetric_window_layout.combine_staging_offset,
        tiling.symmetric_window_layout.combine_staging_shard_bytes,
        tiling.symmetric_window_layout.combine_staging_shard_count,
        tiling.symmetric_window_layout.combine_staging_bytes,
        tiling.symmetric_window_layout
            .hybrid_combine_reverse_forward_control_offset,
        tiling.symmetric_window_layout
            .hybrid_combine_reverse_forward_control_bytes,
        tiling.symmetric_window_layout
            .hybrid_combine_reverse_forward_shard_offset,
        tiling.symmetric_window_layout
            .hybrid_combine_reverse_forward_shard_bytes,
        tiling.symmetric_window_layout
            .hybrid_combine_reverse_forward_shard_count,
        tiling.symmetric_window_layout
            .hybrid_combine_reverse_forward_bytes,
        tiling.workspace_layout.scratch_status_offset,
        tiling.workspace_layout.scratch_rank_counts_offset,
        tiling.workspace_layout.scratch_rank_values_offset,
            tiling.workspace_layout.scratch_rank_count, tiling.hidden);
    }
    if (!direct_parallel || stage == DirectCombineStage::kFull ||
        stage == DirectCombineStage::kProducerRelease)
        transport::service::execute(tiling.transport_context);
    if (hybrid) {
        transport::service::reset(tiling.transport_context, generation);
        const std::uint64_t hybrid_record_capacity =
            expanded && !allow_multiple_reduction ?
                tiling.num_max_tokens_per_rank * tiling.num_topk :
                tiling.num_max_tokens_per_rank;
        asc_vf_call<hybrid_combine_return_vf>(
            dim3(tiling.launch.num_threads), workspace,
            tiling.transport_context.abi_version,
            tiling.transport_context.struct_size,
            tiling.transport_context.capabilities,
            local_window_base,
            tiling.transport_context.channel_table,
            tiling.transport_context.peer_address_table,
            tiling.transport_context.topology.abi_version,
            tiling.transport_context.topology.struct_size,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.transport_context.topology.scale_up_rank,
            tiling.transport_context.topology.scale_up_size,
            tiling.transport_context.topology.scale_out_rank,
            tiling.transport_context.topology.scale_out_size,
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.scale_up_direct),
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.kind),
            tiling.transport_context.topology.epoch,
            tiling.transport_context.backend_context,
            generation, timeout_cycles, tiling.num_max_tokens_per_rank,
            hybrid_record_capacity,
            tiling.symmetric_window_layout.combine_record_bytes,
            tiling.symmetric_window_layout
                .hybrid_combine_reverse_forward_control_offset,
            tiling.symmetric_window_layout
                .hybrid_combine_reverse_forward_shard_offset,
            tiling.symmetric_window_layout
                .hybrid_combine_reverse_forward_shard_bytes,
            tiling.symmetric_window_layout
                .hybrid_combine_return_control_offset,
            tiling.symmetric_window_layout
                .hybrid_combine_return_shard_offset,
            tiling.symmetric_window_layout
                .hybrid_combine_return_shard_bytes,
            tiling.workspace_layout.scratch_status_offset);
        transport::service::execute(tiling.transport_context);
        asc_vf_call<hybrid_combine_prepare_epilogue_vf>(
            dim3(tiling.launch.num_threads), workspace,
            tiling.transport_context.abi_version,
            tiling.transport_context.struct_size,
            tiling.transport_context.capabilities,
            local_window_base,
            tiling.transport_context.channel_table,
            tiling.transport_context.peer_address_table,
            tiling.transport_context.topology.abi_version,
            tiling.transport_context.topology.struct_size,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.transport_context.topology.scale_up_rank,
            tiling.transport_context.topology.scale_up_size,
            tiling.transport_context.topology.scale_out_rank,
            tiling.transport_context.topology.scale_out_size,
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.scale_up_direct),
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.kind),
            tiling.transport_context.topology.epoch,
            tiling.transport_context.backend_context,
            generation, timeout_cycles, hybrid_record_capacity,
            tiling.symmetric_window_layout.combine_record_bytes,
            tiling.symmetric_window_layout.combine_control_offset,
            tiling.symmetric_window_layout.combine_receive_offset,
            tiling.symmetric_window_layout.combine_receive_shard_bytes,
            tiling.symmetric_window_layout
                .hybrid_combine_return_control_offset,
            tiling.symmetric_window_layout
                .hybrid_combine_return_shard_offset,
            tiling.symmetric_window_layout
                .hybrid_combine_return_shard_bytes,
            tiling.workspace_layout.scratch_status_offset);
    }
    if (direct_parallel) {
        if (stage == DirectCombineStage::kFull ||
            stage == DirectCombineStage::kEpiloguePrepare) {
        asc_vf_call<direct_combine_epilogue_acquire_vf>(
            dim3(tiling.launch.num_threads), workspace,
            tiling.transport_context.abi_version,
            tiling.transport_context.struct_size,
            tiling.transport_context.capabilities, local_window_base,
            tiling.transport_context.channel_table,
            tiling.transport_context.peer_address_table,
            tiling.transport_context.topology.abi_version,
            tiling.transport_context.topology.struct_size,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.transport_context.topology.scale_up_rank,
            tiling.transport_context.topology.scale_up_size,
            tiling.transport_context.topology.scale_out_rank,
            tiling.transport_context.topology.scale_out_size,
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.scale_up_direct),
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.kind),
            tiling.transport_context.topology.epoch,
            tiling.transport_context.backend_context, generation,
            timeout_cycles, tiling.num_tokens,
            tiling.num_max_tokens_per_rank,
            tiling.symmetric_window_layout.combine_record_bytes,
            tiling.symmetric_window_layout.combine_control_offset,
            tiling.symmetric_window_layout.combine_control_bytes,
            tiling.symmetric_window_layout.combine_receive_shard_bytes,
            tiling.symmetric_window_layout.combine_receive_shard_count,
            tiling.symmetric_window_layout.combine_receive_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.scratch_rank_counts_offset,
            tiling.workspace_layout.scratch_rank_count);
        asc_vf_call<direct_combine_epilogue_clear_index_vf>(
            dim3(tiling.launch.num_threads), workspace,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.slot_offset,
            tiling.workspace_layout.scratch_rank_values_offset,
            tiling.workspace_layout.scratch_rank_count,
            tiling.num_tokens, tiling.num_topk);
        asc_vf_call<direct_combine_epilogue_validate_vf>(
            dim3(tiling.launch.num_threads), combined_topk_indices, workspace,
            local_window_base, tiling.mode_flags,
            tiling.transport_context.topology.world_size,
            tiling.num_tokens, tiling.num_experts, tiling.num_topk,
            tiling.num_max_tokens_per_rank,
            tiling.symmetric_window_layout.combine_record_bytes,
            tiling.symmetric_window_layout.combine_weight_offset,
            tiling.symmetric_window_layout.combine_receive_offset,
            tiling.symmetric_window_layout.combine_receive_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.scratch_rank_counts_offset,
            tiling.workspace_layout.scratch_rank_values_offset,
            tiling.workspace_layout.slot_offset, tiling.hidden);
        asc_vf_call<direct_combine_epilogue_reduce_errors_vf>(
            dim3(tiling.launch.num_threads), workspace,
            tiling.transport_context.abi_version,
            tiling.transport_context.struct_size,
            tiling.transport_context.capabilities, local_window_base,
            tiling.transport_context.channel_table,
            tiling.transport_context.peer_address_table,
            tiling.transport_context.topology.abi_version,
            tiling.transport_context.topology.struct_size,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.transport_context.topology.scale_up_rank,
            tiling.transport_context.topology.scale_up_size,
            tiling.transport_context.topology.scale_out_rank,
            tiling.transport_context.topology.scale_out_size,
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.scale_up_direct),
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.kind),
            tiling.transport_context.topology.epoch,
            tiling.transport_context.backend_context,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.scratch_rank_values_offset,
            tiling.workspace_layout.scratch_rank_count);
        if (stage == DirectCombineStage::kEpiloguePrepare &&
            tiling.num_topk <= kTopkSubgroupWidth &&
            tiling.hidden % kCombineDataCopyAlignmentElements == 0) {
            asc_vf_call<direct_combine_epilogue_prepare_vector_slots_vf>(
                dim3(tiling.launch.num_threads), combined_topk_indices,
                workspace,
                tiling.transport_context.topology.world_size,
                tiling.num_tokens, tiling.num_experts, tiling.num_topk,
                tiling.workspace_layout.scratch_status_offset,
                tiling.workspace_layout.slot_offset);
        }
        }
        if (stage == DirectCombineStage::kFull ||
            stage == DirectCombineStage::kEpilogueReduce) {
        if (stage == DirectCombineStage::kEpilogueReduce &&
            tiling.num_topk <= kTopkSubgroupWidth &&
            tiling.hidden % kCombineDataCopyAlignmentElements == 0) {
            if (tiling.num_topk == kCombineCommonTopk &&
                tiling.hidden == kCombineCommonHidden) {
                direct_combine_epilogue_vector_reduce_impl<
                    kCombineCommonTopk,
                    kCombineCommonHidden>(
                        combined_topk_indices,
                        reinterpret_cast<__gm__ const bfloat16_t*>(bias_0),
                        reinterpret_cast<__gm__ const bfloat16_t*>(bias_1),
                        workspace,
                        reinterpret_cast<__gm__ bfloat16_t*>(combined_x),
                        local_window_base,
                        tiling.transport_context.topology.world_size,
                        tiling.num_tokens, tiling.num_experts,
                        tiling.num_topk,
                        tiling.symmetric_window_layout.combine_record_bytes,
                        tiling.symmetric_window_layout.combine_receive_offset,
                        tiling.symmetric_window_layout
                            .combine_receive_shard_bytes,
                        tiling.workspace_layout.scratch_status_offset,
                        tiling.workspace_layout.slot_offset,
                        tiling.hidden);
            } else {
                direct_combine_epilogue_vector_reduce_impl<0, 0>(
                    combined_topk_indices,
                    reinterpret_cast<__gm__ const bfloat16_t*>(bias_0),
                    reinterpret_cast<__gm__ const bfloat16_t*>(bias_1),
                    workspace,
                    reinterpret_cast<__gm__ bfloat16_t*>(combined_x),
                    local_window_base,
                    tiling.transport_context.topology.world_size,
                    tiling.num_tokens, tiling.num_experts, tiling.num_topk,
                    tiling.symmetric_window_layout.combine_record_bytes,
                    tiling.symmetric_window_layout.combine_receive_offset,
                    tiling.symmetric_window_layout
                        .combine_receive_shard_bytes,
                    tiling.workspace_layout.scratch_status_offset,
                    tiling.workspace_layout.slot_offset,
                    tiling.hidden);
            }
        } else {
            asc_vf_call<direct_combine_epilogue_reduce_vf>(
                dim3(tiling.launch.num_threads),
                combined_topk_indices,
                reinterpret_cast<__gm__ const bfloat16_t*>(bias_0),
                reinterpret_cast<__gm__ const bfloat16_t*>(bias_1),
                workspace,
                reinterpret_cast<__gm__ bfloat16_t*>(combined_x),
                local_window_base,
                tiling.transport_context.topology.world_size,
                tiling.num_tokens, tiling.num_experts, tiling.num_topk,
                tiling.symmetric_window_layout.combine_record_bytes,
                tiling.symmetric_window_layout.combine_receive_offset,
                tiling.symmetric_window_layout.combine_receive_shard_bytes,
                tiling.workspace_layout.scratch_status_offset,
                tiling.workspace_layout.slot_offset,
                tiling.hidden);
        }
        }
        if (stage == DirectCombineStage::kFull ||
            stage == DirectCombineStage::kEpilogueWeights) {
        if (stage == DirectCombineStage::kEpilogueWeights &&
            tiling.num_topk <= kTopkSubgroupWidth &&
            tiling.hidden % kCombineDataCopyAlignmentElements == 0 &&
            tiling.hidden % kCombineVectorTileElements != 0) {
            asc_vf_call<direct_combine_epilogue_vector_tail_vf>(
                dim3(tiling.launch.num_threads),
                combined_topk_indices,
                reinterpret_cast<__gm__ const bfloat16_t*>(bias_0),
                reinterpret_cast<__gm__ const bfloat16_t*>(bias_1),
                workspace,
                reinterpret_cast<__gm__ bfloat16_t*>(combined_x),
                local_window_base,
                tiling.transport_context.topology.world_size,
                tiling.num_tokens, tiling.num_experts, tiling.num_topk,
                tiling.symmetric_window_layout.combine_record_bytes,
                tiling.symmetric_window_layout.combine_receive_offset,
                tiling.symmetric_window_layout.combine_receive_shard_bytes,
                tiling.workspace_layout.scratch_status_offset,
                tiling.workspace_layout.slot_offset,
                tiling.hidden);
        }
        asc_vf_call<direct_combine_epilogue_weights_vf>(
            dim3(tiling.launch.num_threads), combined_topk_indices, workspace,
            combined_topk_weights, local_window_base,
            tiling.transport_context.topology.world_size,
            tiling.num_tokens, tiling.num_experts, tiling.num_topk,
            tiling.symmetric_window_layout.combine_record_bytes,
            tiling.symmetric_window_layout.combine_weight_offset,
            tiling.symmetric_window_layout.combine_receive_offset,
            tiling.symmetric_window_layout.combine_receive_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.slot_offset);
        }
        if (stage == DirectCombineStage::kFull ||
            stage == DirectCombineStage::kEpilogueComplete) {
        asc_vf_call<direct_combine_epilogue_complete_vf>(
            dim3(tiling.launch.num_threads), workspace,
            tiling.transport_context.abi_version,
            tiling.transport_context.struct_size,
            tiling.transport_context.capabilities, local_window_base,
            tiling.transport_context.channel_table,
            tiling.transport_context.peer_address_table,
            tiling.transport_context.topology.abi_version,
            tiling.transport_context.topology.struct_size,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.transport_context.topology.scale_up_rank,
            tiling.transport_context.topology.scale_up_size,
            tiling.transport_context.topology.scale_out_rank,
            tiling.transport_context.topology.scale_out_size,
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.scale_up_direct),
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.kind),
            tiling.transport_context.topology.epoch,
            tiling.transport_context.backend_context, generation,
            tiling.symmetric_window_layout.control_offset,
            tiling.workspace_layout.scratch_status_offset);
        }
    } else {
        asc_vf_call<combine_epilogue_vf>(
        dim3(tiling.launch.num_threads), combined_topk_indices, topk_weights,
        reinterpret_cast<__gm__ const bfloat16_t*>(bias_0),
        reinterpret_cast<__gm__ const bfloat16_t*>(bias_1), workspace,
        reinterpret_cast<__gm__ bfloat16_t*>(combined_x),
        combined_topk_weights,
        tiling.transport_context.abi_version,
        tiling.transport_context.struct_size,
        tiling.transport_context.capabilities,
        local_window_base,
        tiling.transport_context.channel_table,
        tiling.transport_context.peer_address_table,
        tiling.transport_context.topology.abi_version,
        tiling.transport_context.topology.struct_size,
        tiling.transport_context.topology.world_rank,
        tiling.transport_context.topology.world_size,
        tiling.transport_context.topology.scale_up_rank,
        tiling.transport_context.topology.scale_up_size,
        tiling.transport_context.topology.scale_out_rank,
        tiling.transport_context.topology.scale_out_size,
        static_cast<std::uint32_t>(
            tiling.transport_context.topology.scale_up_direct),
        static_cast<std::uint32_t>(tiling.transport_context.topology.kind),
        tiling.transport_context.topology.epoch,
        tiling.transport_context.backend_context,
        tiling.mode_flags, generation, timeout_cycles,
        tiling.num_tokens, tiling.num_experts,
        tiling.num_topk, tiling.num_max_tokens_per_rank,
        tiling.symmetric_window_layout.combine_record_bytes,
        tiling.symmetric_window_layout.combine_weight_offset,
        tiling.symmetric_window_layout.control_offset,
        tiling.symmetric_window_layout.combine_control_offset,
        tiling.symmetric_window_layout.combine_control_bytes,
        tiling.symmetric_window_layout.combine_receive_offset,
        tiling.symmetric_window_layout.combine_receive_shard_bytes,
        tiling.symmetric_window_layout.combine_receive_shard_count,
        tiling.symmetric_window_layout.combine_receive_bytes,
        tiling.workspace_layout.scratch_status_offset,
        tiling.workspace_layout.scratch_rank_counts_offset,
            tiling.workspace_layout.scratch_rank_count, tiling.hidden);
    }
}

inline int launch_direct_combine_stage(
    CombineArguments arguments, CoreTiling tiling, void* stream,
    DirectCombineStage stage) {
    const auto launch = direct_combine_stage_launch(tiling, stage);
    combine_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        static_cast<const std::uint16_t*>(arguments.x),
        arguments.topk_weights, arguments.source_metadata,
        arguments.route_records, arguments.route_record_count,
        arguments.combined_topk_indices, arguments.prefix_per_rank,
        static_cast<std::uint8_t*>(arguments.workspace),
        static_cast<std::uint16_t*>(arguments.combined_x),
        arguments.combined_topk_weights,
        static_cast<const std::uint16_t*>(arguments.bias_0),
        static_cast<const std::uint16_t*>(arguments.bias_1),
        arguments.generation, arguments.timeout_cycles,
        arguments.num_source_rows, arguments.num_input_rows,
        arguments.local_window_base, stage, tiling);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic

extern "C" int deep_ep_ascend_launch_combine(
    deep_ep::ascend::elastic::CombineArguments arguments,
    deep_ep::ascend::elastic::CoreTiling tiling, void* stream) {
    using namespace deep_ep::ascend::elastic;
    const bool hybrid = has_mode(tiling.mode_flags, CoreMode::kHybrid);
    const bool expanded = has_mode(tiling.mode_flags, CoreMode::kExpanded);
    const bool allow_multiple_reduction = has_mode(
        tiling.mode_flags, CoreMode::kAllowMultipleReduction);
    if (hybrid || tiling.data_launch.num_blocks == 1 ||
        (expanded && !allow_multiple_reduction))
        return launch_direct_combine_stage(
            arguments, tiling, stream, DirectCombineStage::kFull);

    const auto pipeline = direct_combine_pipeline();
    for (std::uint32_t index = 0; index < pipeline.count; ++index) {
        const auto status = launch_direct_combine_stage(
            arguments, tiling, stream, pipeline.stages[index]);
        if (status != 0)
            return status;
    }
    return 0;
}

extern "C" int deep_ep_ascend_launch_combine_epilogue(
    deep_ep::ascend::elastic::CombineArguments,
    deep_ep::ascend::elastic::CoreTiling, void*) {
    return 0;
}
