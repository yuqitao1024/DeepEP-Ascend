#include <cstdint>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "simt_api/asc_bf16.h"

#include "kernels.hpp"

#define DEEP_EP_ASCEND_SIMT_DEVICE 1
#include "../transport/device_transport_facade.hpp"

namespace deep_ep::ascend::elastic {

__simt_vf__ inline void combine_vf(
    __gm__ const bfloat16_t* x,
    __gm__ const float* topk_weights,
    __gm__ const std::int32_t* source_metadata,
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ const std::int32_t* prefix_per_rank,
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    transport::DeviceTransportContext context, CoreModeFlags mode_flags,
    int world_size, std::uint64_t num_tokens, std::uint64_t hidden_elements,
    std::uint64_t num_topk, std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_topk_weight_offset) {
    if (threadIdx.x == 0) {
        const bool expanded = (mode_flags &
            (CoreModeFlags{1} <<
             static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
        const std::int32_t num_receive_tokens = prefix_per_rank[0];
        const std::uint64_t metadata_stride = 2 + num_topk;
        for (std::uint64_t token = 0; token < num_tokens; ++token) {
            __gm__ std::uint8_t* record = communication_buffer +
                token * token_stride_bytes;
            auto record_hidden = reinterpret_cast<__gm__ bfloat16_t*>(
                record + token_hidden_offset);
            auto record_weights = reinterpret_cast<__gm__ float*>(
                record + token_topk_weight_offset);
            std::int32_t source_row = -1;
            for (std::int32_t row = 0; row < num_receive_tokens; ++row) {
                if (source_metadata[
                        static_cast<std::uint64_t>(row) * metadata_stride] ==
                    static_cast<std::int32_t>(token)) {
                    source_row = row;
                    break;
                }
            }
            for (std::uint64_t hidden = 0;
                 hidden < hidden_elements; ++hidden) {
                float value = 0.0F;
                if (source_row >= 0 && !expanded) {
                    value = static_cast<float>(
                        x[static_cast<std::uint64_t>(source_row) *
                              hidden_elements + hidden]);
                } else if (source_row >= 0) {
                    for (std::uint64_t lane = 0;
                         lane < num_topk; ++lane) {
                        const std::int32_t source_slot = source_metadata[
                            static_cast<std::uint64_t>(source_row) *
                                metadata_stride + 2 + lane];
                        if (source_slot >= 0)
                            value += static_cast<float>(
                                x[static_cast<std::uint64_t>(source_slot) *
                                      hidden_elements + hidden]);
                    }
                }
                record_hidden[hidden] = static_cast<bfloat16_t>(value);
            }
            for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                float value = 0.0F;
                const std::int64_t expert = combined_topk_indices[
                    token * num_topk + lane];
                if (source_row >= 0 && expert >= 0 && topk_weights != nullptr) {
                    if (expanded) {
                        const std::int32_t source_slot = source_metadata[
                            static_cast<std::uint64_t>(source_row) *
                                metadata_stride + 2 + lane];
                        if (source_slot >= 0)
                            value = topk_weights[source_slot];
                    } else {
                        value = topk_weights[
                            static_cast<std::uint64_t>(source_row) *
                                num_topk + lane];
                    }
                }
                record_weights[lane] = value;
            }
        }
    }
    asc_syncthreads();

    if (world_size > 1 && threadIdx.x == 0) {
        transport::DeviceTransportFacade transport(context, 0);
        const auto address =
            reinterpret_cast<transport::DeviceAddress>(workspace);
        transport.put(
            transport::TransportTeam::kWorld, 0, address, address,
            sizeof(std::uint64_t), transport::CooperationScope::kParticipant,
            transport::MemorySegment::kDevice, transport::kDefaultOptions,
            transport::RemoteAction::none());
        transport.remote_add_release(
            transport::TransportTeam::kScaleUp, 0, address, 1);
        transport.flush(transport::CooperationScope::kWorkgroup);
        transport.device_barrier(1, address, 0);
    }
}

__simt_vf__ inline void combine_epilogue_vf(
    __gm__ const std::uint8_t* communication_buffer,
    __gm__ const bfloat16_t* bias_0,
    __gm__ const bfloat16_t* bias_1,
    __gm__ bfloat16_t* combined_x,
    __gm__ float* combined_topk_weights, std::uint64_t num_tokens,
    std::uint64_t hidden_elements, std::uint64_t num_topk,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_topk_weight_offset) {
    const std::uint64_t thread_index = threadIdx.x;
    const std::uint64_t total_hidden = num_tokens * hidden_elements;
    for (std::uint64_t index = thread_index; index < total_hidden;
         index += blockDim.x) {
        const std::uint64_t token = index / hidden_elements;
        const std::uint64_t hidden = index % hidden_elements;
        __gm__ const std::uint8_t* record = communication_buffer +
            token * token_stride_bytes;
        auto record_hidden = reinterpret_cast<__gm__ const bfloat16_t*>(
            record + token_hidden_offset);
        float value = static_cast<float>(record_hidden[hidden]);
        if (bias_0 != nullptr)
            value += static_cast<float>(bias_0[index]);
        if (bias_1 != nullptr)
            value += static_cast<float>(bias_1[index]);
        combined_x[index] = static_cast<bfloat16_t>(value);
    }
    const std::uint64_t total_weights =
        num_tokens * num_topk;
    for (std::uint64_t index = thread_index; index < total_weights;
         index += blockDim.x) {
        const std::uint64_t token = index / num_topk;
        const std::uint64_t lane = index % num_topk;
        __gm__ const std::uint8_t* record = communication_buffer +
            token * token_stride_bytes;
        auto record_weights = reinterpret_cast<__gm__ const float*>(
            record + token_topk_weight_offset);
        if (combined_topk_weights != nullptr)
            combined_topk_weights[index] = record_weights[lane];
    }
}

__global__ __vector__ void combine_kernel(
    __gm__ const std::uint16_t* x,
    __gm__ const float* topk_weights,
    __gm__ const std::int32_t* source_metadata,
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ const std::int32_t* prefix_per_rank,
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace, CoreTiling tiling) {
    asc_vf_call<combine_vf>(
        dim3(tiling.launch.num_threads),
        reinterpret_cast<__gm__ const bfloat16_t*>(x), topk_weights,
        source_metadata, combined_topk_indices, prefix_per_rank,
        communication_buffer, workspace, tiling.transport_context,
        tiling.mode_flags, tiling.topology.world_size, tiling.num_tokens,
        tiling.hidden, tiling.num_topk, tiling.token_layout.stride_bytes,
        tiling.token_layout.hidden_offset,
        tiling.token_layout.topk_weight_offset);
}

__global__ __vector__ void combine_epilogue_kernel(
    __gm__ const std::uint8_t* communication_buffer,
    __gm__ const std::uint16_t* bias_0,
    __gm__ const std::uint16_t* bias_1,
    __gm__ std::uint16_t* combined_x,
    __gm__ float* combined_topk_weights, CoreTiling tiling) {
    asc_vf_call<combine_epilogue_vf>(
        dim3(tiling.launch.num_threads), communication_buffer,
        reinterpret_cast<__gm__ const bfloat16_t*>(bias_0),
        reinterpret_cast<__gm__ const bfloat16_t*>(bias_1),
        reinterpret_cast<__gm__ bfloat16_t*>(combined_x),
        combined_topk_weights, tiling.num_tokens, tiling.hidden,
        tiling.num_topk, tiling.token_layout.stride_bytes,
        tiling.token_layout.hidden_offset,
        tiling.token_layout.topk_weight_offset);
}

}  // namespace deep_ep::ascend::elastic

extern "C" int deep_ep_ascend_launch_combine(
    deep_ep::ascend::elastic::CombineArguments arguments,
    deep_ep::ascend::elastic::CoreTiling tiling, void* stream) {
    deep_ep::ascend::elastic::combine_kernel<<<
        tiling.launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        static_cast<const std::uint16_t*>(arguments.x),
        arguments.topk_weights, arguments.source_metadata,
        arguments.combined_topk_indices, arguments.prefix_per_rank,
        static_cast<std::uint8_t*>(arguments.communication_buffer),
        static_cast<std::uint8_t*>(arguments.workspace), tiling);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

extern "C" int deep_ep_ascend_launch_combine_epilogue(
    deep_ep::ascend::elastic::CombineArguments arguments,
    deep_ep::ascend::elastic::CoreTiling tiling, void* stream) {
    deep_ep::ascend::elastic::combine_epilogue_kernel<<<
        tiling.launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        static_cast<const std::uint8_t*>(arguments.communication_buffer),
        static_cast<const std::uint16_t*>(arguments.bias_0),
        static_cast<const std::uint16_t*>(arguments.bias_1),
        static_cast<std::uint16_t*>(arguments.combined_x),
        arguments.combined_topk_weights, tiling);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}
