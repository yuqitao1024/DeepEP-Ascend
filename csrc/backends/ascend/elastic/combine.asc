#include <cstdint>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"

#include "kernels.hpp"

#define DEEP_EP_ASCEND_SIMT_DEVICE 1
#include "../transport/device_transport_facade.hpp"

namespace deep_ep::ascend::elastic {

__simt_vf__ inline void combine_vf(
    __gm__ const std::uint8_t* x,
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace, CoreTiling tiling) {
    const std::uint64_t index = threadIdx.x;
    const std::uint64_t bytes =
        tiling.num_tokens * tiling.token_layout.hidden_bytes;
    for (std::uint64_t offset = index; offset < bytes;
         offset += blockDim.x)
        communication_buffer[offset] = x[offset];
    asc_syncthreads();

    if (tiling.topology.world_size > 1 && threadIdx.x == 0) {
        transport::DeviceTransportFacade transport(
            tiling.transport_context, 0);
        const auto address =
            reinterpret_cast<transport::DeviceAddress>(workspace);
        transport.put(
            transport::TransportTeam::kWorld, 0, address, address,
            sizeof(std::uint64_t), transport::CooperationScope::kParticipant,
            transport::MemorySegment::kDevice, transport::kDefaultOptions,
            transport::RemoteAction::none());
        transport.remote_add_release(
            transport::TransportTeam::kScaleUp, 0, address, 1);
        transport.flush(transport::CooperationScope::kWorkgroup);
        transport.device_barrier(1, address, 0);
    }
}

__simt_vf__ inline void combine_epilogue_vf(
    __gm__ const std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* combined_x, CoreTiling tiling) {
    const std::uint64_t index = threadIdx.x;
    const std::uint64_t bytes =
        tiling.num_tokens * tiling.token_layout.hidden_bytes;
    for (std::uint64_t offset = index; offset < bytes;
         offset += blockDim.x)
        combined_x[offset] = communication_buffer[offset];
}

__global__ __vector__ void combine_kernel(
    __gm__ const std::uint8_t* x,
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace, CoreTiling tiling) {
    asc_vf_call<combine_vf>(
        dim3(tiling.launch.num_threads), x, communication_buffer,
        workspace, tiling);
}

__global__ __vector__ void combine_epilogue_kernel(
    __gm__ const std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* combined_x, CoreTiling tiling) {
    asc_vf_call<combine_epilogue_vf>(
        dim3(tiling.launch.num_threads), communication_buffer,
        combined_x, tiling);
}

}  // namespace deep_ep::ascend::elastic

extern "C" int deep_ep_ascend_launch_combine(
    deep_ep::ascend::elastic::CombineArguments arguments,
    deep_ep::ascend::elastic::CoreTiling tiling, void* stream) {
    deep_ep::ascend::elastic::combine_kernel<<<
        tiling.launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        static_cast<const std::uint8_t*>(arguments.x),
        static_cast<std::uint8_t*>(arguments.communication_buffer),
        static_cast<std::uint8_t*>(arguments.workspace), tiling);
    return 0;
}

extern "C" int deep_ep_ascend_launch_combine_epilogue(
    deep_ep::ascend::elastic::CombineArguments arguments,
    deep_ep::ascend::elastic::CoreTiling tiling, void* stream) {
    deep_ep::ascend::elastic::combine_epilogue_kernel<<<
        tiling.launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        static_cast<const std::uint8_t*>(arguments.communication_buffer),
        static_cast<std::uint8_t*>(arguments.combined_x), tiling);
    return 0;
}
