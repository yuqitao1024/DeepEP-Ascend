#include <cstdint>

#include "acl/acl.h"
#include "simt_api/asc_bf16.h"
#include "simt_api/asc_simt.h"

#include "kernels.hpp"

#define DEEP_EP_ASCEND_SIMT_DEVICE 1
#include "combine_state.hpp"
#include "../transport/aicore_transport_service.hpp"
#include "../transport/device_transport_facade.hpp"

namespace deep_ep::ascend::elastic {

enum class CombineProtocolError : std::uint32_t {
    kNone = 0,
    kInvalidLayout,
    kCapacityOverflow,
    kInvalidPrefix,
    kInvalidMetadata,
    kInvalidControl,
    kInvalidHeader,
    kDuplicateRecord,
};

DEEP_EP_ASCEND_SIMT_CALLEE void record_combine_protocol_error(
    const transport::DeviceTransportContext& context,
    transport::DeviceAddress status_address, int peer_rank,
    CombineProtocolError error) {
    transport::DeviceTransportFacade transport(context, 0);
    const std::uint64_t status =
        (static_cast<std::uint64_t>(peer_rank + 1) << 32U) |
        static_cast<std::uint32_t>(error);
    transport.store_release(status_address, status);
#if defined(DEEP_EP_ASCEND_STAGED_URMA) && DEEP_EP_ASCEND_STAGED_URMA
    auto* queue = transport::device::detail::command_queue(context);
    auto* diagnostic = transport::device::detail::diagnostic(queue);
    if (diagnostic != nullptr) {
        const auto observed_transport_error =
            transport::simt::load_observed(
                reinterpret_cast<__gm__ std::uint32_t*>(
                    &diagnostic->error));
        if (observed_transport_error == static_cast<std::uint32_t>(
                transport::DeviceTransportError::kNone)) {
            transport::simt::store_published(
                &diagnostic->backend_status,
                static_cast<std::uint32_t>(error));
            transport::simt::system_fence();
        }
    }
    transport::device::detail::record_error(
        queue, transport::DeviceTransportError::kInvalidProtocol,
        transport::TransportCommandOpcode::kNone, peer_rank, 0);
#endif
}

__simt_vf__ inline void combine_producer_vf(
    __gm__ const bfloat16_t* x,
    __gm__ const std::int32_t* source_metadata,
    __gm__ const std::int32_t* prefix_per_rank,
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uintptr_t transport_local_window_base,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_size,
    std::uintptr_t transport_backend_context,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t timeout_cycles, std::uint64_t num_source_rows,
    std::uint64_t num_input_rows,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t combine_record_bytes,
    std::uint64_t combine_control_offset,
    std::uint64_t combine_control_bytes,
    std::uint64_t combine_receive_offset,
    std::uint64_t combine_receive_shard_bytes,
    std::uint64_t combine_receive_shard_count,
    std::uint64_t combine_receive_bytes,
    std::uint64_t combine_staging_offset,
    std::uint64_t combine_staging_shard_bytes,
    std::uint64_t combine_staging_shard_count,
    std::uint64_t combine_staging_bytes,
    std::uint64_t workspace_scratch_offset,
    std::uint64_t hidden_elements) {
    if (threadIdx.x != 0)
        return;

    transport::DeviceTransportContext context{};
    context.abi_version = transport_abi_version;
    context.struct_size = transport_struct_size;
    context.topology.world_rank = transport_world_rank;
    context.topology.world_size = transport_world_size;
    context.topology.scale_up_rank = transport_world_rank;
    context.topology.scale_up_size = transport_scale_up_size;
    context.local_window_base = transport_local_window_base;
    context.backend_context = transport_backend_context;
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address =
        reinterpret_cast<transport::DeviceAddress>(
            workspace + workspace_scratch_offset);
    transport.store_release(status_address, 0);

    const std::uint64_t hidden_bytes =
        hidden_elements * sizeof(std::uint16_t);
    // Task 1 places the header as the final field in the aligned record.
    const std::uint64_t header_offset =
        combine_record_bytes >= kAscendElasticAlignment ?
            combine_record_bytes - kAscendElasticAlignment : 0;
    const std::uint64_t raw_record_capacity =
        shard_capacity * static_cast<std::uint64_t>(transport_world_size);

    // Raw record bounds are checked before any byte-capacity arithmetic.
    if (transport_world_size != 2 || transport_scale_up_size != 2 ||
        transport_world_rank < 0 ||
        transport_world_rank >= transport_world_size || mode_flags != 0 ||
        generation == 0 || timeout_cycles == 0 ||
        num_source_rows != num_input_rows ||
        num_source_rows > raw_record_capacity ||
        shard_capacity == 0 ||
        shard_capacity >
            static_cast<std::uint64_t>(0x7fffffff) /
                static_cast<std::uint64_t>(transport_world_size))
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kCapacityOverflow);

    if (combine_control_bytes <
            static_cast<std::uint64_t>(transport_world_size) *
                sizeof(CombineControlSlot) ||
        combine_receive_shard_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        combine_staging_shard_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        combine_receive_bytes <
            combine_receive_shard_count * combine_receive_shard_bytes ||
        combine_staging_bytes <
            combine_staging_shard_count * combine_staging_shard_bytes ||
        combine_record_bytes < kAscendElasticAlignment ||
        hidden_bytes > header_offset ||
        header_offset + sizeof(CombineRecordHeader) > combine_record_bytes ||
        shard_capacity * combine_record_bytes >
            combine_receive_shard_bytes ||
        shard_capacity * combine_record_bytes >
            combine_staging_shard_bytes)
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kInvalidLayout);

    std::uint64_t record_counts[2]{};
    std::uint64_t record_begins[2]{};
    std::uint64_t previous_end = 0;
    const std::uint64_t metadata_stride = 2 + num_topk;
    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        const std::int32_t encoded_end = prefix_per_rank[destination_rank];
        if (encoded_end < 0 ||
            static_cast<std::uint64_t>(encoded_end) < previous_end ||
            static_cast<std::uint64_t>(encoded_end) > num_source_rows)
            return record_combine_protocol_error(
                context, status_address, destination_rank,
                CombineProtocolError::kInvalidPrefix);
        const std::uint64_t end = static_cast<std::uint64_t>(encoded_end);
        record_begins[destination_rank] = previous_end;
        record_counts[destination_rank] = end - previous_end;
        if (record_counts[destination_rank] > shard_capacity)
            return record_combine_protocol_error(
                context, status_address, destination_rank,
                CombineProtocolError::kCapacityOverflow);
        previous_end = end;
    }
    if (previous_end != num_source_rows)
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kInvalidPrefix);

    // Validate all compact rows before writing staging or publishing commands.
    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        const std::uint64_t begin = record_begins[destination_rank];
        const std::uint64_t count = record_counts[destination_rank];
        if (count * combine_record_bytes > combine_staging_shard_bytes ||
            count * combine_record_bytes > combine_receive_shard_bytes)
            return record_combine_protocol_error(
                context, status_address, destination_rank,
                CombineProtocolError::kCapacityOverflow);
        for (std::uint64_t slot = 0; slot < count; ++slot) {
            const std::uint64_t row = begin + slot;
            __gm__ const std::int32_t* metadata =
                source_metadata + row * metadata_stride;
            const int origin_rank = decode_dispatch_source_rank(
                metadata[0], shard_capacity);
            const std::int32_t origin_token = decode_dispatch_local_index(
                metadata[0], shard_capacity);
            const int master_rank = decode_dispatch_source_rank(
                metadata[1], num_topk);
            const std::int32_t master_lane = decode_dispatch_local_index(
                metadata[1], num_topk);
            if (origin_rank != destination_rank ||
                master_rank != destination_rank ||
                !is_dispatch_local_index(origin_token, shard_capacity) ||
                !is_dispatch_local_index(master_lane, num_topk) ||
                row >= num_input_rows)
                return record_combine_protocol_error(
                    context, status_address, destination_rank,
                    CombineProtocolError::kInvalidMetadata);
            for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                if (metadata[2 + lane] != -1)
                    return record_combine_protocol_error(
                        context, status_address, destination_rank,
                        CombineProtocolError::kInvalidMetadata);
            }
            for (std::uint64_t prior = 0; prior < slot; ++prior) {
                __gm__ const std::int32_t* prior_metadata =
                    source_metadata + (begin + prior) * metadata_stride;
                if (decode_dispatch_local_index(
                        prior_metadata[0], shard_capacity) == origin_token)
                    return record_combine_protocol_error(
                        context, status_address, destination_rank,
                        CombineProtocolError::kDuplicateRecord);
            }
        }
    }

    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        __gm__ std::uint8_t* staging_shard =
            reinterpret_cast<__gm__ std::uint8_t*>(
                combine_staging_shard_address(
                    transport_local_window_base, combine_staging_offset,
                    static_cast<std::uint64_t>(destination_rank),
                    combine_staging_shard_bytes));
        const std::uint64_t begin = record_begins[destination_rank];
        const std::uint64_t count = record_counts[destination_rank];
        for (std::uint64_t slot = 0; slot < count; ++slot) {
            const std::uint64_t row = begin + slot;
            __gm__ const std::int32_t* metadata =
                source_metadata + row * metadata_stride;
            __gm__ std::uint8_t* record =
                staging_shard + slot * combine_record_bytes;
            auto* record_hidden =
                reinterpret_cast<__gm__ bfloat16_t*>(record);
            auto* header = reinterpret_cast<__gm__ CombineRecordHeader*>(
                record + header_offset);
            for (std::uint64_t hidden = 0;
                 hidden < hidden_elements; ++hidden)
                record_hidden[hidden] =
                    x[row * hidden_elements + hidden];
            for (std::uint64_t byte = hidden_bytes;
                 byte < header_offset; ++byte)
                record[byte] = 0;
            header->abi_version = kCombineRecordAbiVersion;
            header->struct_size = sizeof(CombineRecordHeader);
            header->origin_token = decode_dispatch_local_index(
                metadata[0], shard_capacity);
            header->contributor_rank = transport_world_rank;
            header->master_lane = decode_dispatch_local_index(
                metadata[1], num_topk);
            header->contribution_lane = header->master_lane;
        }
    }

    auto* control_slots = reinterpret_cast<__gm__ CombineControlSlot*>(
        transport_local_window_base + combine_control_offset);
    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        const std::uint64_t count = record_counts[destination_rank];
        const auto source = static_cast<transport::DeviceAddress>(
            combine_staging_shard_address(
                transport_local_window_base, combine_staging_offset,
                static_cast<std::uint64_t>(destination_rank),
                combine_staging_shard_bytes));
        const auto destination = static_cast<transport::DeviceAddress>(
            combine_receive_shard_address(
                transport_local_window_base, combine_receive_offset,
                static_cast<std::uint64_t>(transport_world_rank),
                combine_receive_shard_bytes));
        if (destination_rank == transport_world_rank) {
            auto* local_source = reinterpret_cast<
                __gm__ const std::uint8_t*>(
                    combine_staging_shard_address(
                        transport_local_window_base, combine_staging_offset,
                        static_cast<std::uint64_t>(destination_rank),
                        combine_staging_shard_bytes));
            auto* local_destination = reinterpret_cast<__gm__ std::uint8_t*>(
                combine_receive_shard_address(
                    transport_local_window_base, combine_receive_offset,
                    static_cast<std::uint64_t>(transport_world_rank),
                    combine_receive_shard_bytes));
            for (std::uint64_t byte = 0;
                 byte < count * combine_record_bytes; ++byte)
                local_destination[byte] = local_source[byte];
            transport.store_release(
                reinterpret_cast<transport::DeviceAddress>(
                    &control_slots[transport_world_rank].count), count);
            transport.store_release(
                reinterpret_cast<transport::DeviceAddress>(
                    &control_slots[transport_world_rank].generation),
                generation);
            continue;
        }
        if (count != 0) {
            transport.put(
                transport::TransportTeam::kScaleUp, destination_rank,
                destination, source, count * combine_record_bytes,
                transport::CooperationScope::kParticipant,
                transport::MemorySegment::kDevice,
                transport::kDefaultOptions,
                transport::RemoteAction::none());
        }
        const auto remote_count = static_cast<transport::DeviceAddress>(
            transport_local_window_base + combine_control_offset +
            static_cast<std::uint64_t>(transport_world_rank) *
                sizeof(CombineControlSlot) + sizeof(std::uint64_t));
        transport.put_value(
            transport::TransportTeam::kScaleUp, destination_rank,
            remote_count, count, sizeof(std::uint64_t),
            transport::kDefaultOptions);
        const auto remote_generation = static_cast<transport::DeviceAddress>(
            transport_local_window_base + combine_control_offset +
            static_cast<std::uint64_t>(transport_world_rank) *
                sizeof(CombineControlSlot));
        transport.put_value(
            transport::TransportTeam::kScaleUp, destination_rank,
            remote_generation, generation, sizeof(std::uint64_t),
            transport::kDefaultOptions);
        transport.signal(
            transport::TransportTeam::kScaleUp, destination_rank,
            transport::RemoteAction::signal_increment(0));
    }
    const auto barrier_workspace =
        reinterpret_cast<transport::DeviceAddress>(
            &control_slots[transport_world_rank].generation);
    transport.device_barrier(1, barrier_workspace, timeout_cycles);
}

__simt_vf__ inline void combine_epilogue_vf(
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ std::uint8_t* workspace,
    __gm__ bfloat16_t* combined_x,
    __gm__ float* combined_topk_weights,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uintptr_t transport_local_window_base,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_size,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t num_tokens,
    std::uint64_t num_experts, std::uint64_t num_topk,
    std::uint64_t shard_capacity, std::uint64_t combine_record_bytes,
    std::uint64_t control_offset,
    std::uint64_t combine_control_offset,
    std::uint64_t combine_control_bytes,
    std::uint64_t combine_receive_offset,
    std::uint64_t combine_receive_shard_bytes,
    std::uint64_t combine_receive_shard_count,
    std::uint64_t combine_receive_bytes,
    std::uint64_t workspace_scratch_offset,
    std::uint64_t hidden_elements) {
    if (threadIdx.x != 0)
        return;

    transport::DeviceTransportContext context{};
    context.abi_version = transport_abi_version;
    context.struct_size = transport_struct_size;
    context.topology.world_rank = transport_world_rank;
    context.topology.world_size = transport_world_size;
    context.topology.scale_up_rank = transport_world_rank;
    context.topology.scale_up_size = transport_scale_up_size;
    context.local_window_base = transport_local_window_base;
    context.backend_context = transport_backend_context;
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address =
        reinterpret_cast<transport::DeviceAddress>(
            workspace + workspace_scratch_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    const auto consumed_generation = transport.consumed_generation();
    auto* queue = transport::device::detail::command_queue(context);
    auto* diagnostic = transport::device::detail::diagnostic(queue);
    if (diagnostic == nullptr)
        return;
    const auto diagnostic_abi_version =
        transport::simt::load_observed(&diagnostic->abi_version);
    const auto diagnostic_generation =
        transport::simt::load_observed(&diagnostic->generation);
    const auto diagnostic_error =
        static_cast<transport::DeviceTransportError>(
            transport::simt::load_observed(
                reinterpret_cast<__gm__ const std::uint32_t*>(
                    &diagnostic->error)));
    if (!is_clean_combine_transport_completion(
            generation, consumed_generation, diagnostic_abi_version,
            diagnostic_generation, diagnostic_error))
        return;

    if (combine_control_bytes <
            static_cast<std::uint64_t>(transport_world_size) *
                sizeof(CombineControlSlot) ||
        combine_receive_shard_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        combine_receive_bytes <
            combine_receive_shard_count * combine_receive_shard_bytes)
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kInvalidLayout);

    std::uint64_t contributor_counts[2]{};
    auto* control_slots = reinterpret_cast<__gm__ CombineControlSlot*>(
        transport_local_window_base + combine_control_offset);
    for (int contributor_rank = 0;
         contributor_rank < transport_world_size; ++contributor_rank) {
        const auto generation_address =
            reinterpret_cast<transport::DeviceAddress>(
                &control_slots[contributor_rank].generation);
        const auto count_address =
            reinterpret_cast<transport::DeviceAddress>(
                &control_slots[contributor_rank].count);
        const std::uint64_t observed_generation =
            transport.load_acquire(generation_address);
        const std::uint64_t record_count =
            transport.load_acquire(count_address);
        if (observed_generation != generation ||
            record_count > shard_capacity ||
            record_count * combine_record_bytes >
                combine_receive_shard_bytes)
            return record_combine_protocol_error(
                context, status_address, contributor_rank,
                record_count > shard_capacity ?
                    CombineProtocolError::kCapacityOverflow :
                    CombineProtocolError::kInvalidControl);
        contributor_counts[contributor_rank] = record_count;
    }

    const std::uint64_t hidden_bytes =
        hidden_elements * sizeof(std::uint16_t);
    // Use the same Task 1 record boundary when validating received headers.
    const std::uint64_t header_offset =
        combine_record_bytes >= kAscendElasticAlignment ?
            combine_record_bytes - kAscendElasticAlignment : 0;
    if (combine_record_bytes < kAscendElasticAlignment ||
        hidden_bytes > header_offset ||
        header_offset + sizeof(CombineRecordHeader) > combine_record_bytes)
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kInvalidLayout);
    const std::uint64_t num_local_experts =
        num_experts / static_cast<std::uint64_t>(transport_world_size);

    // Validate all record headers before reading any payload or writing output.
    for (int contributor_rank = 0;
         contributor_rank < transport_world_size; ++contributor_rank) {
        auto* receive_shard = reinterpret_cast<__gm__ const std::uint8_t*>(
            combine_receive_shard_address(
                transport_local_window_base, combine_receive_offset,
                static_cast<std::uint64_t>(contributor_rank),
                combine_receive_shard_bytes));
        for (std::uint64_t slot = 0;
             slot < contributor_counts[contributor_rank]; ++slot) {
            auto* header =
                reinterpret_cast<__gm__ const CombineRecordHeader*>(
                    receive_shard + slot * combine_record_bytes +
                    header_offset);
            const bool valid_token = is_valid_combine_origin_token(
                header->origin_token, num_tokens, shard_capacity);
            const bool valid_master =
                is_dispatch_local_index(header->master_lane, num_topk);
            std::int64_t expert = -1;
            if (valid_token && valid_master)
                expert = combined_topk_indices[
                    static_cast<std::uint64_t>(header->origin_token) *
                        num_topk +
                    static_cast<std::uint64_t>(header->master_lane)];
            const int expected_contributor = expert < 0 ? -1 :
                static_cast<int>(
                    static_cast<std::uint64_t>(expert) /
                    num_local_experts);
            if (header->abi_version != kCombineRecordAbiVersion ||
                header->struct_size != sizeof(CombineRecordHeader) ||
                header->contributor_rank != contributor_rank ||
                !valid_token || !valid_master ||
                header->contribution_lane != header->master_lane ||
                expert < 0 ||
                static_cast<std::uint64_t>(expert) >= num_experts ||
                expected_contributor != contributor_rank)
                return record_combine_protocol_error(
                    context, status_address, contributor_rank,
                    CombineProtocolError::kInvalidHeader);
            for (std::uint64_t prior = 0; prior < slot; ++prior) {
                auto* prior_header =
                    reinterpret_cast<__gm__ const CombineRecordHeader*>(
                        receive_shard + prior * combine_record_bytes +
                        header_offset);
                if (prior_header->origin_token == header->origin_token)
                    return record_combine_protocol_error(
                        context, status_address, contributor_rank,
                        CombineProtocolError::kDuplicateRecord);
            }
        }
    }

    for (std::uint64_t token = 0; token < num_tokens; ++token) {
        for (std::uint64_t hidden = 0;
             hidden < hidden_elements; ++hidden) {
            float value = 0.0F;
            for (int contributor_rank = 0;
                 contributor_rank < transport_world_size;
                 ++contributor_rank) {
                auto* receive_shard =
                    reinterpret_cast<__gm__ const std::uint8_t*>(
                        combine_receive_shard_address(
                            transport_local_window_base,
                            combine_receive_offset,
                            static_cast<std::uint64_t>(contributor_rank),
                            combine_receive_shard_bytes));
                for (std::uint64_t slot = 0;
                     slot < contributor_counts[contributor_rank]; ++slot) {
                    auto* record =
                        receive_shard + slot * combine_record_bytes;
                    auto* header = reinterpret_cast<
                        __gm__ const CombineRecordHeader*>(
                            record + header_offset);
                    if (header->origin_token ==
                        static_cast<std::int32_t>(token)) {
                        auto* payload =
                            reinterpret_cast<__gm__ const bfloat16_t*>(record);
                        value += static_cast<float>(payload[hidden]);
                    }
                }
            }
            combined_x[token * hidden_elements + hidden] =
                static_cast<bfloat16_t>(value);
        }
    }
    if (combined_topk_weights != nullptr) {
        for (std::uint64_t index = 0;
             index < num_tokens * num_topk; ++index)
            combined_topk_weights[index] = 0.0F;
    }

    auto* control = reinterpret_cast<__gm__ SymmetricControlHeader*>(
        transport_local_window_base + control_offset);
    transport.store_release(
        reinterpret_cast<transport::DeviceAddress>(
            &control->combine_generation), generation);
}

__global__ __vector__ void combine_kernel(
    __gm__ const std::uint16_t* x,
    __gm__ const std::int32_t* source_metadata,
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ const std::int32_t* prefix_per_rank,
    __gm__ std::uint8_t* workspace,
    __gm__ std::uint16_t* combined_x,
    __gm__ float* combined_topk_weights,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t num_source_rows, std::uint64_t num_input_rows,
    std::uintptr_t local_window_base, CoreTiling tiling) {
    transport::service::reset(tiling.transport_context, generation);
    asc_vf_call<combine_producer_vf>(
        dim3(tiling.launch.num_threads),
        reinterpret_cast<__gm__ const bfloat16_t*>(x), source_metadata,
        prefix_per_rank, workspace,
        tiling.transport_context.abi_version,
        tiling.transport_context.struct_size,
        local_window_base,
        tiling.transport_context.topology.world_rank,
        tiling.transport_context.topology.world_size,
        tiling.transport_context.topology.scale_up_size,
        tiling.transport_context.backend_context,
        tiling.mode_flags, generation, timeout_cycles,
        num_source_rows, num_input_rows,
        tiling.num_topk, tiling.num_max_tokens_per_rank,
        tiling.symmetric_window_layout.combine_record_bytes,
        tiling.symmetric_window_layout.combine_control_offset,
        tiling.symmetric_window_layout.combine_control_bytes,
        tiling.symmetric_window_layout.combine_receive_offset,
        tiling.symmetric_window_layout.combine_receive_shard_bytes,
        tiling.symmetric_window_layout.combine_receive_shard_count,
        tiling.symmetric_window_layout.combine_receive_bytes,
        tiling.symmetric_window_layout.combine_staging_offset,
        tiling.symmetric_window_layout.combine_staging_shard_bytes,
        tiling.symmetric_window_layout.combine_staging_shard_count,
        tiling.symmetric_window_layout.combine_staging_bytes,
        tiling.workspace_layout.scratch_offset, tiling.hidden);
    transport::service::execute(tiling.transport_context);
    asc_vf_call<combine_epilogue_vf>(
        dim3(tiling.launch.num_threads), combined_topk_indices, workspace,
        reinterpret_cast<__gm__ bfloat16_t*>(combined_x),
        combined_topk_weights,
        tiling.transport_context.abi_version,
        tiling.transport_context.struct_size,
        local_window_base,
        tiling.transport_context.topology.world_rank,
        tiling.transport_context.topology.world_size,
        tiling.transport_context.topology.scale_up_size,
        tiling.transport_context.backend_context,
        generation, tiling.num_tokens, tiling.num_experts,
        tiling.num_topk, tiling.num_max_tokens_per_rank,
        tiling.symmetric_window_layout.combine_record_bytes,
        tiling.symmetric_window_layout.control_offset,
        tiling.symmetric_window_layout.combine_control_offset,
        tiling.symmetric_window_layout.combine_control_bytes,
        tiling.symmetric_window_layout.combine_receive_offset,
        tiling.symmetric_window_layout.combine_receive_shard_bytes,
        tiling.symmetric_window_layout.combine_receive_shard_count,
        tiling.symmetric_window_layout.combine_receive_bytes,
        tiling.workspace_layout.scratch_offset, tiling.hidden);
}

}  // namespace deep_ep::ascend::elastic

extern "C" int deep_ep_ascend_launch_combine(
    deep_ep::ascend::elastic::CombineArguments arguments,
    deep_ep::ascend::elastic::CoreTiling tiling, void* stream) {
    deep_ep::ascend::elastic::combine_kernel<<<
        tiling.launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        static_cast<const std::uint16_t*>(arguments.x),
        arguments.source_metadata, arguments.combined_topk_indices,
        arguments.prefix_per_rank,
        static_cast<std::uint8_t*>(arguments.workspace),
        static_cast<std::uint16_t*>(arguments.combined_x),
        arguments.combined_topk_weights,
        arguments.generation, arguments.timeout_cycles,
        arguments.num_source_rows, arguments.num_input_rows,
        arguments.local_window_base, tiling);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

extern "C" int deep_ep_ascend_launch_combine_epilogue(
    deep_ep::ascend::elastic::CombineArguments,
    deep_ep::ascend::elastic::CoreTiling, void*) {
    return 0;
}
