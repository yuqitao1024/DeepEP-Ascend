#include "../transport/device_transport_facade.hpp"

namespace deep_ep::ascend::elastic {

#include "dispatch_device_common.hpp"

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_epilogue_validate_records_vf(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ const std::int32_t* source_metadata,
    transport::DeviceTransportContext context,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t num_experts, std::uint64_t num_topk,
    std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t dispatch_receive_tile_error_offset,
    std::uint64_t dispatch_receive_error_candidate_offset,
    std::uint64_t dispatch_receive_error_completion_offset,
    std::uint64_t dispatch_receive_tile_count,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_source_metadata_offset) {
    __ubuf__ std::uint32_t completed_in_block[1];
    if (threadIdx.x == 0)
        completed_in_block[0] = 0;
    asc_syncthreads();
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
#if DEEP_EP_ASCEND_ACQUIRE_DIAGNOSTICS
    __gm__ transport::TransportStageProfile* profile = nullptr;
    auto* staged = reinterpret_cast<__gm__ transport::StagedTransportContext*>(
        context.backend_context);
    if (blockIdx.x == 0 && staged != nullptr &&
        transport::simt::load_observed(&staged->stage_profile) != 0 &&
        transport::simt::load_observed(&staged->stage_profile_bytes) ==
            sizeof(transport::TransportStageProfile)) {
        profile = reinterpret_cast<
            __gm__ transport::TransportStageProfile*>(staged->stage_profile);
        transport::simt::store_published(
            &profile->validate_vf_start_cycles, __asc_simt_vf::clock());
    }
#endif
    const bool status_was_clean =
        transport::simt::load_observed(status) == 0;
    const bool cached = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const bool expanded = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    const std::uint32_t num_experts_u32 =
        static_cast<std::uint32_t>(num_experts);
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t shard_capacity_u32 =
        static_cast<std::uint32_t>(shard_capacity);
    const std::uint32_t tile_count_u32 =
        static_cast<std::uint32_t>(dispatch_receive_tile_count);
    const std::uint32_t world_size =
        static_cast<std::uint32_t>(context.topology.world_size);
    const std::uint32_t local_experts = num_experts_u32 / world_size;
    const std::uint32_t first_local_expert =
        static_cast<std::uint32_t>(context.topology.world_rank) *
        local_experts;
    auto* source_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* source_bases = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    auto* tile_errors = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_receive_tile_error_offset);
    auto* error_candidate = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_receive_error_candidate_offset);
    auto* error_completion = reinterpret_cast<__gm__ std::uint32_t*>(
        workspace + dispatch_receive_error_completion_offset);
    const auto work = direct_block_distributed_grid_stride(
        blockIdx.x, threadIdx.x, gridDim.x, blockDim.x);
    const std::uint32_t logical_record_capacity =
        world_size * shard_capacity_u32;
    for (std::uint32_t tile = work.first;
         tile < tile_count_u32; tile += work.stride) {
        DispatchProtocolError error = DispatchProtocolError::kNone;
        int failure_rank = context.topology.world_rank;
        int diagnostic_peer = context.topology.world_rank;
        const std::uint32_t tile_begin = tile *
            static_cast<std::uint32_t>(kDispatchReceiveRecordsPerTile);
        std::uint32_t tile_end = tile_begin +
            static_cast<std::uint32_t>(kDispatchReceiveRecordsPerTile);
        if (tile_end > logical_record_capacity)
            tile_end = logical_record_capacity;
        for (std::uint32_t logical_record = tile_begin;
             logical_record < tile_end; ++logical_record) {
            std::uint64_t source_rank_u64 = 0;
            std::uint64_t source_slot = 0;
            if (!dispatch_simt_receive_record_coordinates(
                    logical_record, world_size, shard_capacity,
                    &source_rank_u64, &source_slot)) {
                error = DispatchProtocolError::kInvalidLayout;
                diagnostic_peer = static_cast<int>(
                    500000U + logical_record);
                break;
            }
            const int source_rank = static_cast<int>(source_rank_u64);
            if (source_slot >= source_counts[source_rank])
                continue;
            failure_rank = source_rank;
            __gm__ std::uint8_t* source_shard =
                context.topology.world_size == 1 ? communication_buffer :
                reinterpret_cast<__gm__ std::uint8_t*>(
                    context.local_window_base + dispatch_receive_offset +
                    source_rank_u64 * dispatch_receive_shard_bytes);
            __gm__ std::uint8_t* record =
                source_shard + source_slot * token_stride_bytes;
            auto* record_topk =
                reinterpret_cast<__gm__ const std::int64_t*>(
                    record + token_topk_index_offset);
            auto* record_metadata =
                reinterpret_cast<__gm__ const std::int32_t*>(
                    record + token_source_metadata_offset);
            bool has_local_lane = false;
            for (std::uint32_t lane = 0; lane < num_topk_u32; ++lane) {
                const std::int64_t expert = record_topk[lane];
                if (expert < -1 ||
                    (expert >= 0 &&
                     static_cast<std::uint64_t>(expert) >=
                         num_experts_u32)) {
                    error = DispatchProtocolError::kInvalidTopk;
                    diagnostic_peer = static_cast<int>(
                        600000U + logical_record);
                    break;
                }
                const bool local = is_dispatch_expert_local(
                    expert, first_local_expert, local_experts);
                if (local)
                    has_local_lane = true;
                if (cached && expanded && !local) {
                    const auto compact_slot =
                        source_bases[source_rank] + source_slot;
                    const auto* reusable = source_metadata +
                        compact_slot * (2 + num_topk);
                    if (reusable[2 + lane] != -1) {
                        error =
                            DispatchProtocolError::kInvalidCachedMetadata;
                        break;
                    }
                }
            }
            const std::int32_t master_lane = record_metadata[1];
            if (error == DispatchProtocolError::kNone &&
                (!has_local_lane ||
                 !is_dispatch_local_index(
                     record_metadata[0], shard_capacity) ||
                 !is_dispatch_local_index(master_lane, num_topk) ||
                 !is_dispatch_expert_local(
                     record_topk[master_lane], first_local_expert,
                     local_experts))) {
                error = DispatchProtocolError::kInvalidCachedMetadata;
                const std::uint32_t reason =
                    !has_local_lane ? 100000U :
                    !is_dispatch_local_index(
                        record_metadata[0], shard_capacity) ? 200000U :
                    !is_dispatch_local_index(master_lane, num_topk) ?
                        300000U : 400000U;
                const std::int32_t first_expert =
                    static_cast<std::int32_t>(record_topk[0]);
                const std::int32_t last_expert =
                    static_cast<std::int32_t>(
                        record_topk[num_topk_u32 - 1]);
                diagnostic_peer = static_cast<int>(
                    reason + logical_record * 65536U +
                    ((static_cast<std::uint32_t>(first_expert) & 0xffU) << 8U) +
                    (static_cast<std::uint32_t>(last_expert) & 0xffU));
            }
            if (error == DispatchProtocolError::kNone && cached) {
                const auto compact_slot =
                    source_bases[source_rank] + source_slot;
                const auto* reusable = source_metadata +
                    compact_slot * (2 + num_topk);
                if (reusable[0] != encode_dispatch_source_index(
                        static_cast<std::uint64_t>(source_rank),
                        shard_capacity,
                        static_cast<std::uint64_t>(record_metadata[0])) ||
                    reusable[1] != encode_dispatch_source_index(
                        static_cast<std::uint64_t>(source_rank), num_topk,
                        static_cast<std::uint64_t>(master_lane)))
                    error = DispatchProtocolError::kInvalidCachedMetadata;
            }
            if (error != DispatchProtocolError::kNone)
                break;
        }
        if (error == DispatchProtocolError::kNone) {
            tile_errors[tile] = 0;
        } else {
            const auto candidate = make_dispatch_protocol_failure(
                diagnostic_peer, DispatchProtocolStage::kEpilogue,
                generation, error).scratch_status;
            tile_errors[tile] = candidate;
            (void)asc_atomic_min(
                error_candidate,
                (static_cast<std::uint64_t>(tile) + 1U) << 32U |
                    (candidate & 0xffffffffU));
        }
    }
    transport::simt::system_fence();
    asc_atomic_add(&completed_in_block[0], 1U);
    asc_syncthreads();
    if (threadIdx.x != 0)
        return;
#if DEEP_EP_ASCEND_ACQUIRE_DIAGNOSTICS
    if (blockIdx.x == 0 && profile != nullptr) {
        transport::simt::store_published(
            &profile->validate_vf_end_cycles, __asc_simt_vf::clock());
        transport::simt::system_fence();
    }
#endif
    const std::uint32_t worker_count = gridDim.x * blockDim.x;
    const std::uint32_t completed = asc_atomic_add(
        error_completion, completed_in_block[0]);
    if (completed + blockDim.x != worker_count)
        return;
    if (!status_was_clean)
        return;
    const std::uint64_t packed_candidate =
        transport::simt::load_observed(error_candidate);
    if (packed_candidate ==
        std::numeric_limits<std::uint64_t>::max())
        return;
    const std::uint32_t winning_tile = static_cast<std::uint32_t>(
        (packed_candidate >> 32U) - 1U);
    if (winning_tile >= tile_count_u32)
        return;
    const std::uint64_t candidate = transport::simt::load_observed(
        &tile_errors[winning_tile]);
    if (candidate == 0)
        return;
    const auto decoded = decode_dispatch_protocol_scratch(candidate);
    if (decoded.valid)
        record_dispatch_protocol_error(
            context, reinterpret_cast<transport::DeviceAddress>(status),
            decoded.world_rank, DispatchProtocolStage::kEpilogue,
            generation, decoded.error);
}

struct DirectDispatchEpilogueValidateRecordsKernelArguments {
    __gm__ std::uint8_t* communication_buffer;
    __gm__ std::uint8_t* workspace;
    __gm__ const std::int32_t* source_metadata;
    transport::DeviceTransportContext context;
    CoreModeFlags mode_flags;
    std::uint64_t generation, num_experts, num_topk, shard_capacity;
    std::uint64_t dispatch_receive_offset, dispatch_receive_shard_bytes;
    std::uint64_t workspace_status_offset, workspace_rank_counts_offset;
    std::uint64_t workspace_rank_values_offset;
    std::uint64_t dispatch_receive_tile_error_offset;
    std::uint64_t dispatch_receive_error_candidate_offset;
    std::uint64_t dispatch_receive_error_completion_offset;
    std::uint64_t dispatch_receive_tile_count, token_stride_bytes;
    std::uint64_t token_topk_index_offset, token_source_metadata_offset;
    std::uint32_t vf_num_threads;
};

__global__ __vector__ void direct_dispatch_epilogue_validate_records_kernel(
    DirectDispatchEpilogueValidateRecordsKernelArguments arguments) {
    asc_vf_call<direct_dispatch_epilogue_validate_records_vf>(
        dim3(arguments.vf_num_threads), arguments.communication_buffer,
        arguments.workspace, arguments.source_metadata,
        arguments.context, arguments.mode_flags, arguments.generation,
        arguments.num_experts, arguments.num_topk, arguments.shard_capacity,
        arguments.dispatch_receive_offset,
        arguments.dispatch_receive_shard_bytes,
        arguments.workspace_status_offset,
        arguments.workspace_rank_counts_offset,
        arguments.workspace_rank_values_offset,
        arguments.dispatch_receive_tile_error_offset,
        arguments.dispatch_receive_error_candidate_offset,
        arguments.dispatch_receive_error_completion_offset,
        arguments.dispatch_receive_tile_count, arguments.token_stride_bytes,
        arguments.token_topk_index_offset,
        arguments.token_source_metadata_offset);
}

extern "C" int deep_ep_ascend_launch_direct_dispatch_epilogue_validate_records(
    std::uint8_t* communication_buffer,
    std::uint8_t* workspace,
    const std::int32_t* source_metadata,
    transport::DeviceTransportContext context,
    CoreModeFlags mode_flags,
    std::uint64_t generation,
    std::uint64_t num_experts,
    std::uint64_t num_topk,
    std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t dispatch_receive_tile_error_offset,
    std::uint64_t dispatch_receive_error_candidate_offset,
    std::uint64_t dispatch_receive_error_completion_offset,
    std::uint64_t dispatch_receive_tile_count,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_source_metadata_offset,
    void* stream, CoreLaunchShape launch,
    std::uint32_t vf_num_threads) {
    const DirectDispatchEpilogueValidateRecordsKernelArguments arguments{
        communication_buffer, workspace, source_metadata,
        context,
        mode_flags, generation, num_experts, num_topk, shard_capacity,
        dispatch_receive_offset, dispatch_receive_shard_bytes,
        workspace_status_offset, workspace_rank_counts_offset,
        workspace_rank_values_offset, dispatch_receive_tile_error_offset,
        dispatch_receive_error_candidate_offset,
        dispatch_receive_error_completion_offset,
        dispatch_receive_tile_count, token_stride_bytes,
        token_topk_index_offset, token_source_metadata_offset, vf_num_threads};
    direct_dispatch_epilogue_validate_records_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        arguments);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
