#include <cstdint>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"

#define DEEP_EP_ASCEND_SIMT_DEVICE 1
#include "kernels.hpp"

#include "dispatch_state.hpp"
#include "release_protocol.hpp"
#include "../transport/aicore_transport_service.hpp"
#include "../transport/device_transport_facade.hpp"

namespace deep_ep::ascend::elastic {

DEEP_EP_ASCEND_SIMT_CALLEE void record_dispatch_protocol_error(
    const transport::DeviceTransportContext& context,
    transport::DeviceAddress status_address, int world_rank,
    DispatchProtocolStage stage, std::uint64_t generation,
    DispatchProtocolError error) {
    transport::DeviceTransportFacade transport(context, 0);
    const auto failure = make_dispatch_protocol_failure(
        world_rank, stage, generation, error);
    transport.store_release(status_address, failure.scratch_status);
#if defined(DEEP_EP_ASCEND_STAGED_URMA) && DEEP_EP_ASCEND_STAGED_URMA
    auto* queue = transport::device::detail::command_queue(context);
    transport::device::detail::record_error(
        queue, transport::DeviceTransportError::kInvalidProtocol,
        transport::TransportCommandOpcode::kNone, world_rank, 0,
        failure.backend_status, failure.generation);
#endif
}

DEEP_EP_ASCEND_SIMT_CALLEE void record_dispatch_protocol_error(
    const transport::DeviceTransportContext& context,
    transport::DeviceAddress status_address, int world_rank,
    DispatchProtocolError error) {
    std::uint64_t generation = 0;
#if defined(DEEP_EP_ASCEND_STAGED_URMA) && DEEP_EP_ASCEND_STAGED_URMA
    auto* queue = transport::device::detail::command_queue(context);
    if (queue != nullptr)
        generation = transport::simt::load_observed(&queue->generation);
#endif
    record_dispatch_protocol_error(
        context, status_address, world_rank,
        DispatchProtocolStage::kEpilogue, generation, error);
}

DEEP_EP_ASCEND_SIMT_CALLEE DispatchProtocolError
validate_cached_dispatch_state(
    __gm__ const std::int64_t* topk_indices,
    __gm__ const std::int32_t* destination_slots,
    bool cached, int world_rank, int world_size, std::uint64_t num_tokens,
    std::uint64_t num_experts, std::uint64_t num_topk,
    std::uint64_t shard_capacity,
    __gm__ std::uint64_t* destination_counts,
    __gm__ std::uint64_t* maximum_slots,
    __gm__ std::uint8_t* selected_destinations,
    __gm__ std::int32_t* token_slots) {
    if (num_tokens > shard_capacity || shard_capacity == 0 ||
        shard_capacity >
            static_cast<std::uint64_t>(0x7fffffff) /
                static_cast<std::uint64_t>(world_size))
        return DispatchProtocolError::kCapacityOverflow;
    const std::uint64_t num_local_experts =
        num_experts / static_cast<std::uint64_t>(world_size);
    for (int destination_rank = 0;
         destination_rank < world_size; ++destination_rank) {
        destination_counts[destination_rank] = 0;
        maximum_slots[destination_rank] = 0;
    }

    for (std::uint64_t token = 0; token < num_tokens; ++token) {
        for (int destination_rank = 0;
             destination_rank < world_size; ++destination_rank) {
            selected_destinations[destination_rank] = 0;
            token_slots[destination_rank] = -1;
        }
        for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
            const std::int64_t expert =
                topk_indices[token * num_topk + lane];
            const std::int32_t encoded =
                destination_slots[token * num_topk + lane];
            if (expert == -1) {
                if (cached && encoded != -1)
                    return DispatchProtocolError::kInvalidCachedSlot;
                continue;
            }
            if (expert < 0 ||
                static_cast<std::uint64_t>(expert) >= num_experts)
                return DispatchProtocolError::kInvalidTopk;
            const int destination_rank = static_cast<int>(
                static_cast<std::uint64_t>(expert) / num_local_experts);
            selected_destinations[destination_rank] = 1;
            if (!cached)
                continue;
            if (encoded < 0)
                return DispatchProtocolError::kInvalidCachedSlot;
            const int encoded_rank = decode_dispatch_source_rank(
                encoded, shard_capacity);
            const std::int32_t shard_slot = decode_dispatch_local_index(
                encoded, shard_capacity);
            if (encoded_rank != world_rank || shard_slot < 0 ||
                (token_slots[destination_rank] >= 0 &&
                 token_slots[destination_rank] != shard_slot))
                return DispatchProtocolError::kInvalidCachedSlot;
            token_slots[destination_rank] = shard_slot;
        }

        for (int destination_rank = 0;
             destination_rank < world_size; ++destination_rank) {
            if (!selected_destinations[destination_rank])
                continue;
            if (!cached) {
                ++destination_counts[destination_rank];
                continue;
            }
            const std::int32_t shard_slot = token_slots[destination_rank];
            if (shard_slot < 0)
                return DispatchProtocolError::kInvalidCachedSlot;
            for (std::uint64_t previous = 0; previous < token; ++previous) {
                std::int32_t previous_slot = -1;
                for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                    const std::int64_t expert =
                        topk_indices[previous * num_topk + lane];
                    if (expert < 0)
                        continue;
                    const int previous_destination = static_cast<int>(
                        static_cast<std::uint64_t>(expert) /
                        num_local_experts);
                    if (previous_destination == destination_rank) {
                        previous_slot = decode_dispatch_local_index(
                            destination_slots[previous * num_topk + lane],
                            shard_capacity);
                        break;
                    }
                }
                if (previous_slot == shard_slot)
                    return DispatchProtocolError::kInvalidCachedSlot;
            }
            ++destination_counts[destination_rank];
            const std::uint64_t slot =
                static_cast<std::uint64_t>(shard_slot);
            if (maximum_slots[destination_rank] < slot + 1)
                maximum_slots[destination_rank] = slot + 1;
        }
    }

    for (int destination_rank = 0;
         destination_rank < world_size; ++destination_rank) {
        if (destination_counts[destination_rank] > shard_capacity ||
            (cached && maximum_slots[destination_rank] !=
                           destination_counts[destination_rank]))
            return cached ? DispatchProtocolError::kInvalidCachedSlot :
                            DispatchProtocolError::kCapacityOverflow;
    }
    return DispatchProtocolError::kNone;
}

__simt_vf__ inline void dispatch_producer_vf(
    __gm__ const std::uint8_t* x,
    __gm__ const std::uint8_t* scale_factors,
    __gm__ const std::int64_t* topk_indices,
    __gm__ const float* topk_weights,
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ std::int32_t* destination_slots,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t timeout_cycles, std::uint64_t num_tokens,
    std::uint64_t num_experts, std::uint64_t num_topk,
    std::uint64_t shard_capacity,
    std::uint64_t dispatch_control_offset,
    std::uint64_t dispatch_control_bytes,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_receive_shard_count,
    std::uint64_t dispatch_receive_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t dispatch_staging_shard_count,
    std::uint64_t dispatch_staging_bytes,
    std::uint64_t hybrid_dispatch_ingress_control_offset,
    std::uint64_t hybrid_dispatch_ingress_control_bytes,
    std::uint64_t hybrid_dispatch_ingress_shard_offset,
    std::uint64_t hybrid_dispatch_ingress_shard_bytes,
    std::uint64_t hybrid_dispatch_ingress_shard_count,
    std::uint64_t hybrid_dispatch_ingress_bytes,
    std::uint64_t workspace_scratch_status_offset,
    std::uint64_t workspace_scratch_local_count_offset,
    std::uint64_t workspace_scratch_rank_counts_offset,
    std::uint64_t workspace_scratch_rank_values_offset,
    std::uint64_t workspace_scratch_rank_indices_offset,
    std::uint64_t workspace_scratch_rank_flags_offset,
    std::uint64_t workspace_scratch_rank_count,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes,
    std::uint64_t token_scale_factor_offset,
    std::uint64_t token_scale_factor_bytes,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_topk_weight_offset,
    std::uint64_t token_source_metadata_offset) {
    if (threadIdx.x != 0)
        return;

    transport::DeviceTransportContext context{};
    context.abi_version = transport_abi_version;
    context.struct_size = transport_struct_size;
    context.capabilities = transport_capabilities;
    context.topology.abi_version = transport_topology_abi_version;
    context.topology.struct_size = transport_topology_struct_size;
    context.topology.world_rank = transport_world_rank;
    context.topology.world_size = transport_world_size;
    context.topology.scale_up_rank = transport_scale_up_rank;
    context.topology.scale_up_size = transport_scale_up_size;
    context.topology.scale_out_rank = transport_scale_out_rank;
    context.topology.scale_out_size = transport_scale_out_size;
    context.topology.scale_up_direct = transport_scale_up_direct != 0;
    context.topology.kind = static_cast<transport::TransportTopologyKind>(
        transport_topology_kind);
    context.topology.epoch = transport_topology_epoch;
    context.local_window_base = transport_local_window_base;
    context.channel_table = transport_channel_table;
    context.peer_address_table = transport_peer_address_table;
    context.backend_context = transport_backend_context;
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address =
        reinterpret_cast<transport::DeviceAddress>(
            workspace + workspace_scratch_status_offset);
    const auto local_count_address =
        reinterpret_cast<transport::DeviceAddress>(
            workspace + workspace_scratch_local_count_offset);
    transport.store_release(status_address, 0);
    transport.store_release(local_count_address, 0);

    const bool hybrid =
        (mode_flags &
         (CoreModeFlags{1} <<
          static_cast<std::uint8_t>(CoreMode::kHybrid))) != 0;

    if (!transport::device::detail::valid_topology(context.topology) ||
        workspace_scratch_rank_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        (transport_world_size > 1 &&
        (dispatch_control_bytes <
             static_cast<std::uint64_t>(transport_world_size) *
                 sizeof(DispatchControlSlot) ||
         dispatch_receive_shard_count !=
             static_cast<std::uint64_t>(transport_world_size) ||
         dispatch_staging_shard_count !=
             static_cast<std::uint64_t>(transport_world_size) ||
         dispatch_receive_bytes <
             dispatch_receive_shard_count * dispatch_receive_shard_bytes ||
         dispatch_staging_bytes <
             dispatch_staging_shard_count * dispatch_staging_shard_bytes ||
         shard_capacity * token_stride_bytes >
             dispatch_receive_shard_bytes ||
         shard_capacity * token_stride_bytes >
             dispatch_staging_shard_bytes ||
         (hybrid &&
          (hybrid_dispatch_ingress_control_bytes <
               static_cast<std::uint64_t>(transport_world_size) *
                   sizeof(DispatchControlSlot) ||
           hybrid_dispatch_ingress_shard_count !=
               static_cast<std::uint64_t>(transport_world_size) ||
           hybrid_dispatch_ingress_bytes <
               hybrid_dispatch_ingress_shard_count *
                   hybrid_dispatch_ingress_shard_bytes ||
           shard_capacity * token_stride_bytes >
               hybrid_dispatch_ingress_shard_bytes)))))
        return record_dispatch_protocol_error(
            context, status_address, transport_world_rank,
            DispatchProtocolStage::kProducer, generation,
            DispatchProtocolError::kInvalidLayout);

    const bool cached = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const std::uint64_t num_local_experts =
        num_experts / static_cast<std::uint64_t>(transport_world_size);
    auto* destination_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_scratch_rank_counts_offset);
    auto* rank_values = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_scratch_rank_values_offset);
    auto* rank_indices = reinterpret_cast<__gm__ std::int32_t*>(
        workspace + workspace_scratch_rank_indices_offset);
    auto* rank_flags = reinterpret_cast<__gm__ std::uint8_t*>(
        workspace + workspace_scratch_rank_flags_offset);
    const auto validation = validate_cached_dispatch_state(
        topk_indices, destination_slots, cached, transport_world_rank,
        transport_world_size,
        num_tokens, num_experts, num_topk, shard_capacity,
        destination_counts, rank_values, rank_flags, rank_indices);
    if (validation != DispatchProtocolError::kNone)
        return record_dispatch_protocol_error(
            context, status_address, transport_world_rank,
            DispatchProtocolStage::kProducer, generation, validation);

    if (!cached) {
        for (std::uint64_t token = 0; token < num_tokens; ++token) {
            for (std::uint64_t lane = 0; lane < num_topk; ++lane)
                destination_slots[token * num_topk + lane] = -1;
        }
    }
    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank)
        rank_values[destination_rank] = 0;
    auto* ingress_control_slots =
        reinterpret_cast<__gm__ DispatchControlSlot*>(
            transport_local_window_base +
            hybrid_dispatch_ingress_control_offset);
    if (hybrid) {
        for (int ingress_rank = 0;
             ingress_rank < transport_world_size; ++ingress_rank)
            ingress_control_slots[ingress_rank].count = 0;
    }

    for (std::uint64_t token = 0; token < num_tokens; ++token) {
        for (int destination_rank = 0;
             destination_rank < transport_world_size; ++destination_rank) {
            rank_flags[destination_rank] = 0;
            rank_indices[destination_rank] = -1;
        }

        for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
            const std::int64_t expert =
                topk_indices[token * num_topk + lane];
            if (expert < 0)
                continue;
            const int destination_rank = static_cast<int>(
                static_cast<std::uint64_t>(expert) / num_local_experts);
            rank_flags[destination_rank] = 1;
            if (!cached)
                continue;
            const std::int32_t encoded =
                destination_slots[token * num_topk + lane];
            const std::int32_t shard_slot = decode_dispatch_local_index(
                encoded, shard_capacity);
            rank_indices[destination_rank] = shard_slot;
        }

        for (int destination_rank = 0;
             destination_rank < transport_world_size; ++destination_rank) {
            if (rank_flags[destination_rank] == 0)
                continue;
            const auto world_route = classify_world_route(
                transport_world_rank, destination_rank,
                transport_scale_up_size);
            const bool diagonal = hybrid &&
                world_route.kind == WorldRouteKind::kDiagonal;
            const std::uint64_t shard_slot = cached ?
                static_cast<std::uint64_t>(rank_indices[destination_rank]) :
                (diagonal ?
                     ingress_control_slots[
                         world_route.ingress_world_rank].count++ :
                     rank_values[destination_rank]++);
            if (cached && diagonal)
                ++ingress_control_slots[
                    world_route.ingress_world_rank].count;

            __gm__ std::uint8_t* shard = nullptr;
            if (transport_world_size == 1) {
                shard = communication_buffer;
            } else if (diagonal) {
                shard = reinterpret_cast<__gm__ std::uint8_t*>(
                    transport_local_window_base +
                    hybrid_dispatch_ingress_shard_offset +
                    static_cast<std::uint64_t>(
                        world_route.ingress_world_rank) *
                        hybrid_dispatch_ingress_shard_bytes);
            } else if (destination_rank == transport_world_rank) {
                shard = reinterpret_cast<__gm__ std::uint8_t*>(
                    transport_local_window_base + dispatch_receive_offset +
                    static_cast<std::uint64_t>(transport_world_rank) *
                        dispatch_receive_shard_bytes);
            } else {
                shard = reinterpret_cast<__gm__ std::uint8_t*>(
                    transport_local_window_base + dispatch_staging_offset +
                    static_cast<std::uint64_t>(destination_rank) *
                        dispatch_staging_shard_bytes);
            }
            __gm__ std::uint8_t* record =
                shard + shard_slot * token_stride_bytes;
            for (std::uint64_t byte = 0; byte < token_hidden_bytes; ++byte)
                record[token_hidden_offset + byte] =
                    x[token * token_hidden_bytes + byte];
            for (std::uint64_t byte = 0;
                 byte < token_scale_factor_bytes; ++byte) {
                record[token_scale_factor_offset + byte] =
                    scale_factors == nullptr ? 0 :
                    scale_factors[
                        token * token_scale_factor_bytes + byte];
            }
            auto record_topk = reinterpret_cast<__gm__ std::int64_t*>(
                record + token_topk_index_offset);
            auto record_weights = reinterpret_cast<__gm__ float*>(
                record + token_topk_weight_offset);
            auto record_metadata = reinterpret_cast<__gm__ std::int32_t*>(
                record + token_source_metadata_offset);
            std::int32_t master_lane = -1;
            for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                const std::int64_t expert =
                    topk_indices[token * num_topk + lane];
                record_topk[lane] = expert;
                record_weights[lane] = topk_weights == nullptr ? 0.0F :
                    topk_weights[token * num_topk + lane];
                record_metadata[2 + lane] = -1;
                if (expert < 0)
                    continue;
                const int lane_destination = static_cast<int>(
                    static_cast<std::uint64_t>(expert) /
                    num_local_experts);
                if (lane_destination != destination_rank)
                    continue;
                if (master_lane < 0)
                    master_lane = static_cast<std::int32_t>(lane);
                if (!cached) {
                    destination_slots[token * num_topk + lane] =
                        encode_dispatch_source_index(
                            static_cast<std::uint64_t>(transport_world_rank),
                            shard_capacity, shard_slot);
                }
            }
            record_metadata[0] = static_cast<std::int32_t>(token);
            record_metadata[1] = master_lane;
        }
    }

    if (transport_world_size == 1) {
        transport.store_release(local_count_address, destination_counts[0]);
        return;
    }

    auto* control_slots = reinterpret_cast<__gm__ DispatchControlSlot*>(
        transport_local_window_base + dispatch_control_offset);

    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        const auto world_route = classify_world_route(
            transport_world_rank, destination_rank, transport_scale_up_size);
        if (hybrid && world_route.kind == WorldRouteKind::kDiagonal)
            continue;
        const std::uint64_t count = destination_counts[destination_rank];
        if (destination_rank == transport_world_rank) {
            const auto count_address =
                reinterpret_cast<transport::DeviceAddress>(
                    &control_slots[transport_world_rank].count);
            const auto generation_address =
                reinterpret_cast<transport::DeviceAddress>(
                    &control_slots[transport_world_rank].generation);
            transport.store_release(count_address, count);
            transport.store_release(generation_address, generation);
            continue;
        }

        transport::TeamPeer route{};
        if (!transport::device::detail::checked_device_team_peer_for_world_rank(
                context.topology, destination_rank, &route))
            return record_dispatch_protocol_error(
                context, status_address, destination_rank,
                DispatchProtocolStage::kProducer, generation,
                DispatchProtocolError::kInvalidControl);

        if (count != 0) {
            const auto source = static_cast<transport::DeviceAddress>(
                transport_local_window_base + dispatch_staging_offset +
                static_cast<std::uint64_t>(destination_rank) *
                    dispatch_staging_shard_bytes);
            const auto destination = static_cast<transport::DeviceAddress>(
                transport_local_window_base + dispatch_receive_offset +
                static_cast<std::uint64_t>(transport_world_rank) *
                    dispatch_receive_shard_bytes);
            transport.put(
                route.team, route.peer,
                destination, source, count * token_stride_bytes,
                transport::CooperationScope::kParticipant,
                transport::MemorySegment::kDevice,
                transport::kDefaultOptions,
                transport::RemoteAction::none());
        }
        release_protocol::flush_payload(transport);
        const auto remote_count = static_cast<transport::DeviceAddress>(
            transport_local_window_base + dispatch_control_offset +
            static_cast<std::uint64_t>(transport_world_rank) *
                sizeof(DispatchControlSlot) + sizeof(std::uint64_t));
        const auto remote_generation =
            static_cast<transport::DeviceAddress>(
                transport_local_window_base + dispatch_control_offset +
            static_cast<std::uint64_t>(transport_world_rank) *
                    sizeof(DispatchControlSlot));
        release_protocol::publish_control_and_release(
            transport, route, remote_count, count, remote_generation,
            generation, transport::sync_layout::kDispatchReleaseSignalIndex);
    }
    if (hybrid) {
        for (int destination_domain = 0;
             destination_domain < transport_scale_out_size;
             ++destination_domain) {
            if (destination_domain == transport_scale_out_rank)
                continue;
            const int ingress_rank =
                destination_domain * transport_scale_up_size +
                transport_scale_up_rank;
            const std::uint64_t count =
                ingress_control_slots[ingress_rank].count;
            transport::TeamPeer route{
                transport::TransportTeam::kScaleOut,
                destination_domain, ingress_rank};
            release_protocol::put_staged_payload(
                transport, route,
                transport_local_window_base +
                    hybrid_dispatch_ingress_shard_offset +
                    static_cast<std::uint64_t>(transport_world_rank) *
                        hybrid_dispatch_ingress_shard_bytes,
                transport_local_window_base +
                    hybrid_dispatch_ingress_shard_offset +
                    static_cast<std::uint64_t>(ingress_rank) *
                        hybrid_dispatch_ingress_shard_bytes,
                count * token_stride_bytes);
            release_protocol::flush_payload(transport);
            const auto remote_slot =
                transport_local_window_base +
                hybrid_dispatch_ingress_control_offset +
                static_cast<std::uint64_t>(transport_world_rank) *
                    sizeof(DispatchControlSlot);
            release_protocol::publish_control_and_release(
                transport, route, remote_slot + sizeof(std::uint64_t), count,
                remote_slot, generation,
                transport::sync_layout::kDispatchReleaseSignalIndex);
        }
    }
    const auto barrier_workspace =
        reinterpret_cast<transport::DeviceAddress>(
            &control_slots[transport_world_rank].generation);
    transport.device_barrier(
        transport::kWorldTeamMask, barrier_workspace, timeout_cycles);
}

DEEP_EP_ASCEND_SIMT_CALLEE transport::DeviceTransportContext
make_hybrid_dispatch_context(
    std::uint32_t abi_version, std::uint32_t struct_size,
    std::uint64_t capabilities, std::uintptr_t local_window_base,
    std::uintptr_t channel_table, std::uintptr_t peer_address_table,
    std::uint32_t topology_abi_version,
    std::uint32_t topology_struct_size,
    int world_rank, int world_size, int scale_up_rank, int scale_up_size,
    int scale_out_rank, int scale_out_size,
    std::uint32_t scale_up_direct, std::uint32_t topology_kind,
    std::uint64_t topology_epoch, std::uintptr_t backend_context) {
    transport::DeviceTransportContext result{};
    result.abi_version = abi_version;
    result.struct_size = struct_size;
    result.capabilities = capabilities;
    result.topology.abi_version = topology_abi_version;
    result.topology.struct_size = topology_struct_size;
    result.topology.world_rank = world_rank;
    result.topology.world_size = world_size;
    result.topology.scale_up_rank = scale_up_rank;
    result.topology.scale_up_size = scale_up_size;
    result.topology.scale_out_rank = scale_out_rank;
    result.topology.scale_out_size = scale_out_size;
    result.topology.scale_up_direct = scale_up_direct != 0;
    result.topology.kind =
        static_cast<transport::TransportTopologyKind>(topology_kind);
    result.topology.epoch = topology_epoch;
    result.local_window_base = local_window_base;
    result.channel_table = channel_table;
    result.peer_address_table = peer_address_table;
    result.backend_context = backend_context;
    return result;
}

__simt_vf__ inline void hybrid_dispatch_forward_vf(
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t num_experts, std::uint64_t shard_capacity,
    std::uint64_t ingress_control_offset,
    std::uint64_t ingress_shard_offset,
    std::uint64_t ingress_shard_bytes,
    std::uint64_t forward_control_offset,
    std::uint64_t forward_shard_offset,
    std::uint64_t forward_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_source_metadata_offset) {
    if (threadIdx.x != 0)
        return;
    const auto context = make_hybrid_dispatch_context(
        transport_abi_version, transport_struct_size, transport_capabilities,
        transport_local_window_base, transport_channel_table,
        transport_peer_address_table, transport_topology_abi_version,
        transport_topology_struct_size, transport_world_rank,
        transport_world_size, transport_scale_up_rank,
        transport_scale_up_size, transport_scale_out_rank,
        transport_scale_out_size, transport_scale_up_direct,
        transport_topology_kind, transport_topology_epoch,
        transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    auto* ingress_control = reinterpret_cast<__gm__ DispatchControlSlot*>(
        transport_local_window_base + ingress_control_offset);
    const std::uint64_t num_local_experts =
        num_experts / static_cast<std::uint64_t>(transport_world_size);
    for (int origin_rank = 0; origin_rank < transport_world_size;
         ++origin_rank) {
        if (origin_rank == transport_world_rank ||
            origin_rank % transport_scale_up_size != transport_scale_up_rank)
            continue;
        const std::uint64_t observed_generation =
            transport.load_acquire(reinterpret_cast<transport::DeviceAddress>(
                &ingress_control[origin_rank].generation));
        const std::uint64_t input_count =
            transport.load_acquire(reinterpret_cast<transport::DeviceAddress>(
                &ingress_control[origin_rank].count));
        if (observed_generation != generation || input_count > shard_capacity)
            return record_dispatch_protocol_error(
                context, status_address, origin_rank,
                DispatchProtocolStage::kForward, generation,
                observed_generation != generation ?
                    DispatchProtocolError::kInvalidControl :
                    DispatchProtocolError::kCapacityOverflow);
        auto* input_shard = reinterpret_cast<__gm__ std::uint8_t*>(
            transport_local_window_base + ingress_shard_offset +
            static_cast<std::uint64_t>(origin_rank) * ingress_shard_bytes);
        auto* output_shard = reinterpret_cast<__gm__ std::uint8_t*>(
            transport_local_window_base + forward_shard_offset +
            static_cast<std::uint64_t>(origin_rank) * forward_shard_bytes);
        for (int destination_rank =
                 transport_scale_out_rank * transport_scale_up_size;
             destination_rank <
                 (transport_scale_out_rank + 1) * transport_scale_up_size;
             ++destination_rank) {
            if (destination_rank == transport_world_rank)
                continue;
            std::uint64_t output_count = 0;
            for (std::uint64_t input_slot = 0;
                 input_slot < input_count; ++input_slot) {
                auto* input = input_shard + input_slot * token_stride_bytes;
                auto* metadata = reinterpret_cast<__gm__ std::int32_t*>(
                    input + token_source_metadata_offset);
                auto* topk = reinterpret_cast<__gm__ const std::int64_t*>(
                    input + token_topk_index_offset);
                const std::int32_t master_lane = metadata[1];
                const int record_destination = static_cast<int>(
                    static_cast<std::uint64_t>(topk[master_lane]) /
                    num_local_experts);
                if (record_destination != destination_rank)
                    continue;
                auto* output = output_shard +
                    output_count * token_stride_bytes;
                for (std::uint64_t byte = 0; byte < token_stride_bytes; ++byte)
                    output[byte] = input[byte];
                auto* output_metadata =
                    reinterpret_cast<__gm__ std::int32_t*>(
                        output + token_source_metadata_offset);
                output_metadata[2 + master_lane] = static_cast<std::int32_t>(
                    static_cast<std::uint64_t>(origin_rank) * shard_capacity +
                    input_slot);
                ++output_count;
            }
            transport.system_fence();
            transport::TeamPeer route{
                transport::TransportTeam::kScaleUp,
                destination_rank % transport_scale_up_size,
                destination_rank};
            if (output_count != 0) {
                transport.put(
                    transport::TransportTeam::kScaleUp, route.peer,
                    transport_local_window_base + forward_shard_offset +
                        static_cast<std::uint64_t>(origin_rank) *
                            forward_shard_bytes,
                    reinterpret_cast<transport::DeviceAddress>(output_shard),
                    output_count * token_stride_bytes,
                    transport::CooperationScope::kParticipant,
                    transport::MemorySegment::kDevice,
                    transport::kDefaultOptions,
                    transport::RemoteAction::none());
            }
            release_protocol::flush_payload(transport);
            const auto remote_slot = transport_local_window_base +
                forward_control_offset +
                static_cast<std::uint64_t>(origin_rank) *
                    sizeof(DispatchControlSlot);
            release_protocol::publish_control_and_release(
                transport, route, remote_slot + sizeof(std::uint64_t),
                output_count, remote_slot, generation,
                transport::sync_layout::kDispatchReleaseSignalIndex);
        }
    }
    transport.device_barrier(
        transport::kWorldTeamMask,
        reinterpret_cast<transport::DeviceAddress>(
            &ingress_control[transport_world_rank].generation),
        timeout_cycles);
}

__simt_vf__ inline void hybrid_dispatch_prepare_epilogue_vf(
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t shard_capacity,
    std::uint64_t dispatch_control_offset,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t forward_control_offset,
    std::uint64_t forward_shard_offset,
    std::uint64_t forward_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t token_stride_bytes) {
    if (threadIdx.x != 0)
        return;
    const auto context = make_hybrid_dispatch_context(
        transport_abi_version, transport_struct_size, transport_capabilities,
        transport_local_window_base, transport_channel_table,
        transport_peer_address_table, transport_topology_abi_version,
        transport_topology_struct_size, transport_world_rank,
        transport_world_size, transport_scale_up_rank,
        transport_scale_up_size, transport_scale_out_rank,
        transport_scale_out_size, transport_scale_up_direct,
        transport_topology_kind, transport_topology_epoch,
        transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    auto* direct_control = reinterpret_cast<__gm__ DispatchControlSlot*>(
        transport_local_window_base + dispatch_control_offset);
    auto* forward_control = reinterpret_cast<__gm__ DispatchControlSlot*>(
        transport_local_window_base + forward_control_offset);
    for (int origin_rank = 0; origin_rank < transport_world_size;
         ++origin_rank) {
        const auto route = classify_world_route(
            origin_rank, transport_world_rank, transport_scale_up_size);
        if (route.kind != WorldRouteKind::kDiagonal)
            continue;
        const auto release_boundary = dispatch_prepare_release_boundary(
            origin_rank, transport_world_rank, transport_scale_up_size);
        const auto observation = release_protocol::observe_release_control(
            transport, context.topology, release_boundary,
            transport_world_rank, forward_control,
            transport::sync_layout::kDispatchReleaseSignalIndex,
            generation, timeout_cycles);
        if (!observation.acquired)
            return record_dispatch_protocol_error(
                context, status_address, origin_rank,
                DispatchProtocolStage::kPrepareEpilogue, generation,
                DispatchProtocolError::kInvalidControl);
        const std::uint64_t observed_generation = observation.generation;
        const std::uint64_t count = observation.count;
        const auto validation = validate_hybrid_route_control(
            generation, observed_generation, count, shard_capacity);
        if (validation != DispatchProtocolError::kNone)
            return record_dispatch_protocol_error(
                context, status_address, origin_rank,
                DispatchProtocolStage::kPrepareEpilogue, generation,
                validation);
        auto* source = reinterpret_cast<__gm__ const std::uint8_t*>(
            transport_local_window_base + forward_shard_offset +
            static_cast<std::uint64_t>(origin_rank) * forward_shard_bytes);
        auto* destination = reinterpret_cast<__gm__ std::uint8_t*>(
            transport_local_window_base + dispatch_receive_offset +
            static_cast<std::uint64_t>(origin_rank) *
                dispatch_receive_shard_bytes);
        for (std::uint64_t byte = 0; byte < count * token_stride_bytes; ++byte)
            destination[byte] = source[byte];
        release_protocol::publish_local_control(
            transport,
            reinterpret_cast<transport::DeviceAddress>(
                &direct_control[origin_rank].count),
            count,
            reinterpret_cast<transport::DeviceAddress>(
                &direct_control[origin_rank].generation),
            generation);
    }
}

__simt_vf__ inline void hybrid_dispatch_record_routes_vf(
    __gm__ std::uint8_t* workspace,
    __gm__ HybridRouteRecord* route_records,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_backend_context,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_size, std::uint64_t topology_epoch,
    std::uint64_t generation, std::uint64_t num_experts,
    std::uint64_t shard_capacity, std::uint64_t route_record_capacity,
    std::uint64_t dispatch_control_offset,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_source_metadata_offset) {
    if (threadIdx.x != 0)
        return;
    transport::DeviceTransportContext context{};
    context.abi_version = transport::kDeviceTransportAbiVersion;
    context.struct_size = sizeof(transport::DeviceTransportContext);
    context.backend_context = transport_backend_context;
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    auto* control = reinterpret_cast<__gm__ const DispatchControlSlot*>(
        transport_local_window_base + dispatch_control_offset);
    const std::uint64_t local_experts =
        num_experts / static_cast<std::uint64_t>(transport_world_size);
    std::uint64_t total_records = 0;
    for (int origin_rank = 0; origin_rank < transport_world_size;
         ++origin_rank) {
        const std::uint64_t observed_generation = transport.load_acquire(
            reinterpret_cast<transport::DeviceAddress>(
                &control[origin_rank].generation));
        const std::uint64_t count = transport.load_acquire(
            reinterpret_cast<transport::DeviceAddress>(
                &control[origin_rank].count));
        const auto validation = validate_hybrid_route_control(
            generation, observed_generation, count, shard_capacity);
        if (validation != DispatchProtocolError::kNone)
            return record_dispatch_protocol_error(
                context, status_address, origin_rank,
                DispatchProtocolStage::kRouteRecord, generation, validation);
        if (count > route_record_capacity - total_records)
            return record_dispatch_protocol_error(
                context, status_address, origin_rank,
                DispatchProtocolStage::kRouteRecord, generation,
                DispatchProtocolError::kCapacityOverflow);
        total_records += count;
    }

    std::uint64_t output = 0;
    for (int origin_rank = 0; origin_rank < transport_world_size;
         ++origin_rank) {
        auto* shard = reinterpret_cast<__gm__ const std::uint8_t*>(
            transport_local_window_base + dispatch_receive_offset +
            static_cast<std::uint64_t>(origin_rank) *
                dispatch_receive_shard_bytes);
        for (std::uint64_t slot = 0; slot < control[origin_rank].count;
             ++slot) {
            auto* record = shard + slot * token_stride_bytes;
            auto* metadata = reinterpret_cast<__gm__ const std::int32_t*>(
                record + token_source_metadata_offset);
            auto* topk = reinterpret_cast<__gm__ const std::int64_t*>(
                record + token_topk_index_offset);
            const std::int32_t master_lane = metadata[1];
            const auto route = classify_world_route(
                origin_rank, transport_world_rank, transport_scale_up_size);
            const bool diagonal = route.kind == WorldRouteKind::kDiagonal;
            auto* result = route_records + output++;
            result->origin_world_rank = origin_rank;
            result->destination_world_rank = transport_world_rank;
            result->ingress_world_rank = route.ingress_world_rank;
            result->destination_local_expert = static_cast<std::int32_t>(
                static_cast<std::uint64_t>(topk[master_lane]) % local_experts);
            result->origin_source_row =
                static_cast<std::uint64_t>(metadata[0]);
            result->ingress_slot = diagonal ?
                static_cast<std::uint64_t>(metadata[2 + master_lane]) :
                kInvalidHybridRouteSlot;
            result->forwarded_slot = diagonal ?
                static_cast<std::uint64_t>(origin_rank) * shard_capacity + slot :
                kInvalidHybridRouteSlot;
            result->generation = generation;
            result->topology_epoch = topology_epoch;
            result->stage_flags = kHybridRouteCompleteStageFlags;
            result->reserved = 0;
        }
    }
}

__simt_vf__ inline void dispatch_epilogue_vf(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ std::uint8_t* recv_x,
    __gm__ std::uint8_t* recv_scale_factors,
    __gm__ std::int64_t* recv_topk_indices,
    __gm__ float* recv_topk_weights,
    __gm__ std::int32_t* prefix_per_rank,
    __gm__ std::int32_t* prefix_per_expert,
    __gm__ std::int32_t* unaligned_per_expert,
    __gm__ std::int32_t* source_metadata,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t timeout_cycles,
    std::uint64_t num_tokens, std::uint64_t num_experts,
    std::uint64_t num_topk,
    std::uint64_t expert_alignment, std::uint64_t shard_capacity,
    std::uint64_t dispatch_output_capacity,
    std::uint64_t control_offset,
    std::uint64_t dispatch_control_offset,
    std::uint64_t dispatch_control_bytes,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_receive_shard_count,
    std::uint64_t dispatch_receive_bytes,
    std::uint64_t workspace_scratch_status_offset,
    std::uint64_t workspace_scratch_local_count_offset,
    std::uint64_t workspace_scratch_rank_counts_offset,
    std::uint64_t workspace_scratch_rank_count,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes,
    std::uint64_t token_scale_factor_offset,
    std::uint64_t token_scale_factor_bytes,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_topk_weight_offset,
    std::uint64_t token_source_metadata_offset) {
    if (threadIdx.x != 0)
        return;

    const bool expanded = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    const bool cached = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const bool zero_padding = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kZeroPadding))) != 0;
    const std::uint64_t num_local_experts =
        num_experts / static_cast<std::uint64_t>(transport_world_size);
    const std::uint64_t first_local_expert =
        static_cast<std::uint64_t>(transport_world_rank) *
        num_local_experts;
    auto* source_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_scratch_rank_counts_offset);

    transport::DeviceTransportContext context{};
    context.abi_version = transport_abi_version;
    context.struct_size = transport_struct_size;
    context.capabilities = transport_capabilities;
    context.topology.abi_version = transport_topology_abi_version;
    context.topology.struct_size = transport_topology_struct_size;
    context.topology.world_rank = transport_world_rank;
    context.topology.world_size = transport_world_size;
    context.topology.scale_up_rank = transport_scale_up_rank;
    context.topology.scale_up_size = transport_scale_up_size;
    context.topology.scale_out_rank = transport_scale_out_rank;
    context.topology.scale_out_size = transport_scale_out_size;
    context.topology.scale_up_direct = transport_scale_up_direct != 0;
    context.topology.kind = static_cast<transport::TransportTopologyKind>(
        transport_topology_kind);
    context.topology.epoch = transport_topology_epoch;
    context.local_window_base = transport_local_window_base;
    context.channel_table = transport_channel_table;
    context.peer_address_table = transport_peer_address_table;
    context.backend_context = transport_backend_context;
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address =
        reinterpret_cast<transport::DeviceAddress>(
            workspace + workspace_scratch_status_offset);
    const auto local_count_address =
        reinterpret_cast<transport::DeviceAddress>(
            workspace + workspace_scratch_local_count_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    if (workspace_scratch_rank_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        (transport_world_size > 1 &&
        (dispatch_control_bytes <
             static_cast<std::uint64_t>(transport_world_size) *
                 sizeof(DispatchControlSlot) ||
         dispatch_receive_shard_count !=
             static_cast<std::uint64_t>(transport_world_size) ||
         dispatch_receive_bytes <
             dispatch_receive_shard_count * dispatch_receive_shard_bytes ||
         shard_capacity * token_stride_bytes >
             dispatch_receive_shard_bytes)))
        return record_dispatch_protocol_error(
            context, status_address, transport_world_rank,
            DispatchProtocolError::kInvalidLayout);

    if (transport_world_size == 1) {
        source_counts[0] = transport.load_acquire(local_count_address);
        if (source_counts[0] > shard_capacity)
            return record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolError::kCapacityOverflow);
    } else {
        if (transport.consumed_generation() != generation)
            return record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolError::kInvalidControl);
        auto* control_slots = reinterpret_cast<__gm__ DispatchControlSlot*>(
            transport_local_window_base + dispatch_control_offset);
        for (int source_rank = 0;
             source_rank < transport_world_size; ++source_rank) {
            const auto release_boundary = dispatch_release_boundary(
                source_rank, transport_world_rank,
                transport_scale_up_size);
            const auto observation =
                release_protocol::observe_release_control(
                    transport, context.topology, release_boundary,
                    transport_world_rank, control_slots,
                    transport::sync_layout::kDispatchReleaseSignalIndex,
                    generation, timeout_cycles);
            if (!observation.acquired)
                return record_dispatch_protocol_error(
                    context, status_address, source_rank,
                    DispatchProtocolError::kInvalidControl);
            const std::uint64_t observed_generation = observation.generation;
            const std::uint64_t observed_count = observation.count;
            if (observed_generation != generation ||
                observed_count > shard_capacity) {
                return record_dispatch_protocol_error(
                    context, status_address, source_rank,
                    observed_count > shard_capacity ?
                        DispatchProtocolError::kCapacityOverflow :
                        DispatchProtocolError::kInvalidControl);
            }
            source_counts[source_rank] = observed_count;
        }
    }

    std::uint64_t total_records = 0;
    for (int source_rank = 0;
         source_rank < transport_world_size; ++source_rank) {
        total_records += source_counts[source_rank];
        if (cached && prefix_per_rank[source_rank] !=
                static_cast<std::int32_t>(total_records))
            return record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolError::kInvalidCachedPrefix);
    }

    if (total_records >
            shard_capacity *
                static_cast<std::uint64_t>(transport_world_size) ||
        dispatch_output_capacity >
            static_cast<std::uint64_t>(0x7fffffff))
        return record_dispatch_protocol_error(
            context, status_address, transport_world_rank,
            DispatchProtocolError::kCapacityOverflow);

    // Validate every received record before mutating output tensors.
    std::uint64_t compact_validation_slot = 0;
    for (int source_rank = 0;
         source_rank < transport_world_size; ++source_rank) {
        __gm__ std::uint8_t* source_shard =
            transport_world_size == 1 ? communication_buffer :
            reinterpret_cast<__gm__ std::uint8_t*>(
                transport_local_window_base + dispatch_receive_offset +
                static_cast<std::uint64_t>(source_rank) *
                    dispatch_receive_shard_bytes);
        for (std::uint64_t source_slot = 0;
             source_slot < source_counts[source_rank];
             ++source_slot, ++compact_validation_slot) {
            __gm__ std::uint8_t* record =
                source_shard + source_slot * token_stride_bytes;
            auto record_topk =
                reinterpret_cast<__gm__ const std::int64_t*>(
                    record + token_topk_index_offset);
            auto record_metadata =
                reinterpret_cast<__gm__ const std::int32_t*>(
                    record + token_source_metadata_offset);
            bool has_local_lane = false;
            for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                const std::int64_t expert = record_topk[lane];
                if (expert < -1 ||
                    (expert >= 0 &&
                     static_cast<std::uint64_t>(expert) >= num_experts))
                    return record_dispatch_protocol_error(
                        context, status_address, source_rank,
                        DispatchProtocolError::kInvalidTopk);
                if (expert >= static_cast<std::int64_t>(first_local_expert) &&
                    expert < static_cast<std::int64_t>(
                                  first_local_expert + num_local_experts))
                    has_local_lane = true;
            }
            if (!has_local_lane ||
                !is_dispatch_local_index(record_metadata[0], shard_capacity) ||
                !is_dispatch_local_index(record_metadata[1], num_topk) ||
                record_topk[record_metadata[1]] <
                    static_cast<std::int64_t>(first_local_expert) ||
                record_topk[record_metadata[1]] >=
                    static_cast<std::int64_t>(
                        first_local_expert + num_local_experts))
                return record_dispatch_protocol_error(
                    context, status_address, source_rank,
                    DispatchProtocolError::kInvalidCachedMetadata);
            if (cached) {
                __gm__ const std::int32_t* reusable = source_metadata +
                    compact_validation_slot * (2 + num_topk);
                if (reusable[0] != encode_dispatch_source_index(
                        static_cast<std::uint64_t>(source_rank),
                        shard_capacity,
                        static_cast<std::uint64_t>(record_metadata[0])) ||
                    reusable[1] != encode_dispatch_source_index(
                        static_cast<std::uint64_t>(source_rank), num_topk,
                        static_cast<std::uint64_t>(record_metadata[1])))
                    return record_dispatch_protocol_error(
                        context, status_address, source_rank,
                        DispatchProtocolError::kInvalidCachedMetadata);
            }
        }
    }

    std::int32_t derived_prefix = 0;
    for (std::uint64_t expert = 0; expert < num_experts; ++expert) {
        std::int32_t actual_count = 0;
        const bool expert_is_local =
            is_dispatch_expert_local(
                static_cast<std::int64_t>(expert), first_local_expert,
                num_local_experts);
        if (expert_is_local) {
            for (int source_rank = 0;
                 source_rank < transport_world_size; ++source_rank) {
                __gm__ std::uint8_t* source_shard =
                    transport_world_size == 1 ? communication_buffer :
                    reinterpret_cast<__gm__ std::uint8_t*>(
                        transport_local_window_base +
                        dispatch_receive_offset +
                        static_cast<std::uint64_t>(source_rank) *
                            dispatch_receive_shard_bytes);
                for (std::uint64_t source_slot = 0;
                     source_slot < source_counts[source_rank]; ++source_slot) {
                    auto record_topk =
                        reinterpret_cast<__gm__ const std::int64_t*>(
                            source_shard + source_slot * token_stride_bytes +
                            token_topk_index_offset);
                    for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                        if (record_topk[lane] ==
                            static_cast<std::int64_t>(expert))
                            ++actual_count;
                    }
                }
            }
        }
        const std::int32_t alignment =
            static_cast<std::int32_t>(expert_alignment);
        const std::int32_t aligned_count =
            ((actual_count + alignment - 1) / alignment) * alignment;
        if (cached &&
            (unaligned_per_expert[expert] != actual_count ||
             prefix_per_expert[expert] != derived_prefix))
            return record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolError::kInvalidCachedPrefix);
        derived_prefix += aligned_count;
        if (derived_prefix < 0 ||
            static_cast<std::uint64_t>(derived_prefix) >
                dispatch_output_capacity)
            return record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolError::kCapacityOverflow);
    }
    if (cached && prefix_per_expert[num_experts] != derived_prefix)
        return record_dispatch_protocol_error(
            context, status_address, transport_world_rank,
            DispatchProtocolError::kInvalidCachedPrefix);

    if (cached && expanded) {
        std::uint64_t current_record = 0;
        for (int source_rank = 0;
             source_rank < transport_world_size; ++source_rank) {
            __gm__ std::uint8_t* source_shard =
                transport_world_size == 1 ? communication_buffer :
                reinterpret_cast<__gm__ std::uint8_t*>(
                    transport_local_window_base + dispatch_receive_offset +
                    static_cast<std::uint64_t>(source_rank) *
                        dispatch_receive_shard_bytes);
            for (std::uint64_t source_slot = 0;
                 source_slot < source_counts[source_rank];
                 ++source_slot, ++current_record) {
                auto record_topk =
                    reinterpret_cast<__gm__ const std::int64_t*>(
                        source_shard + source_slot * token_stride_bytes +
                        token_topk_index_offset);
                __gm__ const std::int32_t* reusable = source_metadata +
                    current_record * (2 + num_topk);
                for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                    const std::int64_t expert = record_topk[lane];
                    const std::int32_t destination = reusable[2 + lane];
                    const bool local =
                        expert >= static_cast<std::int64_t>(
                                      first_local_expert) &&
                        expert < static_cast<std::int64_t>(
                                     first_local_expert +
                                     num_local_experts);
                    if (!local) {
                        if (destination != -1)
                            return record_dispatch_protocol_error(
                                context, status_address, source_rank,
                                DispatchProtocolError::kInvalidCachedMetadata);
                        continue;
                    }
                    const std::int32_t begin = prefix_per_expert[expert];
                    const std::int32_t end =
                        begin + unaligned_per_expert[expert];
                    if (destination < begin || destination >= end ||
                        destination < 0 ||
                        static_cast<std::uint64_t>(destination) >=
                            dispatch_output_capacity)
                        return record_dispatch_protocol_error(
                            context, status_address, source_rank,
                            DispatchProtocolError::kInvalidCachedMetadata);
                    for (std::uint64_t previous_record = 0;
                         previous_record <= current_record;
                         ++previous_record) {
                        __gm__ const std::int32_t* previous =
                            source_metadata +
                            previous_record * (2 + num_topk);
                        const std::uint64_t lane_limit =
                            previous_record == current_record ? lane :
                            num_topk;
                        for (std::uint64_t previous_lane = 0;
                             previous_lane < lane_limit; ++previous_lane) {
                            if (previous[2 + previous_lane] == destination)
                                return record_dispatch_protocol_error(
                                    context, status_address, source_rank,
                                    DispatchProtocolError::
                                        kInvalidCachedMetadata);
                        }
                    }
                }
            }
        }
    }

    for (int source_rank = 0;
         source_rank < transport_world_size; ++source_rank) {
        if (!cached)
            prefix_per_rank[source_rank] =
                source_rank == 0 ?
                    static_cast<std::int32_t>(source_counts[0]) :
                    prefix_per_rank[source_rank - 1] +
                        static_cast<std::int32_t>(
                            source_counts[source_rank]);
    }

    if (!cached) {
        for (std::uint64_t expert = 0; expert < num_experts; ++expert) {
            unaligned_per_expert[expert] = 0;
            prefix_per_expert[expert] = 0;
        }
        prefix_per_expert[num_experts] = 0;
        for (int source_rank = 0;
             source_rank < transport_world_size; ++source_rank) {
            __gm__ std::uint8_t* source_shard =
                transport_world_size == 1 ? communication_buffer :
                reinterpret_cast<__gm__ std::uint8_t*>(
                    transport_local_window_base + dispatch_receive_offset +
                    static_cast<std::uint64_t>(source_rank) *
                        dispatch_receive_shard_bytes);
            for (std::uint64_t source_slot = 0;
                 source_slot < source_counts[source_rank]; ++source_slot) {
                __gm__ std::uint8_t* record =
                    source_shard + source_slot * token_stride_bytes;
                auto record_topk =
                    reinterpret_cast<__gm__ const std::int64_t*>(
                        record + token_topk_index_offset);
                for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                    const std::int64_t expert = record_topk[lane];
                    if (!is_dispatch_expert_local(
                            expert, first_local_expert,
                            num_local_experts))
                        continue;
                    ++unaligned_per_expert[expert];
                }
            }
        }
        std::int32_t prefix = 0;
        for (std::uint64_t expert = 0; expert < num_experts; ++expert) {
            prefix_per_expert[expert] = prefix;
            const std::int32_t count = unaligned_per_expert[expert];
            const std::int32_t alignment =
                static_cast<std::int32_t>(expert_alignment);
            prefix += ((count + alignment - 1) / alignment) * alignment;
        }
        prefix_per_expert[num_experts] = prefix;
    }

    if (expanded && zero_padding) {
        const std::int32_t expanded_count = prefix_per_expert[num_experts];
        for (std::int32_t slot = 0; slot < expanded_count; ++slot) {
            for (std::uint64_t byte = 0; byte < token_hidden_bytes; ++byte)
                recv_x[static_cast<std::uint64_t>(slot) *
                           token_hidden_bytes + byte] = 0;
            if (recv_topk_weights != nullptr)
                recv_topk_weights[slot] = 0.0F;
        }
    }

    std::uint64_t compact_slot = 0;
    for (int source_rank = 0;
         source_rank < transport_world_size; ++source_rank) {
        __gm__ std::uint8_t* source_shard =
            transport_world_size == 1 ? communication_buffer :
            reinterpret_cast<__gm__ std::uint8_t*>(
                transport_local_window_base + dispatch_receive_offset +
                static_cast<std::uint64_t>(source_rank) *
                    dispatch_receive_shard_bytes);
        for (std::uint64_t source_slot = 0;
             source_slot < source_counts[source_rank];
             ++source_slot, ++compact_slot) {
            __gm__ std::uint8_t* record =
                source_shard + source_slot * token_stride_bytes;
            auto record_topk =
                reinterpret_cast<__gm__ const std::int64_t*>(
                    record + token_topk_index_offset);
            auto record_weights =
                reinterpret_cast<__gm__ const float*>(
                    record + token_topk_weight_offset);
            auto record_metadata =
                reinterpret_cast<__gm__ const std::int32_t*>(
                    record + token_source_metadata_offset);
            __gm__ std::int32_t* output_metadata = source_metadata +
                compact_slot * (2 + num_topk);

            if (!cached) {
                output_metadata[0] = encode_dispatch_source_index(
                    static_cast<std::uint64_t>(source_rank), shard_capacity,
                    static_cast<std::uint64_t>(record_metadata[0]));
                output_metadata[1] = encode_dispatch_source_index(
                    static_cast<std::uint64_t>(source_rank), num_topk,
                    static_cast<std::uint64_t>(record_metadata[1]));
                for (std::uint64_t lane = 0; lane < num_topk; ++lane)
                    output_metadata[2 + lane] = -1;
            }
            for (std::uint64_t lane = 0; lane < num_topk; ++lane)
                recv_topk_indices[compact_slot * num_topk + lane] =
                    localize_dispatch_expert(
                        record_topk[lane], first_local_expert,
                        num_local_experts);
            if (!expanded) {
                for (std::uint64_t byte = 0;
                     byte < token_hidden_bytes; ++byte)
                    recv_x[compact_slot * token_hidden_bytes + byte] =
                        record[token_hidden_offset + byte];
                if (recv_scale_factors != nullptr) {
                    for (std::uint64_t byte = 0;
                         byte < token_scale_factor_bytes; ++byte)
                        recv_scale_factors[
                            compact_slot * token_scale_factor_bytes + byte] =
                            record[token_scale_factor_offset + byte];
                }
                for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                    if (recv_topk_weights != nullptr)
                        recv_topk_weights[compact_slot * num_topk + lane] =
                            record_weights[lane];
                }
                continue;
            }

            for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                const std::int64_t expert = record_topk[lane];
                if (expert < static_cast<std::int64_t>(first_local_expert) ||
                    expert >= static_cast<std::int64_t>(
                                  first_local_expert + num_local_experts))
                    continue;
                std::int32_t destination = output_metadata[2 + lane];
                if (!cached) {
                    std::int32_t occurrence = 0;
                    for (int prior_rank = 0;
                         prior_rank <= source_rank; ++prior_rank) {
                        __gm__ std::uint8_t* prior_shard =
                            transport_world_size == 1 ? communication_buffer :
                            reinterpret_cast<__gm__ std::uint8_t*>(
                                transport_local_window_base +
                                dispatch_receive_offset +
                                static_cast<std::uint64_t>(prior_rank) *
                                    dispatch_receive_shard_bytes);
                        const std::uint64_t record_limit =
                            prior_rank == source_rank ? source_slot + 1 :
                            source_counts[prior_rank];
                        for (std::uint64_t prior_slot = 0;
                             prior_slot < record_limit; ++prior_slot) {
                            auto prior_topk =
                                reinterpret_cast<__gm__ const std::int64_t*>(
                                    prior_shard +
                                    prior_slot * token_stride_bytes +
                                    token_topk_index_offset);
                            const std::uint64_t lane_limit =
                                prior_rank == source_rank &&
                                prior_slot == source_slot ? lane : num_topk;
                            for (std::uint64_t prior_lane = 0;
                                 prior_lane < lane_limit; ++prior_lane) {
                                if (prior_topk[prior_lane] == expert)
                                    ++occurrence;
                            }
                        }
                    }
                    destination = prefix_per_expert[expert] + occurrence;
                    output_metadata[2 + lane] = destination;
                } else if (destination < prefix_per_expert[expert] ||
                           destination >=
                               prefix_per_expert[expert] +
                                   unaligned_per_expert[expert] ||
                           destination < 0 ||
                           static_cast<std::uint64_t>(destination) >=
                               dispatch_output_capacity) {
                    return record_dispatch_protocol_error(
                        context, status_address, source_rank,
                        DispatchProtocolError::kInvalidCachedMetadata);
                }
                for (std::uint64_t byte = 0;
                     byte < token_hidden_bytes; ++byte)
                    recv_x[static_cast<std::uint64_t>(destination) *
                               token_hidden_bytes + byte] =
                        record[token_hidden_offset + byte];
                if (recv_scale_factors != nullptr) {
                    for (std::uint64_t byte = 0;
                         byte < token_scale_factor_bytes; ++byte)
                        recv_scale_factors[
                            static_cast<std::uint64_t>(destination) *
                                token_scale_factor_bytes + byte] =
                            record[token_scale_factor_offset + byte];
                }
                if (recv_topk_weights != nullptr)
                    recv_topk_weights[destination] = record_weights[lane];
            }
        }
    }

    if (transport_world_size > 1) {
        auto* control = reinterpret_cast<__gm__ SymmetricControlHeader*>(
            transport_local_window_base + control_offset);
        transport.store_release(
            reinterpret_cast<transport::DeviceAddress>(
                &control->dispatch_generation),
            generation);
    }
}

__global__ __vector__ void dispatch_kernel(
    __gm__ const std::uint8_t* x,
    __gm__ const std::uint8_t* scale_factors,
    __gm__ const std::int64_t* topk_indices,
    __gm__ const float* topk_weights,
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ std::int32_t* destination_slots,
    __gm__ std::uint8_t* recv_x,
    __gm__ std::uint8_t* recv_scale_factors,
    __gm__ std::int64_t* recv_topk_indices,
    __gm__ float* recv_topk_weights,
    __gm__ std::int32_t* prefix_per_rank,
    __gm__ std::int32_t* prefix_per_expert,
    __gm__ std::int32_t* unaligned_per_expert,
    __gm__ std::int32_t* source_metadata,
    __gm__ HybridRouteRecord* route_records,
    std::uint64_t route_record_capacity,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    CoreTiling tiling) {
    const bool hybrid =
        (tiling.mode_flags &
         (CoreModeFlags{1} <<
          static_cast<std::uint8_t>(CoreMode::kHybrid))) != 0;
    transport::service::reset(tiling.transport_context, generation);
    asc_vf_call<dispatch_producer_vf>(
        dim3(tiling.launch.num_threads), x, scale_factors, topk_indices,
        topk_weights, communication_buffer, workspace, destination_slots,
        tiling.transport_context.abi_version,
        tiling.transport_context.struct_size,
        tiling.transport_context.capabilities,
        tiling.transport_context.local_window_base,
        tiling.transport_context.channel_table,
        tiling.transport_context.peer_address_table,
        tiling.transport_context.topology.abi_version,
        tiling.transport_context.topology.struct_size,
        tiling.transport_context.topology.world_rank,
        tiling.transport_context.topology.world_size,
        tiling.transport_context.topology.scale_up_rank,
        tiling.transport_context.topology.scale_up_size,
        tiling.transport_context.topology.scale_out_rank,
        tiling.transport_context.topology.scale_out_size,
        static_cast<std::uint32_t>(
            tiling.transport_context.topology.scale_up_direct),
        static_cast<std::uint32_t>(tiling.transport_context.topology.kind),
        tiling.transport_context.topology.epoch,
        tiling.transport_context.backend_context,
        tiling.mode_flags, generation, timeout_cycles,
        tiling.num_tokens, tiling.num_experts, tiling.num_topk,
        tiling.num_max_tokens_per_rank,
        tiling.symmetric_window_layout.dispatch_control_offset,
        tiling.symmetric_window_layout.dispatch_control_bytes,
        tiling.symmetric_window_layout.dispatch_receive_offset,
        tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
        tiling.symmetric_window_layout.dispatch_receive_shard_count,
        tiling.symmetric_window_layout.dispatch_receive_bytes,
        tiling.symmetric_window_layout.dispatch_staging_offset,
        tiling.symmetric_window_layout.dispatch_staging_shard_bytes,
        tiling.symmetric_window_layout.dispatch_staging_shard_count,
        tiling.symmetric_window_layout.dispatch_staging_bytes,
        tiling.symmetric_window_layout.hybrid_dispatch_ingress_control_offset,
        tiling.symmetric_window_layout.hybrid_dispatch_ingress_control_bytes,
        tiling.symmetric_window_layout.hybrid_dispatch_ingress_shard_offset,
        tiling.symmetric_window_layout.hybrid_dispatch_ingress_shard_bytes,
        tiling.symmetric_window_layout.hybrid_dispatch_ingress_shard_count,
        tiling.symmetric_window_layout.hybrid_dispatch_ingress_bytes,
        tiling.workspace_layout.scratch_status_offset,
        tiling.workspace_layout.scratch_local_count_offset,
        tiling.workspace_layout.scratch_rank_counts_offset,
        tiling.workspace_layout.scratch_rank_values_offset,
        tiling.workspace_layout.scratch_rank_indices_offset,
        tiling.workspace_layout.scratch_rank_flags_offset,
        tiling.workspace_layout.scratch_rank_count,
        tiling.token_layout.stride_bytes,
        tiling.token_layout.hidden_offset,
        tiling.token_layout.hidden_bytes,
        tiling.token_layout.scale_factor_offset,
        tiling.token_layout.scale_factor_bytes,
        tiling.token_layout.topk_index_offset,
        tiling.token_layout.topk_weight_offset,
        tiling.token_layout.source_metadata_offset);
    transport::service::execute(tiling.transport_context);
    if (hybrid) {
        transport::service::reset(tiling.transport_context, generation);
        asc_vf_call<hybrid_dispatch_forward_vf>(
            dim3(tiling.launch.num_threads), workspace,
            tiling.transport_context.abi_version,
            tiling.transport_context.struct_size,
            tiling.transport_context.capabilities,
            tiling.transport_context.local_window_base,
            tiling.transport_context.channel_table,
            tiling.transport_context.peer_address_table,
            tiling.transport_context.topology.abi_version,
            tiling.transport_context.topology.struct_size,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.transport_context.topology.scale_up_rank,
            tiling.transport_context.topology.scale_up_size,
            tiling.transport_context.topology.scale_out_rank,
            tiling.transport_context.topology.scale_out_size,
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.scale_up_direct),
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.kind),
            tiling.transport_context.topology.epoch,
            tiling.transport_context.backend_context,
            generation, timeout_cycles, tiling.num_experts,
            tiling.num_max_tokens_per_rank,
            tiling.symmetric_window_layout
                .hybrid_dispatch_ingress_control_offset,
            tiling.symmetric_window_layout
                .hybrid_dispatch_ingress_shard_offset,
            tiling.symmetric_window_layout
                .hybrid_dispatch_ingress_shard_bytes,
            tiling.symmetric_window_layout
                .hybrid_dispatch_forward_control_offset,
            tiling.symmetric_window_layout
                .hybrid_dispatch_forward_shard_offset,
            tiling.symmetric_window_layout
                .hybrid_dispatch_forward_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.token_layout.stride_bytes,
            tiling.token_layout.topk_index_offset,
            tiling.token_layout.source_metadata_offset);
        transport::service::execute(tiling.transport_context);
        asc_vf_call<hybrid_dispatch_prepare_epilogue_vf>(
            dim3(tiling.launch.num_threads), workspace,
            tiling.transport_context.abi_version,
            tiling.transport_context.struct_size,
            tiling.transport_context.capabilities,
            tiling.transport_context.local_window_base,
            tiling.transport_context.channel_table,
            tiling.transport_context.peer_address_table,
            tiling.transport_context.topology.abi_version,
            tiling.transport_context.topology.struct_size,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.transport_context.topology.scale_up_rank,
            tiling.transport_context.topology.scale_up_size,
            tiling.transport_context.topology.scale_out_rank,
            tiling.transport_context.topology.scale_out_size,
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.scale_up_direct),
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.kind),
            tiling.transport_context.topology.epoch,
            tiling.transport_context.backend_context,
            generation, timeout_cycles, tiling.num_max_tokens_per_rank,
            tiling.symmetric_window_layout.dispatch_control_offset,
            tiling.symmetric_window_layout.dispatch_receive_offset,
            tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
            tiling.symmetric_window_layout
                .hybrid_dispatch_forward_control_offset,
            tiling.symmetric_window_layout
                .hybrid_dispatch_forward_shard_offset,
            tiling.symmetric_window_layout
                .hybrid_dispatch_forward_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.token_layout.stride_bytes);
    }
    asc_vf_call<dispatch_epilogue_vf>(
        dim3(tiling.launch.num_threads), communication_buffer, workspace,
        recv_x, recv_scale_factors, recv_topk_indices, recv_topk_weights,
        prefix_per_rank, prefix_per_expert, unaligned_per_expert,
        source_metadata,
        tiling.transport_context.abi_version,
        tiling.transport_context.struct_size,
        tiling.transport_context.capabilities,
        tiling.transport_context.local_window_base,
        tiling.transport_context.channel_table,
        tiling.transport_context.peer_address_table,
        tiling.transport_context.topology.abi_version,
        tiling.transport_context.topology.struct_size,
        tiling.transport_context.topology.world_rank,
        tiling.transport_context.topology.world_size,
        tiling.transport_context.topology.scale_up_rank,
        tiling.transport_context.topology.scale_up_size,
        tiling.transport_context.topology.scale_out_rank,
        tiling.transport_context.topology.scale_out_size,
        static_cast<std::uint32_t>(
            tiling.transport_context.topology.scale_up_direct),
        static_cast<std::uint32_t>(tiling.transport_context.topology.kind),
        tiling.transport_context.topology.epoch,
        tiling.transport_context.backend_context,
        tiling.mode_flags, generation, timeout_cycles, tiling.num_tokens,
        tiling.num_experts, tiling.num_topk, tiling.expert_alignment,
        tiling.num_max_tokens_per_rank, tiling.dispatch_output_capacity,
        tiling.symmetric_window_layout.control_offset,
        tiling.symmetric_window_layout.dispatch_control_offset,
        tiling.symmetric_window_layout.dispatch_control_bytes,
        tiling.symmetric_window_layout.dispatch_receive_offset,
        tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
        tiling.symmetric_window_layout.dispatch_receive_shard_count,
        tiling.symmetric_window_layout.dispatch_receive_bytes,
        tiling.workspace_layout.scratch_status_offset,
        tiling.workspace_layout.scratch_local_count_offset,
        tiling.workspace_layout.scratch_rank_counts_offset,
        tiling.workspace_layout.scratch_rank_count,
        tiling.token_layout.stride_bytes,
        tiling.token_layout.hidden_offset,
        tiling.token_layout.hidden_bytes,
        tiling.token_layout.scale_factor_offset,
        tiling.token_layout.scale_factor_bytes,
        tiling.token_layout.topk_index_offset,
        tiling.token_layout.topk_weight_offset,
        tiling.token_layout.source_metadata_offset);
    if (hybrid) {
        asc_vf_call<hybrid_dispatch_record_routes_vf>(
            dim3(tiling.launch.num_threads), workspace, route_records,
            tiling.transport_context.local_window_base,
            tiling.transport_context.backend_context,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.transport_context.topology.scale_up_size,
            tiling.transport_context.topology.epoch,
            generation, tiling.num_experts,
            tiling.num_max_tokens_per_rank, route_record_capacity,
            tiling.symmetric_window_layout.dispatch_control_offset,
            tiling.symmetric_window_layout.dispatch_receive_offset,
            tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.token_layout.stride_bytes,
            tiling.token_layout.topk_index_offset,
            tiling.token_layout.source_metadata_offset);
    }
}

}  // namespace deep_ep::ascend::elastic

extern "C" int deep_ep_ascend_launch_dispatch(
    deep_ep::ascend::elastic::DispatchArguments arguments,
    deep_ep::ascend::elastic::CoreTiling tiling, void* stream) {
    deep_ep::ascend::elastic::dispatch_kernel<<<
        tiling.launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        static_cast<const std::uint8_t*>(arguments.x),
        static_cast<const std::uint8_t*>(arguments.scale_factors),
        arguments.topk_indices, arguments.topk_weights,
        static_cast<std::uint8_t*>(arguments.communication_buffer),
        static_cast<std::uint8_t*>(arguments.workspace),
        arguments.destination_slots,
        static_cast<std::uint8_t*>(arguments.recv_x),
        static_cast<std::uint8_t*>(arguments.recv_scale_factors),
        arguments.recv_topk_indices, arguments.recv_topk_weights,
        arguments.prefix_per_rank, arguments.prefix_per_expert,
        arguments.unaligned_per_expert, arguments.source_metadata,
        arguments.route_records, arguments.route_record_capacity,
        arguments.generation, arguments.timeout_cycles, tiling);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

extern "C" int deep_ep_ascend_launch_dispatch_epilogue(
    deep_ep::ascend::elastic::DispatchArguments,
    deep_ep::ascend::elastic::CoreTiling, void*) {
    return 0;
}
