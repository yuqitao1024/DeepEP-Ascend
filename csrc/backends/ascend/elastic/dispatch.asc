#define DEEP_EP_ASCEND_DIRECT_DISPATCH_EPILOGUE( \
    COPY_OUTPUTS, STAGE, EARLY_ROUTE_PLAN, PERSISTENT_SOURCE_PIPELINE) \
    do { \
        if ((STAGE) == DirectDispatchStage::kFull || \
            (STAGE) == DirectDispatchStage::kEpilogueAcquire) { \
        (void)0; \
        } \
        if ((STAGE) == DirectDispatchStage::kFull || \
            (STAGE) == DirectDispatchStage::kEpilogueValidate) { \
        (void)0; \
        } \
        if ((STAGE) == DirectDispatchStage::kFull || \
            (STAGE) == DirectDispatchStage::kEpilogueValidateReduce) { \
        (void)0; \
        } \
        if ((EARLY_ROUTE_PLAN) == 0 && \
            ((STAGE) == DirectDispatchStage::kFull || \
             (STAGE) == DirectDispatchStage::kEpilogueExpertCount)) { \
        (void)0; \
        } \
        if ((EARLY_ROUTE_PLAN) == 0 && \
            ((STAGE) == DirectDispatchStage::kFull || \
             (STAGE) == DirectDispatchStage::kEpilogueExpertPrefix)) { \
        if (parallel_prefix != 0) { \
        (void)0; \
        } else { \
        (void)0; \
        } \
        } \
        if ((STAGE) == DirectDispatchStage::kFull || \
            (STAGE) == DirectDispatchStage::kEpilogueMetadata) { \
        if ((COPY_OUTPUTS) != 0) { \
            (void)0; \
            (void)0; \
            (void)0; \
            (void)0; \
        } \
        } \
        if ((COPY_OUTPUTS) != 0 && \
            ((STAGE) == DirectDispatchStage::kFull || \
             (STAGE) == DirectDispatchStage::kEpilogueCopy)) { \
            const auto consumer_copy_plan = dispatch_consumer_copy_plan( \
                tiling.token_layout.hidden_bytes, consumer_tile_bytes, 32); \
            (void)0; \
            if ((STAGE) == DirectDispatchStage::kEpilogueCopy && \
                consumer_copy_plan.vector_bytes != 0) { \
                direct_dispatch_epilogue_vector_payload_select( \
                    communication_buffer, workspace, recv_x, \
                    source_metadata, \
                    tiling.transport_context.local_window_base, \
                    tiling.transport_context.topology.world_size, \
                    (tiling.mode_flags & (CoreModeFlags{1} << \
                        static_cast<std::uint8_t>( \
                            CoreMode::kExpanded))) != 0, \
                    tiling.num_topk, \
                    tiling.num_max_tokens_per_rank, \
                    tiling.symmetric_window_layout \
                        .dispatch_receive_offset, \
                    tiling.symmetric_window_layout \
                        .dispatch_receive_shard_bytes, \
                    tiling.workspace_layout.scratch_status_offset, \
                    tiling.workspace_layout.scratch_rank_counts_offset, \
                    tiling.workspace_layout.scratch_rank_values_offset, \
                    tiling.token_layout.stride_bytes, \
                    tiling.token_layout.hidden_offset, \
                    tiling.token_layout.hidden_bytes, \
                    tiling.token_layout.topk_index_offset, \
                    consumer_tile_bytes); \
            } \
        } \
        if ((COPY_OUTPUTS) != 0 && \
            ((STAGE) == DirectDispatchStage::kFull || \
             (STAGE) == DirectDispatchStage::kEpilogueComplete)) { \
        } \
    } while (0)

template <bool ProfileEnabled>
__aicore__ inline void direct_dispatch_release_chunk_device(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    std::uint64_t generation,
    std::uint64_t timeout_cycles,
    std::uint64_t chunk_begin,
    std::uint64_t chunk_end,
    std::uint32_t chunk_index,
    std::uint32_t final_chunk,
    std::uint32_t source_chunk,
    DirectReleaseSegment release_segment,
    const CoreTiling& tiling) {
    (void)0;
    asc_sync_vec();
    asc_sync_data_barrier(mem_dsb_t::DSB_DDR);
    transport::service::execute<ProfileEnabled>(tiling.transport_context);
}

__aicore__ inline void direct_dispatch_pipeline_fail_aicore(
    __gm__ DispatchPipelineState* pipeline,
    __gm__ DispatchPipelineSlot* slot, __gm__ std::uint8_t* workspace,
    std::uint64_t workspace_status_offset, int world_rank,
    std::uint32_t detail) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    transport::aicore::flush_cacheline(status);
    if (transport::aicore::load_device(status) == 0) {
        const std::uint64_t scratch_status =
            (static_cast<std::uint64_t>(world_rank + 1) << 32U) |
            static_cast<std::uint32_t>(
                DispatchProtocolError::kInvalidControl);
        transport::aicore::store_device(status, scratch_status);
    }
    transport::aicore::store_device(
        reinterpret_cast<__gm__ std::uint32_t*>(
            &pipeline->terminal_error),
        static_cast<std::uint32_t>(
            transport::DeviceTransportError::kCompletionTimeout));
    transport::aicore::store_device(&pipeline->diagnostic_detail, detail);
    transport::aicore::store_device(
        reinterpret_cast<__gm__ std::uint32_t*>(
            &pipeline->producer_worker_state),
        static_cast<std::uint32_t>(
            DispatchPipelineWorkerState::kFailed));
    transport::aicore::store_device(
        reinterpret_cast<__gm__ std::uint32_t*>(
            &pipeline->release_worker_state),
        static_cast<std::uint32_t>(
            DispatchPipelineWorkerState::kFailed));
    if (slot != nullptr)
        transport::aicore::store_device(
            reinterpret_cast<__gm__ std::uint32_t*>(&slot->state),
            static_cast<std::uint32_t>(
                DispatchPipelineSlotState::kFailed));
    transport::aicore::system_fence();
    transport::aicore::flush_cacheline(status);
    transport::aicore::flush_cacheline(
        &pipeline->release_completed_generation);
    if (slot != nullptr)
        transport::aicore::flush_cacheline(slot);
}

__aicore__ inline void dispatch_aicore_poll_nop() {
    transport::aicore::poll_nop();
}

__aicore__ inline void direct_dispatch_pipeline_stage_aicore(
    __gm__ DispatchPipelineState* pipeline,
    DispatchPipelineDiagnosticStage stage, std::uint32_t detail) {
    transport::aicore::store_device(
        reinterpret_cast<__gm__ std::uint32_t*>(
            &pipeline->diagnostic_stage),
        static_cast<std::uint32_t>(stage));
    transport::aicore::store_device(&pipeline->diagnostic_detail, detail);
    transport::aicore::system_fence();
    transport::aicore::flush_cacheline(
        &pipeline->release_completed_generation);
}

__aicore__ inline void direct_dispatch_persistent_producer_device(
    __gm__ const std::uint8_t* x,
    __gm__ const std::uint8_t* scale_factors,
    __gm__ const std::int64_t* topk_indices,
    __gm__ const float* topk_weights,
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ std::int32_t* destination_slots,
    std::uint64_t scale_factor_token_stride,
    std::uint64_t scale_factor_pack_stride,
    std::uint64_t generation,
    std::uint64_t timeout_cycles,
    std::uint32_t source_chunk_tiles,
    std::uint32_t source_chunk_count,
    std::uint32_t token_fanout,
    const CoreTiling& tiling) {
    auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
        workspace + tiling.workspace_layout.dispatch_pipeline_offset);
    const std::uint32_t block_index =
        static_cast<std::uint32_t>(AscendC::GetBlockIdx());
    const std::uint32_t producer_blocks =
        tiling.data_launch.num_blocks;
    if (block_index == 0) {
        transport::aicore::store_device(
            &pipeline->abi_version, kDispatchPipelineAbiVersion);
        transport::aicore::store_device(
            &pipeline->struct_size,
            static_cast<std::uint32_t>(sizeof(DispatchPipelineState)));
        transport::aicore::store_device(
            &pipeline->chunk_count, source_chunk_count);
        transport::aicore::store_device(&pipeline->completed_chunks, 0U);
        transport::aicore::store_device(
            &pipeline->chunk_slots,
            static_cast<std::uint64_t>(source_chunk_tiles));
        transport::aicore::store_device(
            reinterpret_cast<__gm__ std::uint32_t*>(
                &pipeline->terminal_error),
            static_cast<std::uint32_t>(
                transport::DeviceTransportError::kNone));
        transport::aicore::store_device(
            &pipeline->release_completed_generation, std::uint64_t{0});
        transport::aicore::store_device(
            &pipeline->producer_completed_generation, std::uint64_t{0});
        transport::aicore::store_device(
            &pipeline->release_batch_target, 0U);
        transport::aicore::store_device(
            &pipeline->release_batch_consumed, 0U);
        transport::aicore::store_device(
            reinterpret_cast<__gm__ std::uint32_t*>(
                &pipeline->release_worker_state),
            static_cast<std::uint32_t>(
                DispatchPipelineWorkerState::kIdle));
        transport::aicore::store_device(
            reinterpret_cast<__gm__ std::uint32_t*>(
                &pipeline->producer_worker_state),
            static_cast<std::uint32_t>(
                DispatchPipelineWorkerState::kRunning));
        direct_dispatch_pipeline_stage_aicore(
            pipeline, DispatchPipelineDiagnosticStage::kProducerStarted, 0U);
        for (std::uint32_t slot_index = 0;
             slot_index < kDispatchPipelineSlotCount; ++slot_index) {
            auto* slot = &pipeline->slots[slot_index];
            transport::aicore::store_device(
                &slot->chunk_begin, std::uint64_t{0});
            transport::aicore::store_device(
                &slot->chunk_end, std::uint64_t{0});
            transport::aicore::store_device(&slot->chunk_index, 0U);
            transport::aicore::store_device(
                &slot->scalar_blocks_completed, 0U);
            transport::aicore::store_device(
                &slot->hidden_blocks_completed, 0U);
            transport::aicore::store_device(
                &slot->published_chunk, UINT32_MAX);
            transport::aicore::store_device(
                reinterpret_cast<__gm__ std::uint32_t*>(&slot->state),
                static_cast<std::uint32_t>(
                    DispatchPipelineSlotState::kEmpty));
            transport::aicore::flush_cacheline(slot);
        }
        for (std::uint32_t block = 0; block < producer_blocks; ++block) {
            for (std::uint32_t chunk = 0;
                 chunk < kDispatchPipelineMaximumChunks; ++chunk) {
                auto* progress = &pipeline->scalar_progress[block][chunk];
                transport::aicore::store_device(
                    &progress->generation, std::uint64_t{0});
                transport::aicore::store_device(
                    &progress->completed_chunk, UINT32_MAX);
                transport::aicore::flush_cacheline(progress);
            }
            auto* progress = &pipeline->hidden_progress[block];
            transport::aicore::store_device(
                &progress->generation, std::uint64_t{0});
            transport::aicore::store_device(
                &progress->completed_chunk, UINT32_MAX);
            transport::aicore::flush_cacheline(progress);
        }
        transport::aicore::system_fence();
        transport::aicore::flush_cacheline(
            &pipeline->release_completed_generation);
        transport::aicore::store_device(&pipeline->generation, generation);
        transport::aicore::system_fence();
        transport::aicore::flush_cacheline(pipeline);
    } else {
        const std::uint64_t generation_wait_start = __asc_aicore::clock();
        while (true) {
            dispatch_aicore_poll_nop();
            transport::aicore::flush_cacheline(pipeline);
            if (transport::aicore::load_published(&pipeline->generation) ==
                generation)
                break;
            if (dispatch_aicore_pipeline_wait_timed_out(
                    generation_wait_start, __asc_aicore::clock(),
                    timeout_cycles)) {
                direct_dispatch_pipeline_fail_aicore(
                    pipeline, nullptr, workspace,
                    tiling.workspace_layout.scratch_status_offset,
                    tiling.transport_context.topology.world_rank,
                    block_index << 16U);
                return;
            }
        }
    }
    const std::uint64_t vector_hidden_bytes = token_fanout != 0 ?
        tiling.token_layout.hidden_bytes -
            tiling.token_layout.hidden_bytes %
                kDispatchTokenFanoutAlignmentBytes :
        tiling.token_layout.hidden_bytes -
            tiling.token_layout.hidden_bytes %
                kDispatchProducerVectorTileBytes;
    (void)0;

    for (std::uint32_t source_chunk = 0;
         source_chunk < source_chunk_count; ++source_chunk) {
        auto* slot = &pipeline->slots[
            dispatch_aicore_pipeline_slot(source_chunk)];
        const std::uint64_t wait_start = __asc_aicore::clock();
        if (block_index == 0) {
            while (true) {
                dispatch_aicore_poll_nop();
                std::uint32_t scalar_blocks = 0;
                for (std::uint32_t block = 0;
                     block < producer_blocks; ++block) {
                    dispatch_aicore_poll_nop();
                    auto* block_progress =
                        &pipeline->scalar_progress[block][source_chunk];
                    // ReadGmByPassDCache below is a read-only observation. Do
                    // not DCCI the line first: CACHELINE_OUT could write a
                    // stale Scalar cache line over a newer SIMT publication.
                    const auto observed_generation =
                        transport::aicore::load_published(
                            &block_progress->generation);
                    if (observed_generation == generation)
                        ++scalar_blocks;
                }
                if (scalar_blocks == producer_blocks) {
                    transport::aicore::flush_cacheline(slot);
                    transport::aicore::store_device(
                        &slot->scalar_blocks_completed, producer_blocks);
                    transport::aicore::store_device(
                        reinterpret_cast<__gm__ std::uint32_t*>(
                            &slot->state),
                        static_cast<std::uint32_t>(
                            DispatchPipelineSlotState::kScalarReady));
                    direct_dispatch_pipeline_stage_aicore(
                        pipeline,
                        DispatchPipelineDiagnosticStage::kScalarReady,
                        source_chunk);
                    transport::aicore::system_fence();
                    transport::aicore::flush_cacheline(slot);
                    break;
                }
                if (dispatch_aicore_pipeline_wait_timed_out(
                        wait_start, __asc_aicore::clock(), timeout_cycles)) {
                    direct_dispatch_pipeline_fail_aicore(
                        pipeline, slot, workspace,
                        tiling.workspace_layout.scratch_status_offset,
                        tiling.transport_context.topology.world_rank,
                        0xd3ff0000U | scalar_blocks);
                    return;
                }
            }
        } else {
            while (true) {
                dispatch_aicore_poll_nop();
                transport::aicore::flush_cacheline(slot);
                const auto state = static_cast<DispatchPipelineSlotState>(
                    transport::aicore::load_device(
                        reinterpret_cast<__gm__ std::uint32_t*>(
                            &slot->state)));
                const std::uint32_t published_chunk =
                    transport::aicore::load_device(&slot->published_chunk);
                if (state == DispatchPipelineSlotState::kScalarReady &&
                    published_chunk == source_chunk)
                    break;
                if (state == DispatchPipelineSlotState::kFailed)
                    return;
                if (dispatch_aicore_pipeline_wait_timed_out(
                        wait_start, __asc_aicore::clock(), timeout_cycles)) {
                    direct_dispatch_pipeline_fail_aicore(
                        pipeline, slot, workspace,
                        tiling.workspace_layout.scratch_status_offset,
                        tiling.transport_context.topology.world_rank,
                        source_chunk | (block_index << 16U));
                    return;
                }
            }
        }
        const std::uint64_t chunk_begin =
            static_cast<std::uint64_t>(source_chunk) * source_chunk_tiles;
        const std::uint64_t chunk_end =
            chunk_begin + source_chunk_tiles <
                    tiling.workspace_layout.dispatch_group_tile_count ?
                chunk_begin + source_chunk_tiles :
                tiling.workspace_layout.dispatch_group_tile_count;
        if (tiling.token_layout.hidden_bytes >= kDispatchVectorTileBytes) {
            if (token_fanout != 0) {
                direct_dispatch_producer_token_fanout_impl(
                    x, communication_buffer, workspace, destination_slots,
                    tiling.transport_context.local_window_base,
                    tiling.transport_context.topology.world_rank,
                    tiling.transport_context.topology.world_size,
                    tiling.num_tokens, tiling.num_topk,
                    tiling.num_max_tokens_per_rank,
                    tiling.symmetric_window_layout.dispatch_receive_offset,
                    tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
                    tiling.symmetric_window_layout.dispatch_staging_offset,
                    tiling.symmetric_window_layout.dispatch_staging_shard_bytes,
                    tiling.workspace_layout.scratch_status_offset,
                    tiling.workspace_layout.dispatch_group_owner_offset,
                    tiling.workspace_layout.dispatch_group_tile_count,
                    tiling.launch.num_threads, chunk_begin, chunk_end, 1U,
                    tiling.token_layout.stride_bytes,
                    tiling.token_layout.hidden_offset,
                    tiling.token_layout.hidden_bytes);
            } else {
                direct_dispatch_producer_vector_payload_impl(
                    x, communication_buffer, workspace, destination_slots,
                    tiling.transport_context.local_window_base,
                    tiling.transport_context.topology.world_rank,
                    tiling.transport_context.topology.world_size,
                    tiling.num_tokens, tiling.num_topk,
                    tiling.num_max_tokens_per_rank,
                    tiling.symmetric_window_layout.dispatch_receive_offset,
                    tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
                    tiling.symmetric_window_layout.dispatch_staging_offset,
                    tiling.symmetric_window_layout.dispatch_staging_shard_bytes,
                    tiling.workspace_layout.scratch_status_offset,
                    tiling.workspace_layout.dispatch_group_owner_offset,
                    tiling.workspace_layout.dispatch_group_tile_count,
                    tiling.launch.num_threads, chunk_begin, chunk_end, 1U,
                    tiling.token_layout.stride_bytes,
                    tiling.token_layout.hidden_offset,
                    tiling.token_layout.hidden_bytes);
            }
        }
        asc_sync_data_barrier(mem_dsb_t::DSB_DDR);
        auto* progress = &pipeline->hidden_progress[block_index];
        transport::aicore::store_device(
            &progress->completed_chunk, source_chunk);
        transport::aicore::system_fence();
        transport::aicore::store_device(
            &progress->generation, generation);
        transport::aicore::system_fence();
        transport::aicore::flush_cacheline(progress);
        if (block_index == 0) {
            const std::uint64_t hidden_wait_start = __asc_aicore::clock();
            while (true) {
                dispatch_aicore_poll_nop();
                std::uint32_t hidden_blocks = 0;
                for (std::uint32_t block = 0;
                     block < producer_blocks; ++block) {
                    dispatch_aicore_poll_nop();
                    auto* block_progress = &pipeline->hidden_progress[block];
                    transport::aicore::flush_cacheline(block_progress);
                    if (transport::aicore::load_device(
                            &block_progress->generation) == generation &&
                        transport::aicore::load_device(
                            &block_progress->completed_chunk) == source_chunk)
                        ++hidden_blocks;
                }
                if (hidden_blocks == producer_blocks) {
                    transport::aicore::flush_cacheline(slot);
                    transport::aicore::store_device(
                        &slot->hidden_blocks_completed, producer_blocks);
                    direct_dispatch_pipeline_stage_aicore(
                        pipeline,
                        DispatchPipelineDiagnosticStage::
                            kHiddenProgressObserved,
                        source_chunk);
                    transport::aicore::store_device(
                        reinterpret_cast<__gm__ std::uint32_t*>(
                            &slot->state),
                        static_cast<std::uint32_t>(
                            DispatchPipelineSlotState::kReady));
                    direct_dispatch_pipeline_stage_aicore(
                        pipeline,
                        DispatchPipelineDiagnosticStage::kPayloadReady,
                        source_chunk);
                    transport::aicore::system_fence();
                    transport::aicore::flush_cacheline(slot);
                    break;
                }
                if (dispatch_aicore_pipeline_wait_timed_out(
                        hidden_wait_start, __asc_aicore::clock(),
                        timeout_cycles)) {
                    direct_dispatch_pipeline_fail_aicore(
                        pipeline, slot, workspace,
                        tiling.workspace_layout.scratch_status_offset,
                        tiling.transport_context.topology.world_rank,
                        0xd4ff0000U | hidden_blocks);
                    return;
                }
            }
        }
    }
    asc_sync_vec();
}

__aicore__ inline void direct_dispatch_diagnose_persistent_release_service(
    const transport::DeviceTransportContext& context,
    std::uint64_t generation) {
    auto* queue = transport::service::detail::command_queue(context);
    auto* state = transport::service::detail::service_state(queue);
    if (queue == nullptr || state == nullptr)
        return;
    transport::aicore::flush_cacheline(queue);
    transport::aicore::flush_cacheline(state);
    const auto consumed_generation = state->consumed_generation;
    if (consumed_generation == generation)
        return;
    transport::service::detail::record_error(
        queue, transport::DeviceTransportError::kInvalidProtocol,
        queue->count, transport::TransportCommandOpcode::kNone,
        context.topology.world_rank, 0, 0x70000001U,
        consumed_generation);
}

template <bool ProfileEnabled>
__aicore__ inline void direct_dispatch_persistent_release_device(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    std::uint64_t generation,
    std::uint64_t timeout_cycles,
    std::uint32_t release_chunk_tiles,
    std::uint32_t release_chunk_count,
    std::uint32_t producer_blocks,
    const CoreTiling& tiling) {
    auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
        workspace + tiling.workspace_layout.dispatch_pipeline_offset);

    // A VF call blocks its enclosing AICore until the VF returns.  Keep every
    // request completion in a continuation VF so the AICore service can run
    // between command publication and request observation.
    for (std::uint32_t release_chunk = 0;
         release_chunk < release_chunk_count; ++release_chunk) {
        (void)0;

        const std::uint64_t chunk_begin =
            static_cast<std::uint64_t>(release_chunk) * release_chunk_tiles;
        const std::uint64_t chunk_end =
            chunk_begin + release_chunk_tiles <
                    tiling.workspace_layout.dispatch_group_tile_count ?
                chunk_begin + release_chunk_tiles :
                tiling.workspace_layout.dispatch_group_tile_count;
        direct_dispatch_release_chunk_device<ProfileEnabled>(
            communication_buffer, workspace, generation, timeout_cycles,
            chunk_begin, chunk_end, release_chunk,
            release_chunk + 1U == release_chunk_count ? 1U : 0U, 1U,
            DirectReleaseSegment::kPayload, tiling);
        (void)0;
        if (static_cast<DispatchPipelineSlotState>(
                transport::aicore::load_device(
                    reinterpret_cast<__gm__ std::uint32_t*>(
                        &pipeline->slots[release_chunk %
                                         kDispatchPipelineSlotCount].state))) ==
            DispatchPipelineSlotState::kFailed)
        {
            transport::aicore::store_device(
                reinterpret_cast<__gm__ std::uint32_t*>(
                    &pipeline->release_worker_state),
                static_cast<std::uint32_t>(
                    DispatchPipelineWorkerState::kFailed));
            transport::aicore::flush_cacheline(
                &pipeline->release_worker_state);
            return;
        }
    }

    const std::uint64_t final_chunk_begin =
        static_cast<std::uint64_t>(release_chunk_count - 1U) *
        release_chunk_tiles;
    const std::uint64_t final_chunk_end =
        tiling.workspace_layout.dispatch_group_tile_count;
    direct_dispatch_release_chunk_device<ProfileEnabled>(
        communication_buffer, workspace, generation, timeout_cycles,
        final_chunk_begin, final_chunk_end, release_chunk_count - 1U, 1U, 1U,
        DirectReleaseSegment::kControl, tiling);
    direct_dispatch_release_chunk_device<ProfileEnabled>(
        communication_buffer, workspace, generation, timeout_cycles,
        final_chunk_begin, final_chunk_end, release_chunk_count - 1U, 1U, 1U,
        DirectReleaseSegment::kBarrier, tiling);
    (void)0;
    asc_sync_vec();
    asc_sync_data_barrier(mem_dsb_t::DSB_DDR);
}

// Per-AIV dynamic UB layout (byte offsets from UB base):
//   [0, dynamic_ub_bytes) payload scratch
// The same region is reused sequentially by producer payload copy, token
// fanout, and consumer payload copy. No two users have overlapping lifetimes.
// The launch site reserves the maximum of the configured producer and consumer
// requirements; all raw GM<->UB copies use offset 0 explicitly.
struct DispatchKernelArguments {
    __gm__ const std::uint8_t* x;
    __gm__ const std::uint8_t* scale_factors;
    __gm__ const std::int64_t* topk_indices;
    __gm__ const float* topk_weights;
    __gm__ std::uint8_t* communication_buffer;
    __gm__ std::uint8_t* workspace;
    __gm__ std::int32_t* destination_slots;
    __gm__ std::uint8_t* recv_x;
    __gm__ std::uint8_t* recv_scale_factors;
    __gm__ std::int64_t* recv_topk_indices;
    __gm__ float* recv_topk_weights;
    __gm__ std::int32_t* prefix_per_rank;
    __gm__ std::int32_t* prefix_per_expert;
    __gm__ std::int32_t* unaligned_per_expert;
    __gm__ std::int32_t* source_metadata;
    __gm__ HybridRouteRecord* route_records;
    std::uint64_t route_record_capacity, scale_factor_token_stride;
    std::uint64_t scale_factor_pack_stride, recv_scale_factor_token_stride;
    std::uint64_t recv_scale_factor_pack_stride, generation, timeout_cycles;
    std::uint64_t pipeline_chunk_begin, pipeline_chunk_end;
    std::uint32_t pipeline_chunk_index, pipeline_final_chunk;
    std::uint32_t pipeline_source_chunk;
    DirectDispatchStage stage;
    std::uint32_t copy_outputs, consumer_tile_bytes, parallel_prefix;
    std::uint32_t token_fanout, early_route_plan;
};

template <bool ProfileEnabled>
__global__ __vector__ void dispatch_kernel(
    DispatchKernelArguments arguments, CoreTiling tiling) {
    const auto x = arguments.x;
    const auto scale_factors = arguments.scale_factors;
    const auto topk_indices = arguments.topk_indices;
    const auto topk_weights = arguments.topk_weights;
    const auto communication_buffer = arguments.communication_buffer;
    const auto workspace = arguments.workspace;
    const auto destination_slots = arguments.destination_slots;
    const auto recv_x = arguments.recv_x;
    const auto recv_scale_factors = arguments.recv_scale_factors;
    const auto recv_topk_indices = arguments.recv_topk_indices;
    const auto recv_topk_weights = arguments.recv_topk_weights;
    const auto prefix_per_rank = arguments.prefix_per_rank;
    const auto prefix_per_expert = arguments.prefix_per_expert;
    const auto unaligned_per_expert = arguments.unaligned_per_expert;
    const auto source_metadata = arguments.source_metadata;
    const auto route_records = arguments.route_records;
    const auto route_record_capacity = arguments.route_record_capacity;
    const auto scale_factor_token_stride = arguments.scale_factor_token_stride;
    const auto scale_factor_pack_stride = arguments.scale_factor_pack_stride;
    const auto recv_scale_factor_token_stride = arguments.recv_scale_factor_token_stride;
    const auto recv_scale_factor_pack_stride = arguments.recv_scale_factor_pack_stride;
    const auto generation = arguments.generation;
    const auto timeout_cycles = arguments.timeout_cycles;
    const auto pipeline_chunk_begin = arguments.pipeline_chunk_begin;
    const auto pipeline_chunk_end = arguments.pipeline_chunk_end;
    const auto pipeline_chunk_index = arguments.pipeline_chunk_index;
    const auto pipeline_final_chunk = arguments.pipeline_final_chunk;
    const auto pipeline_source_chunk = arguments.pipeline_source_chunk;
    const auto stage = arguments.stage;
    const auto copy_outputs = arguments.copy_outputs;
    const auto consumer_tile_bytes = arguments.consumer_tile_bytes;
    const auto parallel_prefix = arguments.parallel_prefix;
    const auto token_fanout = arguments.token_fanout;
    const auto early_route_plan = arguments.early_route_plan;
    if constexpr (ProfileEnabled) {
        const auto profile_block = static_cast<std::uint32_t>(
            AscendC::GetBlockIdx());
        transport::service::record_stage_start<true>(
            tiling.transport_context,
            transport::TransportProfileOperation::kDispatch, generation,
            static_cast<std::uint32_t>(stage), profile_block,
            static_cast<std::uint32_t>(AscendC::GetBlockNum()));
    }
    const bool hybrid =
        (tiling.mode_flags &
         (CoreModeFlags{1} <<
          static_cast<std::uint8_t>(CoreMode::kHybrid))) != 0;
    const bool cpu_sync =
        (tiling.mode_flags &
         (CoreModeFlags{1} <<
          static_cast<std::uint8_t>(CoreMode::kCpuSync))) != 0;
    const bool cached =
        (tiling.mode_flags &
         (CoreModeFlags{1} <<
          static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const bool grouping_eligible =
        tiling.num_topk <= kTopkSubgroupWidth &&
        tiling.transport_context.topology.world_size <=
            static_cast<int>(kTopkSubgroupWidth);
    const auto release_segment = direct_dispatch_release_segment(
        stage, ProfileEnabled);
    if (stage == DirectDispatchStage::kFull ||
        stage == DirectDispatchStage::kProducerControl) {
        if (!transport::service::reset(
                tiling.transport_context, generation))
            return;
    }
    if (stage == DirectDispatchStage::kProducerRelease &&
        tiling.workspace_layout.dispatch_pipeline_bytes ==
            sizeof(DispatchPipelineState)) {
        if (!transport::service::reset(
                tiling.transport_context, generation))
            return;
    }
    if (hybrid) {
        (void)0;
    } else if (stage == DirectDispatchStage::kFull ||
               stage == DirectDispatchStage::kProducerControl) {
        (void)0;
        if (early_route_plan != 0) {
            (void)0;
        }
        if (stage == DirectDispatchStage::kFull || cached ||
            !grouping_eligible) {
            (void)0;
            (void)0;
        }
    }
    if (!hybrid && stage == DirectDispatchStage::kProducerPrefix &&
        grouping_eligible && !cached) {
        (void)0;
        if (early_route_plan != 0) {
            (void)0;
            transport::service::execute<ProfileEnabled>(
                tiling.transport_context);
            (void)0;
        }
    }
    const bool persistent_record =
        stage == DirectDispatchStage::kProducerRecordPipeline;
    const std::uint32_t source_chunk_tiles = persistent_record ?
        static_cast<std::uint32_t>(pipeline_chunk_end) : 0U;
    const std::uint32_t source_tile_count =
        static_cast<std::uint32_t>(
            tiling.workspace_layout.dispatch_group_tile_count);
    const std::uint32_t source_chunk_count = persistent_record ?
        (source_tile_count + source_chunk_tiles - 1U) /
            source_chunk_tiles :
        1U;
    if (persistent_record) {
        direct_dispatch_persistent_producer_device(
            x, scale_factors, topk_indices, topk_weights,
            communication_buffer, workspace, destination_slots,
            scale_factor_token_stride, scale_factor_pack_stride,
            generation, timeout_cycles, source_chunk_tiles, source_chunk_count,
            token_fanout, tiling);
    }
    if (!persistent_record) {
    for (std::uint32_t source_chunk = 0;
             source_chunk < source_chunk_count; ++source_chunk) {
        const std::uint64_t record_chunk_begin = pipeline_chunk_begin;
        const std::uint64_t record_chunk_end = pipeline_chunk_end;
        const bool record_stage =
            stage == DirectDispatchStage::kProducerRecord;
        if (!hybrid && (stage == DirectDispatchStage::kFull ||
                        record_stage)) {
        const std::uint64_t vector_hidden_bytes =
            token_fanout != 0 ?
                tiling.token_layout.hidden_bytes -
                    tiling.token_layout.hidden_bytes %
                        kDispatchTokenFanoutAlignmentBytes :
                tiling.token_layout.hidden_bytes -
                    tiling.token_layout.hidden_bytes %
                        kDispatchProducerVectorTileBytes;
        (void)0;
        if (record_stage &&
            grouping_eligible && tiling.token_layout.hidden_bytes >=
                kDispatchVectorTileBytes) {
            asc_sync_vec();
            asc_sync_data_barrier(mem_dsb_t::DSB_DDR);
            if (token_fanout != 0) {
                direct_dispatch_producer_token_fanout_impl(
                    x, communication_buffer, workspace, destination_slots,
                    tiling.transport_context.local_window_base,
                    tiling.transport_context.topology.world_rank,
                    tiling.transport_context.topology.world_size,
                    tiling.num_tokens, tiling.num_topk,
                    tiling.num_max_tokens_per_rank,
                    tiling.symmetric_window_layout.dispatch_receive_offset,
                    tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
                    tiling.symmetric_window_layout.dispatch_staging_offset,
                    tiling.symmetric_window_layout.dispatch_staging_shard_bytes,
                    tiling.workspace_layout.scratch_status_offset,
                    tiling.workspace_layout.dispatch_group_owner_offset,
                    tiling.workspace_layout.dispatch_group_tile_count,
                    tiling.launch.num_threads,
                    record_chunk_begin, record_chunk_end,
                    pipeline_source_chunk,
                    tiling.token_layout.stride_bytes,
                    tiling.token_layout.hidden_offset,
                    tiling.token_layout.hidden_bytes);
            } else {
                direct_dispatch_producer_vector_payload_impl(
                    x, communication_buffer, workspace, destination_slots,
                    tiling.transport_context.local_window_base,
                    tiling.transport_context.topology.world_rank,
                    tiling.transport_context.topology.world_size,
                    tiling.num_tokens, tiling.num_topk,
                    tiling.num_max_tokens_per_rank,
                    tiling.symmetric_window_layout.dispatch_receive_offset,
                    tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
                    tiling.symmetric_window_layout.dispatch_staging_offset,
                    tiling.symmetric_window_layout.dispatch_staging_shard_bytes,
                    tiling.workspace_layout.scratch_status_offset,
                    tiling.workspace_layout.dispatch_group_owner_offset,
                    tiling.workspace_layout.dispatch_group_tile_count,
                    tiling.launch.num_threads,
                    record_chunk_begin, record_chunk_end,
                    pipeline_source_chunk,
                    tiling.token_layout.stride_bytes,
                    tiling.token_layout.hidden_offset,
                    tiling.token_layout.hidden_bytes);
            }
        }
        }
    }
    }
    if (!hybrid &&
        stage == DirectDispatchStage::kProducerReleasePipeline) {
        const std::uint32_t release_chunk_tiles =
            static_cast<std::uint32_t>(pipeline_chunk_end);
        const std::uint32_t release_tile_count =
            static_cast<std::uint32_t>(
                tiling.workspace_layout.dispatch_group_tile_count);
        const std::uint32_t release_chunk_count =
            (release_tile_count + release_chunk_tiles - 1U) /
                release_chunk_tiles;
        const std::uint32_t producer_blocks =
            tiling.data_launch.num_blocks;
        direct_dispatch_persistent_release_device<ProfileEnabled>(
            communication_buffer, workspace, generation, timeout_cycles,
            release_chunk_tiles, release_chunk_count, producer_blocks,
            tiling);
    }
    if (!hybrid && release_segment != DirectReleaseSegment::kNone) {
        (void)0;
    }
    if (release_segment != DirectReleaseSegment::kNone)
        transport::service::execute<ProfileEnabled>(tiling.transport_context);
    if (stage == DirectDispatchStage::kProducerRelease &&
        tiling.workspace_layout.dispatch_pipeline_bytes ==
            sizeof(DispatchPipelineState)) {
        (void)0;
    }
    if (hybrid) {
        if (!transport::service::reset(
                tiling.transport_context, generation))
            return;
        (void)0;
        transport::service::execute<ProfileEnabled>(tiling.transport_context);
        (void)0;
    }
    if (hybrid) {
        (void)0;
    } else if (stage == DirectDispatchStage::kFull ||
               (static_cast<std::uint8_t>(stage) >=
                    static_cast<std::uint8_t>(
                        kFirstDirectDispatchEpilogueStage) &&
                static_cast<std::uint8_t>(stage) <=
                    static_cast<std::uint8_t>(
                        kLastDirectDispatchEpilogueStage))) {
        DEEP_EP_ASCEND_DIRECT_DISPATCH_EPILOGUE(
            copy_outputs, stage, early_route_plan, pipeline_source_chunk);
    }
    if (hybrid) {
        (void)0;
    }
    if constexpr (ProfileEnabled) {
        const auto profile_block = static_cast<std::uint32_t>(
            AscendC::GetBlockIdx());
        transport::service::record_stage_end<true>(
            tiling.transport_context,
            transport::TransportProfileOperation::kDispatch, generation,
            static_cast<std::uint32_t>(stage), profile_block,
            stage == DirectDispatchStage::kFull ||
                stage == DirectDispatchStage::kEpilogueComplete);
    }
}

// Per-AIV dynamic UB layout (byte offsets from UB base):
//   [0, consumer_ub_bytes) consumer payload scratch
// The launch site selects consumer_ub_bytes from the active copy tile size.
__global__ __vector__ void dispatch_copy_kernel(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ std::uint8_t* recv_x,
    __gm__ std::uint8_t* recv_scale_factors,
    __gm__ std::int64_t* recv_topk_indices,
    __gm__ float* recv_topk_weights,
    __gm__ std::int32_t* prefix_per_rank,
    __gm__ std::int32_t* prefix_per_expert,
    __gm__ std::int32_t* unaligned_per_expert,
    __gm__ std::int32_t* source_metadata,
    std::uint64_t recv_scale_factor_token_stride,
    std::uint64_t recv_scale_factor_pack_stride,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint32_t consumer_tile_bytes, std::uint32_t parallel_prefix,
    CoreTiling tiling) {
    const bool hybrid = (tiling.mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kHybrid))) != 0;
    if (hybrid) {
        (void)0;
    } else {
        DEEP_EP_ASCEND_DIRECT_DISPATCH_EPILOGUE(
            1U, DirectDispatchStage::kFull, 0U, 0U);
    }
}

inline std::uint32_t dispatch_consumer_ub_bytes(
    std::uint32_t consumer_tile_bytes) {
    switch (consumer_tile_bytes) {
        case 1024:
        case 2048:
        case 4096:
        case 8192:
            return consumer_tile_bytes;
        default:
            return kDispatchVectorTileBytes;
    }
}

inline std::uint32_t dispatch_dynamic_ub_bytes(
    const DispatchArguments& arguments) {
    const std::uint32_t producer_bytes = arguments.token_fanout != 0 ?
        static_cast<std::uint32_t>(kDispatchTokenFanoutBufferBytes) :
        kDispatchProducerVectorTileBytes;
    const std::uint32_t consumer_bytes = dispatch_consumer_ub_bytes(
        arguments.consumer_tile_bytes);
    return producer_bytes > consumer_bytes ? producer_bytes : consumer_bytes;
}

extern "C" int deep_ep_ascend_launch_dispatch_producer_group(
    DispatchArguments arguments, CoreTiling tiling, void* stream,
    CoreLaunchShape launch, std::uint32_t dynamic_ub_bytes,
    bool profile_enabled);

extern "C" int deep_ep_ascend_launch_dispatch_producer_prefix(
    DispatchArguments arguments, CoreTiling tiling, void* stream,
    CoreLaunchShape launch, std::uint32_t dynamic_ub_bytes);

extern "C" int deep_ep_ascend_launch_dispatch_epilogue_complete(
    DispatchArguments arguments, CoreTiling tiling, void* stream,
    CoreLaunchShape launch, std::uint32_t dynamic_ub_bytes);

template <bool ProfileEnabled>
inline int launch_dispatch_kernel(
    DispatchArguments arguments, CoreTiling tiling, void* stream,
    CoreLaunchShape launch, DirectDispatchStage stage,
    std::uint32_t copy_outputs) {
    const auto dynamic_ub_bytes = dispatch_dynamic_ub_bytes(arguments);
    const DispatchKernelArguments kernel_arguments{
        static_cast<const std::uint8_t*>(arguments.x),
        static_cast<const std::uint8_t*>(arguments.scale_factors),
        arguments.topk_indices, arguments.topk_weights,
        static_cast<std::uint8_t*>(arguments.communication_buffer),
        static_cast<std::uint8_t*>(arguments.workspace),
        arguments.destination_slots,
        static_cast<std::uint8_t*>(arguments.recv_x),
        static_cast<std::uint8_t*>(arguments.recv_scale_factors),
        arguments.recv_topk_indices, arguments.recv_topk_weights,
        arguments.prefix_per_rank, arguments.prefix_per_expert,
        arguments.unaligned_per_expert, arguments.source_metadata,
        arguments.route_records, arguments.route_record_capacity,
        arguments.scale_factor_token_stride,
        arguments.scale_factor_pack_stride,
        arguments.recv_scale_factor_token_stride,
        arguments.recv_scale_factor_pack_stride,
        arguments.generation, arguments.timeout_cycles,
        arguments.pipeline_chunk_begin, arguments.pipeline_chunk_end,
        arguments.pipeline_chunk_index, arguments.pipeline_final_chunk,
        arguments.pipeline_source_chunk, stage, copy_outputs,
        arguments.consumer_tile_bytes, arguments.parallel_prefix,
        arguments.token_fanout, arguments.early_route_plan};
    dispatch_kernel<ProfileEnabled><<<
        launch.num_blocks, dynamic_ub_bytes,
        static_cast<aclrtStream>(stream)>>>(
        kernel_arguments, tiling);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

inline int launch_dispatch_kernel(
    DispatchArguments arguments, CoreTiling tiling, void* stream,
    CoreLaunchShape launch, DirectDispatchStage stage,
    std::uint32_t copy_outputs) {
    if (arguments.pipeline_chunk_end == 0) {
        arguments.pipeline_chunk_begin = 0;
        arguments.pipeline_chunk_end = tiling.num_max_tokens_per_rank;
        arguments.pipeline_chunk_index = 0;
        arguments.pipeline_final_chunk = 1;
        arguments.pipeline_source_chunk = 0;
    }
    const std::uint64_t chunk_limit = arguments.pipeline_source_chunk != 0 ?
        tiling.workspace_layout.dispatch_group_tile_count :
        tiling.num_max_tokens_per_rank;
    if (arguments.pipeline_chunk_begin >= arguments.pipeline_chunk_end ||
        arguments.pipeline_chunk_end > chunk_limit)
        return -1;
    const bool profile_enabled = deep_ep::ascend::transport::has_capability(
        tiling.transport_context.capabilities,
        deep_ep::ascend::transport::TransportCapability::kStageProfile);
    if (stage == DirectDispatchStage::kProducerGroup)
        return deep_ep_ascend_launch_dispatch_producer_group(
            arguments, tiling, stream, launch,
            dispatch_dynamic_ub_bytes(arguments), profile_enabled);
    if (stage == DirectDispatchStage::kProducerPrefix) {
        const auto prefix_status =
            deep_ep_ascend_launch_dispatch_producer_prefix(
                arguments, tiling, stream, launch,
                dispatch_dynamic_ub_bytes(arguments));
        if (prefix_status != 0)
            return prefix_status;
    }
    const bool hybrid = has_mode(tiling.mode_flags, CoreMode::kHybrid);
    const bool cached = has_mode(tiling.mode_flags, CoreMode::kCached);
    const bool grouping_eligible =
        tiling.num_topk <= kTopkSubgroupWidth &&
        tiling.transport_context.topology.world_size <=
            static_cast<int>(kTopkSubgroupWidth);
    auto launch_vf = [&](auto function) {
        return function(
            arguments, tiling, stream, launch, stage, copy_outputs,
            profile_enabled);
    };
    if (!hybrid && stage == DirectDispatchStage::kProducerRecord) {
        const auto vf_status = launch_vf(
            launch_direct_dispatch_producer_record_variant_0);
        if (vf_status != 0)
            return vf_status;
    }
    const auto release_segment = host_dispatch_release_segment(
        stage, profile_enabled);
    if (!hybrid && release_segment != DirectReleaseSegment::kNone) {
        const auto vf_status = launch_vf(
            launch_direct_dispatch_producer_release_variant_1);
        if (vf_status != 0)
            return vf_status;
    }
    if (!hybrid && copy_outputs != 0 &&
        stage == DirectDispatchStage::kEpilogueCopy) {
        const auto vf_status = launch_vf(
            launch_direct_dispatch_epilogue_copy_outputs_variant_0);
        if (vf_status != 0)
            return vf_status;
    }
    const bool skip_epilogue_noop =
#if DEEP_EP_ASCEND_SKIP_EPILOGUE_NOOP
        !profile_enabled && !hybrid &&
        (stage == DirectDispatchStage::kEpilogueAcquire ||
         stage == DirectDispatchStage::kEpilogueValidate);
#else
        false;
#endif
    if (!skip_epilogue_noop) {
        const auto status = profile_enabled ?
            launch_dispatch_kernel<true>(
                arguments, tiling, stream, launch, stage, copy_outputs) :
            launch_dispatch_kernel<false>(
                arguments, tiling, stream, launch, stage, copy_outputs);
        if (status != 0)
            return status;
    }
    if (!hybrid && stage == DirectDispatchStage::kProducerControl) {
        auto vf_status = launch_vf(
            launch_direct_dispatch_producer_control_variant_0);
        if (vf_status != 0)
            return vf_status;
        if (arguments.early_route_plan != 0) {
            vf_status = launch_vf(
                launch_direct_dispatch_producer_expert_count_init_variant_0);
            if (vf_status != 0)
                return vf_status;
        }
        if (cached || !grouping_eligible) {
            vf_status = launch_vf(
                launch_direct_dispatch_producer_plan_variant_0);
            if (vf_status != 0)
                return vf_status;
            vf_status = launch_vf(
                launch_direct_dispatch_reduce_errors_variant_2);
            if (vf_status != 0)
                return vf_status;
        }
    }
    if (!hybrid && stage == DirectDispatchStage::kProducerPrefix &&
        grouping_eligible && !cached) {
        auto vf_status = launch_vf(
            launch_direct_dispatch_reduce_errors_variant_3);
        if (vf_status != 0)
            return vf_status;
        if (arguments.early_route_plan != 0) {
            vf_status = launch_vf(
                launch_direct_dispatch_publish_route_plan_variant_0);
            if (vf_status != 0)
                return vf_status;
            vf_status = launch_vf(
                launch_direct_dispatch_acquire_route_plan_variant_0);
            if (vf_status != 0)
                return vf_status;
        }
    }
    if (!hybrid && stage == DirectDispatchStage::kProducerRelease &&
        tiling.workspace_layout.dispatch_pipeline_bytes ==
            sizeof(DispatchPipelineState)) {
        const auto vf_status = launch_vf(
            launch_direct_dispatch_pipeline_wait_variant_1);
        if (vf_status != 0)
            return vf_status;
    }
    if (!hybrid && stage == DirectDispatchStage::kEpilogueAcquire) {
        const auto vf_status = launch_vf(
            launch_direct_dispatch_epilogue_acquire_variant_0);
        if (vf_status != 0)
            return vf_status;
    }
    if (!hybrid && stage == DirectDispatchStage::kEpilogueValidate) {
        const auto vf_status = launch_vf(
            launch_direct_dispatch_epilogue_validate_records_variant_0);
        if (vf_status != 0)
            return vf_status;
    }
    if (!hybrid && stage == DirectDispatchStage::kEpilogueValidateReduce) {
        const auto vf_status = launch_vf(
            launch_direct_dispatch_reduce_errors_variant_0);
        if (vf_status != 0)
            return vf_status;
    }
    if (!hybrid && arguments.early_route_plan == 0 &&
        stage == DirectDispatchStage::kEpilogueExpertCount) {
        const auto vf_status = launch_vf(
            launch_direct_dispatch_epilogue_count_experts_variant_0);
        if (vf_status != 0)
            return vf_status;
    }
    if (!hybrid && arguments.early_route_plan == 0 &&
        stage == DirectDispatchStage::kEpilogueExpertPrefix) {
        const auto vf_status = arguments.parallel_prefix != 0 ?
            launch_vf(
                launch_direct_dispatch_epilogue_parallel_prefix_variant_0) :
            launch_vf(
                launch_direct_dispatch_epilogue_prefix_variant_0);
        if (vf_status != 0)
            return vf_status;
    }
    if (!hybrid && copy_outputs != 0 &&
        stage == DirectDispatchStage::kEpilogueMetadata) {
        auto vf_status = launch_vf(
            launch_direct_dispatch_epilogue_metadata_variant_0);
        if (vf_status != 0)
            return vf_status;
        vf_status = launch_vf(
            launch_direct_dispatch_epilogue_assign_destinations_variant_0);
        if (vf_status != 0)
            return vf_status;
        vf_status = launch_vf(
            launch_direct_dispatch_reduce_errors_variant_1);
        if (vf_status != 0)
            return vf_status;
        vf_status = launch_vf(
            launch_direct_dispatch_epilogue_clear_padding_variant_0);
        if (vf_status != 0)
            return vf_status;
    }
    if (copy_outputs != 0 &&
        (stage == DirectDispatchStage::kFull ||
         stage == DirectDispatchStage::kEpilogueComplete))
        return deep_ep_ascend_launch_dispatch_epilogue_complete(
            arguments, tiling, stream, launch,
            dispatch_dynamic_ub_bytes(arguments));
    return 0;
}

inline int launch_direct_dispatch_stage(
    DispatchArguments arguments, CoreTiling tiling, void* stream,
    DirectDispatchStage stage, std::uint32_t copy_outputs) {
    const auto launch = direct_dispatch_stage_launch(tiling, stage);
    return launch_dispatch_kernel(
        arguments, tiling, stream, launch, stage, copy_outputs);
}

inline int launch_persistent_dispatch_source_pipeline(
    DispatchArguments arguments, CoreTiling tiling,
    void* producer_stream, void* communication_stream,
    const DispatchSourceChunkPlan& source_plan) {
    if (tiling.data_launch.num_blocks <= 1 ||
        source_plan.chunk_count < 2 || source_plan.chunk_tiles == 0)
        return -1;
    arguments.pipeline_chunk_begin = 0;
    arguments.pipeline_chunk_end = source_plan.chunk_tiles;
    arguments.pipeline_chunk_index = 0;
    arguments.pipeline_final_chunk = 1;
    arguments.pipeline_source_chunk = 1;

    int status = 0;
    for (const auto stage : {
             DirectDispatchStage::kProducerControl,
             DirectDispatchStage::kProducerGroup,
             DirectDispatchStage::kProducerPrefix}) {
        status = launch_direct_dispatch_stage(
            arguments, tiling, producer_stream, stage, 0U);
        if (status != 0)
            return status;
    }

    const std::uint32_t producer_blocks =
        dispatch_persistent_producer_blocks(
            tiling.data_launch.num_blocks);
    CoreTiling pipeline_tiling = tiling;
    pipeline_tiling.data_launch.num_blocks = producer_blocks;

    status = launch_direct_dispatch_stage(
        arguments, pipeline_tiling, communication_stream,
        DirectDispatchStage::kProducerReleasePipeline, 0U);
    if (status != 0)
        return status;

    CoreLaunchShape producer_launch = pipeline_tiling.data_launch;
    producer_launch.num_blocks = producer_blocks;
    status = launch_dispatch_kernel(
        arguments, pipeline_tiling, producer_stream, producer_launch,
        DirectDispatchStage::kProducerRecordPipeline, 0U);
    if (status != 0)
        return status;
    const bool profile_enabled =
        deep_ep::ascend::transport::has_capability(
            tiling.transport_context.capabilities,
            deep_ep::ascend::transport::
                TransportCapability::kStageProfile);
    const auto pipeline = profile_enabled ?
        direct_dispatch_profile_pipeline(false) :
        direct_dispatch_pipeline(false);
    const std::uint32_t epilogue_begin = profile_enabled ? 6U : 5U;
    for (std::uint32_t index = epilogue_begin;
         index < pipeline.count; ++index) {
        status = launch_direct_dispatch_stage(
            arguments, tiling, producer_stream,
            pipeline.stages[index], 1U);
        if (status != 0)
            return status;
    }
    return 0;
}

#undef DEEP_EP_ASCEND_DIRECT_DISPATCH_EPILOGUE

}  // namespace deep_ep::ascend::elastic

extern "C" int deep_ep_ascend_launch_dispatch(
    deep_ep::ascend::elastic::DispatchArguments arguments,
    deep_ep::ascend::elastic::CoreTiling tiling, void* stream) {
    using namespace deep_ep::ascend::elastic;
    const bool hybrid = has_mode(tiling.mode_flags, CoreMode::kHybrid);
    const bool cpu_sync = has_mode(tiling.mode_flags, CoreMode::kCpuSync);
    if (hybrid) {
        return launch_dispatch_kernel(
            arguments, tiling, stream, tiling.launch,
            DirectDispatchStage::kFull, cpu_sync ? 0U : 1U);
    }
    const bool profile_enabled = deep_ep::ascend::transport::has_capability(
        tiling.transport_context.capabilities,
        deep_ep::ascend::transport::TransportCapability::kStageProfile);
    const auto pipeline = profile_enabled ?
        direct_dispatch_profile_pipeline(cpu_sync) :
        direct_dispatch_pipeline(cpu_sync);
    for (std::uint32_t index = 0; index < pipeline.count; ++index) {
        const auto status = launch_direct_dispatch_stage(
            arguments, tiling, stream, pipeline.stages[index],
            cpu_sync ? 0U : 1U);
        if (status != 0)
            return status;
    }
    return 0;
}

extern "C" int deep_ep_ascend_launch_dispatch_pipeline(
    deep_ep::ascend::elastic::DispatchArguments arguments,
    deep_ep::ascend::elastic::CoreTiling tiling, void* producer_stream,
    void* communication_stream) {
    using namespace deep_ep::ascend::elastic;
    const bool source_pipeline = arguments.pipeline_chunk_tiles != 0;
    const bool slot_pipeline = arguments.pipeline_chunk_slots != 0;
    const bool cpu_sync = has_mode(tiling.mode_flags, CoreMode::kCpuSync);
    if (producer_stream == nullptr || communication_stream == nullptr ||
        producer_stream == communication_stream ||
        source_pipeline == slot_pipeline ||
        !has_mode(tiling.mode_flags, CoreMode::kPipeline) ||
        has_mode(tiling.mode_flags, CoreMode::kCached) ||
        has_mode(tiling.mode_flags, CoreMode::kHybrid) ||
        has_mode(tiling.mode_flags, CoreMode::kAsyncEvent) ||
        (source_pipeline &&
         (cpu_sync || has_mode(tiling.mode_flags, CoreMode::kExpanded) ||
          tiling.element_kind != ElementKind::kFloat8E4M3)) ||
        (slot_pipeline && !cpu_sync))
        return -1;

    DispatchChunkPlan slot_plan{};
    DispatchSourceChunkPlan source_plan{};
    const bool valid_plan = source_pipeline ?
        build_dispatch_source_chunk_plan(
            tiling.num_tokens, kDispatchGroupingTokensPerTile,
            arguments.pipeline_chunk_tiles, &source_plan) :
        build_dispatch_chunk_plan(
            tiling.num_max_tokens_per_rank,
            arguments.pipeline_chunk_slots, &slot_plan);
    const std::uint32_t chunk_count = source_pipeline ?
        source_plan.chunk_count : slot_plan.chunk_count;
    if (!valid_plan || chunk_count < 2 ||
        chunk_count > kMaximumDispatchPipelineChunks)
        return -1;
    arguments.pipeline_source_chunk = source_pipeline ? 1U : 0U;
    if (source_pipeline)
        return launch_persistent_dispatch_source_pipeline(
            arguments, tiling, producer_stream, communication_stream,
            source_plan);

    aclrtEvent ready[kMaximumDispatchPipelineChunks]{};
    aclrtEvent done[kMaximumDispatchPipelineChunks]{};
    std::uint32_t created_ready = 0;
    std::uint32_t created_done = 0;
    int status = 0;
    for (std::uint32_t chunk = 0; chunk < chunk_count; ++chunk) {
        status = aclrtCreateEventWithFlag(&ready[chunk], ACL_EVENT_SYNC);
        if (status != 0)
            break;
        ++created_ready;
        status = aclrtCreateEventWithFlag(&done[chunk], ACL_EVENT_SYNC);
        if (status != 0)
            break;
        ++created_done;
    }

    if (status == 0) {
        for (const auto stage : {
                 DirectDispatchStage::kProducerControl,
                 DirectDispatchStage::kProducerGroup,
                 DirectDispatchStage::kProducerPrefix}) {
            status = launch_direct_dispatch_stage(
                arguments, tiling, producer_stream, stage, 0U);
            if (status != 0)
                break;
        }
    }

    for (std::uint32_t chunk = 0;
         status == 0 && chunk < chunk_count; ++chunk) {
        if (chunk >= kDispatchPipelineSlotCount) {
            status = aclrtStreamWaitEvent(
                static_cast<aclrtStream>(producer_stream),
                done[chunk - kDispatchPipelineSlotCount]);
            if (status != 0)
                break;
        }
        if (source_pipeline) {
            std::uint32_t tile_begin = 0;
            std::uint32_t tile_end = 0;
            std::uint32_t token_begin = 0;
            std::uint32_t token_end = 0;
            if (!dispatch_source_chunk_bounds(
                    source_plan, chunk, &tile_begin, &tile_end,
                    &token_begin, &token_end)) {
                status = -1;
                break;
            }
            (void)token_begin;
            (void)token_end;
            arguments.pipeline_chunk_begin = tile_begin;
            arguments.pipeline_chunk_end = tile_end;
        } else {
            arguments.pipeline_chunk_begin =
                static_cast<std::uint64_t>(chunk) * slot_plan.chunk_slots;
            const auto remaining = slot_plan.shard_capacity -
                arguments.pipeline_chunk_begin;
            arguments.pipeline_chunk_end = arguments.pipeline_chunk_begin +
                (remaining < slot_plan.chunk_slots ?
                     remaining : slot_plan.chunk_slots);
        }
        arguments.pipeline_chunk_index = chunk;
        arguments.pipeline_final_chunk =
            chunk + 1 == chunk_count ? 1U : 0U;

        status = launch_direct_dispatch_stage(
            arguments, tiling, producer_stream,
            DirectDispatchStage::kProducerRecord, 0U);
        if (status != 0)
            break;
        status = aclrtRecordEvent(
            ready[chunk], static_cast<aclrtStream>(producer_stream));
        if (status != 0)
            break;
        status = aclrtStreamWaitEvent(
            static_cast<aclrtStream>(communication_stream),
            ready[chunk]);
        if (status != 0)
            break;
        status = launch_direct_dispatch_stage(
            arguments, tiling, communication_stream,
            DirectDispatchStage::kProducerRelease, 0U);
        if (status != 0)
            break;
        const bool profile_enabled =
            deep_ep::ascend::transport::has_capability(
                tiling.transport_context.capabilities,
                deep_ep::ascend::transport::
                    TransportCapability::kStageProfile);
        if (status == 0 && profile_enabled &&
            chunk + 1 == chunk_count) {
            for (const auto stage : {
                     DirectDispatchStage::kProducerReleaseControl,
                     DirectDispatchStage::kProducerReleaseBarrier}) {
                status = launch_direct_dispatch_stage(
                    arguments, tiling, communication_stream, stage, 0U);
                if (status != 0)
                    break;
            }
        }
        if (status == 0)
            status = aclrtRecordEvent(
                done[chunk],
                static_cast<aclrtStream>(communication_stream));
    }

    if (status == 0)
        status = aclrtStreamWaitEvent(
            static_cast<aclrtStream>(producer_stream),
            done[chunk_count - 1]);
    if (status == 0) {
        const bool profile_enabled =
            deep_ep::ascend::transport::has_capability(
                tiling.transport_context.capabilities,
                deep_ep::ascend::transport::
                    TransportCapability::kStageProfile);
        const auto pipeline = profile_enabled ?
            direct_dispatch_profile_pipeline(cpu_sync) :
            direct_dispatch_pipeline(cpu_sync);
        const std::uint32_t epilogue_begin = profile_enabled ? 6U : 5U;
        for (std::uint32_t index = epilogue_begin;
             status == 0 && index < pipeline.count; ++index)
            status = launch_direct_dispatch_stage(
                arguments, tiling, producer_stream,
                pipeline.stages[index], cpu_sync ? 0U : 1U);
    }

    const int producer_sync = aclrtSynchronizeStream(
        static_cast<aclrtStream>(producer_stream));
    const int communication_sync = aclrtSynchronizeStream(
        static_cast<aclrtStream>(communication_stream));
    if (status == 0)
        status = producer_sync != 0 ? producer_sync : communication_sync;
    for (std::uint32_t index = 0; index < created_ready; ++index) {
        const int destroy_status = aclrtDestroyEvent(ready[index]);
        if (status == 0)
            status = destroy_status;
    }
    for (std::uint32_t index = 0; index < created_done; ++index) {
        const int destroy_status = aclrtDestroyEvent(done[index]);
        if (status == 0)
            status = destroy_status;
    }

    return status;
}

extern "C" int deep_ep_ascend_launch_dispatch_epilogue(
    deep_ep::ascend::elastic::DispatchArguments arguments,
    deep_ep::ascend::elastic::CoreTiling tiling, void* stream) {
    using namespace deep_ep::ascend::elastic;
    if (has_mode(tiling.mode_flags, CoreMode::kHybrid)) {
        const auto dynamic_ub_bytes = dispatch_consumer_ub_bytes(
            arguments.consumer_tile_bytes);
        dispatch_copy_kernel<<<
            tiling.launch.num_blocks, dynamic_ub_bytes,
            static_cast<aclrtStream>(stream)>>>(
        static_cast<std::uint8_t*>(arguments.communication_buffer),
        static_cast<std::uint8_t*>(arguments.workspace),
        static_cast<std::uint8_t*>(arguments.recv_x),
        static_cast<std::uint8_t*>(arguments.recv_scale_factors),
        arguments.recv_topk_indices, arguments.recv_topk_weights,
        arguments.prefix_per_rank, arguments.prefix_per_expert,
        arguments.unaligned_per_expert, arguments.source_metadata,
        arguments.recv_scale_factor_token_stride,
        arguments.recv_scale_factor_pack_stride,
        arguments.generation, arguments.timeout_cycles,
        arguments.consumer_tile_bytes, arguments.parallel_prefix, tiling);
        return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    }
    const auto pipeline = direct_dispatch_epilogue_pipeline();
    for (std::uint32_t index = 0; index < pipeline.count; ++index) {
        const auto status = launch_direct_dispatch_stage(
            arguments, tiling, stream, pipeline.stages[index], 1U);
        if (status != 0)
            return status;
    }
    return 0;
}
