#include <cstdint>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"

#include "kernels.hpp"

#define DEEP_EP_ASCEND_SIMT_DEVICE 1
#include "../transport/device_transport_facade.hpp"

namespace deep_ep::ascend::elastic {

__simt_vf__ inline void dispatch_vf(
    __gm__ const std::uint8_t* x,
    __gm__ const std::uint8_t* scale_factors,
    __gm__ const std::int64_t* topk_indices,
    __gm__ const float* topk_weights,
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::int32_t* prefix_per_rank,
    __gm__ std::int32_t* prefix_per_expert,
    __gm__ std::int32_t* unaligned_per_expert,
    __gm__ std::int32_t* destination_slots,
    __gm__ std::int32_t* source_metadata,
    __gm__ std::uint8_t* workspace, CoreTiling tiling) {
    if (threadIdx.x == 0) {
        const bool cached = (tiling.mode_flags &
            (CoreModeFlags{1} <<
             static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
        if (!cached) {
            for (std::uint64_t expert = 0;
                 expert < tiling.num_experts; ++expert) {
                unaligned_per_expert[expert] = 0;
                prefix_per_expert[expert] = 0;
            }
            prefix_per_expert[tiling.num_experts] = 0;
        }
        std::int32_t rank_count = cached ? prefix_per_rank[0] : 0;
        for (std::uint64_t token = 0; token < tiling.num_tokens; ++token) {
            std::int32_t master_lane = -1;
            std::int32_t destination_slot = -1;
            for (std::uint64_t lane = 0; lane < tiling.num_topk; ++lane) {
                const std::int64_t expert =
                    topk_indices[token * tiling.num_topk + lane];
                const bool valid = expert >= 0 &&
                    static_cast<std::uint64_t>(expert) < tiling.num_experts;
                if (!cached && valid) {
                    ++unaligned_per_expert[expert];
                    if (master_lane < 0)
                        master_lane = static_cast<std::int32_t>(lane);
                }
                if (cached &&
                    destination_slots[token * tiling.num_topk + lane] >= 0) {
                    master_lane = static_cast<std::int32_t>(lane);
                    destination_slot =
                        destination_slots[token * tiling.num_topk + lane];
                }
                if (!cached)
                    destination_slots[token * tiling.num_topk + lane] = -1;
            }
            if (master_lane < 0)
                continue;

            if (!cached) {
                destination_slot = rank_count;
                destination_slots[token * tiling.num_topk + master_lane] =
                    destination_slot;
            }
            __gm__ std::uint8_t* record = communication_buffer +
                static_cast<std::uint64_t>(destination_slot) *
                    tiling.token_layout.stride_bytes;
            const std::uint64_t hidden_bytes =
                tiling.token_layout.hidden_bytes;
            for (std::uint64_t byte = 0; byte < hidden_bytes; ++byte)
                record[tiling.token_layout.hidden_offset + byte] =
                    x[token * hidden_bytes + byte];
            for (std::uint64_t byte = 0;
                 byte < tiling.token_layout.scale_factor_bytes; ++byte) {
                record[tiling.token_layout.scale_factor_offset + byte] =
                    scale_factors == nullptr ? 0 :
                    scale_factors[
                        token * tiling.token_layout.scale_factor_bytes + byte];
            }
            auto record_topk = reinterpret_cast<__gm__ std::int64_t*>(
                record + tiling.token_layout.topk_index_offset);
            auto record_weights = reinterpret_cast<__gm__ float*>(
                record + tiling.token_layout.topk_weight_offset);
            auto record_metadata = reinterpret_cast<__gm__ std::int32_t*>(
                record + tiling.token_layout.source_metadata_offset);
            for (std::uint64_t lane = 0; lane < tiling.num_topk; ++lane) {
                record_topk[lane] =
                    topk_indices[token * tiling.num_topk + lane];
                record_weights[lane] = topk_weights == nullptr ? 0.0F :
                    topk_weights[token * tiling.num_topk + lane];
                record_metadata[2 + lane] = cached ?
                    source_metadata[
                        static_cast<std::uint64_t>(destination_slot) *
                            (2 + tiling.num_topk) + 2 + lane] : -1;
            }
            record_metadata[0] = cached ?
                source_metadata[
                    static_cast<std::uint64_t>(destination_slot) *
                        (2 + tiling.num_topk)] :
                static_cast<std::int32_t>(token);
            record_metadata[1] = cached ?
                source_metadata[
                    static_cast<std::uint64_t>(destination_slot) *
                        (2 + tiling.num_topk) + 1] : master_lane;
            if (!cached)
                ++rank_count;
        }
        if (!cached) {
            prefix_per_rank[0] = rank_count;
            std::int32_t prefix = 0;
            for (std::uint64_t expert = 0;
                 expert < tiling.num_experts; ++expert) {
                prefix_per_expert[expert] = prefix;
                const std::int32_t count = unaligned_per_expert[expert];
                const std::int32_t alignment =
                    static_cast<std::int32_t>(tiling.expert_alignment);
                prefix += ((count + alignment - 1) / alignment) * alignment;
            }
            prefix_per_expert[tiling.num_experts] = prefix;
        }
        if (source_metadata != nullptr && rank_count == 0)
            source_metadata[0] = -1;
    }
    asc_syncthreads();

    if (tiling.topology.world_size > 1 && threadIdx.x == 0) {
        transport::DeviceTransportFacade transport(
            tiling.transport_context, 0);
        const auto address =
            reinterpret_cast<transport::DeviceAddress>(workspace);
        transport.put(
            transport::TransportTeam::kWorld, 0, address, address,
            sizeof(std::uint64_t), transport::CooperationScope::kParticipant,
            transport::MemorySegment::kDevice, transport::kDefaultOptions,
            transport::RemoteAction::none());
        transport.put_value(
            transport::TransportTeam::kScaleUp, 0, address, 1,
            sizeof(std::uint64_t), transport::kAggregateRequests);
        transport.signal(
            transport::TransportTeam::kWorld, 0,
            transport::RemoteAction::signal_increment(0));
        transport.device_barrier(1, address, 0);
    }
}

__simt_vf__ inline void dispatch_epilogue_vf(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* recv_x,
    __gm__ std::uint8_t* recv_scale_factors,
    __gm__ std::int64_t* recv_topk_indices,
    __gm__ float* recv_topk_weights,
    __gm__ const std::int32_t* prefix_per_rank,
    __gm__ const std::int32_t* prefix_per_expert,
    __gm__ std::int32_t* source_metadata,
    CoreTiling tiling) {
    if (threadIdx.x != 0)
        return;
    const bool expanded = (tiling.mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    const bool cached = (tiling.mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const bool zero_padding = (tiling.mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kZeroPadding))) != 0;
    const std::int32_t num_receive_tokens = prefix_per_rank[0];
    if (expanded && zero_padding) {
        const std::int32_t num_expanded_tokens =
            prefix_per_expert[tiling.num_experts];
        for (std::int32_t slot = 0; slot < num_expanded_tokens; ++slot) {
            for (std::uint64_t byte = 0;
                 byte < tiling.token_layout.hidden_bytes; ++byte)
                recv_x[static_cast<std::uint64_t>(slot) *
                           tiling.token_layout.hidden_bytes + byte] = 0;
            if (recv_topk_weights != nullptr)
                recv_topk_weights[slot] = 0.0F;
        }
    }
    for (std::int32_t slot = 0; slot < num_receive_tokens; ++slot) {
        __gm__ std::uint8_t* record = communication_buffer +
            static_cast<std::uint64_t>(slot) *
                tiling.token_layout.stride_bytes;
        auto record_topk = reinterpret_cast<__gm__ const std::int64_t*>(
            record + tiling.token_layout.topk_index_offset);
        auto record_weights = reinterpret_cast<__gm__ const float*>(
            record + tiling.token_layout.topk_weight_offset);
        auto record_metadata = reinterpret_cast<__gm__ std::int32_t*>(
            record + tiling.token_layout.source_metadata_offset);
        if (!expanded) {
            for (std::uint64_t byte = 0;
                 byte < tiling.token_layout.hidden_bytes; ++byte)
                recv_x[static_cast<std::uint64_t>(slot) *
                           tiling.token_layout.hidden_bytes + byte] =
                    record[tiling.token_layout.hidden_offset + byte];
            if (recv_scale_factors != nullptr) {
                for (std::uint64_t byte = 0;
                     byte < tiling.token_layout.scale_factor_bytes; ++byte)
                    recv_scale_factors[
                        static_cast<std::uint64_t>(slot) *
                            tiling.token_layout.scale_factor_bytes + byte] =
                        record[tiling.token_layout.scale_factor_offset + byte];
            }
            for (std::uint64_t lane = 0; lane < tiling.num_topk; ++lane) {
                recv_topk_indices[
                    static_cast<std::uint64_t>(slot) *
                        tiling.num_topk + lane] = record_topk[lane];
                if (recv_topk_weights != nullptr)
                    recv_topk_weights[
                        static_cast<std::uint64_t>(slot) *
                            tiling.num_topk + lane] = record_weights[lane];
            }
        } else {
            for (std::uint64_t lane = 0; lane < tiling.num_topk; ++lane) {
                const std::int64_t expert = record_topk[lane];
                if (expert < 0 ||
                    static_cast<std::uint64_t>(expert) >= tiling.num_experts)
                    continue;
                std::int32_t destination = record_metadata[2 + lane];
                if (!cached) {
                    std::int32_t occurrence = 0;
                    for (std::int32_t previous_slot = 0;
                         previous_slot <= slot; ++previous_slot) {
                        __gm__ const std::uint8_t* previous_record =
                            communication_buffer +
                            static_cast<std::uint64_t>(previous_slot) *
                                tiling.token_layout.stride_bytes;
                        auto previous_topk =
                            reinterpret_cast<__gm__ const std::int64_t*>(
                                previous_record +
                                tiling.token_layout.topk_index_offset);
                        const std::uint64_t lane_limit =
                            previous_slot == slot ? lane : tiling.num_topk;
                        for (std::uint64_t previous_lane = 0;
                             previous_lane < lane_limit; ++previous_lane) {
                            if (previous_topk[previous_lane] == expert)
                                ++occurrence;
                        }
                    }
                    destination = prefix_per_expert[expert] + occurrence;
                    record_metadata[2 + lane] = destination;
                }
                for (std::uint64_t byte = 0;
                     byte < tiling.token_layout.hidden_bytes; ++byte)
                    recv_x[static_cast<std::uint64_t>(destination) *
                               tiling.token_layout.hidden_bytes + byte] =
                        record[tiling.token_layout.hidden_offset + byte];
                if (recv_scale_factors != nullptr) {
                    for (std::uint64_t byte = 0;
                         byte < tiling.token_layout.scale_factor_bytes; ++byte)
                        recv_scale_factors[
                            static_cast<std::uint64_t>(destination) *
                                tiling.token_layout.scale_factor_bytes + byte] =
                            record[tiling.token_layout.scale_factor_offset + byte];
                }
                if (recv_topk_weights != nullptr)
                    recv_topk_weights[destination] = record_weights[lane];
            }
        }
        for (std::uint64_t field = 0; field < 2 + tiling.num_topk; ++field)
            source_metadata[
                static_cast<std::uint64_t>(slot) *
                    (2 + tiling.num_topk) + field] = record_metadata[field];
    }
}

__global__ __vector__ void dispatch_kernel(
    __gm__ const std::uint8_t* x,
    __gm__ const std::uint8_t* scale_factors,
    __gm__ const std::int64_t* topk_indices,
    __gm__ const float* topk_weights,
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::int32_t* prefix_per_rank,
    __gm__ std::int32_t* prefix_per_expert,
    __gm__ std::int32_t* unaligned_per_expert,
    __gm__ std::int32_t* destination_slots,
    __gm__ std::int32_t* source_metadata,
    __gm__ std::uint8_t* workspace, CoreTiling tiling) {
    asc_vf_call<dispatch_vf>(
        dim3(tiling.launch.num_threads), x, scale_factors, topk_indices,
        topk_weights, communication_buffer, prefix_per_rank,
        prefix_per_expert, unaligned_per_expert, destination_slots,
        source_metadata, workspace, tiling);
}

__global__ __vector__ void dispatch_epilogue_kernel(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* recv_x,
    __gm__ std::uint8_t* recv_scale_factors,
    __gm__ std::int64_t* recv_topk_indices,
    __gm__ float* recv_topk_weights,
    __gm__ const std::int32_t* prefix_per_rank,
    __gm__ const std::int32_t* prefix_per_expert,
    __gm__ std::int32_t* source_metadata,
    CoreTiling tiling) {
    asc_vf_call<dispatch_epilogue_vf>(
        dim3(tiling.launch.num_threads), communication_buffer, recv_x,
        recv_scale_factors, recv_topk_indices, recv_topk_weights,
        prefix_per_rank, prefix_per_expert, source_metadata, tiling);
}

}  // namespace deep_ep::ascend::elastic

extern "C" int deep_ep_ascend_launch_dispatch(
    deep_ep::ascend::elastic::DispatchArguments arguments,
    deep_ep::ascend::elastic::CoreTiling tiling, void* stream) {
    deep_ep::ascend::elastic::dispatch_kernel<<<
        tiling.launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        static_cast<const std::uint8_t*>(arguments.x),
        static_cast<const std::uint8_t*>(arguments.scale_factors),
        arguments.topk_indices, arguments.topk_weights,
        static_cast<std::uint8_t*>(arguments.communication_buffer),
        arguments.prefix_per_rank, arguments.prefix_per_expert,
        arguments.unaligned_per_expert, arguments.destination_slots,
        arguments.source_metadata,
        static_cast<std::uint8_t*>(arguments.workspace), tiling);
    return 0;
}

extern "C" int deep_ep_ascend_launch_dispatch_epilogue(
    deep_ep::ascend::elastic::DispatchArguments arguments,
    deep_ep::ascend::elastic::CoreTiling tiling, void* stream) {
    deep_ep::ascend::elastic::dispatch_epilogue_kernel<<<
        tiling.launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        static_cast<std::uint8_t*>(arguments.communication_buffer),
        static_cast<std::uint8_t*>(arguments.recv_x),
        static_cast<std::uint8_t*>(arguments.recv_scale_factors),
        arguments.recv_topk_indices, arguments.recv_topk_weights,
        arguments.prefix_per_rank, arguments.prefix_per_expert,
        arguments.source_metadata, tiling);
    return 0;
}
