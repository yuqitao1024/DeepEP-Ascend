namespace deep_ep::ascend::elastic {

constexpr std::uint32_t kDispatchVectorTileBytes = 512;
// The producer payload path is MTE-bound.  A 2 KiB tile cuts the
// per-record MTE2/MTE3 event pairs from fourteen to four for hidden=7168,
// while leaving the final 1024-byte suffix on the scalar/SIMT path.
constexpr std::uint32_t kDispatchProducerVectorTileBytes = 2048;

DEEP_EP_ASCEND_SIMT_CALLEE void dispatch_simt_poll_nop() {
    transport::simt::poll_nop();
}

DEEP_EP_ASCEND_SIMT_CALLEE void direct_dispatch_store_scale_factor_pack(
    __gm__ std::uint8_t* record, std::uint64_t record_offset,
    __gm__ const std::uint8_t* scale_factors,
    std::uint64_t scale_factor_offset) {
    auto* destination = reinterpret_cast<__gm__ std::uint32_t*>(
        record + record_offset);
    const std::uint32_t value = scale_factors == nullptr ? 0U :
        *reinterpret_cast<__gm__ const std::uint32_t*>(
            scale_factors + scale_factor_offset);
    *destination = value;
}

DEEP_EP_ASCEND_SIMT_CALLEE void direct_dispatch_load_scale_factor_pack(
    __gm__ const std::uint8_t* record, std::uint64_t record_offset,
    __gm__ std::uint8_t* scale_factors,
    std::uint64_t scale_factor_offset) {
    const std::uint32_t value =
        *reinterpret_cast<__gm__ const std::uint32_t*>(
            record + record_offset);
    *reinterpret_cast<__gm__ std::uint32_t*>(
        scale_factors + scale_factor_offset) = value;
}

DEEP_EP_ASCEND_SIMT_CALLEE bool
direct_dispatch_compact_record_coordinates(
    std::uint32_t compact_record,
    __gm__ const std::uint64_t* source_bases,
    __gm__ const std::uint64_t* source_counts,
    std::uint32_t world_size, std::uint32_t* source_rank,
    std::uint32_t* source_slot) {
    for (std::uint32_t rank = 0; rank < world_size; ++rank) {
        const std::uint64_t base = source_bases[rank];
        if (compact_record >= base &&
            static_cast<std::uint64_t>(compact_record) - base <
                source_counts[rank]) {
            *source_rank = rank;
            *source_slot = static_cast<std::uint32_t>(
                static_cast<std::uint64_t>(compact_record) - base);
            return true;
        }
    }
    return false;
}

DEEP_EP_ASCEND_SIMT_CALLEE void record_dispatch_protocol_error(
    const transport::DeviceTransportContext& context,
    transport::DeviceAddress status_address, int world_rank,
    DispatchProtocolStage stage, std::uint64_t generation,
    DispatchProtocolError error, std::uint32_t diagnostic_detail = 0) {
    transport::DeviceTransportFacade transport(context, 0);
    const auto failure = make_dispatch_protocol_failure(
        world_rank, stage, generation, error);
    transport.store_release(status_address, failure.scratch_status);
#if defined(DEEP_EP_ASCEND_STAGED_URMA) && DEEP_EP_ASCEND_STAGED_URMA
    auto* queue = transport::device::detail::command_queue(context);
    transport::device::detail::record_error(
        queue, transport::DeviceTransportError::kInvalidProtocol,
        transport::TransportCommandOpcode::kNone, world_rank, 0,
        failure.backend_status,
        failure.generation |
            (static_cast<std::uint64_t>(diagnostic_detail) << 32U));
#endif
}

DEEP_EP_ASCEND_SIMT_CALLEE void record_dispatch_protocol_error(
    const transport::DeviceTransportContext& context,
    transport::DeviceAddress status_address, int world_rank,
    DispatchProtocolError error) {
    std::uint64_t generation = 0;
#if defined(DEEP_EP_ASCEND_STAGED_URMA) && DEEP_EP_ASCEND_STAGED_URMA
    auto* queue = transport::device::detail::command_queue(context);
    if (queue != nullptr)
        generation = transport::simt::load_observed(&queue->generation);
#endif
    record_dispatch_protocol_error(
        context, status_address, world_rank,
        DispatchProtocolStage::kEpilogue, generation, error);
}

DEEP_EP_ASCEND_SIMT_CALLEE DispatchProtocolError
validate_cached_dispatch_state(
    __gm__ const std::int64_t* topk_indices,
    __gm__ const std::int32_t* destination_slots,
    bool cached, int world_rank, int world_size, std::uint64_t num_tokens,
    std::uint64_t num_experts, std::uint64_t num_topk,
    std::uint64_t shard_capacity,
    __gm__ std::uint64_t* destination_counts,
    __gm__ std::uint64_t* maximum_slots,
    __gm__ std::uint8_t* selected_destinations,
    __gm__ std::int32_t* token_slots) {
    if (num_tokens > shard_capacity || shard_capacity == 0 ||
        shard_capacity >
            static_cast<std::uint64_t>(0x7fffffff) /
                static_cast<std::uint64_t>(world_size))
        return DispatchProtocolError::kCapacityOverflow;
    const std::uint64_t num_local_experts =
        num_experts / static_cast<std::uint64_t>(world_size);
    for (int destination_rank = 0;
         destination_rank < world_size; ++destination_rank) {
        destination_counts[destination_rank] = 0;
        maximum_slots[destination_rank] = 0;
    }

    for (std::uint64_t token = 0; token < num_tokens; ++token) {
        for (int destination_rank = 0;
             destination_rank < world_size; ++destination_rank) {
            selected_destinations[destination_rank] = 0;
            token_slots[destination_rank] = -1;
        }
        for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
            const std::int64_t expert =
                topk_indices[token * num_topk + lane];
            const std::int32_t encoded =
                destination_slots[token * num_topk + lane];
            if (expert == -1) {
                if (cached && encoded != -1)
                    return DispatchProtocolError::kInvalidCachedSlot;
                continue;
            }
            if (expert < 0 ||
                static_cast<std::uint64_t>(expert) >= num_experts)
                return DispatchProtocolError::kInvalidTopk;
            const int destination_rank = static_cast<int>(
                static_cast<std::uint64_t>(expert) / num_local_experts);
            selected_destinations[destination_rank] = 1;
            if (!cached)
                continue;
            if (encoded < 0)
                return DispatchProtocolError::kInvalidCachedSlot;
            const int encoded_rank = decode_dispatch_source_rank(
                encoded, shard_capacity);
            const std::int32_t shard_slot = decode_dispatch_local_index(
                encoded, shard_capacity);
            if (encoded_rank != world_rank || shard_slot < 0 ||
                (token_slots[destination_rank] >= 0 &&
                 token_slots[destination_rank] != shard_slot))
                return DispatchProtocolError::kInvalidCachedSlot;
            token_slots[destination_rank] = shard_slot;
        }

        for (int destination_rank = 0;
             destination_rank < world_size; ++destination_rank) {
            if (!selected_destinations[destination_rank])
                continue;
            if (!cached) {
                ++destination_counts[destination_rank];
                continue;
            }
            const std::int32_t shard_slot = token_slots[destination_rank];
            if (shard_slot < 0)
                return DispatchProtocolError::kInvalidCachedSlot;
            for (std::uint64_t previous = 0; previous < token; ++previous) {
                std::int32_t previous_slot = -1;
                for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                    const std::int64_t expert =
                        topk_indices[previous * num_topk + lane];
                    if (expert < 0)
                        continue;
                    const int previous_destination = static_cast<int>(
                        static_cast<std::uint64_t>(expert) /
                        num_local_experts);
                    if (previous_destination == destination_rank) {
                        previous_slot = decode_dispatch_local_index(
                            destination_slots[previous * num_topk + lane],
                            shard_capacity);
                        break;
                    }
                }
                if (previous_slot == shard_slot)
                    return DispatchProtocolError::kInvalidCachedSlot;
            }
            ++destination_counts[destination_rank];
            const std::uint64_t slot =
                static_cast<std::uint64_t>(shard_slot);
            if (maximum_slots[destination_rank] < slot + 1)
                maximum_slots[destination_rank] = slot + 1;
        }
    }

    for (int destination_rank = 0;
         destination_rank < world_size; ++destination_rank) {
        if (destination_counts[destination_rank] > shard_capacity ||
            (cached && maximum_slots[destination_rank] !=
                           destination_counts[destination_rank]))
            return cached ? DispatchProtocolError::kInvalidCachedSlot :
                            DispatchProtocolError::kCapacityOverflow;
    }
    return DispatchProtocolError::kNone;
}

__simt_vf__ __launch_bounds__(512) inline void dispatch_producer_vf(
    __gm__ const std::uint8_t* x,
    __gm__ const std::uint8_t* scale_factors,
    __gm__ const std::int64_t* topk_indices,
    __gm__ const float* topk_weights,
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ std::int32_t* destination_slots,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t timeout_cycles, std::uint64_t num_tokens,
    std::uint64_t num_experts, std::uint64_t num_topk,
    std::uint64_t shard_capacity,
    std::uint64_t dispatch_control_offset,
    std::uint64_t dispatch_control_bytes,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_receive_shard_count,
    std::uint64_t dispatch_receive_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t dispatch_staging_shard_count,
    std::uint64_t dispatch_staging_bytes,
    std::uint64_t hybrid_dispatch_ingress_control_offset,
    std::uint64_t hybrid_dispatch_ingress_control_bytes,
    std::uint64_t hybrid_dispatch_ingress_shard_offset,
    std::uint64_t hybrid_dispatch_ingress_shard_bytes,
    std::uint64_t hybrid_dispatch_ingress_shard_count,
    std::uint64_t hybrid_dispatch_ingress_bytes,
    std::uint64_t hybrid_dispatch_ingress_staging_offset,
    std::uint64_t hybrid_dispatch_ingress_staging_shard_bytes,
    std::uint64_t hybrid_dispatch_ingress_staging_shard_count,
    std::uint64_t hybrid_dispatch_ingress_staging_bytes,
    std::uint64_t workspace_scratch_status_offset,
    std::uint64_t workspace_scratch_local_count_offset,
    std::uint64_t workspace_scratch_rank_counts_offset,
    std::uint64_t workspace_scratch_rank_values_offset,
    std::uint64_t workspace_scratch_outbound_ingress_counts_offset,
    std::uint64_t workspace_scratch_outbound_ingress_count,
    std::uint64_t workspace_scratch_rank_indices_offset,
    std::uint64_t workspace_scratch_rank_flags_offset,
    std::uint64_t workspace_scratch_rank_count,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes,
    std::uint64_t token_scale_factor_offset,
    std::uint64_t token_scale_factor_bytes,
    std::uint64_t scale_factor_token_stride,
    std::uint64_t scale_factor_pack_stride,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_topk_weight_offset,
    std::uint64_t token_source_metadata_offset) {
    if (threadIdx.x != 0)
        return;

    transport::DeviceTransportContext context{};
    context.abi_version = transport_abi_version;
    context.struct_size = transport_struct_size;
    context.capabilities = transport_capabilities;
    context.topology.abi_version = transport_topology_abi_version;
    context.topology.struct_size = transport_topology_struct_size;
    context.topology.world_rank = transport_world_rank;
    context.topology.world_size = transport_world_size;
    context.topology.scale_up_rank = transport_scale_up_rank;
    context.topology.scale_up_size = transport_scale_up_size;
    context.topology.scale_out_rank = transport_scale_out_rank;
    context.topology.scale_out_size = transport_scale_out_size;
    context.topology.scale_up_direct = transport_scale_up_direct != 0;
    context.topology.kind = static_cast<transport::TransportTopologyKind>(
        transport_topology_kind);
    context.topology.epoch = transport_topology_epoch;
    context.local_window_base = transport_local_window_base;
    context.channel_table = transport_channel_table;
    context.peer_address_table = transport_peer_address_table;
    context.backend_context = transport_backend_context;
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address =
        reinterpret_cast<transport::DeviceAddress>(
            workspace + workspace_scratch_status_offset);
    const auto local_count_address =
        reinterpret_cast<transport::DeviceAddress>(
            workspace + workspace_scratch_local_count_offset);
    transport.store_release(status_address, 0);
    transport.store_release(local_count_address, 0);

    const bool hybrid =
        (mode_flags &
         (CoreModeFlags{1} <<
          static_cast<std::uint8_t>(CoreMode::kHybrid))) != 0;

    if (!transport::device::detail::valid_topology(context.topology) ||
        workspace_scratch_rank_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        (hybrid ?
             workspace_scratch_outbound_ingress_count !=
                 static_cast<std::uint64_t>(transport_world_size) :
             (workspace_scratch_outbound_ingress_counts_offset != 0 ||
              workspace_scratch_outbound_ingress_count != 0)) ||
        (transport_world_size > 1 &&
        (dispatch_control_bytes <
             static_cast<std::uint64_t>(transport_world_size) *
                 sizeof(DispatchControlSlot) ||
         dispatch_receive_shard_count !=
             static_cast<std::uint64_t>(transport_world_size) ||
         dispatch_staging_shard_count !=
             static_cast<std::uint64_t>(transport_world_size) ||
         dispatch_receive_bytes <
             dispatch_receive_shard_count * dispatch_receive_shard_bytes ||
         dispatch_staging_bytes <
             dispatch_staging_shard_count * dispatch_staging_shard_bytes ||
         shard_capacity * token_stride_bytes >
             dispatch_receive_shard_bytes ||
         shard_capacity * token_stride_bytes >
             dispatch_staging_shard_bytes ||
         (hybrid &&
          (hybrid_dispatch_ingress_control_bytes <
               static_cast<std::uint64_t>(transport_world_size) *
                   sizeof(DispatchControlSlot) ||
           hybrid_dispatch_ingress_shard_count !=
               static_cast<std::uint64_t>(transport_world_size) ||
           hybrid_dispatch_ingress_bytes <
               hybrid_dispatch_ingress_shard_count *
                   hybrid_dispatch_ingress_shard_bytes ||
           shard_capacity * token_stride_bytes >
               hybrid_dispatch_ingress_shard_bytes ||
           hybrid_dispatch_ingress_staging_shard_count !=
               static_cast<std::uint64_t>(transport_world_size) ||
           hybrid_dispatch_ingress_staging_bytes <
               hybrid_dispatch_ingress_staging_shard_count *
                   hybrid_dispatch_ingress_staging_shard_bytes ||
           shard_capacity * token_stride_bytes >
               hybrid_dispatch_ingress_staging_shard_bytes)))))
        return record_dispatch_protocol_error(
            context, status_address, transport_world_rank,
            DispatchProtocolStage::kProducer, generation,
            DispatchProtocolError::kInvalidLayout);

    const bool cached = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const std::uint64_t num_local_experts =
        num_experts / static_cast<std::uint64_t>(transport_world_size);
    auto* destination_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_scratch_rank_counts_offset);
    auto* rank_values = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_scratch_rank_values_offset);
    auto* outbound_ingress_counts =
        reinterpret_cast<__gm__ std::uint64_t*>(
            workspace +
            workspace_scratch_outbound_ingress_counts_offset);
    auto* rank_indices = reinterpret_cast<__gm__ std::int32_t*>(
        workspace + workspace_scratch_rank_indices_offset);
    auto* rank_flags = reinterpret_cast<__gm__ std::uint8_t*>(
        workspace + workspace_scratch_rank_flags_offset);
    const auto validation = validate_cached_dispatch_state(
        topk_indices, destination_slots, cached, transport_world_rank,
        transport_world_size,
        num_tokens, num_experts, num_topk, shard_capacity,
        destination_counts, rank_values, rank_flags, rank_indices);
    if (validation != DispatchProtocolError::kNone)
        return record_dispatch_protocol_error(
            context, status_address, transport_world_rank,
            DispatchProtocolStage::kProducer, generation, validation);

    if (!cached) {
        for (std::uint64_t token = 0; token < num_tokens; ++token) {
            for (std::uint64_t lane = 0; lane < num_topk; ++lane)
                destination_slots[token * num_topk + lane] = -1;
        }
    }
    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank)
        rank_values[destination_rank] = 0;
    if (hybrid) {
        for (int ingress_rank = 0;
             ingress_rank < transport_world_size; ++ingress_rank)
            outbound_ingress_counts[ingress_rank] = 0;
    }

    for (std::uint64_t token = 0; token < num_tokens; ++token) {
        for (int destination_rank = 0;
             destination_rank < transport_world_size; ++destination_rank) {
            rank_flags[destination_rank] = 0;
            rank_indices[destination_rank] = -1;
        }

        for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
            const std::int64_t expert =
                topk_indices[token * num_topk + lane];
            if (expert < 0)
                continue;
            const int destination_rank = static_cast<int>(
                static_cast<std::uint64_t>(expert) / num_local_experts);
            rank_flags[destination_rank] = 1;
            if (!cached)
                continue;
            const std::int32_t encoded =
                destination_slots[token * num_topk + lane];
            const std::int32_t shard_slot = decode_dispatch_local_index(
                encoded, shard_capacity);
            rank_indices[destination_rank] = shard_slot;
        }

        for (int destination_rank = 0;
             destination_rank < transport_world_size; ++destination_rank) {
            if (rank_flags[destination_rank] == 0)
                continue;
            const auto world_route = classify_world_route(
                transport_world_rank, destination_rank,
                transport_scale_up_size);
            const bool diagonal = hybrid &&
                world_route.kind == WorldRouteKind::kDiagonal;
            const std::uint64_t shard_slot = cached ?
                static_cast<std::uint64_t>(rank_indices[destination_rank]) :
                (diagonal ?
                     outbound_ingress_counts[
                         world_route.ingress_world_rank]++ :
                     rank_values[destination_rank]++);
            if (cached && diagonal)
                ++outbound_ingress_counts[
                    world_route.ingress_world_rank];

            __gm__ std::uint8_t* shard = nullptr;
            if (transport_world_size == 1) {
                shard = communication_buffer;
            } else if (diagonal) {
                shard = reinterpret_cast<__gm__ std::uint8_t*>(
                    transport_local_window_base +
                    hybrid_dispatch_ingress_staging_offset +
                    static_cast<std::uint64_t>(
                        world_route.ingress_world_rank) *
                        hybrid_dispatch_ingress_staging_shard_bytes);
            } else if (destination_rank == transport_world_rank) {
                shard = reinterpret_cast<__gm__ std::uint8_t*>(
                    transport_local_window_base + dispatch_receive_offset +
                    static_cast<std::uint64_t>(transport_world_rank) *
                        dispatch_receive_shard_bytes);
            } else {
                shard = reinterpret_cast<__gm__ std::uint8_t*>(
                    transport_local_window_base + dispatch_staging_offset +
                    static_cast<std::uint64_t>(destination_rank) *
                        dispatch_staging_shard_bytes);
            }
            __gm__ std::uint8_t* record =
                shard + shard_slot * token_stride_bytes;
            for (std::uint64_t byte = 0; byte < token_hidden_bytes; ++byte)
                record[token_hidden_offset + byte] =
                    x[token * token_hidden_bytes + byte];
            for (std::uint64_t pack = 0;
                 pack < token_scale_factor_bytes / 4; ++pack)
                for (std::uint64_t byte = 0; byte < 4; ++byte)
                    record[token_scale_factor_offset + pack * 4 + byte] =
                        scale_factors == nullptr ? 0 : scale_factors[
                            scale_factor_byte_offset(
                                token, pack, scale_factor_token_stride,
                                scale_factor_pack_stride, 4) + byte];
            auto record_topk = reinterpret_cast<__gm__ std::int64_t*>(
                record + token_topk_index_offset);
            auto record_weights = reinterpret_cast<__gm__ float*>(
                record + token_topk_weight_offset);
            auto record_metadata = reinterpret_cast<__gm__ std::int32_t*>(
                record + token_source_metadata_offset);
            std::int32_t master_lane = -1;
            for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                const std::int64_t expert =
                    topk_indices[token * num_topk + lane];
                record_topk[lane] = expert;
                record_weights[lane] = topk_weights == nullptr ? 0.0F :
                    topk_weights[token * num_topk + lane];
                record_metadata[2 + lane] = -1;
                if (expert < 0)
                    continue;
                const int lane_destination = static_cast<int>(
                    static_cast<std::uint64_t>(expert) /
                    num_local_experts);
                if (lane_destination != destination_rank)
                    continue;
                if (master_lane < 0)
                    master_lane = static_cast<std::int32_t>(lane);
                if (!cached) {
                    destination_slots[token * num_topk + lane] =
                        encode_dispatch_source_index(
                            static_cast<std::uint64_t>(transport_world_rank),
                            shard_capacity, shard_slot);
                }
            }
            record_metadata[0] = static_cast<std::int32_t>(token);
            record_metadata[1] = master_lane;
        }
    }

    if (transport_world_size == 1) {
        transport.store_release(local_count_address, destination_counts[0]);
        return;
    }

    auto* control_slots = reinterpret_cast<__gm__ DispatchControlSlot*>(
        transport_local_window_base + dispatch_control_offset);

    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        const auto world_route = classify_world_route(
            transport_world_rank, destination_rank, transport_scale_up_size);
        if (hybrid && world_route.kind == WorldRouteKind::kDiagonal)
            continue;
        const std::uint64_t count = destination_counts[destination_rank];
        if (destination_rank == transport_world_rank) {
            const auto count_address =
                reinterpret_cast<transport::DeviceAddress>(
                    &control_slots[transport_world_rank].count);
            const auto generation_address =
                reinterpret_cast<transport::DeviceAddress>(
                    &control_slots[transport_world_rank].generation);
            transport.store_release(count_address, count);
            transport.store_release(generation_address, generation);
            continue;
        }

        transport::TeamPeer route{};
        if (!transport::device::detail::checked_device_team_peer_for_world_rank(
                context.topology, destination_rank, &route))
            return record_dispatch_protocol_error(
                context, status_address, destination_rank,
                DispatchProtocolStage::kProducer, generation,
                DispatchProtocolError::kInvalidControl);

        if (count != 0) {
            const auto source = static_cast<transport::DeviceAddress>(
                transport_local_window_base + dispatch_staging_offset +
                static_cast<std::uint64_t>(destination_rank) *
                    dispatch_staging_shard_bytes);
            const auto destination = static_cast<transport::DeviceAddress>(
                transport_local_window_base + dispatch_receive_offset +
                static_cast<std::uint64_t>(transport_world_rank) *
                    dispatch_receive_shard_bytes);
            transport.put(
                route.team, route.peer,
                destination, source, count * token_stride_bytes,
                transport::CooperationScope::kParticipant,
                transport::MemorySegment::kDevice,
                transport::kDefaultOptions,
                transport::RemoteAction::none());
        }
        release_protocol::flush_payload(transport);
        const auto remote_count = static_cast<transport::DeviceAddress>(
            transport_local_window_base + dispatch_control_offset +
            static_cast<std::uint64_t>(transport_world_rank) *
                sizeof(DispatchControlSlot) + sizeof(std::uint64_t));
        const auto remote_generation =
            static_cast<transport::DeviceAddress>(
                transport_local_window_base + dispatch_control_offset +
            static_cast<std::uint64_t>(transport_world_rank) *
                    sizeof(DispatchControlSlot));
        release_protocol::publish_control_and_release(
            transport, route, remote_count, count, remote_generation,
            generation, transport::sync_layout::kDispatchReleaseSignalIndex);
    }
    if (hybrid) {
        for (int destination_domain = 0;
             destination_domain < transport_scale_out_size;
             ++destination_domain) {
            if (destination_domain == transport_scale_out_rank)
                continue;
            const int ingress_rank =
                destination_domain * transport_scale_up_size +
                transport_scale_up_rank;
            const std::uint64_t count =
                outbound_ingress_counts[ingress_rank];
            transport::TeamPeer route{
                transport::TransportTeam::kScaleOut,
                destination_domain, ingress_rank};
            release_protocol::put_staged_payload(
                transport, route,
                transport_local_window_base +
                    hybrid_dispatch_ingress_shard_offset +
                    static_cast<std::uint64_t>(transport_world_rank) *
                        hybrid_dispatch_ingress_shard_bytes,
                transport_local_window_base +
                    hybrid_dispatch_ingress_staging_offset +
                    static_cast<std::uint64_t>(ingress_rank) *
                        hybrid_dispatch_ingress_staging_shard_bytes,
                count * token_stride_bytes);
            release_protocol::flush_payload(transport);
            const auto remote_slot =
                transport_local_window_base +
                hybrid_dispatch_ingress_control_offset +
                static_cast<std::uint64_t>(transport_world_rank) *
                    sizeof(DispatchControlSlot);
            release_protocol::publish_control_and_release(
                transport, route, remote_slot + sizeof(std::uint64_t), count,
                remote_slot, generation,
                transport::sync_layout::kDispatchReleaseSignalIndex);
        }
    }
    const auto barrier_workspace =
        reinterpret_cast<transport::DeviceAddress>(
            &control_slots[transport_world_rank].generation);
    transport.device_barrier(
        transport::kWorldTeamMask, barrier_workspace, timeout_cycles);
}

DEEP_EP_ASCEND_SIMT_CALLEE transport::DeviceTransportContext
make_hybrid_dispatch_context(
    std::uint32_t abi_version, std::uint32_t struct_size,
    std::uint64_t capabilities, std::uintptr_t local_window_base,
    std::uintptr_t channel_table, std::uintptr_t peer_address_table,
    std::uint32_t topology_abi_version,
    std::uint32_t topology_struct_size,
    int world_rank, int world_size, int scale_up_rank, int scale_up_size,
    int scale_out_rank, int scale_out_size,
    std::uint32_t scale_up_direct, std::uint32_t topology_kind,
    std::uint64_t topology_epoch, std::uintptr_t backend_context) {
    transport::DeviceTransportContext result{};
    result.abi_version = abi_version;
    result.struct_size = struct_size;
    result.capabilities = capabilities;
    result.topology.abi_version = topology_abi_version;
    result.topology.struct_size = topology_struct_size;
    result.topology.world_rank = world_rank;
    result.topology.world_size = world_size;
    result.topology.scale_up_rank = scale_up_rank;
    result.topology.scale_up_size = scale_up_size;
    result.topology.scale_out_rank = scale_out_rank;
    result.topology.scale_out_size = scale_out_size;
    result.topology.scale_up_direct = scale_up_direct != 0;
    result.topology.kind =
        static_cast<transport::TransportTopologyKind>(topology_kind);
    result.topology.epoch = topology_epoch;
    result.local_window_base = local_window_base;
    result.channel_table = channel_table;
    result.peer_address_table = peer_address_table;
    result.backend_context = backend_context;
    return result;
}

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_producer_control_vf(
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t num_experts,
    std::uint64_t shard_capacity, std::uint64_t dispatch_output_capacity,
    std::uint64_t dispatch_control_bytes,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_receive_shard_count,
    std::uint64_t dispatch_receive_bytes,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t dispatch_staging_shard_count,
    std::uint64_t dispatch_staging_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_local_count_offset,
    std::uint64_t workspace_rank_count,
    std::uint64_t dispatch_error_offset,
    std::uint64_t dispatch_error_count,
    std::uint64_t dispatch_rank_bitmap_bytes,
    std::uint64_t dispatch_expert_bitmap_bytes,
    std::uint64_t token_stride_bytes) {
    if (threadIdx.x != 0)
        return;

    const auto context = make_hybrid_dispatch_context(
        transport_abi_version, transport_struct_size,
        transport_capabilities, transport_local_window_base,
        transport_channel_table, transport_peer_address_table,
        transport_topology_abi_version, transport_topology_struct_size,
        transport_world_rank, transport_world_size,
        transport_scale_up_rank, transport_scale_up_size,
        transport_scale_out_rank, transport_scale_out_size,
        transport_scale_up_direct, transport_topology_kind,
        transport_topology_epoch, transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    const auto local_count_address =
        reinterpret_cast<transport::DeviceAddress>(
            workspace + workspace_local_count_offset);
    transport.store_release(status_address, 0);
    transport.store_release(local_count_address, 0);

    auto* errors = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_error_offset);
    const std::uint32_t error_count_u32 =
        static_cast<std::uint32_t>(dispatch_error_count);
    for (std::uint32_t index = 0; index < error_count_u32; ++index)
        errors[index] = 0;

    const std::uint32_t world_size =
        static_cast<std::uint32_t>(transport_world_size);
    const std::uint64_t local_experts = num_experts / world_size;
    std::uint64_t rank_bitmap_words = 0;
    std::uint64_t expert_bitmap_words = 0;
    const bool valid_parallel_layout =
        dispatch_error_offset != 0 &&
        dispatch_error_count == world_size + local_experts &&
        dispatch_simt_owner_bitmap_words(
            world_size, shard_capacity, &rank_bitmap_words) &&
        dispatch_simt_owner_bitmap_words(
            local_experts, dispatch_output_capacity,
            &expert_bitmap_words) &&
        rank_bitmap_words <=
            dispatch_rank_bitmap_bytes / sizeof(std::uint64_t) &&
        expert_bitmap_words <=
            dispatch_expert_bitmap_bytes / sizeof(std::uint64_t);
    if (!transport::device::detail::valid_topology(context.topology) ||
        workspace_rank_count != world_size || !valid_parallel_layout ||
        (transport_world_size > 1 &&
         (dispatch_control_bytes <
              world_size * sizeof(DispatchControlSlot) ||
          dispatch_receive_shard_count != world_size ||
          dispatch_staging_shard_count != world_size ||
          dispatch_receive_bytes <
              world_size * dispatch_receive_shard_bytes ||
          dispatch_staging_bytes <
              world_size * dispatch_staging_shard_bytes ||
          shard_capacity * token_stride_bytes >
              dispatch_receive_shard_bytes ||
          shard_capacity * token_stride_bytes >
              dispatch_staging_shard_bytes)))
        record_dispatch_protocol_error(
            context, status_address, transport_world_rank,
            DispatchProtocolStage::kProducer, generation,
            DispatchProtocolError::kInvalidLayout);
}

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_producer_plan_vf(
    __gm__ const std::int64_t* topk_indices,
    __gm__ std::int32_t* destination_slots,
    __gm__ std::uint8_t* workspace,
    int transport_world_rank, int transport_world_size,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t num_tokens, std::uint64_t num_experts,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t dispatch_error_offset,
    std::uint64_t dispatch_rank_bitmap_offset) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::simt::load_observed(status) != 0)
        return;

    const std::uint32_t num_tokens_u32 =
        static_cast<std::uint32_t>(num_tokens);
    const std::uint32_t num_experts_u32 =
        static_cast<std::uint32_t>(num_experts);
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t shard_capacity_u32 =
        static_cast<std::uint32_t>(shard_capacity);
    const bool cached = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const std::uint32_t world_size =
        static_cast<std::uint32_t>(transport_world_size);
    const std::uint32_t num_local_experts = num_experts_u32 / world_size;
    auto* destination_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* maximum_slots = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    auto* errors = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_error_offset);
    auto* bitmap = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_rank_bitmap_offset);
    std::uint64_t words_per_rank = 0;
    dispatch_simt_bitmap_words(shard_capacity, &words_per_rank);
    const std::uint32_t words_per_rank_u32 =
        static_cast<std::uint32_t>(words_per_rank);

    for (int destination_rank = static_cast<int>(threadIdx.x);
         destination_rank < transport_world_size;
         destination_rank += static_cast<int>(blockDim.x)) {
        auto* owner_bitmap = bitmap +
            static_cast<std::uint64_t>(destination_rank) * words_per_rank;
        for (std::uint32_t word = 0; word < words_per_rank_u32; ++word)
            owner_bitmap[word] = 0;

        DispatchProtocolError error = DispatchProtocolError::kNone;
        std::uint32_t count = 0;
        std::uint32_t maximum_slot = 0;
        for (std::uint32_t token = 0; token < num_tokens_u32; ++token) {
            bool selected = false;
            std::int32_t cached_slot = -1;
            for (std::uint32_t lane = 0; lane < num_topk_u32; ++lane) {
                const std::uint32_t index = token * num_topk_u32 + lane;
                const std::int64_t expert = topk_indices[index];
                const std::int32_t encoded = destination_slots[index];
                if (expert == -1) {
                    if (!cached && destination_rank == 0)
                        destination_slots[index] = -1;
                    if (cached && encoded != -1 && destination_rank == 0)
                        error = DispatchProtocolError::kInvalidCachedSlot;
                    continue;
                }
                if (expert < 0 ||
                    static_cast<std::uint64_t>(expert) >= num_experts_u32) {
                    if (destination_rank == 0)
                        error = DispatchProtocolError::kInvalidTopk;
                    continue;
                }
                const int lane_destination = static_cast<int>(
                    static_cast<std::uint64_t>(expert) /
                    num_local_experts);
                if (lane_destination != destination_rank)
                    continue;
                selected = true;
                if (!cached)
                    continue;
                const int encoded_rank = decode_dispatch_source_rank(
                    encoded, shard_capacity);
                const std::int32_t slot = decode_dispatch_local_index(
                    encoded, shard_capacity);
                if (encoded < 0 || encoded_rank != transport_world_rank ||
                    slot < 0 ||
                    static_cast<std::uint64_t>(slot) >= shard_capacity ||
                    (cached_slot >= 0 && cached_slot != slot)) {
                    error = DispatchProtocolError::kInvalidCachedSlot;
                    continue;
                }
                cached_slot = slot;
            }
            if (!selected)
                continue;

            const std::uint32_t shard_slot = cached ?
                static_cast<std::uint32_t>(cached_slot) : count;
            if (cached_slot < 0 && cached) {
                error = DispatchProtocolError::kInvalidCachedSlot;
            } else if (shard_slot >= shard_capacity_u32) {
                error = cached ? DispatchProtocolError::kInvalidCachedSlot :
                                 DispatchProtocolError::kCapacityOverflow;
            } else if (cached) {
                std::uint64_t word = 0;
                std::uint64_t mask = 0;
                if (!dispatch_simt_bitmap_location(
                        shard_slot, shard_capacity, &word, &mask) ||
                    (owner_bitmap[word] & mask) != 0) {
                    error = DispatchProtocolError::kInvalidCachedSlot;
                } else {
                    owner_bitmap[word] |= mask;
                }
                if (maximum_slot < shard_slot + 1)
                    maximum_slot = shard_slot + 1;
            }

            if (!cached) {
                for (std::uint32_t lane = 0;
                     lane < num_topk_u32; ++lane) {
                    const std::uint32_t index =
                        token * num_topk_u32 + lane;
                    const std::int64_t expert = topk_indices[index];
                    if (expert >= 0 &&
                        static_cast<int>(
                            static_cast<std::uint64_t>(expert) /
                            num_local_experts) == destination_rank)
                        destination_slots[index] =
                            encode_dispatch_source_index(
                                static_cast<std::uint64_t>(
                                    transport_world_rank),
                                shard_capacity, shard_slot);
                }
            }
            ++count;
        }
        if (count > shard_capacity_u32 ||
            (cached && maximum_slot != count))
            error = cached ? DispatchProtocolError::kInvalidCachedSlot :
                             DispatchProtocolError::kCapacityOverflow;
        destination_counts[destination_rank] = count;
        maximum_slots[destination_rank] = maximum_slot;
        if (error != DispatchProtocolError::kNone)
            errors[destination_rank] = make_dispatch_protocol_failure(
                transport_world_rank, DispatchProtocolStage::kProducer,
                generation, error).scratch_status;
    }
}

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_producer_expert_count_init_vf(
    __gm__ std::uint8_t* workspace,
    std::uint64_t workspace_status_offset,
    std::uint64_t dispatch_group_expert_count_offset,
    std::uint64_t dispatch_group_expert_count) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::simt::load_observed(status) != 0 ||
        dispatch_group_expert_count_offset == 0)
        return;
    auto* expert_counts = reinterpret_cast<__gm__ std::uint32_t*>(
        workspace + dispatch_group_expert_count_offset);
    const std::uint32_t count = static_cast<std::uint32_t>(
        dispatch_group_expert_count);
    for (std::uint32_t index = threadIdx.x; index < count;
         index += blockDim.x)
        expert_counts[index] = 0;
}

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_producer_group_vf(
    __gm__ const std::int64_t* topk_indices,
    __gm__ std::int32_t* destination_slots,
    __gm__ std::uint8_t* workspace,
    int transport_world_rank, int transport_world_size,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t num_tokens, std::uint64_t num_experts,
    std::uint64_t num_topk, std::uint64_t workspace_status_offset,
    std::uint64_t dispatch_group_owner_offset,
    std::uint64_t dispatch_group_tile_offset,
    std::uint64_t dispatch_group_tile_count,
    std::uint64_t dispatch_group_expert_count_offset,
    std::uint64_t dispatch_group_expert_count,
    std::uint64_t dispatch_group_error_offset) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::simt::load_observed(status) != 0 ||
        num_topk > kTopkSubgroupWidth ||
        transport_world_size > static_cast<int>(kTopkSubgroupWidth))
        return;

    const std::uint32_t num_tokens_u32 =
        static_cast<std::uint32_t>(num_tokens);
    const std::uint32_t num_experts_u32 =
        static_cast<std::uint32_t>(num_experts);
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t tile_count_u32 =
        static_cast<std::uint32_t>(dispatch_group_tile_count);
    const bool cached = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const std::uint32_t world_size =
        static_cast<std::uint32_t>(transport_world_size);
    const std::uint32_t num_local_experts = num_experts_u32 / world_size;
    auto* owners = reinterpret_cast<__gm__ std::int32_t*>(
        workspace + dispatch_group_owner_offset);
    auto* tile_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_group_tile_offset);
    auto* expert_counts = reinterpret_cast<__gm__ std::uint32_t*>(
        workspace + dispatch_group_expert_count_offset);
    auto* tile_errors = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_group_error_offset);
    const auto grid = direct_subgroup_grid_stride(
        blockIdx.x, threadIdx.x, gridDim.x, blockDim.x,
        kTopkSubgroupWidth);
    const std::uint32_t lane = grid.lane;
    const bool build_expert_counts =
        dispatch_group_expert_count == num_experts_u32 &&
        dispatch_group_expert_count_offset != 0;

    for (std::uint32_t tile = grid.first;
         tile < tile_count_u32; tile += grid.stride) {
        std::uint32_t destination_count = 0;
        std::uint64_t tile_error = 0;
        const std::uint32_t token_begin =
            tile * static_cast<std::uint32_t>(
                kDispatchGroupingTokensPerTile);
        for (std::uint32_t local_token = 0;
             local_token < kDispatchGroupingTokensPerTile; ++local_token) {
            const std::uint32_t token = token_begin + local_token;
            if (token >= num_tokens_u32)
                break;
            if (lane < world_size)
                owners[token * world_size + lane] = -1;

            std::int32_t destination_key = -1;
            bool logically_active = false;
            bool invalid_topk = false;
            if (lane < num_topk_u32) {
                const std::uint32_t index = token * num_topk_u32 + lane;
                const std::int64_t expert = topk_indices[index];
                if (expert == -1) {
                    if (!cached)
                        destination_slots[index] = -1;
                } else if (expert < 0 ||
                           static_cast<std::uint64_t>(expert) >=
                               num_experts_u32) {
                    invalid_topk = true;
                } else {
                    destination_key = static_cast<std::int32_t>(
                        static_cast<std::uint64_t>(expert) /
                        num_local_experts);
                    logically_active = true;
                    if (build_expert_counts)
                        (void)asc_atomic_add(
                            &expert_counts[static_cast<std::uint32_t>(expert)],
                            1U);
                }
            }

            const auto group = group_topk_subgroup(
                destination_key, logically_active);
            if (group.is_owner)
                owners[token * world_size +
                       static_cast<std::uint64_t>(destination_key)] =
                    static_cast<std::int32_t>(lane);

            bool rank_selected = false;
            TopkSubgroupMask remaining_owners = group.unique_owner_mask;
            while (remaining_owners != 0) {
                const std::int32_t owner_lane =
                    topk_first_set_lane(remaining_owners);
                const std::int32_t owner_key = asc_shfl(
                    destination_key,
                    static_cast<std::uint32_t>(owner_lane),
                    kTopkSubgroupWidth);
                if (lane == static_cast<std::uint32_t>(owner_key))
                    rank_selected = true;
                remaining_owners &= ~(
                    TopkSubgroupMask{1} <<
                    static_cast<std::uint32_t>(owner_lane));
            }
            if (lane < world_size && rank_selected)
                ++destination_count;

            const TopkSubgroupMask invalid_mask =
                static_cast<TopkSubgroupMask>(
                    asc_ballot(invalid_topk ? 1 : 0));
            if (lane == 0 && invalid_mask != 0)
                tile_error = make_dispatch_protocol_failure(
                    transport_world_rank, DispatchProtocolStage::kProducer,
                    generation, DispatchProtocolError::kInvalidTopk)
                    .scratch_status;
        }
        if (lane < world_size)
            tile_counts[tile * world_size + lane] = destination_count;
        if (lane == 0)
            tile_errors[tile] = tile_error;
    }
}

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_producer_prefix_vf(
    __gm__ std::uint8_t* workspace,
    std::uintptr_t transport_local_window_base,
    int transport_world_rank, int transport_world_size,
    std::uint64_t generation, std::uint64_t shard_capacity,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t dispatch_error_offset,
    std::uint64_t dispatch_group_tile_offset,
    std::uint64_t dispatch_group_tile_count,
    std::uint64_t dispatch_group_expert_count_offset,
    std::uint64_t dispatch_group_expert_count,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t dispatch_route_plan_slot_bytes,
    std::uint64_t dispatch_route_plan_expert_capacity,
    std::uint64_t num_experts,
    std::uint64_t dispatch_group_error_offset) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::simt::load_observed(status) != 0)
        return;

    const std::uint32_t thread_index = threadIdx.x;
    const std::uint32_t world_size =
        static_cast<std::uint32_t>(transport_world_size);
    const std::uint32_t tile_count_u32 =
        static_cast<std::uint32_t>(dispatch_group_tile_count);
    const std::uint32_t group_width = world_size != 0 ?
        static_cast<std::uint32_t>(blockDim.x) / world_size : 0;
    const bool use_parallel_prefix = world_size != 0 && group_width != 0 &&
        static_cast<std::uint32_t>(blockDim.x) % world_size == 0 &&
        tile_count_u32 >= world_size * group_width;
    auto* destination_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* maximum_slots = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    auto* errors = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_error_offset);
    auto* tile_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_group_tile_offset);
    auto* expert_counts = reinterpret_cast<__gm__ std::uint32_t*>(
        workspace + dispatch_group_expert_count_offset);
    auto* route_plan_staging = reinterpret_cast<__gm__ std::uint8_t*>(
        transport_local_window_base + dispatch_staging_offset);
    auto* tile_errors = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_group_error_offset);

    std::uint64_t failure = 0;
    if (thread_index == 0) {
        for (std::uint32_t tile = 0; tile < tile_count_u32; ++tile) {
            if (tile_errors[tile] != 0) {
                failure = tile_errors[tile];
                break;
            }
        }
    }

    // The parallel prefix reuses the front of tile_errors for partial sums.
    // Ensure thread 0 has finished checking the previous stage before any
    // lane overwrites that storage.
    asc_syncthreads();

    if (use_parallel_prefix) {
        const std::uint32_t rank = thread_index / group_width;
        const std::uint32_t lane = thread_index % group_width;
        const std::uint32_t chunks_per_rank =
            (tile_count_u32 + group_width - 1U) / group_width;
        const std::uint32_t chunk_begin = lane * chunks_per_rank;
        const std::uint32_t chunk_end = chunk_begin + chunks_per_rank <
                tile_count_u32 ? chunk_begin + chunks_per_rank :
                tile_count_u32;
        std::uint64_t prefix = 0;
        if (rank < world_size) {
            for (std::uint32_t tile = chunk_begin; tile < chunk_end;
                 ++tile) {
                const std::uint32_t index = tile * world_size + rank;
                const std::uint64_t count = tile_counts[index];
                tile_counts[index] = prefix;
                prefix += count;
            }
            tile_errors[rank * group_width + lane] = prefix;
        }
        asc_syncthreads();
        if (rank < world_size && lane == 0) {
            std::uint64_t rank_prefix = 0;
            for (std::uint32_t chunk = 0; chunk < group_width; ++chunk) {
                const std::uint32_t partial_index =
                    rank * group_width + chunk;
                const std::uint64_t partial = tile_errors[partial_index];
                tile_errors[partial_index] = rank_prefix;
                rank_prefix += partial;
            }
            destination_counts[rank] = rank_prefix;
            maximum_slots[rank] = 0;
            if (dispatch_staging_offset != 0 &&
                dispatch_route_plan_slot_bytes <= dispatch_staging_shard_bytes) {
                auto* route_header =
                    reinterpret_cast<__gm__ DispatchRoutePlanSlotHeader*>(
                        route_plan_staging +
                        static_cast<std::uint64_t>(rank) *
                            dispatch_staging_shard_bytes);
                route_header->generation = generation;
                route_header->record_count = rank_prefix;
            }
            if (rank_prefix > shard_capacity)
                failure = make_dispatch_protocol_failure(
                    transport_world_rank, DispatchProtocolStage::kProducer,
                    generation, DispatchProtocolError::kCapacityOverflow)
                    .scratch_status;
            if (failure != 0)
                errors[rank] = failure;
        }
        asc_syncthreads();
        if (rank < world_size) {
            const std::uint64_t chunk_base =
                tile_errors[rank * group_width + lane];
            for (std::uint32_t tile = chunk_begin; tile < chunk_end;
                 ++tile) {
                const std::uint32_t index = tile * world_size + rank;
                tile_counts[index] += chunk_base;
            }
        }
        asc_syncthreads();
    } else if (thread_index < world_size) {
        std::uint64_t prefix = 0;
        for (std::uint32_t tile = 0; tile < tile_count_u32; ++tile) {
            const std::uint32_t index = tile * world_size + thread_index;
            const std::uint64_t count = tile_counts[index];
            tile_counts[index] = prefix;
            prefix += count;
        }
        destination_counts[thread_index] = prefix;
        maximum_slots[thread_index] = 0;
        if (dispatch_staging_offset != 0 &&
            dispatch_route_plan_slot_bytes <= dispatch_staging_shard_bytes) {
            auto* route_header =
                reinterpret_cast<__gm__ DispatchRoutePlanSlotHeader*>(
                    route_plan_staging +
                    static_cast<std::uint64_t>(thread_index) *
                        dispatch_staging_shard_bytes);
            route_header->generation = generation;
            route_header->record_count = prefix;
        }
        if (prefix > shard_capacity)
            failure = make_dispatch_protocol_failure(
                transport_world_rank, DispatchProtocolStage::kProducer,
                generation, DispatchProtocolError::kCapacityOverflow)
                .scratch_status;
        if (failure != 0)
            errors[thread_index] = failure;
    }

    const std::uint32_t storage_expert = threadIdx.x;
    const std::uint64_t expert_capacity =
        static_cast<std::uint64_t>(world_size) *
        dispatch_route_plan_expert_capacity;
    const std::uint64_t num_local_experts =
        num_experts / world_size;
    if (dispatch_group_expert_count == num_experts &&
        dispatch_staging_offset != 0 &&
        dispatch_route_plan_slot_bytes <= dispatch_staging_shard_bytes &&
        storage_expert < expert_capacity) {
        const std::uint32_t destination_rank = static_cast<std::uint32_t>(
            storage_expert / dispatch_route_plan_expert_capacity);
        const std::uint32_t local_expert = static_cast<std::uint32_t>(
            storage_expert % dispatch_route_plan_expert_capacity);
        auto* route_expert_counts =
            reinterpret_cast<__gm__ std::uint64_t*>(
                route_plan_staging +
                static_cast<std::uint64_t>(destination_rank) *
                    dispatch_staging_shard_bytes +
                sizeof(DispatchRoutePlanSlotHeader));
        std::uint64_t count = 0;
        if (local_expert < num_local_experts) {
            const std::uint64_t expert =
                destination_rank * num_local_experts + local_expert;
            count = expert_counts[expert];
        }
        route_expert_counts[local_expert] = count;
    }
}

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_publish_route_plan_vf(
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t dispatch_route_plan_offset,
    std::uint64_t dispatch_route_plan_slot_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t workspace_status_offset) {
    if (threadIdx.x != 0)
        return;
    const auto context = make_hybrid_dispatch_context(
        transport_abi_version, transport_struct_size,
        transport_capabilities, transport_local_window_base,
        transport_channel_table, transport_peer_address_table,
        transport_topology_abi_version, transport_topology_struct_size,
        transport_world_rank, transport_world_size,
        transport_scale_up_rank, transport_scale_up_size,
        transport_scale_out_rank, transport_scale_out_size,
        transport_scale_up_direct, transport_topology_kind,
        transport_topology_epoch, transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0 ||
        dispatch_route_plan_slot_bytes < sizeof(DispatchRoutePlanSlotHeader) ||
        dispatch_route_plan_slot_bytes > dispatch_staging_shard_bytes)
        return;

    transport.system_fence();
    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        const auto source = static_cast<transport::DeviceAddress>(
            transport_local_window_base + dispatch_staging_offset +
            static_cast<std::uint64_t>(destination_rank) *
                dispatch_staging_shard_bytes);
        const auto destination = static_cast<transport::DeviceAddress>(
            transport_local_window_base + dispatch_route_plan_offset +
            static_cast<std::uint64_t>(transport_world_rank) *
                dispatch_route_plan_slot_bytes);
        if (destination_rank == transport_world_rank) {
            auto* source_words = reinterpret_cast<__gm__ std::uint64_t*>(
                source);
            auto* destination_words = reinterpret_cast<__gm__ std::uint64_t*>(
                destination);
            const std::uint64_t word_count =
                dispatch_route_plan_slot_bytes / sizeof(std::uint64_t);
            for (std::uint64_t word = 1; word < word_count; ++word)
                destination_words[word] = source_words[word];
            transport.store_release(destination, generation);
            continue;
        }
        transport::TeamPeer route{};
        if (!transport::device::detail::checked_device_team_peer_for_world_rank(
                context.topology, destination_rank, &route)) {
            record_dispatch_protocol_error(
                context, status_address, destination_rank,
                DispatchProtocolStage::kProducer, generation,
                DispatchProtocolError::kInvalidControl);
            return;
        }
        transport.put(
            route.team, route.peer, destination, source,
            dispatch_route_plan_slot_bytes,
            transport::CooperationScope::kParticipant,
            transport::MemorySegment::kDevice,
            transport::kDefaultOptions,
            transport::RemoteAction::none());
    }
    release_protocol::flush_payload(transport);
    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        if (destination_rank == transport_world_rank)
            continue;
        transport::TeamPeer route{};
        if (!transport::device::detail::checked_device_team_peer_for_world_rank(
                context.topology, destination_rank, &route))
            return;
        transport.signal(
            route.team, route.peer,
            transport::RemoteAction::signal_set(
                transport::sync_layout::kDispatchRouteReadySignalIndex,
                generation));
    }
    // Drain the release signal, then align service progress before SIMT lanes
    // start polling route-ready state from every source rank.
    release_protocol::flush_payload(transport);
    const auto barrier_workspace = static_cast<transport::DeviceAddress>(
        transport_local_window_base + dispatch_route_plan_offset +
        static_cast<std::uint64_t>(transport_world_rank) *
            dispatch_route_plan_slot_bytes);
    transport.device_barrier(
        transport::kWorldTeamMask, barrier_workspace, timeout_cycles);
}

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_acquire_route_plan_vf(
    __gm__ std::uint8_t* workspace,
    __gm__ std::int32_t* prefix_per_rank,
    __gm__ std::int32_t* prefix_per_expert,
    __gm__ std::int32_t* unaligned_per_expert,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t num_experts, std::uint64_t expert_alignment,
    std::uint64_t shard_capacity,
    std::uint64_t dispatch_output_capacity,
    std::uint64_t dispatch_route_plan_offset,
    std::uint64_t dispatch_route_plan_slot_bytes,
    std::uint64_t dispatch_route_plan_expert_capacity,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_route_source_counts_offset,
    std::uint64_t workspace_rank_values_offset) {
    if (threadIdx.x != 0)
        return;
    const auto context = make_hybrid_dispatch_context(
        transport_abi_version, transport_struct_size,
        transport_capabilities, transport_local_window_base,
        transport_channel_table, transport_peer_address_table,
        transport_topology_abi_version, transport_topology_struct_size,
        transport_world_rank, transport_world_size,
        transport_scale_up_rank, transport_scale_up_size,
        transport_scale_out_rank, transport_scale_out_size,
        transport_scale_up_direct, transport_topology_kind,
        transport_topology_epoch, transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0 ||
        transport_world_size <= 0 || expert_alignment == 0 ||
        num_experts % static_cast<std::uint64_t>(transport_world_size) != 0)
        return;
    auto* source_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_route_source_counts_offset);
    auto* source_bases = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    const std::uint64_t local_experts =
        num_experts / static_cast<std::uint64_t>(transport_world_size);
    if (local_experts > dispatch_route_plan_expert_capacity) {
        record_dispatch_protocol_error(
            context, status_address, transport_world_rank,
            DispatchProtocolStage::kEpilogue, generation,
            DispatchProtocolError::kInvalidLayout);
        return;
    }

    std::uint64_t rank_prefix = 0;
    for (int source_rank = 0;
         source_rank < transport_world_size; ++source_rank) {
        if (source_rank != transport_world_rank &&
            !release_protocol::acquire_release(
                transport, context.topology, source_rank,
                transport::sync_layout::kDispatchRouteReadySignalIndex,
                generation, timeout_cycles)) {
            record_dispatch_protocol_error(
                context, status_address, source_rank,
                DispatchProtocolStage::kEpilogue, generation,
                DispatchProtocolError::kInvalidControl);
            return;
        }
        const auto slot = static_cast<transport::DeviceAddress>(
            transport_local_window_base + dispatch_route_plan_offset +
            static_cast<std::uint64_t>(source_rank) *
                dispatch_route_plan_slot_bytes);
        const std::uint64_t observed_generation =
            transport.load_acquire(slot);
        const std::uint64_t count = transport.load_acquire(
            slot + sizeof(std::uint64_t));
        if (observed_generation != generation || count > shard_capacity) {
            record_dispatch_protocol_error(
                context, status_address, source_rank,
                DispatchProtocolStage::kEpilogue, generation,
                count > shard_capacity ?
                    DispatchProtocolError::kCapacityOverflow :
                    DispatchProtocolError::kInvalidControl);
            return;
        }
        source_bases[source_rank] = rank_prefix;
        source_counts[source_rank] = count;
        rank_prefix += count;
        prefix_per_rank[source_rank] = static_cast<std::int32_t>(rank_prefix);
    }

    std::uint64_t expert_prefix = 0;
    const std::uint64_t first_local_expert =
        static_cast<std::uint64_t>(transport_world_rank) * local_experts;
    for (std::uint64_t expert = 0; expert < num_experts; ++expert) {
        std::uint64_t count = 0;
        if (expert >= first_local_expert &&
            expert < first_local_expert + local_experts) {
            const std::uint64_t local_expert = expert - first_local_expert;
            for (int source_rank = 0;
                 source_rank < transport_world_size; ++source_rank) {
                const auto count_address =
                    static_cast<transport::DeviceAddress>(
                        transport_local_window_base +
                        dispatch_route_plan_offset +
                        static_cast<std::uint64_t>(source_rank) *
                            dispatch_route_plan_slot_bytes +
                        sizeof(DispatchRoutePlanSlotHeader) +
                        local_expert * sizeof(std::uint64_t));
                count += transport.load_acquire(count_address);
            }
        }
        if (count > static_cast<std::uint64_t>(0x7fffffff)) {
            record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolStage::kEpilogue, generation,
                DispatchProtocolError::kCapacityOverflow);
            return;
        }
        prefix_per_expert[expert] = static_cast<std::int32_t>(expert_prefix);
        unaligned_per_expert[expert] = static_cast<std::int32_t>(count);
        const std::uint64_t aligned_count =
            (count + expert_alignment - 1) / expert_alignment *
            expert_alignment;
        if (aligned_count > dispatch_output_capacity ||
            expert_prefix > dispatch_output_capacity - aligned_count) {
            record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolStage::kEpilogue, generation,
                DispatchProtocolError::kCapacityOverflow);
            return;
        }
        expert_prefix += aligned_count;
    }
    prefix_per_expert[num_experts] =
        static_cast<std::int32_t>(expert_prefix);
}

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_reduce_errors_vf(
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint32_t protocol_stage,
    std::uint64_t workspace_status_offset,
    std::uint64_t dispatch_error_offset,
    std::uint64_t error_begin, std::uint64_t error_count) {
    if (threadIdx.x != 0)
        return;
    const auto context = make_hybrid_dispatch_context(
        transport_abi_version, transport_struct_size,
        transport_capabilities, transport_local_window_base,
        transport_channel_table, transport_peer_address_table,
        transport_topology_abi_version, transport_topology_struct_size,
        transport_world_rank, transport_world_size,
        transport_scale_up_rank, transport_scale_up_size,
        transport_scale_out_rank, transport_scale_out_size,
        transport_scale_up_direct, transport_topology_kind,
        transport_topology_epoch, transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    auto* errors = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_error_offset);
    const std::uint32_t error_count_u32 =
        static_cast<std::uint32_t>(error_count);
    for (std::uint32_t owner = 0; owner < error_count_u32; ++owner) {
        const auto decoded =
            decode_dispatch_protocol_scratch(errors[error_begin + owner]);
        if (!decoded.valid)
            continue;
        record_dispatch_protocol_error(
            context, status_address, decoded.world_rank,
            static_cast<DispatchProtocolStage>(protocol_stage),
            generation, decoded.error);
        return;
    }
}

DEEP_EP_ASCEND_SIMT_CALLEE void direct_dispatch_write_record(
    __gm__ const std::uint8_t* x,
    __gm__ const std::uint8_t* scale_factors,
    __gm__ const std::int64_t* topk_indices,
    __gm__ const float* topk_weights,
    __gm__ std::uint8_t* communication_buffer,
    std::uintptr_t transport_local_window_base,
    int transport_world_rank, int transport_world_size,
    std::uint32_t token, int destination_rank,
    std::int32_t master_lane, std::int32_t encoded_slot,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes,
    std::uint64_t hidden_copy_begin,
    std::uint64_t token_scale_factor_offset,
    std::uint64_t token_scale_factor_bytes,
    std::uint64_t scale_factor_token_stride,
    std::uint64_t scale_factor_pack_stride,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_topk_weight_offset,
    std::uint64_t token_source_metadata_offset) {
    const std::int32_t local_slot = decode_dispatch_local_index(
        encoded_slot, shard_capacity);
    __gm__ std::uint8_t* shard = nullptr;
    if (transport_world_size == 1) {
        shard = communication_buffer;
    } else if (destination_rank == transport_world_rank) {
        shard = reinterpret_cast<__gm__ std::uint8_t*>(
            transport_local_window_base + dispatch_receive_offset +
            static_cast<std::uint64_t>(transport_world_rank) *
                dispatch_receive_shard_bytes);
    } else {
        shard = reinterpret_cast<__gm__ std::uint8_t*>(
            transport_local_window_base + dispatch_staging_offset +
            static_cast<std::uint64_t>(destination_rank) *
                dispatch_staging_shard_bytes);
    }
    __gm__ std::uint8_t* record = shard +
        static_cast<std::uint64_t>(local_slot) * token_stride_bytes;
    for (std::uint64_t byte = hidden_copy_begin;
         byte < token_hidden_bytes; ++byte)
        record[token_hidden_offset + byte] =
            x[token * token_hidden_bytes + byte];
    for (std::uint64_t pack = 0;
         pack < token_scale_factor_bytes / 4; ++pack) {
        const std::uint64_t source_offset = scale_factor_byte_offset(
            token, pack, scale_factor_token_stride,
            scale_factor_pack_stride, 4);
        direct_dispatch_store_scale_factor_pack(
            record, token_scale_factor_offset + pack * 4,
            scale_factors, source_offset);
    }
    auto* record_topk = reinterpret_cast<__gm__ std::int64_t*>(
        record + token_topk_index_offset);
    auto* record_weights = reinterpret_cast<__gm__ float*>(
        record + token_topk_weight_offset);
    auto* record_metadata = reinterpret_cast<__gm__ std::int32_t*>(
        record + token_source_metadata_offset);
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    for (std::uint32_t lane = 0; lane < num_topk_u32; ++lane) {
        record_topk[lane] = topk_indices[token * num_topk + lane];
        record_weights[lane] = topk_weights == nullptr ? 0.0F :
            topk_weights[token * num_topk + lane];
        record_metadata[2 + lane] = -1;
    }
    record_metadata[0] = static_cast<std::int32_t>(token);
    record_metadata[1] = master_lane;
}

__aicore__ inline void direct_dispatch_producer_vector_payload_impl(
    __gm__ const std::uint8_t* x,
    __gm__ std::uint8_t* communication_buffer,
    __gm__ const std::uint8_t* workspace,
    __gm__ const std::int32_t* destination_slots,
    std::uintptr_t transport_local_window_base,
    int transport_world_rank, int transport_world_size,
    std::uint64_t num_tokens, std::uint64_t num_topk,
    std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t dispatch_group_owner_offset,
    std::uint64_t dispatch_group_tile_count,
    std::uint32_t launch_num_threads,
    std::uint64_t pipeline_chunk_begin,
    std::uint64_t pipeline_chunk_end,
    std::uint32_t pipeline_source_chunk,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes) {
    const auto* status = reinterpret_cast<__gm__ const std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::aicore::load_device(status) != 0)
        return;
    const std::uint64_t vector_bytes = token_hidden_bytes -
        token_hidden_bytes % kDispatchProducerVectorTileBytes;
    if (vector_bytes == 0)
        return;
    const std::uint32_t num_tokens_u32 =
        static_cast<std::uint32_t>(num_tokens);
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t tile_count_u32 =
        static_cast<std::uint32_t>(dispatch_group_tile_count);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> payload_buffer;
    (void)pipe.InitBuffer(
        payload_buffer, kDispatchProducerVectorTileBytes);
    auto payload_local = payload_buffer.Get<std::uint8_t>();
    AscendC::GlobalTensor<std::int32_t> owners_global;
    AscendC::GlobalTensor<std::int32_t> slots_global;
    AscendC::GlobalTensor<std::uint8_t> input_global;
    AscendC::GlobalTensor<std::uint8_t> output_global;
    const std::uint32_t world_size =
        static_cast<std::uint32_t>(transport_world_size);
    owners_global.SetGlobalBuffer(
        reinterpret_cast<__gm__ std::int32_t*>(
            const_cast<__gm__ std::uint8_t*>(workspace) +
            dispatch_group_owner_offset),
        num_tokens_u32 * world_size);
    slots_global.SetGlobalBuffer(
        const_cast<__gm__ std::int32_t*>(destination_slots),
        num_tokens_u32 * num_topk_u32);

    const std::uint32_t block_index =
        static_cast<std::uint32_t>(AscendC::GetBlockIdx());
    const std::uint32_t block_count =
        static_cast<std::uint32_t>(AscendC::GetBlockNum());
    const std::uint32_t subgroups_per_block =
        launch_num_threads / kTopkSubgroupWidth;
    const std::uint32_t tile_stride =
        block_count * subgroups_per_block;
    const std::uint32_t source_tile_begin = pipeline_source_chunk != 0 ?
        static_cast<std::uint32_t>(pipeline_chunk_begin) : 0;
    const std::uint32_t source_tile_end = pipeline_source_chunk != 0 ?
        static_cast<std::uint32_t>(pipeline_chunk_end) : tile_count_u32;
    for (std::uint32_t subgroup = 0; subgroup < subgroups_per_block;
         ++subgroup) {
        for (std::uint32_t tile =
                 source_tile_begin +
                 block_index * subgroups_per_block + subgroup;
             tile < source_tile_end; tile += tile_stride) {
            const std::uint32_t token_begin =
                tile * static_cast<std::uint32_t>(
                    kDispatchGroupingTokensPerTile);
            for (std::uint32_t local_token = 0;
                 local_token < kDispatchGroupingTokensPerTile;
                 ++local_token) {
                const std::uint32_t token = token_begin + local_token;
                if (token >= num_tokens_u32)
                    break;
                for (std::uint32_t rank = 0; rank < world_size; ++rank) {
                    const int destination_rank = static_cast<int>(rank);
                    const std::int32_t owner = owners_global.GetValue(
                        token * world_size + rank);
                    if (owner < 0)
                        continue;
                    const std::int32_t encoded_slot = slots_global.GetValue(
                        token * num_topk_u32 +
                            static_cast<std::uint32_t>(owner));
                    if (encoded_slot < 0)
                        continue;
                    const std::int32_t local_slot =
                        decode_dispatch_local_index(
                            encoded_slot, shard_capacity);
                    if (local_slot < 0 ||
                        (pipeline_source_chunk == 0 &&
                         (static_cast<std::uint64_t>(local_slot) <
                              pipeline_chunk_begin ||
                          static_cast<std::uint64_t>(local_slot) >=
                              pipeline_chunk_end)))
                        continue;
                    __gm__ std::uint8_t* shard = nullptr;
                    if (transport_world_size == 1) {
                        shard = communication_buffer;
                    } else if (destination_rank == transport_world_rank) {
                        shard = reinterpret_cast<__gm__ std::uint8_t*>(
                            transport_local_window_base +
                            dispatch_receive_offset +
                            static_cast<std::uint64_t>(
                                transport_world_rank) *
                                dispatch_receive_shard_bytes);
                    } else {
                        shard = reinterpret_cast<__gm__ std::uint8_t*>(
                            transport_local_window_base +
                            dispatch_staging_offset + rank *
                                dispatch_staging_shard_bytes);
                    }
                    __gm__ std::uint8_t* record = shard +
                        static_cast<std::uint64_t>(local_slot) *
                            token_stride_bytes;
                    for (std::uint64_t byte = 0; byte < vector_bytes;
                         byte += kDispatchProducerVectorTileBytes) {
                        input_global.SetGlobalBuffer(
                            const_cast<__gm__ std::uint8_t*>(x) +
                                token * token_hidden_bytes + byte,
                            kDispatchProducerVectorTileBytes);
                        output_global.SetGlobalBuffer(
                            record + token_hidden_offset + byte,
                            kDispatchProducerVectorTileBytes);
                        AscendC::DataCopy(
                            payload_local, input_global,
                            kDispatchProducerVectorTileBytes);
                        AscendC::SetFlag<
                            AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
                        AscendC::WaitFlag<
                            AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
                        AscendC::DataCopy(
                            output_global, payload_local,
                            kDispatchProducerVectorTileBytes);
                        AscendC::SetFlag<
                            AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
                        AscendC::WaitFlag<
                            AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
                    }
                }
            }
        }
    }
}

__aicore__ inline void direct_dispatch_producer_token_fanout_impl(
    __gm__ const std::uint8_t* x,
    __gm__ std::uint8_t* communication_buffer,
    __gm__ const std::uint8_t* workspace,
    __gm__ const std::int32_t* destination_slots,
    std::uintptr_t transport_local_window_base,
    int transport_world_rank, int transport_world_size,
    std::uint64_t num_tokens, std::uint64_t num_topk,
    std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t dispatch_group_owner_offset,
    std::uint64_t dispatch_group_tile_count,
    std::uint32_t launch_num_threads,
    std::uint64_t pipeline_chunk_begin,
    std::uint64_t pipeline_chunk_end,
    std::uint32_t pipeline_source_chunk,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes) {
    const auto* status = reinterpret_cast<__gm__ const std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::aicore::load_device(status) != 0)
        return;
    const std::uint64_t vector_bytes = token_hidden_bytes -
        token_hidden_bytes % kDispatchTokenFanoutAlignmentBytes;
    if (vector_bytes == 0 ||
        vector_bytes > kDispatchTokenFanoutBufferBytes)
        return;
    const std::uint32_t num_tokens_u32 =
        static_cast<std::uint32_t>(num_tokens);
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t tile_count_u32 =
        static_cast<std::uint32_t>(dispatch_group_tile_count);
    const std::uint32_t world_size =
        static_cast<std::uint32_t>(transport_world_size);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> payload_buffer;
    (void)pipe.InitBuffer(
        payload_buffer, kDispatchTokenFanoutBufferBytes);
    auto payload_local = payload_buffer.Get<std::uint8_t>();
    AscendC::GlobalTensor<std::int32_t> owners_global;
    AscendC::GlobalTensor<std::int32_t> slots_global;
    AscendC::GlobalTensor<std::uint8_t> input_global;
    AscendC::GlobalTensor<std::uint8_t> output_global;
    owners_global.SetGlobalBuffer(
        reinterpret_cast<__gm__ std::int32_t*>(
            const_cast<__gm__ std::uint8_t*>(workspace) +
            dispatch_group_owner_offset),
        num_tokens_u32 * world_size);
    slots_global.SetGlobalBuffer(
        const_cast<__gm__ std::int32_t*>(destination_slots),
        num_tokens_u32 * num_topk_u32);

    const std::uint32_t block_index =
        static_cast<std::uint32_t>(AscendC::GetBlockIdx());
    const std::uint32_t block_count =
        static_cast<std::uint32_t>(AscendC::GetBlockNum());
    const std::uint32_t subgroups_per_block =
        launch_num_threads / kTopkSubgroupWidth;
    const std::uint32_t tile_stride =
        block_count * subgroups_per_block;
    const std::uint32_t source_tile_begin = pipeline_source_chunk != 0 ?
        static_cast<std::uint32_t>(pipeline_chunk_begin) : 0;
    const std::uint32_t source_tile_end = pipeline_source_chunk != 0 ?
        static_cast<std::uint32_t>(pipeline_chunk_end) : tile_count_u32;
    for (std::uint32_t subgroup = 0; subgroup < subgroups_per_block;
         ++subgroup) {
        for (std::uint32_t tile = source_tile_begin +
                 block_index * subgroups_per_block + subgroup;
             tile < source_tile_end; tile += tile_stride) {
            const std::uint32_t token_begin =
                tile * static_cast<std::uint32_t>(
                    kDispatchGroupingTokensPerTile);
            for (std::uint32_t local_token = 0;
                 local_token < kDispatchGroupingTokensPerTile;
                 ++local_token) {
                const std::uint32_t token = token_begin + local_token;
                if (token >= num_tokens_u32)
                    break;
                input_global.SetGlobalBuffer(
                    const_cast<__gm__ std::uint8_t*>(x) +
                        static_cast<std::uint64_t>(token) *
                            token_hidden_bytes,
                    vector_bytes);
                AscendC::DataCopy(
                    payload_local, input_global, vector_bytes);
                AscendC::SetFlag<
                    AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
                AscendC::WaitFlag<
                    AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);

                for (std::uint32_t rank = 0; rank < world_size; ++rank) {
                    const int destination_rank = static_cast<int>(rank);
                    const std::int32_t owner = owners_global.GetValue(
                        token * world_size + rank);
                    if (owner < 0)
                        continue;
                    const std::int32_t encoded_slot = slots_global.GetValue(
                        token * num_topk_u32 +
                            static_cast<std::uint32_t>(owner));
                    if (encoded_slot < 0)
                        continue;
                    const std::int32_t local_slot =
                        decode_dispatch_local_index(
                            encoded_slot, shard_capacity);
                    if (local_slot < 0 ||
                        (pipeline_source_chunk == 0 &&
                         (static_cast<std::uint64_t>(local_slot) <
                              pipeline_chunk_begin ||
                          static_cast<std::uint64_t>(local_slot) >=
                              pipeline_chunk_end)))
                        continue;
                    __gm__ std::uint8_t* shard = nullptr;
                    if (transport_world_size == 1) {
                        shard = communication_buffer;
                    } else if (destination_rank == transport_world_rank) {
                        shard = reinterpret_cast<__gm__ std::uint8_t*>(
                            transport_local_window_base +
                            dispatch_receive_offset +
                            static_cast<std::uint64_t>(
                                transport_world_rank) *
                                dispatch_receive_shard_bytes);
                    } else {
                        shard = reinterpret_cast<__gm__ std::uint8_t*>(
                            transport_local_window_base +
                            dispatch_staging_offset + rank *
                                dispatch_staging_shard_bytes);
                    }
                    __gm__ std::uint8_t* record = shard +
                        static_cast<std::uint64_t>(local_slot) *
                            token_stride_bytes;
                    output_global.SetGlobalBuffer(
                        record + token_hidden_offset, vector_bytes);
                    AscendC::DataCopy(
                        output_global, payload_local, vector_bytes);
                }
                // All destination records consume the same resident token
                // payload.  Queue their GM stores first, then wait once
                // before the next source load can overwrite UB.
                AscendC::SetFlag<
                    AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
                AscendC::WaitFlag<
                    AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
            }
        }
    }
}

DEEP_EP_ASCEND_SIMT_CALLEE void direct_dispatch_producer_record_body(
    __gm__ const std::uint8_t* x,
    __gm__ const std::uint8_t* scale_factors,
    __gm__ const std::int64_t* topk_indices,
    __gm__ const float* topk_weights,
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ std::int32_t* destination_slots,
    std::uintptr_t transport_local_window_base,
    int transport_world_rank, int transport_world_size,
    CoreModeFlags mode_flags, std::uint32_t use_grouping,
    std::uint64_t num_tokens, std::uint64_t num_experts,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t dispatch_group_owner_offset,
    std::uint64_t dispatch_group_tile_offset,
    std::uint64_t dispatch_group_tile_count,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes,
    std::uint64_t hidden_copy_begin,
    std::uint64_t pipeline_chunk_begin,
    std::uint64_t pipeline_chunk_end,
    std::uint32_t pipeline_source_chunk,
    std::uint64_t token_scale_factor_offset,
    std::uint64_t token_scale_factor_bytes,
    std::uint64_t scale_factor_token_stride,
    std::uint64_t scale_factor_pack_stride,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_topk_weight_offset,
    std::uint64_t token_source_metadata_offset) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::simt::load_observed(status) != 0)
        return;
    const std::uint32_t num_tokens_u32 =
        static_cast<std::uint32_t>(num_tokens);
    const std::uint32_t num_experts_u32 =
        static_cast<std::uint32_t>(num_experts);
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t tile_count_u32 =
        static_cast<std::uint32_t>(dispatch_group_tile_count);
    const std::uint32_t world_size =
        static_cast<std::uint32_t>(transport_world_size);
    const std::uint32_t num_local_experts = num_experts_u32 / world_size;
    const bool cached = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const bool grouped = use_grouping != 0 &&
        num_topk <= kTopkSubgroupWidth &&
        transport_world_size <= static_cast<int>(kTopkSubgroupWidth);
    if (grouped) {
        auto* owners = reinterpret_cast<__gm__ const std::int32_t*>(
            workspace + dispatch_group_owner_offset);
        auto* tile_offsets = reinterpret_cast<__gm__ const std::uint64_t*>(
            workspace + dispatch_group_tile_offset);
        const auto grid = direct_subgroup_grid_stride(
            blockIdx.x, threadIdx.x, gridDim.x, blockDim.x,
            kTopkSubgroupWidth);
        const std::uint32_t lane = grid.lane;
        const std::uint32_t source_tile_begin = pipeline_source_chunk != 0 ?
            static_cast<std::uint32_t>(pipeline_chunk_begin) : 0;
        const std::uint32_t source_tile_end = pipeline_source_chunk != 0 ?
            static_cast<std::uint32_t>(pipeline_chunk_end) : tile_count_u32;
        for (std::uint32_t tile = source_tile_begin + grid.first;
             tile < source_tile_end; tile += grid.stride) {
            std::int32_t rank_cursor = 0;
            if (!cached && lane < world_size)
                rank_cursor = static_cast<std::int32_t>(
                    tile_offsets[tile * world_size + lane]);
            const std::uint32_t token_begin =
                tile * static_cast<std::uint32_t>(
                    kDispatchGroupingTokensPerTile);
            for (std::uint32_t local_token = 0;
                 local_token < kDispatchGroupingTokensPerTile;
                 ++local_token) {
                const std::uint32_t token = token_begin + local_token;
                if (token >= num_tokens_u32)
                    break;
                const std::int32_t rank_owner = lane < world_size ?
                    owners[token * world_size + lane] : -1;
                std::int32_t destination_rank = -1;
                std::uint32_t logical_index = 0;
                if (lane < num_topk_u32) {
                    logical_index = token * num_topk_u32 + lane;
                    const std::int64_t expert = topk_indices[logical_index];
                    if (expert >= 0 &&
                        static_cast<std::uint64_t>(expert) < num_experts_u32)
                        destination_rank = static_cast<std::int32_t>(
                            static_cast<std::uint64_t>(expert) /
                            num_local_experts);
                }
                const std::uint32_t source_lane = destination_rank >= 0 ?
                    static_cast<std::uint32_t>(destination_rank) : 0;
                const std::int32_t master_lane = asc_shfl(
                    rank_owner, source_lane, kTopkSubgroupWidth);
                const std::int32_t local_slot = asc_shfl(
                    rank_cursor, source_lane, kTopkSubgroupWidth);
                std::int32_t encoded_slot = -1;
                if (destination_rank >= 0) {
                    encoded_slot = cached ? destination_slots[logical_index] :
                        encode_dispatch_source_index(
                            static_cast<std::uint64_t>(transport_world_rank),
                            shard_capacity,
                            static_cast<std::uint64_t>(local_slot));
                    if (!cached)
                        destination_slots[logical_index] = encoded_slot;
                }
                if (destination_rank >= 0 &&
                    lane == static_cast<std::uint32_t>(master_lane) &&
                    local_slot >= 0 &&
                    (pipeline_source_chunk != 0 ||
                     (static_cast<std::uint64_t>(local_slot) >=
                          pipeline_chunk_begin &&
                      static_cast<std::uint64_t>(local_slot) <
                          pipeline_chunk_end)))
                    direct_dispatch_write_record(
                        x, scale_factors, topk_indices, topk_weights,
                        communication_buffer, transport_local_window_base,
                        transport_world_rank, transport_world_size,
                        token, destination_rank, master_lane, encoded_slot,
                        num_topk, shard_capacity, dispatch_receive_offset,
                        dispatch_receive_shard_bytes, dispatch_staging_offset,
                        dispatch_staging_shard_bytes, token_stride_bytes,
                        token_hidden_offset, token_hidden_bytes,
                        hidden_copy_begin,
                        token_scale_factor_offset, token_scale_factor_bytes,
                        scale_factor_token_stride, scale_factor_pack_stride,
                        token_topk_index_offset, token_topk_weight_offset,
                        token_source_metadata_offset);
                if (!cached && lane < world_size && rank_owner >= 0)
                    ++rank_cursor;
            }
        }
        return;
    }

    const std::uint32_t logical_count = num_tokens_u32 * world_size;
    const auto grid = direct_data_grid_stride(
        blockIdx.x, threadIdx.x, gridDim.x, blockDim.x);
    for (std::uint32_t logical = grid.first; logical < logical_count;
         logical += grid.stride) {
        const std::uint32_t token = logical / world_size;
        const int destination_rank =
            static_cast<int>(logical % world_size);
        std::int32_t master_lane = -1;
        std::int32_t encoded_slot = -1;
        for (std::uint32_t lane = 0; lane < num_topk_u32; ++lane) {
            const std::uint32_t index = token * num_topk_u32 + lane;
            const std::int64_t expert = topk_indices[index];
            if (expert < 0 ||
                static_cast<int>(static_cast<std::uint64_t>(expert) /
                                 num_local_experts) != destination_rank)
                continue;
            if (master_lane < 0) {
                master_lane = static_cast<std::int32_t>(lane);
                encoded_slot = destination_slots[index];
            }
        }
        const auto local_slot = decode_dispatch_local_index(
            encoded_slot, shard_capacity);
        if (master_lane >= 0 && local_slot >= 0 &&
            static_cast<std::uint64_t>(local_slot) >= pipeline_chunk_begin &&
            static_cast<std::uint64_t>(local_slot) < pipeline_chunk_end)
            direct_dispatch_write_record(
                x, scale_factors, topk_indices, topk_weights,
                communication_buffer, transport_local_window_base,
                transport_world_rank, transport_world_size,
                token, destination_rank, master_lane, encoded_slot,
                num_topk, shard_capacity, dispatch_receive_offset,
                dispatch_receive_shard_bytes, dispatch_staging_offset,
                dispatch_staging_shard_bytes, token_stride_bytes,
                token_hidden_offset, token_hidden_bytes, hidden_copy_begin,
                token_scale_factor_offset, token_scale_factor_bytes,
                scale_factor_token_stride, scale_factor_pack_stride,
                token_topk_index_offset, token_topk_weight_offset,
                token_source_metadata_offset);
    }
}

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_producer_record_vf(
    __gm__ const std::uint8_t* x,
    __gm__ const std::uint8_t* scale_factors,
    __gm__ const std::int64_t* topk_indices,
    __gm__ const float* topk_weights,
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ std::int32_t* destination_slots,
    std::uintptr_t transport_local_window_base,
    int transport_world_rank, int transport_world_size,
    CoreModeFlags mode_flags, std::uint32_t use_grouping,
    std::uint64_t num_tokens, std::uint64_t num_experts,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t dispatch_group_owner_offset,
    std::uint64_t dispatch_group_tile_offset,
    std::uint64_t dispatch_group_tile_count,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes,
    std::uint64_t hidden_copy_begin,
    std::uint64_t pipeline_chunk_begin,
    std::uint64_t pipeline_chunk_end,
    std::uint32_t pipeline_source_chunk,
    std::uint64_t token_scale_factor_offset,
    std::uint64_t token_scale_factor_bytes,
    std::uint64_t scale_factor_token_stride,
    std::uint64_t scale_factor_pack_stride,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_topk_weight_offset,
    std::uint64_t token_source_metadata_offset) {
    direct_dispatch_producer_record_body(
        x, scale_factors, topk_indices, topk_weights,
        communication_buffer, workspace, destination_slots,
        transport_local_window_base, transport_world_rank,
        transport_world_size, mode_flags, use_grouping, num_tokens,
        num_experts, num_topk, shard_capacity, dispatch_receive_offset,
        dispatch_receive_shard_bytes, dispatch_staging_offset,
        dispatch_staging_shard_bytes, workspace_status_offset,
        dispatch_group_owner_offset, dispatch_group_tile_offset,
        dispatch_group_tile_count, token_stride_bytes,
        token_hidden_offset, token_hidden_bytes, hidden_copy_begin,
        pipeline_chunk_begin, pipeline_chunk_end, pipeline_source_chunk,
        token_scale_factor_offset, token_scale_factor_bytes,
        scale_factor_token_stride, scale_factor_pack_stride,
        token_topk_index_offset, token_topk_weight_offset,
        token_source_metadata_offset);
}

__simt_vf__ __launch_bounds__(512) inline void
direct_dispatch_persistent_chunk_begin_vf(
    __gm__ std::uint8_t* workspace,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t generation,
    std::uint32_t source_chunk_count,
    std::uint32_t source_chunk_tiles,
    std::uint32_t source_chunk,
    std::uint32_t source_tile_begin,
    std::uint32_t source_tile_end) {
    if (threadIdx.x != 0)
        return;
    auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
        workspace + dispatch_pipeline_offset);
    if (blockIdx.x == 0 && source_chunk == 0) {
        transport::simt::store_published(
            &pipeline->abi_version, kDispatchPipelineAbiVersion);
        transport::simt::store_published(
            &pipeline->struct_size,
            static_cast<std::uint32_t>(sizeof(DispatchPipelineState)));
        transport::simt::store_published(
            &pipeline->chunk_count, source_chunk_count);
        transport::simt::store_published(
            &pipeline->completed_chunks, 0U);
        transport::simt::store_published(
            &pipeline->chunk_slots,
            static_cast<std::uint64_t>(source_chunk_tiles));
        transport::simt::store_published(
            reinterpret_cast<__gm__ std::uint32_t*>(
                &pipeline->terminal_error),
            static_cast<std::uint32_t>(
                transport::DeviceTransportError::kNone));
        transport::simt::store_published(
            &pipeline->release_completed_generation, std::uint64_t{0});
        for (std::uint32_t slot_index = 0;
             slot_index < kDispatchPipelineSlotCount; ++slot_index) {
            auto* slot = &pipeline->slots[slot_index];
            slot->chunk_begin = 0;
            slot->chunk_end = 0;
            slot->chunk_index = 0;
            slot->scalar_blocks_completed = 0;
            slot->hidden_blocks_completed = 0;
            slot->published_chunk = UINT32_MAX;
            transport::simt::store_published(
                reinterpret_cast<__gm__ std::uint32_t*>(&slot->state),
                static_cast<std::uint32_t>(
                    DispatchPipelineSlotState::kEmpty));
        }
        transport::simt::system_fence();
        transport::simt::store_published(&pipeline->generation, generation);
    } else {
        while (transport::simt::load_observed(&pipeline->generation) !=
               generation) {
            dispatch_simt_poll_nop();
        }
    }

    if (source_chunk == 0U) {
        transport::simt::store_published(
            reinterpret_cast<__gm__ std::uint32_t*>(
                &pipeline->release_worker_state),
            static_cast<std::uint32_t>(
                DispatchPipelineWorkerState::kRunning));
    }
    auto* slot = &pipeline->slots[dispatch_simt_pipeline_slot(source_chunk)];
    if (blockIdx.x == 0) {
        while (true) {
            dispatch_simt_poll_nop();
            const auto state = static_cast<DispatchPipelineSlotState>(
                transport::simt::load_observed(
                    reinterpret_cast<__gm__ std::uint32_t*>(
                        &slot->state)));
            const std::uint32_t published_chunk =
                transport::simt::load_observed(&slot->published_chunk);
            const bool reusable =
                (state == DispatchPipelineSlotState::kEmpty &&
                 source_chunk < kDispatchPipelineSlotCount) ||
                (state == DispatchPipelineSlotState::kCompleted &&
                 published_chunk <=
                     UINT32_MAX - kDispatchPipelineSlotCount &&
                 published_chunk + kDispatchPipelineSlotCount ==
                     source_chunk);
            if (reusable)
                break;
        }
        slot->chunk_begin = source_tile_begin;
        slot->chunk_end = source_tile_end;
        slot->chunk_index = source_chunk;
        slot->scalar_blocks_completed = 0;
        slot->hidden_blocks_completed = 0;
        slot->published_chunk = source_chunk;
        transport::simt::system_fence();
        transport::simt::store_published(
            reinterpret_cast<__gm__ std::uint32_t*>(&slot->state),
            static_cast<std::uint32_t>(
                DispatchPipelineSlotState::kProducing));
        return;
    }

    while (true) {
        dispatch_simt_poll_nop();
        const auto state = static_cast<DispatchPipelineSlotState>(
            transport::simt::load_observed(
                reinterpret_cast<__gm__ std::uint32_t*>(&slot->state)));
        const std::uint32_t published_chunk =
            transport::simt::load_observed(&slot->published_chunk);
        if (state == DispatchPipelineSlotState::kProducing &&
            published_chunk == source_chunk)
            return;
    }
}

__simt_vf__ __launch_bounds__(512) inline void
direct_dispatch_persistent_chunk_complete_vf(
    __gm__ std::uint8_t* workspace,
    std::uint64_t dispatch_pipeline_offset,
    std::uint32_t source_chunk) {
    if (threadIdx.x != 0)
        return;
    auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
        workspace + dispatch_pipeline_offset);
    auto* slot = &pipeline->slots[dispatch_simt_pipeline_slot(source_chunk)];
    const std::uint32_t producer_blocks = gridDim.x;
    transport::simt::system_fence();
    const std::uint32_t completed_blocks = asc_atomic_add(
        &slot->scalar_blocks_completed, 1U);
    if (dispatch_simt_pipeline_completion_is_last(
            completed_blocks, producer_blocks)) {
        transport::simt::system_fence();
        transport::simt::store_published(
            reinterpret_cast<__gm__ std::uint32_t*>(&slot->state),
            static_cast<std::uint32_t>(DispatchPipelineSlotState::kReady));
    }
    while (true) {
        dispatch_simt_poll_nop();
        const std::uint32_t published_chunk =
            transport::simt::load_observed(&slot->published_chunk);
        const auto state = static_cast<DispatchPipelineSlotState>(
            transport::simt::load_observed(
                reinterpret_cast<__gm__ std::uint32_t*>(&slot->state)));
        if (published_chunk == source_chunk &&
            state != DispatchPipelineSlotState::kProducing)
            return;
    }
}

__simt_vf__ __launch_bounds__(512) inline void
direct_dispatch_persistent_release_wait_vf(
    __gm__ std::uint8_t* workspace,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t generation,
    std::uint32_t source_chunk,
    std::uint32_t producer_blocks) {
    if (threadIdx.x != 0)
        return;
    auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
        workspace + dispatch_pipeline_offset);
    while (transport::simt::load_observed(&pipeline->generation) !=
           generation) {
        dispatch_simt_poll_nop();
    }
    auto* slot = &pipeline->slots[dispatch_simt_pipeline_slot(source_chunk)];
    while (true) {
        dispatch_simt_poll_nop();
        const auto state = static_cast<DispatchPipelineSlotState>(
            transport::simt::load_observed(
                reinterpret_cast<__gm__ std::uint32_t*>(&slot->state)));
        const std::uint32_t chunk_index =
            transport::simt::load_observed(&slot->chunk_index);
        const std::uint32_t published_chunk =
            transport::simt::load_observed(&slot->published_chunk);
        const std::uint32_t scalar_blocks =
            transport::simt::load_observed(
                &slot->scalar_blocks_completed);
        const std::uint32_t hidden_blocks =
            transport::simt::load_observed(
                &slot->hidden_blocks_completed);
        if (state == DispatchPipelineSlotState::kReady &&
            chunk_index == source_chunk &&
            published_chunk == source_chunk &&
            scalar_blocks == producer_blocks &&
            hidden_blocks == producer_blocks) {
            transport::simt::system_fence();
            return;
        }
        if (state == DispatchPipelineSlotState::kFailed)
            return;
    }
}

__simt_vf__ __launch_bounds__(512) inline void
direct_dispatch_persistent_release_complete_vf(
    __gm__ std::uint8_t* workspace,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t generation) {
    if (blockIdx.x != 0 || threadIdx.x != 0)
        return;
    auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
        workspace + dispatch_pipeline_offset);
    transport::simt::system_fence();
    transport::simt::store_published(
        &pipeline->release_completed_generation, generation);
    transport::simt::store_published(
        reinterpret_cast<__gm__ std::uint32_t*>(
            &pipeline->release_worker_state),
        static_cast<std::uint32_t>(DispatchPipelineWorkerState::kCompleted));
}

__simt_vf__ __launch_bounds__(512) inline void
direct_dispatch_persistent_release_tail_wait_vf(
    __gm__ std::uint8_t* workspace,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t generation) {
    if (blockIdx.x != 0 || threadIdx.x != 0)
        return;
    auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
        workspace + dispatch_pipeline_offset);
    while (transport::simt::load_observed(
               &pipeline->release_completed_generation) != generation) {
        dispatch_simt_poll_nop();
    }
    transport::simt::system_fence();
}

DEEP_EP_ASCEND_SIMT_CALLEE void direct_dispatch_pipeline_stage_simt(
    __gm__ DispatchPipelineState* pipeline,
    DispatchPipelineDiagnosticStage stage, std::uint32_t detail) {
    transport::simt::store_published(
        reinterpret_cast<__gm__ std::uint32_t*>(
            &pipeline->diagnostic_stage),
        static_cast<std::uint32_t>(stage));
    transport::simt::store_published(&pipeline->diagnostic_detail, detail);
}

DEEP_EP_ASCEND_SIMT_CALLEE void direct_dispatch_pipeline_fail_simt(
    __gm__ DispatchPipelineState* pipeline,
    __gm__ DispatchPipelineSlot* slot, __gm__ std::uint8_t* workspace,
    std::uint64_t workspace_status_offset, int world_rank,
    std::uint64_t generation, std::uint32_t detail) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::simt::load_observed(status) == 0) {
        const auto failure = make_dispatch_protocol_failure(
            world_rank, DispatchProtocolStage::kProducer, generation,
            DispatchProtocolError::kInvalidControl);
        transport::simt::store_published(status, failure.scratch_status);
    }
    transport::simt::store_published(
        reinterpret_cast<__gm__ std::uint32_t*>(
            &pipeline->terminal_error),
        static_cast<std::uint32_t>(
            transport::DeviceTransportError::kCompletionTimeout));
    transport::simt::store_published(&pipeline->diagnostic_detail, detail);
    if (slot != nullptr)
        transport::simt::store_published(
            reinterpret_cast<__gm__ std::uint32_t*>(&slot->state),
            static_cast<std::uint32_t>(
                DispatchPipelineSlotState::kFailed));
    transport::simt::store_published(
        reinterpret_cast<__gm__ std::uint32_t*>(
            &pipeline->producer_worker_state),
        static_cast<std::uint32_t>(
            DispatchPipelineWorkerState::kFailed));
    transport::simt::store_published(
        reinterpret_cast<__gm__ std::uint32_t*>(
            &pipeline->release_worker_state),
        static_cast<std::uint32_t>(
            DispatchPipelineWorkerState::kFailed));
    transport::simt::system_fence();
}

__simt_vf__ __launch_bounds__(512) inline void
direct_dispatch_persistent_producer_vf(
    __gm__ const std::uint8_t* x,
    __gm__ const std::uint8_t* scale_factors,
    __gm__ const std::int64_t* topk_indices,
    __gm__ const float* topk_weights,
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ std::int32_t* destination_slots,
    std::uintptr_t transport_local_window_base,
    int transport_world_rank, int transport_world_size,
    CoreModeFlags mode_flags, std::uint32_t use_grouping,
    std::uint64_t num_tokens, std::uint64_t num_experts,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t dispatch_group_owner_offset,
    std::uint64_t dispatch_group_tile_offset,
    std::uint64_t dispatch_group_tile_count,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes,
    std::uint64_t hidden_copy_begin,
    std::uint32_t source_chunk_tiles,
    std::uint32_t source_chunk_count,
    std::uint64_t token_scale_factor_offset,
    std::uint64_t token_scale_factor_bytes,
    std::uint64_t scale_factor_token_stride,
    std::uint64_t scale_factor_pack_stride,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_topk_weight_offset,
    std::uint64_t token_source_metadata_offset,
    std::uint64_t generation, std::uint64_t timeout_cycles) {
    auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
        workspace + dispatch_pipeline_offset);
    const std::uint32_t producer_blocks = gridDim.x;
    if (producer_blocks == 0 ||
        producer_blocks > kDispatchPipelineMaximumProducerBlocks)
        return;

    const std::uint64_t generation_wait_start = __asc_simt_vf::clock();
    while (transport::simt::load_observed(&pipeline->generation) !=
           generation) {
        dispatch_simt_poll_nop();
        if (static_cast<transport::DeviceTransportError>(
                transport::simt::load_observed(
                    reinterpret_cast<__gm__ std::uint32_t*>(
                        &pipeline->terminal_error))) !=
            transport::DeviceTransportError::kNone)
            return;
        if (threadIdx.x == 0 &&
            dispatch_simt_pipeline_wait_timed_out(
                generation_wait_start, __asc_simt_vf::clock(),
                timeout_cycles)) {
            direct_dispatch_pipeline_fail_simt(
                pipeline, nullptr, workspace, workspace_status_offset,
                transport_world_rank, generation, blockIdx.x << 16U);
            return;
        }
    }

    for (std::uint32_t source_chunk = 0;
         source_chunk < source_chunk_count; ++source_chunk) {
        const std::uint32_t source_tile_begin =
            source_chunk * source_chunk_tiles;
        const std::uint32_t source_tile_end =
            source_tile_begin + source_chunk_tiles <
                    dispatch_group_tile_count ?
                source_tile_begin + source_chunk_tiles :
                static_cast<std::uint32_t>(dispatch_group_tile_count);
        auto* slot = &pipeline->slots[
            dispatch_simt_pipeline_slot(source_chunk)];
        if (blockIdx.x == 0 && threadIdx.x == 0) {
            if (dispatch_simt_pipeline_producer_must_wait_for_reuse(
                    source_chunk)) {
                const std::uint64_t wait_start = __asc_simt_vf::clock();
                while (true) {
                    dispatch_simt_poll_nop();
                    const auto state = static_cast<DispatchPipelineSlotState>(
                        transport::simt::load_observed(
                            reinterpret_cast<__gm__ std::uint32_t*>(
                                &slot->state)));
                    const std::uint32_t published_chunk =
                        transport::simt::load_observed(
                            &slot->published_chunk);
                    const bool reusable =
                        state == DispatchPipelineSlotState::kCompleted &&
                        published_chunk <=
                            UINT32_MAX - kDispatchPipelineSlotCount &&
                        published_chunk + kDispatchPipelineSlotCount ==
                            source_chunk;
                    if (reusable)
                        break;
                    if (state == DispatchPipelineSlotState::kFailed)
                        return;
                    if (dispatch_simt_pipeline_wait_timed_out(
                            wait_start, __asc_simt_vf::clock(),
                            timeout_cycles)) {
                        direct_dispatch_pipeline_fail_simt(
                            pipeline, slot, workspace,
                            workspace_status_offset, transport_world_rank,
                            generation, source_chunk);
                        return;
                    }
                }
            }
            slot->chunk_begin = source_tile_begin;
            slot->chunk_end = source_tile_end;
            slot->chunk_index = source_chunk;
            slot->scalar_blocks_completed = 0;
            slot->hidden_blocks_completed = 0;
            slot->published_chunk = source_chunk;
            transport::simt::system_fence();
            transport::simt::store_published(
                reinterpret_cast<__gm__ std::uint32_t*>(&slot->state),
                static_cast<std::uint32_t>(
                    DispatchPipelineSlotState::kProducing));
        }
        direct_dispatch_producer_record_body(
            x, scale_factors, topk_indices, topk_weights,
            communication_buffer, workspace, destination_slots,
            transport_local_window_base, transport_world_rank,
            transport_world_size,
            mode_flags, use_grouping, num_tokens,
            num_experts, num_topk, shard_capacity, dispatch_receive_offset,
            dispatch_receive_shard_bytes, dispatch_staging_offset,
            dispatch_staging_shard_bytes, workspace_status_offset,
            dispatch_group_owner_offset, dispatch_group_tile_offset,
            dispatch_group_tile_count, token_stride_bytes,
            token_hidden_offset, token_hidden_bytes, hidden_copy_begin,
            source_tile_begin, source_tile_end, 1U,
            token_scale_factor_offset, token_scale_factor_bytes,
            scale_factor_token_stride, scale_factor_pack_stride,
            token_topk_index_offset, token_topk_weight_offset,
            token_source_metadata_offset);

        asc_syncthreads();
        if (threadIdx.x == 0) {
            auto* progress =
                &pipeline->scalar_progress[blockIdx.x][source_chunk];
            transport::simt::system_fence();
            transport::simt::store_published(
                &progress->generation, generation);
            transport::simt::system_fence();
        }
        // asc_vf_call does not run concurrently with the enclosing AICore
        // function.  Waiting for kReady here would therefore prevent the
        // manager from publishing kReady.  The per-chunk progress record is
        // retained until the manager consumes it after this VF returns.
    }
    if (blockIdx.x == 0 && threadIdx.x == 0) {
        if (static_cast<DispatchPipelineWorkerState>(
                transport::simt::load_observed(
                    reinterpret_cast<__gm__ std::uint32_t*>(
                        &pipeline->producer_worker_state))) ==
            DispatchPipelineWorkerState::kFailed)
            return;
        transport::simt::system_fence();
        transport::simt::store_published(
            &pipeline->producer_completed_generation, generation);
        transport::simt::store_published(
            reinterpret_cast<__gm__ std::uint32_t*>(
                &pipeline->producer_worker_state),
            static_cast<std::uint32_t>(
                DispatchPipelineWorkerState::kCompleted));
    }
}

DEEP_EP_ASCEND_SIMT_CALLEE void direct_dispatch_producer_release_body(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t dispatch_control_offset,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_local_count_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t dispatch_pipeline_bytes,
    std::uint64_t dispatch_group_tile_offset,
    std::uint64_t dispatch_group_tile_count,
    std::uint64_t pipeline_chunk_begin,
    std::uint64_t pipeline_chunk_end,
    std::uint32_t pipeline_chunk_index,
    std::uint32_t pipeline_final_chunk,
    std::uint32_t pipeline_source_chunk,
    std::uint64_t token_stride_bytes,
    std::uint32_t release_segment_value) {
    if (threadIdx.x != 0)
        return;
    const auto release_segment =
        static_cast<DirectReleaseSegment>(release_segment_value);
    const bool release_all = release_segment == DirectReleaseSegment::kAll;
    const bool release_payload =
        release_all || release_segment == DirectReleaseSegment::kPayload;
    const bool release_control =
        release_all || release_segment == DirectReleaseSegment::kControl;
    const bool release_barrier =
        release_all || release_segment == DirectReleaseSegment::kBarrier;
    const auto context = make_hybrid_dispatch_context(
        transport_abi_version, transport_struct_size,
        transport_capabilities, transport_local_window_base,
        transport_channel_table, transport_peer_address_table,
        transport_topology_abi_version, transport_topology_struct_size,
        transport_world_rank, transport_world_size,
        transport_scale_up_rank, transport_scale_up_size,
        transport_scale_out_rank, transport_scale_out_size,
        transport_scale_up_direct, transport_topology_kind,
        transport_topology_epoch, transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    auto* destination_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* tile_offsets = reinterpret_cast<__gm__ const std::uint64_t*>(
        workspace + dispatch_group_tile_offset);
    const std::uint64_t source_tile_begin = pipeline_chunk_begin;
    const std::uint64_t source_tile_end = pipeline_chunk_end;
    const std::uint64_t world_size =
        static_cast<std::uint64_t>(transport_world_size);
    if (transport_world_size == 1) {
        if (release_control && pipeline_final_chunk != 0)
            transport.store_release(
                reinterpret_cast<transport::DeviceAddress>(
                    workspace + workspace_local_count_offset),
                destination_counts[0]);
        return;
    }

    const bool pipeline_enabled = dispatch_pipeline_bytes ==
        sizeof(DispatchPipelineState);
    __gm__ DispatchPipelineSlot* pipeline_slot = nullptr;
    if (release_payload && pipeline_enabled) {
        auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
            workspace + dispatch_pipeline_offset);
        const auto slot_index =
            pipeline_chunk_index % kDispatchPipelineSlotCount;
        transport::simt::store_published(
            &pipeline->abi_version, kDispatchPipelineAbiVersion);
        transport::simt::store_published(
            &pipeline->struct_size,
            static_cast<std::uint32_t>(sizeof(DispatchPipelineState)));
        transport::simt::store_published(
            &pipeline->generation, generation);
        if (pipeline_chunk_index == 0) {
            transport::simt::store_published(
                &pipeline->chunk_slots,
                pipeline_chunk_end - pipeline_chunk_begin);
            transport::simt::store_published(
                &pipeline->completed_chunks, 0U);
            transport::simt::store_published(
                reinterpret_cast<__gm__ std::uint32_t*>(
                    &pipeline->terminal_error),
                static_cast<std::uint32_t>(
                    transport::DeviceTransportError::kNone));
        }
        if (pipeline_final_chunk != 0)
            transport::simt::store_published(
                &pipeline->chunk_count, pipeline_chunk_index + 1U);
        pipeline_slot = &pipeline->slots[slot_index];
        pipeline_slot->request.abi_version =
            transport::kDeviceRequestAbiVersion;
        pipeline_slot->request.state =
            transport::DeviceRequestState::kEmpty;
        pipeline_slot->request.command_begin = 0;
        pipeline_slot->request.command_end = 0;
        pipeline_slot->request.queue_generation = 0;
        pipeline_slot->request.consumed_target = 0;
        pipeline_slot->request.terminal_error =
            transport::DeviceTransportError::kNone;
        pipeline_slot->chunk_begin = pipeline_chunk_begin;
        pipeline_slot->chunk_end = pipeline_chunk_end;
        pipeline_slot->chunk_index = pipeline_chunk_index;
        pipeline_slot->state = DispatchPipelineSlotState::kInFlight;
    }

    auto* control_slots = reinterpret_cast<__gm__ DispatchControlSlot*>(
        transport_local_window_base + dispatch_control_offset);
    if (release_payload) {
        for (int destination_rank = 0;
             destination_rank < transport_world_size; ++destination_rank) {
            const std::uint64_t total_count =
                destination_counts[destination_rank];
            std::uint64_t chunk_slot_begin = pipeline_chunk_begin;
            std::uint64_t chunk_slot_end = total_count < pipeline_chunk_end ?
                total_count : pipeline_chunk_end;
            if (pipeline_source_chunk != 0) {
                chunk_slot_begin =
                    tile_offsets[source_tile_begin * world_size +
                                 static_cast<std::uint64_t>(destination_rank)];
                chunk_slot_end = source_tile_end ==
                        dispatch_group_tile_count ?
                    total_count :
                    tile_offsets[source_tile_end * world_size +
                                 static_cast<std::uint64_t>(destination_rank)];
            }
            const std::uint64_t count =
                chunk_slot_end > chunk_slot_begin ?
                    chunk_slot_end - chunk_slot_begin : 0;
            if (destination_rank == transport_world_rank) {
                if (release_all && pipeline_final_chunk != 0) {
                    transport.store_release(
                        reinterpret_cast<transport::DeviceAddress>(
                            &control_slots[transport_world_rank].count),
                        total_count);
                    transport.store_release(
                        reinterpret_cast<transport::DeviceAddress>(
                            &control_slots[transport_world_rank].generation),
                        generation);
                }
                continue;
            }
            transport::TeamPeer route{};
            if (!transport::device::detail::
                    checked_device_team_peer_for_world_rank(
                        context.topology, destination_rank, &route)) {
                record_dispatch_protocol_error(
                    context, status_address, destination_rank,
                    DispatchProtocolStage::kProducer, generation,
                    DispatchProtocolError::kInvalidControl);
                return;
            }
            if (count != 0) {
                const auto source = static_cast<transport::DeviceAddress>(
                        transport_local_window_base + dispatch_staging_offset +
                        static_cast<std::uint64_t>(destination_rank) *
                            dispatch_staging_shard_bytes +
                    chunk_slot_begin * token_stride_bytes);
                const auto destination = static_cast<transport::DeviceAddress>(
                        transport_local_window_base + dispatch_receive_offset +
                        static_cast<std::uint64_t>(transport_world_rank) *
                            dispatch_receive_shard_bytes +
                    chunk_slot_begin * token_stride_bytes);
                transport.put(
                    route.team, route.peer, destination, source,
                    count * token_stride_bytes,
                    transport::CooperationScope::kParticipant,
                    transport::MemorySegment::kDevice,
                    transport::kDefaultOptions,
                    transport::RemoteAction::none());
            }
        }
        if (pipeline_slot == nullptr) {
            release_protocol::flush_payload(transport);
        } else {
            transport.flush_async(
                transport::TransportTeam::kWorld, transport_world_rank,
                transport::CooperationScope::kDevice,
                &pipeline_slot->request);
        }
    }
    if (release_payload && pipeline_final_chunk == 0)
        return;
    if (release_control && !release_all) {
        transport.store_release(
            reinterpret_cast<transport::DeviceAddress>(
                &control_slots[transport_world_rank].count),
            destination_counts[transport_world_rank]);
        transport.store_release(
            reinterpret_cast<transport::DeviceAddress>(
                &control_slots[transport_world_rank].generation),
            generation);
    }
    if (release_control) {
        for (int destination_rank = 0;
             destination_rank < transport_world_size; ++destination_rank) {
            if (destination_rank == transport_world_rank)
                continue;
            const std::uint64_t count = destination_counts[destination_rank];
            transport::TeamPeer route{};
            if (!transport::device::detail::
                    checked_device_team_peer_for_world_rank(
                        context.topology, destination_rank, &route)) {
                record_dispatch_protocol_error(
                    context, status_address, destination_rank,
                    DispatchProtocolStage::kProducer, generation,
                    DispatchProtocolError::kInvalidControl);
                return;
            }
            const auto remote_slot = static_cast<transport::DeviceAddress>(
                transport_local_window_base + dispatch_control_offset +
                static_cast<std::uint64_t>(transport_world_rank) *
                    sizeof(DispatchControlSlot));
            release_protocol::publish_control_and_release(
                transport, route, remote_slot + sizeof(std::uint64_t), count,
                remote_slot, generation,
                transport::sync_layout::kDispatchReleaseSignalIndex);
        }
    }
    if (release_barrier)
        transport.device_barrier(
            transport::kWorldTeamMask,
            reinterpret_cast<transport::DeviceAddress>(
                &control_slots[transport_world_rank].generation),
            timeout_cycles);
}

#define DEEP_EP_ASCEND_DISPATCH_RELEASE_ARGUMENTS \
    communication_buffer, workspace, transport_abi_version, \
    transport_struct_size, transport_capabilities, \
    transport_local_window_base, transport_channel_table, \
    transport_peer_address_table, transport_topology_abi_version, \
    transport_topology_struct_size, transport_world_rank, \
    transport_world_size, transport_scale_up_rank, \
    transport_scale_up_size, transport_scale_out_rank, \
    transport_scale_out_size, transport_scale_up_direct, \
    transport_topology_kind, transport_topology_epoch, \
    transport_backend_context, generation, timeout_cycles, \
    dispatch_control_offset, dispatch_receive_offset, \
    dispatch_receive_shard_bytes, dispatch_staging_offset, \
    dispatch_staging_shard_bytes, workspace_status_offset, \
    workspace_local_count_offset, workspace_rank_counts_offset, \
    dispatch_pipeline_offset, dispatch_pipeline_bytes, \
    dispatch_group_tile_offset, dispatch_group_tile_count

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_producer_release_vf(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t dispatch_control_offset,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_local_count_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t dispatch_pipeline_bytes,
    std::uint64_t dispatch_group_tile_offset,
    std::uint64_t dispatch_group_tile_count,
    std::uint64_t pipeline_chunk_begin,
    std::uint64_t pipeline_chunk_end,
    std::uint32_t pipeline_chunk_index,
    std::uint32_t pipeline_final_chunk,
    std::uint32_t pipeline_source_chunk,
    std::uint64_t token_stride_bytes,
    std::uint32_t release_segment_value) {
    direct_dispatch_producer_release_body(
        DEEP_EP_ASCEND_DISPATCH_RELEASE_ARGUMENTS,
        pipeline_chunk_begin, pipeline_chunk_end, pipeline_chunk_index,
        pipeline_final_chunk, pipeline_source_chunk, token_stride_bytes,
        release_segment_value);
}

__simt_vf__ __launch_bounds__(512) inline void
direct_dispatch_persistent_release_vf(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t dispatch_control_offset,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_local_count_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t dispatch_pipeline_bytes,
    std::uint64_t dispatch_group_tile_offset,
    std::uint64_t dispatch_group_tile_count,
    std::uint32_t release_chunk_tiles,
    std::uint32_t release_chunk_count,
    std::uint32_t producer_blocks,
    std::uint64_t token_stride_bytes) {
    if (threadIdx.x != 0)
        return;
    auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
        workspace + dispatch_pipeline_offset);
    const auto context = make_hybrid_dispatch_context(
        transport_abi_version, transport_struct_size,
        transport_capabilities, transport_local_window_base,
        transport_channel_table, transport_peer_address_table,
        transport_topology_abi_version, transport_topology_struct_size,
        transport_world_rank, transport_world_size,
        transport_scale_up_rank, transport_scale_up_size,
        transport_scale_out_rank, transport_scale_out_size,
        transport_scale_up_direct, transport_topology_kind,
        transport_topology_epoch, transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    auto* queue = transport::device::detail::command_queue(context);
    auto* diagnostic = transport::device::detail::diagnostic(queue);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    const std::uint64_t generation_wait_start = __asc_simt_vf::clock();
    while (transport::simt::load_observed(&pipeline->generation) !=
           generation) {
        dispatch_simt_poll_nop();
        if (dispatch_simt_pipeline_wait_timed_out(
                generation_wait_start, __asc_simt_vf::clock(),
                timeout_cycles)) {
            record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolStage::kProducer, generation,
                DispatchProtocolError::kInvalidControl, 0U);
            direct_dispatch_pipeline_fail_simt(
                pipeline, nullptr, workspace, workspace_status_offset,
                transport_world_rank, generation, 0U);
            return;
        }
    }
    if (static_cast<transport::DeviceTransportError>(
            transport::simt::load_observed(
                reinterpret_cast<__gm__ std::uint32_t*>(
                    &pipeline->terminal_error))) !=
        transport::DeviceTransportError::kNone)
        return;
    direct_dispatch_pipeline_stage_simt(
        pipeline, DispatchPipelineDiagnosticStage::kReleaseStarted, 0U);

    for (std::uint32_t release_chunk = 0;
         release_chunk < release_chunk_count; ++release_chunk) {
        auto* slot = &pipeline->slots[
            dispatch_simt_pipeline_slot(release_chunk)];
        const std::uint64_t ready_wait_start = __asc_simt_vf::clock();
        while (true) {
            dispatch_simt_poll_nop();
            const auto state = static_cast<DispatchPipelineSlotState>(
                transport::simt::load_observed(
                    reinterpret_cast<__gm__ std::uint32_t*>(&slot->state)));
            const std::uint32_t scalar_blocks =
                transport::simt::load_observed(
                    &slot->scalar_blocks_completed);
            const std::uint32_t hidden_blocks =
                transport::simt::load_observed(
                    &slot->hidden_blocks_completed);
            if (state == DispatchPipelineSlotState::kReady &&
                transport::simt::load_observed(&slot->chunk_index) ==
                    release_chunk &&
                transport::simt::load_observed(&slot->published_chunk) ==
                    release_chunk &&
                scalar_blocks == producer_blocks &&
                hidden_blocks == producer_blocks) {
                direct_dispatch_pipeline_stage_simt(
                    pipeline,
                    DispatchPipelineDiagnosticStage::kReleaseSawPayloadReady,
                    release_chunk);
                break;
            }
            if (state == DispatchPipelineSlotState::kFailed ||
                static_cast<DispatchPipelineWorkerState>(
                    transport::simt::load_observed(
                        reinterpret_cast<__gm__ std::uint32_t*>(
                            &pipeline->producer_worker_state))) ==
                    DispatchPipelineWorkerState::kFailed) {
                transport::simt::store_published(
                    reinterpret_cast<__gm__ std::uint32_t*>(
                        &pipeline->release_worker_state),
                    static_cast<std::uint32_t>(
                        DispatchPipelineWorkerState::kFailed));
                return;
            }
            if (dispatch_simt_pipeline_wait_timed_out(
                    ready_wait_start, __asc_simt_vf::clock(),
                    timeout_cycles)) {
                record_dispatch_protocol_error(
                    context, status_address, transport_world_rank,
                    DispatchProtocolStage::kProducer, generation,
                    DispatchProtocolError::kInvalidControl, release_chunk);
                direct_dispatch_pipeline_fail_simt(
                    pipeline, slot, workspace, workspace_status_offset,
                    transport_world_rank, generation, release_chunk);
                return;
            }
        }
        const std::uint64_t chunk_begin =
            static_cast<std::uint64_t>(release_chunk) * release_chunk_tiles;
        const std::uint64_t chunk_end =
            chunk_begin + release_chunk_tiles < dispatch_group_tile_count ?
                chunk_begin + release_chunk_tiles :
                dispatch_group_tile_count;
        direct_dispatch_producer_release_body(
            DEEP_EP_ASCEND_DISPATCH_RELEASE_ARGUMENTS,
            chunk_begin, chunk_end, release_chunk,
            release_chunk + 1U == release_chunk_count ? 1U : 0U,
            1U, token_stride_bytes,
            static_cast<std::uint32_t>(DirectReleaseSegment::kPayload));
        if (transport_world_size > 1) {
            const std::uint32_t batch_target =
                transport::simt::load_observed(
                    &slot->request.consumed_target);
            transport::simt::system_fence();
            transport::simt::store_published(
                &pipeline->release_batch_target, batch_target);
            direct_dispatch_pipeline_stage_simt(
                pipeline,
                DispatchPipelineDiagnosticStage::kReleaseBatchTargetPublished,
                release_chunk);
            const std::uint64_t batch_wait_start = __asc_simt_vf::clock();
            while (!dispatch_simt_pipeline_release_batch_acknowledged(
                batch_target,
                transport::simt::load_observed(
                    &pipeline->release_batch_consumed))) {
                dispatch_simt_poll_nop();
                if (static_cast<DispatchPipelineWorkerState>(
                        transport::simt::load_observed(
                            reinterpret_cast<__gm__ std::uint32_t*>(
                                &pipeline->release_worker_state))) ==
                    DispatchPipelineWorkerState::kFailed)
                    return;
                if (dispatch_simt_pipeline_wait_timed_out(
                    batch_wait_start, __asc_simt_vf::clock(),
                        timeout_cycles)) {
                    record_dispatch_protocol_error(
                        context, status_address, transport_world_rank,
                        DispatchProtocolStage::kProducer, generation,
                        DispatchProtocolError::kInvalidControl,
                        release_chunk);
                    direct_dispatch_pipeline_fail_simt(
                        pipeline, slot, workspace, workspace_status_offset,
                        transport_world_rank, generation, release_chunk);
                    return;
                }
            }
            transport.wait(&slot->request);
            if (slot->request.state !=
                    transport::DeviceRequestState::kCompleted) {
                transport::simt::store_published(
                    reinterpret_cast<__gm__ std::uint32_t*>(
                        &slot->state),
                    static_cast<std::uint32_t>(
                        DispatchPipelineSlotState::kFailed));
                transport::simt::store_published(
                    reinterpret_cast<__gm__ std::uint32_t*>(
                        &pipeline->terminal_error),
                    static_cast<std::uint32_t>(
                        slot->request.terminal_error));
                transport::simt::store_published(
                    reinterpret_cast<__gm__ std::uint32_t*>(
                        &pipeline->release_worker_state),
                    static_cast<std::uint32_t>(
                        DispatchPipelineWorkerState::kFailed));
                transport::simt::store_published(
                    reinterpret_cast<__gm__ std::uint32_t*>(
                        &pipeline->producer_worker_state),
                    static_cast<std::uint32_t>(
                        DispatchPipelineWorkerState::kFailed));
                return;
            }
            direct_dispatch_pipeline_stage_simt(
                pipeline, DispatchPipelineDiagnosticStage::kRequestCompleted,
                release_chunk);
        }
        transport::simt::system_fence();
        transport::simt::store_published(
            reinterpret_cast<__gm__ std::uint32_t*>(&slot->state),
            static_cast<std::uint32_t>(
                DispatchPipelineSlotState::kCompleted));
        const std::uint32_t completed_chunks =
            transport::simt::load_observed(&pipeline->completed_chunks);
        transport::simt::store_published(
            &pipeline->completed_chunks, completed_chunks + 1U);
    }

    const std::uint64_t final_chunk_begin =
        static_cast<std::uint64_t>(release_chunk_count - 1U) *
            release_chunk_tiles;
    const std::uint64_t final_chunk_end = dispatch_group_tile_count;
    direct_dispatch_producer_release_body(
        DEEP_EP_ASCEND_DISPATCH_RELEASE_ARGUMENTS,
        final_chunk_begin, final_chunk_end, release_chunk_count - 1U,
        1U, 1U, token_stride_bytes,
        static_cast<std::uint32_t>(DirectReleaseSegment::kControl));
    direct_dispatch_producer_release_body(
        DEEP_EP_ASCEND_DISPATCH_RELEASE_ARGUMENTS,
        final_chunk_begin, final_chunk_end, release_chunk_count - 1U,
        1U, 1U, token_stride_bytes,
        static_cast<std::uint32_t>(DirectReleaseSegment::kBarrier));
    if (transport_world_size > 1 && queue != nullptr) {
        const std::uint32_t final_target =
            transport::simt::load_observed(&queue->count);
        transport::simt::system_fence();
        transport::simt::store_published(
            &pipeline->release_batch_target, final_target);
        direct_dispatch_pipeline_stage_simt(
            pipeline,
            DispatchPipelineDiagnosticStage::kFinalBatchTargetPublished,
            final_target);
        const std::uint64_t final_wait_start = __asc_simt_vf::clock();
        while (!dispatch_simt_pipeline_release_batch_acknowledged(
            final_target,
            transport::simt::load_observed(
                &pipeline->release_batch_consumed))) {
            dispatch_simt_poll_nop();
            if (static_cast<DispatchPipelineWorkerState>(
                    transport::simt::load_observed(
                        reinterpret_cast<__gm__ std::uint32_t*>(
                            &pipeline->release_worker_state))) ==
                DispatchPipelineWorkerState::kFailed)
                return;
            if (dispatch_simt_pipeline_wait_timed_out(
                final_wait_start, __asc_simt_vf::clock(),
                timeout_cycles)) {
                record_dispatch_protocol_error(
                    context, status_address, transport_world_rank,
                    DispatchProtocolStage::kProducer, generation,
                    DispatchProtocolError::kInvalidControl, final_target);
                direct_dispatch_pipeline_fail_simt(
                    pipeline, nullptr, workspace, workspace_status_offset,
                    transport_world_rank, generation, final_target);
                return;
            }
        }
    }
    if (diagnostic != nullptr &&
        static_cast<transport::DeviceTransportError>(
            transport::simt::load_observed(
                reinterpret_cast<__gm__ std::uint32_t*>(
                    &diagnostic->error))) !=
            transport::DeviceTransportError::kNone) {
        transport::simt::store_published(
            reinterpret_cast<__gm__ std::uint32_t*>(
                &pipeline->release_worker_state),
            static_cast<std::uint32_t>(
                DispatchPipelineWorkerState::kFailed));
        return;
    }
    transport::simt::system_fence();
    transport::simt::store_published(
        &pipeline->release_completed_generation, generation);
    direct_dispatch_pipeline_stage_simt(
        pipeline, DispatchPipelineDiagnosticStage::kReleaseCompleted, 0U);
    transport::simt::store_published(
        reinterpret_cast<__gm__ std::uint32_t*>(
            &pipeline->release_worker_state),
        static_cast<std::uint32_t>(
            DispatchPipelineWorkerState::kCompleted));
}

#undef DEEP_EP_ASCEND_DISPATCH_RELEASE_ARGUMENTS

__simt_vf__ __launch_bounds__(512) inline void
direct_dispatch_pipeline_wait_vf(
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t dispatch_pipeline_offset,
    std::uint32_t pipeline_chunk_index) {
    if (threadIdx.x != 0)
        return;
    const auto context = make_hybrid_dispatch_context(
        transport_abi_version, transport_struct_size,
        transport_capabilities, transport_local_window_base,
        transport_channel_table, transport_peer_address_table,
        transport_topology_abi_version, transport_topology_struct_size,
        transport_world_rank, transport_world_size,
        transport_scale_up_rank, transport_scale_up_size,
        transport_scale_out_rank, transport_scale_out_size,
        transport_scale_up_direct, transport_topology_kind,
        transport_topology_epoch, transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
        workspace + dispatch_pipeline_offset);
    auto* slot = &pipeline->slots[
        pipeline_chunk_index % kDispatchPipelineSlotCount];
    transport.wait(&slot->request);
    if (slot->request.state == transport::DeviceRequestState::kCompleted) {
        transport::simt::store_published(
            reinterpret_cast<__gm__ std::uint32_t*>(&slot->state),
            static_cast<std::uint32_t>(
                DispatchPipelineSlotState::kCompleted));
        const auto completed_chunks = transport::simt::load_observed(
            &pipeline->completed_chunks);
        transport::simt::store_published(
            &pipeline->completed_chunks, completed_chunks + 1U);
        return;
    }
    transport::simt::store_published(
        reinterpret_cast<__gm__ std::uint32_t*>(&slot->state),
        static_cast<std::uint32_t>(DispatchPipelineSlotState::kFailed));
    transport::simt::store_published(
        reinterpret_cast<__gm__ std::uint32_t*>(
            &pipeline->terminal_error),
        static_cast<std::uint32_t>(slot->request.terminal_error));
}

__simt_vf__ __launch_bounds__(512) inline void hybrid_dispatch_forward_vf(
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t num_experts, std::uint64_t shard_capacity,
    std::uint64_t ingress_control_offset,
    std::uint64_t ingress_shard_offset,
    std::uint64_t ingress_shard_bytes,
    std::uint64_t forward_control_offset,
    std::uint64_t forward_shard_offset,
    std::uint64_t forward_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_source_metadata_offset) {
    if (threadIdx.x != 0)
        return;
    const auto context = make_hybrid_dispatch_context(
        transport_abi_version, transport_struct_size, transport_capabilities,
        transport_local_window_base, transport_channel_table,
        transport_peer_address_table, transport_topology_abi_version,
        transport_topology_struct_size, transport_world_rank,
        transport_world_size, transport_scale_up_rank,
        transport_scale_up_size, transport_scale_out_rank,
        transport_scale_out_size, transport_scale_up_direct,
        transport_topology_kind, transport_topology_epoch,
        transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    const auto preserved_status = transport.load_acquire(status_address);
    if (preserved_status != 0) {
        const auto producer_failure =
            decode_dispatch_protocol_scratch(preserved_status);
        const bool valid_producer_failure =
            producer_failure.valid &&
            producer_failure.world_rank >= 0 &&
            producer_failure.world_rank < transport_world_size;
        return record_dispatch_protocol_error(
            context, status_address,
            valid_producer_failure ? producer_failure.world_rank :
                                     transport_world_rank,
            DispatchProtocolStage::kProducer, generation,
            valid_producer_failure ? producer_failure.error :
                                     DispatchProtocolError::kInvalidControl);
    }
    auto* ingress_control = reinterpret_cast<__gm__ DispatchControlSlot*>(
        transport_local_window_base + ingress_control_offset);
    const std::uint64_t num_local_experts =
        num_experts / static_cast<std::uint64_t>(transport_world_size);
    for (int origin_rank = 0; origin_rank < transport_world_size;
         ++origin_rank) {
        if (origin_rank == transport_world_rank ||
            origin_rank % transport_scale_up_size != transport_scale_up_rank)
            continue;
        const std::uint64_t observed_generation =
            transport.load_acquire(reinterpret_cast<transport::DeviceAddress>(
                &ingress_control[origin_rank].generation));
        const std::uint64_t input_count =
            transport.load_acquire(reinterpret_cast<transport::DeviceAddress>(
                &ingress_control[origin_rank].count));
        if (observed_generation != generation || input_count > shard_capacity)
            return record_dispatch_protocol_error(
                context, status_address, origin_rank,
                DispatchProtocolStage::kForward, generation,
                observed_generation != generation ?
                    DispatchProtocolError::kInvalidControl :
                    DispatchProtocolError::kCapacityOverflow);
        auto* input_shard = reinterpret_cast<__gm__ std::uint8_t*>(
            transport_local_window_base + ingress_shard_offset +
            static_cast<std::uint64_t>(origin_rank) * ingress_shard_bytes);
        auto* output_shard = reinterpret_cast<__gm__ std::uint8_t*>(
            transport_local_window_base + forward_shard_offset +
            static_cast<std::uint64_t>(origin_rank) * forward_shard_bytes);
        for (int destination_rank =
                 transport_scale_out_rank * transport_scale_up_size;
             destination_rank <
                 (transport_scale_out_rank + 1) * transport_scale_up_size;
             ++destination_rank) {
            if (destination_rank == transport_world_rank)
                continue;
            std::uint64_t output_count = 0;
            for (std::uint64_t input_slot = 0;
                 input_slot < input_count; ++input_slot) {
                auto* input = input_shard + input_slot * token_stride_bytes;
                auto* metadata = reinterpret_cast<__gm__ std::int32_t*>(
                    input + token_source_metadata_offset);
                auto* topk = reinterpret_cast<__gm__ const std::int64_t*>(
                    input + token_topk_index_offset);
                const std::int32_t master_lane = metadata[1];
                const int record_destination = static_cast<int>(
                    static_cast<std::uint64_t>(topk[master_lane]) /
                    num_local_experts);
                if (record_destination != destination_rank)
                    continue;
                auto* output = output_shard +
                    output_count * token_stride_bytes;
                for (std::uint64_t byte = 0; byte < token_stride_bytes; ++byte)
                    output[byte] = input[byte];
                auto* output_metadata =
                    reinterpret_cast<__gm__ std::int32_t*>(
                        output + token_source_metadata_offset);
                output_metadata[2 + master_lane] = static_cast<std::int32_t>(
                    static_cast<std::uint64_t>(origin_rank) * shard_capacity +
                    input_slot);
                ++output_count;
            }
            transport.system_fence();
            transport::TeamPeer route{
                transport::TransportTeam::kScaleUp,
                destination_rank % transport_scale_up_size,
                destination_rank};
            if (output_count != 0) {
                transport.put(
                    transport::TransportTeam::kScaleUp, route.peer,
                    transport_local_window_base + forward_shard_offset +
                        static_cast<std::uint64_t>(origin_rank) *
                            forward_shard_bytes,
                    reinterpret_cast<transport::DeviceAddress>(output_shard),
                    output_count * token_stride_bytes,
                    transport::CooperationScope::kParticipant,
                    transport::MemorySegment::kDevice,
                    transport::kDefaultOptions,
                    transport::RemoteAction::none());
            }
            release_protocol::flush_payload(transport);
            const auto remote_slot = transport_local_window_base +
                forward_control_offset +
                static_cast<std::uint64_t>(origin_rank) *
                    sizeof(DispatchControlSlot);
            release_protocol::publish_control_and_release(
                transport, route, remote_slot + sizeof(std::uint64_t),
                output_count, remote_slot, generation,
                transport::sync_layout::kDispatchReleaseSignalIndex);
        }
    }
    transport.device_barrier(
        transport::kWorldTeamMask,
        reinterpret_cast<transport::DeviceAddress>(
            &ingress_control[transport_world_rank].generation),
        timeout_cycles);
}

__simt_vf__ __launch_bounds__(512) inline void hybrid_dispatch_prepare_epilogue_vf(
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t shard_capacity,
    std::uint64_t dispatch_control_offset,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t forward_control_offset,
    std::uint64_t forward_shard_offset,
    std::uint64_t forward_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t token_stride_bytes) {
    if (threadIdx.x != 0)
        return;
    const auto context = make_hybrid_dispatch_context(
        transport_abi_version, transport_struct_size, transport_capabilities,
        transport_local_window_base, transport_channel_table,
        transport_peer_address_table, transport_topology_abi_version,
        transport_topology_struct_size, transport_world_rank,
        transport_world_size, transport_scale_up_rank,
        transport_scale_up_size, transport_scale_out_rank,
        transport_scale_out_size, transport_scale_up_direct,
        transport_topology_kind, transport_topology_epoch,
        transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    auto* direct_control = reinterpret_cast<__gm__ DispatchControlSlot*>(
        transport_local_window_base + dispatch_control_offset);
    auto* forward_control = reinterpret_cast<__gm__ DispatchControlSlot*>(
        transport_local_window_base + forward_control_offset);
    for (int origin_rank = 0; origin_rank < transport_world_size;
         ++origin_rank) {
        const auto route = classify_world_route(
            origin_rank, transport_world_rank, transport_scale_up_size);
        if (route.kind != WorldRouteKind::kDiagonal)
            continue;
        const auto release_boundary = dispatch_prepare_release_boundary(
            origin_rank, transport_world_rank, transport_scale_up_size);
        const auto observation = release_protocol::observe_release_control(
            transport, context.topology, release_boundary,
            transport_world_rank, forward_control,
            transport::sync_layout::kDispatchReleaseSignalIndex,
            generation, timeout_cycles);
        if (!observation.acquired)
            return record_dispatch_protocol_error(
                context, status_address, origin_rank,
                DispatchProtocolStage::kPrepareEpilogue, generation,
                DispatchProtocolError::kInvalidControl);
        const std::uint64_t observed_generation = observation.generation;
        const std::uint64_t count = observation.count;
        const auto validation = validate_hybrid_route_control(
            generation, observed_generation, count, shard_capacity);
        if (validation != DispatchProtocolError::kNone)
            return record_dispatch_protocol_error(
                context, status_address, origin_rank,
                DispatchProtocolStage::kPrepareEpilogue, generation,
                validation);
        auto* source = reinterpret_cast<__gm__ const std::uint8_t*>(
            transport_local_window_base + forward_shard_offset +
            static_cast<std::uint64_t>(origin_rank) * forward_shard_bytes);
        auto* destination = reinterpret_cast<__gm__ std::uint8_t*>(
            transport_local_window_base + dispatch_receive_offset +
            static_cast<std::uint64_t>(origin_rank) *
                dispatch_receive_shard_bytes);
        for (std::uint64_t byte = 0; byte < count * token_stride_bytes; ++byte)
            destination[byte] = source[byte];
        release_protocol::publish_local_control(
            transport,
            reinterpret_cast<transport::DeviceAddress>(
                &direct_control[origin_rank].count),
            count,
            reinterpret_cast<transport::DeviceAddress>(
                &direct_control[origin_rank].generation),
            generation);
    }
}

__simt_vf__ __launch_bounds__(512) inline void hybrid_dispatch_record_routes_vf(
    __gm__ std::uint8_t* workspace,
    __gm__ HybridRouteRecord* route_records,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_backend_context,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_size, std::uint64_t topology_epoch,
    std::uint64_t generation, std::uint64_t num_experts,
    std::uint64_t shard_capacity, std::uint64_t route_record_capacity,
    std::uint64_t dispatch_control_offset,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_source_metadata_offset) {
    if (threadIdx.x != 0)
        return;
    transport::DeviceTransportContext context{};
    context.abi_version = transport::kDeviceTransportAbiVersion;
    context.struct_size = sizeof(transport::DeviceTransportContext);
    context.backend_context = transport_backend_context;
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    auto* control = reinterpret_cast<__gm__ const DispatchControlSlot*>(
        transport_local_window_base + dispatch_control_offset);
    const std::uint64_t local_experts =
        num_experts / static_cast<std::uint64_t>(transport_world_size);
    std::uint64_t total_records = 0;
    for (int origin_rank = 0; origin_rank < transport_world_size;
         ++origin_rank) {
        const std::uint64_t observed_generation = transport.load_acquire(
            reinterpret_cast<transport::DeviceAddress>(
                &control[origin_rank].generation));
        const std::uint64_t count = transport.load_acquire(
            reinterpret_cast<transport::DeviceAddress>(
                &control[origin_rank].count));
        const auto validation = validate_hybrid_route_control(
            generation, observed_generation, count, shard_capacity);
        if (validation != DispatchProtocolError::kNone)
            return record_dispatch_protocol_error(
                context, status_address, origin_rank,
                DispatchProtocolStage::kRouteRecord, generation, validation);
        if (count > route_record_capacity - total_records)
            return record_dispatch_protocol_error(
                context, status_address, origin_rank,
                DispatchProtocolStage::kRouteRecord, generation,
                DispatchProtocolError::kCapacityOverflow);
        total_records += count;
    }

    std::uint64_t output = 0;
    for (int origin_rank = 0; origin_rank < transport_world_size;
         ++origin_rank) {
        auto* shard = reinterpret_cast<__gm__ const std::uint8_t*>(
            transport_local_window_base + dispatch_receive_offset +
            static_cast<std::uint64_t>(origin_rank) *
                dispatch_receive_shard_bytes);
        for (std::uint64_t slot = 0; slot < control[origin_rank].count;
             ++slot) {
            auto* record = shard + slot * token_stride_bytes;
            auto* metadata = reinterpret_cast<__gm__ const std::int32_t*>(
                record + token_source_metadata_offset);
            auto* topk = reinterpret_cast<__gm__ const std::int64_t*>(
                record + token_topk_index_offset);
            const std::int32_t master_lane = metadata[1];
            const auto route = classify_world_route(
                origin_rank, transport_world_rank, transport_scale_up_size);
            const bool diagonal = route.kind == WorldRouteKind::kDiagonal;
            auto* result = route_records + output++;
            result->origin_world_rank = origin_rank;
            result->destination_world_rank = transport_world_rank;
            result->ingress_world_rank = route.ingress_world_rank;
            result->destination_local_expert = static_cast<std::int32_t>(
                static_cast<std::uint64_t>(topk[master_lane]) % local_experts);
            result->origin_source_row =
                static_cast<std::uint64_t>(metadata[0]);
            result->ingress_slot = diagonal ?
                static_cast<std::uint64_t>(metadata[2 + master_lane]) :
                kInvalidHybridRouteSlot;
            result->forwarded_slot = diagonal ?
                static_cast<std::uint64_t>(origin_rank) * shard_capacity + slot :
                kInvalidHybridRouteSlot;
            result->generation = generation;
            result->topology_epoch = topology_epoch;
            result->stage_flags = kHybridRouteCompleteStageFlags;
            result->reserved = 0;
        }
    }
}

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_epilogue_acquire_vf(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ const std::int32_t* prefix_per_rank,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t timeout_cycles, std::uint64_t num_experts,
    std::uint64_t expert_alignment, std::uint64_t shard_capacity,
    std::uint64_t dispatch_output_capacity,
    std::uint64_t dispatch_control_offset,
    std::uint64_t dispatch_control_bytes,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_receive_shard_count,
    std::uint64_t dispatch_receive_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_local_count_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_route_source_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t workspace_rank_count,
    std::uint64_t dispatch_error_offset,
    std::uint64_t dispatch_error_count,
    std::uint64_t dispatch_rank_bitmap_bytes,
    std::uint64_t dispatch_expert_bitmap_bytes,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t dispatch_pipeline_bytes,
    std::uint64_t token_stride_bytes,
    std::uint32_t early_route_plan,
    std::uint32_t persistent_source_pipeline) {
    if (threadIdx.x != 0)
        return;

    const auto context = make_hybrid_dispatch_context(
        transport_abi_version, transport_struct_size,
        transport_capabilities, transport_local_window_base,
        transport_channel_table, transport_peer_address_table,
        transport_topology_abi_version, transport_topology_struct_size,
        transport_world_rank, transport_world_size,
        transport_scale_up_rank, transport_scale_up_size,
        transport_scale_out_rank, transport_scale_out_size,
        transport_scale_up_direct, transport_topology_kind,
        transport_topology_epoch, transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0)
        return;

    auto* errors = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_error_offset);
    const std::uint32_t error_count_u32 =
        static_cast<std::uint32_t>(dispatch_error_count);
    for (std::uint32_t index = 0; index < error_count_u32; ++index)
        errors[index] = 0;

    const bool cached = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const bool valid_world = transport_world_size > 0;
    const std::uint64_t world_size = valid_world ?
        static_cast<std::uint64_t>(transport_world_size) : 0;
    const std::uint64_t local_experts =
        valid_world && num_experts % world_size == 0 ?
            num_experts / world_size : 0;
    std::uint64_t rank_bitmap_words = 0;
    std::uint64_t expert_bitmap_words = 0;
    const bool valid_parallel_layout =
        valid_world && local_experts != 0 && expert_alignment != 0 &&
        dispatch_error_offset != 0 &&
        dispatch_error_count == world_size + local_experts &&
        workspace_rank_count == world_size &&
        dispatch_simt_owner_bitmap_words(
            world_size, shard_capacity, &rank_bitmap_words) &&
        dispatch_simt_owner_bitmap_words(
            local_experts, dispatch_output_capacity,
            &expert_bitmap_words) &&
        rank_bitmap_words <=
            dispatch_rank_bitmap_bytes / sizeof(std::uint64_t) &&
        expert_bitmap_words <=
            dispatch_expert_bitmap_bytes / sizeof(std::uint64_t);
    if (!transport::device::detail::valid_topology(context.topology) ||
        !valid_parallel_layout ||
        dispatch_output_capacity >
            static_cast<std::uint64_t>(0x7fffffff) ||
        (transport_world_size > 1 &&
         (dispatch_control_bytes <
              world_size * sizeof(DispatchControlSlot) ||
          dispatch_receive_shard_count != world_size ||
          dispatch_receive_bytes <
              world_size * dispatch_receive_shard_bytes ||
          shard_capacity * token_stride_bytes >
              dispatch_receive_shard_bytes))) {
        record_dispatch_protocol_error(
            context, status_address, transport_world_rank,
            DispatchProtocolStage::kEpilogue, generation,
            DispatchProtocolError::kInvalidLayout);
        return;
    }

    auto* source_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + (early_route_plan != 0 ?
            workspace_route_source_counts_offset :
            workspace_rank_counts_offset));
    auto* canonical_source_counts =
        reinterpret_cast<__gm__ std::uint64_t*>(
            workspace + workspace_rank_counts_offset);
    auto* source_bases = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    if (transport_world_size == 1) {
        const auto local_count_address =
            reinterpret_cast<transport::DeviceAddress>(
                workspace + workspace_local_count_offset);
        const std::uint64_t payload_count =
            transport.load_acquire(local_count_address);
        std::uint64_t canonical_count = 0;
        if (!dispatch_simt_handoff_dispatch_route_source_count(
                early_route_plan != 0, source_counts[0], payload_count,
                shard_capacity, &canonical_count)) {
            record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolStage::kEpilogue, generation,
                payload_count > shard_capacity ?
                    DispatchProtocolError::kCapacityOverflow :
                    DispatchProtocolError::kInvalidControl);
            return;
        }
        source_counts[0] = canonical_count;
        canonical_source_counts[0] = canonical_count;
    } else {
        bool pipeline_completion_ready = false;
        std::uint32_t completion_diagnostic = 0;
        if (persistent_source_pipeline == 0)
            completion_diagnostic |= 1U;
        if (dispatch_pipeline_bytes != sizeof(DispatchPipelineState))
            completion_diagnostic |= 2U;
        if (persistent_source_pipeline != 0 &&
            dispatch_pipeline_bytes == sizeof(DispatchPipelineState)) {
            auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
                workspace + dispatch_pipeline_offset);
            const auto pipeline_abi = transport::simt::load_observed(
                &pipeline->abi_version);
            const auto pipeline_size = transport::simt::load_observed(
                &pipeline->struct_size);
            const auto pipeline_generation = transport::simt::load_observed(
                &pipeline->generation);
            if (pipeline_abi != kDispatchPipelineAbiVersion)
                completion_diagnostic |= 4U;
            if (pipeline_size != sizeof(DispatchPipelineState))
                completion_diagnostic |= 8U;
            if (pipeline_generation != generation)
                completion_diagnostic |= 16U;
            pipeline_completion_ready =
                completion_diagnostic == 0;
            transport::simt::system_fence();
        }
        const bool transport_completion_ready =
            persistent_source_pipeline != 0 ?
                pipeline_completion_ready :
                transport.consumed_generation() == generation;
        if (!transport_completion_ready) {
            record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolStage::kEpilogue, generation,
                DispatchProtocolError::kInvalidControl,
                completion_diagnostic);
            return;
        }
        auto* control_slots = reinterpret_cast<__gm__ DispatchControlSlot*>(
            transport_local_window_base + dispatch_control_offset);
        for (int source_rank = 0;
             source_rank < transport_world_size; ++source_rank) {
            const auto release_boundary = dispatch_release_boundary(
                source_rank, transport_world_rank,
                transport_scale_up_size);
            std::uint32_t persistent_control_diagnostic = 0;
            std::uint64_t observed_signal = generation;
            const auto control_slot_address =
                reinterpret_cast<transport::DeviceAddress>(control_slots) +
                static_cast<std::uint64_t>(
                    release_boundary.control_slot_world_rank) *
                    sizeof(DispatchControlSlot);
            const auto observed_control_generation =
                transport.load_acquire(control_slot_address);
            if (persistent_source_pipeline != 0 &&
                release_boundary.remote_acquire_required &&
                release_boundary.control_slot_world_rank !=
                    transport_world_rank) {
                transport::TeamPeer signal_route{};
                if (!transport::device::detail::
                        checked_device_team_peer_for_world_rank(
                            context.topology,
                            release_boundary.signal_sender_world_rank,
                            &signal_route)) {
                    persistent_control_diagnostic |= 1U;
                    observed_signal = 0;
                } else {
                    observed_signal = transport.read_signal(
                        signal_route.team, signal_route.peer,
                        transport::sync_layout::
                            kDispatchReleaseSignalIndex);
                    if (observed_signal < generation)
                        persistent_control_diagnostic |= 2U;
                }
            }
            if (persistent_source_pipeline != 0 &&
                observed_control_generation != generation)
                persistent_control_diagnostic |= 4U;
            if (persistent_control_diagnostic != 0) {
                persistent_control_diagnostic |=
                    (static_cast<std::uint32_t>(source_rank) & 0x7U) << 5U;
                persistent_control_diagnostic |=
                    static_cast<std::uint32_t>(
                        observed_signal > 0xffU ? 0xffU : observed_signal)
                    << 8U;
                persistent_control_diagnostic |=
                    static_cast<std::uint32_t>(
                        observed_control_generation > 0xffU ?
                            0xffU : observed_control_generation)
                    << 16U;
                record_dispatch_protocol_error(
                    context, status_address, source_rank,
                    DispatchProtocolStage::kEpilogue, generation,
                    DispatchProtocolError::kInvalidControl,
                    persistent_control_diagnostic);
                return;
            }
            const auto observation =
                release_protocol::observe_release_control(
                    transport, context.topology, release_boundary,
                    transport_world_rank, control_slots,
                    transport::sync_layout::kDispatchReleaseSignalIndex,
                    generation, timeout_cycles);
            std::uint64_t canonical_count = 0;
            if (!observation.acquired ||
                observation.generation != generation ||
                !dispatch_simt_handoff_dispatch_route_source_count(
                    early_route_plan != 0, source_counts[source_rank],
                    observation.count, shard_capacity, &canonical_count)) {
                record_dispatch_protocol_error(
                    context, status_address, source_rank,
                    DispatchProtocolStage::kEpilogue, generation,
                    observation.count > shard_capacity ?
                        DispatchProtocolError::kCapacityOverflow :
                        DispatchProtocolError::kInvalidControl);
                return;
            }
            source_counts[source_rank] = canonical_count;
            canonical_source_counts[source_rank] = canonical_count;
        }
    }

    std::uint64_t total_records = 0;
    for (int source_rank = 0;
         source_rank < transport_world_size; ++source_rank) {
        source_bases[source_rank] = total_records;
        total_records += source_counts[source_rank];
        if (cached && prefix_per_rank[source_rank] !=
                static_cast<std::int32_t>(total_records)) {
            record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolStage::kEpilogue, generation,
                DispatchProtocolError::kInvalidCachedPrefix);
            return;
        }
    }
    if (total_records > shard_capacity * world_size) {
        record_dispatch_protocol_error(
            context, status_address, transport_world_rank,
            DispatchProtocolStage::kEpilogue, generation,
            DispatchProtocolError::kCapacityOverflow);
    }
    (void)communication_buffer;
}

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_epilogue_validate_records_vf(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ const std::int32_t* source_metadata,
    std::uintptr_t transport_local_window_base,
    int transport_world_rank, int transport_world_size,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t num_experts, std::uint64_t num_topk,
    std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t dispatch_receive_tile_error_offset,
    std::uint64_t dispatch_receive_tile_count,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_source_metadata_offset) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::simt::load_observed(status) != 0)
        return;
    const bool cached = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const bool expanded = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    const std::uint32_t num_experts_u32 =
        static_cast<std::uint32_t>(num_experts);
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t shard_capacity_u32 =
        static_cast<std::uint32_t>(shard_capacity);
    const std::uint32_t tile_count_u32 =
        static_cast<std::uint32_t>(dispatch_receive_tile_count);
    const std::uint32_t world_size =
        static_cast<std::uint32_t>(transport_world_size);
    const std::uint32_t local_experts = num_experts_u32 / world_size;
    const std::uint32_t first_local_expert =
        static_cast<std::uint32_t>(transport_world_rank) * local_experts;
    auto* source_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* source_bases = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    auto* tile_errors = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_receive_tile_error_offset);
    const auto work = direct_block_distributed_grid_stride(
        blockIdx.x, threadIdx.x, gridDim.x, blockDim.x);
    const std::uint32_t logical_record_capacity =
        world_size * shard_capacity_u32;
    for (std::uint32_t tile = work.first;
         tile < tile_count_u32; tile += work.stride) {
        DispatchProtocolError error = DispatchProtocolError::kNone;
        int failure_rank = transport_world_rank;
        const std::uint32_t tile_begin = tile *
            static_cast<std::uint32_t>(kDispatchReceiveRecordsPerTile);
        std::uint32_t tile_end = tile_begin +
            static_cast<std::uint32_t>(kDispatchReceiveRecordsPerTile);
        if (tile_end > logical_record_capacity)
            tile_end = logical_record_capacity;
        for (std::uint32_t logical_record = tile_begin;
             logical_record < tile_end; ++logical_record) {
            std::uint64_t source_rank_u64 = 0;
            std::uint64_t source_slot = 0;
            if (!dispatch_simt_receive_record_coordinates(
                    logical_record, world_size, shard_capacity,
                    &source_rank_u64, &source_slot)) {
                error = DispatchProtocolError::kInvalidLayout;
                break;
            }
            const int source_rank = static_cast<int>(source_rank_u64);
            if (source_slot >= source_counts[source_rank])
                continue;
            failure_rank = source_rank;
            __gm__ std::uint8_t* source_shard =
                transport_world_size == 1 ? communication_buffer :
                reinterpret_cast<__gm__ std::uint8_t*>(
                    transport_local_window_base + dispatch_receive_offset +
                    source_rank_u64 * dispatch_receive_shard_bytes);
            __gm__ std::uint8_t* record =
                source_shard + source_slot * token_stride_bytes;
            auto* record_topk =
                reinterpret_cast<__gm__ const std::int64_t*>(
                    record + token_topk_index_offset);
            auto* record_metadata =
                reinterpret_cast<__gm__ const std::int32_t*>(
                    record + token_source_metadata_offset);
            bool has_local_lane = false;
            for (std::uint32_t lane = 0; lane < num_topk_u32; ++lane) {
                const std::int64_t expert = record_topk[lane];
                if (expert < -1 ||
                    (expert >= 0 &&
                     static_cast<std::uint64_t>(expert) >=
                         num_experts_u32)) {
                    error = DispatchProtocolError::kInvalidTopk;
                    break;
                }
                const bool local = is_dispatch_expert_local(
                    expert, first_local_expert, local_experts);
                if (local)
                    has_local_lane = true;
                if (cached && expanded && !local) {
                    const auto compact_slot =
                        source_bases[source_rank] + source_slot;
                    const auto* reusable = source_metadata +
                        compact_slot * (2 + num_topk);
                    if (reusable[2 + lane] != -1) {
                        error =
                            DispatchProtocolError::kInvalidCachedMetadata;
                        break;
                    }
                }
            }
            const std::int32_t master_lane = record_metadata[1];
            if (error == DispatchProtocolError::kNone &&
                (!has_local_lane ||
                 !is_dispatch_local_index(
                     record_metadata[0], shard_capacity) ||
                 !is_dispatch_local_index(master_lane, num_topk) ||
                 !is_dispatch_expert_local(
                     record_topk[master_lane], first_local_expert,
                     local_experts)))
                error = DispatchProtocolError::kInvalidCachedMetadata;
            if (error == DispatchProtocolError::kNone && cached) {
                const auto compact_slot =
                    source_bases[source_rank] + source_slot;
                const auto* reusable = source_metadata +
                    compact_slot * (2 + num_topk);
                if (reusable[0] != encode_dispatch_source_index(
                        static_cast<std::uint64_t>(source_rank),
                        shard_capacity,
                        static_cast<std::uint64_t>(record_metadata[0])) ||
                    reusable[1] != encode_dispatch_source_index(
                        static_cast<std::uint64_t>(source_rank), num_topk,
                        static_cast<std::uint64_t>(master_lane)))
                    error = DispatchProtocolError::kInvalidCachedMetadata;
            }
            if (error != DispatchProtocolError::kNone)
                break;
        }
        tile_errors[tile] = error == DispatchProtocolError::kNone ? 0 :
            make_dispatch_protocol_failure(
                failure_rank, DispatchProtocolStage::kEpilogue,
                generation, error).scratch_status;
    }
}

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_epilogue_count_experts_vf(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    std::uintptr_t transport_local_window_base,
    int transport_world_rank, int transport_world_size,
    std::uint64_t num_experts, std::uint64_t num_topk,
    std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t dispatch_expert_tile_count_offset,
    std::uint64_t dispatch_expert_tile_count,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_topk_index_offset) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::simt::load_observed(status) != 0)
        return;
    const std::uint32_t num_experts_u32 =
        static_cast<std::uint32_t>(num_experts);
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t shard_capacity_u32 =
        static_cast<std::uint32_t>(shard_capacity);
    const std::uint32_t tile_count_u32 =
        static_cast<std::uint32_t>(dispatch_expert_tile_count);
    const std::uint32_t world_size =
        static_cast<std::uint32_t>(transport_world_size);
    const std::uint32_t local_experts = num_experts_u32 / world_size;
    const std::uint32_t first_local_expert =
        static_cast<std::uint32_t>(transport_world_rank) * local_experts;
    auto* source_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* tile_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_expert_tile_count_offset);
    const auto work = direct_block_distributed_grid_stride(
        blockIdx.x, threadIdx.x, gridDim.x, blockDim.x);
    const std::uint32_t logical_record_capacity =
        world_size * shard_capacity_u32;
    for (std::uint32_t tile = work.first;
         tile < tile_count_u32; tile += work.stride) {
        for (std::uint32_t local_expert = 0;
             local_expert < local_experts; ++local_expert)
            tile_counts[
                static_cast<std::uint64_t>(tile) * local_experts +
                local_expert] = 0;
        const std::uint32_t tile_begin = tile *
            static_cast<std::uint32_t>(kDispatchReceiveRecordsPerTile);
        std::uint32_t tile_end = tile_begin +
            static_cast<std::uint32_t>(kDispatchReceiveRecordsPerTile);
        if (tile_end > logical_record_capacity)
            tile_end = logical_record_capacity;
        for (std::uint32_t logical_record = tile_begin;
             logical_record < tile_end; ++logical_record) {
            std::uint64_t source_rank = 0;
            std::uint64_t source_slot = 0;
            if (!dispatch_simt_receive_record_coordinates(
                    logical_record, world_size, shard_capacity,
                    &source_rank, &source_slot) ||
                source_slot >= source_counts[source_rank])
                continue;
            __gm__ std::uint8_t* source_shard =
                transport_world_size == 1 ? communication_buffer :
                reinterpret_cast<__gm__ std::uint8_t*>(
                    transport_local_window_base + dispatch_receive_offset +
                    source_rank * dispatch_receive_shard_bytes);
            auto* record_topk =
                reinterpret_cast<__gm__ const std::int64_t*>(
                    source_shard + source_slot * token_stride_bytes +
                    token_topk_index_offset);
            for (std::uint32_t lane = 0; lane < num_topk_u32; ++lane) {
                const auto expert = record_topk[lane];
                if (!is_dispatch_expert_local(
                        expert, first_local_expert, local_experts))
                    continue;
                const std::uint32_t local_expert =
                    static_cast<std::uint32_t>(expert) - first_local_expert;
                ++tile_counts[
                    static_cast<std::uint64_t>(tile) * local_experts +
                    local_expert];
            }
        }
    }
}

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_epilogue_prefix_vf(
    __gm__ std::uint8_t* workspace,
    __gm__ std::int32_t* prefix_per_rank,
    __gm__ std::int32_t* prefix_per_expert,
    __gm__ std::int32_t* unaligned_per_expert,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t num_experts, std::uint64_t expert_alignment,
    std::uint64_t dispatch_output_capacity,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t dispatch_expert_tile_count_offset,
    std::uint64_t dispatch_expert_tile_count) {
    if (threadIdx.x != 0)
        return;
    const auto context = make_hybrid_dispatch_context(
        transport_abi_version, transport_struct_size,
        transport_capabilities, transport_local_window_base,
        transport_channel_table, transport_peer_address_table,
        transport_topology_abi_version, transport_topology_struct_size,
        transport_world_rank, transport_world_size,
        transport_scale_up_rank, transport_scale_up_size,
        transport_scale_out_rank, transport_scale_out_size,
        transport_scale_up_direct, transport_topology_kind,
        transport_topology_epoch, transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    const bool cached = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const std::uint32_t num_experts_u32 =
        static_cast<std::uint32_t>(num_experts);
    const std::uint32_t tile_count_u32 =
        static_cast<std::uint32_t>(dispatch_expert_tile_count);
    const std::uint32_t world_size =
        static_cast<std::uint32_t>(transport_world_size);
    const std::uint32_t local_experts = num_experts_u32 / world_size;
    const std::uint32_t first_local_expert =
        static_cast<std::uint32_t>(transport_world_rank) * local_experts;
    auto* source_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* tile_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_expert_tile_count_offset);

    std::uint64_t rank_prefix = 0;
    for (int source_rank = 0;
         source_rank < transport_world_size; ++source_rank) {
        rank_prefix += source_counts[source_rank];
        if (!cached)
            prefix_per_rank[source_rank] =
                static_cast<std::int32_t>(rank_prefix);
    }
    std::uint64_t derived_prefix = 0;
    for (std::uint32_t expert = 0; expert < num_experts_u32; ++expert) {
        const bool local = is_dispatch_expert_local(
            static_cast<std::int64_t>(expert), first_local_expert,
            local_experts);
        std::uint64_t actual_count = 0;
        if (local) {
            const std::uint32_t local_expert =
                expert - first_local_expert;
            for (std::uint32_t tile = 0; tile < tile_count_u32; ++tile) {
                const std::uint64_t index =
                    static_cast<std::uint64_t>(tile) * local_experts +
                    local_expert;
                const std::uint64_t count = tile_counts[index];
                tile_counts[index] = actual_count;
                actual_count += count;
            }
        }
        if (cached &&
            (unaligned_per_expert[expert] !=
                 static_cast<std::int32_t>(actual_count) ||
             prefix_per_expert[expert] !=
                 static_cast<std::int32_t>(derived_prefix))) {
            record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolStage::kEpilogue, generation,
                DispatchProtocolError::kInvalidCachedPrefix);
            return;
        }
        if (!cached) {
            unaligned_per_expert[expert] =
                static_cast<std::int32_t>(actual_count);
            prefix_per_expert[expert] =
                static_cast<std::int32_t>(derived_prefix);
        }
        const std::uint64_t aligned_count =
            ((actual_count + expert_alignment - 1) / expert_alignment) *
            expert_alignment;
        derived_prefix += aligned_count;
        if (derived_prefix > dispatch_output_capacity ||
            derived_prefix > static_cast<std::uint64_t>(0x7fffffff)) {
            record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolStage::kEpilogue, generation,
                DispatchProtocolError::kCapacityOverflow);
            return;
        }
    }
    if (cached && prefix_per_expert[num_experts] !=
            static_cast<std::int32_t>(derived_prefix)) {
        record_dispatch_protocol_error(
            context, status_address, transport_world_rank,
            DispatchProtocolStage::kEpilogue, generation,
            DispatchProtocolError::kInvalidCachedPrefix);
        return;
    }
    if (!cached)
        prefix_per_expert[num_experts] =
            static_cast<std::int32_t>(derived_prefix);
}

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_epilogue_parallel_prefix_vf(
    __gm__ std::uint8_t* workspace,
    __gm__ std::int32_t* prefix_per_rank,
    __gm__ std::int32_t* prefix_per_expert,
    __gm__ std::int32_t* unaligned_per_expert,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t num_experts,
    std::uint64_t expert_alignment,
    std::uint64_t dispatch_output_capacity,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t dispatch_expert_tile_count_offset,
    std::uint64_t dispatch_expert_tile_count) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    auto* source_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* tile_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_expert_tile_count_offset);
    const auto worker_plan = dispatch_simt_expert_prefix_worker_plan(
        num_experts, static_cast<std::uint64_t>(transport_world_size),
        static_cast<std::uint64_t>(blockDim.x));
    const bool ready = worker_plan.valid &&
        transport::simt::load_observed(status) == 0;
    const std::uint32_t local_expert = threadIdx.x;
    const std::uint32_t tile_count_u32 =
        static_cast<std::uint32_t>(dispatch_expert_tile_count);
    const std::uint32_t first_local_expert =
        static_cast<std::uint32_t>(transport_world_rank) *
        worker_plan.local_experts;
    if (ready && local_expert < worker_plan.active_threads) {
        std::uint64_t prefix = 0;
        for (std::uint32_t tile = 0; tile < tile_count_u32; ++tile) {
            const std::uint64_t index =
                static_cast<std::uint64_t>(tile) *
                    worker_plan.local_experts +
                local_expert;
            const std::uint64_t count = tile_counts[index];
            tile_counts[index] = prefix;
            prefix += count;
        }
        const std::uint32_t expert = first_local_expert + local_expert;
        unaligned_per_expert[expert] = static_cast<std::int32_t>(prefix);
    }
    asc_threadfence_block();
    asc_syncthreads();
    if (threadIdx.x != 0)
        return;
    if (!ready)
        return;

    const auto context = make_hybrid_dispatch_context(
        transport_abi_version, transport_struct_size,
        transport_capabilities, transport_local_window_base,
        transport_channel_table, transport_peer_address_table,
        transport_topology_abi_version, transport_topology_struct_size,
        transport_world_rank, transport_world_size,
        transport_scale_up_rank, transport_scale_up_size,
        transport_scale_out_rank, transport_scale_out_size,
        transport_scale_up_direct, transport_topology_kind,
        transport_topology_epoch, transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);

    std::uint64_t rank_prefix = 0;
    for (int source_rank = 0;
         source_rank < transport_world_size; ++source_rank) {
        rank_prefix += source_counts[source_rank];
        prefix_per_rank[source_rank] =
            static_cast<std::int32_t>(rank_prefix);
    }

    const std::uint32_t num_experts_u32 =
        static_cast<std::uint32_t>(num_experts);
    std::uint64_t derived_prefix = 0;
    for (std::uint32_t expert = 0; expert < num_experts_u32; ++expert) {
        const bool local =
            expert >= first_local_expert &&
            expert < first_local_expert + worker_plan.local_experts;
        const std::uint64_t actual_count = local ?
            static_cast<std::uint32_t>(unaligned_per_expert[expert]) : 0;
        if (!local)
            unaligned_per_expert[expert] = 0;
        prefix_per_expert[expert] =
            static_cast<std::int32_t>(derived_prefix);
        const std::uint64_t aligned_count =
            ((actual_count + expert_alignment - 1) / expert_alignment) *
            expert_alignment;
        derived_prefix += aligned_count;
        if (derived_prefix > dispatch_output_capacity ||
            derived_prefix > static_cast<std::uint64_t>(0x7fffffff)) {
            record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolStage::kEpilogue, generation,
                DispatchProtocolError::kCapacityOverflow);
            return;
        }
    }
    prefix_per_expert[num_experts] =
        static_cast<std::int32_t>(derived_prefix);
}

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_epilogue_metadata_vf(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ std::int64_t* recv_topk_indices,
    __gm__ std::int32_t* source_metadata,
    std::uintptr_t transport_local_window_base,
    int transport_world_rank, int transport_world_size,
    CoreModeFlags mode_flags, std::uint64_t num_experts,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_source_metadata_offset) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::simt::load_observed(status) != 0)
        return;
    const bool cached = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const std::uint32_t num_experts_u32 =
        static_cast<std::uint32_t>(num_experts);
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t shard_capacity_u32 =
        static_cast<std::uint32_t>(shard_capacity);
    const std::uint32_t world_size =
        static_cast<std::uint32_t>(transport_world_size);
    const std::uint32_t local_experts = num_experts_u32 / world_size;
    const std::uint32_t first_local_expert =
        static_cast<std::uint32_t>(transport_world_rank) * local_experts;
    auto* source_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* source_bases = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    const std::uint32_t logical_count = world_size * shard_capacity_u32;
    const std::uint32_t tile_count =
        (logical_count + kDispatchReceiveRecordsPerTile - 1) /
        kDispatchReceiveRecordsPerTile;
    const auto work = direct_block_distributed_grid_stride(
        blockIdx.x, threadIdx.x, gridDim.x, blockDim.x);
    for (std::uint32_t tile = work.first; tile < tile_count;
         tile += work.stride) {
        const std::uint32_t tile_begin = tile *
            static_cast<std::uint32_t>(kDispatchReceiveRecordsPerTile);
        std::uint32_t tile_end = tile_begin +
            static_cast<std::uint32_t>(kDispatchReceiveRecordsPerTile);
        if (tile_end > logical_count)
            tile_end = logical_count;
        for (std::uint32_t logical = tile_begin; logical < tile_end;
             ++logical) {
            const int source_rank =
                static_cast<int>(logical / shard_capacity_u32);
            const std::uint32_t source_slot =
                logical % shard_capacity_u32;
            if (source_slot >= source_counts[source_rank])
                continue;
            const std::uint64_t compact_slot =
                source_bases[source_rank] + source_slot;
            __gm__ std::uint8_t* source_shard =
                transport_world_size == 1 ? communication_buffer :
                reinterpret_cast<__gm__ std::uint8_t*>(
                    transport_local_window_base + dispatch_receive_offset +
                    static_cast<std::uint64_t>(source_rank) *
                        dispatch_receive_shard_bytes);
            __gm__ std::uint8_t* record =
                source_shard + source_slot * token_stride_bytes;
            auto* record_topk =
                reinterpret_cast<__gm__ const std::int64_t*>(
                    record + token_topk_index_offset);
            auto* record_metadata =
                reinterpret_cast<__gm__ const std::int32_t*>(
                    record + token_source_metadata_offset);
            auto* output_metadata =
                source_metadata + compact_slot * (2 + num_topk);
            if (!cached) {
                output_metadata[0] = encode_dispatch_source_index(
                    static_cast<std::uint64_t>(source_rank), shard_capacity,
                    static_cast<std::uint64_t>(record_metadata[0]));
                output_metadata[1] = encode_dispatch_source_index(
                    static_cast<std::uint64_t>(source_rank), num_topk,
                    static_cast<std::uint64_t>(record_metadata[1]));
                for (std::uint32_t lane = 0;
                     lane < num_topk_u32; ++lane)
                    output_metadata[2 + lane] = -1;
            }
            for (std::uint32_t lane = 0; lane < num_topk_u32; ++lane)
                recv_topk_indices[compact_slot * num_topk + lane] =
                    localize_dispatch_expert(
                        record_topk[lane], first_local_expert,
                        local_experts);
        }
    }
}

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_epilogue_assign_destinations_vf(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ const std::int32_t* prefix_per_expert,
    __gm__ const std::int32_t* unaligned_per_expert,
    __gm__ std::int32_t* source_metadata,
    std::uintptr_t transport_local_window_base,
    int transport_world_rank, int transport_world_size,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t num_experts, std::uint64_t num_topk,
    std::uint64_t shard_capacity,
    std::uint64_t dispatch_output_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t dispatch_expert_tile_count_offset,
    std::uint64_t dispatch_expert_tile_count,
    std::uint64_t dispatch_error_offset,
    std::uint64_t dispatch_expert_bitmap_offset,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_topk_index_offset) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::simt::load_observed(status) != 0)
        return;
    const bool cached = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const bool expanded = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    if (!expanded)
        return;
    const std::uint32_t num_experts_u32 =
        static_cast<std::uint32_t>(num_experts);
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t shard_capacity_u32 =
        static_cast<std::uint32_t>(shard_capacity);
    const std::uint32_t tile_count_u32 =
        static_cast<std::uint32_t>(dispatch_expert_tile_count);
    const std::uint32_t world_size =
        static_cast<std::uint32_t>(transport_world_size);
    const std::uint32_t local_experts = num_experts_u32 / world_size;
    const std::uint32_t first_local_expert =
        static_cast<std::uint32_t>(transport_world_rank) * local_experts;
    auto* source_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* source_bases = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    auto* tile_cursors = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_expert_tile_count_offset);
    auto* errors = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_error_offset);
    auto* bitmap = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_expert_bitmap_offset);

    if (!cached) {
        const auto work = direct_block_distributed_grid_stride(
            blockIdx.x, threadIdx.x, gridDim.x, blockDim.x);
        const std::uint32_t logical_record_capacity =
            world_size * shard_capacity_u32;
        for (std::uint32_t tile = work.first;
             tile < tile_count_u32; tile += work.stride) {
            const std::uint32_t tile_begin = tile *
                static_cast<std::uint32_t>(
                    kDispatchReceiveRecordsPerTile);
            std::uint32_t tile_end = tile_begin +
                static_cast<std::uint32_t>(
                    kDispatchReceiveRecordsPerTile);
            if (tile_end > logical_record_capacity)
                tile_end = logical_record_capacity;
            for (std::uint32_t logical_record = tile_begin;
                 logical_record < tile_end; ++logical_record) {
                std::uint64_t source_rank = 0;
                std::uint64_t source_slot = 0;
                if (!dispatch_simt_receive_record_coordinates(
                        logical_record, world_size, shard_capacity,
                        &source_rank, &source_slot) ||
                    source_slot >= source_counts[source_rank])
                    continue;
                __gm__ std::uint8_t* source_shard =
                    transport_world_size == 1 ? communication_buffer :
                    reinterpret_cast<__gm__ std::uint8_t*>(
                        transport_local_window_base +
                        dispatch_receive_offset +
                        source_rank * dispatch_receive_shard_bytes);
                auto* record_topk =
                    reinterpret_cast<__gm__ const std::int64_t*>(
                        source_shard + source_slot * token_stride_bytes +
                        token_topk_index_offset);
                const auto compact_slot =
                    source_bases[source_rank] + source_slot;
                auto* output_metadata =
                    source_metadata + compact_slot * (2 + num_topk);
                for (std::uint32_t lane = 0;
                     lane < num_topk_u32; ++lane) {
                    const auto expert = record_topk[lane];
                    if (!is_dispatch_expert_local(
                            expert, first_local_expert, local_experts))
                        continue;
                    const std::uint32_t local_expert =
                        static_cast<std::uint32_t>(expert) -
                        first_local_expert;
                    const std::uint64_t index =
                        static_cast<std::uint64_t>(tile) * local_experts +
                        local_expert;
                    const std::uint64_t destination =
                        static_cast<std::uint64_t>(
                            prefix_per_expert[expert]) +
                        tile_cursors[index]++;
                    output_metadata[2 + lane] =
                        static_cast<std::int32_t>(destination);
                }
            }
        }
        return;
    }
    if (!direct_dispatch_simt_cached_bitmap_owner(blockIdx.x))
        return;

    for (std::uint32_t local_expert = threadIdx.x;
         local_expert < local_experts; local_expert += blockDim.x) {
        const std::uint32_t expert = first_local_expert + local_expert;
        std::uint64_t base_word = 0;
        std::uint64_t word_count = 0;
        dispatch_simt_owner_bitmap_range(
            local_expert, local_experts, dispatch_output_capacity,
            &base_word, &word_count);
        auto* owner_bitmap = bitmap + base_word;
        const std::uint32_t word_count_u32 =
            static_cast<std::uint32_t>(word_count);
        if (cached)
            for (std::uint32_t word = 0; word < word_count_u32; ++word)
                owner_bitmap[word] = 0;
        DispatchProtocolError error = DispatchProtocolError::kNone;
        std::uint32_t occurrence = 0;
        for (int source_rank = 0;
             source_rank < transport_world_size; ++source_rank) {
            __gm__ std::uint8_t* source_shard =
                transport_world_size == 1 ? communication_buffer :
                reinterpret_cast<__gm__ std::uint8_t*>(
                    transport_local_window_base + dispatch_receive_offset +
                    static_cast<std::uint64_t>(source_rank) *
                        dispatch_receive_shard_bytes);
            const std::uint32_t source_count =
                static_cast<std::uint32_t>(source_counts[source_rank]);
            for (std::uint32_t source_slot = 0;
                 source_slot < source_count; ++source_slot) {
                auto* record_topk =
                    reinterpret_cast<__gm__ const std::int64_t*>(
                        source_shard + source_slot * token_stride_bytes +
                        token_topk_index_offset);
                const auto compact_slot =
                    source_bases[source_rank] + source_slot;
                auto* output_metadata =
                    source_metadata + compact_slot * (2 + num_topk);
                for (std::uint32_t lane = 0;
                     lane < num_topk_u32; ++lane) {
                    if (record_topk[lane] !=
                            static_cast<std::int64_t>(expert))
                        continue;
                    if (!cached) {
                        output_metadata[2 + lane] =
                            prefix_per_expert[expert] +
                            static_cast<std::int32_t>(occurrence++);
                        continue;
                    }
                    const std::int32_t destination =
                        output_metadata[2 + lane];
                    const std::int32_t begin = prefix_per_expert[expert];
                    const std::int32_t end =
                        begin + unaligned_per_expert[expert];
                    std::uint64_t word = 0;
                    std::uint64_t mask = 0;
                    if (destination < begin || destination >= end ||
                        destination < 0 ||
                        static_cast<std::uint64_t>(destination) >=
                            dispatch_output_capacity ||
                        !dispatch_simt_bitmap_location(
                            static_cast<std::uint64_t>(destination),
                            dispatch_output_capacity, &word, &mask) ||
                        (owner_bitmap[word] & mask) != 0) {
                        error =
                            DispatchProtocolError::kInvalidCachedMetadata;
                        break;
                    }
                    owner_bitmap[word] |= mask;
                }
                if (error != DispatchProtocolError::kNone)
                    break;
            }
            if (error != DispatchProtocolError::kNone)
                break;
        }
        if (error != DispatchProtocolError::kNone)
            errors[world_size + local_expert] =
                make_dispatch_protocol_failure(
                    transport_world_rank,
                    DispatchProtocolStage::kEpilogue,
                    generation, error).scratch_status;
    }
    (void)shard_capacity;
}

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_epilogue_clear_padding_vf(
    __gm__ std::uint8_t* workspace,
    __gm__ std::uint8_t* recv_x,
    __gm__ std::uint8_t* recv_scale_factors,
    __gm__ float* recv_topk_weights,
    __gm__ const std::int32_t* prefix_per_expert,
    CoreModeFlags mode_flags, std::uint64_t num_experts,
    std::uint64_t token_hidden_bytes,
    std::uint64_t token_scale_factor_bytes,
    std::uint64_t recv_scale_factor_token_stride,
    std::uint64_t recv_scale_factor_pack_stride,
    std::uint64_t workspace_status_offset) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::simt::load_observed(status) != 0)
        return;
    const bool expanded = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    const bool zero_padding = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kZeroPadding))) != 0;
    if (!expanded || !zero_padding)
        return;
    const std::uint64_t expanded_count =
        static_cast<std::uint64_t>(prefix_per_expert[num_experts]);
    const std::uint64_t hidden_bytes = expanded_count * token_hidden_bytes;
    for (std::uint64_t logical = threadIdx.x; logical < hidden_bytes;
         logical += blockDim.x)
        recv_x[logical] = 0;
    if (recv_scale_factors != nullptr) {
        const std::uint64_t scale_bytes =
            expanded_count * token_scale_factor_bytes;
        for (std::uint64_t logical = threadIdx.x; logical < scale_bytes;
             logical += blockDim.x) {
            const std::uint64_t slot =
                logical / token_scale_factor_bytes;
            const std::uint64_t inner =
                logical % token_scale_factor_bytes;
            const std::uint64_t pack = inner / 4;
            const std::uint64_t byte = inner % 4;
            recv_scale_factors[scale_factor_byte_offset(
                slot, pack, recv_scale_factor_token_stride,
                recv_scale_factor_pack_stride, 4) + byte] = 0;
        }
    }
    if (recv_topk_weights != nullptr)
        for (std::uint64_t slot = threadIdx.x; slot < expanded_count;
             slot += blockDim.x)
            recv_topk_weights[slot] = 0.0F;
}

template <std::uint32_t TileBytes>
__aicore__ inline void direct_dispatch_epilogue_vector_payload_impl(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ const std::uint8_t* workspace,
    __gm__ std::uint8_t* recv_x,
    __gm__ const std::int32_t* source_metadata,
    std::uintptr_t transport_local_window_base,
    int transport_world_size, bool expanded,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes,
    std::uint64_t token_topk_index_offset) {
    const auto* status = reinterpret_cast<__gm__ const std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::aicore::load_device(status) != 0)
        return;
    const auto consumer_copy_plan = dispatch_consumer_copy_plan(
        token_hidden_bytes, TileBytes, 32);
    if (!consumer_copy_plan.valid || consumer_copy_plan.vector_bytes == 0)
        return;

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> payload_buffer;
    (void)pipe.InitBuffer(payload_buffer, TileBytes);
    auto payload_local = payload_buffer.Get<std::uint8_t>();
    AscendC::GlobalTensor<std::uint64_t> source_counts_global;
    AscendC::GlobalTensor<std::uint64_t> source_bases_global;
    AscendC::GlobalTensor<std::int32_t> source_metadata_global;
    AscendC::GlobalTensor<std::int64_t> record_topk_global;
    AscendC::GlobalTensor<std::uint8_t> input_global;
    AscendC::GlobalTensor<std::uint8_t> output_global;
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t shard_capacity_u32 =
        static_cast<std::uint32_t>(shard_capacity);
    const std::uint32_t world_size =
        static_cast<std::uint32_t>(transport_world_size);
    source_counts_global.SetGlobalBuffer(
        reinterpret_cast<__gm__ std::uint64_t*>(
            const_cast<__gm__ std::uint8_t*>(workspace) +
            workspace_rank_counts_offset),
        world_size);
    source_bases_global.SetGlobalBuffer(
        reinterpret_cast<__gm__ std::uint64_t*>(
            const_cast<__gm__ std::uint8_t*>(workspace) +
            workspace_rank_values_offset),
        world_size);
    if (expanded)
        source_metadata_global.SetGlobalBuffer(
            const_cast<__gm__ std::int32_t*>(source_metadata),
            static_cast<std::uint64_t>(world_size) * shard_capacity_u32 *
                (2 + num_topk_u32));

    const std::uint32_t block_index =
        static_cast<std::uint32_t>(AscendC::GetBlockIdx());
    const std::uint32_t block_count =
        static_cast<std::uint32_t>(AscendC::GetBlockNum());
    if (world_size == 0)
        return;
    const std::uint32_t last_source_rank = world_size - 1;
    const std::uint32_t total_records = static_cast<std::uint32_t>(
        source_bases_global.GetValue(last_source_rank) +
        source_counts_global.GetValue(last_source_rank));
    const std::uint32_t copies_per_record =
        expanded ? num_topk_u32 : 1;
    const std::uint32_t logical_count =
        total_records * copies_per_record;
    for (std::uint32_t logical = block_index; logical < logical_count;
         logical += block_count) {
        const std::uint32_t compact_record =
            logical / copies_per_record;
        const std::uint32_t lane =
            expanded ? logical % copies_per_record : 0;
        std::uint32_t source_rank = 0;
        std::uint32_t source_slot = 0;
        bool found_source = false;
        for (; source_rank < world_size; ++source_rank) {
            const std::uint64_t source_base =
                source_bases_global.GetValue(source_rank);
            if (compact_record >= source_base &&
                static_cast<std::uint64_t>(compact_record) - source_base <
                    source_counts_global.GetValue(source_rank)) {
                source_slot = static_cast<std::uint32_t>(
                    static_cast<std::uint64_t>(compact_record) - source_base);
                found_source = true;
                break;
            }
        }
        if (!found_source)
            continue;
        const std::uint64_t compact_slot = compact_record;
        __gm__ std::uint8_t* source_shard =
            transport_world_size == 1 ? communication_buffer :
            reinterpret_cast<__gm__ std::uint8_t*>(
                transport_local_window_base + dispatch_receive_offset +
                static_cast<std::uint64_t>(source_rank) *
                    dispatch_receive_shard_bytes);
        __gm__ std::uint8_t* record =
            source_shard + source_slot * token_stride_bytes;
        std::uint64_t destination = compact_slot;
        if (expanded) {
            record_topk_global.SetGlobalBuffer(
                reinterpret_cast<__gm__ std::int64_t*>(
                    record + token_topk_index_offset),
                num_topk_u32);
            const std::int32_t mapped = source_metadata_global.GetValue(
                compact_slot * (2 + num_topk_u32) + 2 + lane);
            if (record_topk_global.GetValue(lane) < 0 || mapped < 0)
                continue;
            destination = static_cast<std::uint64_t>(mapped);
        }
        for (std::uint64_t byte = 0;
             byte < consumer_copy_plan.vector_bytes; byte += TileBytes) {
            const std::uint32_t copy_bytes = static_cast<std::uint32_t>(
                consumer_copy_plan.vector_bytes - byte < TileBytes ?
                    consumer_copy_plan.vector_bytes - byte : TileBytes);
            input_global.SetGlobalBuffer(
                record + token_hidden_offset + byte,
                copy_bytes);
            output_global.SetGlobalBuffer(
                recv_x + destination * token_hidden_bytes + byte,
                copy_bytes);
            AscendC::DataCopy(payload_local, input_global, copy_bytes);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
            AscendC::DataCopy(output_global, payload_local, copy_bytes);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
        }
    }
}

__aicore__ inline void direct_dispatch_epilogue_vector_payload_select(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ const std::uint8_t* workspace,
    __gm__ std::uint8_t* recv_x,
    __gm__ const std::int32_t* source_metadata,
    std::uintptr_t transport_local_window_base,
    int transport_world_size, bool expanded,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes,
    std::uint64_t token_topk_index_offset,
    std::uint32_t consumer_tile_bytes) {
    switch (consumer_tile_bytes) {
        case 1024:
            direct_dispatch_epilogue_vector_payload_impl<1024>(
                communication_buffer, workspace, recv_x, source_metadata,
                transport_local_window_base, transport_world_size, expanded,
                num_topk, shard_capacity, dispatch_receive_offset,
                dispatch_receive_shard_bytes, workspace_status_offset,
                workspace_rank_counts_offset, workspace_rank_values_offset,
                token_stride_bytes, token_hidden_offset, token_hidden_bytes,
                token_topk_index_offset);
            return;
        case 2048:
            direct_dispatch_epilogue_vector_payload_impl<2048>(
                communication_buffer, workspace, recv_x, source_metadata,
                transport_local_window_base, transport_world_size, expanded,
                num_topk, shard_capacity, dispatch_receive_offset,
                dispatch_receive_shard_bytes, workspace_status_offset,
                workspace_rank_counts_offset, workspace_rank_values_offset,
                token_stride_bytes, token_hidden_offset, token_hidden_bytes,
                token_topk_index_offset);
            return;
        case 4096:
            direct_dispatch_epilogue_vector_payload_impl<4096>(
                communication_buffer, workspace, recv_x, source_metadata,
                transport_local_window_base, transport_world_size, expanded,
                num_topk, shard_capacity, dispatch_receive_offset,
                dispatch_receive_shard_bytes, workspace_status_offset,
                workspace_rank_counts_offset, workspace_rank_values_offset,
                token_stride_bytes, token_hidden_offset, token_hidden_bytes,
                token_topk_index_offset);
            return;
        case 8192:
            direct_dispatch_epilogue_vector_payload_impl<8192>(
                communication_buffer, workspace, recv_x, source_metadata,
                transport_local_window_base, transport_world_size, expanded,
                num_topk, shard_capacity, dispatch_receive_offset,
                dispatch_receive_shard_bytes, workspace_status_offset,
                workspace_rank_counts_offset, workspace_rank_values_offset,
                token_stride_bytes, token_hidden_offset, token_hidden_bytes,
                token_topk_index_offset);
            return;
        default:
            direct_dispatch_epilogue_vector_payload_impl<512>(
                communication_buffer, workspace, recv_x, source_metadata,
                transport_local_window_base, transport_world_size, expanded,
                num_topk, shard_capacity, dispatch_receive_offset,
                dispatch_receive_shard_bytes, workspace_status_offset,
                workspace_rank_counts_offset, workspace_rank_values_offset,
                token_stride_bytes, token_hidden_offset, token_hidden_bytes,
                token_topk_index_offset);
            return;
    }
}

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_epilogue_copy_outputs_vf(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ std::uint8_t* recv_x,
    __gm__ std::uint8_t* recv_scale_factors,
    __gm__ float* recv_topk_weights,
    __gm__ const std::int32_t* source_metadata,
    std::uintptr_t transport_local_window_base,
    int transport_world_size, CoreModeFlags mode_flags,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes,
    std::uint64_t hidden_copy_begin,
    std::uint64_t token_scale_factor_offset,
    std::uint64_t token_scale_factor_bytes,
    std::uint64_t recv_scale_factor_token_stride,
    std::uint64_t recv_scale_factor_pack_stride,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_topk_weight_offset) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::simt::load_observed(status) != 0)
        return;
    const bool expanded = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t world_size =
        static_cast<std::uint32_t>(transport_world_size);
    (void)shard_capacity;
    auto* source_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* source_bases = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    if (world_size == 0)
        return;
    const std::uint32_t last_source_rank = world_size - 1;
    const std::uint32_t total_records = static_cast<std::uint32_t>(
        source_bases[last_source_rank] + source_counts[last_source_rank]);
    const std::uint32_t copies_per_record =
        expanded ? num_topk_u32 : 1;
    const std::uint32_t logical_count =
        total_records * copies_per_record;
    const auto grid = direct_data_grid_stride(
        blockIdx.x, threadIdx.x, gridDim.x, blockDim.x);
    for (std::uint32_t logical = grid.first; logical < logical_count;
         logical += grid.stride) {
        const std::uint32_t compact_record =
            logical / copies_per_record;
        const std::uint32_t lane =
            expanded ? logical % copies_per_record : 0;
        std::uint32_t source_rank = 0;
        std::uint32_t source_slot = 0;
        if (!direct_dispatch_compact_record_coordinates(
                compact_record, source_bases, source_counts, world_size,
                &source_rank, &source_slot))
            continue;
        const std::uint64_t compact_slot = compact_record;
        __gm__ std::uint8_t* source_shard =
            transport_world_size == 1 ? communication_buffer :
            reinterpret_cast<__gm__ std::uint8_t*>(
                transport_local_window_base + dispatch_receive_offset +
                static_cast<std::uint64_t>(source_rank) *
                    dispatch_receive_shard_bytes);
        __gm__ std::uint8_t* record =
            source_shard + source_slot * token_stride_bytes;
        auto* record_topk =
            reinterpret_cast<__gm__ const std::int64_t*>(
                record + token_topk_index_offset);
        auto* record_weights =
            reinterpret_cast<__gm__ const float*>(
                record + token_topk_weight_offset);
        std::uint64_t destination = compact_slot;
        if (expanded) {
            const auto* output_metadata =
                source_metadata + compact_slot * (2 + num_topk);
            if (record_topk[lane] < 0 ||
                output_metadata[2 + lane] < 0)
                continue;
            destination = static_cast<std::uint64_t>(
                output_metadata[2 + lane]);
        }
        for (std::uint64_t byte = hidden_copy_begin;
             byte < token_hidden_bytes; ++byte)
            recv_x[destination * token_hidden_bytes + byte] =
                record[token_hidden_offset + byte];
        if (recv_scale_factors != nullptr)
            for (std::uint64_t pack = 0;
                 pack < token_scale_factor_bytes / 4; ++pack) {
                const std::uint64_t destination_offset =
                    scale_factor_byte_offset(
                        destination, pack,
                        recv_scale_factor_token_stride,
                        recv_scale_factor_pack_stride, 4);
                direct_dispatch_load_scale_factor_pack(
                    record, token_scale_factor_offset + pack * 4,
                    recv_scale_factors, destination_offset);
            }
        if (recv_topk_weights != nullptr) {
            if (expanded)
                recv_topk_weights[destination] = record_weights[lane];
            else
                for (std::uint32_t compact_lane = 0;
                     compact_lane < num_topk_u32; ++compact_lane)
                    recv_topk_weights[
                        compact_slot * num_topk + compact_lane] =
                            record_weights[compact_lane];
        }
    }
}

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_epilogue_complete_vf(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t control_offset,
    std::uint64_t workspace_status_offset) {
    if (threadIdx.x != 0)
        return;
    const auto context = make_hybrid_dispatch_context(
        transport_abi_version, transport_struct_size,
        transport_capabilities, transport_local_window_base,
        transport_channel_table, transport_peer_address_table,
        transport_topology_abi_version, transport_topology_struct_size,
        transport_world_rank, transport_world_size,
        transport_scale_up_rank, transport_scale_up_size,
        transport_scale_out_rank, transport_scale_out_size,
        transport_scale_up_direct, transport_topology_kind,
        transport_topology_epoch, transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    __gm__ std::uint8_t* control_base = transport_world_size == 1 ?
        communication_buffer :
        reinterpret_cast<__gm__ std::uint8_t*>(
            transport_local_window_base);
    auto* control = reinterpret_cast<__gm__ SymmetricControlHeader*>(
        control_base + control_offset);
    transport.store_release(
        reinterpret_cast<transport::DeviceAddress>(
            &control->dispatch_generation),
        generation);
}

__simt_vf__ __launch_bounds__(512) inline void dispatch_epilogue_vf(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ std::uint8_t* recv_x,
    __gm__ std::uint8_t* recv_scale_factors,
    __gm__ std::int64_t* recv_topk_indices,
    __gm__ float* recv_topk_weights,
    __gm__ std::int32_t* prefix_per_rank,
    __gm__ std::int32_t* prefix_per_expert,
    __gm__ std::int32_t* unaligned_per_expert,
    __gm__ std::int32_t* source_metadata,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t timeout_cycles,
    std::uint64_t num_tokens, std::uint64_t num_experts,
    std::uint64_t num_topk,
    std::uint64_t expert_alignment, std::uint64_t shard_capacity,
    std::uint64_t dispatch_output_capacity,
    std::uint64_t control_offset,
    std::uint64_t dispatch_control_offset,
    std::uint64_t dispatch_control_bytes,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_receive_shard_count,
    std::uint64_t dispatch_receive_bytes,
    std::uint64_t workspace_scratch_status_offset,
    std::uint64_t workspace_scratch_local_count_offset,
    std::uint64_t workspace_scratch_rank_counts_offset,
    std::uint64_t workspace_scratch_rank_count,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes,
    std::uint64_t token_scale_factor_offset,
    std::uint64_t token_scale_factor_bytes,
    std::uint64_t recv_scale_factor_token_stride,
    std::uint64_t recv_scale_factor_pack_stride,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_topk_weight_offset,
    std::uint64_t token_source_metadata_offset,
    std::uint32_t copy_outputs) {
    if (threadIdx.x != 0)
        return;

    const bool expanded = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    const bool cached = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const bool zero_padding = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kZeroPadding))) != 0;
    const std::uint64_t num_local_experts =
        num_experts / static_cast<std::uint64_t>(transport_world_size);
    const std::uint64_t first_local_expert =
        static_cast<std::uint64_t>(transport_world_rank) *
        num_local_experts;
    auto* source_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_scratch_rank_counts_offset);

    transport::DeviceTransportContext context{};
    context.abi_version = transport_abi_version;
    context.struct_size = transport_struct_size;
    context.capabilities = transport_capabilities;
    context.topology.abi_version = transport_topology_abi_version;
    context.topology.struct_size = transport_topology_struct_size;
    context.topology.world_rank = transport_world_rank;
    context.topology.world_size = transport_world_size;
    context.topology.scale_up_rank = transport_scale_up_rank;
    context.topology.scale_up_size = transport_scale_up_size;
    context.topology.scale_out_rank = transport_scale_out_rank;
    context.topology.scale_out_size = transport_scale_out_size;
    context.topology.scale_up_direct = transport_scale_up_direct != 0;
    context.topology.kind = static_cast<transport::TransportTopologyKind>(
        transport_topology_kind);
    context.topology.epoch = transport_topology_epoch;
    context.local_window_base = transport_local_window_base;
    context.channel_table = transport_channel_table;
    context.peer_address_table = transport_peer_address_table;
    context.backend_context = transport_backend_context;
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address =
        reinterpret_cast<transport::DeviceAddress>(
            workspace + workspace_scratch_status_offset);
    const auto local_count_address =
        reinterpret_cast<transport::DeviceAddress>(
            workspace + workspace_scratch_local_count_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    if (workspace_scratch_rank_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        (transport_world_size > 1 &&
        (dispatch_control_bytes <
             static_cast<std::uint64_t>(transport_world_size) *
                 sizeof(DispatchControlSlot) ||
         dispatch_receive_shard_count !=
             static_cast<std::uint64_t>(transport_world_size) ||
         dispatch_receive_bytes <
             dispatch_receive_shard_count * dispatch_receive_shard_bytes ||
         shard_capacity * token_stride_bytes >
             dispatch_receive_shard_bytes)))
        return record_dispatch_protocol_error(
            context, status_address, transport_world_rank,
            DispatchProtocolError::kInvalidLayout);

    if (transport_world_size == 1) {
        source_counts[0] = transport.load_acquire(local_count_address);
        if (source_counts[0] > shard_capacity)
            return record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolError::kCapacityOverflow);
    } else {
        if (transport.consumed_generation() != generation)
            return record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolError::kInvalidControl);
        auto* control_slots = reinterpret_cast<__gm__ DispatchControlSlot*>(
            transport_local_window_base + dispatch_control_offset);
        for (int source_rank = 0;
             source_rank < transport_world_size; ++source_rank) {
            const auto release_boundary = dispatch_release_boundary(
                source_rank, transport_world_rank,
                transport_scale_up_size);
            const auto observation =
                release_protocol::observe_release_control(
                    transport, context.topology, release_boundary,
                    transport_world_rank, control_slots,
                    transport::sync_layout::kDispatchReleaseSignalIndex,
                    generation, timeout_cycles);
            if (!observation.acquired)
                return record_dispatch_protocol_error(
                    context, status_address, source_rank,
                    DispatchProtocolError::kInvalidControl);
            const std::uint64_t observed_generation = observation.generation;
            const std::uint64_t observed_count = observation.count;
            if (observed_generation != generation ||
                observed_count > shard_capacity) {
                return record_dispatch_protocol_error(
                    context, status_address, source_rank,
                    observed_count > shard_capacity ?
                        DispatchProtocolError::kCapacityOverflow :
                        DispatchProtocolError::kInvalidControl);
            }
            source_counts[source_rank] = observed_count;
        }
    }

    std::uint64_t total_records = 0;
    for (int source_rank = 0;
         source_rank < transport_world_size; ++source_rank) {
        total_records += source_counts[source_rank];
        if (cached && prefix_per_rank[source_rank] !=
                static_cast<std::int32_t>(total_records))
            return record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolError::kInvalidCachedPrefix);
    }

    if (total_records >
            shard_capacity *
                static_cast<std::uint64_t>(transport_world_size) ||
        dispatch_output_capacity >
            static_cast<std::uint64_t>(0x7fffffff))
        return record_dispatch_protocol_error(
            context, status_address, transport_world_rank,
            DispatchProtocolError::kCapacityOverflow);

    // Validate every received record before mutating output tensors.
    std::uint64_t compact_validation_slot = 0;
    for (int source_rank = 0;
         source_rank < transport_world_size; ++source_rank) {
        __gm__ std::uint8_t* source_shard =
            transport_world_size == 1 ? communication_buffer :
            reinterpret_cast<__gm__ std::uint8_t*>(
                transport_local_window_base + dispatch_receive_offset +
                static_cast<std::uint64_t>(source_rank) *
                    dispatch_receive_shard_bytes);
        for (std::uint64_t source_slot = 0;
             source_slot < source_counts[source_rank];
             ++source_slot, ++compact_validation_slot) {
            __gm__ std::uint8_t* record =
                source_shard + source_slot * token_stride_bytes;
            auto record_topk =
                reinterpret_cast<__gm__ const std::int64_t*>(
                    record + token_topk_index_offset);
            auto record_metadata =
                reinterpret_cast<__gm__ const std::int32_t*>(
                    record + token_source_metadata_offset);
            bool has_local_lane = false;
            for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                const std::int64_t expert = record_topk[lane];
                if (expert < -1 ||
                    (expert >= 0 &&
                     static_cast<std::uint64_t>(expert) >= num_experts))
                    return record_dispatch_protocol_error(
                        context, status_address, source_rank,
                        DispatchProtocolError::kInvalidTopk);
                if (expert >= static_cast<std::int64_t>(first_local_expert) &&
                    expert < static_cast<std::int64_t>(
                                  first_local_expert + num_local_experts))
                    has_local_lane = true;
            }
            if (!has_local_lane ||
                !is_dispatch_local_index(record_metadata[0], shard_capacity) ||
                !is_dispatch_local_index(record_metadata[1], num_topk) ||
                record_topk[record_metadata[1]] <
                    static_cast<std::int64_t>(first_local_expert) ||
                record_topk[record_metadata[1]] >=
                    static_cast<std::int64_t>(
                        first_local_expert + num_local_experts))
                return record_dispatch_protocol_error(
                    context, status_address, source_rank,
                    DispatchProtocolError::kInvalidCachedMetadata);
            if (cached) {
                __gm__ const std::int32_t* reusable = source_metadata +
                    compact_validation_slot * (2 + num_topk);
                if (reusable[0] != encode_dispatch_source_index(
                        static_cast<std::uint64_t>(source_rank),
                        shard_capacity,
                        static_cast<std::uint64_t>(record_metadata[0])) ||
                    reusable[1] != encode_dispatch_source_index(
                        static_cast<std::uint64_t>(source_rank), num_topk,
                        static_cast<std::uint64_t>(record_metadata[1])))
                    return record_dispatch_protocol_error(
                        context, status_address, source_rank,
                        DispatchProtocolError::kInvalidCachedMetadata);
            }
        }
    }

    std::int32_t derived_prefix = 0;
    for (std::uint64_t expert = 0; expert < num_experts; ++expert) {
        std::int32_t actual_count = 0;
        const bool expert_is_local =
            is_dispatch_expert_local(
                static_cast<std::int64_t>(expert), first_local_expert,
                num_local_experts);
        if (expert_is_local) {
            for (int source_rank = 0;
                 source_rank < transport_world_size; ++source_rank) {
                __gm__ std::uint8_t* source_shard =
                    transport_world_size == 1 ? communication_buffer :
                    reinterpret_cast<__gm__ std::uint8_t*>(
                        transport_local_window_base +
                        dispatch_receive_offset +
                        static_cast<std::uint64_t>(source_rank) *
                            dispatch_receive_shard_bytes);
                for (std::uint64_t source_slot = 0;
                     source_slot < source_counts[source_rank]; ++source_slot) {
                    auto record_topk =
                        reinterpret_cast<__gm__ const std::int64_t*>(
                            source_shard + source_slot * token_stride_bytes +
                            token_topk_index_offset);
                    for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                        if (record_topk[lane] ==
                            static_cast<std::int64_t>(expert))
                            ++actual_count;
                    }
                }
            }
        }
        const std::int32_t alignment =
            static_cast<std::int32_t>(expert_alignment);
        const std::int32_t aligned_count =
            ((actual_count + alignment - 1) / alignment) * alignment;
        if (cached &&
            (unaligned_per_expert[expert] != actual_count ||
             prefix_per_expert[expert] != derived_prefix))
            return record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolError::kInvalidCachedPrefix);
        derived_prefix += aligned_count;
        if (derived_prefix < 0 ||
            static_cast<std::uint64_t>(derived_prefix) >
                dispatch_output_capacity)
            return record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolError::kCapacityOverflow);
    }
    if (cached && prefix_per_expert[num_experts] != derived_prefix)
        return record_dispatch_protocol_error(
            context, status_address, transport_world_rank,
            DispatchProtocolError::kInvalidCachedPrefix);

    if (cached && expanded) {
        std::uint64_t current_record = 0;
        for (int source_rank = 0;
             source_rank < transport_world_size; ++source_rank) {
            __gm__ std::uint8_t* source_shard =
                transport_world_size == 1 ? communication_buffer :
                reinterpret_cast<__gm__ std::uint8_t*>(
                    transport_local_window_base + dispatch_receive_offset +
                    static_cast<std::uint64_t>(source_rank) *
                        dispatch_receive_shard_bytes);
            for (std::uint64_t source_slot = 0;
                 source_slot < source_counts[source_rank];
                 ++source_slot, ++current_record) {
                auto record_topk =
                    reinterpret_cast<__gm__ const std::int64_t*>(
                        source_shard + source_slot * token_stride_bytes +
                        token_topk_index_offset);
                __gm__ const std::int32_t* reusable = source_metadata +
                    current_record * (2 + num_topk);
                for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                    const std::int64_t expert = record_topk[lane];
                    const std::int32_t destination = reusable[2 + lane];
                    const bool local =
                        expert >= static_cast<std::int64_t>(
                                      first_local_expert) &&
                        expert < static_cast<std::int64_t>(
                                     first_local_expert +
                                     num_local_experts);
                    if (!local) {
                        if (destination != -1)
                            return record_dispatch_protocol_error(
                                context, status_address, source_rank,
                                DispatchProtocolError::kInvalidCachedMetadata);
                        continue;
                    }
                    const std::int32_t begin = prefix_per_expert[expert];
                    const std::int32_t end =
                        begin + unaligned_per_expert[expert];
                    if (destination < begin || destination >= end ||
                        destination < 0 ||
                        static_cast<std::uint64_t>(destination) >=
                            dispatch_output_capacity)
                        return record_dispatch_protocol_error(
                            context, status_address, source_rank,
                            DispatchProtocolError::kInvalidCachedMetadata);
                    for (std::uint64_t previous_record = 0;
                         previous_record <= current_record;
                         ++previous_record) {
                        __gm__ const std::int32_t* previous =
                            source_metadata +
                            previous_record * (2 + num_topk);
                        const std::uint64_t lane_limit =
                            previous_record == current_record ? lane :
                            num_topk;
                        for (std::uint64_t previous_lane = 0;
                             previous_lane < lane_limit; ++previous_lane) {
                            if (previous[2 + previous_lane] == destination)
                                return record_dispatch_protocol_error(
                                    context, status_address, source_rank,
                                    DispatchProtocolError::
                                        kInvalidCachedMetadata);
                        }
                    }
                }
            }
        }
    }

    for (int source_rank = 0;
         source_rank < transport_world_size; ++source_rank) {
        if (!cached)
            prefix_per_rank[source_rank] =
                source_rank == 0 ?
                    static_cast<std::int32_t>(source_counts[0]) :
                    prefix_per_rank[source_rank - 1] +
                        static_cast<std::int32_t>(
                            source_counts[source_rank]);
    }

    if (!cached) {
        for (std::uint64_t expert = 0; expert < num_experts; ++expert) {
            unaligned_per_expert[expert] = 0;
            prefix_per_expert[expert] = 0;
        }
        prefix_per_expert[num_experts] = 0;
        for (int source_rank = 0;
             source_rank < transport_world_size; ++source_rank) {
            __gm__ std::uint8_t* source_shard =
                transport_world_size == 1 ? communication_buffer :
                reinterpret_cast<__gm__ std::uint8_t*>(
                    transport_local_window_base + dispatch_receive_offset +
                    static_cast<std::uint64_t>(source_rank) *
                        dispatch_receive_shard_bytes);
            for (std::uint64_t source_slot = 0;
                 source_slot < source_counts[source_rank]; ++source_slot) {
                __gm__ std::uint8_t* record =
                    source_shard + source_slot * token_stride_bytes;
                auto record_topk =
                    reinterpret_cast<__gm__ const std::int64_t*>(
                        record + token_topk_index_offset);
                for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                    const std::int64_t expert = record_topk[lane];
                    if (!is_dispatch_expert_local(
                            expert, first_local_expert,
                            num_local_experts))
                        continue;
                    ++unaligned_per_expert[expert];
                }
            }
        }
        std::int32_t prefix = 0;
        for (std::uint64_t expert = 0; expert < num_experts; ++expert) {
            prefix_per_expert[expert] = prefix;
            const std::int32_t count = unaligned_per_expert[expert];
            const std::int32_t alignment =
                static_cast<std::int32_t>(expert_alignment);
            prefix += ((count + alignment - 1) / alignment) * alignment;
        }
        prefix_per_expert[num_experts] = prefix;
    }

    if (copy_outputs == 0)
        return;

    if (expanded && zero_padding) {
        const std::int32_t expanded_count = prefix_per_expert[num_experts];
        for (std::int32_t slot = 0; slot < expanded_count; ++slot) {
            for (std::uint64_t byte = 0; byte < token_hidden_bytes; ++byte)
                recv_x[static_cast<std::uint64_t>(slot) *
                           token_hidden_bytes + byte] = 0;
            if (recv_scale_factors != nullptr) {
                for (std::uint64_t pack = 0;
                     pack < token_scale_factor_bytes / 4; ++pack)
                    for (std::uint64_t byte = 0; byte < 4; ++byte)
                        recv_scale_factors[scale_factor_byte_offset(
                            static_cast<std::uint64_t>(slot), pack,
                            recv_scale_factor_token_stride,
                            recv_scale_factor_pack_stride, 4) + byte] = 0;
            }
            if (recv_topk_weights != nullptr)
                recv_topk_weights[slot] = 0.0F;
        }
    }

    std::uint64_t compact_slot = 0;
    for (int source_rank = 0;
         source_rank < transport_world_size; ++source_rank) {
        __gm__ std::uint8_t* source_shard =
            transport_world_size == 1 ? communication_buffer :
            reinterpret_cast<__gm__ std::uint8_t*>(
                transport_local_window_base + dispatch_receive_offset +
                static_cast<std::uint64_t>(source_rank) *
                    dispatch_receive_shard_bytes);
        for (std::uint64_t source_slot = 0;
             source_slot < source_counts[source_rank];
             ++source_slot, ++compact_slot) {
            __gm__ std::uint8_t* record =
                source_shard + source_slot * token_stride_bytes;
            auto record_topk =
                reinterpret_cast<__gm__ const std::int64_t*>(
                    record + token_topk_index_offset);
            auto record_weights =
                reinterpret_cast<__gm__ const float*>(
                    record + token_topk_weight_offset);
            auto record_metadata =
                reinterpret_cast<__gm__ const std::int32_t*>(
                    record + token_source_metadata_offset);
            __gm__ std::int32_t* output_metadata = source_metadata +
                compact_slot * (2 + num_topk);

            if (!cached) {
                output_metadata[0] = encode_dispatch_source_index(
                    static_cast<std::uint64_t>(source_rank), shard_capacity,
                    static_cast<std::uint64_t>(record_metadata[0]));
                output_metadata[1] = encode_dispatch_source_index(
                    static_cast<std::uint64_t>(source_rank), num_topk,
                    static_cast<std::uint64_t>(record_metadata[1]));
                for (std::uint64_t lane = 0; lane < num_topk; ++lane)
                    output_metadata[2 + lane] = -1;
            }
            for (std::uint64_t lane = 0; lane < num_topk; ++lane)
                recv_topk_indices[compact_slot * num_topk + lane] =
                    localize_dispatch_expert(
                        record_topk[lane], first_local_expert,
                        num_local_experts);
            if (!expanded) {
                for (std::uint64_t byte = 0;
                     byte < token_hidden_bytes; ++byte)
                    recv_x[compact_slot * token_hidden_bytes + byte] =
                        record[token_hidden_offset + byte];
                if (recv_scale_factors != nullptr) {
                    for (std::uint64_t pack = 0;
                         pack < token_scale_factor_bytes / 4; ++pack)
                        for (std::uint64_t byte = 0; byte < 4; ++byte)
                            recv_scale_factors[scale_factor_byte_offset(
                                compact_slot, pack,
                                recv_scale_factor_token_stride,
                                recv_scale_factor_pack_stride, 4) + byte] =
                                record[token_scale_factor_offset +
                                       pack * 4 + byte];
                }
                for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                    if (recv_topk_weights != nullptr)
                        recv_topk_weights[compact_slot * num_topk + lane] =
                            record_weights[lane];
                }
                continue;
            }

            for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                const std::int64_t expert = record_topk[lane];
                if (expert < static_cast<std::int64_t>(first_local_expert) ||
                    expert >= static_cast<std::int64_t>(
                                  first_local_expert + num_local_experts))
                    continue;
                std::int32_t destination = output_metadata[2 + lane];
                if (!cached) {
                    std::int32_t occurrence = 0;
                    for (int prior_rank = 0;
                         prior_rank <= source_rank; ++prior_rank) {
                        __gm__ std::uint8_t* prior_shard =
                            transport_world_size == 1 ? communication_buffer :
                            reinterpret_cast<__gm__ std::uint8_t*>(
                                transport_local_window_base +
                                dispatch_receive_offset +
                                static_cast<std::uint64_t>(prior_rank) *
                                    dispatch_receive_shard_bytes);
                        const std::uint64_t record_limit =
                            prior_rank == source_rank ? source_slot + 1 :
                            source_counts[prior_rank];
                        for (std::uint64_t prior_slot = 0;
                             prior_slot < record_limit; ++prior_slot) {
                            auto prior_topk =
                                reinterpret_cast<__gm__ const std::int64_t*>(
                                    prior_shard +
                                    prior_slot * token_stride_bytes +
                                    token_topk_index_offset);
                            const std::uint64_t lane_limit =
                                prior_rank == source_rank &&
                                prior_slot == source_slot ? lane : num_topk;
                            for (std::uint64_t prior_lane = 0;
                                 prior_lane < lane_limit; ++prior_lane) {
                                if (prior_topk[prior_lane] == expert)
                                    ++occurrence;
                            }
                        }
                    }
                    destination = prefix_per_expert[expert] + occurrence;
                    output_metadata[2 + lane] = destination;
                } else if (destination < prefix_per_expert[expert] ||
                           destination >=
                               prefix_per_expert[expert] +
                                   unaligned_per_expert[expert] ||
                           destination < 0 ||
                           static_cast<std::uint64_t>(destination) >=
                               dispatch_output_capacity) {
                    return record_dispatch_protocol_error(
                        context, status_address, source_rank,
                        DispatchProtocolError::kInvalidCachedMetadata);
                }
                for (std::uint64_t byte = 0;
                     byte < token_hidden_bytes; ++byte)
                    recv_x[static_cast<std::uint64_t>(destination) *
                               token_hidden_bytes + byte] =
                        record[token_hidden_offset + byte];
                if (recv_scale_factors != nullptr) {
                    for (std::uint64_t pack = 0;
                         pack < token_scale_factor_bytes / 4; ++pack)
                        for (std::uint64_t byte = 0; byte < 4; ++byte)
                            recv_scale_factors[scale_factor_byte_offset(
                                static_cast<std::uint64_t>(destination), pack,
                                recv_scale_factor_token_stride,
                                recv_scale_factor_pack_stride, 4) + byte] =
                                record[token_scale_factor_offset +
                                       pack * 4 + byte];
                }
                if (recv_topk_weights != nullptr)
                    recv_topk_weights[destination] = record_weights[lane];
            }
        }
    }

    __gm__ std::uint8_t* control_base = transport_world_size == 1 ?
        communication_buffer :
        reinterpret_cast<__gm__ std::uint8_t*>(
            transport_local_window_base);
    auto* control = reinterpret_cast<__gm__ SymmetricControlHeader*>(
        control_base + control_offset);
    transport.store_release(
        reinterpret_cast<transport::DeviceAddress>(
            &control->dispatch_generation),
        generation);
}

#define DEEP_EP_ASCEND_DIRECT_DISPATCH_EPILOGUE( \
    COPY_OUTPUTS, STAGE, EARLY_ROUTE_PLAN, PERSISTENT_SOURCE_PIPELINE) \
    do { \
        if ((STAGE) == DirectDispatchStage::kFull || \
            (STAGE) == DirectDispatchStage::kEpilogueAcquire) { \
        asc_vf_call<direct_dispatch_epilogue_acquire_vf>( \
            dim3(tiling.launch.num_threads), communication_buffer, workspace, \
            prefix_per_rank, tiling.transport_context.abi_version, \
            tiling.transport_context.struct_size, \
            tiling.transport_context.capabilities, \
            tiling.transport_context.local_window_base, \
            tiling.transport_context.channel_table, \
            tiling.transport_context.peer_address_table, \
            tiling.transport_context.topology.abi_version, \
            tiling.transport_context.topology.struct_size, \
            tiling.transport_context.topology.world_rank, \
            tiling.transport_context.topology.world_size, \
            tiling.transport_context.topology.scale_up_rank, \
            tiling.transport_context.topology.scale_up_size, \
            tiling.transport_context.topology.scale_out_rank, \
            tiling.transport_context.topology.scale_out_size, \
            static_cast<std::uint32_t>( \
                tiling.transport_context.topology.scale_up_direct), \
            static_cast<std::uint32_t>( \
                tiling.transport_context.topology.kind), \
            tiling.transport_context.topology.epoch, \
            tiling.transport_context.backend_context, tiling.mode_flags, \
            generation, timeout_cycles, tiling.num_experts, \
            tiling.expert_alignment, tiling.num_max_tokens_per_rank, \
            tiling.dispatch_output_capacity, \
            tiling.symmetric_window_layout.dispatch_control_offset, \
            tiling.symmetric_window_layout.dispatch_control_bytes, \
            tiling.symmetric_window_layout.dispatch_receive_shard_bytes, \
            tiling.symmetric_window_layout.dispatch_receive_shard_count, \
            tiling.symmetric_window_layout.dispatch_receive_bytes, \
            tiling.workspace_layout.scratch_status_offset, \
            tiling.workspace_layout.scratch_local_count_offset, \
            tiling.workspace_layout.scratch_rank_counts_offset, \
            tiling.workspace_layout.dispatch_route_source_counts_offset, \
            tiling.workspace_layout.scratch_rank_values_offset, \
            tiling.workspace_layout.scratch_rank_count, \
            tiling.workspace_layout.dispatch_error_offset, \
            tiling.workspace_layout.dispatch_error_count, \
            tiling.workspace_layout.dispatch_rank_bitmap_bytes, \
            tiling.workspace_layout.dispatch_expert_bitmap_bytes, \
            tiling.workspace_layout.dispatch_pipeline_offset, \
            tiling.workspace_layout.dispatch_pipeline_bytes, \
            tiling.token_layout.stride_bytes, (EARLY_ROUTE_PLAN), \
            (PERSISTENT_SOURCE_PIPELINE)); \
        } \
        if ((STAGE) == DirectDispatchStage::kFull || \
            (STAGE) == DirectDispatchStage::kEpilogueValidate) { \
        asc_vf_call<direct_dispatch_epilogue_validate_records_vf>( \
            dim3(tiling.launch.num_threads), communication_buffer, workspace, \
            source_metadata, tiling.transport_context.local_window_base, \
            tiling.transport_context.topology.world_rank, \
            tiling.transport_context.topology.world_size, tiling.mode_flags, \
            generation, tiling.num_experts, tiling.num_topk, \
            tiling.num_max_tokens_per_rank, \
            tiling.symmetric_window_layout.dispatch_receive_offset, \
            tiling.symmetric_window_layout.dispatch_receive_shard_bytes, \
            tiling.workspace_layout.scratch_status_offset, \
            tiling.workspace_layout.scratch_rank_counts_offset, \
            tiling.workspace_layout.scratch_rank_values_offset, \
            tiling.workspace_layout.dispatch_receive_tile_error_offset, \
            tiling.workspace_layout.dispatch_receive_tile_count, \
            tiling.token_layout.stride_bytes, \
            tiling.token_layout.topk_index_offset, \
            tiling.token_layout.source_metadata_offset); \
        } \
        if ((STAGE) == DirectDispatchStage::kFull || \
            (STAGE) == DirectDispatchStage::kEpilogueValidateReduce) { \
        asc_vf_call<direct_dispatch_reduce_errors_vf>( \
            dim3(tiling.launch.num_threads), workspace, \
            tiling.transport_context.abi_version, \
            tiling.transport_context.struct_size, \
            tiling.transport_context.capabilities, \
            tiling.transport_context.local_window_base, \
            tiling.transport_context.channel_table, \
            tiling.transport_context.peer_address_table, \
            tiling.transport_context.topology.abi_version, \
            tiling.transport_context.topology.struct_size, \
            tiling.transport_context.topology.world_rank, \
            tiling.transport_context.topology.world_size, \
            tiling.transport_context.topology.scale_up_rank, \
            tiling.transport_context.topology.scale_up_size, \
            tiling.transport_context.topology.scale_out_rank, \
            tiling.transport_context.topology.scale_out_size, \
            static_cast<std::uint32_t>( \
                tiling.transport_context.topology.scale_up_direct), \
            static_cast<std::uint32_t>( \
                tiling.transport_context.topology.kind), \
            tiling.transport_context.topology.epoch, \
            tiling.transport_context.backend_context, generation, \
            static_cast<std::uint32_t>( \
                DispatchProtocolStage::kEpilogue), \
            tiling.workspace_layout.scratch_status_offset, \
            tiling.workspace_layout.dispatch_receive_tile_error_offset, 0, \
            tiling.workspace_layout.dispatch_receive_tile_count); \
        } \
        if ((EARLY_ROUTE_PLAN) == 0 && \
            ((STAGE) == DirectDispatchStage::kFull || \
             (STAGE) == DirectDispatchStage::kEpilogueExpertCount)) { \
        asc_vf_call<direct_dispatch_epilogue_count_experts_vf>( \
            dim3(tiling.launch.num_threads), communication_buffer, workspace, \
            tiling.transport_context.local_window_base, \
            tiling.transport_context.topology.world_rank, \
            tiling.transport_context.topology.world_size, \
            tiling.num_experts, tiling.num_topk, \
            tiling.num_max_tokens_per_rank, \
            tiling.symmetric_window_layout.dispatch_receive_offset, \
            tiling.symmetric_window_layout.dispatch_receive_shard_bytes, \
            tiling.workspace_layout.scratch_status_offset, \
            tiling.workspace_layout.scratch_rank_counts_offset, \
            tiling.workspace_layout.dispatch_expert_tile_count_offset, \
            tiling.workspace_layout.dispatch_expert_tile_count, \
            tiling.token_layout.stride_bytes, \
            tiling.token_layout.topk_index_offset); \
        } \
        if ((EARLY_ROUTE_PLAN) == 0 && \
            ((STAGE) == DirectDispatchStage::kFull || \
             (STAGE) == DirectDispatchStage::kEpilogueExpertPrefix)) { \
        if (parallel_prefix != 0) { \
        asc_vf_call<direct_dispatch_epilogue_parallel_prefix_vf>( \
            dim3(tiling.launch.num_threads), workspace, prefix_per_rank, \
            prefix_per_expert, unaligned_per_expert, \
            tiling.transport_context.abi_version, \
            tiling.transport_context.struct_size, \
            tiling.transport_context.capabilities, \
            tiling.transport_context.local_window_base, \
            tiling.transport_context.channel_table, \
            tiling.transport_context.peer_address_table, \
            tiling.transport_context.topology.abi_version, \
            tiling.transport_context.topology.struct_size, \
            tiling.transport_context.topology.world_rank, \
            tiling.transport_context.topology.world_size, \
            tiling.transport_context.topology.scale_up_rank, \
            tiling.transport_context.topology.scale_up_size, \
            tiling.transport_context.topology.scale_out_rank, \
            tiling.transport_context.topology.scale_out_size, \
            static_cast<std::uint32_t>( \
                tiling.transport_context.topology.scale_up_direct), \
            static_cast<std::uint32_t>( \
                tiling.transport_context.topology.kind), \
            tiling.transport_context.topology.epoch, \
            tiling.transport_context.backend_context, generation, \
            tiling.num_experts, tiling.expert_alignment, \
            tiling.dispatch_output_capacity, \
            tiling.workspace_layout.scratch_status_offset, \
            tiling.workspace_layout.scratch_rank_counts_offset, \
            tiling.workspace_layout.dispatch_expert_tile_count_offset, \
            tiling.workspace_layout.dispatch_expert_tile_count); \
        } else { \
        asc_vf_call<direct_dispatch_epilogue_prefix_vf>( \
            dim3(tiling.launch.num_threads), workspace, prefix_per_rank, \
            prefix_per_expert, unaligned_per_expert, \
            tiling.transport_context.abi_version, \
            tiling.transport_context.struct_size, \
            tiling.transport_context.capabilities, \
            tiling.transport_context.local_window_base, \
            tiling.transport_context.channel_table, \
            tiling.transport_context.peer_address_table, \
            tiling.transport_context.topology.abi_version, \
            tiling.transport_context.topology.struct_size, \
            tiling.transport_context.topology.world_rank, \
            tiling.transport_context.topology.world_size, \
            tiling.transport_context.topology.scale_up_rank, \
            tiling.transport_context.topology.scale_up_size, \
            tiling.transport_context.topology.scale_out_rank, \
            tiling.transport_context.topology.scale_out_size, \
            static_cast<std::uint32_t>( \
                tiling.transport_context.topology.scale_up_direct), \
            static_cast<std::uint32_t>( \
                tiling.transport_context.topology.kind), \
            tiling.transport_context.topology.epoch, \
            tiling.transport_context.backend_context, tiling.mode_flags, \
            generation, tiling.num_experts, tiling.expert_alignment, \
            tiling.dispatch_output_capacity, \
            tiling.workspace_layout.scratch_status_offset, \
            tiling.workspace_layout.scratch_rank_counts_offset, \
            tiling.workspace_layout.dispatch_expert_tile_count_offset, \
            tiling.workspace_layout.dispatch_expert_tile_count); \
        } \
        } \
        if ((STAGE) == DirectDispatchStage::kFull || \
            (STAGE) == DirectDispatchStage::kEpilogueMetadata) { \
        if ((COPY_OUTPUTS) != 0) { \
            asc_vf_call<direct_dispatch_epilogue_metadata_vf>( \
                dim3(tiling.launch.num_threads), communication_buffer, \
                workspace, recv_topk_indices, source_metadata, \
                tiling.transport_context.local_window_base, \
                tiling.transport_context.topology.world_rank, \
                tiling.transport_context.topology.world_size, \
                tiling.mode_flags, tiling.num_experts, tiling.num_topk, \
                tiling.num_max_tokens_per_rank, \
                tiling.symmetric_window_layout.dispatch_receive_offset, \
                tiling.symmetric_window_layout \
                    .dispatch_receive_shard_bytes, \
                tiling.workspace_layout.scratch_status_offset, \
                tiling.workspace_layout.scratch_rank_counts_offset, \
                tiling.workspace_layout.scratch_rank_values_offset, \
                tiling.token_layout.stride_bytes, \
                tiling.token_layout.topk_index_offset, \
                tiling.token_layout.source_metadata_offset); \
            asc_vf_call< \
                direct_dispatch_epilogue_assign_destinations_vf>( \
                dim3(tiling.launch.num_threads), communication_buffer, \
                workspace, prefix_per_expert, unaligned_per_expert, \
                source_metadata, \
                tiling.transport_context.local_window_base, \
                tiling.transport_context.topology.world_rank, \
                tiling.transport_context.topology.world_size, \
                tiling.mode_flags, generation, tiling.num_experts, \
                tiling.num_topk, tiling.num_max_tokens_per_rank, \
                tiling.dispatch_output_capacity, \
                tiling.symmetric_window_layout.dispatch_receive_offset, \
                tiling.symmetric_window_layout \
                    .dispatch_receive_shard_bytes, \
                tiling.workspace_layout.scratch_status_offset, \
                tiling.workspace_layout.scratch_rank_counts_offset, \
                tiling.workspace_layout.scratch_rank_values_offset, \
                tiling.workspace_layout.dispatch_expert_tile_count_offset, \
                tiling.workspace_layout.dispatch_expert_tile_count, \
                tiling.workspace_layout.dispatch_error_offset, \
                tiling.workspace_layout.dispatch_expert_bitmap_offset, \
                tiling.token_layout.stride_bytes, \
                tiling.token_layout.topk_index_offset); \
            asc_vf_call<direct_dispatch_reduce_errors_vf>( \
                dim3(tiling.launch.num_threads), workspace, \
                tiling.transport_context.abi_version, \
                tiling.transport_context.struct_size, \
                tiling.transport_context.capabilities, \
                tiling.transport_context.local_window_base, \
                tiling.transport_context.channel_table, \
                tiling.transport_context.peer_address_table, \
                tiling.transport_context.topology.abi_version, \
                tiling.transport_context.topology.struct_size, \
                tiling.transport_context.topology.world_rank, \
                tiling.transport_context.topology.world_size, \
                tiling.transport_context.topology.scale_up_rank, \
                tiling.transport_context.topology.scale_up_size, \
                tiling.transport_context.topology.scale_out_rank, \
                tiling.transport_context.topology.scale_out_size, \
                static_cast<std::uint32_t>( \
                    tiling.transport_context.topology.scale_up_direct), \
                static_cast<std::uint32_t>( \
                    tiling.transport_context.topology.kind), \
                tiling.transport_context.topology.epoch, \
                tiling.transport_context.backend_context, generation, \
                static_cast<std::uint32_t>( \
                    DispatchProtocolStage::kEpilogue), \
                tiling.workspace_layout.scratch_status_offset, \
                tiling.workspace_layout.dispatch_error_offset, \
                static_cast<std::uint64_t>( \
                    tiling.transport_context.topology.world_size), \
                tiling.num_experts / static_cast<std::uint64_t>( \
                    tiling.transport_context.topology.world_size)); \
            asc_vf_call<direct_dispatch_epilogue_clear_padding_vf>( \
                dim3(tiling.launch.num_threads), workspace, recv_x, \
                recv_scale_factors, recv_topk_weights, prefix_per_expert, \
                tiling.mode_flags, tiling.num_experts, \
                tiling.token_layout.hidden_bytes, \
                tiling.token_layout.scale_factor_bytes, \
                recv_scale_factor_token_stride, \
                recv_scale_factor_pack_stride, \
                tiling.workspace_layout.scratch_status_offset); \
        } \
        } \
        if ((COPY_OUTPUTS) != 0 && \
            ((STAGE) == DirectDispatchStage::kFull || \
             (STAGE) == DirectDispatchStage::kEpilogueCopy)) { \
            const auto consumer_copy_plan = dispatch_consumer_copy_plan( \
                tiling.token_layout.hidden_bytes, consumer_tile_bytes, 32); \
            asc_vf_call<direct_dispatch_epilogue_copy_outputs_vf>( \
                dim3(tiling.launch.num_threads), communication_buffer, \
                workspace, recv_x, recv_scale_factors, recv_topk_weights, \
                source_metadata, \
                tiling.transport_context.local_window_base, \
                tiling.transport_context.topology.world_size, \
                tiling.mode_flags, tiling.num_topk, \
                tiling.num_max_tokens_per_rank, \
                tiling.symmetric_window_layout.dispatch_receive_offset, \
                tiling.symmetric_window_layout \
                    .dispatch_receive_shard_bytes, \
                tiling.workspace_layout.scratch_status_offset, \
                tiling.workspace_layout.scratch_rank_counts_offset, \
                tiling.workspace_layout.scratch_rank_values_offset, \
                tiling.token_layout.stride_bytes, \
                tiling.token_layout.hidden_offset, \
                tiling.token_layout.hidden_bytes, \
                (STAGE) == DirectDispatchStage::kEpilogueCopy ? \
                    consumer_copy_plan.scalar_begin : 0, \
                tiling.token_layout.scale_factor_offset, \
                tiling.token_layout.scale_factor_bytes, \
                recv_scale_factor_token_stride, \
                recv_scale_factor_pack_stride, \
                tiling.token_layout.topk_index_offset, \
                tiling.token_layout.topk_weight_offset); \
            if ((STAGE) == DirectDispatchStage::kEpilogueCopy && \
                consumer_copy_plan.vector_bytes != 0) { \
                direct_dispatch_epilogue_vector_payload_select( \
                    communication_buffer, workspace, recv_x, \
                    source_metadata, \
                    tiling.transport_context.local_window_base, \
                    tiling.transport_context.topology.world_size, \
                    (tiling.mode_flags & (CoreModeFlags{1} << \
                        static_cast<std::uint8_t>( \
                            CoreMode::kExpanded))) != 0, \
                    tiling.num_topk, \
                    tiling.num_max_tokens_per_rank, \
                    tiling.symmetric_window_layout \
                        .dispatch_receive_offset, \
                    tiling.symmetric_window_layout \
                        .dispatch_receive_shard_bytes, \
                    tiling.workspace_layout.scratch_status_offset, \
                    tiling.workspace_layout.scratch_rank_counts_offset, \
                    tiling.workspace_layout.scratch_rank_values_offset, \
                    tiling.token_layout.stride_bytes, \
                    tiling.token_layout.hidden_offset, \
                    tiling.token_layout.hidden_bytes, \
                    tiling.token_layout.topk_index_offset, \
                    consumer_tile_bytes); \
            } \
        } \
        if ((COPY_OUTPUTS) != 0 && \
            ((STAGE) == DirectDispatchStage::kFull || \
             (STAGE) == DirectDispatchStage::kEpilogueComplete)) { \
            asc_vf_call<direct_dispatch_epilogue_complete_vf>( \
                dim3(tiling.launch.num_threads), communication_buffer, \
                workspace, tiling.transport_context.abi_version, \
                tiling.transport_context.struct_size, \
                tiling.transport_context.capabilities, \
                tiling.transport_context.local_window_base, \
                tiling.transport_context.channel_table, \
                tiling.transport_context.peer_address_table, \
                tiling.transport_context.topology.abi_version, \
                tiling.transport_context.topology.struct_size, \
                tiling.transport_context.topology.world_rank, \
                tiling.transport_context.topology.world_size, \
                tiling.transport_context.topology.scale_up_rank, \
                tiling.transport_context.topology.scale_up_size, \
                tiling.transport_context.topology.scale_out_rank, \
                tiling.transport_context.topology.scale_out_size, \
                static_cast<std::uint32_t>( \
                    tiling.transport_context.topology.scale_up_direct), \
                static_cast<std::uint32_t>( \
                    tiling.transport_context.topology.kind), \
                tiling.transport_context.topology.epoch, \
                tiling.transport_context.backend_context, generation, \
                tiling.symmetric_window_layout.control_offset, \
                tiling.workspace_layout.scratch_status_offset); \
        } \
    } while (0)

template <bool ProfileEnabled>
__aicore__ inline void direct_dispatch_release_chunk_device(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    std::uint64_t generation,
    std::uint64_t timeout_cycles,
    std::uint64_t chunk_begin,
    std::uint64_t chunk_end,
    std::uint32_t chunk_index,
    std::uint32_t final_chunk,
    std::uint32_t source_chunk,
    DirectReleaseSegment release_segment,
    const CoreTiling& tiling) {
    asc_vf_call<direct_dispatch_producer_release_vf>(
        dim3(tiling.launch.num_threads), communication_buffer,
        workspace, tiling.transport_context.abi_version,
        tiling.transport_context.struct_size,
        tiling.transport_context.capabilities,
        tiling.transport_context.local_window_base,
        tiling.transport_context.channel_table,
        tiling.transport_context.peer_address_table,
        tiling.transport_context.topology.abi_version,
        tiling.transport_context.topology.struct_size,
        tiling.transport_context.topology.world_rank,
        tiling.transport_context.topology.world_size,
        tiling.transport_context.topology.scale_up_rank,
        tiling.transport_context.topology.scale_up_size,
        tiling.transport_context.topology.scale_out_rank,
        tiling.transport_context.topology.scale_out_size,
        static_cast<std::uint32_t>(
            tiling.transport_context.topology.scale_up_direct),
        static_cast<std::uint32_t>(
            tiling.transport_context.topology.kind),
        tiling.transport_context.topology.epoch,
        tiling.transport_context.backend_context,
        generation, timeout_cycles,
        tiling.symmetric_window_layout.dispatch_control_offset,
        tiling.symmetric_window_layout.dispatch_receive_offset,
        tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
        tiling.symmetric_window_layout.dispatch_staging_offset,
        tiling.symmetric_window_layout.dispatch_staging_shard_bytes,
        tiling.workspace_layout.scratch_status_offset,
        tiling.workspace_layout.scratch_local_count_offset,
        tiling.workspace_layout.scratch_rank_counts_offset,
        tiling.workspace_layout.dispatch_pipeline_offset,
        tiling.workspace_layout.dispatch_pipeline_bytes,
        tiling.workspace_layout.dispatch_group_tile_offset,
        tiling.workspace_layout.dispatch_group_tile_count,
        chunk_begin, chunk_end, chunk_index, final_chunk, source_chunk,
        tiling.token_layout.stride_bytes,
        static_cast<std::uint32_t>(release_segment));
    asc_sync_vec();
    asc_sync_data_barrier(mem_dsb_t::DSB_DDR);
    transport::service::execute<ProfileEnabled>(tiling.transport_context);
}

__aicore__ inline void direct_dispatch_pipeline_fail_aicore(
    __gm__ DispatchPipelineState* pipeline,
    __gm__ DispatchPipelineSlot* slot, __gm__ std::uint8_t* workspace,
    std::uint64_t workspace_status_offset, int world_rank,
    std::uint32_t detail) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    transport::aicore::flush_cacheline(status);
    if (transport::aicore::load_device(status) == 0) {
        const std::uint64_t scratch_status =
            (static_cast<std::uint64_t>(world_rank + 1) << 32U) |
            static_cast<std::uint32_t>(
                DispatchProtocolError::kInvalidControl);
        transport::aicore::store_device(status, scratch_status);
    }
    transport::aicore::store_device(
        reinterpret_cast<__gm__ std::uint32_t*>(
            &pipeline->terminal_error),
        static_cast<std::uint32_t>(
            transport::DeviceTransportError::kCompletionTimeout));
    transport::aicore::store_device(&pipeline->diagnostic_detail, detail);
    transport::aicore::store_device(
        reinterpret_cast<__gm__ std::uint32_t*>(
            &pipeline->producer_worker_state),
        static_cast<std::uint32_t>(
            DispatchPipelineWorkerState::kFailed));
    transport::aicore::store_device(
        reinterpret_cast<__gm__ std::uint32_t*>(
            &pipeline->release_worker_state),
        static_cast<std::uint32_t>(
            DispatchPipelineWorkerState::kFailed));
    if (slot != nullptr)
        transport::aicore::store_device(
            reinterpret_cast<__gm__ std::uint32_t*>(&slot->state),
            static_cast<std::uint32_t>(
                DispatchPipelineSlotState::kFailed));
    transport::aicore::system_fence();
    transport::aicore::flush_cacheline(status);
    transport::aicore::flush_cacheline(
        &pipeline->release_completed_generation);
    if (slot != nullptr)
        transport::aicore::flush_cacheline(slot);
}

__aicore__ inline void dispatch_aicore_poll_nop() {
    transport::aicore::poll_nop();
}

__aicore__ inline void direct_dispatch_pipeline_stage_aicore(
    __gm__ DispatchPipelineState* pipeline,
    DispatchPipelineDiagnosticStage stage, std::uint32_t detail) {
    transport::aicore::store_device(
        reinterpret_cast<__gm__ std::uint32_t*>(
            &pipeline->diagnostic_stage),
        static_cast<std::uint32_t>(stage));
    transport::aicore::store_device(&pipeline->diagnostic_detail, detail);
    transport::aicore::system_fence();
    transport::aicore::flush_cacheline(
        &pipeline->release_completed_generation);
}

__aicore__ inline void direct_dispatch_persistent_producer_device(
    __gm__ const std::uint8_t* x,
    __gm__ const std::uint8_t* scale_factors,
    __gm__ const std::int64_t* topk_indices,
    __gm__ const float* topk_weights,
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ std::int32_t* destination_slots,
    std::uint64_t scale_factor_token_stride,
    std::uint64_t scale_factor_pack_stride,
    std::uint64_t generation,
    std::uint64_t timeout_cycles,
    std::uint32_t source_chunk_tiles,
    std::uint32_t source_chunk_count,
    std::uint32_t token_fanout,
    const CoreTiling& tiling) {
    auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
        workspace + tiling.workspace_layout.dispatch_pipeline_offset);
    const std::uint32_t block_index =
        static_cast<std::uint32_t>(AscendC::GetBlockIdx());
    const std::uint32_t producer_blocks =
        tiling.data_launch.num_blocks;
    if (block_index == 0) {
        transport::aicore::store_device(
            &pipeline->abi_version, kDispatchPipelineAbiVersion);
        transport::aicore::store_device(
            &pipeline->struct_size,
            static_cast<std::uint32_t>(sizeof(DispatchPipelineState)));
        transport::aicore::store_device(
            &pipeline->chunk_count, source_chunk_count);
        transport::aicore::store_device(&pipeline->completed_chunks, 0U);
        transport::aicore::store_device(
            &pipeline->chunk_slots,
            static_cast<std::uint64_t>(source_chunk_tiles));
        transport::aicore::store_device(
            reinterpret_cast<__gm__ std::uint32_t*>(
                &pipeline->terminal_error),
            static_cast<std::uint32_t>(
                transport::DeviceTransportError::kNone));
        transport::aicore::store_device(
            &pipeline->release_completed_generation, std::uint64_t{0});
        transport::aicore::store_device(
            &pipeline->producer_completed_generation, std::uint64_t{0});
        transport::aicore::store_device(
            &pipeline->release_batch_target, 0U);
        transport::aicore::store_device(
            &pipeline->release_batch_consumed, 0U);
        transport::aicore::store_device(
            reinterpret_cast<__gm__ std::uint32_t*>(
                &pipeline->release_worker_state),
            static_cast<std::uint32_t>(
                DispatchPipelineWorkerState::kIdle));
        transport::aicore::store_device(
            reinterpret_cast<__gm__ std::uint32_t*>(
                &pipeline->producer_worker_state),
            static_cast<std::uint32_t>(
                DispatchPipelineWorkerState::kRunning));
        direct_dispatch_pipeline_stage_aicore(
            pipeline, DispatchPipelineDiagnosticStage::kProducerStarted, 0U);
        for (std::uint32_t slot_index = 0;
             slot_index < kDispatchPipelineSlotCount; ++slot_index) {
            auto* slot = &pipeline->slots[slot_index];
            transport::aicore::store_device(
                &slot->chunk_begin, std::uint64_t{0});
            transport::aicore::store_device(
                &slot->chunk_end, std::uint64_t{0});
            transport::aicore::store_device(&slot->chunk_index, 0U);
            transport::aicore::store_device(
                &slot->scalar_blocks_completed, 0U);
            transport::aicore::store_device(
                &slot->hidden_blocks_completed, 0U);
            transport::aicore::store_device(
                &slot->published_chunk, UINT32_MAX);
            transport::aicore::store_device(
                reinterpret_cast<__gm__ std::uint32_t*>(&slot->state),
                static_cast<std::uint32_t>(
                    DispatchPipelineSlotState::kEmpty));
            transport::aicore::flush_cacheline(slot);
        }
        for (std::uint32_t block = 0; block < producer_blocks; ++block) {
            for (std::uint32_t chunk = 0;
                 chunk < kDispatchPipelineMaximumChunks; ++chunk) {
                auto* progress = &pipeline->scalar_progress[block][chunk];
                transport::aicore::store_device(
                    &progress->generation, std::uint64_t{0});
                transport::aicore::store_device(
                    &progress->completed_chunk, UINT32_MAX);
                transport::aicore::flush_cacheline(progress);
            }
            auto* progress = &pipeline->hidden_progress[block];
            transport::aicore::store_device(
                &progress->generation, std::uint64_t{0});
            transport::aicore::store_device(
                &progress->completed_chunk, UINT32_MAX);
            transport::aicore::flush_cacheline(progress);
        }
        transport::aicore::system_fence();
        transport::aicore::flush_cacheline(
            &pipeline->release_completed_generation);
        transport::aicore::store_device(&pipeline->generation, generation);
        transport::aicore::system_fence();
        transport::aicore::flush_cacheline(pipeline);
    } else {
        const std::uint64_t generation_wait_start = __asc_aicore::clock();
        while (true) {
            dispatch_aicore_poll_nop();
            transport::aicore::flush_cacheline(pipeline);
            if (transport::aicore::load_published(&pipeline->generation) ==
                generation)
                break;
            if (dispatch_aicore_pipeline_wait_timed_out(
                    generation_wait_start, __asc_aicore::clock(),
                    timeout_cycles)) {
                direct_dispatch_pipeline_fail_aicore(
                    pipeline, nullptr, workspace,
                    tiling.workspace_layout.scratch_status_offset,
                    tiling.transport_context.topology.world_rank,
                    block_index << 16U);
                return;
            }
        }
    }
    const std::uint64_t vector_hidden_bytes = token_fanout != 0 ?
        tiling.token_layout.hidden_bytes -
            tiling.token_layout.hidden_bytes %
                kDispatchTokenFanoutAlignmentBytes :
        tiling.token_layout.hidden_bytes -
            tiling.token_layout.hidden_bytes %
                kDispatchProducerVectorTileBytes;
    asc_vf_call<direct_dispatch_persistent_producer_vf>(
        dim3(tiling.launch.num_threads), x, scale_factors, topk_indices,
        topk_weights, communication_buffer, workspace, destination_slots,
        tiling.transport_context.local_window_base,
        tiling.transport_context.topology.world_rank,
        tiling.transport_context.topology.world_size, tiling.mode_flags, 1U,
        tiling.num_tokens, tiling.num_experts, tiling.num_topk,
        tiling.num_max_tokens_per_rank,
        tiling.symmetric_window_layout.dispatch_receive_offset,
        tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
        tiling.symmetric_window_layout.dispatch_staging_offset,
        tiling.symmetric_window_layout.dispatch_staging_shard_bytes,
        tiling.workspace_layout.scratch_status_offset,
        tiling.workspace_layout.dispatch_group_owner_offset,
        tiling.workspace_layout.dispatch_group_tile_offset,
        tiling.workspace_layout.dispatch_group_tile_count,
        tiling.workspace_layout.dispatch_pipeline_offset,
        tiling.token_layout.stride_bytes,
        tiling.token_layout.hidden_offset,
        tiling.token_layout.hidden_bytes, vector_hidden_bytes,
        source_chunk_tiles, source_chunk_count,
        tiling.token_layout.scale_factor_offset,
        tiling.token_layout.scale_factor_bytes,
        scale_factor_token_stride, scale_factor_pack_stride,
        tiling.token_layout.topk_index_offset,
        tiling.token_layout.topk_weight_offset,
        tiling.token_layout.source_metadata_offset, generation,
        timeout_cycles);

    for (std::uint32_t source_chunk = 0;
         source_chunk < source_chunk_count; ++source_chunk) {
        auto* slot = &pipeline->slots[
            dispatch_aicore_pipeline_slot(source_chunk)];
        const std::uint64_t wait_start = __asc_aicore::clock();
        if (block_index == 0) {
            while (true) {
                dispatch_aicore_poll_nop();
                std::uint32_t scalar_blocks = 0;
                for (std::uint32_t block = 0;
                     block < producer_blocks; ++block) {
                    dispatch_aicore_poll_nop();
                    auto* block_progress =
                        &pipeline->scalar_progress[block][source_chunk];
                    // ReadGmByPassDCache below is a read-only observation. Do
                    // not DCCI the line first: CACHELINE_OUT could write a
                    // stale Scalar cache line over a newer SIMT publication.
                    const auto observed_generation =
                        transport::aicore::load_published(
                            &block_progress->generation);
                    if (observed_generation == generation)
                        ++scalar_blocks;
                }
                if (scalar_blocks == producer_blocks) {
                    transport::aicore::flush_cacheline(slot);
                    transport::aicore::store_device(
                        &slot->scalar_blocks_completed, producer_blocks);
                    transport::aicore::store_device(
                        reinterpret_cast<__gm__ std::uint32_t*>(
                            &slot->state),
                        static_cast<std::uint32_t>(
                            DispatchPipelineSlotState::kScalarReady));
                    direct_dispatch_pipeline_stage_aicore(
                        pipeline,
                        DispatchPipelineDiagnosticStage::kScalarReady,
                        source_chunk);
                    transport::aicore::system_fence();
                    transport::aicore::flush_cacheline(slot);
                    break;
                }
                if (dispatch_aicore_pipeline_wait_timed_out(
                        wait_start, __asc_aicore::clock(), timeout_cycles)) {
                    direct_dispatch_pipeline_fail_aicore(
                        pipeline, slot, workspace,
                        tiling.workspace_layout.scratch_status_offset,
                        tiling.transport_context.topology.world_rank,
                        0xd3ff0000U | scalar_blocks);
                    return;
                }
            }
        } else {
            while (true) {
                dispatch_aicore_poll_nop();
                transport::aicore::flush_cacheline(slot);
                const auto state = static_cast<DispatchPipelineSlotState>(
                    transport::aicore::load_device(
                        reinterpret_cast<__gm__ std::uint32_t*>(
                            &slot->state)));
                const std::uint32_t published_chunk =
                    transport::aicore::load_device(&slot->published_chunk);
                if (state == DispatchPipelineSlotState::kScalarReady &&
                    published_chunk == source_chunk)
                    break;
                if (state == DispatchPipelineSlotState::kFailed)
                    return;
                if (dispatch_aicore_pipeline_wait_timed_out(
                        wait_start, __asc_aicore::clock(), timeout_cycles)) {
                    direct_dispatch_pipeline_fail_aicore(
                        pipeline, slot, workspace,
                        tiling.workspace_layout.scratch_status_offset,
                        tiling.transport_context.topology.world_rank,
                        source_chunk | (block_index << 16U));
                    return;
                }
            }
        }
        const std::uint64_t chunk_begin =
            static_cast<std::uint64_t>(source_chunk) * source_chunk_tiles;
        const std::uint64_t chunk_end =
            chunk_begin + source_chunk_tiles <
                    tiling.workspace_layout.dispatch_group_tile_count ?
                chunk_begin + source_chunk_tiles :
                tiling.workspace_layout.dispatch_group_tile_count;
        if (tiling.token_layout.hidden_bytes >= kDispatchVectorTileBytes) {
            if (token_fanout != 0) {
                direct_dispatch_producer_token_fanout_impl(
                    x, communication_buffer, workspace, destination_slots,
                    tiling.transport_context.local_window_base,
                    tiling.transport_context.topology.world_rank,
                    tiling.transport_context.topology.world_size,
                    tiling.num_tokens, tiling.num_topk,
                    tiling.num_max_tokens_per_rank,
                    tiling.symmetric_window_layout.dispatch_receive_offset,
                    tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
                    tiling.symmetric_window_layout.dispatch_staging_offset,
                    tiling.symmetric_window_layout.dispatch_staging_shard_bytes,
                    tiling.workspace_layout.scratch_status_offset,
                    tiling.workspace_layout.dispatch_group_owner_offset,
                    tiling.workspace_layout.dispatch_group_tile_count,
                    tiling.launch.num_threads, chunk_begin, chunk_end, 1U,
                    tiling.token_layout.stride_bytes,
                    tiling.token_layout.hidden_offset,
                    tiling.token_layout.hidden_bytes);
            } else {
                direct_dispatch_producer_vector_payload_impl(
                    x, communication_buffer, workspace, destination_slots,
                    tiling.transport_context.local_window_base,
                    tiling.transport_context.topology.world_rank,
                    tiling.transport_context.topology.world_size,
                    tiling.num_tokens, tiling.num_topk,
                    tiling.num_max_tokens_per_rank,
                    tiling.symmetric_window_layout.dispatch_receive_offset,
                    tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
                    tiling.symmetric_window_layout.dispatch_staging_offset,
                    tiling.symmetric_window_layout.dispatch_staging_shard_bytes,
                    tiling.workspace_layout.scratch_status_offset,
                    tiling.workspace_layout.dispatch_group_owner_offset,
                    tiling.workspace_layout.dispatch_group_tile_count,
                    tiling.launch.num_threads, chunk_begin, chunk_end, 1U,
                    tiling.token_layout.stride_bytes,
                    tiling.token_layout.hidden_offset,
                    tiling.token_layout.hidden_bytes);
            }
        }
        asc_sync_data_barrier(mem_dsb_t::DSB_DDR);
        auto* progress = &pipeline->hidden_progress[block_index];
        transport::aicore::store_device(
            &progress->completed_chunk, source_chunk);
        transport::aicore::system_fence();
        transport::aicore::store_device(
            &progress->generation, generation);
        transport::aicore::system_fence();
        transport::aicore::flush_cacheline(progress);
        if (block_index == 0) {
            const std::uint64_t hidden_wait_start = __asc_aicore::clock();
            while (true) {
                dispatch_aicore_poll_nop();
                std::uint32_t hidden_blocks = 0;
                for (std::uint32_t block = 0;
                     block < producer_blocks; ++block) {
                    dispatch_aicore_poll_nop();
                    auto* block_progress = &pipeline->hidden_progress[block];
                    transport::aicore::flush_cacheline(block_progress);
                    if (transport::aicore::load_device(
                            &block_progress->generation) == generation &&
                        transport::aicore::load_device(
                            &block_progress->completed_chunk) == source_chunk)
                        ++hidden_blocks;
                }
                if (hidden_blocks == producer_blocks) {
                    transport::aicore::flush_cacheline(slot);
                    transport::aicore::store_device(
                        &slot->hidden_blocks_completed, producer_blocks);
                    direct_dispatch_pipeline_stage_aicore(
                        pipeline,
                        DispatchPipelineDiagnosticStage::
                            kHiddenProgressObserved,
                        source_chunk);
                    transport::aicore::store_device(
                        reinterpret_cast<__gm__ std::uint32_t*>(
                            &slot->state),
                        static_cast<std::uint32_t>(
                            DispatchPipelineSlotState::kReady));
                    direct_dispatch_pipeline_stage_aicore(
                        pipeline,
                        DispatchPipelineDiagnosticStage::kPayloadReady,
                        source_chunk);
                    transport::aicore::system_fence();
                    transport::aicore::flush_cacheline(slot);
                    break;
                }
                if (dispatch_aicore_pipeline_wait_timed_out(
                        hidden_wait_start, __asc_aicore::clock(),
                        timeout_cycles)) {
                    direct_dispatch_pipeline_fail_aicore(
                        pipeline, slot, workspace,
                        tiling.workspace_layout.scratch_status_offset,
                        tiling.transport_context.topology.world_rank,
                        0xd4ff0000U | hidden_blocks);
                    return;
                }
            }
        }
    }
    asc_sync_vec();
}

__aicore__ inline void direct_dispatch_diagnose_persistent_release_service(
    const transport::DeviceTransportContext& context,
    std::uint64_t generation) {
    auto* queue = transport::service::detail::command_queue(context);
    auto* state = transport::service::detail::service_state(queue);
    if (queue == nullptr || state == nullptr)
        return;
    transport::aicore::flush_cacheline(queue);
    transport::aicore::flush_cacheline(state);
    const auto consumed_generation = state->consumed_generation;
    if (consumed_generation == generation)
        return;
    transport::service::detail::record_error(
        queue, transport::DeviceTransportError::kInvalidProtocol,
        queue->count, transport::TransportCommandOpcode::kNone,
        context.topology.world_rank, 0, 0x70000001U,
        consumed_generation);
}

template <bool ProfileEnabled>
__aicore__ inline void direct_dispatch_persistent_release_device(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    std::uint64_t generation,
    std::uint64_t timeout_cycles,
    std::uint32_t release_chunk_tiles,
    std::uint32_t release_chunk_count,
    std::uint32_t producer_blocks,
    const CoreTiling& tiling) {
    auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
        workspace + tiling.workspace_layout.dispatch_pipeline_offset);

    // A VF call blocks its enclosing AICore until the VF returns.  Keep every
    // request completion in a continuation VF so the AICore service can run
    // between command publication and request observation.
    for (std::uint32_t release_chunk = 0;
         release_chunk < release_chunk_count; ++release_chunk) {
        asc_vf_call<direct_dispatch_persistent_release_wait_vf>(
            dim3(tiling.launch.num_threads), workspace,
            tiling.workspace_layout.dispatch_pipeline_offset, generation,
            release_chunk, producer_blocks);

        const std::uint64_t chunk_begin =
            static_cast<std::uint64_t>(release_chunk) * release_chunk_tiles;
        const std::uint64_t chunk_end =
            chunk_begin + release_chunk_tiles <
                    tiling.workspace_layout.dispatch_group_tile_count ?
                chunk_begin + release_chunk_tiles :
                tiling.workspace_layout.dispatch_group_tile_count;
        direct_dispatch_release_chunk_device<ProfileEnabled>(
            communication_buffer, workspace, generation, timeout_cycles,
            chunk_begin, chunk_end, release_chunk,
            release_chunk + 1U == release_chunk_count ? 1U : 0U, 1U,
            DirectReleaseSegment::kPayload, tiling);
        asc_vf_call<direct_dispatch_pipeline_wait_vf>(
            dim3(tiling.launch.num_threads), workspace,
            tiling.transport_context.abi_version,
            tiling.transport_context.struct_size,
            tiling.transport_context.capabilities,
            tiling.transport_context.local_window_base,
            tiling.transport_context.channel_table,
            tiling.transport_context.peer_address_table,
            tiling.transport_context.topology.abi_version,
            tiling.transport_context.topology.struct_size,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.transport_context.topology.scale_up_rank,
            tiling.transport_context.topology.scale_up_size,
            tiling.transport_context.topology.scale_out_rank,
            tiling.transport_context.topology.scale_out_size,
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.scale_up_direct),
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.kind),
            tiling.transport_context.topology.epoch,
            tiling.transport_context.backend_context,
            tiling.workspace_layout.dispatch_pipeline_offset,
            release_chunk);
        if (static_cast<DispatchPipelineSlotState>(
                transport::aicore::load_device(
                    reinterpret_cast<__gm__ std::uint32_t*>(
                        &pipeline->slots[release_chunk %
                                         kDispatchPipelineSlotCount].state))) ==
            DispatchPipelineSlotState::kFailed)
        {
            transport::aicore::store_device(
                reinterpret_cast<__gm__ std::uint32_t*>(
                    &pipeline->release_worker_state),
                static_cast<std::uint32_t>(
                    DispatchPipelineWorkerState::kFailed));
            transport::aicore::flush_cacheline(
                &pipeline->release_worker_state);
            return;
        }
    }

    const std::uint64_t final_chunk_begin =
        static_cast<std::uint64_t>(release_chunk_count - 1U) *
        release_chunk_tiles;
    const std::uint64_t final_chunk_end =
        tiling.workspace_layout.dispatch_group_tile_count;
    direct_dispatch_release_chunk_device<ProfileEnabled>(
        communication_buffer, workspace, generation, timeout_cycles,
        final_chunk_begin, final_chunk_end, release_chunk_count - 1U, 1U, 1U,
        DirectReleaseSegment::kControl, tiling);
    direct_dispatch_release_chunk_device<ProfileEnabled>(
        communication_buffer, workspace, generation, timeout_cycles,
        final_chunk_begin, final_chunk_end, release_chunk_count - 1U, 1U, 1U,
        DirectReleaseSegment::kBarrier, tiling);
    asc_vf_call<direct_dispatch_persistent_release_complete_vf>(
        dim3(tiling.launch.num_threads), workspace,
        tiling.workspace_layout.dispatch_pipeline_offset, generation);
    asc_sync_vec();
    asc_sync_data_barrier(mem_dsb_t::DSB_DDR);
}

template <bool ProfileEnabled>
__global__ __vector__ void dispatch_kernel(
    __gm__ const std::uint8_t* x,
    __gm__ const std::uint8_t* scale_factors,
    __gm__ const std::int64_t* topk_indices,
    __gm__ const float* topk_weights,
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ std::int32_t* destination_slots,
    __gm__ std::uint8_t* recv_x,
    __gm__ std::uint8_t* recv_scale_factors,
    __gm__ std::int64_t* recv_topk_indices,
    __gm__ float* recv_topk_weights,
    __gm__ std::int32_t* prefix_per_rank,
    __gm__ std::int32_t* prefix_per_expert,
    __gm__ std::int32_t* unaligned_per_expert,
    __gm__ std::int32_t* source_metadata,
    __gm__ HybridRouteRecord* route_records,
    std::uint64_t route_record_capacity,
    std::uint64_t scale_factor_token_stride,
    std::uint64_t scale_factor_pack_stride,
    std::uint64_t recv_scale_factor_token_stride,
    std::uint64_t recv_scale_factor_pack_stride,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t pipeline_chunk_begin,
    std::uint64_t pipeline_chunk_end,
    std::uint32_t pipeline_chunk_index,
    std::uint32_t pipeline_final_chunk,
    std::uint32_t pipeline_source_chunk,
    DirectDispatchStage stage, std::uint32_t copy_outputs,
    std::uint32_t consumer_tile_bytes, std::uint32_t parallel_prefix,
    std::uint32_t token_fanout, std::uint32_t early_route_plan,
    CoreTiling tiling) {
    if constexpr (ProfileEnabled) {
        const auto profile_block = static_cast<std::uint32_t>(
            AscendC::GetBlockIdx());
        transport::service::record_stage_start<true>(
            tiling.transport_context,
            transport::TransportProfileOperation::kDispatch, generation,
            static_cast<std::uint32_t>(stage), profile_block,
            static_cast<std::uint32_t>(AscendC::GetBlockNum()));
    }
    const bool hybrid =
        (tiling.mode_flags &
         (CoreModeFlags{1} <<
          static_cast<std::uint8_t>(CoreMode::kHybrid))) != 0;
    const bool cpu_sync =
        (tiling.mode_flags &
         (CoreModeFlags{1} <<
          static_cast<std::uint8_t>(CoreMode::kCpuSync))) != 0;
    const bool cached =
        (tiling.mode_flags &
         (CoreModeFlags{1} <<
          static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const bool grouping_eligible =
        tiling.num_topk <= kTopkSubgroupWidth &&
        tiling.transport_context.topology.world_size <=
            static_cast<int>(kTopkSubgroupWidth);
    const auto release_segment = direct_dispatch_release_segment(
        stage, ProfileEnabled);
    if (stage == DirectDispatchStage::kFull ||
        stage == DirectDispatchStage::kProducerControl)
        transport::service::reset(tiling.transport_context, generation);
    if (stage == DirectDispatchStage::kProducerRelease &&
        tiling.workspace_layout.dispatch_pipeline_bytes ==
            sizeof(DispatchPipelineState))
        transport::service::reset(tiling.transport_context, generation);
    if (hybrid) {
        asc_vf_call<dispatch_producer_vf>(
        dim3(tiling.launch.num_threads), x, scale_factors, topk_indices,
        topk_weights, communication_buffer, workspace, destination_slots,
        tiling.transport_context.abi_version,
        tiling.transport_context.struct_size,
        tiling.transport_context.capabilities,
        tiling.transport_context.local_window_base,
        tiling.transport_context.channel_table,
        tiling.transport_context.peer_address_table,
        tiling.transport_context.topology.abi_version,
        tiling.transport_context.topology.struct_size,
        tiling.transport_context.topology.world_rank,
        tiling.transport_context.topology.world_size,
        tiling.transport_context.topology.scale_up_rank,
        tiling.transport_context.topology.scale_up_size,
        tiling.transport_context.topology.scale_out_rank,
        tiling.transport_context.topology.scale_out_size,
        static_cast<std::uint32_t>(
            tiling.transport_context.topology.scale_up_direct),
        static_cast<std::uint32_t>(tiling.transport_context.topology.kind),
        tiling.transport_context.topology.epoch,
        tiling.transport_context.backend_context,
        tiling.mode_flags, generation, timeout_cycles,
        tiling.num_tokens, tiling.num_experts, tiling.num_topk,
        tiling.num_max_tokens_per_rank,
        tiling.symmetric_window_layout.dispatch_control_offset,
        tiling.symmetric_window_layout.dispatch_control_bytes,
        tiling.symmetric_window_layout.dispatch_receive_offset,
        tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
        tiling.symmetric_window_layout.dispatch_receive_shard_count,
        tiling.symmetric_window_layout.dispatch_receive_bytes,
        tiling.symmetric_window_layout.dispatch_staging_offset,
        tiling.symmetric_window_layout.dispatch_staging_shard_bytes,
        tiling.symmetric_window_layout.dispatch_staging_shard_count,
        tiling.symmetric_window_layout.dispatch_staging_bytes,
        tiling.symmetric_window_layout.hybrid_dispatch_ingress_control_offset,
        tiling.symmetric_window_layout.hybrid_dispatch_ingress_control_bytes,
        tiling.symmetric_window_layout.hybrid_dispatch_ingress_shard_offset,
        tiling.symmetric_window_layout.hybrid_dispatch_ingress_shard_bytes,
        tiling.symmetric_window_layout.hybrid_dispatch_ingress_shard_count,
        tiling.symmetric_window_layout.hybrid_dispatch_ingress_bytes,
        tiling.symmetric_window_layout.hybrid_dispatch_ingress_staging_offset,
        tiling.symmetric_window_layout
            .hybrid_dispatch_ingress_staging_shard_bytes,
        tiling.symmetric_window_layout
            .hybrid_dispatch_ingress_staging_shard_count,
        tiling.symmetric_window_layout.hybrid_dispatch_ingress_staging_bytes,
        tiling.workspace_layout.scratch_status_offset,
        tiling.workspace_layout.scratch_local_count_offset,
        tiling.workspace_layout.scratch_rank_counts_offset,
        tiling.workspace_layout.scratch_rank_values_offset,
        tiling.workspace_layout.scratch_outbound_ingress_counts_offset,
        tiling.workspace_layout.scratch_outbound_ingress_count,
        tiling.workspace_layout.scratch_rank_indices_offset,
        tiling.workspace_layout.scratch_rank_flags_offset,
        tiling.workspace_layout.scratch_rank_count,
        tiling.token_layout.stride_bytes,
        tiling.token_layout.hidden_offset,
        tiling.token_layout.hidden_bytes,
        tiling.token_layout.scale_factor_offset,
        tiling.token_layout.scale_factor_bytes,
        scale_factor_token_stride,
        scale_factor_pack_stride,
        tiling.token_layout.topk_index_offset,
        tiling.token_layout.topk_weight_offset,
            tiling.token_layout.source_metadata_offset);
    } else if (stage == DirectDispatchStage::kFull ||
               stage == DirectDispatchStage::kProducerControl) {
        asc_vf_call<direct_dispatch_producer_control_vf>(
            dim3(tiling.launch.num_threads), workspace,
            tiling.transport_context.abi_version,
            tiling.transport_context.struct_size,
            tiling.transport_context.capabilities,
            tiling.transport_context.local_window_base,
            tiling.transport_context.channel_table,
            tiling.transport_context.peer_address_table,
            tiling.transport_context.topology.abi_version,
            tiling.transport_context.topology.struct_size,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.transport_context.topology.scale_up_rank,
            tiling.transport_context.topology.scale_up_size,
            tiling.transport_context.topology.scale_out_rank,
            tiling.transport_context.topology.scale_out_size,
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.scale_up_direct),
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.kind),
            tiling.transport_context.topology.epoch,
            tiling.transport_context.backend_context,
            generation, tiling.num_experts,
            tiling.num_max_tokens_per_rank,
            tiling.dispatch_output_capacity,
            tiling.symmetric_window_layout.dispatch_control_bytes,
            tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
            tiling.symmetric_window_layout.dispatch_receive_shard_count,
            tiling.symmetric_window_layout.dispatch_receive_bytes,
            tiling.symmetric_window_layout.dispatch_staging_shard_bytes,
            tiling.symmetric_window_layout.dispatch_staging_shard_count,
            tiling.symmetric_window_layout.dispatch_staging_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.scratch_local_count_offset,
            tiling.workspace_layout.scratch_rank_count,
            tiling.workspace_layout.dispatch_error_offset,
            tiling.workspace_layout.dispatch_error_count,
            tiling.workspace_layout.dispatch_rank_bitmap_bytes,
            tiling.workspace_layout.dispatch_expert_bitmap_bytes,
            tiling.token_layout.stride_bytes);
        if (early_route_plan != 0) {
            asc_vf_call<direct_dispatch_producer_expert_count_init_vf>(
                dim3(tiling.launch.num_threads), workspace,
                tiling.workspace_layout.scratch_status_offset,
                tiling.workspace_layout.dispatch_group_expert_count_offset,
                tiling.workspace_layout.dispatch_group_expert_count);
        }
        if (stage == DirectDispatchStage::kFull || cached ||
            !grouping_eligible) {
            asc_vf_call<direct_dispatch_producer_plan_vf>(
            dim3(tiling.launch.num_threads), topk_indices,
            destination_slots, workspace,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.mode_flags, generation, tiling.num_tokens,
            tiling.num_experts, tiling.num_topk,
            tiling.num_max_tokens_per_rank,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.scratch_rank_counts_offset,
            tiling.workspace_layout.scratch_rank_values_offset,
            tiling.workspace_layout.dispatch_error_offset,
            tiling.workspace_layout.dispatch_rank_bitmap_offset);
            asc_vf_call<direct_dispatch_reduce_errors_vf>(
            dim3(tiling.launch.num_threads), workspace,
            tiling.transport_context.abi_version,
            tiling.transport_context.struct_size,
            tiling.transport_context.capabilities,
            tiling.transport_context.local_window_base,
            tiling.transport_context.channel_table,
            tiling.transport_context.peer_address_table,
            tiling.transport_context.topology.abi_version,
            tiling.transport_context.topology.struct_size,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.transport_context.topology.scale_up_rank,
            tiling.transport_context.topology.scale_up_size,
            tiling.transport_context.topology.scale_out_rank,
            tiling.transport_context.topology.scale_out_size,
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.scale_up_direct),
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.kind),
            tiling.transport_context.topology.epoch,
            tiling.transport_context.backend_context,
            generation, static_cast<std::uint32_t>(
                DispatchProtocolStage::kProducer),
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.dispatch_error_offset,
            0, static_cast<std::uint64_t>(
                tiling.transport_context.topology.world_size));
        }
    }
    if (!hybrid && stage == DirectDispatchStage::kProducerGroup &&
        grouping_eligible) {
        asc_vf_call<direct_dispatch_producer_group_vf>(
            dim3(tiling.launch.num_threads), topk_indices,
            destination_slots, workspace,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.mode_flags, generation, tiling.num_tokens,
            tiling.num_experts, tiling.num_topk,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.dispatch_group_owner_offset,
            tiling.workspace_layout.dispatch_group_tile_offset,
            tiling.workspace_layout.dispatch_group_tile_count,
            early_route_plan != 0 ?
                tiling.workspace_layout
                    .dispatch_group_expert_count_offset : 0,
            early_route_plan != 0 ?
                tiling.workspace_layout.dispatch_group_expert_count : 0,
            tiling.workspace_layout.dispatch_group_error_offset);
    }
    if (!hybrid && stage == DirectDispatchStage::kProducerPrefix &&
        grouping_eligible && !cached) {
        asc_vf_call<direct_dispatch_producer_prefix_vf>(
            dim3(tiling.launch.num_threads), workspace,
            tiling.transport_context.local_window_base,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            generation, tiling.num_max_tokens_per_rank,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.scratch_rank_counts_offset,
            tiling.workspace_layout.scratch_rank_values_offset,
            tiling.workspace_layout.dispatch_error_offset,
            tiling.workspace_layout.dispatch_group_tile_offset,
            tiling.workspace_layout.dispatch_group_tile_count,
            early_route_plan != 0 ?
                tiling.workspace_layout
                    .dispatch_group_expert_count_offset : 0,
            early_route_plan != 0 ?
                tiling.workspace_layout.dispatch_group_expert_count : 0,
            early_route_plan != 0 ?
                tiling.symmetric_window_layout.dispatch_staging_offset : 0,
            tiling.symmetric_window_layout.dispatch_staging_shard_bytes,
            tiling.symmetric_window_layout.dispatch_route_plan_slot_bytes,
            tiling.symmetric_window_layout
                .dispatch_route_plan_expert_capacity,
            tiling.num_experts,
            tiling.workspace_layout.dispatch_group_error_offset);
        asc_vf_call<direct_dispatch_reduce_errors_vf>(
            dim3(tiling.launch.num_threads), workspace,
            tiling.transport_context.abi_version,
            tiling.transport_context.struct_size,
            tiling.transport_context.capabilities,
            tiling.transport_context.local_window_base,
            tiling.transport_context.channel_table,
            tiling.transport_context.peer_address_table,
            tiling.transport_context.topology.abi_version,
            tiling.transport_context.topology.struct_size,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.transport_context.topology.scale_up_rank,
            tiling.transport_context.topology.scale_up_size,
            tiling.transport_context.topology.scale_out_rank,
            tiling.transport_context.topology.scale_out_size,
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.scale_up_direct),
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.kind),
            tiling.transport_context.topology.epoch,
            tiling.transport_context.backend_context,
            generation, static_cast<std::uint32_t>(
                DispatchProtocolStage::kProducer),
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.dispatch_error_offset,
            0, static_cast<std::uint64_t>(
                tiling.transport_context.topology.world_size));
        if (early_route_plan != 0) {
            asc_vf_call<direct_dispatch_publish_route_plan_vf>(
                dim3(tiling.launch.num_threads), workspace,
                tiling.transport_context.abi_version,
                tiling.transport_context.struct_size,
                tiling.transport_context.capabilities,
                tiling.transport_context.local_window_base,
                tiling.transport_context.channel_table,
                tiling.transport_context.peer_address_table,
                tiling.transport_context.topology.abi_version,
                tiling.transport_context.topology.struct_size,
                tiling.transport_context.topology.world_rank,
                tiling.transport_context.topology.world_size,
                tiling.transport_context.topology.scale_up_rank,
                tiling.transport_context.topology.scale_up_size,
                tiling.transport_context.topology.scale_out_rank,
                tiling.transport_context.topology.scale_out_size,
                static_cast<std::uint32_t>(
                    tiling.transport_context.topology.scale_up_direct),
                static_cast<std::uint32_t>(
                    tiling.transport_context.topology.kind),
                tiling.transport_context.topology.epoch,
                tiling.transport_context.backend_context,
                generation, timeout_cycles,
                tiling.symmetric_window_layout.dispatch_route_plan_offset,
                tiling.symmetric_window_layout
                    .dispatch_route_plan_slot_bytes,
                tiling.symmetric_window_layout.dispatch_staging_offset,
                tiling.symmetric_window_layout.dispatch_staging_shard_bytes,
                tiling.workspace_layout.scratch_status_offset);
            transport::service::execute<ProfileEnabled>(
                tiling.transport_context);
            asc_vf_call<direct_dispatch_acquire_route_plan_vf>(
                dim3(tiling.launch.num_threads), workspace,
                prefix_per_rank, prefix_per_expert, unaligned_per_expert,
                tiling.transport_context.abi_version,
                tiling.transport_context.struct_size,
                tiling.transport_context.capabilities,
                tiling.transport_context.local_window_base,
                tiling.transport_context.channel_table,
                tiling.transport_context.peer_address_table,
                tiling.transport_context.topology.abi_version,
                tiling.transport_context.topology.struct_size,
                tiling.transport_context.topology.world_rank,
                tiling.transport_context.topology.world_size,
                tiling.transport_context.topology.scale_up_rank,
                tiling.transport_context.topology.scale_up_size,
                tiling.transport_context.topology.scale_out_rank,
                tiling.transport_context.topology.scale_out_size,
                static_cast<std::uint32_t>(
                    tiling.transport_context.topology.scale_up_direct),
                static_cast<std::uint32_t>(
                    tiling.transport_context.topology.kind),
                tiling.transport_context.topology.epoch,
                tiling.transport_context.backend_context,
                generation, timeout_cycles, tiling.num_experts,
                tiling.expert_alignment,
                tiling.num_max_tokens_per_rank,
                tiling.dispatch_output_capacity,
                tiling.symmetric_window_layout.dispatch_route_plan_offset,
                tiling.symmetric_window_layout
                    .dispatch_route_plan_slot_bytes,
                tiling.symmetric_window_layout
                    .dispatch_route_plan_expert_capacity,
                tiling.workspace_layout.scratch_status_offset,
                tiling.workspace_layout.dispatch_route_source_counts_offset,
                tiling.workspace_layout.scratch_rank_values_offset);
        }
    }
    const bool persistent_record =
        stage == DirectDispatchStage::kProducerRecordPipeline;
    const std::uint32_t source_chunk_tiles = persistent_record ?
        static_cast<std::uint32_t>(pipeline_chunk_end) : 0U;
    const std::uint32_t source_tile_count =
        static_cast<std::uint32_t>(
            tiling.workspace_layout.dispatch_group_tile_count);
    const std::uint32_t source_chunk_count = persistent_record ?
        (source_tile_count + source_chunk_tiles - 1U) /
            source_chunk_tiles :
        1U;
    if (persistent_record) {
        direct_dispatch_persistent_producer_device(
            x, scale_factors, topk_indices, topk_weights,
            communication_buffer, workspace, destination_slots,
            scale_factor_token_stride, scale_factor_pack_stride,
            generation, timeout_cycles, source_chunk_tiles, source_chunk_count,
            token_fanout, tiling);
    }
    if (!persistent_record) {
    for (std::uint32_t source_chunk = 0;
             source_chunk < source_chunk_count; ++source_chunk) {
        const std::uint64_t record_chunk_begin = pipeline_chunk_begin;
        const std::uint64_t record_chunk_end = pipeline_chunk_end;
        const bool record_stage =
            stage == DirectDispatchStage::kProducerRecord;
        if (!hybrid && (stage == DirectDispatchStage::kFull ||
                        record_stage)) {
        const std::uint64_t vector_hidden_bytes =
            token_fanout != 0 ?
                tiling.token_layout.hidden_bytes -
                    tiling.token_layout.hidden_bytes %
                        kDispatchTokenFanoutAlignmentBytes :
                tiling.token_layout.hidden_bytes -
                    tiling.token_layout.hidden_bytes %
                        kDispatchProducerVectorTileBytes;
        asc_vf_call<direct_dispatch_producer_record_vf>(
            dim3(tiling.launch.num_threads), x, scale_factors,
            topk_indices, topk_weights, communication_buffer, workspace,
            destination_slots, tiling.transport_context.local_window_base,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.mode_flags,
            record_stage &&
                    grouping_eligible ? 1U : 0U,
            tiling.num_tokens, tiling.num_experts, tiling.num_topk,
            tiling.num_max_tokens_per_rank,
            tiling.symmetric_window_layout.dispatch_receive_offset,
            tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
            tiling.symmetric_window_layout.dispatch_staging_offset,
            tiling.symmetric_window_layout.dispatch_staging_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.dispatch_group_owner_offset,
            tiling.workspace_layout.dispatch_group_tile_offset,
            tiling.workspace_layout.dispatch_group_tile_count,
            tiling.token_layout.stride_bytes,
            tiling.token_layout.hidden_offset,
            tiling.token_layout.hidden_bytes,
            record_stage &&
                    grouping_eligible ?
                vector_hidden_bytes : 0,
            record_chunk_begin, record_chunk_end,
            pipeline_source_chunk,
            tiling.token_layout.scale_factor_offset,
            tiling.token_layout.scale_factor_bytes,
            scale_factor_token_stride, scale_factor_pack_stride,
            tiling.token_layout.topk_index_offset,
            tiling.token_layout.topk_weight_offset,
            tiling.token_layout.source_metadata_offset);
        if (record_stage &&
            grouping_eligible && tiling.token_layout.hidden_bytes >=
                kDispatchVectorTileBytes) {
            asc_sync_vec();
            asc_sync_data_barrier(mem_dsb_t::DSB_DDR);
            if (token_fanout != 0) {
                direct_dispatch_producer_token_fanout_impl(
                    x, communication_buffer, workspace, destination_slots,
                    tiling.transport_context.local_window_base,
                    tiling.transport_context.topology.world_rank,
                    tiling.transport_context.topology.world_size,
                    tiling.num_tokens, tiling.num_topk,
                    tiling.num_max_tokens_per_rank,
                    tiling.symmetric_window_layout.dispatch_receive_offset,
                    tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
                    tiling.symmetric_window_layout.dispatch_staging_offset,
                    tiling.symmetric_window_layout.dispatch_staging_shard_bytes,
                    tiling.workspace_layout.scratch_status_offset,
                    tiling.workspace_layout.dispatch_group_owner_offset,
                    tiling.workspace_layout.dispatch_group_tile_count,
                    tiling.launch.num_threads,
                    record_chunk_begin, record_chunk_end,
                    pipeline_source_chunk,
                    tiling.token_layout.stride_bytes,
                    tiling.token_layout.hidden_offset,
                    tiling.token_layout.hidden_bytes);
            } else {
                direct_dispatch_producer_vector_payload_impl(
                    x, communication_buffer, workspace, destination_slots,
                    tiling.transport_context.local_window_base,
                    tiling.transport_context.topology.world_rank,
                    tiling.transport_context.topology.world_size,
                    tiling.num_tokens, tiling.num_topk,
                    tiling.num_max_tokens_per_rank,
                    tiling.symmetric_window_layout.dispatch_receive_offset,
                    tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
                    tiling.symmetric_window_layout.dispatch_staging_offset,
                    tiling.symmetric_window_layout.dispatch_staging_shard_bytes,
                    tiling.workspace_layout.scratch_status_offset,
                    tiling.workspace_layout.dispatch_group_owner_offset,
                    tiling.workspace_layout.dispatch_group_tile_count,
                    tiling.launch.num_threads,
                    record_chunk_begin, record_chunk_end,
                    pipeline_source_chunk,
                    tiling.token_layout.stride_bytes,
                    tiling.token_layout.hidden_offset,
                    tiling.token_layout.hidden_bytes);
            }
        }
        }
    }
    }
    if (!hybrid &&
        stage == DirectDispatchStage::kProducerReleasePipeline) {
        const std::uint32_t release_chunk_tiles =
            static_cast<std::uint32_t>(pipeline_chunk_end);
        const std::uint32_t release_tile_count =
            static_cast<std::uint32_t>(
                tiling.workspace_layout.dispatch_group_tile_count);
        const std::uint32_t release_chunk_count =
            (release_tile_count + release_chunk_tiles - 1U) /
                release_chunk_tiles;
        const std::uint32_t producer_blocks =
            tiling.data_launch.num_blocks;
        direct_dispatch_persistent_release_device<ProfileEnabled>(
            communication_buffer, workspace, generation, timeout_cycles,
            release_chunk_tiles, release_chunk_count, producer_blocks,
            tiling);
    }
    if (!hybrid && release_segment != DirectReleaseSegment::kNone) {
        asc_vf_call<direct_dispatch_producer_release_vf>(
            dim3(tiling.launch.num_threads), communication_buffer,
            workspace, tiling.transport_context.abi_version,
            tiling.transport_context.struct_size,
            tiling.transport_context.capabilities,
            tiling.transport_context.local_window_base,
            tiling.transport_context.channel_table,
            tiling.transport_context.peer_address_table,
            tiling.transport_context.topology.abi_version,
            tiling.transport_context.topology.struct_size,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.transport_context.topology.scale_up_rank,
            tiling.transport_context.topology.scale_up_size,
            tiling.transport_context.topology.scale_out_rank,
            tiling.transport_context.topology.scale_out_size,
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.scale_up_direct),
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.kind),
            tiling.transport_context.topology.epoch,
            tiling.transport_context.backend_context,
            generation, timeout_cycles,
            tiling.symmetric_window_layout.dispatch_control_offset,
            tiling.symmetric_window_layout.dispatch_receive_offset,
            tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
            tiling.symmetric_window_layout.dispatch_staging_offset,
            tiling.symmetric_window_layout.dispatch_staging_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.scratch_local_count_offset,
            tiling.workspace_layout.scratch_rank_counts_offset,
            tiling.workspace_layout.dispatch_pipeline_offset,
            tiling.workspace_layout.dispatch_pipeline_bytes,
            tiling.workspace_layout.dispatch_group_tile_offset,
            tiling.workspace_layout.dispatch_group_tile_count,
            pipeline_chunk_begin, pipeline_chunk_end,
            pipeline_chunk_index, pipeline_final_chunk,
            pipeline_source_chunk,
            tiling.token_layout.stride_bytes,
            static_cast<std::uint32_t>(release_segment));
    }
    if (release_segment != DirectReleaseSegment::kNone)
        transport::service::execute<ProfileEnabled>(tiling.transport_context);
    if (stage == DirectDispatchStage::kProducerRelease &&
        tiling.workspace_layout.dispatch_pipeline_bytes ==
            sizeof(DispatchPipelineState)) {
        asc_vf_call<direct_dispatch_pipeline_wait_vf>(
            dim3(tiling.launch.num_threads), workspace,
            tiling.transport_context.abi_version,
            tiling.transport_context.struct_size,
            tiling.transport_context.capabilities,
            tiling.transport_context.local_window_base,
            tiling.transport_context.channel_table,
            tiling.transport_context.peer_address_table,
            tiling.transport_context.topology.abi_version,
            tiling.transport_context.topology.struct_size,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.transport_context.topology.scale_up_rank,
            tiling.transport_context.topology.scale_up_size,
            tiling.transport_context.topology.scale_out_rank,
            tiling.transport_context.topology.scale_out_size,
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.scale_up_direct),
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.kind),
            tiling.transport_context.topology.epoch,
            tiling.transport_context.backend_context,
            tiling.workspace_layout.dispatch_pipeline_offset,
            pipeline_chunk_index);
    }
    if (hybrid) {
        transport::service::reset(tiling.transport_context, generation);
        asc_vf_call<hybrid_dispatch_forward_vf>(
            dim3(tiling.launch.num_threads), workspace,
            tiling.transport_context.abi_version,
            tiling.transport_context.struct_size,
            tiling.transport_context.capabilities,
            tiling.transport_context.local_window_base,
            tiling.transport_context.channel_table,
            tiling.transport_context.peer_address_table,
            tiling.transport_context.topology.abi_version,
            tiling.transport_context.topology.struct_size,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.transport_context.topology.scale_up_rank,
            tiling.transport_context.topology.scale_up_size,
            tiling.transport_context.topology.scale_out_rank,
            tiling.transport_context.topology.scale_out_size,
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.scale_up_direct),
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.kind),
            tiling.transport_context.topology.epoch,
            tiling.transport_context.backend_context,
            generation, timeout_cycles, tiling.num_experts,
            tiling.num_max_tokens_per_rank,
            tiling.symmetric_window_layout
                .hybrid_dispatch_ingress_control_offset,
            tiling.symmetric_window_layout
                .hybrid_dispatch_ingress_shard_offset,
            tiling.symmetric_window_layout
                .hybrid_dispatch_ingress_shard_bytes,
            tiling.symmetric_window_layout
                .hybrid_dispatch_forward_control_offset,
            tiling.symmetric_window_layout
                .hybrid_dispatch_forward_shard_offset,
            tiling.symmetric_window_layout
                .hybrid_dispatch_forward_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.token_layout.stride_bytes,
            tiling.token_layout.topk_index_offset,
            tiling.token_layout.source_metadata_offset);
        transport::service::execute<ProfileEnabled>(tiling.transport_context);
        asc_vf_call<hybrid_dispatch_prepare_epilogue_vf>(
            dim3(tiling.launch.num_threads), workspace,
            tiling.transport_context.abi_version,
            tiling.transport_context.struct_size,
            tiling.transport_context.capabilities,
            tiling.transport_context.local_window_base,
            tiling.transport_context.channel_table,
            tiling.transport_context.peer_address_table,
            tiling.transport_context.topology.abi_version,
            tiling.transport_context.topology.struct_size,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.transport_context.topology.scale_up_rank,
            tiling.transport_context.topology.scale_up_size,
            tiling.transport_context.topology.scale_out_rank,
            tiling.transport_context.topology.scale_out_size,
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.scale_up_direct),
            static_cast<std::uint32_t>(
                tiling.transport_context.topology.kind),
            tiling.transport_context.topology.epoch,
            tiling.transport_context.backend_context,
            generation, timeout_cycles, tiling.num_max_tokens_per_rank,
            tiling.symmetric_window_layout.dispatch_control_offset,
            tiling.symmetric_window_layout.dispatch_receive_offset,
            tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
            tiling.symmetric_window_layout
                .hybrid_dispatch_forward_control_offset,
            tiling.symmetric_window_layout
                .hybrid_dispatch_forward_shard_offset,
            tiling.symmetric_window_layout
                .hybrid_dispatch_forward_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.token_layout.stride_bytes);
    }
    if (hybrid) {
        asc_vf_call<dispatch_epilogue_vf>(
        dim3(tiling.launch.num_threads), communication_buffer, workspace,
        recv_x, recv_scale_factors, recv_topk_indices, recv_topk_weights,
        prefix_per_rank, prefix_per_expert, unaligned_per_expert,
        source_metadata,
        tiling.transport_context.abi_version,
        tiling.transport_context.struct_size,
        tiling.transport_context.capabilities,
        tiling.transport_context.local_window_base,
        tiling.transport_context.channel_table,
        tiling.transport_context.peer_address_table,
        tiling.transport_context.topology.abi_version,
        tiling.transport_context.topology.struct_size,
        tiling.transport_context.topology.world_rank,
        tiling.transport_context.topology.world_size,
        tiling.transport_context.topology.scale_up_rank,
        tiling.transport_context.topology.scale_up_size,
        tiling.transport_context.topology.scale_out_rank,
        tiling.transport_context.topology.scale_out_size,
        static_cast<std::uint32_t>(
            tiling.transport_context.topology.scale_up_direct),
        static_cast<std::uint32_t>(tiling.transport_context.topology.kind),
        tiling.transport_context.topology.epoch,
        tiling.transport_context.backend_context,
        tiling.mode_flags, generation, timeout_cycles, tiling.num_tokens,
        tiling.num_experts, tiling.num_topk, tiling.expert_alignment,
        tiling.num_max_tokens_per_rank, tiling.dispatch_output_capacity,
        tiling.symmetric_window_layout.control_offset,
        tiling.symmetric_window_layout.dispatch_control_offset,
        tiling.symmetric_window_layout.dispatch_control_bytes,
        tiling.symmetric_window_layout.dispatch_receive_offset,
        tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
        tiling.symmetric_window_layout.dispatch_receive_shard_count,
        tiling.symmetric_window_layout.dispatch_receive_bytes,
        tiling.workspace_layout.scratch_status_offset,
        tiling.workspace_layout.scratch_local_count_offset,
        tiling.workspace_layout.scratch_rank_counts_offset,
        tiling.workspace_layout.scratch_rank_count,
        tiling.token_layout.stride_bytes,
        tiling.token_layout.hidden_offset,
        tiling.token_layout.hidden_bytes,
        tiling.token_layout.scale_factor_offset,
        tiling.token_layout.scale_factor_bytes,
        recv_scale_factor_token_stride,
        recv_scale_factor_pack_stride,
        tiling.token_layout.topk_index_offset,
        tiling.token_layout.topk_weight_offset,
        tiling.token_layout.source_metadata_offset,
            cpu_sync ? 0U : 1U);
    } else if (stage == DirectDispatchStage::kFull ||
               (static_cast<std::uint8_t>(stage) >=
                    static_cast<std::uint8_t>(
                        kFirstDirectDispatchEpilogueStage) &&
                static_cast<std::uint8_t>(stage) <=
                    static_cast<std::uint8_t>(
                        kLastDirectDispatchEpilogueStage))) {
        DEEP_EP_ASCEND_DIRECT_DISPATCH_EPILOGUE(
            copy_outputs, stage, early_route_plan, pipeline_source_chunk);
    }
    if (hybrid) {
        asc_vf_call<hybrid_dispatch_record_routes_vf>(
            dim3(tiling.launch.num_threads), workspace, route_records,
            tiling.transport_context.local_window_base,
            tiling.transport_context.backend_context,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.transport_context.topology.scale_up_size,
            tiling.transport_context.topology.epoch,
            generation, tiling.num_experts,
            tiling.num_max_tokens_per_rank, route_record_capacity,
            tiling.symmetric_window_layout.dispatch_control_offset,
            tiling.symmetric_window_layout.dispatch_receive_offset,
            tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
            tiling.workspace_layout.scratch_status_offset,
            tiling.token_layout.stride_bytes,
            tiling.token_layout.topk_index_offset,
            tiling.token_layout.source_metadata_offset);
    }
    if constexpr (ProfileEnabled) {
        const auto profile_block = static_cast<std::uint32_t>(
            AscendC::GetBlockIdx());
        transport::service::record_stage_end<true>(
            tiling.transport_context,
            transport::TransportProfileOperation::kDispatch, generation,
            static_cast<std::uint32_t>(stage), profile_block,
            stage == DirectDispatchStage::kFull ||
                stage == DirectDispatchStage::kEpilogueComplete);
    }
}

__global__ __vector__ void dispatch_copy_kernel(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ std::uint8_t* recv_x,
    __gm__ std::uint8_t* recv_scale_factors,
    __gm__ std::int64_t* recv_topk_indices,
    __gm__ float* recv_topk_weights,
    __gm__ std::int32_t* prefix_per_rank,
    __gm__ std::int32_t* prefix_per_expert,
    __gm__ std::int32_t* unaligned_per_expert,
    __gm__ std::int32_t* source_metadata,
    std::uint64_t recv_scale_factor_token_stride,
    std::uint64_t recv_scale_factor_pack_stride,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint32_t consumer_tile_bytes, std::uint32_t parallel_prefix,
    CoreTiling tiling) {
    const bool hybrid = (tiling.mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kHybrid))) != 0;
    if (hybrid) {
        asc_vf_call<dispatch_epilogue_vf>(
        dim3(tiling.launch.num_threads), communication_buffer, workspace,
        recv_x, recv_scale_factors, recv_topk_indices, recv_topk_weights,
        prefix_per_rank, prefix_per_expert, unaligned_per_expert,
        source_metadata,
        tiling.transport_context.abi_version,
        tiling.transport_context.struct_size,
        tiling.transport_context.capabilities,
        tiling.transport_context.local_window_base,
        tiling.transport_context.channel_table,
        tiling.transport_context.peer_address_table,
        tiling.transport_context.topology.abi_version,
        tiling.transport_context.topology.struct_size,
        tiling.transport_context.topology.world_rank,
        tiling.transport_context.topology.world_size,
        tiling.transport_context.topology.scale_up_rank,
        tiling.transport_context.topology.scale_up_size,
        tiling.transport_context.topology.scale_out_rank,
        tiling.transport_context.topology.scale_out_size,
        static_cast<std::uint32_t>(
            tiling.transport_context.topology.scale_up_direct),
        static_cast<std::uint32_t>(tiling.transport_context.topology.kind),
        tiling.transport_context.topology.epoch,
        tiling.transport_context.backend_context,
        tiling.mode_flags, generation, timeout_cycles, tiling.num_tokens,
        tiling.num_experts, tiling.num_topk, tiling.expert_alignment,
        tiling.num_max_tokens_per_rank, tiling.dispatch_output_capacity,
        tiling.symmetric_window_layout.control_offset,
        tiling.symmetric_window_layout.dispatch_control_offset,
        tiling.symmetric_window_layout.dispatch_control_bytes,
        tiling.symmetric_window_layout.dispatch_receive_offset,
        tiling.symmetric_window_layout.dispatch_receive_shard_bytes,
        tiling.symmetric_window_layout.dispatch_receive_shard_count,
        tiling.symmetric_window_layout.dispatch_receive_bytes,
        tiling.workspace_layout.scratch_status_offset,
        tiling.workspace_layout.scratch_local_count_offset,
        tiling.workspace_layout.scratch_rank_counts_offset,
        tiling.workspace_layout.scratch_rank_count,
        tiling.token_layout.stride_bytes,
        tiling.token_layout.hidden_offset,
        tiling.token_layout.hidden_bytes,
        tiling.token_layout.scale_factor_offset,
        tiling.token_layout.scale_factor_bytes,
        recv_scale_factor_token_stride,
        recv_scale_factor_pack_stride,
        tiling.token_layout.topk_index_offset,
        tiling.token_layout.topk_weight_offset,
        tiling.token_layout.source_metadata_offset,
            1U);
    } else {
        DEEP_EP_ASCEND_DIRECT_DISPATCH_EPILOGUE(
            1U, DirectDispatchStage::kFull, 0U, 0U);
    }
}

template <bool ProfileEnabled>
inline int launch_dispatch_kernel(
    DispatchArguments arguments, CoreTiling tiling, void* stream,
    CoreLaunchShape launch, DirectDispatchStage stage,
    std::uint32_t copy_outputs) {
    dispatch_kernel<ProfileEnabled><<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        static_cast<const std::uint8_t*>(arguments.x),
        static_cast<const std::uint8_t*>(arguments.scale_factors),
        arguments.topk_indices, arguments.topk_weights,
        static_cast<std::uint8_t*>(arguments.communication_buffer),
        static_cast<std::uint8_t*>(arguments.workspace),
        arguments.destination_slots,
        static_cast<std::uint8_t*>(arguments.recv_x),
        static_cast<std::uint8_t*>(arguments.recv_scale_factors),
        arguments.recv_topk_indices, arguments.recv_topk_weights,
        arguments.prefix_per_rank, arguments.prefix_per_expert,
        arguments.unaligned_per_expert, arguments.source_metadata,
        arguments.route_records, arguments.route_record_capacity,
        arguments.scale_factor_token_stride,
        arguments.scale_factor_pack_stride,
        arguments.recv_scale_factor_token_stride,
        arguments.recv_scale_factor_pack_stride,
        arguments.generation, arguments.timeout_cycles,
        arguments.pipeline_chunk_begin, arguments.pipeline_chunk_end,
        arguments.pipeline_chunk_index, arguments.pipeline_final_chunk,
        arguments.pipeline_source_chunk,
        stage, copy_outputs, arguments.consumer_tile_bytes,
        arguments.parallel_prefix, arguments.token_fanout,
        arguments.early_route_plan, tiling);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

inline int launch_dispatch_kernel(
    DispatchArguments arguments, CoreTiling tiling, void* stream,
    CoreLaunchShape launch, DirectDispatchStage stage,
    std::uint32_t copy_outputs) {
    if (arguments.pipeline_chunk_end == 0) {
        arguments.pipeline_chunk_begin = 0;
        arguments.pipeline_chunk_end = tiling.num_max_tokens_per_rank;
        arguments.pipeline_chunk_index = 0;
        arguments.pipeline_final_chunk = 1;
        arguments.pipeline_source_chunk = 0;
    }
    const std::uint64_t chunk_limit = arguments.pipeline_source_chunk != 0 ?
        tiling.workspace_layout.dispatch_group_tile_count :
        tiling.num_max_tokens_per_rank;
    if (arguments.pipeline_chunk_begin >= arguments.pipeline_chunk_end ||
        arguments.pipeline_chunk_end > chunk_limit)
        return -1;
    const bool profile_enabled = deep_ep::ascend::transport::has_capability(
        tiling.transport_context.capabilities,
        deep_ep::ascend::transport::TransportCapability::kStageProfile);
    return profile_enabled ?
        launch_dispatch_kernel<true>(
            arguments, tiling, stream, launch, stage, copy_outputs) :
        launch_dispatch_kernel<false>(
            arguments, tiling, stream, launch, stage, copy_outputs);
}

inline int launch_direct_dispatch_stage(
    DispatchArguments arguments, CoreTiling tiling, void* stream,
    DirectDispatchStage stage, std::uint32_t copy_outputs) {
    const auto launch = direct_dispatch_stage_launch(tiling, stage);
    return launch_dispatch_kernel(
        arguments, tiling, stream, launch, stage, copy_outputs);
}

inline int launch_persistent_dispatch_source_pipeline(
    DispatchArguments arguments, CoreTiling tiling,
    void* producer_stream, void* communication_stream,
    const DispatchSourceChunkPlan& source_plan) {
    if (tiling.data_launch.num_blocks <= 1 ||
        source_plan.chunk_count < 2 || source_plan.chunk_tiles == 0)
        return -1;
    arguments.pipeline_chunk_begin = 0;
    arguments.pipeline_chunk_end = source_plan.chunk_tiles;
    arguments.pipeline_chunk_index = 0;
    arguments.pipeline_final_chunk = 1;
    arguments.pipeline_source_chunk = 1;

    int status = 0;
    for (const auto stage : {
             DirectDispatchStage::kProducerControl,
             DirectDispatchStage::kProducerGroup,
             DirectDispatchStage::kProducerPrefix}) {
        status = launch_direct_dispatch_stage(
            arguments, tiling, producer_stream, stage, 0U);
        if (status != 0)
            return status;
    }

    const std::uint32_t producer_blocks =
        dispatch_persistent_producer_blocks(
            tiling.data_launch.num_blocks);
    CoreTiling pipeline_tiling = tiling;
    pipeline_tiling.data_launch.num_blocks = producer_blocks;

    status = launch_direct_dispatch_stage(
        arguments, pipeline_tiling, communication_stream,
        DirectDispatchStage::kProducerReleasePipeline, 0U);
    if (status != 0)
        return status;

    CoreLaunchShape producer_launch = pipeline_tiling.data_launch;
    producer_launch.num_blocks = producer_blocks;
    status = launch_dispatch_kernel(
        arguments, pipeline_tiling, producer_stream, producer_launch,
        DirectDispatchStage::kProducerRecordPipeline, 0U);
    if (status != 0)
        return status;
    const bool profile_enabled =
        deep_ep::ascend::transport::has_capability(
            tiling.transport_context.capabilities,
            deep_ep::ascend::transport::
                TransportCapability::kStageProfile);
    const auto pipeline = profile_enabled ?
        direct_dispatch_profile_pipeline(false) :
        direct_dispatch_pipeline(false);
    const std::uint32_t epilogue_begin = profile_enabled ? 6U : 5U;
    for (std::uint32_t index = epilogue_begin;
         index < pipeline.count; ++index) {
        status = launch_direct_dispatch_stage(
            arguments, tiling, producer_stream,
            pipeline.stages[index], 1U);
        if (status != 0)
            return status;
    }
    return 0;
}

#undef DEEP_EP_ASCEND_DIRECT_DISPATCH_EPILOGUE

}  // namespace deep_ep::ascend::elastic

extern "C" int deep_ep_ascend_launch_dispatch(
    deep_ep::ascend::elastic::DispatchArguments arguments,
    deep_ep::ascend::elastic::CoreTiling tiling, void* stream) {
    using namespace deep_ep::ascend::elastic;
    const bool hybrid = has_mode(tiling.mode_flags, CoreMode::kHybrid);
    const bool cpu_sync = has_mode(tiling.mode_flags, CoreMode::kCpuSync);
    if (hybrid || tiling.data_launch.num_blocks == 1) {
        return launch_dispatch_kernel(
            arguments, tiling, stream, tiling.launch,
            DirectDispatchStage::kFull, cpu_sync ? 0U : 1U);
    }
    const bool profile_enabled = deep_ep::ascend::transport::has_capability(
        tiling.transport_context.capabilities,
        deep_ep::ascend::transport::TransportCapability::kStageProfile);
    const auto pipeline = profile_enabled ?
        direct_dispatch_profile_pipeline(cpu_sync) :
        direct_dispatch_pipeline(cpu_sync);
    for (std::uint32_t index = 0; index < pipeline.count; ++index) {
        const auto status = launch_direct_dispatch_stage(
            arguments, tiling, stream, pipeline.stages[index],
            cpu_sync ? 0U : 1U);
        if (status != 0)
            return status;
    }
    return 0;
}

extern "C" int deep_ep_ascend_launch_dispatch_pipeline(
    deep_ep::ascend::elastic::DispatchArguments arguments,
    deep_ep::ascend::elastic::CoreTiling tiling, void* producer_stream,
    void* communication_stream) {
    using namespace deep_ep::ascend::elastic;
    const bool source_pipeline = arguments.pipeline_chunk_tiles != 0;
    const bool slot_pipeline = arguments.pipeline_chunk_slots != 0;
    const bool cpu_sync = has_mode(tiling.mode_flags, CoreMode::kCpuSync);
    if (producer_stream == nullptr || communication_stream == nullptr ||
        producer_stream == communication_stream ||
        source_pipeline == slot_pipeline ||
        !has_mode(tiling.mode_flags, CoreMode::kPipeline) ||
        has_mode(tiling.mode_flags, CoreMode::kCached) ||
        has_mode(tiling.mode_flags, CoreMode::kHybrid) ||
        has_mode(tiling.mode_flags, CoreMode::kAsyncEvent) ||
        (source_pipeline &&
         (cpu_sync || has_mode(tiling.mode_flags, CoreMode::kExpanded) ||
          tiling.element_kind != ElementKind::kFloat8E4M3)) ||
        (slot_pipeline && !cpu_sync))
        return -1;

    DispatchChunkPlan slot_plan{};
    DispatchSourceChunkPlan source_plan{};
    const bool valid_plan = source_pipeline ?
        build_dispatch_source_chunk_plan(
            tiling.num_tokens, kDispatchGroupingTokensPerTile,
            arguments.pipeline_chunk_tiles, &source_plan) :
        build_dispatch_chunk_plan(
            tiling.num_max_tokens_per_rank,
            arguments.pipeline_chunk_slots, &slot_plan);
    const std::uint32_t chunk_count = source_pipeline ?
        source_plan.chunk_count : slot_plan.chunk_count;
    if (!valid_plan || chunk_count < 2 ||
        chunk_count > kMaximumDispatchPipelineChunks)
        return -1;
    arguments.pipeline_source_chunk = source_pipeline ? 1U : 0U;
    if (source_pipeline)
        return launch_persistent_dispatch_source_pipeline(
            arguments, tiling, producer_stream, communication_stream,
            source_plan);

    aclrtEvent ready[kMaximumDispatchPipelineChunks]{};
    aclrtEvent done[kMaximumDispatchPipelineChunks]{};
    std::uint32_t created_ready = 0;
    std::uint32_t created_done = 0;
    int status = 0;
    for (std::uint32_t chunk = 0; chunk < chunk_count; ++chunk) {
        status = aclrtCreateEventWithFlag(&ready[chunk], ACL_EVENT_SYNC);
        if (status != 0)
            break;
        ++created_ready;
        status = aclrtCreateEventWithFlag(&done[chunk], ACL_EVENT_SYNC);
        if (status != 0)
            break;
        ++created_done;
    }

    if (status == 0) {
        for (const auto stage : {
                 DirectDispatchStage::kProducerControl,
                 DirectDispatchStage::kProducerGroup,
                 DirectDispatchStage::kProducerPrefix}) {
            status = launch_direct_dispatch_stage(
                arguments, tiling, producer_stream, stage, 0U);
            if (status != 0)
                break;
        }
    }

    for (std::uint32_t chunk = 0;
         status == 0 && chunk < chunk_count; ++chunk) {
        if (chunk >= kDispatchPipelineSlotCount) {
            status = aclrtStreamWaitEvent(
                static_cast<aclrtStream>(producer_stream),
                done[chunk - kDispatchPipelineSlotCount]);
            if (status != 0)
                break;
        }
        if (source_pipeline) {
            std::uint32_t tile_begin = 0;
            std::uint32_t tile_end = 0;
            std::uint32_t token_begin = 0;
            std::uint32_t token_end = 0;
            if (!dispatch_source_chunk_bounds(
                    source_plan, chunk, &tile_begin, &tile_end,
                    &token_begin, &token_end)) {
                status = -1;
                break;
            }
            (void)token_begin;
            (void)token_end;
            arguments.pipeline_chunk_begin = tile_begin;
            arguments.pipeline_chunk_end = tile_end;
        } else {
            arguments.pipeline_chunk_begin =
                static_cast<std::uint64_t>(chunk) * slot_plan.chunk_slots;
            const auto remaining = slot_plan.shard_capacity -
                arguments.pipeline_chunk_begin;
            arguments.pipeline_chunk_end = arguments.pipeline_chunk_begin +
                (remaining < slot_plan.chunk_slots ?
                     remaining : slot_plan.chunk_slots);
        }
        arguments.pipeline_chunk_index = chunk;
        arguments.pipeline_final_chunk =
            chunk + 1 == chunk_count ? 1U : 0U;

        status = launch_direct_dispatch_stage(
            arguments, tiling, producer_stream,
            DirectDispatchStage::kProducerRecord, 0U);
        if (status != 0)
            break;
        status = aclrtRecordEvent(
            ready[chunk], static_cast<aclrtStream>(producer_stream));
        if (status != 0)
            break;
        status = aclrtStreamWaitEvent(
            static_cast<aclrtStream>(communication_stream),
            ready[chunk]);
        if (status != 0)
            break;
        status = launch_direct_dispatch_stage(
            arguments, tiling, communication_stream,
            DirectDispatchStage::kProducerRelease, 0U);
        if (status != 0)
            break;
        const bool profile_enabled =
            deep_ep::ascend::transport::has_capability(
                tiling.transport_context.capabilities,
                deep_ep::ascend::transport::
                    TransportCapability::kStageProfile);
        if (status == 0 && profile_enabled &&
            chunk + 1 == chunk_count) {
            for (const auto stage : {
                     DirectDispatchStage::kProducerReleaseControl,
                     DirectDispatchStage::kProducerReleaseBarrier}) {
                status = launch_direct_dispatch_stage(
                    arguments, tiling, communication_stream, stage, 0U);
                if (status != 0)
                    break;
            }
        }
        if (status == 0)
            status = aclrtRecordEvent(
                done[chunk],
                static_cast<aclrtStream>(communication_stream));
    }

    if (status == 0)
        status = aclrtStreamWaitEvent(
            static_cast<aclrtStream>(producer_stream),
            done[chunk_count - 1]);
    if (status == 0) {
        const bool profile_enabled =
            deep_ep::ascend::transport::has_capability(
                tiling.transport_context.capabilities,
                deep_ep::ascend::transport::
                    TransportCapability::kStageProfile);
        const auto pipeline = profile_enabled ?
            direct_dispatch_profile_pipeline(cpu_sync) :
            direct_dispatch_pipeline(cpu_sync);
        const std::uint32_t epilogue_begin = profile_enabled ? 6U : 5U;
        for (std::uint32_t index = epilogue_begin;
             status == 0 && index < pipeline.count; ++index)
            status = launch_direct_dispatch_stage(
                arguments, tiling, producer_stream,
                pipeline.stages[index], cpu_sync ? 0U : 1U);
    }

    const int producer_sync = aclrtSynchronizeStream(
        static_cast<aclrtStream>(producer_stream));
    const int communication_sync = aclrtSynchronizeStream(
        static_cast<aclrtStream>(communication_stream));
    if (status == 0)
        status = producer_sync != 0 ? producer_sync : communication_sync;
    for (std::uint32_t index = 0; index < created_ready; ++index) {
        const int destroy_status = aclrtDestroyEvent(ready[index]);
        if (status == 0)
            status = destroy_status;
    }
    for (std::uint32_t index = 0; index < created_done; ++index) {
        const int destroy_status = aclrtDestroyEvent(done[index]);
        if (status == 0)
            status = destroy_status;
    }

    return status;
}

extern "C" int deep_ep_ascend_launch_dispatch_epilogue(
    deep_ep::ascend::elastic::DispatchArguments arguments,
    deep_ep::ascend::elastic::CoreTiling tiling, void* stream) {
    using namespace deep_ep::ascend::elastic;
    if (has_mode(tiling.mode_flags, CoreMode::kHybrid) ||
        tiling.data_launch.num_blocks == 1) {
        dispatch_copy_kernel<<<
            tiling.launch.num_blocks, 0,
            static_cast<aclrtStream>(stream)>>>(
        static_cast<std::uint8_t*>(arguments.communication_buffer),
        static_cast<std::uint8_t*>(arguments.workspace),
        static_cast<std::uint8_t*>(arguments.recv_x),
        static_cast<std::uint8_t*>(arguments.recv_scale_factors),
        arguments.recv_topk_indices, arguments.recv_topk_weights,
        arguments.prefix_per_rank, arguments.prefix_per_expert,
        arguments.unaligned_per_expert, arguments.source_metadata,
        arguments.recv_scale_factor_token_stride,
        arguments.recv_scale_factor_pack_stride,
        arguments.generation, arguments.timeout_cycles,
        arguments.consumer_tile_bytes, arguments.parallel_prefix, tiling);
        return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    }
    const auto pipeline = direct_dispatch_epilogue_pipeline();
    for (std::uint32_t index = 0; index < pipeline.count; ++index) {
        const auto status = launch_direct_dispatch_stage(
            arguments, tiling, stream, pipeline.stages[index], 1U);
        if (status != 0)
            return status;
    }
    return 0;
}
