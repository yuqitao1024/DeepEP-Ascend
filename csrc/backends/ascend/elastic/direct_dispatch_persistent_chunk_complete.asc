#include "../transport/device_transport_facade.hpp"

namespace deep_ep::ascend::elastic {

#include "dispatch_device_common.hpp"

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_persistent_chunk_complete_vf(
    __gm__ std::uint8_t* workspace,
    std::uint64_t dispatch_pipeline_offset,
    std::uint32_t source_chunk) {
    if (threadIdx.x != 0)
        return;
    auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
        workspace + dispatch_pipeline_offset);
    auto* slot = &pipeline->slots[dispatch_simt_pipeline_slot(source_chunk)];
    const std::uint32_t producer_blocks = gridDim.x;
    transport::simt::system_fence();
    const std::uint32_t completed_blocks = asc_atomic_add(
        &slot->scalar_blocks_completed, 1U);
    if (dispatch_simt_pipeline_completion_is_last(
            completed_blocks, producer_blocks)) {
        transport::simt::system_fence();
        transport::simt::store_published(
            reinterpret_cast<__gm__ std::uint32_t*>(&slot->state),
            static_cast<std::uint32_t>(DispatchPipelineSlotState::kReady));
    }
    while (true) {
        dispatch_simt_poll_nop();
        const std::uint32_t published_chunk =
            transport::simt::load_observed(&slot->published_chunk);
        const auto state = static_cast<DispatchPipelineSlotState>(
            transport::simt::load_observed(
                reinterpret_cast<__gm__ std::uint32_t*>(&slot->state)));
        if (published_chunk == source_chunk &&
            state != DispatchPipelineSlotState::kProducing)
            return;
    }
}

struct DirectDispatchPersistentChunkCompleteKernelArguments {
    __gm__ std::uint8_t* workspace;
    std::uint64_t dispatch_pipeline_offset;
    std::uint32_t source_chunk;
    std::uint32_t vf_num_threads;
};

__global__ __vector__ void direct_dispatch_persistent_chunk_complete_kernel(
    DirectDispatchPersistentChunkCompleteKernelArguments arguments) {
    asc_vf_call<direct_dispatch_persistent_chunk_complete_vf> (
        dim3(arguments.vf_num_threads), arguments.workspace, arguments.dispatch_pipeline_offset, arguments.source_chunk);
}

extern "C" int deep_ep_ascend_launch_direct_dispatch_persistent_chunk_complete(
    std::uint8_t* workspace,
    std::uint64_t dispatch_pipeline_offset,
    std::uint32_t source_chunk,
    void* stream, CoreLaunchShape launch,
    std::uint32_t vf_num_threads) {
    const DirectDispatchPersistentChunkCompleteKernelArguments arguments{
        workspace,
        dispatch_pipeline_offset,
        source_chunk,
        vf_num_threads};
    direct_dispatch_persistent_chunk_complete_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(arguments);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
