namespace deep_ep::ascend::elastic {

#include "dispatch_device_common.hpp"

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_producer_expert_count_init_vf(
    __gm__ std::uint8_t* workspace,
    std::uint64_t workspace_status_offset,
    std::uint64_t dispatch_group_expert_count_offset,
    std::uint64_t dispatch_group_expert_count) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::simt::load_observed(status) != 0 ||
        dispatch_group_expert_count_offset == 0)
        return;
    auto* expert_counts = reinterpret_cast<__gm__ std::uint32_t*>(
        workspace + dispatch_group_expert_count_offset);
    const std::uint32_t count = static_cast<std::uint32_t>(
        dispatch_group_expert_count);
    for (std::uint32_t index = threadIdx.x; index < count;
         index += blockDim.x)
        expert_counts[index] = 0;
}

struct DirectDispatchProducerExpertCountInitKernelArguments {
    __gm__ std::uint8_t* workspace;
    std::uint64_t workspace_status_offset;
    std::uint64_t dispatch_group_expert_count_offset;
    std::uint64_t dispatch_group_expert_count;
    std::uint32_t vf_num_threads;
};

__global__ __vector__ void direct_dispatch_producer_expert_count_init_kernel(
    DirectDispatchProducerExpertCountInitKernelArguments arguments) {
    asc_vf_call<direct_dispatch_producer_expert_count_init_vf> (
        dim3(arguments.vf_num_threads), arguments.workspace, arguments.workspace_status_offset, arguments.dispatch_group_expert_count_offset, arguments.dispatch_group_expert_count);
}

extern "C" int deep_ep_ascend_launch_direct_dispatch_producer_expert_count_init(
    std::uint8_t* workspace,
    std::uint64_t workspace_status_offset,
    std::uint64_t dispatch_group_expert_count_offset,
    std::uint64_t dispatch_group_expert_count,
    void* stream, CoreLaunchShape launch,
    std::uint32_t vf_num_threads) {
    const DirectDispatchProducerExpertCountInitKernelArguments arguments{
        workspace,
        workspace_status_offset,
        dispatch_group_expert_count_offset,
        dispatch_group_expert_count,
        vf_num_threads};
    direct_dispatch_producer_expert_count_init_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(arguments);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
