__simt_vf__ __launch_bounds__(512) inline void direct_combine_producer_record_vf(
    __gm__ const bfloat16_t* x,
    __gm__ const float* topk_weights,
    __gm__ const std::int32_t* source_metadata,
    __gm__ std::uint8_t* workspace,
    std::uintptr_t local_window_base,
    CoreModeFlags mode_flags, std::uint64_t num_source_rows,
    std::uint64_t num_input_rows, std::uint64_t num_topk,
    std::uint64_t shard_capacity, std::uint64_t combine_record_bytes,
    std::uint64_t combine_weight_offset,
    std::uint64_t combine_receive_offset,
    std::uint64_t combine_receive_shard_bytes,
    std::uint64_t combine_staging_offset,
    std::uint64_t combine_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t workspace_slot_offset,
    std::uint64_t combine_producer_tile_rank_count_offset,
    std::uint64_t combine_producer_tile_count,
    int world_rank, int world_size, std::uint64_t hidden_elements,
    std::uint32_t expanded_vector_reduce,
    std::uint32_t direct_local_placement) {
    if (!combine_direct_status_is_clean(
            workspace, workspace_status_offset))
        return;
    const std::uint32_t num_source_rows_u32 =
        static_cast<std::uint32_t>(num_source_rows);
    const std::uint32_t num_input_rows_u32 =
        static_cast<std::uint32_t>(num_input_rows);
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t hidden_elements_u32 =
        static_cast<std::uint32_t>(hidden_elements);
    const std::uint32_t tile_count_u32 =
        static_cast<std::uint32_t>(combine_producer_tile_count);
    const bool expanded = (mode_flags & (CoreModeFlags{1} <<
        static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    const auto payload_plan = simt_combine_producer_payload_copy_plan(
        hidden_elements_u32, kCombineProducerVectorTileElements,
        kCombineDataCopyAlignmentElements, expanded);
    const auto expanded_payload_plan =
        simt_combine_expanded_producer_payload_plan(
            hidden_elements_u32, kCombineProducerVectorTileElements,
            kCombineDataCopyAlignmentElements,
            expanded && expanded_vector_reduce != 0);
    const auto trailer = combine_record_trailer_layout(
        combine_record_bytes, false);
    const auto* begins = reinterpret_cast<__gm__ const std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    const auto* slots = reinterpret_cast<__gm__ const std::int32_t*>(
        workspace + workspace_slot_offset);
    const auto* tile_prefixes = reinterpret_cast<
        __gm__ const std::uint64_t*>(
            workspace + combine_producer_tile_rank_count_offset);
    const std::uint64_t metadata_stride = 2 + num_topk_u32;
    const auto grid = direct_data_grid_stride(
        blockIdx.x, threadIdx.x, gridDim.x, blockDim.x);
    for (std::uint32_t row = grid.first; row < num_source_rows_u32;
         row += grid.stride) {
        const std::int32_t local_occurrence = slots[row];
        if (local_occurrence < 0)
            continue;
        int destination_rank = world_size - 1;
        for (int rank = 1; rank < world_size; ++rank) {
            if (row < begins[rank]) {
                destination_rank = rank - 1;
                break;
            }
        }
        const std::uint32_t tile = row /
            static_cast<std::uint32_t>(kCombineRecordsPerTile);
        if (tile >= tile_count_u32)
            continue;
        const std::uint64_t tile_prefix = tile_prefixes[
            tile * static_cast<std::uint64_t>(world_size) +
            static_cast<std::uint64_t>(destination_rank)];
        std::uint64_t output_slot = 0;
        if (!combine_simt_record_destination_slot(
                tile_prefix,
                static_cast<std::uint64_t>(local_occurrence),
                combine_staging_shard_bytes / combine_record_bytes,
                &output_slot))
            continue;
        const bool direct_local = direct_local_placement != 0 &&
            destination_rank == world_rank;
        const std::uint64_t record_region_offset = direct_local ?
            combine_receive_offset : combine_staging_offset;
        const std::uint64_t record_region_shard_bytes = direct_local ?
            combine_receive_shard_bytes : combine_staging_shard_bytes;
        auto* record = reinterpret_cast<__gm__ std::uint8_t*>(
            local_window_base + record_region_offset +
            static_cast<std::uint64_t>(destination_rank) *
                record_region_shard_bytes) + output_slot * combine_record_bytes;
        const auto* metadata = source_metadata + row * metadata_stride;
        const std::int32_t master_lane = decode_dispatch_local_index(
            metadata[1], num_topk);
        auto* record_hidden = reinterpret_cast<__gm__ bfloat16_t*>(record);
        auto* record_weights = reinterpret_cast<__gm__ float*>(
            record + combine_weight_offset);
        if (expanded) {
            for (std::uint32_t lane = 0; lane < num_topk_u32; ++lane)
                record_weights[lane] = 0.0F;
        }
        for (std::uint32_t hidden = static_cast<std::uint32_t>(
                 expanded ? expanded_payload_plan.scalar_begin :
                            payload_plan.scalar_begin);
             hidden < hidden_elements_u32; ++hidden) {
            const float value = expanded ? combine_reduce_expanded_lanes(
                x, metadata + 2, num_topk_u32, num_input_rows_u32,
                hidden_elements, hidden) :
                static_cast<float>(x[row * hidden_elements + hidden]);
            record_hidden[hidden] = static_cast<bfloat16_t>(value);
        }
        if (!expanded) {
            combine_fill_normal_record_routing_weights(
                topk_weights, row, master_lane, num_topk,
                record, combine_weight_offset);
        } else {
            for (std::uint32_t lane = 0; lane < num_topk_u32; ++lane) {
                const std::int32_t input_row = metadata[2 + lane];
                if (input_row != -1)
                    record_weights[lane] = topk_weights == nullptr ? 0.0F :
                        combine_routing_weight(
                            topk_weights,
                            static_cast<std::uint64_t>(input_row));
            }
        }
        auto* header = reinterpret_cast<__gm__ CombineRecordHeader*>(
            record + trailer.header_offset);
        header->abi_version = kCombineRecordAbiVersion;
        header->struct_size = sizeof(CombineRecordHeader);
        header->origin_token = decode_dispatch_local_index(
            metadata[0], shard_capacity);
        header->contributor_rank = world_rank;
        header->master_lane = master_lane;
        header->contribution_lane = master_lane;
    }
}

__global__ __vector__ void direct_combine_producer_record_kernel(
    __gm__ const std::uint16_t* x,
    __gm__ const float* topk_weights,
    __gm__ const std::int32_t* source_metadata,
    __gm__ const HybridRouteRecord* route_records,
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ const std::int32_t* prefix_per_rank,
    __gm__ std::uint8_t* workspace,
    __gm__ std::uint16_t* combined_x,
    __gm__ float* combined_topk_weights,
    __gm__ const std::uint16_t* bias_0,
    __gm__ const std::uint16_t* bias_1,
    CombineVfScalars scalars) {
    const auto route_record_count = scalars.route_record_count;
    const auto generation = scalars.generation;
    const auto timeout_cycles = scalars.timeout_cycles;
    const auto num_source_rows = scalars.num_source_rows;
    const auto num_input_rows = scalars.num_input_rows;
    const auto local_window_base = scalars.local_window_base;
    const auto expanded_vector_reduce = scalars.expanded_vector_reduce;
    const auto local_copy_datacopy = scalars.local_copy_datacopy;
    const auto direct_local_placement = scalars.direct_local_placement;
    const auto vector_reduce_tile_elements = scalars.vector_reduce_tile_elements;
    const auto stage = scalars.stage;
    const auto profile_enabled = scalars.profile_enabled;
    const auto tiling = scalars.tiling;
    const auto release_segment = direct_combine_release_segment(stage, profile_enabled);
    const std::uint64_t hybrid_record_capacity =
        (tiling.mode_flags & (CoreModeFlags{1} << static_cast<std::uint8_t>(
            CoreMode::kExpanded))) != 0 &&
        (tiling.mode_flags & (CoreModeFlags{1} << static_cast<std::uint8_t>(
            CoreMode::kAllowMultipleReduction))) == 0 ?
            tiling.num_max_tokens_per_rank * tiling.num_topk :
            tiling.num_max_tokens_per_rank;
    asc_vf_call<direct_combine_producer_record_vf>(
        dim3(tiling.launch.num_threads),
        reinterpret_cast<__gm__ const bfloat16_t*>(x),
        topk_weights,
        source_metadata,
        workspace,
        local_window_base,
        tiling.mode_flags,
        num_source_rows,
        num_input_rows,
        tiling.num_topk,
        tiling.num_max_tokens_per_rank,
        tiling.symmetric_window_layout.combine_record_bytes,
        tiling.symmetric_window_layout.combine_weight_offset,
        tiling.symmetric_window_layout.combine_receive_offset,
        tiling.symmetric_window_layout.combine_receive_shard_bytes,
        tiling.symmetric_window_layout.combine_staging_offset,
        tiling.symmetric_window_layout.combine_staging_shard_bytes,
        tiling.workspace_layout.scratch_status_offset,
        tiling.workspace_layout.scratch_rank_values_offset,
        tiling.workspace_layout.combine_record_slots_offset,
        tiling.workspace_layout.combine_producer_tile_rank_count_offset,
        tiling.workspace_layout.combine_producer_tile_count,
        tiling.transport_context.topology.world_rank,
        tiling.transport_context.topology.world_size,
        tiling.hidden,
        expanded_vector_reduce,
        direct_local_placement);
}

extern "C" int deep_ep_ascend_launch_direct_combine_producer_record(
    CombineArguments arguments, CoreTiling tiling,
    DirectCombineStage stage, bool profile_enabled,
    void* stream, CoreLaunchShape launch) {
    const CombineVfScalars scalars{
        arguments.route_record_count, arguments.generation,
        arguments.timeout_cycles,
        arguments.num_source_rows, arguments.num_input_rows,
        arguments.local_window_base, arguments.expanded_vector_reduce,
        arguments.local_copy_datacopy, arguments.direct_local_placement,
        arguments.vector_reduce_tile_elements, stage, profile_enabled, tiling};
    direct_combine_producer_record_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        static_cast<const std::uint16_t*>(arguments.x),
        arguments.topk_weights, arguments.source_metadata,
        arguments.route_records, arguments.combined_topk_indices,
        arguments.prefix_per_rank,
        static_cast<std::uint8_t*>(arguments.workspace),
        static_cast<std::uint16_t*>(arguments.combined_x),
        arguments.combined_topk_weights,
        static_cast<const std::uint16_t*>(arguments.bias_0),
        static_cast<const std::uint16_t*>(arguments.bias_1), scalars);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
