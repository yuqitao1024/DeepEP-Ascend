namespace deep_ep::ascend::elastic {

#include "dispatch_device_common.hpp"

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_epilogue_acquire_vf(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ const std::int32_t* prefix_per_rank,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t timeout_cycles, std::uint64_t num_experts,
    std::uint64_t expert_alignment, std::uint64_t shard_capacity,
    std::uint64_t dispatch_output_capacity,
    std::uint64_t dispatch_control_offset,
    std::uint64_t dispatch_control_bytes,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_receive_shard_count,
    std::uint64_t dispatch_receive_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_local_count_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_route_source_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t workspace_rank_count,
    std::uint64_t dispatch_error_offset,
    std::uint64_t dispatch_error_count,
    std::uint64_t dispatch_rank_bitmap_bytes,
    std::uint64_t dispatch_expert_bitmap_bytes,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t dispatch_pipeline_bytes,
    std::uint64_t token_stride_bytes,
    std::uint32_t early_route_plan,
    std::uint32_t persistent_source_pipeline) {
    if (threadIdx.x != 0)
        return;

    const auto context = make_hybrid_dispatch_context(
        transport_abi_version, transport_struct_size,
        transport_capabilities, transport_local_window_base,
        transport_channel_table, transport_peer_address_table,
        transport_topology_abi_version, transport_topology_struct_size,
        transport_world_rank, transport_world_size,
        transport_scale_up_rank, transport_scale_up_size,
        transport_scale_out_rank, transport_scale_out_size,
        transport_scale_up_direct, transport_topology_kind,
        transport_topology_epoch, transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
#if DEEP_EP_ASCEND_ACQUIRE_DIAGNOSTICS
    __gm__ transport::TransportStageProfile* acquire_profile = nullptr;
    std::uint32_t logged_peer_count = 0;
#endif
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0)
        return;

    auto* errors = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_error_offset);
    const std::uint32_t error_count_u32 =
        static_cast<std::uint32_t>(dispatch_error_count);
    for (std::uint32_t index = 0; index < error_count_u32; ++index)
        errors[index] = 0;

    const bool cached = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const bool valid_world = transport_world_size > 0;
    const std::uint64_t world_size = valid_world ?
        static_cast<std::uint64_t>(transport_world_size) : 0;
    const std::uint64_t local_experts =
        valid_world && num_experts % world_size == 0 ?
            num_experts / world_size : 0;
    std::uint64_t rank_bitmap_words = 0;
    std::uint64_t expert_bitmap_words = 0;
    const bool valid_parallel_layout =
        valid_world && local_experts != 0 && expert_alignment != 0 &&
        dispatch_error_offset != 0 &&
        dispatch_error_count == world_size + local_experts &&
        workspace_rank_count == world_size &&
        dispatch_simt_owner_bitmap_words(
            world_size, shard_capacity, &rank_bitmap_words) &&
        dispatch_simt_owner_bitmap_words(
            local_experts, dispatch_output_capacity,
            &expert_bitmap_words) &&
        rank_bitmap_words <=
            dispatch_rank_bitmap_bytes / sizeof(std::uint64_t) &&
        expert_bitmap_words <=
            dispatch_expert_bitmap_bytes / sizeof(std::uint64_t);
    if (!transport::device::detail::valid_topology(context.topology) ||
        !valid_parallel_layout ||
        dispatch_output_capacity >
            static_cast<std::uint64_t>(0x7fffffff) ||
        (transport_world_size > 1 &&
         (dispatch_control_bytes <
              world_size * sizeof(DispatchControlSlot) ||
          dispatch_receive_shard_count != world_size ||
          dispatch_receive_bytes <
              world_size * dispatch_receive_shard_bytes ||
          shard_capacity * token_stride_bytes >
              dispatch_receive_shard_bytes))) {
        record_dispatch_protocol_error(
            context, status_address, transport_world_rank,
            DispatchProtocolStage::kEpilogue, generation,
            DispatchProtocolError::kInvalidLayout);
        return;
    }

    auto* source_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + (early_route_plan != 0 ?
            workspace_route_source_counts_offset :
            workspace_rank_counts_offset));
    auto* canonical_source_counts =
        reinterpret_cast<__gm__ std::uint64_t*>(
            workspace + workspace_rank_counts_offset);
    auto* source_bases = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    if (transport_world_size == 1) {
        const auto local_count_address =
            reinterpret_cast<transport::DeviceAddress>(
                workspace + workspace_local_count_offset);
        const std::uint64_t payload_count =
            transport.load_acquire(local_count_address);
        std::uint64_t canonical_count = 0;
        if (!dispatch_simt_handoff_dispatch_route_source_count(
                early_route_plan != 0, source_counts[0], payload_count,
                shard_capacity, &canonical_count)) {
            record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolStage::kEpilogue, generation,
                payload_count > shard_capacity ?
                    DispatchProtocolError::kCapacityOverflow :
                    DispatchProtocolError::kInvalidControl);
            return;
        }
        source_counts[0] = canonical_count;
        canonical_source_counts[0] = canonical_count;
    } else {
        auto* staged = reinterpret_cast<__gm__ transport::StagedTransportContext*>(
            context.backend_context);
#if DEEP_EP_ASCEND_ACQUIRE_DIAGNOSTICS
        if (context.abi_version == transport::kDeviceTransportAbiVersion &&
            context.struct_size == sizeof(transport::DeviceTransportContext) &&
            staged != nullptr &&
            transport::simt::load_observed(&staged->abi_version) ==
                transport::kTransportCommandAbiVersion &&
            transport::simt::load_observed(&staged->struct_size) ==
                sizeof(transport::StagedTransportContext) &&
            transport::simt::load_observed(&staged->cann_compatibility) ==
                transport::kStagedTransportCannCompatibility &&
            transport::simt::load_observed(&staged->stage_profile) != 0 &&
            transport::simt::load_observed(&staged->stage_profile_bytes) ==
                sizeof(transport::TransportStageProfile)) {
            acquire_profile = reinterpret_cast<
                __gm__ transport::TransportStageProfile*>(
                    staged->stage_profile);
            if (acquire_profile != nullptr) {
                transport::simt::store_published(
                    &acquire_profile->acquire_probe,
                    std::uint64_t{0x4143515545524531ULL});
            }
        }
#endif

#if DEEP_EP_ASCEND_ACQUIRE_DIAGNOSTICS
        if (acquire_profile != nullptr) {
            transport::simt::store_published(
                &acquire_profile->acquire_vf_start_cycles,
                __asc_simt_vf::clock());
        }
#endif
        bool pipeline_completion_ready = false;
        std::uint32_t completion_diagnostic = 0;
        if (persistent_source_pipeline == 0)
            completion_diagnostic |= 1U;
        if (dispatch_pipeline_bytes != sizeof(DispatchPipelineState))
            completion_diagnostic |= 2U;
        if (persistent_source_pipeline != 0 &&
            dispatch_pipeline_bytes == sizeof(DispatchPipelineState)) {
            auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
                workspace + dispatch_pipeline_offset);
            const auto pipeline_abi = transport::simt::load_observed(
                &pipeline->abi_version);
            const auto pipeline_size = transport::simt::load_observed(
                &pipeline->struct_size);
            const auto pipeline_generation = transport::simt::load_observed(
                &pipeline->generation);
            if (pipeline_abi != kDispatchPipelineAbiVersion)
                completion_diagnostic |= 4U;
            if (pipeline_size != sizeof(DispatchPipelineState))
                completion_diagnostic |= 8U;
            if (pipeline_generation != generation)
                completion_diagnostic |= 16U;
            pipeline_completion_ready =
                completion_diagnostic == 0;
            transport::simt::system_fence();
        }
        const bool transport_completion_ready =
            persistent_source_pipeline != 0 ?
                pipeline_completion_ready :
                transport.consumed_generation() == generation;
        if (!transport_completion_ready) {
            record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolStage::kEpilogue, generation,
                DispatchProtocolError::kInvalidControl,
                completion_diagnostic);
            return;
        }
        // All source readiness is polled before the final acquisition loop so that
        // an already-ready source is not blocked by an earlier pending source.
        auto* control_slots = reinterpret_cast<__gm__ DispatchControlSlot*>(
            transport_local_window_base + dispatch_control_offset);
        const std::uint64_t acquire_wait_start = __asc_simt_vf::clock();
#if DEEP_EP_ASCEND_ACQUIRE_DIAGNOSTICS
        if (acquire_profile != nullptr) {
            transport::simt::store_published(
                &acquire_profile->acquire_wait_start_cycles,
                acquire_wait_start);
        }
#endif
        bool any_source_pending = true;
        bool peer_ready_logged[16] = {};
        while (any_source_pending) {
            any_source_pending = false;
            for (int source_rank = 0;
                 source_rank < transport_world_size; ++source_rank) {
                const auto release_boundary = dispatch_release_boundary(
                    source_rank, transport_world_rank,
                    transport_scale_up_size);
                const auto control_slot_address =
                    reinterpret_cast<transport::DeviceAddress>(control_slots) +
                    static_cast<std::uint64_t>(
                        release_boundary.control_slot_world_rank) *
                        sizeof(DispatchControlSlot);
                const auto observed_control_generation =
                    transport.load_acquire(control_slot_address);
                bool source_ready = observed_control_generation == generation;
                if (source_ready &&
                    release_boundary.remote_acquire_required &&
                    release_boundary.control_slot_world_rank !=
                        transport_world_rank) {
                    transport::TeamPeer signal_route{};
                    source_ready = transport::device::detail::
                        checked_device_team_peer_for_world_rank(
                            context.topology,
                            release_boundary.signal_sender_world_rank,
                            &signal_route) &&
                        transport.read_signal(
                            signal_route.team, signal_route.peer,
                            transport::sync_layout::
                                kDispatchReleaseSignalIndex) >= generation;
                }
                if (source_ready) {
#if DEEP_EP_ASCEND_ACQUIRE_DIAGNOSTICS
                    if (acquire_profile != nullptr && source_rank < 16 &&
                        !peer_ready_logged[source_rank]) {
                        peer_ready_logged[source_rank] = true;
                        const auto diagnostic_index =
                            static_cast<std::uint32_t>(source_rank);
                        transport::simt::store_published(
                            &acquire_profile
                                ->acquire_peer_first_ready_cycles[diagnostic_index],
                            __asc_simt_vf::clock() - acquire_wait_start);
                        transport::simt::store_published(
                            &acquire_profile->acquire_peer_world_rank[diagnostic_index],
                            static_cast<std::uint32_t>(source_rank));
                        ++logged_peer_count;
                    }
#endif
                    continue;
                }
                any_source_pending = true;
            }
            if (!any_source_pending)
                break;
            transport::simt::poll_nop();
            if (timeout_cycles != 0 &&
                __asc_simt_vf::clock() - acquire_wait_start >=
                    timeout_cycles)
                break;
        }
#if DEEP_EP_ASCEND_ACQUIRE_DIAGNOSTICS
        if (acquire_profile != nullptr) {
            transport::simt::store_published(
                &acquire_profile->acquire_wait_end_cycles,
                __asc_simt_vf::clock() - acquire_wait_start);
            transport::simt::store_published(
                &acquire_profile->acquire_peer_count, logged_peer_count);
            transport::simt::system_fence();
        }
#endif
        for (int source_rank = 0;
             source_rank < transport_world_size; ++source_rank) {
            const auto release_boundary = dispatch_release_boundary(
                source_rank, transport_world_rank,
                transport_scale_up_size);
            std::uint32_t persistent_control_diagnostic = 0;
            std::uint64_t observed_signal = generation;
            const auto control_slot_address =
                reinterpret_cast<transport::DeviceAddress>(control_slots) +
                static_cast<std::uint64_t>(
                    release_boundary.control_slot_world_rank) *
                    sizeof(DispatchControlSlot);
            const auto observed_control_generation =
                transport.load_acquire(control_slot_address);
            if (persistent_source_pipeline != 0 &&
                release_boundary.remote_acquire_required &&
                release_boundary.control_slot_world_rank !=
                    transport_world_rank) {
                transport::TeamPeer signal_route{};
                if (!transport::device::detail::
                        checked_device_team_peer_for_world_rank(
                            context.topology,
                            release_boundary.signal_sender_world_rank,
                            &signal_route)) {
                    persistent_control_diagnostic |= 1U;
                    observed_signal = 0;
                } else {
                    observed_signal = transport.read_signal(
                        signal_route.team, signal_route.peer,
                        transport::sync_layout::
                            kDispatchReleaseSignalIndex);
                    if (observed_signal < generation)
                        persistent_control_diagnostic |= 2U;
                }
            }
            if (persistent_source_pipeline != 0 &&
                observed_control_generation != generation)
                persistent_control_diagnostic |= 4U;
            if (persistent_control_diagnostic != 0) {
                persistent_control_diagnostic |=
                    (static_cast<std::uint32_t>(source_rank) & 0x7U) << 5U;
                persistent_control_diagnostic |=
                    static_cast<std::uint32_t>(
                        observed_signal > 0xffU ? 0xffU : observed_signal)
                    << 8U;
                persistent_control_diagnostic |=
                    static_cast<std::uint32_t>(
                        observed_control_generation > 0xffU ?
                            0xffU : observed_control_generation)
                    << 16U;
                record_dispatch_protocol_error(
                    context, status_address, source_rank,
                    DispatchProtocolStage::kEpilogue, generation,
                    DispatchProtocolError::kInvalidControl,
                    persistent_control_diagnostic);
                return;
            }
            const auto observation =
                release_protocol::observe_release_control(
                    transport, context.topology, release_boundary,
                    transport_world_rank, control_slots,
                    transport::sync_layout::kDispatchReleaseSignalIndex,
                    generation, timeout_cycles);
            std::uint64_t canonical_count = 0;
            if (!observation.acquired ||
                observation.generation != generation ||
                !dispatch_simt_handoff_dispatch_route_source_count(
                    early_route_plan != 0, source_counts[source_rank],
                    observation.count, shard_capacity, &canonical_count)) {
                record_dispatch_protocol_error(
                    context, status_address, source_rank,
                    DispatchProtocolStage::kEpilogue, generation,
                    observation.count > shard_capacity ?
                        DispatchProtocolError::kCapacityOverflow :
                        DispatchProtocolError::kInvalidControl);
                return;
            }
            source_counts[source_rank] = canonical_count;
            canonical_source_counts[source_rank] = canonical_count;
        }
    }

    std::uint64_t total_records = 0;
    for (int source_rank = 0;
         source_rank < transport_world_size; ++source_rank) {
        source_bases[source_rank] = total_records;
        total_records += source_counts[source_rank];
        if (cached && prefix_per_rank[source_rank] !=
                static_cast<std::int32_t>(total_records)) {
            record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolStage::kEpilogue, generation,
                DispatchProtocolError::kInvalidCachedPrefix);
            return;
        }
    }
    if (total_records > shard_capacity * world_size) {
        record_dispatch_protocol_error(
            context, status_address, transport_world_rank,
            DispatchProtocolStage::kEpilogue, generation,
            DispatchProtocolError::kCapacityOverflow);
    }
#if DEEP_EP_ASCEND_ACQUIRE_DIAGNOSTICS
    if (acquire_profile != nullptr) {
        transport::simt::store_published(
            &acquire_profile->acquire_vf_end_cycles,
            __asc_simt_vf::clock());
        transport::simt::system_fence();
    }
#endif
    (void)communication_buffer;
}

struct DirectDispatchEpilogueAcquireKernelArguments {
    __gm__ std::uint8_t* communication_buffer;
    __gm__ std::uint8_t* workspace;
    __gm__ const std::int32_t* prefix_per_rank;
    std::uint32_t transport_abi_version, transport_struct_size;
    std::uint64_t transport_capabilities;
    std::uintptr_t transport_local_window_base, transport_channel_table;
    std::uintptr_t transport_peer_address_table;
    std::uint32_t transport_topology_abi_version;
    std::uint32_t transport_topology_struct_size;
    int transport_world_rank, transport_world_size;
    int transport_scale_up_rank, transport_scale_up_size;
    int transport_scale_out_rank, transport_scale_out_size;
    std::uint32_t transport_scale_up_direct, transport_topology_kind;
    std::uint64_t transport_topology_epoch;
    std::uintptr_t transport_backend_context;
    CoreModeFlags mode_flags;
    std::uint64_t generation, timeout_cycles;
    std::uint64_t num_experts, expert_alignment, shard_capacity;
    std::uint64_t dispatch_output_capacity, dispatch_control_offset;
    std::uint64_t dispatch_control_bytes, dispatch_receive_shard_bytes;
    std::uint64_t dispatch_receive_shard_count, dispatch_receive_bytes;
    std::uint64_t workspace_status_offset, workspace_local_count_offset;
    std::uint64_t workspace_rank_counts_offset;
    std::uint64_t workspace_route_source_counts_offset;
    std::uint64_t workspace_rank_values_offset, workspace_rank_count;
    std::uint64_t dispatch_error_offset, dispatch_error_count;
    std::uint64_t dispatch_rank_bitmap_bytes, dispatch_expert_bitmap_bytes;
    std::uint64_t dispatch_pipeline_offset, dispatch_pipeline_bytes;
    std::uint64_t token_stride_bytes;
    std::uint32_t early_route_plan, persistent_source_pipeline;
    std::uint32_t vf_num_threads;
};

__global__ __vector__ void direct_dispatch_epilogue_acquire_kernel(
    DirectDispatchEpilogueAcquireKernelArguments arguments) {
    asc_vf_call<direct_dispatch_epilogue_acquire_vf>(
        dim3(arguments.vf_num_threads), arguments.communication_buffer,
        arguments.workspace, arguments.prefix_per_rank,
        arguments.transport_abi_version, arguments.transport_struct_size,
        arguments.transport_capabilities, arguments.transport_local_window_base,
        arguments.transport_channel_table, arguments.transport_peer_address_table,
        arguments.transport_topology_abi_version,
        arguments.transport_topology_struct_size, arguments.transport_world_rank,
        arguments.transport_world_size, arguments.transport_scale_up_rank,
        arguments.transport_scale_up_size, arguments.transport_scale_out_rank,
        arguments.transport_scale_out_size, arguments.transport_scale_up_direct,
        arguments.transport_topology_kind, arguments.transport_topology_epoch,
        arguments.transport_backend_context, arguments.mode_flags,
        arguments.generation, arguments.timeout_cycles, arguments.num_experts,
        arguments.expert_alignment, arguments.shard_capacity,
        arguments.dispatch_output_capacity, arguments.dispatch_control_offset,
        arguments.dispatch_control_bytes,
        arguments.dispatch_receive_shard_bytes,
        arguments.dispatch_receive_shard_count, arguments.dispatch_receive_bytes,
        arguments.workspace_status_offset,
        arguments.workspace_local_count_offset,
        arguments.workspace_rank_counts_offset,
        arguments.workspace_route_source_counts_offset,
        arguments.workspace_rank_values_offset, arguments.workspace_rank_count,
        arguments.dispatch_error_offset, arguments.dispatch_error_count,
        arguments.dispatch_rank_bitmap_bytes,
        arguments.dispatch_expert_bitmap_bytes,
        arguments.dispatch_pipeline_offset, arguments.dispatch_pipeline_bytes,
        arguments.token_stride_bytes, arguments.early_route_plan,
        arguments.persistent_source_pipeline);
}

extern "C" int deep_ep_ascend_launch_direct_dispatch_epilogue_acquire(
    std::uint8_t* communication_buffer,
    std::uint8_t* workspace,
    const std::int32_t* prefix_per_rank,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank,
    int transport_world_size,
    int transport_scale_up_rank,
    int transport_scale_up_size,
    int transport_scale_out_rank,
    int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    CoreModeFlags mode_flags,
    std::uint64_t generation,
    std::uint64_t timeout_cycles,
    std::uint64_t num_experts,
    std::uint64_t expert_alignment,
    std::uint64_t shard_capacity,
    std::uint64_t dispatch_output_capacity,
    std::uint64_t dispatch_control_offset,
    std::uint64_t dispatch_control_bytes,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_receive_shard_count,
    std::uint64_t dispatch_receive_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_local_count_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_route_source_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t workspace_rank_count,
    std::uint64_t dispatch_error_offset,
    std::uint64_t dispatch_error_count,
    std::uint64_t dispatch_rank_bitmap_bytes,
    std::uint64_t dispatch_expert_bitmap_bytes,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t dispatch_pipeline_bytes,
    std::uint64_t token_stride_bytes,
    std::uint32_t early_route_plan,
    std::uint32_t persistent_source_pipeline,
    void* stream, CoreLaunchShape launch,
    std::uint32_t vf_num_threads) {
    const DirectDispatchEpilogueAcquireKernelArguments arguments{
        communication_buffer, workspace, prefix_per_rank,
        transport_abi_version, transport_struct_size, transport_capabilities,
        transport_local_window_base, transport_channel_table,
        transport_peer_address_table, transport_topology_abi_version,
        transport_topology_struct_size, transport_world_rank,
        transport_world_size, transport_scale_up_rank, transport_scale_up_size,
        transport_scale_out_rank, transport_scale_out_size,
        transport_scale_up_direct, transport_topology_kind,
        transport_topology_epoch, transport_backend_context, mode_flags,
        generation, timeout_cycles, num_experts, expert_alignment,
        shard_capacity, dispatch_output_capacity, dispatch_control_offset,
        dispatch_control_bytes, dispatch_receive_shard_bytes,
        dispatch_receive_shard_count, dispatch_receive_bytes,
        workspace_status_offset, workspace_local_count_offset,
        workspace_rank_counts_offset, workspace_route_source_counts_offset,
        workspace_rank_values_offset, workspace_rank_count,
        dispatch_error_offset, dispatch_error_count,
        dispatch_rank_bitmap_bytes, dispatch_expert_bitmap_bytes,
        dispatch_pipeline_offset, dispatch_pipeline_bytes, token_stride_bytes,
        early_route_plan, persistent_source_pipeline, vf_num_threads};
    direct_dispatch_epilogue_acquire_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        arguments);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
