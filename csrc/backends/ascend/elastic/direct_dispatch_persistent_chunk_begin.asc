#include "../transport/device_transport_facade.hpp"

namespace deep_ep::ascend::elastic {

#include "dispatch_device_common.hpp"

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_persistent_chunk_begin_vf(
    __gm__ std::uint8_t* workspace,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t generation,
    std::uint32_t source_chunk_count,
    std::uint32_t source_chunk_tiles,
    std::uint32_t source_chunk,
    std::uint32_t source_tile_begin,
    std::uint32_t source_tile_end) {
    if (threadIdx.x != 0)
        return;
    auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
        workspace + dispatch_pipeline_offset);
    if (blockIdx.x == 0 && source_chunk == 0) {
        transport::simt::store_published(
            &pipeline->abi_version, kDispatchPipelineAbiVersion);
        transport::simt::store_published(
            &pipeline->struct_size,
            static_cast<std::uint32_t>(sizeof(DispatchPipelineState)));
        transport::simt::store_published(
            &pipeline->chunk_count, source_chunk_count);
        transport::simt::store_published(
            &pipeline->completed_chunks, 0U);
        transport::simt::store_published(
            &pipeline->chunk_slots,
            static_cast<std::uint64_t>(source_chunk_tiles));
        transport::simt::store_published(
            reinterpret_cast<__gm__ std::uint32_t*>(
                &pipeline->terminal_error),
            static_cast<std::uint32_t>(
                transport::DeviceTransportError::kNone));
        transport::simt::store_published(
            &pipeline->release_completed_generation, std::uint64_t{0});
        for (std::uint32_t slot_index = 0;
             slot_index < kDispatchPipelineSlotCount; ++slot_index) {
            auto* slot = &pipeline->slots[slot_index];
            slot->chunk_begin = 0;
            slot->chunk_end = 0;
            slot->chunk_index = 0;
            slot->scalar_blocks_completed = 0;
            slot->hidden_blocks_completed = 0;
            slot->published_chunk = UINT32_MAX;
            transport::simt::store_published(
                reinterpret_cast<__gm__ std::uint32_t*>(&slot->state),
                static_cast<std::uint32_t>(
                    DispatchPipelineSlotState::kEmpty));
        }
        transport::simt::system_fence();
        transport::simt::store_published(&pipeline->generation, generation);
    } else {
        while (transport::simt::load_observed(&pipeline->generation) !=
               generation) {
            dispatch_simt_poll_nop();
        }
    }

    if (source_chunk == 0U) {
        transport::simt::store_published(
            reinterpret_cast<__gm__ std::uint32_t*>(
                &pipeline->release_worker_state),
            static_cast<std::uint32_t>(
                DispatchPipelineWorkerState::kRunning));
    }
    auto* slot = &pipeline->slots[dispatch_simt_pipeline_slot(source_chunk)];
    if (blockIdx.x == 0) {
        while (true) {
            dispatch_simt_poll_nop();
            const auto state = static_cast<DispatchPipelineSlotState>(
                transport::simt::load_observed(
                    reinterpret_cast<__gm__ std::uint32_t*>(
                        &slot->state)));
            const std::uint32_t published_chunk =
                transport::simt::load_observed(&slot->published_chunk);
            const bool reusable =
                (state == DispatchPipelineSlotState::kEmpty &&
                 source_chunk < kDispatchPipelineSlotCount) ||
                (state == DispatchPipelineSlotState::kCompleted &&
                 published_chunk <=
                     UINT32_MAX - kDispatchPipelineSlotCount &&
                 published_chunk + kDispatchPipelineSlotCount ==
                     source_chunk);
            if (reusable)
                break;
        }
        slot->chunk_begin = source_tile_begin;
        slot->chunk_end = source_tile_end;
        slot->chunk_index = source_chunk;
        slot->scalar_blocks_completed = 0;
        slot->hidden_blocks_completed = 0;
        slot->published_chunk = source_chunk;
        transport::simt::system_fence();
        transport::simt::store_published(
            reinterpret_cast<__gm__ std::uint32_t*>(&slot->state),
            static_cast<std::uint32_t>(
                DispatchPipelineSlotState::kProducing));
        return;
    }

    while (true) {
        dispatch_simt_poll_nop();
        const auto state = static_cast<DispatchPipelineSlotState>(
            transport::simt::load_observed(
                reinterpret_cast<__gm__ std::uint32_t*>(&slot->state)));
        const std::uint32_t published_chunk =
            transport::simt::load_observed(&slot->published_chunk);
        if (state == DispatchPipelineSlotState::kProducing &&
            published_chunk == source_chunk)
            return;
    }
}

struct DirectDispatchPersistentChunkBeginKernelArguments {
    __gm__ std::uint8_t* workspace;
    std::uint64_t dispatch_pipeline_offset;
    std::uint64_t generation;
    std::uint32_t source_chunk_count;
    std::uint32_t source_chunk_tiles;
    std::uint32_t source_chunk;
    std::uint32_t source_tile_begin;
    std::uint32_t source_tile_end;
    std::uint32_t vf_num_threads;
};

__global__ __vector__ void direct_dispatch_persistent_chunk_begin_kernel(
    DirectDispatchPersistentChunkBeginKernelArguments arguments) {
    asc_vf_call<direct_dispatch_persistent_chunk_begin_vf> (
        dim3(arguments.vf_num_threads), arguments.workspace, arguments.dispatch_pipeline_offset, arguments.generation, arguments.source_chunk_count, arguments.source_chunk_tiles, arguments.source_chunk, arguments.source_tile_begin, arguments.source_tile_end);
}

extern "C" int deep_ep_ascend_launch_direct_dispatch_persistent_chunk_begin(
    std::uint8_t* workspace,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t generation,
    std::uint32_t source_chunk_count,
    std::uint32_t source_chunk_tiles,
    std::uint32_t source_chunk,
    std::uint32_t source_tile_begin,
    std::uint32_t source_tile_end,
    void* stream, CoreLaunchShape launch,
    std::uint32_t vf_num_threads) {
    const DirectDispatchPersistentChunkBeginKernelArguments arguments{
        workspace,
        dispatch_pipeline_offset,
        generation,
        source_chunk_count,
        source_chunk_tiles,
        source_chunk,
        source_tile_begin,
        source_tile_end,
        vf_num_threads};
    direct_dispatch_persistent_chunk_begin_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(arguments);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
