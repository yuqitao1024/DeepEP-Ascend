__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_epilogue_copy_outputs_vf(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ std::uint8_t* recv_x,
    __gm__ std::uint8_t* recv_scale_factors,
    __gm__ float* recv_topk_weights,
    __gm__ const std::int32_t* source_metadata,
    std::uintptr_t transport_local_window_base,
    int transport_world_size, CoreModeFlags mode_flags,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes,
    std::uint64_t hidden_copy_begin,
    std::uint64_t token_scale_factor_offset,
    std::uint64_t token_scale_factor_bytes,
    std::uint64_t recv_scale_factor_token_stride,
    std::uint64_t recv_scale_factor_pack_stride,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_topk_weight_offset) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::simt::load_observed(status) != 0)
        return;
    const bool expanded = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t world_size =
        static_cast<std::uint32_t>(transport_world_size);
    (void)shard_capacity;
    auto* source_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* source_bases = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    if (world_size == 0)
        return;
    const std::uint32_t last_source_rank = world_size - 1;
    const std::uint32_t total_records = static_cast<std::uint32_t>(
        source_bases[last_source_rank] + source_counts[last_source_rank]);
    const std::uint32_t copies_per_record =
        expanded ? num_topk_u32 : 1;
    const std::uint32_t logical_count =
        total_records * copies_per_record;
    const auto grid = direct_data_grid_stride(
        blockIdx.x, threadIdx.x, gridDim.x, blockDim.x);
    for (std::uint32_t logical = grid.first; logical < logical_count;
         logical += grid.stride) {
        const std::uint32_t compact_record =
            logical / copies_per_record;
        const std::uint32_t lane =
            expanded ? logical % copies_per_record : 0;
        std::uint32_t source_rank = 0;
        std::uint32_t source_slot = 0;
        if (!direct_dispatch_compact_record_coordinates(
                compact_record, source_bases, source_counts, world_size,
                &source_rank, &source_slot))
            continue;
        const std::uint64_t compact_slot = compact_record;
        __gm__ std::uint8_t* source_shard =
            transport_world_size == 1 ? communication_buffer :
            reinterpret_cast<__gm__ std::uint8_t*>(
                transport_local_window_base + dispatch_receive_offset +
                static_cast<std::uint64_t>(source_rank) *
                    dispatch_receive_shard_bytes);
        __gm__ std::uint8_t* record =
            source_shard + source_slot * token_stride_bytes;
        auto* record_topk =
            reinterpret_cast<__gm__ const std::int64_t*>(
                record + token_topk_index_offset);
        auto* record_weights =
            reinterpret_cast<__gm__ const float*>(
                record + token_topk_weight_offset);
        std::uint64_t destination = compact_slot;
        if (expanded) {
            const auto* output_metadata =
                source_metadata + compact_slot * (2 + num_topk);
            if (record_topk[lane] < 0 ||
                output_metadata[2 + lane] < 0)
                continue;
            destination = static_cast<std::uint64_t>(
                output_metadata[2 + lane]);
        }
        for (std::uint64_t byte = hidden_copy_begin;
             byte < token_hidden_bytes; ++byte)
            recv_x[destination * token_hidden_bytes + byte] =
                record[token_hidden_offset + byte];
        if (recv_scale_factors != nullptr)
            for (std::uint64_t pack = 0;
                 pack < token_scale_factor_bytes / 4; ++pack) {
                const std::uint64_t destination_offset =
                    scale_factor_byte_offset(
                        destination, pack,
                        recv_scale_factor_token_stride,
                        recv_scale_factor_pack_stride, 4);
                direct_dispatch_load_scale_factor_pack(
                    record, token_scale_factor_offset + pack * 4,
                    recv_scale_factors, destination_offset);
            }
        if (recv_topk_weights != nullptr) {
            if (expanded)
                recv_topk_weights[destination] = record_weights[lane];
            else
                for (std::uint32_t compact_lane = 0;
                     compact_lane < num_topk_u32; ++compact_lane)
                    recv_topk_weights[
                        compact_slot * num_topk + compact_lane] =
                            record_weights[compact_lane];
        }
    }
}

__global__ __vector__ void direct_dispatch_epilogue_copy_outputs_kernel(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ std::uint8_t* recv_x,
    __gm__ std::uint8_t* recv_scale_factors,
    __gm__ float* recv_topk_weights,
    __gm__ const std::int32_t* source_metadata,
    std::uintptr_t transport_local_window_base,
    int transport_world_size, CoreModeFlags mode_flags,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes,
    std::uint64_t hidden_copy_begin,
    std::uint64_t token_scale_factor_offset,
    std::uint64_t token_scale_factor_bytes,
    std::uint64_t recv_scale_factor_token_stride,
    std::uint64_t recv_scale_factor_pack_stride,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_topk_weight_offset,
    std::uint32_t vf_num_threads) {
    asc_vf_call<direct_dispatch_epilogue_copy_outputs_vf>(
        dim3(vf_num_threads), communication_buffer, workspace, recv_x, recv_scale_factors, recv_topk_weights, source_metadata, transport_local_window_base, transport_world_size, mode_flags, num_topk, shard_capacity, dispatch_receive_offset, dispatch_receive_shard_bytes, workspace_status_offset, workspace_rank_counts_offset, workspace_rank_values_offset, token_stride_bytes, token_hidden_offset, token_hidden_bytes, hidden_copy_begin, token_scale_factor_offset, token_scale_factor_bytes, recv_scale_factor_token_stride, recv_scale_factor_pack_stride, token_topk_index_offset, token_topk_weight_offset);
}

extern "C" int deep_ep_ascend_launch_direct_dispatch_epilogue_copy_outputs(
    std::uint8_t* communication_buffer,
    std::uint8_t* workspace,
    std::uint8_t* recv_x,
    std::uint8_t* recv_scale_factors,
    float* recv_topk_weights,
    const std::int32_t* source_metadata,
    std::uintptr_t transport_local_window_base,
    int transport_world_size,
    CoreModeFlags mode_flags,
    std::uint64_t num_topk,
    std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes,
    std::uint64_t hidden_copy_begin,
    std::uint64_t token_scale_factor_offset,
    std::uint64_t token_scale_factor_bytes,
    std::uint64_t recv_scale_factor_token_stride,
    std::uint64_t recv_scale_factor_pack_stride,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_topk_weight_offset,
    void* stream, CoreLaunchShape launch,
    std::uint32_t vf_num_threads) {
    direct_dispatch_epilogue_copy_outputs_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        communication_buffer, workspace, recv_x, recv_scale_factors, recv_topk_weights, source_metadata, transport_local_window_base, transport_world_size, mode_flags, num_topk, shard_capacity, dispatch_receive_offset, dispatch_receive_shard_bytes, workspace_status_offset, workspace_rank_counts_offset, workspace_rank_values_offset, token_stride_bytes, token_hidden_offset, token_hidden_bytes, hidden_copy_begin, token_scale_factor_offset, token_scale_factor_bytes, recv_scale_factor_token_stride, recv_scale_factor_pack_stride, token_topk_index_offset, token_topk_weight_offset, vf_num_threads);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
