namespace deep_ep::ascend::elastic {

#include "dispatch_device_common.hpp"

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_producer_record_vf(
    __gm__ const std::uint8_t* x,
    __gm__ const std::uint8_t* scale_factors,
    __gm__ const std::int64_t* topk_indices,
    __gm__ const float* topk_weights,
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ std::int32_t* destination_slots,
    std::uintptr_t transport_local_window_base,
    int transport_world_rank, int transport_world_size,
    CoreModeFlags mode_flags, std::uint32_t use_grouping,
    std::uint64_t num_tokens, std::uint64_t num_experts,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t dispatch_group_owner_offset,
    std::uint64_t dispatch_group_tile_offset,
    std::uint64_t dispatch_group_tile_count,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes,
    std::uint64_t hidden_copy_begin,
    std::uint64_t pipeline_chunk_begin,
    std::uint64_t pipeline_chunk_end,
    std::uint32_t pipeline_source_chunk,
    std::uint64_t token_scale_factor_offset,
    std::uint64_t token_scale_factor_bytes,
    std::uint64_t scale_factor_token_stride,
    std::uint64_t scale_factor_pack_stride,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_topk_weight_offset,
    std::uint64_t token_source_metadata_offset) {
    direct_dispatch_producer_record_body(
        x, scale_factors, topk_indices, topk_weights,
        communication_buffer, workspace, destination_slots,
        transport_local_window_base, transport_world_rank,
        transport_world_size, mode_flags, use_grouping, num_tokens,
        num_experts, num_topk, shard_capacity, dispatch_receive_offset,
        dispatch_receive_shard_bytes, dispatch_staging_offset,
        dispatch_staging_shard_bytes, workspace_status_offset,
        dispatch_group_owner_offset, dispatch_group_tile_offset,
        dispatch_group_tile_count, token_stride_bytes,
        token_hidden_offset, token_hidden_bytes, hidden_copy_begin,
        pipeline_chunk_begin, pipeline_chunk_end, pipeline_source_chunk,
        token_scale_factor_offset, token_scale_factor_bytes,
        scale_factor_token_stride, scale_factor_pack_stride,
        token_topk_index_offset, token_topk_weight_offset,
        token_source_metadata_offset);
}

struct DirectDispatchProducerRecordKernelArguments {
    __gm__ const std::uint8_t* x;
    __gm__ const std::uint8_t* scale_factors;
    __gm__ const std::int64_t* topk_indices;
    __gm__ const float* topk_weights;
    __gm__ std::uint8_t* communication_buffer;
    __gm__ std::uint8_t* workspace;
    __gm__ std::int32_t* destination_slots;
    std::uintptr_t transport_local_window_base;
    int transport_world_rank, transport_world_size;
    CoreModeFlags mode_flags;
    std::uint32_t use_grouping;
    std::uint64_t num_tokens, num_experts, num_topk, shard_capacity;
    std::uint64_t dispatch_receive_offset, dispatch_receive_shard_bytes;
    std::uint64_t dispatch_staging_offset, dispatch_staging_shard_bytes;
    std::uint64_t workspace_status_offset;
    std::uint64_t dispatch_group_owner_offset, dispatch_group_tile_offset;
    std::uint64_t dispatch_group_tile_count, token_stride_bytes;
    std::uint64_t token_hidden_offset, token_hidden_bytes, hidden_copy_begin;
    std::uint64_t pipeline_chunk_begin, pipeline_chunk_end;
    std::uint32_t pipeline_source_chunk;
    std::uint64_t token_scale_factor_offset, token_scale_factor_bytes;
    std::uint64_t scale_factor_token_stride, scale_factor_pack_stride;
    std::uint64_t token_topk_index_offset, token_topk_weight_offset;
    std::uint64_t token_source_metadata_offset;
    std::uint32_t vf_num_threads;
};

__global__ __vector__ void direct_dispatch_producer_record_kernel(
    DirectDispatchProducerRecordKernelArguments arguments) {
    asc_vf_call<direct_dispatch_producer_record_vf>(
        dim3(arguments.vf_num_threads), arguments.x, arguments.scale_factors,
        arguments.topk_indices, arguments.topk_weights,
        arguments.communication_buffer, arguments.workspace,
        arguments.destination_slots, arguments.transport_local_window_base,
        arguments.transport_world_rank, arguments.transport_world_size,
        arguments.mode_flags, arguments.use_grouping, arguments.num_tokens,
        arguments.num_experts, arguments.num_topk, arguments.shard_capacity,
        arguments.dispatch_receive_offset,
        arguments.dispatch_receive_shard_bytes,
        arguments.dispatch_staging_offset,
        arguments.dispatch_staging_shard_bytes,
        arguments.workspace_status_offset,
        arguments.dispatch_group_owner_offset,
        arguments.dispatch_group_tile_offset,
        arguments.dispatch_group_tile_count, arguments.token_stride_bytes,
        arguments.token_hidden_offset, arguments.token_hidden_bytes,
        arguments.hidden_copy_begin, arguments.pipeline_chunk_begin,
        arguments.pipeline_chunk_end, arguments.pipeline_source_chunk,
        arguments.token_scale_factor_offset,
        arguments.token_scale_factor_bytes,
        arguments.scale_factor_token_stride,
        arguments.scale_factor_pack_stride,
        arguments.token_topk_index_offset,
        arguments.token_topk_weight_offset,
        arguments.token_source_metadata_offset);
}

extern "C" int deep_ep_ascend_launch_direct_dispatch_producer_record(
    const std::uint8_t* x,
    const std::uint8_t* scale_factors,
    const std::int64_t* topk_indices,
    const float* topk_weights,
    std::uint8_t* communication_buffer,
    std::uint8_t* workspace,
    std::int32_t* destination_slots,
    std::uintptr_t transport_local_window_base,
    int transport_world_rank,
    int transport_world_size,
    CoreModeFlags mode_flags,
    std::uint32_t use_grouping,
    std::uint64_t num_tokens,
    std::uint64_t num_experts,
    std::uint64_t num_topk,
    std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t dispatch_group_owner_offset,
    std::uint64_t dispatch_group_tile_offset,
    std::uint64_t dispatch_group_tile_count,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes,
    std::uint64_t hidden_copy_begin,
    std::uint64_t pipeline_chunk_begin,
    std::uint64_t pipeline_chunk_end,
    std::uint32_t pipeline_source_chunk,
    std::uint64_t token_scale_factor_offset,
    std::uint64_t token_scale_factor_bytes,
    std::uint64_t scale_factor_token_stride,
    std::uint64_t scale_factor_pack_stride,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_topk_weight_offset,
    std::uint64_t token_source_metadata_offset,
    void* stream, CoreLaunchShape launch,
    std::uint32_t vf_num_threads) {
    const DirectDispatchProducerRecordKernelArguments arguments{
        x, scale_factors, topk_indices, topk_weights, communication_buffer,
        workspace, destination_slots, transport_local_window_base,
        transport_world_rank, transport_world_size, mode_flags, use_grouping,
        num_tokens, num_experts, num_topk, shard_capacity,
        dispatch_receive_offset, dispatch_receive_shard_bytes,
        dispatch_staging_offset, dispatch_staging_shard_bytes,
        workspace_status_offset, dispatch_group_owner_offset,
        dispatch_group_tile_offset, dispatch_group_tile_count,
        token_stride_bytes, token_hidden_offset, token_hidden_bytes,
        hidden_copy_begin, pipeline_chunk_begin, pipeline_chunk_end,
        pipeline_source_chunk, token_scale_factor_offset,
        token_scale_factor_bytes, scale_factor_token_stride,
        scale_factor_pack_stride, token_topk_index_offset,
        token_topk_weight_offset, token_source_metadata_offset,
        vf_num_threads};
    direct_dispatch_producer_record_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        arguments);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
