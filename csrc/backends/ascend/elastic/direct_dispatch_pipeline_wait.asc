__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_pipeline_wait_vf(
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t dispatch_pipeline_offset,
    std::uint32_t pipeline_chunk_index) {
    if (threadIdx.x != 0)
        return;
    const auto context = make_hybrid_dispatch_context(
        transport_abi_version, transport_struct_size,
        transport_capabilities, transport_local_window_base,
        transport_channel_table, transport_peer_address_table,
        transport_topology_abi_version, transport_topology_struct_size,
        transport_world_rank, transport_world_size,
        transport_scale_up_rank, transport_scale_up_size,
        transport_scale_out_rank, transport_scale_out_size,
        transport_scale_up_direct, transport_topology_kind,
        transport_topology_epoch, transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
        workspace + dispatch_pipeline_offset);
    auto* slot = &pipeline->slots[
        pipeline_chunk_index % kDispatchPipelineSlotCount];
    transport.wait(&slot->request);
    if (slot->request.state == transport::DeviceRequestState::kCompleted) {
        transport::simt::store_published(
            reinterpret_cast<__gm__ std::uint32_t*>(&slot->state),
            static_cast<std::uint32_t>(
                DispatchPipelineSlotState::kCompleted));
        const auto completed_chunks = transport::simt::load_observed(
            &pipeline->completed_chunks);
        transport::simt::store_published(
            &pipeline->completed_chunks, completed_chunks + 1U);
        return;
    }
    transport::simt::store_published(
        reinterpret_cast<__gm__ std::uint32_t*>(&slot->state),
        static_cast<std::uint32_t>(DispatchPipelineSlotState::kFailed));
    transport::simt::store_published(
        reinterpret_cast<__gm__ std::uint32_t*>(
            &pipeline->terminal_error),
        static_cast<std::uint32_t>(slot->request.terminal_error));
}

struct DirectDispatchPipelineWaitKernelArguments {
    __gm__ std::uint8_t* workspace;
    std::uint32_t transport_abi_version;
    std::uint32_t transport_struct_size;
    std::uint64_t transport_capabilities;
    std::uintptr_t transport_local_window_base;
    std::uintptr_t transport_channel_table;
    std::uintptr_t transport_peer_address_table;
    std::uint32_t transport_topology_abi_version;
    std::uint32_t transport_topology_struct_size;
    int transport_world_rank;
    int transport_world_size;
    int transport_scale_up_rank;
    int transport_scale_up_size;
    int transport_scale_out_rank;
    int transport_scale_out_size;
    std::uint32_t transport_scale_up_direct;
    std::uint32_t transport_topology_kind;
    std::uint64_t transport_topology_epoch;
    std::uintptr_t transport_backend_context;
    std::uint64_t dispatch_pipeline_offset;
    std::uint32_t pipeline_chunk_index;
    std::uint32_t vf_num_threads;
};

__global__ __vector__ void direct_dispatch_pipeline_wait_kernel(
    DirectDispatchPipelineWaitKernelArguments arguments) {
    asc_vf_call<direct_dispatch_pipeline_wait_vf> (
        dim3(arguments.vf_num_threads), arguments.workspace, arguments.transport_abi_version, arguments.transport_struct_size, arguments.transport_capabilities, arguments.transport_local_window_base, arguments.transport_channel_table, arguments.transport_peer_address_table, arguments.transport_topology_abi_version, arguments.transport_topology_struct_size, arguments.transport_world_rank, arguments.transport_world_size, arguments.transport_scale_up_rank, arguments.transport_scale_up_size, arguments.transport_scale_out_rank, arguments.transport_scale_out_size, arguments.transport_scale_up_direct, arguments.transport_topology_kind, arguments.transport_topology_epoch, arguments.transport_backend_context, arguments.dispatch_pipeline_offset, arguments.pipeline_chunk_index);
}

extern "C" int deep_ep_ascend_launch_direct_dispatch_pipeline_wait(
    std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank,
    int transport_world_size,
    int transport_scale_up_rank,
    int transport_scale_up_size,
    int transport_scale_out_rank,
    int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t dispatch_pipeline_offset,
    std::uint32_t pipeline_chunk_index,
    void* stream, CoreLaunchShape launch,
    std::uint32_t vf_num_threads) {
    const DirectDispatchPipelineWaitKernelArguments arguments{
        workspace,
        transport_abi_version,
        transport_struct_size,
        transport_capabilities,
        transport_local_window_base,
        transport_channel_table,
        transport_peer_address_table,
        transport_topology_abi_version,
        transport_topology_struct_size,
        transport_world_rank,
        transport_world_size,
        transport_scale_up_rank,
        transport_scale_up_size,
        transport_scale_out_rank,
        transport_scale_out_size,
        transport_scale_up_direct,
        transport_topology_kind,
        transport_topology_epoch,
        transport_backend_context,
        dispatch_pipeline_offset,
        pipeline_chunk_index,
        vf_num_threads};
    direct_dispatch_pipeline_wait_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(arguments);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
