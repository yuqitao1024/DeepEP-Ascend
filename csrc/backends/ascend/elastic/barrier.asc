#include <cstdint>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"

#include "kernels.hpp"

#define DEEP_EP_ASCEND_SIMT_DEVICE 1
#include "../transport/aicore_transport_service.hpp"
#include "../transport/device_transport_facade.hpp"

namespace deep_ep::ascend::elastic {

__simt_vf__ inline void barrier_producer_vf(
    BarrierArguments arguments, CoreTiling tiling) {
    if (threadIdx.x != 0)
        return;
    auto* control = reinterpret_cast<__gm__ SymmetricControlHeader*>(
        tiling.transport_context.local_window_base +
        tiling.symmetric_window_layout.control_offset);
    transport::DeviceTransportFacade transport(
        tiling.transport_context, 0);
    const auto generation_address =
        reinterpret_cast<transport::DeviceAddress>(
            &control->barrier_generation[tiling.topology.world_rank]);
    transport.store_release(generation_address, arguments.generation);
    transport.system_fence();
    transport.device_barrier(1, generation_address, 0);
}

__simt_vf__ inline void barrier_continuation_vf(
    BarrierArguments arguments, CoreTiling tiling) {
    if (threadIdx.x != 0)
        return;
    transport::DeviceTransportFacade transport(
        tiling.transport_context, 0);
    if (transport.consumed_generation() != arguments.generation)
        return;
    auto* control = reinterpret_cast<__gm__ SymmetricControlHeader*>(
        tiling.transport_context.local_window_base +
        tiling.symmetric_window_layout.control_offset);
    const auto completion_address =
        reinterpret_cast<transport::DeviceAddress>(
            &control->barrier_completion[tiling.topology.world_rank]);
    transport.store_release(completion_address, arguments.generation);
}

__global__ __vector__ void barrier_kernel(
    BarrierArguments arguments, CoreTiling tiling) {
    transport::service::reset(
        tiling.transport_context, arguments.generation);
    asc_vf_call<barrier_producer_vf>(
        dim3(tiling.launch.num_threads), arguments, tiling);
    transport::service::execute(tiling.transport_context);
    asc_vf_call<barrier_continuation_vf>(
        dim3(tiling.launch.num_threads), arguments, tiling);
}

}  // namespace deep_ep::ascend::elastic

extern "C" int deep_ep_ascend_launch_barrier(
    deep_ep::ascend::elastic::BarrierArguments arguments,
    deep_ep::ascend::elastic::CoreTiling tiling, void* stream) {
    deep_ep::ascend::elastic::barrier_kernel<<<
        tiling.launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        arguments, tiling);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}
