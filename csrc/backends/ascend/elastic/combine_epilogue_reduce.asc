#include <cstdint>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"

#define DEEP_EP_ASCEND_SIMT_DEVICE 1
#define DEEP_EP_ASCEND_TOPK_GROUPING_DEVICE 1
#include "kernels.hpp"
#include "combine_state.hpp"
#include "topk_grouping.hpp"
#include "../transport/device_transport_facade.hpp"

namespace deep_ep::ascend::elastic {

#include "combine_device_helpers.hpp"

DEEP_EP_ASCEND_SIMT_CALLEE std::uint32_t topk_compact_owner_ordinal(
    TopkSubgroupMask owner_mask, std::int32_t key) {
    std::uint32_t ordinal = 0;
    TopkSubgroupMask remaining = owner_mask;
    while (remaining != 0) {
        const std::int32_t owner_lane = topk_first_set_lane(remaining);
        const std::int32_t owner_key = asc_shfl(
            key, static_cast<std::uint32_t>(owner_lane),
            kTopkSubgroupWidth);
        if (owner_key < key)
            ++ordinal;
        remaining &= ~(TopkSubgroupMask{1} <<
                       static_cast<std::uint32_t>(owner_lane));
    }
    return ordinal;
}

__simt_vf__ __launch_bounds__(512) inline void direct_combine_epilogue_reduce_vf(
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ const bfloat16_t* bias_0,
    __gm__ const bfloat16_t* bias_1,
    __gm__ std::uint8_t* workspace,
    __gm__ bfloat16_t* combined_x,
    std::uintptr_t local_window_base,
    int world_size, std::uint64_t num_tokens,
    std::uint64_t num_experts, std::uint64_t num_topk,
    std::uint64_t combine_record_bytes,
    std::uint64_t combine_receive_offset,
    std::uint64_t combine_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t slot_offset,
    std::uint64_t hidden_elements) {
    if (!combine_direct_status_is_clean(
            workspace, workspace_status_offset))
        return;
    const std::uint32_t num_tokens_u32 =
        static_cast<std::uint32_t>(num_tokens);
    const std::uint32_t num_experts_u32 =
        static_cast<std::uint32_t>(num_experts);
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t hidden_elements_u32 =
        static_cast<std::uint32_t>(hidden_elements);
    auto* slots = reinterpret_cast<__gm__ std::int32_t*>(
        workspace + slot_offset);
    const std::uint32_t local_experts =
        num_experts_u32 / static_cast<std::uint32_t>(world_size);

    if (num_topk_u32 > kTopkSubgroupWidth) {
        const auto grid = direct_data_grid_stride(
            blockIdx.x, threadIdx.x, gridDim.x, blockDim.x);
        for (std::uint32_t token = grid.first; token < num_tokens_u32;
             token += grid.stride) {
            const std::uint64_t token_base =
                static_cast<std::uint64_t>(token) * num_topk_u32;
            for (int contributor_rank = 0;
                 contributor_rank < world_size; ++contributor_rank) {
                std::int32_t owner_lane = -1;
                for (std::uint32_t lane = 0;
                     lane < num_topk_u32; ++lane) {
                    const std::int64_t expert =
                        combined_topk_indices[token_base + lane];
                    if (expert >= 0 &&
                        static_cast<std::uint64_t>(expert) <
                            num_experts_u32 &&
                        static_cast<std::uint64_t>(expert) / local_experts ==
                            static_cast<std::uint64_t>(contributor_rank)) {
                        owner_lane = static_cast<std::int32_t>(lane);
                        break;
                    }
                }
                const std::int32_t owner_slot = owner_lane < 0 ? -1 :
                    slots[token_base +
                          static_cast<std::uint64_t>(owner_lane)];
                for (std::uint32_t lane = 0;
                     lane < num_topk_u32; ++lane) {
                    const std::int64_t expert =
                        combined_topk_indices[token_base + lane];
                    if (expert >= 0 &&
                        static_cast<std::uint64_t>(expert) <
                            num_experts_u32 &&
                        static_cast<std::uint64_t>(expert) / local_experts ==
                            static_cast<std::uint64_t>(contributor_rank))
                        slots[token_base + lane] = owner_slot;
                }
            }
            for (std::uint32_t hidden = 0;
                 hidden < hidden_elements_u32;
                 ++hidden) {
                float value = 0.0F;
                for (int contributor_rank = 0;
                     contributor_rank < world_size; ++contributor_rank) {
                    std::int32_t receive_slot = -1;
                    for (std::uint32_t lane = 0;
                         lane < num_topk_u32; ++lane) {
                        const std::int64_t expert =
                            combined_topk_indices[token_base + lane];
                        if (expert >= 0 &&
                            static_cast<std::uint64_t>(expert) <
                                num_experts_u32 &&
                            static_cast<std::uint64_t>(expert) / local_experts ==
                                static_cast<std::uint64_t>(contributor_rank)) {
                            receive_slot = slots[token_base + lane];
                            break;
                        }
                    }
                    if (receive_slot < 0)
                        continue;
                    auto* shard = reinterpret_cast<
                        __gm__ const std::uint8_t*>(
                            combine_receive_shard_address(
                                local_window_base, combine_receive_offset,
                                static_cast<std::uint64_t>(contributor_rank),
                                combine_receive_shard_bytes));
                    auto* payload = reinterpret_cast<
                        __gm__ const bfloat16_t*>(
                            shard + static_cast<std::uint64_t>(receive_slot) *
                                combine_record_bytes);
                    value += static_cast<float>(payload[hidden]);
                }
                const std::uint64_t logical =
                    static_cast<std::uint64_t>(token) *
                        hidden_elements_u32 + hidden;
                if (bias_0 != nullptr)
                    value += static_cast<float>(bias_0[logical]);
                if (bias_1 != nullptr)
                    value += static_cast<float>(bias_1[logical]);
                combined_x[logical] = static_cast<bfloat16_t>(value);
            }
        }
        return;
    }

    const auto work = direct_subgroup_grid_stride(
        blockIdx.x, threadIdx.x, gridDim.x, blockDim.x,
        kTopkSubgroupWidth);
    std::int32_t contributor_ranks[kTopkSubgroupWidth];
    std::int32_t receive_slots[kTopkSubgroupWidth];
    for (std::uint32_t token = work.first; token < num_tokens_u32;
         token += work.stride) {
        const bool logical = work.lane < num_topk_u32;
        const std::uint32_t logical_index =
            token * num_topk_u32 + work.lane;
        const std::int64_t expert = logical ?
            combined_topk_indices[logical_index] : -1;
        const bool active = logical && expert >= 0 &&
            static_cast<std::uint64_t>(expert) < num_experts_u32;
        const std::int32_t contributor_key = active ?
            static_cast<std::int32_t>(
                static_cast<std::uint64_t>(expert) / local_experts) : -1;
        const auto group = group_topk_subgroup(contributor_key, active);
        const std::int32_t observed_slot = active ?
            slots[logical_index] : -1;
        const std::int32_t resolved_slot = topk_broadcast_owner_value(
            group, observed_slot, -1);
        const TopkSubgroupMask entry_owner_mask =
            static_cast<TopkSubgroupMask>(asc_ballot(
                group.is_owner && resolved_slot >= 0 ? 1 : 0));
        const std::uint32_t contributor_count =
            static_cast<std::uint32_t>(__popc(entry_owner_mask));
        if (logical)
            slots[logical_index] = resolved_slot;

        const std::uint32_t owner_ordinal = topk_compact_owner_ordinal(
            entry_owner_mask, contributor_key);
        TopkSubgroupMask remaining_owners = entry_owner_mask;
        while (remaining_owners != 0) {
            const std::int32_t owner_lane =
                topk_first_set_lane(remaining_owners);
            const std::uint32_t broadcast_ordinal = asc_shfl(
                owner_ordinal, static_cast<std::uint32_t>(owner_lane),
                kTopkSubgroupWidth);
            const std::int32_t broadcast_rank = asc_shfl(
                contributor_key, static_cast<std::uint32_t>(owner_lane),
                kTopkSubgroupWidth);
            const std::int32_t broadcast_slot = asc_shfl(
                resolved_slot, static_cast<std::uint32_t>(owner_lane),
                kTopkSubgroupWidth);
            contributor_ranks[broadcast_ordinal] = broadcast_rank;
            receive_slots[broadcast_ordinal] = broadcast_slot;
            remaining_owners &= ~(
                TopkSubgroupMask{1} <<
                static_cast<std::uint32_t>(owner_lane));
        }
        for (std::uint32_t hidden = work.lane;
             hidden < hidden_elements_u32;
             hidden += kTopkSubgroupWidth) {
            float value = 0.0F;
            for (std::uint32_t contributor_index = 0;
                 contributor_index < contributor_count;
                 ++contributor_index) {
                auto* shard = reinterpret_cast<
                    __gm__ const std::uint8_t*>(
                        combine_receive_shard_address(
                            local_window_base, combine_receive_offset,
                            static_cast<std::uint64_t>(
                                contributor_ranks[contributor_index]),
                            combine_receive_shard_bytes));
                auto* payload = reinterpret_cast<
                    __gm__ const bfloat16_t*>(
                        shard + static_cast<std::uint64_t>(
                            receive_slots[contributor_index]) *
                            combine_record_bytes);
                value += static_cast<float>(payload[hidden]);
            }
            const std::uint64_t logical =
                static_cast<std::uint64_t>(token) * hidden_elements_u32 +
                hidden;
            if (bias_0 != nullptr)
                value += static_cast<float>(bias_0[logical]);
            if (bias_1 != nullptr)
                value += static_cast<float>(bias_1[logical]);
            combined_x[logical] = static_cast<bfloat16_t>(value);
        }
    }
}

__global__ __vector__ void combine_epilogue_reduce_kernel(
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ const std::uint16_t* bias_0,
    __gm__ const std::uint16_t* bias_1,
    __gm__ std::uint8_t* workspace,
    __gm__ std::uint16_t* combined_x,
    std::uintptr_t local_window_base, CoreTiling tiling) {
    asc_vf_call<direct_combine_epilogue_reduce_vf>(
        dim3(tiling.launch.num_threads), combined_topk_indices,
        reinterpret_cast<__gm__ const bfloat16_t*>(bias_0),
        reinterpret_cast<__gm__ const bfloat16_t*>(bias_1),
        workspace, reinterpret_cast<__gm__ bfloat16_t*>(combined_x),
        local_window_base,
        tiling.transport_context.topology.world_size,
        tiling.num_tokens, tiling.num_experts, tiling.num_topk,
        tiling.symmetric_window_layout.combine_record_bytes,
        tiling.symmetric_window_layout.combine_receive_offset,
        tiling.symmetric_window_layout.combine_receive_shard_bytes,
        tiling.workspace_layout.scratch_status_offset,
        tiling.workspace_layout.slot_offset, tiling.hidden);
}

}  // namespace deep_ep::ascend::elastic

extern "C" int deep_ep_ascend_launch_combine_epilogue_reduce(
    deep_ep::ascend::elastic::CombineArguments arguments,
    deep_ep::ascend::elastic::CoreTiling tiling, void* stream,
    deep_ep::ascend::elastic::CoreLaunchShape launch) {
    using namespace deep_ep::ascend::elastic;
    combine_epilogue_reduce_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        arguments.combined_topk_indices,
        static_cast<const std::uint16_t*>(arguments.bias_0),
        static_cast<const std::uint16_t*>(arguments.bias_1),
        static_cast<std::uint8_t*>(arguments.workspace),
        static_cast<std::uint16_t*>(arguments.combined_x),
        arguments.local_window_base, tiling);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}
