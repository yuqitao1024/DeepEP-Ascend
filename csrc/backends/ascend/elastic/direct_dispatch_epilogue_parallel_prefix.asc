__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_epilogue_parallel_prefix_vf(
    __gm__ std::uint8_t* workspace,
    __gm__ std::int32_t* prefix_per_rank,
    __gm__ std::int32_t* prefix_per_expert,
    __gm__ std::int32_t* unaligned_per_expert,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t num_experts,
    std::uint64_t expert_alignment,
    std::uint64_t dispatch_output_capacity,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t dispatch_expert_tile_count_offset,
    std::uint64_t dispatch_expert_tile_count) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    auto* source_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* tile_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_expert_tile_count_offset);
    const auto worker_plan = dispatch_simt_expert_prefix_worker_plan(
        num_experts, static_cast<std::uint64_t>(transport_world_size),
        static_cast<std::uint64_t>(blockDim.x));
    const bool ready = worker_plan.valid &&
        transport::simt::load_observed(status) == 0;
    const std::uint32_t local_expert = threadIdx.x;
    const std::uint32_t tile_count_u32 =
        static_cast<std::uint32_t>(dispatch_expert_tile_count);
    const std::uint32_t first_local_expert =
        static_cast<std::uint32_t>(transport_world_rank) *
        worker_plan.local_experts;
    if (ready && local_expert < worker_plan.active_threads) {
        std::uint64_t prefix = 0;
        for (std::uint32_t tile = 0; tile < tile_count_u32; ++tile) {
            const std::uint64_t index =
                static_cast<std::uint64_t>(tile) *
                    worker_plan.local_experts +
                local_expert;
            const std::uint64_t count = tile_counts[index];
            tile_counts[index] = prefix;
            prefix += count;
        }
        const std::uint32_t expert = first_local_expert + local_expert;
        unaligned_per_expert[expert] = static_cast<std::int32_t>(prefix);
    }
    asc_threadfence_block();
    asc_syncthreads();
    if (threadIdx.x != 0)
        return;
    if (!ready)
        return;

    const auto context = make_hybrid_dispatch_context(
        transport_abi_version, transport_struct_size,
        transport_capabilities, transport_local_window_base,
        transport_channel_table, transport_peer_address_table,
        transport_topology_abi_version, transport_topology_struct_size,
        transport_world_rank, transport_world_size,
        transport_scale_up_rank, transport_scale_up_size,
        transport_scale_out_rank, transport_scale_out_size,
        transport_scale_up_direct, transport_topology_kind,
        transport_topology_epoch, transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);

    std::uint64_t rank_prefix = 0;
    for (int source_rank = 0;
         source_rank < transport_world_size; ++source_rank) {
        rank_prefix += source_counts[source_rank];
        prefix_per_rank[source_rank] =
            static_cast<std::int32_t>(rank_prefix);
    }

    const std::uint32_t num_experts_u32 =
        static_cast<std::uint32_t>(num_experts);
    std::uint64_t derived_prefix = 0;
    for (std::uint32_t expert = 0; expert < num_experts_u32; ++expert) {
        const bool local =
            expert >= first_local_expert &&
            expert < first_local_expert + worker_plan.local_experts;
        const std::uint64_t actual_count = local ?
            static_cast<std::uint32_t>(unaligned_per_expert[expert]) : 0;
        if (!local)
            unaligned_per_expert[expert] = 0;
        prefix_per_expert[expert] =
            static_cast<std::int32_t>(derived_prefix);
        const std::uint64_t aligned_count =
            ((actual_count + expert_alignment - 1) / expert_alignment) *
            expert_alignment;
        derived_prefix += aligned_count;
        if (derived_prefix > dispatch_output_capacity ||
            derived_prefix > static_cast<std::uint64_t>(0x7fffffff)) {
            record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolStage::kEpilogue, generation,
                DispatchProtocolError::kCapacityOverflow);
            return;
        }
    }
    prefix_per_expert[num_experts] =
        static_cast<std::int32_t>(derived_prefix);
}

struct DirectDispatchEpilogueParallelPrefixKernelArguments {
    __gm__ std::uint8_t* workspace;
    __gm__ std::int32_t* prefix_per_rank;
    __gm__ std::int32_t* prefix_per_expert;
    __gm__ std::int32_t* unaligned_per_expert;
    std::uint32_t transport_abi_version;
    std::uint32_t transport_struct_size;
    std::uint64_t transport_capabilities;
    std::uintptr_t transport_local_window_base;
    std::uintptr_t transport_channel_table;
    std::uintptr_t transport_peer_address_table;
    std::uint32_t transport_topology_abi_version;
    std::uint32_t transport_topology_struct_size;
    int transport_world_rank;
    int transport_world_size;
    int transport_scale_up_rank;
    int transport_scale_up_size;
    int transport_scale_out_rank;
    int transport_scale_out_size;
    std::uint32_t transport_scale_up_direct;
    std::uint32_t transport_topology_kind;
    std::uint64_t transport_topology_epoch;
    std::uintptr_t transport_backend_context;
    std::uint64_t generation;
    std::uint64_t num_experts;
    std::uint64_t expert_alignment;
    std::uint64_t dispatch_output_capacity;
    std::uint64_t workspace_status_offset;
    std::uint64_t workspace_rank_counts_offset;
    std::uint64_t dispatch_expert_tile_count_offset;
    std::uint64_t dispatch_expert_tile_count;
    std::uint32_t vf_num_threads;
};

__global__ __vector__ void direct_dispatch_epilogue_parallel_prefix_kernel(
    DirectDispatchEpilogueParallelPrefixKernelArguments arguments) {
    asc_vf_call<direct_dispatch_epilogue_parallel_prefix_vf> (
        dim3(arguments.vf_num_threads), arguments.workspace, arguments.prefix_per_rank, arguments.prefix_per_expert, arguments.unaligned_per_expert, arguments.transport_abi_version, arguments.transport_struct_size, arguments.transport_capabilities, arguments.transport_local_window_base, arguments.transport_channel_table, arguments.transport_peer_address_table, arguments.transport_topology_abi_version, arguments.transport_topology_struct_size, arguments.transport_world_rank, arguments.transport_world_size, arguments.transport_scale_up_rank, arguments.transport_scale_up_size, arguments.transport_scale_out_rank, arguments.transport_scale_out_size, arguments.transport_scale_up_direct, arguments.transport_topology_kind, arguments.transport_topology_epoch, arguments.transport_backend_context, arguments.generation, arguments.num_experts, arguments.expert_alignment, arguments.dispatch_output_capacity, arguments.workspace_status_offset, arguments.workspace_rank_counts_offset, arguments.dispatch_expert_tile_count_offset, arguments.dispatch_expert_tile_count);
}

extern "C" int deep_ep_ascend_launch_direct_dispatch_epilogue_parallel_prefix(
    std::uint8_t* workspace,
    std::int32_t* prefix_per_rank,
    std::int32_t* prefix_per_expert,
    std::int32_t* unaligned_per_expert,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank,
    int transport_world_size,
    int transport_scale_up_rank,
    int transport_scale_up_size,
    int transport_scale_out_rank,
    int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation,
    std::uint64_t num_experts,
    std::uint64_t expert_alignment,
    std::uint64_t dispatch_output_capacity,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t dispatch_expert_tile_count_offset,
    std::uint64_t dispatch_expert_tile_count,
    void* stream, CoreLaunchShape launch,
    std::uint32_t vf_num_threads) {
    const DirectDispatchEpilogueParallelPrefixKernelArguments arguments{
        workspace,
        prefix_per_rank,
        prefix_per_expert,
        unaligned_per_expert,
        transport_abi_version,
        transport_struct_size,
        transport_capabilities,
        transport_local_window_base,
        transport_channel_table,
        transport_peer_address_table,
        transport_topology_abi_version,
        transport_topology_struct_size,
        transport_world_rank,
        transport_world_size,
        transport_scale_up_rank,
        transport_scale_up_size,
        transport_scale_out_rank,
        transport_scale_out_size,
        transport_scale_up_direct,
        transport_topology_kind,
        transport_topology_epoch,
        transport_backend_context,
        generation,
        num_experts,
        expert_alignment,
        dispatch_output_capacity,
        workspace_status_offset,
        workspace_rank_counts_offset,
        dispatch_expert_tile_count_offset,
        dispatch_expert_tile_count,
        vf_num_threads};
    direct_dispatch_epilogue_parallel_prefix_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(arguments);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
