__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_persistent_producer_vf(
    __gm__ const std::uint8_t* x,
    __gm__ const std::uint8_t* scale_factors,
    __gm__ const std::int64_t* topk_indices,
    __gm__ const float* topk_weights,
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ std::int32_t* destination_slots,
    std::uintptr_t transport_local_window_base,
    int transport_world_rank, int transport_world_size,
    CoreModeFlags mode_flags, std::uint32_t use_grouping,
    std::uint64_t num_tokens, std::uint64_t num_experts,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t dispatch_group_owner_offset,
    std::uint64_t dispatch_group_tile_offset,
    std::uint64_t dispatch_group_tile_count,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes,
    std::uint64_t hidden_copy_begin,
    std::uint32_t source_chunk_tiles,
    std::uint32_t source_chunk_count,
    std::uint64_t token_scale_factor_offset,
    std::uint64_t token_scale_factor_bytes,
    std::uint64_t scale_factor_token_stride,
    std::uint64_t scale_factor_pack_stride,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_topk_weight_offset,
    std::uint64_t token_source_metadata_offset,
    std::uint64_t generation, std::uint64_t timeout_cycles) {
    auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
        workspace + dispatch_pipeline_offset);
    const std::uint32_t producer_blocks = gridDim.x;
    if (producer_blocks == 0 ||
        producer_blocks > kDispatchPipelineMaximumProducerBlocks)
        return;

    const std::uint64_t generation_wait_start = __asc_simt_vf::clock();
    while (transport::simt::load_observed(&pipeline->generation) !=
           generation) {
        dispatch_simt_poll_nop();
        if (static_cast<transport::DeviceTransportError>(
                transport::simt::load_observed(
                    reinterpret_cast<__gm__ std::uint32_t*>(
                        &pipeline->terminal_error))) !=
            transport::DeviceTransportError::kNone)
            return;
        if (threadIdx.x == 0 &&
            dispatch_simt_pipeline_wait_timed_out(
                generation_wait_start, __asc_simt_vf::clock(),
                timeout_cycles)) {
            direct_dispatch_pipeline_fail_simt(
                pipeline, nullptr, workspace, workspace_status_offset,
                transport_world_rank, generation, blockIdx.x << 16U);
            return;
        }
    }

    for (std::uint32_t source_chunk = 0;
         source_chunk < source_chunk_count; ++source_chunk) {
        const std::uint32_t source_tile_begin =
            source_chunk * source_chunk_tiles;
        const std::uint32_t source_tile_end =
            source_tile_begin + source_chunk_tiles <
                    dispatch_group_tile_count ?
                source_tile_begin + source_chunk_tiles :
                static_cast<std::uint32_t>(dispatch_group_tile_count);
        auto* slot = &pipeline->slots[
            dispatch_simt_pipeline_slot(source_chunk)];
        if (blockIdx.x == 0 && threadIdx.x == 0) {
            if (dispatch_simt_pipeline_producer_must_wait_for_reuse(
                    source_chunk)) {
                const std::uint64_t wait_start = __asc_simt_vf::clock();
                while (true) {
                    dispatch_simt_poll_nop();
                    const auto state = static_cast<DispatchPipelineSlotState>(
                        transport::simt::load_observed(
                            reinterpret_cast<__gm__ std::uint32_t*>(
                                &slot->state)));
                    const std::uint32_t published_chunk =
                        transport::simt::load_observed(
                            &slot->published_chunk);
                    const bool reusable =
                        state == DispatchPipelineSlotState::kCompleted &&
                        published_chunk <=
                            UINT32_MAX - kDispatchPipelineSlotCount &&
                        published_chunk + kDispatchPipelineSlotCount ==
                            source_chunk;
                    if (reusable)
                        break;
                    if (state == DispatchPipelineSlotState::kFailed)
                        return;
                    if (dispatch_simt_pipeline_wait_timed_out(
                            wait_start, __asc_simt_vf::clock(),
                            timeout_cycles)) {
                        direct_dispatch_pipeline_fail_simt(
                            pipeline, slot, workspace,
                            workspace_status_offset, transport_world_rank,
                            generation, source_chunk);
                        return;
                    }
                }
            }
            slot->chunk_begin = source_tile_begin;
            slot->chunk_end = source_tile_end;
            slot->chunk_index = source_chunk;
            slot->scalar_blocks_completed = 0;
            slot->hidden_blocks_completed = 0;
            slot->published_chunk = source_chunk;
            transport::simt::system_fence();
            transport::simt::store_published(
                reinterpret_cast<__gm__ std::uint32_t*>(&slot->state),
                static_cast<std::uint32_t>(
                    DispatchPipelineSlotState::kProducing));
        }
        direct_dispatch_producer_record_body(
            x, scale_factors, topk_indices, topk_weights,
            communication_buffer, workspace, destination_slots,
            transport_local_window_base, transport_world_rank,
            transport_world_size,
            mode_flags, use_grouping, num_tokens,
            num_experts, num_topk, shard_capacity, dispatch_receive_offset,
            dispatch_receive_shard_bytes, dispatch_staging_offset,
            dispatch_staging_shard_bytes, workspace_status_offset,
            dispatch_group_owner_offset, dispatch_group_tile_offset,
            dispatch_group_tile_count, token_stride_bytes,
            token_hidden_offset, token_hidden_bytes, hidden_copy_begin,
            source_tile_begin, source_tile_end, 1U,
            token_scale_factor_offset, token_scale_factor_bytes,
            scale_factor_token_stride, scale_factor_pack_stride,
            token_topk_index_offset, token_topk_weight_offset,
            token_source_metadata_offset);

        asc_syncthreads();
        if (threadIdx.x == 0) {
            auto* progress =
                &pipeline->scalar_progress[blockIdx.x][source_chunk];
            transport::simt::system_fence();
            transport::simt::store_published(
                &progress->generation, generation);
            transport::simt::system_fence();
        }
        // asc_vf_call does not run concurrently with the enclosing AICore
        // function.  Waiting for kReady here would therefore prevent the
        // manager from publishing kReady.  The per-chunk progress record is
        // retained until the manager consumes it after this VF returns.
    }
    if (blockIdx.x == 0 && threadIdx.x == 0) {
        if (static_cast<DispatchPipelineWorkerState>(
                transport::simt::load_observed(
                    reinterpret_cast<__gm__ std::uint32_t*>(
                        &pipeline->producer_worker_state))) ==
            DispatchPipelineWorkerState::kFailed)
            return;
        transport::simt::system_fence();
        transport::simt::store_published(
            &pipeline->producer_completed_generation, generation);
        transport::simt::store_published(
            reinterpret_cast<__gm__ std::uint32_t*>(
                &pipeline->producer_worker_state),
            static_cast<std::uint32_t>(
                DispatchPipelineWorkerState::kCompleted));
    }
}

__global__ __vector__ void direct_dispatch_persistent_producer_kernel(
    __gm__ const std::uint8_t* x,
    __gm__ const std::uint8_t* scale_factors,
    __gm__ const std::int64_t* topk_indices,
    __gm__ const float* topk_weights,
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    __gm__ std::int32_t* destination_slots,
    std::uintptr_t transport_local_window_base,
    int transport_world_rank, int transport_world_size,
    CoreModeFlags mode_flags, std::uint32_t use_grouping,
    std::uint64_t num_tokens, std::uint64_t num_experts,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t dispatch_group_owner_offset,
    std::uint64_t dispatch_group_tile_offset,
    std::uint64_t dispatch_group_tile_count,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes,
    std::uint64_t hidden_copy_begin,
    std::uint32_t source_chunk_tiles,
    std::uint32_t source_chunk_count,
    std::uint64_t token_scale_factor_offset,
    std::uint64_t token_scale_factor_bytes,
    std::uint64_t scale_factor_token_stride,
    std::uint64_t scale_factor_pack_stride,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_topk_weight_offset,
    std::uint64_t token_source_metadata_offset,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint32_t vf_num_threads) {
    asc_vf_call<direct_dispatch_persistent_producer_vf>(
        dim3(vf_num_threads), x, scale_factors, topk_indices, topk_weights, communication_buffer, workspace, destination_slots, transport_local_window_base, transport_world_rank, transport_world_size, mode_flags, use_grouping, num_tokens, num_experts, num_topk, shard_capacity, dispatch_receive_offset, dispatch_receive_shard_bytes, dispatch_staging_offset, dispatch_staging_shard_bytes, workspace_status_offset, dispatch_group_owner_offset, dispatch_group_tile_offset, dispatch_group_tile_count, dispatch_pipeline_offset, token_stride_bytes, token_hidden_offset, token_hidden_bytes, hidden_copy_begin, source_chunk_tiles, source_chunk_count, token_scale_factor_offset, token_scale_factor_bytes, scale_factor_token_stride, scale_factor_pack_stride, token_topk_index_offset, token_topk_weight_offset, token_source_metadata_offset, generation, timeout_cycles);
}

extern "C" int deep_ep_ascend_launch_direct_dispatch_persistent_producer(
    const std::uint8_t* x,
    const std::uint8_t* scale_factors,
    const std::int64_t* topk_indices,
    const float* topk_weights,
    std::uint8_t* communication_buffer,
    std::uint8_t* workspace,
    std::int32_t* destination_slots,
    std::uintptr_t transport_local_window_base,
    int transport_world_rank,
    int transport_world_size,
    CoreModeFlags mode_flags,
    std::uint32_t use_grouping,
    std::uint64_t num_tokens,
    std::uint64_t num_experts,
    std::uint64_t num_topk,
    std::uint64_t shard_capacity,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t dispatch_group_owner_offset,
    std::uint64_t dispatch_group_tile_offset,
    std::uint64_t dispatch_group_tile_count,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t token_stride_bytes,
    std::uint64_t token_hidden_offset,
    std::uint64_t token_hidden_bytes,
    std::uint64_t hidden_copy_begin,
    std::uint32_t source_chunk_tiles,
    std::uint32_t source_chunk_count,
    std::uint64_t token_scale_factor_offset,
    std::uint64_t token_scale_factor_bytes,
    std::uint64_t scale_factor_token_stride,
    std::uint64_t scale_factor_pack_stride,
    std::uint64_t token_topk_index_offset,
    std::uint64_t token_topk_weight_offset,
    std::uint64_t token_source_metadata_offset,
    std::uint64_t generation,
    std::uint64_t timeout_cycles,
    void* stream, CoreLaunchShape launch,
    std::uint32_t vf_num_threads) {
    direct_dispatch_persistent_producer_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        x, scale_factors, topk_indices, topk_weights, communication_buffer, workspace, destination_slots, transport_local_window_base, transport_world_rank, transport_world_size, mode_flags, use_grouping, num_tokens, num_experts, num_topk, shard_capacity, dispatch_receive_offset, dispatch_receive_shard_bytes, dispatch_staging_offset, dispatch_staging_shard_bytes, workspace_status_offset, dispatch_group_owner_offset, dispatch_group_tile_offset, dispatch_group_tile_count, dispatch_pipeline_offset, token_stride_bytes, token_hidden_offset, token_hidden_bytes, hidden_copy_begin, source_chunk_tiles, source_chunk_count, token_scale_factor_offset, token_scale_factor_bytes, scale_factor_token_stride, scale_factor_pack_stride, token_topk_index_offset, token_topk_weight_offset, token_source_metadata_offset, generation, timeout_cycles, vf_num_threads);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
