#include <cstdint>

#include "acl/acl.h"
#include "c_api/sync/sync.h"
#include "kernel_operator.h"
#include "simt_api/asc_bf16.h"
#include "simt_api/asc_simt.h"
#include "simt_api/device_atomic_functions.h"
#include "simt_api/device_sync_functions.h"
#include "simt_api/device_warp_functions.h"

#define DEEP_EP_ASCEND_SIMT_DEVICE 1
#define DEEP_EP_ASCEND_TOPK_GROUPING_DEVICE 1
#define DEEP_EP_ASCEND_ELASTIC_AICORE_CALLEE __aicore__ inline
#include "kernels.hpp"
#undef DEEP_EP_ASCEND_ELASTIC_AICORE_CALLEE
#include "topk_grouping.hpp"

#include "combine_parallel.hpp"
#include "combine_state.hpp"
#include "release_protocol.hpp"
#include "../transport/aicore_transport_service.hpp"
#include "../transport/device_transport_facade.hpp"

namespace deep_ep::ascend::elastic {

#include "combine_device_helpers.hpp"
#include "combine_device_common.hpp"

__simt_vf__ __launch_bounds__(512) inline void combine_producer_vf(
    __gm__ const bfloat16_t* x,
    __gm__ const float* topk_weights,
    __gm__ const std::int32_t* source_metadata,
    __gm__ const HybridRouteRecord* route_records,
    std::uint64_t route_record_count,
    __gm__ const std::int32_t* prefix_per_rank,
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t timeout_cycles, std::uint64_t num_source_rows,
    std::uint64_t num_input_rows, std::uint64_t num_tokens,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t dispatch_output_capacity,
    std::uint64_t combine_record_bytes,
    std::uint64_t combine_weight_offset,
    std::uint64_t combine_control_offset,
    std::uint64_t combine_control_bytes,
    std::uint64_t combine_receive_offset,
    std::uint64_t combine_receive_shard_bytes,
    std::uint64_t combine_receive_shard_count,
    std::uint64_t combine_receive_bytes,
    std::uint64_t combine_staging_offset,
    std::uint64_t combine_staging_shard_bytes,
    std::uint64_t combine_staging_shard_count,
    std::uint64_t combine_staging_bytes,
    std::uint64_t reverse_forward_control_offset,
    std::uint64_t reverse_forward_control_bytes,
    std::uint64_t reverse_forward_shard_offset,
    std::uint64_t reverse_forward_shard_bytes,
    std::uint64_t reverse_forward_shard_count,
    std::uint64_t reverse_forward_bytes,
    std::uint64_t workspace_scratch_status_offset,
    std::uint64_t workspace_scratch_rank_counts_offset,
    std::uint64_t workspace_scratch_rank_values_offset,
    std::uint64_t workspace_scratch_rank_count,
    std::uint64_t hidden_elements) {
    if (threadIdx.x != 0)
        return;

    transport::DeviceTransportContext context{};
    context.abi_version = transport_abi_version;
    context.struct_size = transport_struct_size;
    context.capabilities = transport_capabilities;
    context.topology.abi_version = transport_topology_abi_version;
    context.topology.struct_size = transport_topology_struct_size;
    context.topology.world_rank = transport_world_rank;
    context.topology.world_size = transport_world_size;
    context.topology.scale_up_rank = transport_scale_up_rank;
    context.topology.scale_up_size = transport_scale_up_size;
    context.topology.scale_out_rank = transport_scale_out_rank;
    context.topology.scale_out_size = transport_scale_out_size;
    context.topology.scale_up_direct = transport_scale_up_direct != 0;
    context.topology.kind = static_cast<transport::TransportTopologyKind>(
        transport_topology_kind);
    context.topology.epoch = transport_topology_epoch;
    context.local_window_base = transport_local_window_base;
    context.channel_table = transport_channel_table;
    context.peer_address_table = transport_peer_address_table;
    context.backend_context = transport_backend_context;
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address =
        reinterpret_cast<transport::DeviceAddress>(
            workspace + workspace_scratch_status_offset);
    transport.store_release(status_address, 0);

    const std::uint64_t hidden_bytes =
        hidden_elements * sizeof(std::uint16_t);
    const std::uint64_t raw_record_capacity =
        shard_capacity * static_cast<std::uint64_t>(transport_world_size);

    // Raw record bounds are checked before any byte-capacity arithmetic.
    if (!transport::device::detail::valid_topology(context.topology) ||
        transport_world_size < 2 ||
        workspace_scratch_rank_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        generation == 0 || timeout_cycles == 0 ||
        num_source_rows > raw_record_capacity ||
        shard_capacity == 0 ||
        shard_capacity >
            static_cast<std::uint64_t>(0x7fffffff) /
                static_cast<std::uint64_t>(transport_world_size))
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kCapacityOverflow);

    const bool expanded = (mode_flags & (CoreModeFlags{1} <<
        static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    const bool allow_multiple_reduction = (mode_flags & (CoreModeFlags{1} <<
        static_cast<std::uint8_t>(CoreMode::kAllowMultipleReduction))) != 0;
    const bool hybrid =
        (mode_flags &
         (CoreModeFlags{1} <<
          static_cast<std::uint8_t>(CoreMode::kHybrid))) != 0;
    const auto record_trailer =
        combine_record_trailer_layout(combine_record_bytes, hybrid);
    const std::uint64_t record_capacity = expanded && !allow_multiple_reduction ?
        shard_capacity * num_topk : shard_capacity;
    if ((!expanded && (allow_multiple_reduction ||
                       num_source_rows != num_input_rows)) ||
        (expanded && num_input_rows > dispatch_output_capacity))
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kInvalidMetadata);

    if (combine_control_bytes <
            static_cast<std::uint64_t>(transport_world_size) *
                sizeof(CombineControlSlot) ||
        combine_receive_shard_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        combine_staging_shard_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        combine_receive_bytes <
            combine_receive_shard_count * combine_receive_shard_bytes ||
        combine_staging_bytes <
            combine_staging_shard_count * combine_staging_shard_bytes ||
        !record_trailer.valid ||
        hidden_bytes > combine_weight_offset ||
        combine_weight_offset > record_trailer.header_offset ||
        num_topk >
            (record_trailer.header_offset - combine_weight_offset) /
                sizeof(float) ||
        record_capacity * combine_record_bytes >
            combine_receive_shard_bytes ||
        record_capacity * combine_record_bytes >
            combine_staging_shard_bytes ||
        (hybrid &&
         (route_records == nullptr || route_record_count != num_source_rows ||
          reverse_forward_control_bytes <
              static_cast<std::uint64_t>(transport_world_size) *
                  sizeof(CombineControlSlot) ||
          reverse_forward_shard_count !=
              static_cast<std::uint64_t>(transport_world_size) ||
          reverse_forward_bytes < reverse_forward_shard_count *
              reverse_forward_shard_bytes ||
          record_capacity * combine_record_bytes >
              reverse_forward_shard_bytes)))
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kInvalidLayout);

    auto* record_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_scratch_rank_counts_offset);
    auto* record_begins = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_scratch_rank_values_offset);
    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        record_counts[destination_rank] = 0;
        record_begins[destination_rank] = 0;
    }
    std::uint64_t previous_end = 0;
    const std::uint64_t metadata_stride = 2 + num_topk;
    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        const std::int32_t encoded_end = prefix_per_rank[destination_rank];
        if (encoded_end < 0 ||
            static_cast<std::uint64_t>(encoded_end) < previous_end ||
            static_cast<std::uint64_t>(encoded_end) > num_source_rows)
            return record_combine_protocol_error(
                context, status_address, destination_rank,
                CombineProtocolError::kInvalidPrefix);
        const std::uint64_t end = static_cast<std::uint64_t>(encoded_end);
        record_begins[destination_rank] = previous_end;
        for (std::uint64_t row = previous_end; row < end; ++row) {
            __gm__ const std::int32_t* metadata =
                source_metadata + row * metadata_stride;
            const std::int32_t origin_token = decode_dispatch_local_index(
                metadata[0], shard_capacity);
            const int master_rank = decode_dispatch_source_rank(
                metadata[1], num_topk);
            const std::int32_t master_lane = decode_dispatch_local_index(
                metadata[1], num_topk);
            if (!is_valid_combine_source_identity(
                    metadata[0], destination_rank, transport_world_rank,
                    shard_capacity,
                    num_tokens) ||
                master_rank != destination_rank ||
                !is_dispatch_local_index(master_lane, num_topk))
                return record_combine_protocol_error(
                    context, status_address, destination_rank,
                    CombineProtocolError::kInvalidMetadata);
            if (hybrid) {
                const auto& route_record = route_records[row];
                const auto route = classify_world_route(
                    destination_rank, transport_world_rank,
                    transport_scale_up_size);
                const bool diagonal =
                    route.kind == WorldRouteKind::kDiagonal;
                if (route_record.origin_world_rank != destination_rank ||
                    route_record.destination_world_rank !=
                        transport_world_rank ||
                    route_record.ingress_world_rank !=
                        route.ingress_world_rank ||
                    route_record.origin_source_row !=
                        static_cast<std::uint64_t>(origin_token) ||
                    route_record.topology_epoch != transport_topology_epoch ||
                    !is_complete_hybrid_route_stage_flags(
                        route_record.stage_flags) ||
                    (diagonal ?
                         (route_record.ingress_slot ==
                              kInvalidHybridRouteSlot ||
                          route_record.forwarded_slot ==
                              kInvalidHybridRouteSlot) :
                         (route_record.ingress_slot !=
                              kInvalidHybridRouteSlot ||
                          route_record.forwarded_slot !=
                              kInvalidHybridRouteSlot)))
                    return record_combine_protocol_error(
                        context, status_address, destination_rank,
                        CombineProtocolError::kInvalidMetadata);
                if (diagonal &&
                    (shard_capacity == 0 ||
                     route_record.ingress_slot / shard_capacity !=
                         static_cast<std::uint64_t>(destination_rank) ||
                     route_record.forwarded_slot / shard_capacity !=
                         static_cast<std::uint64_t>(destination_rank)))
                    return record_combine_protocol_error(
                        context, status_address, destination_rank,
                        CombineProtocolError::kInvalidMetadata);
                if (diagonal) {
                    for (std::uint64_t prior = 0; prior < row; ++prior) {
                        const auto& prior_record = route_records[prior];
                        if (prior_record.ingress_slot ==
                                route_record.ingress_slot ||
                            prior_record.forwarded_slot ==
                                route_record.forwarded_slot)
                            return record_combine_protocol_error(
                                context, status_address, destination_rank,
                                CombineProtocolError::kInvalidMetadata);
                    }
                }
            }
            for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                const std::int32_t input_row = metadata[2 + lane];
                if (!expanded) {
                    if (input_row != -1)
                        return record_combine_protocol_error(
                            context, status_address, destination_rank,
                            CombineProtocolError::kInvalidMetadata);
                    continue;
                }
                if (!combine_expanded_input_row_is_valid(
                        input_row, num_input_rows))
                    return record_combine_protocol_error(
                        context, status_address, destination_rank,
                        CombineProtocolError::kInvalidMetadata);
            }
            record_counts[destination_rank] +=
                hybrid_combine_records_for_row(
                    metadata, num_topk, expanded,
                    allow_multiple_reduction);
        }
        previous_end = end;
    }
    if (previous_end != num_source_rows)
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kInvalidPrefix);

    // Record counts are derived before staging so no command is published on
    // malformed expanded metadata.
    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        const std::uint64_t count = record_counts[destination_rank];
        if (count * combine_record_bytes > combine_staging_shard_bytes ||
            count * combine_record_bytes > combine_receive_shard_bytes)
            return record_combine_protocol_error(
                context, status_address, destination_rank,
                CombineProtocolError::kCapacityOverflow);
    }

    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        __gm__ std::uint8_t* staging_shard =
            reinterpret_cast<__gm__ std::uint8_t*>(
                combine_staging_shard_address(
                    transport_local_window_base, combine_staging_offset,
                    static_cast<std::uint64_t>(destination_rank),
                    combine_staging_shard_bytes));
        const std::uint64_t begin = record_begins[destination_rank];
        const std::uint64_t end = destination_rank + 1 == transport_world_size ?
            num_source_rows : record_begins[destination_rank + 1];
        std::uint64_t output_slot = 0;
        for (std::uint64_t row = begin; row < end; ++row) {
            __gm__ const std::int32_t* metadata =
                source_metadata + row * metadata_stride;
            const std::int32_t master_lane = decode_dispatch_local_index(
                metadata[1], num_topk);
            const std::uint64_t records_for_row =
                hybrid_combine_records_for_row(
                    metadata, num_topk, expanded,
                    allow_multiple_reduction);
            const auto world_route = classify_world_route(
                destination_rank, transport_world_rank,
                transport_scale_up_size);
            const bool diagonal = hybrid &&
                world_route.kind == WorldRouteKind::kDiagonal;
            std::uint64_t row_output_slot = output_slot;
            if (diagonal) {
                const auto& route_record = route_records[row];
                row_output_slot = 0;
                for (std::uint64_t prior = begin; prior < end; ++prior) {
                    const auto& prior_record = route_records[prior];
                    if (prior_record.forwarded_slot >=
                        route_record.forwarded_slot)
                        continue;
                    const auto* prior_metadata =
                        source_metadata + prior * metadata_stride;
                    row_output_slot += hybrid_combine_records_for_row(
                        prior_metadata, num_topk, expanded,
                        allow_multiple_reduction);
                }
            }
            for (std::uint64_t record_index = 0;
                 record_index < records_for_row; ++record_index) {
                std::uint64_t contribution_lane =
                    static_cast<std::uint64_t>(master_lane);
                if (expanded && !allow_multiple_reduction) {
                    contribution_lane = static_cast<std::uint64_t>(
                        combine_expanded_record_lane(
                            metadata + 2, num_topk, record_index));
                }
                __gm__ std::uint8_t* record =
                    staging_shard +
                    (row_output_slot + record_index) * combine_record_bytes;
                auto* record_hidden =
                    reinterpret_cast<__gm__ bfloat16_t*>(record);
                auto* record_weights = reinterpret_cast<__gm__ float*>(
                    record + combine_weight_offset);
                for (std::uint64_t lane = 0; lane < num_topk; ++lane)
                    record_weights[lane] = 0.0F;
                for (std::uint64_t hidden = 0;
                     hidden < hidden_elements; ++hidden) {
                    float value = 0.0F;
                    if (!expanded) {
                        value = static_cast<float>(x[row * hidden_elements + hidden]);
                    } else if (allow_multiple_reduction) {
                        value = combine_reduce_expanded_lanes(
                            x, metadata + 2, num_topk, num_input_rows,
                            hidden_elements, hidden);
                    } else {
                        const std::int32_t input_row =
                            metadata[2 + contribution_lane];
                        value = static_cast<float>(x[
                            static_cast<std::uint64_t>(input_row) *
                            hidden_elements + hidden]);
                    }
                    record_hidden[hidden] = static_cast<bfloat16_t>(value);
                }
                if (!expanded) {
                    combine_fill_normal_record_routing_weights(
                        topk_weights, row, master_lane, num_topk,
                        record, combine_weight_offset);
                } else {
                    for (std::uint64_t lane = 0; lane < num_topk; ++lane) {
                        const bool owns_lane = metadata[2 + lane] != -1;
                        if (!owns_lane || (!allow_multiple_reduction &&
                                           lane != contribution_lane))
                            continue;
                        const std::int32_t input_row = metadata[2 + lane];
                        record_weights[lane] = topk_weights == nullptr ?
                            0.0F : combine_routing_weight(
                                topk_weights,
                                static_cast<std::uint64_t>(input_row));
                    }
                }
                auto* header = reinterpret_cast<__gm__ CombineRecordHeader*>(
                    record + record_trailer.header_offset);
                header->abi_version = kCombineRecordAbiVersion;
                header->struct_size = sizeof(CombineRecordHeader);
                header->origin_token = decode_dispatch_local_index(
                    metadata[0], shard_capacity);
                header->contributor_rank = transport_world_rank;
                header->master_lane = master_lane;
                header->contribution_lane = expanded && !allow_multiple_reduction ?
                    static_cast<std::int32_t>(contribution_lane) : master_lane;
                if (record_trailer.has_route_metadata) {
                    auto* route_metadata = reinterpret_cast<
                        __gm__ HybridCombineRouteMetadata*>(
                            record + record_trailer.route_metadata_offset);
                    route_metadata->ingress_slot = diagonal ?
                        route_records[row].ingress_slot :
                        kInvalidHybridRouteSlot;
                    route_metadata->forwarded_slot = diagonal ?
                        route_records[row].forwarded_slot :
                        kInvalidHybridRouteSlot;
                }
            }
            output_slot += records_for_row;
        }
    }

    transport.system_fence();
    auto* control_slots = reinterpret_cast<__gm__ CombineControlSlot*>(
        transport_local_window_base + combine_control_offset);
    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        const std::uint64_t count = record_counts[destination_rank];
        const auto source = static_cast<transport::DeviceAddress>(
            combine_staging_shard_address(
                transport_local_window_base, combine_staging_offset,
                static_cast<std::uint64_t>(destination_rank),
                combine_staging_shard_bytes));
        const auto destination = static_cast<transport::DeviceAddress>(
            combine_receive_shard_address(
                transport_local_window_base, combine_receive_offset,
                static_cast<std::uint64_t>(transport_world_rank),
                combine_receive_shard_bytes));
        if (destination_rank == transport_world_rank) {
            auto* local_source = reinterpret_cast<
                __gm__ const std::uint8_t*>(
                    combine_staging_shard_address(
                        transport_local_window_base, combine_staging_offset,
                        static_cast<std::uint64_t>(destination_rank),
                        combine_staging_shard_bytes));
            auto* local_destination = reinterpret_cast<__gm__ std::uint8_t*>(
                combine_receive_shard_address(
                    transport_local_window_base, combine_receive_offset,
                    static_cast<std::uint64_t>(transport_world_rank),
                    combine_receive_shard_bytes));
            for (std::uint64_t byte = 0;
                 byte < count * combine_record_bytes; ++byte)
                local_destination[byte] = local_source[byte];
            transport.store_release(
                reinterpret_cast<transport::DeviceAddress>(
                    &control_slots[transport_world_rank].count), count);
            transport.store_release(
                reinterpret_cast<transport::DeviceAddress>(
                    &control_slots[transport_world_rank].generation),
                generation);
            continue;
        }
        const auto world_route = classify_world_route(
            destination_rank, transport_world_rank, transport_scale_up_size);
        if (hybrid && world_route.kind == WorldRouteKind::kDiagonal) {
            const int ingress_rank = world_route.ingress_world_rank;
            transport::TeamPeer route{
                transport::TransportTeam::kScaleUp,
                ingress_rank % transport_scale_up_size, ingress_rank};
            const auto reverse_destination =
                transport_local_window_base + reverse_forward_shard_offset +
                static_cast<std::uint64_t>(destination_rank) *
                    reverse_forward_shard_bytes;
            if (count != 0) {
                transport.put(
                    transport::TransportTeam::kScaleUp, route.peer,
                    reverse_destination, source,
                    count * combine_record_bytes,
                    transport::CooperationScope::kParticipant,
                    transport::MemorySegment::kDevice,
                    transport::kDefaultOptions,
                    transport::RemoteAction::none());
            }
            release_protocol::flush_payload(transport);
            const auto remote_slot = transport_local_window_base +
                reverse_forward_control_offset +
                static_cast<std::uint64_t>(destination_rank) *
                    sizeof(CombineControlSlot);
            release_protocol::publish_control_and_release(
                transport, route, remote_slot + sizeof(std::uint64_t), count,
                remote_slot, generation,
                transport::sync_layout::kCombineReleaseSignalIndex);
            continue;
        }
        transport::TeamPeer route{};
        if (!transport::device::detail::checked_device_team_peer_for_world_rank(
                context.topology, destination_rank, &route))
            return record_combine_protocol_error(
                context, status_address, destination_rank,
                CombineProtocolError::kInvalidMetadata);
        if (count != 0)
            release_protocol::put_staged_records_striped(
                transport, route, destination, source, count,
                combine_record_bytes);
    }
    release_protocol::flush_payload(transport);
    for (int destination_rank = 0;
         destination_rank < transport_world_size; ++destination_rank) {
        if (destination_rank == transport_world_rank)
            continue;
        const std::uint64_t count = record_counts[destination_rank];
        transport::TeamPeer route{};
        if (!transport::device::detail::checked_device_team_peer_for_world_rank(
                context.topology, destination_rank, &route))
            return record_combine_protocol_error(
                context, status_address, destination_rank,
                CombineProtocolError::kInvalidMetadata);
        const auto remote_count = static_cast<transport::DeviceAddress>(
            transport_local_window_base + combine_control_offset +
            static_cast<std::uint64_t>(transport_world_rank) *
                sizeof(CombineControlSlot) + sizeof(std::uint64_t));
        const auto remote_generation = static_cast<transport::DeviceAddress>(
            transport_local_window_base + combine_control_offset +
            static_cast<std::uint64_t>(transport_world_rank) *
                sizeof(CombineControlSlot));
        release_protocol::publish_control_and_release(
            transport, route, remote_count, count, remote_generation,
            generation, transport::sync_layout::kCombineReleaseSignalIndex);
    }
    const auto barrier_workspace =
        reinterpret_cast<transport::DeviceAddress>(
            &control_slots[transport_world_rank].generation);
    transport.device_barrier(
        transport::kWorldTeamMask, barrier_workspace, timeout_cycles);
}

__global__ __vector__ void combine_producer_kernel(
    __gm__ const std::uint16_t* x,
    __gm__ const float* topk_weights,
    __gm__ const std::int32_t* source_metadata,
    __gm__ const HybridRouteRecord* route_records,
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ const std::int32_t* prefix_per_rank,
    __gm__ std::uint8_t* workspace,
    __gm__ std::uint16_t* combined_x,
    __gm__ float* combined_topk_weights,
    __gm__ const std::uint16_t* bias_0,
    __gm__ const std::uint16_t* bias_1,
    CombineVfScalars scalars) {
    const auto route_record_count = scalars.route_record_count;
    const auto generation = scalars.generation;
    const auto timeout_cycles = scalars.timeout_cycles;
    const auto num_source_rows = scalars.num_source_rows;
    const auto num_input_rows = scalars.num_input_rows;
    const auto local_window_base = scalars.local_window_base;
    const auto expanded_vector_reduce = scalars.expanded_vector_reduce;
    const auto local_copy_datacopy = scalars.local_copy_datacopy;
    const auto direct_local_placement = scalars.direct_local_placement;
    const auto vector_reduce_tile_elements = scalars.vector_reduce_tile_elements;
    const auto stage = scalars.stage;
    const auto profile_enabled = scalars.profile_enabled;
    const auto tiling = scalars.tiling;
    const auto release_segment = direct_combine_release_segment(stage, profile_enabled);
    const std::uint64_t hybrid_record_capacity =
        (tiling.mode_flags & (CoreModeFlags{1} << static_cast<std::uint8_t>(
            CoreMode::kExpanded))) != 0 &&
        (tiling.mode_flags & (CoreModeFlags{1} << static_cast<std::uint8_t>(
            CoreMode::kAllowMultipleReduction))) == 0 ?
            tiling.num_max_tokens_per_rank * tiling.num_topk :
            tiling.num_max_tokens_per_rank;
    asc_vf_call<combine_producer_vf>(
        dim3(tiling.launch.num_threads),
        reinterpret_cast<__gm__ const bfloat16_t*>(x),
        topk_weights,
        source_metadata,
        route_records,
        route_record_count,
        prefix_per_rank,
        workspace,
        tiling.transport_context.abi_version,
        tiling.transport_context.struct_size,
        tiling.transport_context.capabilities,
        local_window_base,
        tiling.transport_context.channel_table,
        tiling.transport_context.peer_address_table,
        tiling.transport_context.topology.abi_version,
        tiling.transport_context.topology.struct_size,
        tiling.transport_context.topology.world_rank,
        tiling.transport_context.topology.world_size,
        tiling.transport_context.topology.scale_up_rank,
        tiling.transport_context.topology.scale_up_size,
        tiling.transport_context.topology.scale_out_rank,
        tiling.transport_context.topology.scale_out_size,
        static_cast<std::uint32_t>(
            tiling.transport_context.topology.scale_up_direct),
        static_cast<std::uint32_t>(tiling.transport_context.topology.kind),
        tiling.transport_context.topology.epoch,
        tiling.transport_context.backend_context,
        tiling.mode_flags,
        generation,
        timeout_cycles,
        num_source_rows,
        num_input_rows,
        tiling.num_tokens,
        tiling.num_topk,
        tiling.num_max_tokens_per_rank,
        tiling.dispatch_output_capacity,
        tiling.symmetric_window_layout.combine_record_bytes,
        tiling.symmetric_window_layout.combine_weight_offset,
        tiling.symmetric_window_layout.combine_control_offset,
        tiling.symmetric_window_layout.combine_control_bytes,
        tiling.symmetric_window_layout.combine_receive_offset,
        tiling.symmetric_window_layout.combine_receive_shard_bytes,
        tiling.symmetric_window_layout.combine_receive_shard_count,
        tiling.symmetric_window_layout.combine_receive_bytes,
        tiling.symmetric_window_layout.combine_staging_offset,
        tiling.symmetric_window_layout.combine_staging_shard_bytes,
        tiling.symmetric_window_layout.combine_staging_shard_count,
        tiling.symmetric_window_layout.combine_staging_bytes,
        tiling.symmetric_window_layout
            .hybrid_combine_reverse_forward_control_offset,
        tiling.symmetric_window_layout
            .hybrid_combine_reverse_forward_control_bytes,
        tiling.symmetric_window_layout
            .hybrid_combine_reverse_forward_shard_offset,
        tiling.symmetric_window_layout
            .hybrid_combine_reverse_forward_shard_bytes,
        tiling.symmetric_window_layout
            .hybrid_combine_reverse_forward_shard_count,
        tiling.symmetric_window_layout
            .hybrid_combine_reverse_forward_bytes,
        tiling.workspace_layout.scratch_status_offset,
        tiling.workspace_layout.scratch_rank_counts_offset,
        tiling.workspace_layout.scratch_rank_values_offset,
        tiling.workspace_layout.scratch_rank_count,
        tiling.hidden);
}

extern "C" int deep_ep_ascend_launch_combine_producer(
    CombineArguments arguments, CoreTiling tiling,
    DirectCombineStage stage, bool profile_enabled,
    void* stream, CoreLaunchShape launch) {
    const CombineVfScalars scalars{
        arguments.route_record_count, arguments.generation,
        arguments.timeout_cycles,
        arguments.num_source_rows, arguments.num_input_rows,
        arguments.local_window_base, arguments.expanded_vector_reduce,
        arguments.local_copy_datacopy, arguments.direct_local_placement,
        arguments.vector_reduce_tile_elements, stage, profile_enabled, tiling};
    combine_producer_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        static_cast<const std::uint16_t*>(arguments.x),
        arguments.topk_weights, arguments.source_metadata,
        arguments.route_records, arguments.combined_topk_indices,
        arguments.prefix_per_rank,
        static_cast<std::uint8_t*>(arguments.workspace),
        static_cast<std::uint16_t*>(arguments.combined_x),
        arguments.combined_topk_weights,
        static_cast<const std::uint16_t*>(arguments.bias_0),
        static_cast<const std::uint16_t*>(arguments.bias_1), scalars);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
