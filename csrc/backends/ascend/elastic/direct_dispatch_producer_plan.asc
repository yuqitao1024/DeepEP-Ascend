#include <cstddef>
#include <cstdint>
#include <limits>

#include "acl/acl.h"
#include "c_api/sync/sync.h"
#include "kernel_operator.h"
#include "simt_api/asc_bf16.h"
#include "simt_api/asc_simt.h"
#include "simt_api/device_atomic_functions.h"
#include "simt_api/device_sync_functions.h"
#include "simt_api/device_warp_functions.h"

#define DEEP_EP_ASCEND_SIMT_DEVICE 1
#define DEEP_EP_ASCEND_TOPK_GROUPING_DEVICE 1
#define DEEP_EP_ASCEND_ELASTIC_AICORE_CALLEE __aicore__ inline
#include "kernels.hpp"
#undef DEEP_EP_ASCEND_ELASTIC_AICORE_CALLEE
#include "topk_grouping.hpp"

#include "dispatch_parallel.hpp"
#include "dispatch_pipeline_config.hpp"
#include "dispatch_state.hpp"
