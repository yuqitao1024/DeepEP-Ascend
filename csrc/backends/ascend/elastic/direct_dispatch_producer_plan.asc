namespace deep_ep::ascend::elastic {

#include "dispatch_device_common.hpp"

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_producer_plan_vf(
    __gm__ const std::int64_t* topk_indices,
    __gm__ std::int32_t* destination_slots,
    __gm__ std::uint8_t* workspace,
    int transport_world_rank, int transport_world_size,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t num_tokens, std::uint64_t num_experts,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t dispatch_error_offset,
    std::uint64_t dispatch_rank_bitmap_offset) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::simt::load_observed(status) != 0)
        return;

    const std::uint32_t num_tokens_u32 =
        static_cast<std::uint32_t>(num_tokens);
    const std::uint32_t num_experts_u32 =
        static_cast<std::uint32_t>(num_experts);
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t shard_capacity_u32 =
        static_cast<std::uint32_t>(shard_capacity);
    const bool cached = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const std::uint32_t world_size =
        static_cast<std::uint32_t>(transport_world_size);
    const std::uint32_t num_local_experts = num_experts_u32 / world_size;
    auto* destination_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* maximum_slots = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    auto* errors = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_error_offset);
    auto* bitmap = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_rank_bitmap_offset);
    std::uint64_t words_per_rank = 0;
    dispatch_simt_bitmap_words(shard_capacity, &words_per_rank);
    const std::uint32_t words_per_rank_u32 =
        static_cast<std::uint32_t>(words_per_rank);

    for (int destination_rank = static_cast<int>(threadIdx.x);
         destination_rank < transport_world_size;
         destination_rank += static_cast<int>(blockDim.x)) {
        auto* owner_bitmap = bitmap +
            static_cast<std::uint64_t>(destination_rank) * words_per_rank;
        for (std::uint32_t word = 0; word < words_per_rank_u32; ++word)
            owner_bitmap[word] = 0;

        DispatchProtocolError error = DispatchProtocolError::kNone;
        int diagnostic_peer = 999;
        std::uint32_t count = 0;
        std::uint32_t maximum_slot = 0;
        for (std::uint32_t token = 0; token < num_tokens_u32; ++token) {
            bool selected = false;
            std::int32_t cached_slot = -1;
            for (std::uint32_t lane = 0; lane < num_topk_u32; ++lane) {
                const std::uint32_t index = token * num_topk_u32 + lane;
                const std::int64_t expert = topk_indices[index];
                const std::int32_t encoded = destination_slots[index];
                if (expert == -1) {
                    if (!cached && destination_rank == 0)
                        destination_slots[index] = -1;
                    if (cached && encoded != -1 && destination_rank == 0) {
                        error = DispatchProtocolError::kInvalidCachedSlot;
                        diagnostic_peer = static_cast<int>(
                            200000U + index);
                    }
                    continue;
                }
                if (expert < 0 ||
                    static_cast<std::uint64_t>(expert) >= num_experts_u32) {
                    if (destination_rank == 0) {
                        error = DispatchProtocolError::kInvalidTopk;
                        diagnostic_peer = static_cast<int>(
                            100000U + index);
                    }
                    continue;
                }
                const int lane_destination = static_cast<int>(
                    static_cast<std::uint64_t>(expert) /
                    num_local_experts);
                if (lane_destination != destination_rank)
                    continue;
                selected = true;
                if (!cached)
                    continue;
                const int encoded_rank = decode_dispatch_source_rank(
                    encoded, shard_capacity);
                const std::int32_t slot = decode_dispatch_local_index(
                    encoded, shard_capacity);
                if (encoded < 0 || encoded_rank != transport_world_rank ||
                    slot < 0 ||
                    static_cast<std::uint64_t>(slot) >= shard_capacity ||
                    (cached_slot >= 0 && cached_slot != slot)) {
                    error = DispatchProtocolError::kInvalidCachedSlot;
                    diagnostic_peer = static_cast<int>(
                        (encoded < 0 ? 300000U :
                         encoded_rank != transport_world_rank ? 400000U :
                         slot < 0 ? 500000U :
                         static_cast<std::uint64_t>(slot) >= shard_capacity ?
                             600000U : 700000U) +
                        index);
                    continue;
                }
                cached_slot = slot;
            }
            if (!selected)
                continue;

            const std::uint32_t shard_slot = cached ?
                static_cast<std::uint32_t>(cached_slot) : count;
            if (cached_slot < 0 && cached) {
                error = DispatchProtocolError::kInvalidCachedSlot;
                diagnostic_peer = static_cast<int>(
                    800000U + token * num_topk_u32);
            } else if (shard_slot >= shard_capacity_u32) {
                error = cached ? DispatchProtocolError::kInvalidCachedSlot :
                                 DispatchProtocolError::kCapacityOverflow;
                diagnostic_peer = static_cast<int>(
                    900000U + token * num_topk_u32);
            } else if (cached) {
                std::uint64_t word = 0;
                std::uint64_t mask = 0;
                if (!dispatch_simt_bitmap_location(
                        shard_slot, shard_capacity, &word, &mask)) {
                    error = DispatchProtocolError::kInvalidCachedSlot;
                    diagnostic_peer = static_cast<int>(
                        1000000U + token * num_topk_u32);
                } else if ((owner_bitmap[word] & mask) != 0) {
                    error = DispatchProtocolError::kInvalidCachedSlot;
                    diagnostic_peer = static_cast<int>(
                        0x10000000U |
                        ((token & 0x3fffU) << 14U) |
                        (shard_slot & 0x3fffU));
                } else {
                    owner_bitmap[word] |= mask;
                }
                if (maximum_slot < shard_slot + 1)
                    maximum_slot = shard_slot + 1;
            }

            if (!cached) {
                for (std::uint32_t lane = 0;
                     lane < num_topk_u32; ++lane) {
                    const std::uint32_t index =
                        token * num_topk_u32 + lane;
                    const std::int64_t expert = topk_indices[index];
                    if (expert >= 0 &&
                        static_cast<int>(
                            static_cast<std::uint64_t>(expert) /
                            num_local_experts) == destination_rank)
                        destination_slots[index] =
                            encode_dispatch_source_index(
                                static_cast<std::uint64_t>(
                                    transport_world_rank),
                                shard_capacity, shard_slot);
                }
            }
            ++count;
        }
        if (count > shard_capacity_u32 ||
            (cached && maximum_slot != count)) {
            if (error == DispatchProtocolError::kNone) {
                const std::uint32_t packed_counts =
                    ((count & 0x7fffU) << 15U) |
                    (maximum_slot & 0x7fffU);
                diagnostic_peer = static_cast<int>(
                    (count > shard_capacity_u32 ? 0x20000000U :
                                                   0x40000000U) |
                    packed_counts);
            }
            error = cached ? DispatchProtocolError::kInvalidCachedSlot :
                             DispatchProtocolError::kCapacityOverflow;
        }
        destination_counts[destination_rank] = count;
        maximum_slots[destination_rank] = maximum_slot;
        if (error != DispatchProtocolError::kNone)
            transport::simt::store_published(
                &errors[destination_rank], make_dispatch_protocol_failure(
                    diagnostic_peer,
                    DispatchProtocolStage::kProducer, generation,
                    error).scratch_status);
    }
}

struct DirectDispatchProducerPlanKernelArguments {
    __gm__ const std::int64_t* topk_indices;
    __gm__ std::int32_t* destination_slots;
    __gm__ std::uint8_t* workspace;
    int transport_world_rank;
    int transport_world_size;
    CoreModeFlags mode_flags;
    std::uint64_t generation;
    std::uint64_t num_tokens;
    std::uint64_t num_experts;
    std::uint64_t num_topk;
    std::uint64_t shard_capacity;
    std::uint64_t workspace_status_offset;
    std::uint64_t workspace_rank_counts_offset;
    std::uint64_t workspace_rank_values_offset;
    std::uint64_t dispatch_error_offset;
    std::uint64_t dispatch_rank_bitmap_offset;
    std::uint32_t vf_num_threads;
};

static_assert(offsetof(DirectDispatchProducerPlanKernelArguments,
                       transport_world_rank) ==
                  offsetof(DirectDispatchProducerPlanKernelArguments,
                           workspace) + sizeof(void*),
              "direct producer plan pointer/int ABI drift");
static_assert(offsetof(DirectDispatchProducerPlanKernelArguments,
                       generation) % alignof(std::uint64_t) == 0,
              "direct producer plan generation alignment");
static_assert(offsetof(DirectDispatchProducerPlanKernelArguments,
                       vf_num_threads) + sizeof(std::uint32_t) ==
                  sizeof(DirectDispatchProducerPlanKernelArguments) ||
                  offsetof(DirectDispatchProducerPlanKernelArguments,
                           vf_num_threads) + sizeof(std::uint32_t) +
                          sizeof(std::uint32_t) ==
                      sizeof(DirectDispatchProducerPlanKernelArguments),
              "direct producer plan trailing ABI drift");

__global__ __vector__ void direct_dispatch_producer_plan_kernel(
    DirectDispatchProducerPlanKernelArguments arguments) {
    asc_vf_call<direct_dispatch_producer_plan_vf> (
        dim3(arguments.vf_num_threads), arguments.topk_indices, arguments.destination_slots, arguments.workspace, arguments.transport_world_rank, arguments.transport_world_size, arguments.mode_flags, arguments.generation, arguments.num_tokens, arguments.num_experts, arguments.num_topk, arguments.shard_capacity, arguments.workspace_status_offset, arguments.workspace_rank_counts_offset, arguments.workspace_rank_values_offset, arguments.dispatch_error_offset, arguments.dispatch_rank_bitmap_offset);
}

extern "C" int deep_ep_ascend_launch_direct_dispatch_producer_plan(
    const std::int64_t* topk_indices,
    std::int32_t* destination_slots,
    std::uint8_t* workspace,
    int transport_world_rank,
    int transport_world_size,
    CoreModeFlags mode_flags,
    std::uint64_t generation,
    std::uint64_t num_tokens,
    std::uint64_t num_experts,
    std::uint64_t num_topk,
    std::uint64_t shard_capacity,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t dispatch_error_offset,
    std::uint64_t dispatch_rank_bitmap_offset,
    void* stream, CoreLaunchShape launch,
    std::uint32_t vf_num_threads) {
    const DirectDispatchProducerPlanKernelArguments arguments{
        topk_indices,
        destination_slots,
        workspace,
        transport_world_rank,
        transport_world_size,
        mode_flags,
        generation,
        num_tokens,
        num_experts,
        num_topk,
        shard_capacity,
        workspace_status_offset,
        workspace_rank_counts_offset,
        workspace_rank_values_offset,
        dispatch_error_offset,
        dispatch_rank_bitmap_offset,
        vf_num_threads};
    direct_dispatch_producer_plan_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(arguments);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
