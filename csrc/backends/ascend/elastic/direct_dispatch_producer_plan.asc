namespace deep_ep::ascend::elastic {

struct DirectDispatchProducerRoutePlanLayout {
    __gm__ std::uint64_t* counts;
    __gm__ std::uint64_t* digest;
};

#include "dispatch_device_common.hpp"

__simt_callee__ inline void direct_dispatch_producer_plan_serial(
    __gm__ const std::int64_t* topk_indices,
    __gm__ std::int32_t* destination_slots,
    __gm__ std::uint8_t* workspace,
    int transport_world_rank, int transport_world_size,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t num_tokens, std::uint64_t num_experts,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t dispatch_error_offset,
    std::uint64_t dispatch_rank_bitmap_offset,
    __gm__ std::uint64_t* route_plan,
    std::uint32_t route_plan_words);

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_producer_plan_vf(
    __gm__ const std::int64_t* topk_indices,
    __gm__ std::int32_t* destination_slots,
    __gm__ std::uint8_t* workspace,
    int transport_world_rank, int transport_world_size,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t num_tokens, std::uint64_t num_experts,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t dispatch_error_offset,
    std::uint64_t dispatch_rank_bitmap_offset,
    __gm__ std::uint64_t* route_plan,
    std::uint32_t route_plan_words) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::simt::load_observed(status) != 0)
        return;

    const std::uint32_t num_tokens_u32 =
        static_cast<std::uint32_t>(num_tokens);
    const std::uint32_t num_experts_u32 =
        static_cast<std::uint32_t>(num_experts);
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t shard_capacity_u32 =
        static_cast<std::uint32_t>(shard_capacity);
    const bool cached = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const std::uint32_t world_size =
        static_cast<std::uint32_t>(transport_world_size);
    const std::uint32_t num_local_experts = num_experts_u32 / world_size;
    auto* destination_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* maximum_slots = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    auto* errors = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_error_offset);
    auto* bitmap = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_rank_bitmap_offset);
    std::uint64_t words_per_rank = 0;
    dispatch_simt_bitmap_words(shard_capacity, &words_per_rank);
    const std::uint32_t words_per_rank_u32 =
        static_cast<std::uint32_t>(words_per_rank);

    if (!cached || num_topk > kTopkSubgroupWidth ||
        transport_world_size > static_cast<int>(kTopkSubgroupWidth)) {
        direct_dispatch_producer_plan_serial(
            topk_indices, destination_slots, workspace,
            transport_world_rank, transport_world_size, mode_flags,
            generation, num_tokens, num_experts, num_topk, shard_capacity,
            workspace_status_offset, workspace_rank_counts_offset,
            workspace_rank_values_offset, dispatch_error_offset,
            dispatch_rank_bitmap_offset, route_plan, route_plan_words);
        return;
    }

    if (cached &&
        route_plan != nullptr && route_plan_words == world_size + 2U) {
        const DirectDispatchProducerRoutePlanLayout plan{
            route_plan, route_plan + world_size};
        if (blockIdx.x != 0)
            return;
        const std::uint64_t stored_digest = plan.digest[0];
        std::uint64_t route_digest = 0;
        const std::uint32_t workers = blockDim.x;
        const std::uint32_t worker = threadIdx.x;
        std::uint64_t rank_counts[kTopkSubgroupWidth] = {};
        bool valid = true;
        __ubuf__ std::uint32_t scratch[3 + 2 * kTopkSubgroupWidth];
        __ubuf__ std::uint32_t* shared_digest = scratch;
        __ubuf__ std::uint32_t* shared_valid = scratch + 2;
        __ubuf__ std::uint32_t* shared_counts = scratch + 3;
        if (threadIdx.x == 0) {
            shared_digest[0] = 0;
            shared_digest[1] = 0;
            shared_valid[0] = 1;
            for (std::uint32_t rank = 0; rank < world_size; ++rank)
                shared_counts[2 * rank] = shared_counts[2 * rank + 1] = 0;
        }
        asc_syncthreads();
        for (std::uint32_t token = worker; token < num_tokens_u32;
             token += workers) {
            std::uint32_t selected_ranks = 0;
            for (std::uint32_t lane = 0; lane < num_topk_u32; ++lane) {
                const std::uint32_t index = token * num_topk_u32 + lane;
                const std::int64_t expert = topk_indices[index];
                const std::int32_t encoded = destination_slots[index];
                route_digest += cached_route_digest_entry(
                    static_cast<std::uint64_t>(expert),
                    static_cast<std::uint64_t>(
                        static_cast<std::int64_t>(encoded)));
                if (expert == -1) {
                    valid = valid && encoded == -1;
                } else if (expert < 0 ||
                           static_cast<std::uint64_t>(expert) >=
                               num_experts_u32) {
                    valid = false;
                } else {
                    const std::uint32_t destination =
                        static_cast<std::uint32_t>(expert) /
                        num_local_experts;
                    const std::int32_t slot = decode_dispatch_local_index(
                        encoded, shard_capacity);
                    valid = valid &&
                        decode_dispatch_source_rank(
                            encoded, shard_capacity) ==
                            transport_world_rank &&
                        slot >= 0 &&
                        static_cast<std::uint64_t>(slot) < shard_capacity;
                    if (valid)
                        selected_ranks |= std::uint32_t{1} << destination;
                }
            }
            while (selected_ranks != 0) {
                const std::uint32_t destination =
                    static_cast<std::uint32_t>(__builtin_ctz(selected_ranks));
                ++rank_counts[destination];
                selected_ranks &= selected_ranks - 1U;
            }
        }
        for (std::uint32_t shift = 0; shift < 64U; shift += 32U)
            (void)asc_atomic_add(
                &shared_digest[shift / 32U],
                static_cast<std::uint32_t>(route_digest >> shift));
        if (!valid)
            (void)asc_atomic_add(&shared_valid[0], 1U);
        for (std::uint32_t rank = 0; rank < world_size; ++rank)
            for (std::uint32_t shift = 0; shift < 64U; shift += 32U)
                (void)asc_atomic_add(
                    &shared_counts[2 * rank + shift / 32U],
                    static_cast<std::uint32_t>(
                        rank_counts[rank] >> shift));
        asc_syncthreads();
        const std::uint64_t observed_digest =
            (static_cast<std::uint64_t>(shared_digest[0]) |
             (static_cast<std::uint64_t>(shared_digest[1]) << 32U));
        const bool digest_match = shared_valid[0] == 0 &&
            observed_digest == stored_digest;
        for (std::uint32_t rank = 0; rank < world_size; ++rank) {
            const std::uint64_t count =
                static_cast<std::uint64_t>(shared_counts[2 * rank]) |
                (static_cast<std::uint64_t>(
                     shared_counts[2 * rank + 1]) << 32U);
            if (threadIdx.x == rank) {
                destination_counts[rank] = plan.counts[rank];
                maximum_slots[rank] = plan.counts[rank];
            }
            if (threadIdx.x == 0 &&
                (!digest_match || plan.counts[rank] != count ||
                 plan.counts[rank] > shard_capacity)) {
                transport::simt::store_published(
                    &errors[0],
                    make_dispatch_protocol_failure(
                        transport_world_rank,
                        DispatchProtocolStage::kProducer, generation,
                        DispatchProtocolError::kInvalidCachedMetadata)
                        .scratch_status);
            }
        }
        return;
    }

    const auto work = direct_subgroup_grid_stride(
        blockIdx.x, threadIdx.x, gridDim.x, blockDim.x,
        kTopkSubgroupWidth);

    // Clear one destination bitmap per subgroup lane. The barrier covers all
    // subgroups in this block: every later grouping tile reads a bitmap that
    // was fully cleared by whichever subgroup lane owned it.
    if (work.lane < world_size) {
        auto* owner_bitmap = bitmap +
            static_cast<std::uint64_t>(work.lane) * words_per_rank;
        for (std::uint32_t word = work.first;
             word < words_per_rank_u32; word += work.stride)
            owner_bitmap[word] = 0;
        if (work.first == 0) {
            destination_counts[work.lane] = 0;
            maximum_slots[work.lane] = 0;
        }
    }
    transport::simt::system_fence();
    asc_syncthreads();
    for (std::uint32_t token = work.first; token < num_tokens_u32;
         token += work.stride) {
        std::int32_t destination_key = -1;
        bool logically_active = false;
        bool invalid_topk = false;
        bool invalid_cached_slot = false;
        std::int32_t lane_slot = -1;
        if (work.lane < num_topk_u32) {
            const std::uint32_t index =
                token * num_topk_u32 + work.lane;
            const std::int64_t expert = topk_indices[index];
            const std::int32_t encoded = destination_slots[index];
            lane_slot = encoded;
            if (expert == -1) {
                invalid_cached_slot = encoded != -1;
            } else if (expert < 0 ||
                       static_cast<std::uint64_t>(expert) >=
                           num_experts_u32) {
                invalid_topk = true;
            } else {
                destination_key = static_cast<std::int32_t>(
                    static_cast<std::uint64_t>(expert) /
                    num_local_experts);
                logically_active = true;
                const int encoded_rank = decode_dispatch_source_rank(
                    encoded, shard_capacity);
                const std::int32_t slot = decode_dispatch_local_index(
                    encoded, shard_capacity);
                lane_slot = slot;
                invalid_cached_slot =
                    encoded < 0 || encoded_rank != transport_world_rank ||
                    slot < 0 ||
                    static_cast<std::uint64_t>(slot) >= shard_capacity;
            }
        }

        const auto group = group_topk_subgroup(
            destination_key, logically_active);
        const std::int32_t group_slot = topk_broadcast_owner_value(
            group, lane_slot, -1);
        const TopkSubgroupMask invalid_mask =
            static_cast<TopkSubgroupMask>(asc_ballot(
                invalid_topk || invalid_cached_slot ||
                        (logically_active && lane_slot != group_slot) ?
                    1 : 0));
        const TopkSubgroupMask invalid_topk_mask =
            static_cast<TopkSubgroupMask>(
                asc_ballot(invalid_topk ? 1 : 0));
        const std::int32_t destination = destination_key;
        if (invalid_topk) {
            transport::simt::store_published(
                &errors[0],
                make_dispatch_protocol_failure(
                    transport_world_rank,
                    DispatchProtocolStage::kProducer, generation,
                    DispatchProtocolError::kInvalidTopk).scratch_status);
        } else if (invalid_cached_slot ||
                   (logically_active && lane_slot != group_slot)) {
            transport::simt::store_published(
                &errors[0],
                make_dispatch_protocol_failure(
                    transport_world_rank,
                    DispatchProtocolStage::kProducer, generation,
                    DispatchProtocolError::kInvalidCachedSlot).scratch_status);
        }
        if (group.is_owner && invalid_mask == 0) {
            const std::uint32_t shard_slot =
                static_cast<std::uint32_t>(group_slot);
            auto* owner_bitmap = bitmap +
                static_cast<std::uint64_t>(destination) * words_per_rank;
            std::uint64_t word = 0;
            std::uint64_t mask = 0;
            const std::uint64_t prior = dispatch_simt_bitmap_location(
                shard_slot, shard_capacity, &word, &mask) ?
                asc_atomic_or(&owner_bitmap[word], mask) :
                std::numeric_limits<std::uint64_t>::max();
            if (group_slot < 0 || shard_slot >= shard_capacity ||
                (prior & mask) != 0) {
                transport::simt::store_published(
                    &errors[0],
                    make_dispatch_protocol_failure(
                        transport_world_rank,
                        DispatchProtocolStage::kProducer, generation,
                        DispatchProtocolError::kInvalidCachedSlot)
                        .scratch_status);
            } else {
                (void)asc_atomic_add(
                    &destination_counts[destination], 1ULL);
                (void)asc_atomic_max(
                    &maximum_slots[destination],
                    static_cast<std::uint64_t>(shard_slot) + 1);
            }
        }
    }
}

__simt_callee__ inline void direct_dispatch_producer_plan_serial(
    __gm__ const std::int64_t* topk_indices,
    __gm__ std::int32_t* destination_slots,
    __gm__ std::uint8_t* workspace,
    int transport_world_rank, int transport_world_size,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t num_tokens, std::uint64_t num_experts,
    std::uint64_t num_topk, std::uint64_t shard_capacity,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t dispatch_error_offset,
    std::uint64_t dispatch_rank_bitmap_offset,
    __gm__ std::uint64_t* route_plan,
    std::uint32_t route_plan_words) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::simt::load_observed(status) != 0)
        return;
    const std::uint32_t num_tokens_u32 =
        static_cast<std::uint32_t>(num_tokens);
    const std::uint32_t num_experts_u32 =
        static_cast<std::uint32_t>(num_experts);
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t shard_capacity_u32 =
        static_cast<std::uint32_t>(shard_capacity);
    const bool cached = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const std::uint32_t world_size =
        static_cast<std::uint32_t>(transport_world_size);
    const std::uint32_t num_local_experts =
        num_experts_u32 / world_size;
    auto* destination_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* maximum_slots = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    auto* errors = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_error_offset);
    auto* bitmap = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_rank_bitmap_offset);
    std::uint64_t words_per_rank = 0;
    dispatch_simt_bitmap_words(shard_capacity, &words_per_rank);
    const std::uint32_t words_per_rank_u32 =
        static_cast<std::uint32_t>(words_per_rank);
    for (int destination_rank = static_cast<int>(threadIdx.x);
         destination_rank < transport_world_size;
         destination_rank += static_cast<int>(blockDim.x)) {
        auto* owner_bitmap = bitmap +
            static_cast<std::uint64_t>(destination_rank) * words_per_rank;
        for (std::uint32_t word = 0; word < words_per_rank_u32; ++word)
            owner_bitmap[word] = 0;

        DispatchProtocolError error = DispatchProtocolError::kNone;
        int diagnostic_peer = 999;
        std::uint32_t count = 0;
        std::uint32_t maximum_slot = 0;
        for (std::uint32_t token = 0; token < num_tokens_u32; ++token) {
            bool selected = false;
            std::int32_t cached_slot = -1;
            for (std::uint32_t lane = 0; lane < num_topk_u32; ++lane) {
                const std::uint32_t index = token * num_topk_u32 + lane;
                const std::int64_t expert = topk_indices[index];
                const std::int32_t encoded = destination_slots[index];
                if (expert == -1) {
                    if (!cached && destination_rank == 0)
                        destination_slots[index] = -1;
                    if (cached && encoded != -1 && destination_rank == 0) {
                        error = DispatchProtocolError::kInvalidCachedSlot;
                        diagnostic_peer = static_cast<int>(
                            200000U + index);
                    }
                    continue;
                }
                if (expert < 0 ||
                    static_cast<std::uint64_t>(expert) >= num_experts_u32) {
                    if (destination_rank == 0) {
                        error = DispatchProtocolError::kInvalidTopk;
                        diagnostic_peer = static_cast<int>(
                            100000U + index);
                    }
                    continue;
                }
                const int lane_destination = static_cast<int>(
                    static_cast<std::uint64_t>(expert) /
                    num_local_experts);
                if (lane_destination != destination_rank)
                    continue;
                selected = true;
                if (!cached)
                    continue;
                const int encoded_rank = decode_dispatch_source_rank(
                    encoded, shard_capacity);
                const std::int32_t slot = decode_dispatch_local_index(
                    encoded, shard_capacity);
                if (encoded < 0 || encoded_rank != transport_world_rank ||
                    slot < 0 ||
                    static_cast<std::uint64_t>(slot) >= shard_capacity ||
                    (cached_slot >= 0 && cached_slot != slot)) {
                    error = DispatchProtocolError::kInvalidCachedSlot;
                    diagnostic_peer = static_cast<int>(
                        (encoded < 0 ? 300000U :
                         encoded_rank != transport_world_rank ? 400000U :
                         slot < 0 ? 500000U :
                         static_cast<std::uint64_t>(slot) >= shard_capacity ?
                             600000U : 700000U) +
                        index);
                    continue;
                }
                cached_slot = slot;
            }
            if (!selected)
                continue;

            const std::uint32_t shard_slot = cached ?
                static_cast<std::uint32_t>(cached_slot) : count;
            if (cached_slot < 0 && cached) {
                error = DispatchProtocolError::kInvalidCachedSlot;
                diagnostic_peer = static_cast<int>(
                    800000U + token * num_topk_u32);
            } else if (shard_slot >= shard_capacity_u32) {
                error = cached ? DispatchProtocolError::kInvalidCachedSlot :
                                 DispatchProtocolError::kCapacityOverflow;
                diagnostic_peer = static_cast<int>(
                    900000U + token * num_topk_u32);
            } else if (cached) {
                std::uint64_t word = 0;
                std::uint64_t mask = 0;
                if (!dispatch_simt_bitmap_location(
                        shard_slot, shard_capacity, &word, &mask)) {
                    error = DispatchProtocolError::kInvalidCachedSlot;
                    diagnostic_peer = static_cast<int>(
                        1000000U + token * num_topk_u32);
                } else if ((owner_bitmap[word] & mask) != 0) {
                    error = DispatchProtocolError::kInvalidCachedSlot;
                    diagnostic_peer = static_cast<int>(
                        0x10000000U |
                        ((token & 0x3fffU) << 14U) |
                        (shard_slot & 0x3fffU));
                } else {
                    owner_bitmap[word] |= mask;
                }
                if (maximum_slot < shard_slot + 1)
                    maximum_slot = shard_slot + 1;
            }

            if (!cached) {
                for (std::uint32_t lane = 0;
                     lane < num_topk_u32; ++lane) {
                    const std::uint32_t index =
                        token * num_topk_u32 + lane;
                    const std::int64_t expert = topk_indices[index];
                    if (expert >= 0 &&
                        static_cast<int>(
                            static_cast<std::uint64_t>(expert) /
                            num_local_experts) == destination_rank)
                        destination_slots[index] =
                            encode_dispatch_source_index(
                                static_cast<std::uint64_t>(
                                    transport_world_rank),
                                shard_capacity, shard_slot);
                }
            }
            ++count;
        }
        if (count > shard_capacity_u32 ||
            (cached && maximum_slot != count)) {
            if (error == DispatchProtocolError::kNone) {
                const std::uint32_t packed_counts =
                    ((count & 0x7fffU) << 15U) |
                    (maximum_slot & 0x7fffU);
                diagnostic_peer = static_cast<int>(
                    (count > shard_capacity_u32 ? 0x20000000U :
                                                   0x40000000U) |
                    packed_counts);
            }
            error = cached ? DispatchProtocolError::kInvalidCachedSlot :
                             DispatchProtocolError::kCapacityOverflow;
        }
        destination_counts[destination_rank] = count;
        maximum_slots[destination_rank] = maximum_slot;
        if (route_plan != nullptr && route_plan_words == world_size + 2U) {
            const DirectDispatchProducerRoutePlanLayout plan{
                route_plan, route_plan + world_size};
            route_plan[destination_rank] = count;
            if (destination_rank == 0) {
                plan.digest[0] = plan.digest[1] = 0;
            }
        }
        if (error != DispatchProtocolError::kNone)
            transport::simt::store_published(
                &errors[destination_rank], make_dispatch_protocol_failure(
                    diagnostic_peer,
                    DispatchProtocolStage::kProducer, generation,
                    error).scratch_status);
    }
}

struct DirectDispatchProducerPlanKernelArguments {
    __gm__ const std::int64_t* topk_indices;
    __gm__ std::int32_t* destination_slots;
    __gm__ std::uint8_t* workspace;
    int transport_world_rank;
    int transport_world_size;
    CoreModeFlags mode_flags;
    std::uint64_t generation;
    std::uint64_t num_tokens;
    std::uint64_t num_experts;
    std::uint64_t num_topk;
    std::uint64_t shard_capacity;
    std::uint64_t workspace_status_offset;
    std::uint64_t workspace_rank_counts_offset;
    std::uint64_t workspace_rank_values_offset;
    std::uint64_t dispatch_error_offset;
    std::uint64_t dispatch_rank_bitmap_offset;
    __gm__ std::uint64_t* route_plan;
    std::uint32_t route_plan_words;
    std::uint32_t vf_num_threads;
};

static_assert(offsetof(DirectDispatchProducerPlanKernelArguments,
                       transport_world_rank) ==
                  offsetof(DirectDispatchProducerPlanKernelArguments,
                           workspace) + sizeof(void*),
              "direct producer plan pointer/int ABI drift");
static_assert(offsetof(DirectDispatchProducerPlanKernelArguments,
                       generation) % alignof(std::uint64_t) == 0,
              "direct producer plan generation alignment");
static_assert(offsetof(DirectDispatchProducerPlanKernelArguments,
                       route_plan) % alignof(void*) == 0,
              "direct producer plan route plan alignment");
static_assert(offsetof(DirectDispatchProducerPlanKernelArguments,
                       vf_num_threads) + sizeof(std::uint32_t) ==
                  sizeof(DirectDispatchProducerPlanKernelArguments) ||
                  offsetof(DirectDispatchProducerPlanKernelArguments,
                           vf_num_threads) + sizeof(std::uint32_t) +
                          sizeof(std::uint32_t) ==
                      sizeof(DirectDispatchProducerPlanKernelArguments),
              "direct producer plan trailing ABI drift");

__global__ __vector__ void direct_dispatch_producer_plan_kernel(
    DirectDispatchProducerPlanKernelArguments arguments) {
    asc_vf_call<direct_dispatch_producer_plan_vf> (
        dim3(arguments.vf_num_threads), arguments.topk_indices, arguments.destination_slots, arguments.workspace, arguments.transport_world_rank, arguments.transport_world_size, arguments.mode_flags, arguments.generation, arguments.num_tokens, arguments.num_experts, arguments.num_topk, arguments.shard_capacity, arguments.workspace_status_offset, arguments.workspace_rank_counts_offset, arguments.workspace_rank_values_offset, arguments.dispatch_error_offset, arguments.dispatch_rank_bitmap_offset, arguments.route_plan, arguments.route_plan_words);
}

extern "C" int deep_ep_ascend_launch_direct_dispatch_producer_plan(
    const std::int64_t* topk_indices,
    std::int32_t* destination_slots,
    std::uint8_t* workspace,
    int transport_world_rank,
    int transport_world_size,
    CoreModeFlags mode_flags,
    std::uint64_t generation,
    std::uint64_t num_tokens,
    std::uint64_t num_experts,
    std::uint64_t num_topk,
    std::uint64_t shard_capacity,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    std::uint64_t dispatch_error_offset,
    std::uint64_t dispatch_rank_bitmap_offset,
    __gm__ std::uint64_t* route_plan,
    std::uint32_t route_plan_words,
    void* stream, CoreLaunchShape launch,
    std::uint32_t vf_num_threads) {
    const DirectDispatchProducerPlanKernelArguments arguments{
        topk_indices,
        destination_slots,
        workspace,
        transport_world_rank,
        transport_world_size,
        mode_flags,
        generation,
        num_tokens,
        num_experts,
        num_topk,
        shard_capacity,
        workspace_status_offset,
        workspace_rank_counts_offset,
        workspace_rank_values_offset,
        dispatch_error_offset,
        dispatch_rank_bitmap_offset,
        route_plan,
        route_plan_words,
        vf_num_threads};
    direct_dispatch_producer_plan_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(arguments);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

