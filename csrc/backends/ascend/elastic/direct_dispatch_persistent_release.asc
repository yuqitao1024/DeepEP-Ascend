__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_persistent_release_vf(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t dispatch_control_offset,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_local_count_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t dispatch_pipeline_bytes,
    std::uint64_t dispatch_group_tile_offset,
    std::uint64_t dispatch_group_tile_count,
    std::uint32_t release_chunk_tiles,
    std::uint32_t release_chunk_count,
    std::uint32_t producer_blocks,
    std::uint64_t token_stride_bytes) {
    if (threadIdx.x != 0)
        return;
    auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
        workspace + dispatch_pipeline_offset);
    const auto context = make_hybrid_dispatch_context(
        transport_abi_version, transport_struct_size,
        transport_capabilities, transport_local_window_base,
        transport_channel_table, transport_peer_address_table,
        transport_topology_abi_version, transport_topology_struct_size,
        transport_world_rank, transport_world_size,
        transport_scale_up_rank, transport_scale_up_size,
        transport_scale_out_rank, transport_scale_out_size,
        transport_scale_up_direct, transport_topology_kind,
        transport_topology_epoch, transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    auto* queue = transport::device::detail::command_queue(context);
    auto* diagnostic = transport::device::detail::diagnostic(queue);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    const std::uint64_t generation_wait_start = __asc_simt_vf::clock();
    while (transport::simt::load_observed(&pipeline->generation) !=
           generation) {
        dispatch_simt_poll_nop();
        if (dispatch_simt_pipeline_wait_timed_out(
                generation_wait_start, __asc_simt_vf::clock(),
                timeout_cycles)) {
            record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolStage::kProducer, generation,
                DispatchProtocolError::kInvalidControl, 0U);
            direct_dispatch_pipeline_fail_simt(
                pipeline, nullptr, workspace, workspace_status_offset,
                transport_world_rank, generation, 0U);
            return;
        }
    }
    if (static_cast<transport::DeviceTransportError>(
            transport::simt::load_observed(
                reinterpret_cast<__gm__ std::uint32_t*>(
                    &pipeline->terminal_error))) !=
        transport::DeviceTransportError::kNone)
        return;
    direct_dispatch_pipeline_stage_simt(
        pipeline, DispatchPipelineDiagnosticStage::kReleaseStarted, 0U);

    for (std::uint32_t release_chunk = 0;
         release_chunk < release_chunk_count; ++release_chunk) {
        auto* slot = &pipeline->slots[
            dispatch_simt_pipeline_slot(release_chunk)];
        const std::uint64_t ready_wait_start = __asc_simt_vf::clock();
        while (true) {
            dispatch_simt_poll_nop();
            const auto state = static_cast<DispatchPipelineSlotState>(
                transport::simt::load_observed(
                    reinterpret_cast<__gm__ std::uint32_t*>(&slot->state)));
            const std::uint32_t scalar_blocks =
                transport::simt::load_observed(
                    &slot->scalar_blocks_completed);
            const std::uint32_t hidden_blocks =
                transport::simt::load_observed(
                    &slot->hidden_blocks_completed);
            if (state == DispatchPipelineSlotState::kReady &&
                transport::simt::load_observed(&slot->chunk_index) ==
                    release_chunk &&
                transport::simt::load_observed(&slot->published_chunk) ==
                    release_chunk &&
                scalar_blocks == producer_blocks &&
                hidden_blocks == producer_blocks) {
                direct_dispatch_pipeline_stage_simt(
                    pipeline,
                    DispatchPipelineDiagnosticStage::kReleaseSawPayloadReady,
                    release_chunk);
                break;
            }
            if (state == DispatchPipelineSlotState::kFailed ||
                static_cast<DispatchPipelineWorkerState>(
                    transport::simt::load_observed(
                        reinterpret_cast<__gm__ std::uint32_t*>(
                            &pipeline->producer_worker_state))) ==
                    DispatchPipelineWorkerState::kFailed) {
                transport::simt::store_published(
                    reinterpret_cast<__gm__ std::uint32_t*>(
                        &pipeline->release_worker_state),
                    static_cast<std::uint32_t>(
                        DispatchPipelineWorkerState::kFailed));
                return;
            }
            if (dispatch_simt_pipeline_wait_timed_out(
                    ready_wait_start, __asc_simt_vf::clock(),
                    timeout_cycles)) {
                record_dispatch_protocol_error(
                    context, status_address, transport_world_rank,
                    DispatchProtocolStage::kProducer, generation,
                    DispatchProtocolError::kInvalidControl, release_chunk);
                direct_dispatch_pipeline_fail_simt(
                    pipeline, slot, workspace, workspace_status_offset,
                    transport_world_rank, generation, release_chunk);
                return;
            }
        }
        const std::uint64_t chunk_begin =
            static_cast<std::uint64_t>(release_chunk) * release_chunk_tiles;
        const std::uint64_t chunk_end =
            chunk_begin + release_chunk_tiles < dispatch_group_tile_count ?
                chunk_begin + release_chunk_tiles :
                dispatch_group_tile_count;
        direct_dispatch_producer_release_body(
            DEEP_EP_ASCEND_DISPATCH_RELEASE_ARGUMENTS,
            chunk_begin, chunk_end, release_chunk,
            release_chunk + 1U == release_chunk_count ? 1U : 0U,
            1U, token_stride_bytes,
            static_cast<std::uint32_t>(DirectReleaseSegment::kPayload));
        if (transport_world_size > 1) {
            const std::uint32_t batch_target =
                transport::simt::load_observed(
                    &slot->request.consumed_target);
            transport::simt::system_fence();
            transport::simt::store_published(
                &pipeline->release_batch_target, batch_target);
            direct_dispatch_pipeline_stage_simt(
                pipeline,
                DispatchPipelineDiagnosticStage::kReleaseBatchTargetPublished,
                release_chunk);
            const std::uint64_t batch_wait_start = __asc_simt_vf::clock();
            while (!dispatch_simt_pipeline_release_batch_acknowledged(
                batch_target,
                transport::simt::load_observed(
                    &pipeline->release_batch_consumed))) {
                dispatch_simt_poll_nop();
                if (static_cast<DispatchPipelineWorkerState>(
                        transport::simt::load_observed(
                            reinterpret_cast<__gm__ std::uint32_t*>(
                                &pipeline->release_worker_state))) ==
                    DispatchPipelineWorkerState::kFailed)
                    return;
                if (dispatch_simt_pipeline_wait_timed_out(
                    batch_wait_start, __asc_simt_vf::clock(),
                        timeout_cycles)) {
                    record_dispatch_protocol_error(
                        context, status_address, transport_world_rank,
                        DispatchProtocolStage::kProducer, generation,
                        DispatchProtocolError::kInvalidControl,
                        release_chunk);
                    direct_dispatch_pipeline_fail_simt(
                        pipeline, slot, workspace, workspace_status_offset,
                        transport_world_rank, generation, release_chunk);
                    return;
                }
            }
            transport.wait(&slot->request);
            if (slot->request.state !=
                    transport::DeviceRequestState::kCompleted) {
                transport::simt::store_published(
                    reinterpret_cast<__gm__ std::uint32_t*>(
                        &slot->state),
                    static_cast<std::uint32_t>(
                        DispatchPipelineSlotState::kFailed));
                transport::simt::store_published(
                    reinterpret_cast<__gm__ std::uint32_t*>(
                        &pipeline->terminal_error),
                    static_cast<std::uint32_t>(
                        slot->request.terminal_error));
                transport::simt::store_published(
                    reinterpret_cast<__gm__ std::uint32_t*>(
                        &pipeline->release_worker_state),
                    static_cast<std::uint32_t>(
                        DispatchPipelineWorkerState::kFailed));
                transport::simt::store_published(
                    reinterpret_cast<__gm__ std::uint32_t*>(
                        &pipeline->producer_worker_state),
                    static_cast<std::uint32_t>(
                        DispatchPipelineWorkerState::kFailed));
                return;
            }
            direct_dispatch_pipeline_stage_simt(
                pipeline, DispatchPipelineDiagnosticStage::kRequestCompleted,
                release_chunk);
        }
        transport::simt::system_fence();
        transport::simt::store_published(
            reinterpret_cast<__gm__ std::uint32_t*>(&slot->state),
            static_cast<std::uint32_t>(
                DispatchPipelineSlotState::kCompleted));
        const std::uint32_t completed_chunks =
            transport::simt::load_observed(&pipeline->completed_chunks);
        transport::simt::store_published(
            &pipeline->completed_chunks, completed_chunks + 1U);
    }

    const std::uint64_t final_chunk_begin =
        static_cast<std::uint64_t>(release_chunk_count - 1U) *
            release_chunk_tiles;
    const std::uint64_t final_chunk_end = dispatch_group_tile_count;
    direct_dispatch_producer_release_body(
        DEEP_EP_ASCEND_DISPATCH_RELEASE_ARGUMENTS,
        final_chunk_begin, final_chunk_end, release_chunk_count - 1U,
        1U, 1U, token_stride_bytes,
        static_cast<std::uint32_t>(DirectReleaseSegment::kControl));
    direct_dispatch_producer_release_body(
        DEEP_EP_ASCEND_DISPATCH_RELEASE_ARGUMENTS,
        final_chunk_begin, final_chunk_end, release_chunk_count - 1U,
        1U, 1U, token_stride_bytes,
        static_cast<std::uint32_t>(DirectReleaseSegment::kBarrier));
    if (transport_world_size > 1 && queue != nullptr) {
        const std::uint32_t final_target =
            transport::simt::load_observed(&queue->count);
        transport::simt::system_fence();
        transport::simt::store_published(
            &pipeline->release_batch_target, final_target);
        direct_dispatch_pipeline_stage_simt(
            pipeline,
            DispatchPipelineDiagnosticStage::kFinalBatchTargetPublished,
            final_target);
        const std::uint64_t final_wait_start = __asc_simt_vf::clock();
        while (!dispatch_simt_pipeline_release_batch_acknowledged(
            final_target,
            transport::simt::load_observed(
                &pipeline->release_batch_consumed))) {
            dispatch_simt_poll_nop();
            if (static_cast<DispatchPipelineWorkerState>(
                    transport::simt::load_observed(
                        reinterpret_cast<__gm__ std::uint32_t*>(
                            &pipeline->release_worker_state))) ==
                DispatchPipelineWorkerState::kFailed)
                return;
            if (dispatch_simt_pipeline_wait_timed_out(
                final_wait_start, __asc_simt_vf::clock(),
                timeout_cycles)) {
                record_dispatch_protocol_error(
                    context, status_address, transport_world_rank,
                    DispatchProtocolStage::kProducer, generation,
                    DispatchProtocolError::kInvalidControl, final_target);
                direct_dispatch_pipeline_fail_simt(
                    pipeline, nullptr, workspace, workspace_status_offset,
                    transport_world_rank, generation, final_target);
                return;
            }
        }
    }
    if (diagnostic != nullptr &&
        static_cast<transport::DeviceTransportError>(
            transport::simt::load_observed(
                reinterpret_cast<__gm__ std::uint32_t*>(
                    &diagnostic->error))) !=
            transport::DeviceTransportError::kNone) {
        transport::simt::store_published(
            reinterpret_cast<__gm__ std::uint32_t*>(
                &pipeline->release_worker_state),
            static_cast<std::uint32_t>(
                DispatchPipelineWorkerState::kFailed));
        return;
    }
    transport::simt::system_fence();
    transport::simt::store_published(
        &pipeline->release_completed_generation, generation);
    direct_dispatch_pipeline_stage_simt(
        pipeline, DispatchPipelineDiagnosticStage::kReleaseCompleted, 0U);
    transport::simt::store_published(
        reinterpret_cast<__gm__ std::uint32_t*>(
            &pipeline->release_worker_state),
        static_cast<std::uint32_t>(
            DispatchPipelineWorkerState::kCompleted));
}

__global__ __vector__ void direct_dispatch_persistent_release_kernel(
    __gm__ std::uint8_t* communication_buffer,
    __gm__ std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t dispatch_control_offset,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_local_count_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t dispatch_pipeline_bytes,
    std::uint64_t dispatch_group_tile_offset,
    std::uint64_t dispatch_group_tile_count,
    std::uint32_t release_chunk_tiles,
    std::uint32_t release_chunk_count,
    std::uint32_t producer_blocks,
    std::uint64_t token_stride_bytes,
    std::uint32_t vf_num_threads) {
    asc_vf_call<direct_dispatch_persistent_release_vf>(
        dim3(vf_num_threads), communication_buffer, workspace, transport_abi_version, transport_struct_size, transport_capabilities, transport_local_window_base, transport_channel_table, transport_peer_address_table, transport_topology_abi_version, transport_topology_struct_size, transport_world_rank, transport_world_size, transport_scale_up_rank, transport_scale_up_size, transport_scale_out_rank, transport_scale_out_size, transport_scale_up_direct, transport_topology_kind, transport_topology_epoch, transport_backend_context, generation, timeout_cycles, dispatch_control_offset, dispatch_receive_offset, dispatch_receive_shard_bytes, dispatch_staging_offset, dispatch_staging_shard_bytes, workspace_status_offset, workspace_local_count_offset, workspace_rank_counts_offset, dispatch_pipeline_offset, dispatch_pipeline_bytes, dispatch_group_tile_offset, dispatch_group_tile_count, release_chunk_tiles, release_chunk_count, producer_blocks, token_stride_bytes);
}

extern "C" int deep_ep_ascend_launch_direct_dispatch_persistent_release(
    std::uint8_t* communication_buffer,
    std::uint8_t* workspace,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank,
    int transport_world_size,
    int transport_scale_up_rank,
    int transport_scale_up_size,
    int transport_scale_out_rank,
    int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation,
    std::uint64_t timeout_cycles,
    std::uint64_t dispatch_control_offset,
    std::uint64_t dispatch_receive_offset,
    std::uint64_t dispatch_receive_shard_bytes,
    std::uint64_t dispatch_staging_offset,
    std::uint64_t dispatch_staging_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_local_count_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t dispatch_pipeline_bytes,
    std::uint64_t dispatch_group_tile_offset,
    std::uint64_t dispatch_group_tile_count,
    std::uint32_t release_chunk_tiles,
    std::uint32_t release_chunk_count,
    std::uint32_t producer_blocks,
    std::uint64_t token_stride_bytes,
    void* stream, CoreLaunchShape launch,
    std::uint32_t vf_num_threads) {
    direct_dispatch_persistent_release_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        communication_buffer, workspace, transport_abi_version, transport_struct_size, transport_capabilities, transport_local_window_base, transport_channel_table, transport_peer_address_table, transport_topology_abi_version, transport_topology_struct_size, transport_world_rank, transport_world_size, transport_scale_up_rank, transport_scale_up_size, transport_scale_out_rank, transport_scale_out_size, transport_scale_up_direct, transport_topology_kind, transport_topology_epoch, transport_backend_context, generation, timeout_cycles, dispatch_control_offset, dispatch_receive_offset, dispatch_receive_shard_bytes, dispatch_staging_offset, dispatch_staging_shard_bytes, workspace_status_offset, workspace_local_count_offset, workspace_rank_counts_offset, dispatch_pipeline_offset, dispatch_pipeline_bytes, dispatch_group_tile_offset, dispatch_group_tile_count, release_chunk_tiles, release_chunk_count, producer_blocks, token_stride_bytes, vf_num_threads);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
