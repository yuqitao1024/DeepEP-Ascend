__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_acquire_route_plan_vf(
    __gm__ std::uint8_t* workspace,
    __gm__ std::int32_t* prefix_per_rank,
    __gm__ std::int32_t* prefix_per_expert,
    __gm__ std::int32_t* unaligned_per_expert,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation, std::uint64_t timeout_cycles,
    std::uint64_t num_experts, std::uint64_t expert_alignment,
    std::uint64_t shard_capacity,
    std::uint64_t dispatch_output_capacity,
    std::uint64_t dispatch_route_plan_offset,
    std::uint64_t dispatch_route_plan_slot_bytes,
    std::uint64_t dispatch_route_plan_expert_capacity,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_route_source_counts_offset,
    std::uint64_t workspace_rank_values_offset) {
    if (threadIdx.x != 0)
        return;
    const auto context = make_hybrid_dispatch_context(
        transport_abi_version, transport_struct_size,
        transport_capabilities, transport_local_window_base,
        transport_channel_table, transport_peer_address_table,
        transport_topology_abi_version, transport_topology_struct_size,
        transport_world_rank, transport_world_size,
        transport_scale_up_rank, transport_scale_up_size,
        transport_scale_out_rank, transport_scale_out_size,
        transport_scale_up_direct, transport_topology_kind,
        transport_topology_epoch, transport_backend_context);
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address = reinterpret_cast<transport::DeviceAddress>(
        workspace + workspace_status_offset);
    if (transport.load_acquire(status_address) != 0 ||
        transport_world_size <= 0 || expert_alignment == 0 ||
        num_experts % static_cast<std::uint64_t>(transport_world_size) != 0)
        return;
    auto* source_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_route_source_counts_offset);
    auto* source_bases = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_rank_values_offset);
    const std::uint64_t local_experts =
        num_experts / static_cast<std::uint64_t>(transport_world_size);
    if (local_experts > dispatch_route_plan_expert_capacity) {
        record_dispatch_protocol_error(
            context, status_address, transport_world_rank,
            DispatchProtocolStage::kEpilogue, generation,
            DispatchProtocolError::kInvalidLayout);
        return;
    }

    std::uint64_t rank_prefix = 0;
    for (int source_rank = 0;
         source_rank < transport_world_size; ++source_rank) {
        if (source_rank != transport_world_rank &&
            !release_protocol::acquire_release(
                transport, context.topology, source_rank,
                transport::sync_layout::kDispatchRouteReadySignalIndex,
                generation, timeout_cycles)) {
            record_dispatch_protocol_error(
                context, status_address, source_rank,
                DispatchProtocolStage::kEpilogue, generation,
                DispatchProtocolError::kInvalidControl);
            return;
        }
        const auto slot = static_cast<transport::DeviceAddress>(
            transport_local_window_base + dispatch_route_plan_offset +
            static_cast<std::uint64_t>(source_rank) *
                dispatch_route_plan_slot_bytes);
        const std::uint64_t observed_generation =
            transport.load_acquire(slot);
        const std::uint64_t count = transport.load_acquire(
            slot + sizeof(std::uint64_t));
        if (observed_generation != generation || count > shard_capacity) {
            record_dispatch_protocol_error(
                context, status_address, source_rank,
                DispatchProtocolStage::kEpilogue, generation,
                count > shard_capacity ?
                    DispatchProtocolError::kCapacityOverflow :
                    DispatchProtocolError::kInvalidControl);
            return;
        }
        source_bases[source_rank] = rank_prefix;
        source_counts[source_rank] = count;
        rank_prefix += count;
        prefix_per_rank[source_rank] = static_cast<std::int32_t>(rank_prefix);
    }

    std::uint64_t expert_prefix = 0;
    const std::uint64_t first_local_expert =
        static_cast<std::uint64_t>(transport_world_rank) * local_experts;
    for (std::uint64_t expert = 0; expert < num_experts; ++expert) {
        std::uint64_t count = 0;
        if (expert >= first_local_expert &&
            expert < first_local_expert + local_experts) {
            const std::uint64_t local_expert = expert - first_local_expert;
            for (int source_rank = 0;
                 source_rank < transport_world_size; ++source_rank) {
                const auto count_address =
                    static_cast<transport::DeviceAddress>(
                        transport_local_window_base +
                        dispatch_route_plan_offset +
                        static_cast<std::uint64_t>(source_rank) *
                            dispatch_route_plan_slot_bytes +
                        sizeof(DispatchRoutePlanSlotHeader) +
                        local_expert * sizeof(std::uint64_t));
                count += transport.load_acquire(count_address);
            }
        }
        if (count > static_cast<std::uint64_t>(0x7fffffff)) {
            record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolStage::kEpilogue, generation,
                DispatchProtocolError::kCapacityOverflow);
            return;
        }
        prefix_per_expert[expert] = static_cast<std::int32_t>(expert_prefix);
        unaligned_per_expert[expert] = static_cast<std::int32_t>(count);
        const std::uint64_t aligned_count =
            (count + expert_alignment - 1) / expert_alignment *
            expert_alignment;
        if (aligned_count > dispatch_output_capacity ||
            expert_prefix > dispatch_output_capacity - aligned_count) {
            record_dispatch_protocol_error(
                context, status_address, transport_world_rank,
                DispatchProtocolStage::kEpilogue, generation,
                DispatchProtocolError::kCapacityOverflow);
            return;
        }
        expert_prefix += aligned_count;
    }
    prefix_per_expert[num_experts] =
        static_cast<std::int32_t>(expert_prefix);
}

struct DirectDispatchAcquireRoutePlanKernelArguments {
    __gm__ std::uint8_t* workspace;
    __gm__ std::int32_t* prefix_per_rank;
    __gm__ std::int32_t* prefix_per_expert;
    __gm__ std::int32_t* unaligned_per_expert;
    std::uint32_t transport_abi_version;
    std::uint32_t transport_struct_size;
    std::uint64_t transport_capabilities;
    std::uintptr_t transport_local_window_base;
    std::uintptr_t transport_channel_table;
    std::uintptr_t transport_peer_address_table;
    std::uint32_t transport_topology_abi_version;
    std::uint32_t transport_topology_struct_size;
    int transport_world_rank;
    int transport_world_size;
    int transport_scale_up_rank;
    int transport_scale_up_size;
    int transport_scale_out_rank;
    int transport_scale_out_size;
    std::uint32_t transport_scale_up_direct;
    std::uint32_t transport_topology_kind;
    std::uint64_t transport_topology_epoch;
    std::uintptr_t transport_backend_context;
    std::uint64_t generation;
    std::uint64_t timeout_cycles;
    std::uint64_t num_experts;
    std::uint64_t expert_alignment;
    std::uint64_t shard_capacity;
    std::uint64_t dispatch_output_capacity;
    std::uint64_t dispatch_route_plan_offset;
    std::uint64_t dispatch_route_plan_slot_bytes;
    std::uint64_t dispatch_route_plan_expert_capacity;
    std::uint64_t workspace_status_offset;
    std::uint64_t workspace_route_source_counts_offset;
    std::uint64_t workspace_rank_values_offset;
    std::uint32_t vf_num_threads;
};

__global__ __vector__ void direct_dispatch_acquire_route_plan_kernel(
    DirectDispatchAcquireRoutePlanKernelArguments arguments) {
    asc_vf_call<direct_dispatch_acquire_route_plan_vf> (
        dim3(arguments.vf_num_threads), arguments.workspace, arguments.prefix_per_rank, arguments.prefix_per_expert, arguments.unaligned_per_expert, arguments.transport_abi_version, arguments.transport_struct_size, arguments.transport_capabilities, arguments.transport_local_window_base, arguments.transport_channel_table, arguments.transport_peer_address_table, arguments.transport_topology_abi_version, arguments.transport_topology_struct_size, arguments.transport_world_rank, arguments.transport_world_size, arguments.transport_scale_up_rank, arguments.transport_scale_up_size, arguments.transport_scale_out_rank, arguments.transport_scale_out_size, arguments.transport_scale_up_direct, arguments.transport_topology_kind, arguments.transport_topology_epoch, arguments.transport_backend_context, arguments.generation, arguments.timeout_cycles, arguments.num_experts, arguments.expert_alignment, arguments.shard_capacity, arguments.dispatch_output_capacity, arguments.dispatch_route_plan_offset, arguments.dispatch_route_plan_slot_bytes, arguments.dispatch_route_plan_expert_capacity, arguments.workspace_status_offset, arguments.workspace_route_source_counts_offset, arguments.workspace_rank_values_offset);
}

extern "C" int deep_ep_ascend_launch_direct_dispatch_acquire_route_plan(
    std::uint8_t* workspace,
    std::int32_t* prefix_per_rank,
    std::int32_t* prefix_per_expert,
    std::int32_t* unaligned_per_expert,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank,
    int transport_world_size,
    int transport_scale_up_rank,
    int transport_scale_up_size,
    int transport_scale_out_rank,
    int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    std::uint64_t generation,
    std::uint64_t timeout_cycles,
    std::uint64_t num_experts,
    std::uint64_t expert_alignment,
    std::uint64_t shard_capacity,
    std::uint64_t dispatch_output_capacity,
    std::uint64_t dispatch_route_plan_offset,
    std::uint64_t dispatch_route_plan_slot_bytes,
    std::uint64_t dispatch_route_plan_expert_capacity,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_route_source_counts_offset,
    std::uint64_t workspace_rank_values_offset,
    void* stream, CoreLaunchShape launch,
    std::uint32_t vf_num_threads) {
    const DirectDispatchAcquireRoutePlanKernelArguments arguments{
        workspace,
        prefix_per_rank,
        prefix_per_expert,
        unaligned_per_expert,
        transport_abi_version,
        transport_struct_size,
        transport_capabilities,
        transport_local_window_base,
        transport_channel_table,
        transport_peer_address_table,
        transport_topology_abi_version,
        transport_topology_struct_size,
        transport_world_rank,
        transport_world_size,
        transport_scale_up_rank,
        transport_scale_up_size,
        transport_scale_out_rank,
        transport_scale_out_size,
        transport_scale_up_direct,
        transport_topology_kind,
        transport_topology_epoch,
        transport_backend_context,
        generation,
        timeout_cycles,
        num_experts,
        expert_alignment,
        shard_capacity,
        dispatch_output_capacity,
        dispatch_route_plan_offset,
        dispatch_route_plan_slot_bytes,
        dispatch_route_plan_expert_capacity,
        workspace_status_offset,
        workspace_route_source_counts_offset,
        workspace_rank_values_offset,
        vf_num_threads};
    direct_dispatch_acquire_route_plan_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(arguments);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
