__simt_vf__ __launch_bounds__(512) inline void combine_epilogue_vf(
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ const float* topk_weights,
    __gm__ const bfloat16_t* bias_0,
    __gm__ const bfloat16_t* bias_1,
    __gm__ std::uint8_t* workspace,
    __gm__ bfloat16_t* combined_x,
    __gm__ float* combined_topk_weights,
    std::uint32_t transport_abi_version,
    std::uint32_t transport_struct_size,
    std::uint64_t transport_capabilities,
    std::uintptr_t transport_local_window_base,
    std::uintptr_t transport_channel_table,
    std::uintptr_t transport_peer_address_table,
    std::uint32_t transport_topology_abi_version,
    std::uint32_t transport_topology_struct_size,
    int transport_world_rank, int transport_world_size,
    int transport_scale_up_rank, int transport_scale_up_size,
    int transport_scale_out_rank, int transport_scale_out_size,
    std::uint32_t transport_scale_up_direct,
    std::uint32_t transport_topology_kind,
    std::uint64_t transport_topology_epoch,
    std::uintptr_t transport_backend_context,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t timeout_cycles, std::uint64_t num_tokens,
    std::uint64_t num_experts, std::uint64_t num_topk,
    std::uint64_t shard_capacity, std::uint64_t combine_record_bytes,
    std::uint64_t combine_weight_offset,
    std::uint64_t control_offset,
    std::uint64_t combine_control_offset,
    std::uint64_t combine_control_bytes,
    std::uint64_t combine_receive_offset,
    std::uint64_t combine_receive_shard_bytes,
    std::uint64_t combine_receive_shard_count,
    std::uint64_t combine_receive_bytes,
    std::uint64_t workspace_scratch_status_offset,
    std::uint64_t workspace_scratch_rank_counts_offset,
    std::uint64_t workspace_scratch_rank_count,
    std::uint64_t hidden_elements) {
    if (threadIdx.x != 0)
        return;

    transport::DeviceTransportContext context{};
    context.abi_version = transport_abi_version;
    context.struct_size = transport_struct_size;
    context.capabilities = transport_capabilities;
    context.topology.abi_version = transport_topology_abi_version;
    context.topology.struct_size = transport_topology_struct_size;
    context.topology.world_rank = transport_world_rank;
    context.topology.world_size = transport_world_size;
    context.topology.scale_up_rank = transport_scale_up_rank;
    context.topology.scale_up_size = transport_scale_up_size;
    context.topology.scale_out_rank = transport_scale_out_rank;
    context.topology.scale_out_size = transport_scale_out_size;
    context.topology.scale_up_direct = transport_scale_up_direct != 0;
    context.topology.kind = static_cast<transport::TransportTopologyKind>(
        transport_topology_kind);
    context.topology.epoch = transport_topology_epoch;
    context.local_window_base = transport_local_window_base;
    context.channel_table = transport_channel_table;
    context.peer_address_table = transport_peer_address_table;
    context.backend_context = transport_backend_context;
    transport::DeviceTransportFacade transport(context, 0);
    const auto status_address =
        reinterpret_cast<transport::DeviceAddress>(
            workspace + workspace_scratch_status_offset);
    if (transport.load_acquire(status_address) != 0)
        return;
    if (!is_valid_combine_token_extent(num_tokens, shard_capacity))
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kCapacityOverflow);
    const auto consumed_generation = transport.consumed_generation();
    auto* queue = transport::device::detail::command_queue(context);
    auto* diagnostic = transport::device::detail::diagnostic(queue);
    if (diagnostic == nullptr)
        return;
    const auto diagnostic_abi_version =
        transport::simt::load_observed(&diagnostic->abi_version);
    const auto diagnostic_generation =
        transport::simt::load_observed(&diagnostic->generation);
    const auto diagnostic_error =
        static_cast<transport::DeviceTransportError>(
            transport::simt::load_observed(
                reinterpret_cast<__gm__ const std::uint32_t*>(
                    &diagnostic->error)));
    if (!is_clean_combine_transport_completion(
            generation, consumed_generation, diagnostic_abi_version,
            diagnostic_generation, diagnostic_error))
        return;

    if (workspace_scratch_rank_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        combine_control_bytes <
            static_cast<std::uint64_t>(transport_world_size) *
                sizeof(CombineControlSlot) ||
        combine_receive_shard_count !=
            static_cast<std::uint64_t>(transport_world_size) ||
        combine_receive_bytes <
            combine_receive_shard_count * combine_receive_shard_bytes)
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kInvalidLayout);

    const bool expanded = (mode_flags & (CoreModeFlags{1} <<
        static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    const bool allow_multiple_reduction = (mode_flags & (CoreModeFlags{1} <<
        static_cast<std::uint8_t>(CoreMode::kAllowMultipleReduction))) != 0;
    const bool hybrid = (mode_flags & (CoreModeFlags{1} <<
        static_cast<std::uint8_t>(CoreMode::kHybrid))) != 0;
    const auto record_trailer =
        combine_record_trailer_layout(combine_record_bytes, hybrid);
    const std::uint64_t record_capacity = expanded && !allow_multiple_reduction ?
        shard_capacity * num_topk : shard_capacity;
    auto* contributor_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_scratch_rank_counts_offset);
    auto* control_slots = reinterpret_cast<__gm__ CombineControlSlot*>(
        transport_local_window_base + combine_control_offset);
    for (int contributor_rank = 0;
         contributor_rank < transport_world_size; ++contributor_rank) {
        const auto release_boundary = combine_release_boundary(
            transport_world_rank, contributor_rank,
            transport_scale_up_size);
        const auto observation =
            release_protocol::observe_release_control(
                transport, context.topology, release_boundary,
                transport_world_rank, control_slots,
                transport::sync_layout::kCombineReleaseSignalIndex,
                generation, timeout_cycles);
        if (!observation.acquired)
            return record_combine_protocol_error(
                context, status_address, contributor_rank,
                CombineProtocolError::kInvalidControl);
        const std::uint64_t observed_generation = observation.generation;
        const std::uint64_t record_count = observation.count;
        if (observed_generation != generation ||
            record_count > record_capacity ||
            record_count * combine_record_bytes >
                combine_receive_shard_bytes)
            return record_combine_protocol_error(
                context, status_address, contributor_rank,
                record_count > record_capacity ?
                    CombineProtocolError::kCapacityOverflow :
                    CombineProtocolError::kInvalidControl);
        contributor_counts[contributor_rank] = record_count;
    }

    const std::uint64_t hidden_bytes =
        hidden_elements * sizeof(std::uint16_t);
    if (!record_trailer.valid ||
        hidden_bytes > combine_weight_offset ||
        combine_weight_offset > record_trailer.header_offset ||
        num_topk >
            (record_trailer.header_offset - combine_weight_offset) /
                sizeof(float))
        return record_combine_protocol_error(
            context, status_address, transport_world_rank,
            CombineProtocolError::kInvalidLayout);
    const std::uint64_t num_local_experts =
        num_experts / static_cast<std::uint64_t>(transport_world_size);
    // Validate all record headers before reading any payload or writing output.
    for (int contributor_rank = 0;
         contributor_rank < transport_world_size; ++contributor_rank) {
        auto* receive_shard = reinterpret_cast<__gm__ const std::uint8_t*>(
            combine_receive_shard_address(
                transport_local_window_base, combine_receive_offset,
                static_cast<std::uint64_t>(contributor_rank),
                combine_receive_shard_bytes));
        for (std::uint64_t slot = 0;
             slot < contributor_counts[contributor_rank]; ++slot) {
            auto* header =
                reinterpret_cast<__gm__ const CombineRecordHeader*>(
                    receive_shard + slot * combine_record_bytes +
                    record_trailer.header_offset);
            const auto observed_header =
                load_observed_combine_record_header(header);
            const bool valid_token = is_valid_combine_origin_token(
                observed_header.origin_token, num_tokens, shard_capacity);
            bool valid_lanes = false;
            if (valid_token)
                valid_lanes = is_valid_combine_record_lanes(
                    combined_topk_indices +
                        static_cast<std::uint64_t>(
                            observed_header.origin_token) *
                            num_topk,
                    num_topk, num_experts, num_local_experts,
                    contributor_rank, observed_header.master_lane,
                    observed_header.contribution_lane, expanded,
                    allow_multiple_reduction);
            if (observed_header.abi_version != kCombineRecordAbiVersion ||
                observed_header.struct_size != sizeof(CombineRecordHeader) ||
                observed_header.contributor_rank != contributor_rank ||
                !valid_token || !valid_lanes)
                return record_combine_protocol_error(
                    context, status_address, contributor_rank,
                    CombineProtocolError::kInvalidHeader);
            for (std::uint64_t prior = 0; prior < slot; ++prior) {
                auto* prior_header =
                    reinterpret_cast<__gm__ const CombineRecordHeader*>(
                        receive_shard + prior * combine_record_bytes +
                        record_trailer.header_offset);
                const auto observed_prior =
                    load_observed_combine_record_header(prior_header);
                if (observed_prior.origin_token ==
                        observed_header.origin_token &&
                    (!expanded || allow_multiple_reduction ||
                     observed_prior.contribution_lane ==
                         observed_header.contribution_lane))
                    return record_combine_protocol_error(
                        context, status_address, contributor_rank,
                        CombineProtocolError::kDuplicateRecord);
            }
        }
    }

    const CombineOriginDeviceRecordSource origin_records{
        reinterpret_cast<__gm__ const std::uint8_t*>(
            transport_local_window_base + combine_receive_offset),
        combine_receive_shard_bytes, combine_record_bytes,
        record_trailer.header_offset,
        combine_weight_offset, hidden_elements, contributor_counts,
        workspace_scratch_rank_count};
    for (std::uint64_t token = 0; token < num_tokens; ++token) {
        for (std::uint64_t hidden = 0;
             hidden < hidden_elements; ++hidden) {
            const float value = combine_reduce_origin_records(
                origin_records,
                static_cast<std::uint64_t>(transport_world_size),
                static_cast<std::int32_t>(token), combined_topk_indices,
                num_topk, num_experts, num_local_experts, expanded,
                allow_multiple_reduction, hidden,
                bias_0 == nullptr ? 0.0F : static_cast<float>(
                    bias_0[token * hidden_elements + hidden]),
                bias_1 == nullptr ? 0.0F : static_cast<float>(
                    bias_1[token * hidden_elements + hidden]), nullptr);
            combined_x[token * hidden_elements + hidden] =
                static_cast<bfloat16_t>(value);
        }
    }
    if (combined_topk_weights != nullptr) {
        for (std::uint64_t token = 0; token < num_tokens; ++token) {
            (void)combine_reduce_origin_records(
                origin_records,
                static_cast<std::uint64_t>(transport_world_size),
                static_cast<std::int32_t>(token), combined_topk_indices,
                num_topk, num_experts, num_local_experts, expanded,
                allow_multiple_reduction, hidden_elements, 0.0F, 0.0F,
                combined_topk_weights + token * num_topk);
        }
    }

    auto* control = reinterpret_cast<__gm__ SymmetricControlHeader*>(
        transport_local_window_base + control_offset);
    transport.store_release(
        reinterpret_cast<transport::DeviceAddress>(
            &control->combine_generation), generation);
}

__global__ __vector__ void combine_epilogue_kernel(
    __gm__ const std::uint16_t* x,
    __gm__ const float* topk_weights,
    __gm__ const std::int32_t* source_metadata,
    __gm__ const HybridRouteRecord* route_records,
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ const std::int32_t* prefix_per_rank,
    __gm__ std::uint8_t* workspace,
    __gm__ std::uint16_t* combined_x,
    __gm__ float* combined_topk_weights,
    __gm__ const std::uint16_t* bias_0,
    __gm__ const std::uint16_t* bias_1,
    CombineVfScalars scalars) {
    const auto route_record_count = scalars.route_record_count;
    const auto generation = scalars.generation;
    const auto timeout_cycles = scalars.timeout_cycles;
    const auto num_source_rows = scalars.num_source_rows;
    const auto num_input_rows = scalars.num_input_rows;
    const auto local_window_base = scalars.local_window_base;
    const auto expanded_vector_reduce = scalars.expanded_vector_reduce;
    const auto local_copy_datacopy = scalars.local_copy_datacopy;
    const auto direct_local_placement = scalars.direct_local_placement;
    const auto vector_reduce_tile_elements = scalars.vector_reduce_tile_elements;
    const auto stage = scalars.stage;
    const auto profile_enabled = scalars.profile_enabled;
    const auto tiling = scalars.tiling;
    const auto release_segment = direct_combine_release_segment(stage, profile_enabled);
    const std::uint64_t hybrid_record_capacity =
        (tiling.mode_flags & (CoreModeFlags{1} << static_cast<std::uint8_t>(
            CoreMode::kExpanded))) != 0 &&
        (tiling.mode_flags & (CoreModeFlags{1} << static_cast<std::uint8_t>(
            CoreMode::kAllowMultipleReduction))) == 0 ?
            tiling.num_max_tokens_per_rank * tiling.num_topk :
            tiling.num_max_tokens_per_rank;
    asc_vf_call<combine_epilogue_vf>(
        dim3(tiling.launch.num_threads),
        combined_topk_indices,
        topk_weights,
        reinterpret_cast<__gm__ const bfloat16_t*>(bias_0),
        reinterpret_cast<__gm__ const bfloat16_t*>(bias_1),
        workspace,
        reinterpret_cast<__gm__ bfloat16_t*>(combined_x),
        combined_topk_weights,
        tiling.transport_context.abi_version,
        tiling.transport_context.struct_size,
        tiling.transport_context.capabilities,
        local_window_base,
        tiling.transport_context.channel_table,
        tiling.transport_context.peer_address_table,
        tiling.transport_context.topology.abi_version,
        tiling.transport_context.topology.struct_size,
        tiling.transport_context.topology.world_rank,
        tiling.transport_context.topology.world_size,
        tiling.transport_context.topology.scale_up_rank,
        tiling.transport_context.topology.scale_up_size,
        tiling.transport_context.topology.scale_out_rank,
        tiling.transport_context.topology.scale_out_size,
        static_cast<std::uint32_t>(
            tiling.transport_context.topology.scale_up_direct),
        static_cast<std::uint32_t>(tiling.transport_context.topology.kind),
        tiling.transport_context.topology.epoch,
        tiling.transport_context.backend_context,
        tiling.mode_flags,
        generation,
        timeout_cycles,
        tiling.num_tokens,
        tiling.num_experts,
        tiling.num_topk,
        tiling.num_max_tokens_per_rank,
        tiling.symmetric_window_layout.combine_record_bytes,
        tiling.symmetric_window_layout.combine_weight_offset,
        tiling.symmetric_window_layout.control_offset,
        tiling.symmetric_window_layout.combine_control_offset,
        tiling.symmetric_window_layout.combine_control_bytes,
        tiling.symmetric_window_layout.combine_receive_offset,
        tiling.symmetric_window_layout.combine_receive_shard_bytes,
        tiling.symmetric_window_layout.combine_receive_shard_count,
        tiling.symmetric_window_layout.combine_receive_bytes,
        tiling.workspace_layout.scratch_status_offset,
        tiling.workspace_layout.scratch_rank_counts_offset,
        tiling.workspace_layout.scratch_rank_count,
        tiling.hidden);
}

extern "C" int deep_ep_ascend_launch_vf_combine_epilogue(
    CombineArguments arguments, CoreTiling tiling,
    DirectCombineStage stage, bool profile_enabled,
    void* stream, CoreLaunchShape launch) {
    const CombineVfScalars scalars{
        arguments.route_record_count, arguments.generation,
        arguments.timeout_cycles,
        arguments.num_source_rows, arguments.num_input_rows,
        arguments.local_window_base, arguments.expanded_vector_reduce,
        arguments.local_copy_datacopy, arguments.direct_local_placement,
        arguments.vector_reduce_tile_elements, stage, profile_enabled, tiling};
    combine_epilogue_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        static_cast<const std::uint16_t*>(arguments.x),
        arguments.topk_weights, arguments.source_metadata,
        arguments.route_records, arguments.combined_topk_indices,
        arguments.prefix_per_rank,
        static_cast<std::uint8_t*>(arguments.workspace),
        static_cast<std::uint16_t*>(arguments.combined_x),
        arguments.combined_topk_weights,
        static_cast<const std::uint16_t*>(arguments.bias_0),
        static_cast<const std::uint16_t*>(arguments.bias_1), scalars);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
