#include "../transport/device_transport_facade.hpp"

namespace deep_ep::ascend::elastic {

#include "dispatch_device_common.hpp"

__simt_vf__ __launch_bounds__(512) inline void
direct_dispatch_cached_route_plan_vf(
    __gm__ const std::int64_t* topk_indices,
    __gm__ const std::int32_t* destination_slots,
    __gm__ std::uint64_t* route_plan,
    std::uint32_t route_plan_words,
    int transport_world_rank,
    int transport_world_size,
    std::uint64_t num_tokens,
    std::uint64_t num_experts,
    std::uint64_t num_topk,
    std::uint64_t shard_capacity) {
    if (route_plan == nullptr ||
        route_plan_words !=
            static_cast<std::uint32_t>(transport_world_size) + 2U)
        return;
    if (transport_world_size <= 0 ||
        static_cast<std::uint32_t>(transport_world_size) >
            kTopkSubgroupWidth)
        return;
    const std::uint32_t world_size =
        static_cast<std::uint32_t>(transport_world_size);
    const std::uint32_t workers = blockDim.x;
    const std::uint32_t worker = threadIdx.x;
    std::uint64_t route_digest = 0;
    std::uint64_t rank_counts[kTopkSubgroupWidth] = {};
    const std::uint32_t num_tokens_u32 =
        static_cast<std::uint32_t>(num_tokens);
    const std::uint32_t num_experts_u32 =
        static_cast<std::uint32_t>(num_experts);
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t local_experts = num_experts_u32 / world_size;
    for (std::uint32_t token = worker; token < num_tokens_u32;
         token += workers) {
        std::uint32_t selected_ranks = 0;
        for (std::uint32_t lane = 0; lane < num_topk_u32; ++lane) {
            const std::uint32_t index = token * num_topk_u32 + lane;
            const std::int64_t expert = topk_indices[index];
            const std::int32_t encoded = destination_slots[index];
            route_digest += cached_route_digest_entry(
                static_cast<std::uint64_t>(expert),
                static_cast<std::uint64_t>(
                    static_cast<std::int64_t>(encoded)));
            if (expert < 0 ||
                static_cast<std::uint64_t>(expert) >= num_experts)
                continue;
            const std::uint32_t destination =
                static_cast<std::uint32_t>(expert) / local_experts;
            if (destination >= world_size ||
                decode_dispatch_source_rank(encoded, shard_capacity) !=
                    transport_world_rank ||
                decode_dispatch_local_index(encoded, shard_capacity) < 0)
                continue;
            selected_ranks |= std::uint32_t{1} << destination;
        }
        while (selected_ranks != 0) {
            const std::uint32_t destination =
                static_cast<std::uint32_t>(
                    __builtin_ctz(selected_ranks));
            ++rank_counts[destination];
            selected_ranks &= selected_ranks - 1U;
        }
    }

    __ubuf__ std::uint32_t scratch[1 + 2 * kTopkSubgroupWidth];
    __ubuf__ std::uint32_t* shared_digest = scratch;
    __ubuf__ std::uint32_t* shared_counts = scratch + 1;
    if (worker == 0) {
        shared_digest[0] = shared_digest[1] = 0;
        for (std::uint32_t rank = 0; rank < world_size; ++rank)
            shared_counts[2 * rank] = shared_counts[2 * rank + 1] = 0;
    }
    asc_syncthreads();
    for (std::uint32_t shift = 0; shift < 64U; shift += 32U)
        (void)asc_atomic_add(
            &shared_digest[shift / 32U],
            static_cast<std::uint32_t>(route_digest >> shift));
    for (std::uint32_t rank = 0; rank < world_size; ++rank) {
        for (std::uint32_t shift = 0; shift < 64U; shift += 32U)
            (void)asc_atomic_add(
                &shared_counts[2 * rank + shift / 32U],
                static_cast<std::uint32_t>(rank_counts[rank] >> shift));
    }
    asc_syncthreads();
    if (worker == 0) {
        for (std::uint32_t rank = 0; rank < world_size; ++rank)
            route_plan[rank] =
                static_cast<std::uint64_t>(shared_counts[2 * rank]) |
                (static_cast<std::uint64_t>(
                     shared_counts[2 * rank + 1]) << 32U);
        route_plan[world_size] =
            static_cast<std::uint64_t>(shared_digest[0]) |
            (static_cast<std::uint64_t>(shared_digest[1]) << 32U);
        route_plan[world_size + 1U] = std::uint64_t{0};
    }
}

struct DirectDispatchCachedRoutePlanKernelArguments {
    __gm__ const std::int64_t* topk_indices;
    __gm__ const std::int32_t* destination_slots;
    __gm__ std::uint64_t* route_plan;
    std::uint32_t route_plan_words;
    int transport_world_rank, transport_world_size;
    std::uint64_t num_tokens, num_experts, num_topk, shard_capacity;
    std::uint32_t vf_num_threads;
};

__global__ __vector__ void direct_dispatch_cached_route_plan_kernel(
    DirectDispatchCachedRoutePlanKernelArguments arguments) {
    asc_vf_call<direct_dispatch_cached_route_plan_vf>(
        dim3(arguments.vf_num_threads), arguments.topk_indices,
        arguments.destination_slots, arguments.route_plan,
        arguments.route_plan_words, arguments.transport_world_rank,
        arguments.transport_world_size, arguments.num_tokens,
        arguments.num_experts, arguments.num_topk, arguments.shard_capacity);
}

extern "C" int deep_ep_ascend_launch_direct_dispatch_cached_route_plan(
    __gm__ const std::int64_t* topk_indices,
    __gm__ const std::int32_t* destination_slots,
    __gm__ std::uint64_t* route_plan,
    std::uint32_t route_plan_words,
    int transport_world_rank,
    int transport_world_size,
    std::uint64_t num_tokens,
    std::uint64_t num_experts,
    std::uint64_t num_topk,
    std::uint64_t shard_capacity,
    void* stream) {
    const DirectDispatchCachedRoutePlanKernelArguments arguments{
        topk_indices, destination_slots, route_plan, route_plan_words,
        transport_world_rank, transport_world_size, num_tokens, num_experts,
        num_topk, shard_capacity, 512U};
    direct_dispatch_cached_route_plan_kernel<<<
        1, 0, static_cast<aclrtStream>(stream)>>>(arguments);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
