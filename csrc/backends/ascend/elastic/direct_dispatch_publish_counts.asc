#include <cstdint>

#include "acl/acl.h"
#include "c_api/sync/sync.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "simt_api/device_sync_functions.h"

namespace deep_ep::ascend::elastic {

__simt_vf__ __launch_bounds__(512) inline void
direct_dispatch_publish_counts_vf(
    __gm__ const std::int32_t* kernel_expert_prefix,
    __gm__ const std::int32_t* kernel_unaligned,
    __gm__ std::int32_t* public_expert_prefix,
    __gm__ std::int32_t* public_unaligned,
    std::uint32_t num_experts,
    std::uint32_t local_experts,
    std::uint32_t world_rank,
    std::uint32_t world_size,
    std::uint32_t expert_alignment,
    std::uint32_t expand_mode) {
    const std::uint32_t first_local_expert = world_rank * local_experts;
    const std::uint32_t local_expert = threadIdx.x;
    if (local_expert >= local_experts || local_experts * world_size != num_experts)
        return;

    const std::uint32_t expert = first_local_expert + local_expert;
    const std::uint32_t actual =
        static_cast<std::uint32_t>(kernel_unaligned[expert]);
    const std::uint32_t aligned_count =
        (actual + expert_alignment - 1) / expert_alignment *
        expert_alignment;
    public_expert_prefix[local_expert] =
        kernel_expert_prefix[expert] +
        (expand_mode != 0 ?
            static_cast<std::int32_t>(actual) :
            static_cast<std::int32_t>(aligned_count));
    public_unaligned[local_expert] = static_cast<std::int32_t>(actual);
}

struct DirectDispatchPublishCountsKernelArguments {
    __gm__ const std::int32_t* kernel_expert_prefix;
    __gm__ const std::int32_t* kernel_unaligned;
    __gm__ std::int32_t* public_expert_prefix;
    __gm__ std::int32_t* public_unaligned;
    std::uint32_t num_experts;
    std::uint32_t local_experts;
    std::uint32_t world_rank;
    std::uint32_t world_size;
    std::uint32_t expert_alignment;
    std::uint32_t expand_mode;
    std::uint32_t vf_num_threads;
};

__global__ __vector__ void direct_dispatch_publish_counts_kernel(
    DirectDispatchPublishCountsKernelArguments arguments) {
    asc_vf_call<direct_dispatch_publish_counts_vf>(
        dim3(arguments.vf_num_threads), arguments.kernel_expert_prefix,
        arguments.kernel_unaligned, arguments.public_expert_prefix,
        arguments.public_unaligned, arguments.num_experts,
        arguments.local_experts, arguments.world_rank,
        arguments.world_size, arguments.expert_alignment,
        arguments.expand_mode);
}

extern "C" int deep_ep_ascend_launch_direct_dispatch_publish_counts(
    const std::int32_t* kernel_expert_prefix,
    const std::int32_t* kernel_unaligned,
    std::int32_t* public_expert_prefix,
    std::int32_t* public_unaligned,
    std::uint32_t num_experts,
    std::uint32_t local_experts,
    std::uint32_t world_rank,
    std::uint32_t world_size,
    std::uint32_t expert_alignment,
    std::uint32_t expand_mode,
    void* stream, std::uint32_t vf_num_threads) {
    const DirectDispatchPublishCountsKernelArguments arguments{
        kernel_expert_prefix, kernel_unaligned, public_expert_prefix,
        public_unaligned, num_experts, local_experts, world_rank,
        world_size, expert_alignment, expand_mode, vf_num_threads};
    direct_dispatch_publish_counts_kernel<<<1, 0,
        static_cast<aclrtStream>(stream)>>>(arguments);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
