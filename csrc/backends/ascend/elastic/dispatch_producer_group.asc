#include <cstdint>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"

#define DEEP_EP_ASCEND_SIMT_DEVICE 1
#define DEEP_EP_ASCEND_TOPK_GROUPING_DEVICE 1
#include "kernels.hpp"
#include "dispatch_state.hpp"
#include "topk_grouping.hpp"
#include "../transport/aicore_transport_service.hpp"
#include "../transport/device_transport_facade.hpp"

namespace deep_ep::ascend::elastic {

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_producer_group_vf(
    __gm__ const std::int64_t* topk_indices,
    __gm__ std::int32_t* destination_slots,
    __gm__ std::uint8_t* workspace,
    int transport_world_rank, int transport_world_size,
    CoreModeFlags mode_flags, std::uint64_t generation,
    std::uint64_t num_tokens, std::uint64_t num_experts,
    std::uint64_t num_topk, std::uint64_t workspace_status_offset,
    std::uint64_t dispatch_group_owner_offset,
    std::uint64_t dispatch_group_tile_offset,
    std::uint64_t dispatch_group_tile_count,
    std::uint64_t dispatch_group_expert_count_offset,
    std::uint64_t dispatch_group_expert_count,
    std::uint64_t dispatch_group_error_offset) {
    auto* status = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + workspace_status_offset);
    if (transport::simt::load_observed(status) != 0 ||
        num_topk > kTopkSubgroupWidth ||
        transport_world_size > static_cast<int>(kTopkSubgroupWidth))
        return;

    const std::uint32_t num_tokens_u32 =
        static_cast<std::uint32_t>(num_tokens);
    const std::uint32_t num_experts_u32 =
        static_cast<std::uint32_t>(num_experts);
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t tile_count_u32 =
        static_cast<std::uint32_t>(dispatch_group_tile_count);
    const bool cached = (mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kCached))) != 0;
    const std::uint32_t world_size =
        static_cast<std::uint32_t>(transport_world_size);
    const std::uint32_t num_local_experts = num_experts_u32 / world_size;
    auto* owners = reinterpret_cast<__gm__ std::int32_t*>(
        workspace + dispatch_group_owner_offset);
    auto* tile_counts = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_group_tile_offset);
    auto* expert_counts = reinterpret_cast<__gm__ std::uint32_t*>(
        workspace + dispatch_group_expert_count_offset);
    auto* tile_errors = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + dispatch_group_error_offset);
    const auto grid = direct_subgroup_grid_stride(
        blockIdx.x, threadIdx.x, gridDim.x, blockDim.x,
        kTopkSubgroupWidth);
    const std::uint32_t lane = grid.lane;
    const bool build_expert_counts =
        dispatch_group_expert_count == num_experts_u32 &&
        dispatch_group_expert_count_offset != 0;

    for (std::uint32_t tile = grid.first;
         tile < tile_count_u32; tile += grid.stride) {
        std::uint32_t destination_count = 0;
        std::uint64_t tile_error = 0;
        const std::uint32_t token_begin =
            tile * static_cast<std::uint32_t>(
                kDispatchGroupingTokensPerTile);
        for (std::uint32_t local_token = 0;
             local_token < kDispatchGroupingTokensPerTile; ++local_token) {
            const std::uint32_t token = token_begin + local_token;
            if (token >= num_tokens_u32)
                break;
            if (lane < world_size)
                owners[token * world_size + lane] = -1;

            std::int32_t destination_key = -1;
            bool logically_active = false;
            bool invalid_topk = false;
            if (lane < num_topk_u32) {
                const std::uint32_t index = token * num_topk_u32 + lane;
                const std::int64_t expert = topk_indices[index];
                if (expert == -1) {
                    if (!cached)
                        destination_slots[index] = -1;
                } else if (expert < 0 ||
                           static_cast<std::uint64_t>(expert) >=
                               num_experts_u32) {
                    invalid_topk = true;
                } else {
                    destination_key = static_cast<std::int32_t>(
                        static_cast<std::uint64_t>(expert) /
                        num_local_experts);
                    logically_active = true;
                    if (build_expert_counts)
                        (void)asc_atomic_add(
                            &expert_counts[static_cast<std::uint32_t>(expert)],
                            1U);
                }
            }
            const auto group = group_topk_subgroup(
                destination_key, logically_active);
            if (group.is_owner)
                owners[token * world_size +
                       static_cast<std::uint64_t>(destination_key)] =
                    static_cast<std::int32_t>(lane);

            bool rank_selected = false;
            TopkSubgroupMask remaining_owners = group.unique_owner_mask;
            while (remaining_owners != 0) {
                const std::int32_t owner_lane =
                    topk_first_set_lane(remaining_owners);
                const std::int32_t owner_key = asc_shfl(
                    destination_key,
                    static_cast<std::uint32_t>(owner_lane),
                    kTopkSubgroupWidth);
                if (lane == static_cast<std::uint32_t>(owner_key))
                    rank_selected = true;
                remaining_owners &= ~(
                    TopkSubgroupMask{1} <<
                    static_cast<std::uint32_t>(owner_lane));
            }
            if (lane < world_size && rank_selected)
                ++destination_count;

            const TopkSubgroupMask invalid_mask =
                static_cast<TopkSubgroupMask>(
                    asc_ballot(invalid_topk ? 1 : 0));
            if (lane == 0 && invalid_mask != 0)
                tile_error = make_dispatch_protocol_failure(
                    transport_world_rank, DispatchProtocolStage::kProducer,
                    generation, DispatchProtocolError::kInvalidTopk)
                    .scratch_status;
        }
        if (lane < world_size)
            transport::simt::store_published(
                &tile_counts[tile * world_size + lane],
                static_cast<std::uint64_t>(destination_count));
        if (lane == 0)
            transport::simt::store_published(&tile_errors[tile], tile_error);
    }
}

template <bool ProfileEnabled>
__global__ __vector__ void dispatch_producer_group_kernel(
    __gm__ const std::int64_t* topk_indices,
    __gm__ std::int32_t* destination_slots,
    __gm__ std::uint8_t* workspace,
    std::uint64_t generation, CoreTiling tiling,
    std::uint32_t early_route_plan) {
    if constexpr (ProfileEnabled) {
        const auto profile_block = static_cast<std::uint32_t>(
            AscendC::GetBlockIdx());
        transport::service::record_stage_start<true>(
            tiling.transport_context,
            transport::TransportProfileOperation::kDispatch, generation,
            static_cast<std::uint32_t>(DirectDispatchStage::kProducerGroup),
            profile_block,
            static_cast<std::uint32_t>(AscendC::GetBlockNum()));
    }
    const bool hybrid = (tiling.mode_flags &
        (CoreModeFlags{1} <<
         static_cast<std::uint8_t>(CoreMode::kHybrid))) != 0;
    const bool grouping_eligible =
        tiling.num_topk <= kTopkSubgroupWidth &&
        tiling.transport_context.topology.world_size <=
            static_cast<int>(kTopkSubgroupWidth);
    if (!hybrid && grouping_eligible) {
        asc_vf_call<direct_dispatch_producer_group_vf>(
            dim3(tiling.launch.num_threads), topk_indices,
            destination_slots, workspace,
            tiling.transport_context.topology.world_rank,
            tiling.transport_context.topology.world_size,
            tiling.mode_flags, generation, tiling.num_tokens,
            tiling.num_experts, tiling.num_topk,
            tiling.workspace_layout.scratch_status_offset,
            tiling.workspace_layout.dispatch_group_owner_offset,
            tiling.workspace_layout.dispatch_group_tile_offset,
            tiling.workspace_layout.dispatch_group_tile_count,
            early_route_plan != 0 ?
                tiling.workspace_layout
                    .dispatch_group_expert_count_offset : 0,
            early_route_plan != 0 ?
                tiling.workspace_layout.dispatch_group_expert_count : 0,
            tiling.workspace_layout.dispatch_group_error_offset);
    }
    if constexpr (ProfileEnabled) {
        const auto profile_block = static_cast<std::uint32_t>(
            AscendC::GetBlockIdx());
        transport::service::record_stage_end<true>(
            tiling.transport_context,
            transport::TransportProfileOperation::kDispatch, generation,
            static_cast<std::uint32_t>(DirectDispatchStage::kProducerGroup),
            profile_block, false);
    }
}

template <bool ProfileEnabled>
inline int launch_dispatch_producer_group(
    DispatchArguments arguments, CoreTiling tiling, void* stream,
    CoreLaunchShape launch, std::uint32_t dynamic_ub_bytes) {
    dispatch_producer_group_kernel<ProfileEnabled><<<
        launch.num_blocks, dynamic_ub_bytes,
        static_cast<aclrtStream>(stream)>>>(
        arguments.topk_indices, arguments.destination_slots,
        static_cast<std::uint8_t*>(arguments.workspace),
        arguments.generation, tiling, arguments.early_route_plan);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic

extern "C" int deep_ep_ascend_launch_dispatch_producer_group(
    deep_ep::ascend::elastic::DispatchArguments arguments,
    deep_ep::ascend::elastic::CoreTiling tiling, void* stream,
    deep_ep::ascend::elastic::CoreLaunchShape launch,
    std::uint32_t dynamic_ub_bytes, bool profile_enabled) {
    using namespace deep_ep::ascend::elastic;
    return profile_enabled ?
        launch_dispatch_producer_group<true>(
            arguments, tiling, stream, launch, dynamic_ub_bytes) :
        launch_dispatch_producer_group<false>(
            arguments, tiling, stream, launch, dynamic_ub_bytes);
}
