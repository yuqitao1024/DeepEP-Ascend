__simt_vf__ __launch_bounds__(512) inline void direct_combine_epilogue_validate_vf(
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ std::uint8_t* workspace,
    std::uintptr_t local_window_base,
    std::uintptr_t transport_backend_context,
    CoreModeFlags mode_flags, int world_size, std::uint64_t num_tokens,
    std::uint64_t num_experts, std::uint64_t num_topk,
    std::uint64_t shard_capacity,
    std::uint64_t combine_record_bytes,
    std::uint64_t combine_weight_offset,
    std::uint64_t combine_receive_offset,
    std::uint64_t combine_receive_shard_bytes,
    std::uint64_t workspace_status_offset,
    std::uint64_t workspace_rank_counts_offset,
    std::uint64_t workspace_slot_offset,
    std::uint64_t combine_receive_tile_error_offset,
    std::uint64_t combine_receive_tile_count,
    std::uint64_t hidden_elements) {
#if DEEP_EP_ASCEND_ACQUIRE_DIAGNOSTICS
    __gm__ transport::TransportStageProfile* profile = nullptr;
    auto* staged = reinterpret_cast<__gm__ transport::StagedTransportContext*>(
        transport_backend_context);
    if (blockIdx.x == 0 && threadIdx.x == 0 && staged != nullptr &&
        transport::simt::load_observed(&staged->stage_profile) != 0 &&
        transport::simt::load_observed(&staged->stage_profile_bytes) ==
            sizeof(transport::TransportStageProfile)) {
        profile = reinterpret_cast<
            __gm__ transport::TransportStageProfile*>(
                staged->stage_profile);
        const auto validate_start = __asc_simt_vf::clock();
        transport::simt::store_published(
            &profile->validate_vf_start_cycles, validate_start);
    }
#endif
    if (!combine_direct_status_is_clean(
            workspace, workspace_status_offset))
        return;
    const std::uint32_t num_tokens_u32 =
        static_cast<std::uint32_t>(num_tokens);
    const std::uint32_t num_experts_u32 =
        static_cast<std::uint32_t>(num_experts);
    const std::uint32_t num_topk_u32 =
        static_cast<std::uint32_t>(num_topk);
    const std::uint32_t shard_capacity_u32 =
        static_cast<std::uint32_t>(shard_capacity);
    const std::uint32_t tile_count_u32 =
        static_cast<std::uint32_t>(combine_receive_tile_count);
    const auto trailer = combine_record_trailer_layout(
        combine_record_bytes, false);
    const bool expanded = (mode_flags & (CoreModeFlags{1} <<
        static_cast<std::uint8_t>(CoreMode::kExpanded))) != 0;
    const bool allow_multiple_reduction =
        (mode_flags & (CoreModeFlags{1} << static_cast<std::uint8_t>(
            CoreMode::kAllowMultipleReduction))) != 0;
    const std::uint64_t hidden_bytes =
        hidden_elements * sizeof(std::uint16_t);
    const auto* counts = reinterpret_cast<__gm__ const std::uint64_t*>(
        workspace + workspace_rank_counts_offset);
    auto* tile_errors = reinterpret_cast<__gm__ std::uint64_t*>(
        workspace + combine_receive_tile_error_offset);
    auto* slots = reinterpret_cast<__gm__ std::int32_t*>(
        workspace + workspace_slot_offset);
    const std::uint32_t local_experts =
        num_experts_u32 / static_cast<std::uint32_t>(world_size);
    const bool layout_valid = trailer.valid &&
        hidden_bytes <= combine_weight_offset &&
        combine_weight_offset <= trailer.header_offset &&
        num_topk <= (trailer.header_offset - combine_weight_offset) /
            sizeof(float);
    const std::uint32_t receive_extent =
        static_cast<std::uint32_t>(world_size) * shard_capacity_u32;
    const auto work = direct_block_distributed_grid_stride(
        blockIdx.x, threadIdx.x, gridDim.x, blockDim.x);
    for (std::uint32_t tile = work.first;
         tile < tile_count_u32; tile += work.stride) {
        tile_errors[tile] = 0;
        if (!layout_valid) {
            if (tile == 0)
                tile_errors[tile] = (std::uint64_t{1} << 32U) |
                    static_cast<std::uint32_t>(
                        CombineProtocolError::kInvalidLayout);
            continue;
        }
        const std::uint32_t tile_begin =
            tile * static_cast<std::uint32_t>(kCombineRecordsPerTile);
        std::uint32_t tile_end = tile_begin +
            static_cast<std::uint32_t>(kCombineRecordsPerTile);
        if (tile_end > receive_extent)
            tile_end = receive_extent;
        for (std::uint32_t logical = tile_begin;
             logical < tile_end; ++logical) {
            std::uint64_t contributor_rank = 0;
            std::uint64_t receive_slot = 0;
            if (!combine_simt_receive_record_coordinates(
                    logical, static_cast<std::uint64_t>(world_size),
                    shard_capacity, &contributor_rank, &receive_slot) ||
                receive_slot >= counts[contributor_rank])
                continue;
            auto* shard = reinterpret_cast<__gm__ const std::uint8_t*>(
                combine_receive_shard_address(
                    local_window_base, combine_receive_offset,
                    contributor_rank, combine_receive_shard_bytes));
            auto* header = reinterpret_cast<
                __gm__ const CombineRecordHeader*>(
                    shard + receive_slot * combine_record_bytes +
                    trailer.header_offset);
            const auto observed = load_observed_combine_record_header(header);
            const bool valid_token = is_valid_combine_origin_token(
                observed.origin_token, num_tokens_u32,
                shard_capacity_u32);
            const bool valid_lanes = valid_token &&
                is_valid_combine_record_lanes(
                    combined_topk_indices +
                        static_cast<std::uint64_t>(observed.origin_token) *
                            num_topk,
                    num_topk_u32, num_experts_u32, local_experts,
                    static_cast<int>(contributor_rank),
                    observed.master_lane, observed.contribution_lane,
                    expanded, allow_multiple_reduction);
            CombineProtocolError error = CombineProtocolError::kNone;
            if (observed.abi_version != kCombineRecordAbiVersion ||
                observed.struct_size != sizeof(CombineRecordHeader) ||
                observed.contributor_rank !=
                    static_cast<std::int32_t>(contributor_rank) ||
                !valid_token || !valid_lanes)
                error = CombineProtocolError::kInvalidHeader;
            std::uint64_t index = 0;
            if (error == CombineProtocolError::kNone &&
                (!combine_simt_record_slot_index(
                    static_cast<std::uint64_t>(observed.origin_token),
                    static_cast<std::uint64_t>(observed.contribution_lane),
                    num_tokens, num_topk, &index) ||
                 index > static_cast<std::uint64_t>(0x7fffffff)))
                error = CombineProtocolError::kInvalidHeader;
            if (error != CombineProtocolError::kNone) {
                tile_errors[tile] =
                    (static_cast<std::uint64_t>(logical + 1) << 32U) |
                    static_cast<std::uint32_t>(error);
                break;
            }
            const std::int32_t prior = asc_atomic_cas(slots + index, -1,
                static_cast<std::int32_t>(receive_slot));
            if (prior != -1) {
                tile_errors[tile] =
                    (static_cast<std::uint64_t>(logical + 1) << 32U) |
                    static_cast<std::uint32_t>(
                        CombineProtocolError::kDuplicateRecord);
                break;
            }
        }
    }
#if DEEP_EP_ASCEND_ACQUIRE_DIAGNOSTICS
    if (profile != nullptr) {
        transport::simt::store_published(
            &profile->validate_vf_end_cycles, __asc_simt_vf::clock());
        transport::simt::system_fence();
    }
#endif
}

__global__ __vector__ void direct_combine_epilogue_validate_kernel(
    __gm__ const std::uint16_t* x,
    __gm__ const float* topk_weights,
    __gm__ const std::int32_t* source_metadata,
    __gm__ const HybridRouteRecord* route_records,
    __gm__ const std::int64_t* combined_topk_indices,
    __gm__ const std::int32_t* prefix_per_rank,
    __gm__ std::uint8_t* workspace,
    __gm__ std::uint16_t* combined_x,
    __gm__ float* combined_topk_weights,
    __gm__ const std::uint16_t* bias_0,
    __gm__ const std::uint16_t* bias_1,
    CombineVfScalars scalars) {
    const auto route_record_count = scalars.route_record_count;
    const auto generation = scalars.generation;
    const auto timeout_cycles = scalars.timeout_cycles;
    const auto num_source_rows = scalars.num_source_rows;
    const auto num_input_rows = scalars.num_input_rows;
    const auto local_window_base = scalars.local_window_base;
    const auto expanded_vector_reduce = scalars.expanded_vector_reduce;
    const auto local_copy_datacopy = scalars.local_copy_datacopy;
    const auto direct_local_placement = scalars.direct_local_placement;
    const auto vector_reduce_tile_elements = scalars.vector_reduce_tile_elements;
    const auto stage = scalars.stage;
    const auto profile_enabled = scalars.profile_enabled;
    const auto tiling = scalars.tiling;
    const auto release_segment = direct_combine_release_segment(stage, profile_enabled);
    const std::uint64_t hybrid_record_capacity =
        (tiling.mode_flags & (CoreModeFlags{1} << static_cast<std::uint8_t>(
            CoreMode::kExpanded))) != 0 &&
        (tiling.mode_flags & (CoreModeFlags{1} << static_cast<std::uint8_t>(
            CoreMode::kAllowMultipleReduction))) == 0 ?
            tiling.num_max_tokens_per_rank * tiling.num_topk :
            tiling.num_max_tokens_per_rank;
    asc_vf_call<direct_combine_epilogue_validate_vf>(
        dim3(tiling.launch.num_threads),
        combined_topk_indices,
        workspace,
        local_window_base,
        tiling.transport_context.backend_context,
        tiling.mode_flags,
        tiling.transport_context.topology.world_size,
        tiling.num_tokens,
        tiling.num_experts,
        tiling.num_topk,
        tiling.num_max_tokens_per_rank,
        tiling.symmetric_window_layout.combine_record_bytes,
        tiling.symmetric_window_layout.combine_weight_offset,
        tiling.symmetric_window_layout.combine_receive_offset,
        tiling.symmetric_window_layout.combine_receive_shard_bytes,
        tiling.workspace_layout.scratch_status_offset,
        tiling.workspace_layout.scratch_rank_counts_offset,
        tiling.workspace_layout.slot_offset,
        tiling.workspace_layout.combine_receive_tile_error_offset,
        tiling.workspace_layout.combine_receive_tile_count,
        tiling.hidden);
}

extern "C" int deep_ep_ascend_launch_direct_combine_epilogue_validate(
    CombineArguments arguments, CoreTiling tiling,
    DirectCombineStage stage, bool profile_enabled,
    void* stream, CoreLaunchShape launch) {
    const CombineVfScalars scalars{
        arguments.route_record_count, arguments.generation,
        arguments.timeout_cycles,
        arguments.num_source_rows, arguments.num_input_rows,
        arguments.local_window_base, arguments.expanded_vector_reduce,
        arguments.local_copy_datacopy, arguments.direct_local_placement,
        arguments.vector_reduce_tile_elements, stage, profile_enabled, tiling};
    direct_combine_epilogue_validate_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(
        static_cast<const std::uint16_t*>(arguments.x),
        arguments.topk_weights, arguments.source_metadata,
        arguments.route_records, arguments.combined_topk_indices,
        arguments.prefix_per_rank,
        static_cast<std::uint8_t*>(arguments.workspace),
        static_cast<std::uint16_t*>(arguments.combined_x),
        arguments.combined_topk_weights,
        static_cast<const std::uint16_t*>(arguments.bias_0),
        static_cast<const std::uint16_t*>(arguments.bias_1), scalars);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
