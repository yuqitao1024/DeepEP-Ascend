#include "../transport/aicore_transport_service.hpp"
#include "../transport/device_transport_facade.hpp"

namespace deep_ep::ascend::elastic {

#include "dispatch_device_common.hpp"

__simt_vf__ __launch_bounds__(512) inline void direct_dispatch_persistent_release_complete_vf(
    __gm__ std::uint8_t* workspace,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t generation) {
    if (blockIdx.x != 0 || threadIdx.x != 0)
        return;
    auto* pipeline = reinterpret_cast<__gm__ DispatchPipelineState*>(
        workspace + dispatch_pipeline_offset);
    transport::simt::system_fence();
    transport::simt::store_published(
        &pipeline->release_completed_generation, generation);
    transport::simt::store_published(
        reinterpret_cast<__gm__ std::uint32_t*>(
            &pipeline->release_worker_state),
        static_cast<std::uint32_t>(DispatchPipelineWorkerState::kCompleted));
}

struct DirectDispatchPersistentReleaseCompleteKernelArguments {
    __gm__ std::uint8_t* workspace;
    std::uint64_t dispatch_pipeline_offset;
    std::uint64_t generation;
    std::uint32_t vf_num_threads;
};

__global__ __vector__ void direct_dispatch_persistent_release_complete_kernel(
    DirectDispatchPersistentReleaseCompleteKernelArguments arguments) {
    asc_vf_call<direct_dispatch_persistent_release_complete_vf> (
        dim3(arguments.vf_num_threads), arguments.workspace, arguments.dispatch_pipeline_offset, arguments.generation);
}

extern "C" int deep_ep_ascend_launch_direct_dispatch_persistent_release_complete(
    std::uint8_t* workspace,
    std::uint64_t dispatch_pipeline_offset,
    std::uint64_t generation,
    void* stream, CoreLaunchShape launch,
    std::uint32_t vf_num_threads) {
    const DirectDispatchPersistentReleaseCompleteKernelArguments arguments{
        workspace,
        dispatch_pipeline_offset,
        generation,
        vf_num_threads};
    direct_dispatch_persistent_release_complete_kernel<<<
        launch.num_blocks, 0, static_cast<aclrtStream>(stream)>>>(arguments);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace deep_ep::ascend::elastic
