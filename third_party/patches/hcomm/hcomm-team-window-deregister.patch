+HcclResult EndpointPair::CreateChannelForMemoryVersion(
+    EndpointHandle endpointHandle, CommEngine engine, uint64_t memoryVersion, u32 logicalReuseIdx,
+    HcommChannelDesc* channelDescs, ChannelHandle* channels, bool& isNewChannel, u32& physicalIndex)
+{
+    std::lock_guard<std::mutex> lock(channelMutex_);
+    const auto generationKey = std::make_pair(memoryVersion, logicalReuseIdx);
+    auto& generationIndices = channelGenerationIndices_[engine];
+    const auto generation = generationIndices.find(generationKey);
+    if (generation != generationIndices.end()) {
+        physicalIndex = generation->second;
+        CHK_PRT_RET(
+            physicalIndex >= channelHandles_[engine].size(),
+            HCCL_ERROR(
+                "[%s] invalid channel generation mapping, engine[%s] memoryVersion[%llu] logicalReuseIdx[%u] "
+                "physicalIndex[%u] channelCount[%zu]",
+                __func__, GetEnumToString(GetCommEngineStatusStrMap(), engine).c_str(), memoryVersion,
+                logicalReuseIdx, physicalIndex, channelHandles_[engine].size()),
+            HCCL_E_INTERNAL);
+        channels[0] = channelHandles_[engine][physicalIndex];
+        isNewChannel = false;
+        return HCCL_SUCCESS;
+    }
+
+    ChannelHandle newChannel = 0;
+    const HcclResult ret = static_cast<HcclResult>(
+        HcommCollectiveChannelCreate(endpointHandle, engine, channelDescs, 1, &newChannel));
+    if (ret != HCCL_SUCCESS) {
+        return ret;
+    }
+
+    auto& engineChannels = channelHandles_[engine];
+    physicalIndex = static_cast<u32>(engineChannels.size());
+    engineChannels.push_back(newChannel);
+    generationIndices.emplace(generationKey, physicalIndex);
+    channels[0] = newChannel;
+    isNewChannel = true;
+    HCCL_INFO(
+        "[%s] created channel generation, engine[%s] memoryVersion[%llu] logicalReuseIdx[%u] physicalIndex[%u]",
+        __func__, GetEnumToString(GetCommEngineStatusStrMap(), engine).c_str(), memoryVersion, logicalReuseIdx,
+        physicalIndex);
+    return HCCL_SUCCESS;
+}
