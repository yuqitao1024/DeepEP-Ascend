+bool TaggedMemMap::HasSameMemory(const std::string& tag, const HcclMem& mem) const
+{
+    auto it = tagToHandle_.find(tag);
+    if (it == tagToHandle_.end()) {
+        return false;
+    }
+    const HcclMem& registered = it->second.mem;
+    return registered.type == mem.type && registered.addr == mem.addr && registered.size == mem.size;
+}
+
+void TaggedMemMap::UpdateHandle(const std::string& tag, const HcclMem& mem, MemHandle handle)
+{
+    auto it = tagToHandle_.find(tag);
+    if (it == tagToHandle_.end()) {
+        tagToHandle_.emplace(tag, TaggedMemEntry{mem, handle});
+        return;
+    }
+    if (it->second.handle != handle) {
+        retiredHandles_.push_back(it->second.handle);
+    }
+    it->second = TaggedMemEntry{mem, handle};
+}
+
+std::vector<MemHandle> TaggedMemMap::GetAllHandles() const
+{
+    std::vector<MemHandle> handles;
+    handles.reserve(tagToHandle_.size() + retiredHandles_.size());
+    for (const auto& kv : tagToHandle_) {
+        handles.push_back(kv.second.handle);
+    }
+    handles.insert(handles.end(), retiredHandles_.begin(), retiredHandles_.end());
+    return handles;
+}
 
