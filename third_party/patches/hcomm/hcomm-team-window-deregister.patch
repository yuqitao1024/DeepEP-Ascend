+TEST_F(TestEndpointPair, Ut_CreateChannelForMemoryVersion_When_VersionChanges_Expect_NewPhysicalGeneration)
+{
+    EndpointDesc localEndpointDesc{};
+    EndpointDesc remoteEndpointDesc{};
+    EndpointPair endpointPair(localEndpointDesc, remoteEndpointDesc, rankIpPortMap);
+    HcommChannelDesc channelDesc{};
+    ChannelHandle channel = 0;
+    bool isNewChannel = false;
+    u32 physicalIndex = 0;
+
+    endpointPair.channelHandles_[COMM_ENGINE_AIV] = {100, 200};
+    endpointPair.channelGenerationIndices_[COMM_ENGINE_AIV].emplace(std::make_pair(10u, 0u), 0u);
+    endpointPair.channelGenerationIndices_[COMM_ENGINE_AIV].emplace(std::make_pair(11u, 0u), 1u);
+
+    EXPECT_EQ(endpointPair.CreateChannelForMemoryVersion(
+                  nullptr, COMM_ENGINE_AIV, 10, 0, &channelDesc, &channel, isNewChannel, physicalIndex),
+              HCCL_SUCCESS);
+    EXPECT_FALSE(isNewChannel);
+    EXPECT_EQ(physicalIndex, 0u);
+    EXPECT_EQ(channel, 100u);
+
+    EXPECT_EQ(endpointPair.CreateChannelForMemoryVersion(
+                  nullptr, COMM_ENGINE_AIV, 11, 0, &channelDesc, &channel, isNewChannel, physicalIndex),
+              HCCL_SUCCESS);
+    EXPECT_FALSE(isNewChannel);
+    EXPECT_EQ(physicalIndex, 1u);
+    EXPECT_EQ(channel, 200u);
+
+    EXPECT_EQ(endpointPair.CreateChannelForMemoryVersion(
+                  nullptr, COMM_ENGINE_AIV, 10, 0, &channelDesc, &channel, isNewChannel, physicalIndex),
+              HCCL_SUCCESS);
+    EXPECT_FALSE(isNewChannel);
+    EXPECT_EQ(physicalIndex, 0u);
+    EXPECT_EQ(channel, 100u);
+    EXPECT_EQ(endpointPair.channelHandles_[COMM_ENGINE_AIV].size(), 2u);
+    endpointPair.channelHandles_.clear();
+}
