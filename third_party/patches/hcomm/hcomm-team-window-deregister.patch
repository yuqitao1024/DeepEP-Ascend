+TEST(UtHcclTeamMgr, Ut_ClearByCollComm_When_TeamOperationInFlight_Expect_WaitsForLifecycleLock)
+{
+    HcommTeamHandle worldTeam = reinterpret_cast<HcommTeamHandle>(0x99000);
+    HcommTeamHandle subTeam = reinterpret_cast<HcommTeamHandle>(0x9A000);
+    ManagerCallbacks callbacks{};
+    CollComm collComm(nullptr, 0, "team-lifecycle-test", callbacks, CollCommInitMode::simpleMode);
+    uint32_t rankIds[2] = {0, 1};
+    ASSERT_EQ(
+        HcclTeamMgr::GetInstance().RegisterWorldTeam(worldTeam, &collComm, nullptr, 0, rankIds, 2), HCCL_SUCCESS);
+    ASSERT_EQ(
+        HcclTeamMgr::GetInstance().RegisterSubTeam(worldTeam, subTeam, nullptr, 0, rankIds, 2), HCCL_SUCCESS);
+
+    TeamDestroyState state{};
+    ASSERT_TRUE(HcclTeamMgr::GetInstance().BeginTeamDestroy(worldTeam, state));
+    ASSERT_TRUE(HcclTeamMgr::GetInstance().MarkTeamHcommDestroyed(worldTeam));
+    state = {};
+    ASSERT_TRUE(HcclTeamMgr::GetInstance().BeginTeamDestroy(subTeam, state));
+    ASSERT_TRUE(HcclTeamMgr::GetInstance().MarkTeamHcommDestroyed(subTeam));
+
+    auto lifecycleMutex = HcclTeamMgr::GetInstance().GetTeamLifecycleMutex(worldTeam);
+    ASSERT_NE(lifecycleMutex, nullptr);
+    std::unique_lock<std::recursive_mutex> lifecycleLock(*lifecycleMutex);
+    std::promise<void> cleanupStarted;
+    auto cleanupStartedFuture = cleanupStarted.get_future();
+    auto cleanup = std::async(std::launch::async, [&] {
+        cleanupStarted.set_value();
+        HcclTeamMgr::GetInstance().ClearByCollComm(&collComm);
+    });
+    cleanupStartedFuture.wait();
+    bool cleanupOwnsCommGate = false;
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+    while (!cleanupOwnsCommGate && std::chrono::steady_clock::now() < deadline) {
+        if (!collComm.GetTeamLifecycleMutex().try_lock()) {
+            cleanupOwnsCommGate = true;
+        } else {
+            collComm.GetTeamLifecycleMutex().unlock();
+            std::this_thread::yield();
+        }
+    }
+    ASSERT_TRUE(cleanupOwnsCommGate);
+    EXPECT_EQ(cleanup.wait_for(std::chrono::milliseconds(100)), std::future_status::timeout);
+
+    lifecycleLock.unlock();
+    EXPECT_EQ(cleanup.wait_for(std::chrono::seconds(5)), std::future_status::ready);
+    cleanup.get();
+
+    {
+        std::unique_lock<std::recursive_mutex> commLock(collComm.GetTeamLifecycleMutex());
+        EXPECT_TRUE(collComm.IsTeamLifecycleClosing());
+    }
+}
