+
+TeamOperationGuard HcclTeamMgr::AcquireTeamOperation(HcommTeamHandle team)
+{
+    TeamOperationGuard guard;
+    if (team == nullptr) {
+        return guard;
+    }
+    {
+        std::shared_lock<std::shared_mutex> lock(mutex_);
+        auto it = teamMap_.find(team);
+        if (it == teamMap_.end() || it->second.collComm == nullptr || it->second.lifecycleMutex == nullptr) {
+            return guard;
+        }
+        guard.collComm_ = it->second.collComm;
+        guard.lifecycleMutex_ = it->second.lifecycleMutex;
+    }
+
+    guard.collCommLock_ = std::unique_lock<std::recursive_mutex>(guard.collComm_->GetTeamLifecycleMutex());
+    if (guard.collComm_->IsTeamLifecycleClosing()) {
+        guard.state_ = TeamOperationGuard::State::CLOSING;
+        return guard;
+    }
+    guard.lifecycleLock_ = std::unique_lock<std::recursive_mutex>(*guard.lifecycleMutex_);
+
+    std::shared_lock<std::shared_mutex> lock(mutex_);
+    auto it = teamMap_.find(team);
+    if (it == teamMap_.end() || it->second.collComm != guard.collComm_ ||
+        it->second.lifecycleMutex != guard.lifecycleMutex_) {
+        return guard;
+    }
+    guard.state_ = TeamOperationGuard::State::READY;
+    return guard;
+}
