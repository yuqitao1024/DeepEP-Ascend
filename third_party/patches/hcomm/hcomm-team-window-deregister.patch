+std::shared_ptr<std::recursive_mutex> HcclTeamMgr::GetTeamLifecycleMutex(HcommTeamHandle team)
+{
+    if (team == nullptr) {
+        return nullptr;
+    }
+    std::shared_lock<std::shared_mutex> lock(mutex_);
