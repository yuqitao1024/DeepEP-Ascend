+    }
+    std::shared_lock<std::shared_mutex> lock(mutex_);
+    auto it = teamMap_.find(worldTeam);
+    if (it == teamMap_.end()) {
+        return false;
+    }
+    const uintptr_t requestStart = reinterpret_cast<uintptr_t>(localMem.addr);
+    for (const auto& info : it->second.windows) {
+        if (!info.hcommDeregistered || info.registeredLocalMem.addr == nullptr ||
+            info.registeredLocalMem.size == 0) {
+            continue;
+        }
+        const uintptr_t windowStart = reinterpret_cast<uintptr_t>(info.registeredLocalMem.addr);
+        const bool overlaps = (requestStart <= windowStart)
+            ? (windowStart - requestStart < localMem.size)
+            : (requestStart - windowStart < info.registeredLocalMem.size);
+        if (overlaps) {
+            return true;
+        }
+    }
+    return false;
+}
