#include <cstdint>

#include "acl/acl.h"
#include "kernel_operator.h"

#include "netlayer_ab_abi.hpp"

namespace netlayer_ab {
namespace {

constexpr std::uint32_t kStrongOrdering = 5;
constexpr std::uint32_t kFence = 1;
constexpr std::uint32_t kCompletionEntry = 1;

__aicore__ inline void system_fence() {
    pipe_barrier(PIPE_ALL);
}

template <typename T>
__aicore__ inline T load_device(const __gm__ T* address) {
    return static_cast<T>(ld_dev(const_cast<__gm__ T*>(address), 0));
}

template <typename T>
__aicore__ inline T load_published(const __gm__ T* address) {
    return AscendC::ReadGmBypassDCache<T>(const_cast<__gm__ T*>(address));
}

template <typename T>
__aicore__ inline void store_device(__gm__ T* address, T value) {
    st_dev(value, address, 0);
}

__aicore__ inline void flush_cacheline(__gm__ void* address) {
    pipe_barrier(PIPE_ALL);
    dcci(address, cache_line_t::SINGLE_CACHE_LINE, dcci_dst_t::CACHELINE_OUT);
    pipe_barrier(PIPE_ALL);
}

__aicore__ inline std::uint32_t sq_position(std::uint64_t head) {
    return static_cast<std::uint32_t>(head);
}

__aicore__ inline std::uint32_t sq_request_count(std::uint64_t head) {
    return static_cast<std::uint32_t>(head >> 32);
}

__aicore__ inline std::uint64_t pack_sq_head(std::uint32_t position,
                                              std::uint32_t count) {
    return static_cast<std::uint64_t>(position) |
           (static_cast<std::uint64_t>(count) << 32);
}

__aicore__ inline std::uint32_t sq_slot(std::uint32_t head,
                                         std::uint32_t depth) {
    return depth == 0 ? 0 : head % depth;
}

__aicore__ inline std::uint32_t owner_for(std::uint32_t value,
                                           std::uint32_t depth) {
    return depth == 0 ? 0 : 1 ^ ((value / depth) & 1);
}

__aicore__ inline bool cqe_owner_valid(std::uint32_t owner,
                                         std::uint32_t tail,
                                         std::uint32_t depth) {
    return owner == owner_for(tail, depth);
}

__aicore__ inline std::uint64_t load_eid_word(const std::uint8_t* eid,
                                               std::uint32_t start) {
    std::uint64_t result = 0;
    for (std::uint32_t byte = 0; byte < sizeof(result); ++byte)
        result |= static_cast<std::uint64_t>(eid[start + byte]) << (byte * 8);
    return result;
}

__aicore__ inline UrmaSqe make_sqe(const SqContext& sq,
                                     const RegisteredBuffer& remote,
                                     std::uint32_t head,
                                     std::uint64_t remote_address) {
    UrmaSqe result{};
    const std::uint32_t flags =
        kStrongOrdering | (kFence << 3) | (kCompletionEntry << 5);
    result.word0 = (sq_slot(head, sq.depth) & 0xffff) |
                   (flags << 16) | (1 << 28) | (1 << 29) |
                   (owner_for(head, sq.depth) << 31);
    result.word1 = (kUrmaWriteOpcode << 8);
    result.word2 = sq.transport_path_id & 0x00ffffff;
    result.word2 |= 1 << 24;
    result.word3 = remote.token_id & 0x000fffff;
    result.remote_eid_low = load_eid_word(sq.remote_eid, 0);
    result.remote_eid_high = load_eid_word(sq.remote_eid, 8);
    result.remote_token_value = remote.token_value;
    result.remote_address_low =
        static_cast<std::uint32_t>(remote_address);
    result.remote_address_high =
        static_cast<std::uint32_t>(remote_address >> 32);
    return result;
}

__aicore__ inline WriteRequest make_write(const SqContext& sq,
                                            const RegisteredBuffer& remote,
                                            std::uint32_t head,
                                            std::uint64_t remote_address,
                                            std::uint64_t local_address,
                                            std::uint32_t bytes,
                                            std::uint32_t local_token) {
    WriteRequest result{};
    result.sqe = make_sqe(sq, remote, head, remote_address);
    result.sge.bytes = bytes;
    result.sge.token_id = local_token;
    result.sge.address = local_address;
    return result;
}

__aicore__ inline bool ranges_match(std::uint64_t address,
                                     std::uint32_t bytes,
                                     __gm__ RegisteredBuffer& buffer) {
    return address >= buffer.address && bytes <= buffer.bytes &&
           address - buffer.address <= buffer.bytes - bytes;
}

struct ResolvedChannel {
    __gm__ Channel* channel;
    __gm__ SqContext* sq;
    __gm__ CqContext* cq;
    SqContext sq_snapshot;
    RegisteredBuffer local;
    RegisteredBuffer remote;
};

__aicore__ inline RegisteredBuffer snapshot_buffer(
    __gm__ RegisteredBuffer* source) {
    RegisteredBuffer result{};
    result.address = source->address;
    result.bytes = source->bytes;
    result.token_id = source->token_id;
    result.token_value = source->token_value;
    return result;
}

__aicore__ inline bool resolve_channel(__gm__ DeviceControl* control,
                                         std::uint32_t peer,
                                         ResolvedChannel& resolved,
                                         std::uint32_t& status) {
    if (peer >= control->world_size || peer == control->rank ||
        control->channels == 0) {
        status = 1;
        return false;
    }
    auto* channels = reinterpret_cast<__gm__ std::uint64_t*>(
        static_cast<std::uintptr_t>(control->channels));
    const auto handle = channels[peer];
    if (handle == 0) {
        status = 2;
        return false;
    }
    auto* channel = reinterpret_cast<__gm__ Channel*>(
        static_cast<std::uintptr_t>(handle));
    if (channel->protocol != static_cast<std::int32_t>(kUbcCtpProtocol) ||
        channel->sq_count == 0 || channel->cq_count == 0 ||
        channel->local_buffer_count == 0 ||
        channel->remote_buffer_count == 0) {
        status = 3;
        return false;
    }

    auto* sq = reinterpret_cast<__gm__ SqContext*>(channel->sq_contexts);
    auto* cq = reinterpret_cast<__gm__ CqContext*>(channel->cq_contexts);
    if (sq->base == 0 || sq->head == 0 || sq->tail == 0 || sq->doorbell == 0 ||
        sq->entry_bytes != 64 || sq->depth == 0 || cq->base == 0 ||
        cq->tail == 0 || cq->doorbell == 0 || cq->entry_bytes != 64 ||
        cq->depth == 0) {
        status = 4;
        return false;
    }

    auto* local_buffers = reinterpret_cast<__gm__ RegisteredBuffer*>(
        channel->local_buffers);
    auto* remote_buffers = reinterpret_cast<__gm__ RegisteredBuffer*>(
        channel->remote_buffers);
    const auto payload = static_cast<std::uint64_t>(control->local_payload);
    const auto payload_bytes = control->payload_bytes;
    bool found_local = false;
    bool found_remote = false;
    for (std::uint32_t index = 0;
         index < channel->local_buffer_count && (!found_local || !found_remote);
         ++index) {
        if (!found_local && ranges_match(payload, 1,
                                         local_buffers[index])) {
            resolved.local = snapshot_buffer(local_buffers + index);
            found_local = true;
        }
        if (!found_remote && ranges_match(payload, payload_bytes,
                                          remote_buffers[index])) {
            resolved.remote = snapshot_buffer(remote_buffers + index);
            found_remote = true;
        }
    }
    if (!found_local || !found_remote) {
        status = 5;
        return false;
    }

    resolved.channel = channel;
    resolved.sq = sq;
    resolved.cq = cq;
    resolved.sq_snapshot.entry_bytes = sq->entry_bytes;
    resolved.sq_snapshot.depth = sq->depth;
    resolved.sq_snapshot.transport_path_id = sq->transport_path_id;
    for (std::uint32_t byte = 0; byte < sizeof(resolved.sq_snapshot.remote_eid);
         ++byte)
        resolved.sq_snapshot.remote_eid[byte] = sq->remote_eid[byte];
    return true;
}

__aicore__ inline bool post_write(__gm__ DeviceControl* control,
                                   ResolvedChannel& resolved,
                                   std::uint32_t peer,
                                   std::uint32_t chunk,
                                   std::uint32_t& status) {
    auto* remote_addresses = reinterpret_cast<__gm__ std::uint64_t*>(
        static_cast<std::uintptr_t>(control->remote_addresses));
    const auto remote_address =
        remote_addresses[peer] + static_cast<std::uint64_t>(chunk) *
                                     control->chunk_bytes;
    const auto local_address = control->local_payload +
                               static_cast<std::uint64_t>(chunk) *
                                   control->chunk_bytes;
    const auto request = make_write(
        resolved.sq_snapshot, resolved.remote,
        sq_position(load_device(
            reinterpret_cast<__gm__ std::uint64_t*>(resolved.sq->head))),
        remote_address, local_address, static_cast<std::uint32_t>(
                                           control->chunk_bytes),
        resolved.local.token_id);

    // The queue entry is written with a 64B aligned store.  AICore global
    // scalar stores are naturally 64B cacheline coherent on dav-3510; this
    // avoids a TQue dependency for a fixed 64B WQE.
    auto* destination = reinterpret_cast<__gm__ WriteRequest*>(
        resolved.sq->base +
        static_cast<std::uint64_t>(sq_slot(
            sq_position(load_device(
                reinterpret_cast<__gm__ std::uint64_t*>(resolved.sq->head))),
            resolved.sq_snapshot.depth)) *
            resolved.sq_snapshot.entry_bytes);
    auto* destination_words = reinterpret_cast<__gm__ std::uint32_t*>(destination);
    const auto* source = reinterpret_cast<const std::uint32_t*>(&request);
    for (std::uint32_t word = 0; word < sizeof(request) / sizeof(std::uint32_t);
         ++word)
        destination_words[word] = source[word];
    flush_cacheline(destination);

    auto head_value = load_device(
        reinterpret_cast<__gm__ std::uint64_t*>(resolved.sq->head));
    auto position = sq_position(head_value);
    auto count = sq_request_count(head_value);
    position += sizeof(WriteRequest) / resolved.sq_snapshot.entry_bytes;
    ++count;
    store_device(reinterpret_cast<__gm__ std::uint64_t*>(resolved.sq->head),
                 pack_sq_head(position, count));
    store_device(reinterpret_cast<__gm__ std::uint32_t*>(
                     resolved.sq->doorbell),
                 position);
    (void)control;
    (void)peer;
    status = 0;
    return true;
}

__aicore__ inline bool drain_cq(__gm__ DeviceControl* control,
                                 ResolvedChannel& resolved,
                                 std::uint32_t timeout_cycles,
                                 std::uint32_t& status) {
    const auto head_value = load_device(
        reinterpret_cast<__gm__ std::uint64_t*>(resolved.sq->head));
    const auto expected = sq_request_count(head_value);
    auto tail = load_device(
        reinterpret_cast<__gm__ std::uint32_t*>(resolved.cq->tail));
    while (tail != expected) {
        auto* cqe = reinterpret_cast<__gm__ std::uint32_t*>(
            resolved.cq->base +
            static_cast<std::uint64_t>(tail % resolved.cq->depth) *
                resolved.cq->entry_bytes);
        std::uint32_t word0 = 0;
        std::uint32_t elapsed = 0;
        do {
            word0 = load_published(cqe);
            if (cqe_owner_valid((word0 >> 2) & 1, tail, resolved.cq->depth))
                break;
            ++elapsed;
        } while (elapsed < timeout_cycles);
        if (elapsed >= timeout_cycles) {
            status = word0;
            return false;
        }
        const auto substatus = (word0 >> 16) & 0xff;
        const auto completion_status = (word0 >> 24) & 0xff;
        if (completion_status != 0 || substatus != 0) {
            status = (completion_status << 8) | substatus;
            return false;
        }
        ++tail;
    }
    store_device(reinterpret_cast<__gm__ std::uint32_t*>(resolved.cq->tail),
                 tail);
    store_device(reinterpret_cast<__gm__ std::uint32_t*>(
                     resolved.cq->doorbell),
                 tail & 0x00ffffff);
    store_device(reinterpret_cast<__gm__ std::uint32_t*>(resolved.sq->tail),
                 tail);
    (void)control;
    status = 0;
    return true;
}

}  // namespace

__global__ __vector__ void netlayer_ab_kernel(
    __gm__ DeviceControl* control) {
    control->success = 0;
    control->failed_peer = 0xffffffff;
    control->failed_stage = 0;
    control->backend_status = 0;

    const auto start = AscendC::GetSystemCycle();
    for (std::uint32_t peer = 0; peer < control->world_size; ++peer) {
        if (peer == control->rank)
            continue;
        ResolvedChannel resolved{};
        std::uint32_t status = 0;
        auto* channel_table = reinterpret_cast<__gm__ std::uint64_t*>(
            static_cast<std::uintptr_t>(control->channels));
        if (control->channels != 0 && channel_table[peer] == 0)
            continue;
        if (!resolve_channel(control, peer, resolved, status)) {
            control->failed_peer = peer;
            control->failed_stage = 1;
            control->backend_status = status;
            store_device(&control->success, std::uint32_t{1});
            return;
        }
        for (std::uint32_t chunk = 0;
             chunk < control->payload_bytes / control->chunk_bytes; ++chunk) {
            if (!post_write(control, resolved, peer, chunk, status)) {
                control->failed_peer = peer;
                control->failed_stage = 2;
                control->backend_status = status;
                store_device(&control->success, std::uint32_t{1});
                return;
            }
        }
        if (!drain_cq(control, resolved, control->timeout_cycles, status)) {
            control->failed_peer = peer;
            control->failed_stage = 3;
            control->backend_status = status;
                store_device(&control->success, std::uint32_t{1});
            return;
        }
    }
    const auto end = AscendC::GetSystemCycle();
    control->cycle_counter = end - start;
    control->cycle_frequency = 1000000000ULL;
    system_fence();
    flush_cacheline(control);
    store_device(&control->success, std::uint32_t{2});
}

}  // namespace netlayer_ab

extern "C" int netlayer_ab_launch(
    __gm__ netlayer_ab::DeviceControl* control, void* stream) {
    netlayer_ab::netlayer_ab_kernel<<<1, 0, static_cast<aclrtStream>(stream)>>>(
        control);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}
